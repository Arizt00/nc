compactRawSurfaceV2 {
    fn:
        hazard(enabled >> bool) -> bool {
            if (!enabled) return true;

            owner <- alloc(8);
            alias>> p<byte> <- off(owner, 4096);

            wr(alias, 0xFF);
            free(owner);
            wr(owner, 1);
            free(owner);

            stale <- rd(alias);
            address <- adr(alias);
            recovered <- from(address);

            return stale == stale && !nil(recovered);
        }

        run() -> bool {
            return hazard(false);
        }

    ref main ->> run;
}
