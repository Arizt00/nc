use <io:output, render>;
use <memory:ptr, heap>;

ptrHeapCompacto :: runtime {
    stc:
        p >> p<int>;
        valor >> int <- 2;

    fn:
        run() -> bool {
            p !> p<int> : alloc(128);
            wr(p, 42);
            valor >> int <- rd(p);
            println("valor = " + renderInt(valor));
            free(p);
            return valor == 42;
        }

    ref main ->> run;

    fa:
        return true;

}
