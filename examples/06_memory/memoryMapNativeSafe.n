use <collections:result>;
use <memory:ptr, map>;

memoryMapNativeSafe :: runtime {
    stc:
        p >> p<byte>;
        ok >> bool <- false;

    fn:
        run() -> bool {
            p <- unwrap(map(4096));
            ok <- wr(p, 65);
            ok <- ok && rd(p) == 65;
            p <- unwrap(remap(p, 8192, true));
            ok <- ok && mapLen(p) == 8192;
            ok <- ok && mapAddress(p) == p;
            ok <- ok && mapIsMapped(p);
            ok <- ok && unwrap(mapLock(p));
            ok <- ok && unwrap(mapUnlock(p));
            ok <- ok && unwrap(mapProtect(p, 1));
            ok <- ok && unwrap(mapProtect(p, 3));
            ok <- ok && unwrap(mapAdvise(p, 0));
            ok <- ok && unwrap(mapSync(p, 1));
            ok <- ok && unwrap(unmap(p));
            return ok && !mapIsMapped(p);
        }

    ref main ->> run;

    fa:
        return true;

}
