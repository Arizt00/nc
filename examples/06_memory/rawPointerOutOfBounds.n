use <memory:ptr, heap>;


rawPointerOutOfBounds :: runtime {
    stc:
        p >> p<int>;
        q >> p<int>;
        value    >> int  <- 0;
        distance >> int  <- 0;
        written  >> bool <- false;

    fn:
        run() -> bool {
            p !> p<int> : memory.heap.manager.alloc(8);
            q <- off(p, 3);
            written <- wr(q, 42);
            value <- rd(q);
            distance <- pDiff(q, p);
            memory.heap.manager.free(p);
            return written && value == 42 && distance == 3;

        }

    ref main ->> run;

    fa:
        return true;

}
