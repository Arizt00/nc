use <io:output, render>;

redFisicaInspect :: runtime {
    stc:
        ipRed         >> str  <- "10.0.0.12";
        macRed        >> str  <- "52 <- 74:F2:B1:9C:AA";
        puertoRed     >> int  <- 8080;
        dirFisicaRam  >> addr <- 0x0000000000100000;
        dirFisicaMmio >> addr <- 0x00000000FEE00000;

    fn:
        mostrarRed() -> bool {
            println("===== NETWORK SURFACE =====");
            println("ip   = " + ipRed);
            println("mac  = " + macRed);
            println("port = " + renderInt(puertoRed));
            return true;
        }

        mostrarFisica() -> bool {
            println("===== PHYSICAL SURFACE =====");
            println("phys.ram  = " + renderStable(dirFisicaRam));
            println("phys.mmio = " + renderStable(dirFisicaMmio));
            return true;
        }

    to main {
    mostrarRed();
    mostrarFisica();
    }

    fa:
        return true;

}
