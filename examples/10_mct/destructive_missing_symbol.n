use foreign { c };

destructiveMissingSymbol :: runtime {
    foreign:
        c symbol "ncc_example_symbol_that_does_not_exist" {
            abi: C;
            header: "missing.h";
            library: "missing";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            sideEffects: none;
            signature: fn(int) -> int;
        }

    fn:
        run() -> int {
            return ncc_example_symbol_that_does_not_exist(42);
        }

    ref main ->> run;

    fa:
        return true;

}
