use <collections:list>;

collectionClearNameCollision :: runtime {
    stc:
        values >> Array<int>;

    fn:
        clear() -> bool {
            return true;
        }

        reset() -> int {
            values.push(7);
            values.clear();
            return values.len;
        }

    ref main ->> reset;

    fa:
        return true;

}
