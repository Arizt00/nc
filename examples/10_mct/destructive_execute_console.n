use <io:output>;

destructiveConsoleRun :: runtime {
    fn:
        run() -> int {
            println("omit: this line must disappear");
            println("repeat: this line is emitted twice");
            println("split: this line exists here and at the tail");
            println("once: this line is emitted once");
            return 0;
        }

    ref main ->> run;

    fa:
        return true;

}
