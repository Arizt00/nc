use <memory:ptr, heap>;

destructivePointerProfile :: runtime {
    fn:
        run() -> int {
            memory >> p<byte> <- alloc(16);
            wr(memory, 41);
            value >> int <- rd(memory);
            free(memory);
            return value + 1;
        }

    ref main ->> run;

    fa:
        return true;

}
