use <io:output, render>;
use <memory:ptr, heap>;

destructivePointerRun :: runtime {
    fn:
        run() -> int {
            println("omit: before allocation");
            println("repeat: before allocation");
            println("split: before allocation");
            memory >> p<byte> <- alloc(16);

            println("omit: before write");
            println("repeat: before write");
            println("split: before write");
            wr(memory, 42);

            println("omit: before read");
            println("repeat: before read");
            println("split: before read");
            println("pointer value=" + renderInt(rd(memory)));

            println("omit: before free");
            println("repeat: before free");
            println("split: before free");
            free(memory);

            println("omit: before return");
            println("repeat: before return");
            println("split: before return");
            return 0;
        }

    ref main ->> run;

    fa:
        return true;

}
