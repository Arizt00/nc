typeLocalMachineMaterialization {
    Header :: type {
        kind >> byte;
        code >> int;
    }

    Pair :: type {
        left >> int;
        right >> qword;
    }

    const:
        expected >> int <- 7;

    stc:
        header >> Header;
        pair >> Pair;

    fn:
        run() -> bool {
            header.kind <- 1;
            header.code <- expected;
            pair.left <- header.code;
            pair.right <- 9;
            return header.kind == 1
                && pair.left == 7
                && pair.right == 9;
        }

    ref main ->> run;
}
