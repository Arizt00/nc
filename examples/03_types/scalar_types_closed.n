use <io:output, render>;

scalarTypesClosed :: runtime {
    stc:
        b >> byte;
        sb >> sbyte;
        w >> word;
        sw >> sword;
        dw >> dword;
        sdw >> sdword;
        qw >> qword;
        sqw >> sqword;
        i8v >> int8;
        i16v >> int16;
        i32v >> int32;
        i64v >> int64;
        u8v >> uint8;
        u16v >> uint16;
        u32v >> uint32;
        u64v >> uint64;
        i >> int;
        u >> uint;
        f32v >> ft32;
        f64v >> ft64;
        f >> ft;
        c >> char;
        label >> str;
        ok >> bool;
        checksum >> int;

    fn:
        run() -> bool {
            b >> byte <- 255;
            sb >> sbyte <- -8;
            w >> word <- 65535;
            sw >> sword <- -32000;
            dw >> dword <- 1024;
            sdw >> sdword <- cast(-2048);
            qw >> qword <- 4096;
            sqw >> sqword <- -8192;
            i8v >> int8 <- -7;
            i16v >> int16 <- -1234;
            i32v >> int32 <- 123456;
            i64v >> int64 <- -654321;
            u8v >> uint8 <- 200;
            u16v >> uint16 <- 65000;
            u32v >> uint32 <- 42;
            u64v >> uint64 <- 88;
            i >> int <- 7;
            u >> uint <- 8;
            f64v >> ft64 <- 2.5;
            f >> ft <- 3.5;
            c >> char <- 'Z';
            label >> str <- "scalar";
            byteAsInt >> int <- cast(b);
            sbyteAsInt >> int <- cast(sb);
            uintAsInt >> int <- cast(u);
            uint32AsInt >> int <- cast(u32v);
            checksum >> int <- byteAsInt + sbyteAsInt + i + uintAsInt + uint32AsInt;
            ok >> bool <- c == 'Z' && checksum == 304;

            println(colorBold("===== escalares cerrados =====", "cyan"));
            println(label + ".char=" + renderChar(c));
            println("checksum=" + renderInt(checksum));
            println("ft32=" + renderFloat(f32v, 1));
            println("ft64=" + renderFloat(f64v, 1));
            println("ft=" + renderFloat(f, 1));
            println("ok=" + renderBool(ok));
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
