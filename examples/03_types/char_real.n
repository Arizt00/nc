use <io:output, render>;

charReal :: runtime {
    stc:
        letra >> char;
        otra >> char;
        ok >> bool;

    fn:
        run() -> bool {
            letra >> char <- 'A';
            otra >> char <- 'B';
            ok <- letra < otra;

            println("letra=" + renderChar(letra));
            println("otra=" + renderChar(otra));
            println("tipo=" + renderType(letra));
            println("orden=" + renderBool(ok));

            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
