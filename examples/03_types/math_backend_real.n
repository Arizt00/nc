use <io:output, render>;
use <math:core, numeric, trig>;

mathBackendReal :: runtime {
    stc:
        raiz   >> ft64 <- 0.0;
        expo   >> ft64 <- 0.0;
        seno   >> ft64 <- 0.0;
        coseno >> ft64 <- 0.0;
        angulo >> ft64 <- 0.0;
        loge   >> ft64 <- 0.0;
        ok     >> bool <- false;

    fn:
        run() -> bool {
            raiz <- sqrtFloat(81.0);
            expo <- expFloat(1.0);
            seno <- sinFloat(pi() / 2.0);
            coseno <- cosFloat(0.0);
            angulo <- atan2Float(1.0, 1.0);
            loge <- logFloat(euler());

            ok <- raiz > 8.99 && raiz < 9.01;
            ok <- ok && seno > 0.99 && seno < 1.01;
            ok <- ok && coseno > 0.99 && coseno < 1.01;
            ok <- ok && loge > 0.99 && loge < 1.01;

            println(colorBold("===== MATH BACKEND REAL =====", "cyan"));
            println("sqrtFloat(81) = " + renderFloat(raiz, 4));
            println("expFloat(1)   = " + renderFloat(expo, 6));
            println("sinFloat(pi/2)= " + renderFloat(seno, 6));
            println("cosFloat(0)   = " + renderFloat(coseno, 6));
            println("atan2(1,1)    = " + renderFloat(angulo, 6));
            println("logFloat(e)   = " + renderFloat(loge, 6));
            println("pi digits     = " + piDigits());
            println("euler digits  = " + eulerDigits());
            println("aureo digits  = " + aureoDigits());
            println("ok = " + renderBool(ok));

            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
