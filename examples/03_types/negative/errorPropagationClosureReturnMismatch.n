errorPropagationClosureReturnMismatch {
    fn:
        source() -> Result<int, str> {
            return ok(7);
        }

        run() -> int {
            relay >> fn() -> int <- || -> int {
                value >> int <- source()?;
                return value;
            };
            return relay();
        }

    ref main ->> run;

    fa:
        return true;

}
