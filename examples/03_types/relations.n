mathCore {
    fn:
        sumar(a >> int, b >> int) -> int {
            return a + b;
        }

    fa:
        return true;

}

relations {
    stc:
        estado >> int;

    fn:
        validarYSumar(x >> int, y >> int) -> int {
            return mathCore.sumar(x, y);
        }

        boot() -> int {
            estado <- validarYSumar(7, 8);
            return estado;
        }

    ref main ->> boot;

    fa:
        return true;

}
