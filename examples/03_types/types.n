use <io:output, render>;

typesCompacto {
    Punto :: type {
            x >> int;
            y >> int;
    }

    stc:
        p >> Punto;
        modulo >> int <- 0;

    fn:
        run() -> bool {
            p.x <- 3;
            p.y <- 4;
            modulo <- (p.x * p.x) + (p.y * p.y);
            println("modulo2 = " + renderInt(modulo));
            return modulo == 25;
        }

    ref main ->> run;

    fa:
        return true;

}
