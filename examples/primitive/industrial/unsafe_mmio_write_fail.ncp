primitive[@] target x86_64:
    capability hw:
        allow port.write;
    operation kernelEntry():
        capability hw;
        mmioWrite 0xFEE00000 <- 0x01 volatile;
        barrier io;
        haltLoop;
    anchor boot0:
        addr physaddr(0x0000_7C00);
    entry kernelEntry:
        anchor boot0;
        mode real16;
    bridge:
        root.policy.bind;
        root.policy.guard;
        root.memory.resolve;
        machine.machineCore;
    seal:
        primitiveClosed;
