primitive[@]:
    voltage:
        vcore;
    current:
        rail0;
    noise:
        emi0;
    clock:
        core_clk;
    edge:
        rising;
    metastability:
        cdc0;
    power:
        pstate0;
    powerGate:
        pg0;
    temperature:
        sensor0;
    thermalState:
        thermal_nominal;
    throttleState:
        throttle_none;
    watchdog:
        wd0;
    interruptLine:
        irq0;
    dmaChannel:
        dma0;
    cacheState:
        l1_clean;
    tlbState:
        tlb_hot;
    firmwareRegion:
        fw0;
    bootRomRegion:
        rom0;
    biosRegion:
        bios0;
    uefiHandoff:
        handoff0;
    resetVector:
        reset0;
    bootWindow:
        bootwin0;
    bootAnchor:
        boot0;
    firmwareTable:
        fwtable0;
    deviceTree:
        dt0;
    acpiTable:
        acpi0;
    microcodeState:
        patch_state0;
    controller:
        uart_ctrl;
    peripheral:
        uart0;
    phy:
        uart_phy;
    lane:
        lane0;
    channel:
        ch0;
    pipelineState:
        fetch_decode;
    branchPredictorState:
        bp0;
    reorderState:
        rob0;
    outOfOrder:
        ooo_enabled;
    physicalFault:
        thermal_trip;
    busFault:
        bus_busy;
    signalLoss:
        signal_drop;
    timingViolation:
        missed_deadline;
    thermalViolation:
        overheat;
    metastabilityRisk:
        cdc_risk;
    dmaViolation:
        dma_race;
    cacheCoherenceViolation:
        stale_line;
    mmioSideEffectViolation:
        read_clears_flag;

    capability hw:
        allow port.write;
        allow port.read;

    port uart0.data:
        addr ioaddr(0x03F8);

    window status:
        cache uncached;

    operation kernelEntry():
        capability hw;
        event interrupt irq0;
        event dmaCompletion dma0;
        event watchdogTrip wd0;
        event mmioReadClearsFlag status.ready;
        event peripheralStateChange uart0;
        event physicalFault thermal_trip;
        event physicalFault missed_deadline;
        event physicalFault dma_race;
        event physicalFault read_clears_flag;
        event physicalFault bus_busy;
        event physicalFault signal_drop;
        event physicalFault overheat;
        event physicalFault stale_line;
        mmioRead 0x0040 volatile;
        read side_effect clears_status_flag;
        write uart0.data <- 0x41;
        barrier io;
        haltLoop;

    anchor:
        boot0;

    rupture:
        thermal_trip;

    bridge:
        root.policy.bind;
        root.policy.guard;
        root.memory.resolve;
        machine.machineCore;

    seal:
        primitiveClosed;
