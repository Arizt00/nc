primitive[@]:
    capability material_io:
        allow port.read;
        allow port.write;

    port uart0.data:
        addr ioaddr(0x03F8);

    port uart0.status:
        addr ioaddr(0x03FD);

    operation kernelEntry():
        capability material_io;
        portWrite uart0.data <- 0x41;
        portRead uart0.status;
        mmioWrite 0x0040 <- 0x01 volatile;
        mmioRead 0x0040 volatile;
        read side_effect none;
        volatileWrite 0x0050 <- 0x02;
        volatileRead 0x0050;
        fence;
        cpuPause;
        haltLoop;

    anchor:
        boot0;

    bridge:
        root.memory.resolve;

    seal:
        primitiveClosed;
