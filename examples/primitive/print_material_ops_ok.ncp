primitive[@]:
    capability material_io:
        allow port.write;

    port uart0.data:
        addr ioaddr(0x03F8);

    operation kernelEntry():
        capability material_io;
        print.port uart0.data <- 0x41;
        print.mmio 0x0040 <- 0x01 volatile;
        barrier io;
        haltLoop;

    anchor:
        boot0;

    bridge:
        root.memory.resolve;
        root.policy.guard;
        machine.machineCore;

    seal:
        primitiveClosed;
