machineCore[@machine] {
    reg:
        ax;

    inst:
        entry:
        ret;

    final:
        ret;
}

primitiveSensoryGate[@primitive] target x86_64 {
    peripheral:
        sensory0;

    capability sensory_cap:
        allow signal.sample;

    operation kernelEntry():
        capability sensory_cap;
        print.sensory("pulse");
        haltLoop;

    anchor boot0:
        addr physaddr(0x0000_7C00);
        width 512;

    bridge:
        root.policy.bind;
        root.policy.guard;
        root.memory.resolve;
        machine.sensoryCore;

    seal:
        primitiveClosed;
}
