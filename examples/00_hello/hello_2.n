use <io:output, random, fs>;

hello :: runtime {
    stc:
        semilla >> int;
        tono >> int;
        sujeto >> int;
        accion >> int;
        cierre >> int;
        texto >> str;

    fn:
        palabraTono(codigo >> int) -> str {
            match (codigo) {
                case 0 => { return "Brillante"; }
                case 1 => { return "Silencioso"; }
                case 2 => { return "Electrico"; }
                default => { return "Soberano"; }
            }
        }

        palabraSujeto(codigo >> int) -> str {
            match (codigo) {
                case 0 => { return "el compilador"; }
                case 1 => { return "la memoria"; }
                case 2 => { return "el runtime"; }
                default => { return "el backend"; }
            }
        }

        palabraAccion(codigo >> int) -> str {
            match (codigo) {
                case 0 => { return "ordena bits con calma"; }
                case 1 => { return "enciende rutas nuevas"; }
                case 2 => { return "traduce ideas a maquina"; }
                default => { return "guarda texto generado"; }
            }
        }

        palabraCierre(codigo >> int) -> str {
            match (codigo) {
                case 0 => { return "y deja una huella en disco."; }
                case 1 => { return "mientras nC respira en pantalla."; }
                case 2 => { return "con una sonrisa de sistemas."; }
                default => { return "listo para la siguiente prueba."; }
            }
        }

        generarTexto() -> bool {
            tono >> int <- randomRange(0, 3);
            sujeto >> int <- randomRange(0, 3);
            accion >> int <- randomRange(0, 3);
            cierre >> int <- randomRange(0, 3);

            texto <-
                palabraTono(tono) + ": " +
                palabraSujeto(sujeto) + " " +
                palabraAccion(accion) + ", " +
                palabraCierre(cierre);

            return true;
        }

    to main {
    semilla >> int <- randomRange(1000, 9999);
    generarTexto();

    println("Booting nC text generator...");
    println("System OK");
    println("seed=");
    println(semilla);

    println("");
    println("Texto generado:");
    println(texto);

    writeFile("generadorTexto.txt", texto);
    println("Archivo solicitado: generadorTexto.txt");
    }

    fa:
        return true;

}
