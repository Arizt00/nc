use <io:output, render>;

buclesEtiquetados :: runtime {
    stc:
        i >> int <- 0;
        j >> int <- 0;
        k >> int <- 0;
    fn:
        run() -> bool {
            outer: for (i <- 1; i <= 3; i++) {
                for (j <- 1; j <= 3; j++) {
                    for (k <- 1; k <= 3; k++) {
                        if (i == 2 && j == 2 && k == 2) {
                            break outer;
                        }

                        print(
                            renderInt((i * 100) + (j * 10) + k) + " "
                        );
                    }
                }
            }

            println("");
            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
