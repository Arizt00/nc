use <io:output, render>;

helloWorld {
    stc:
        appName >> str;

    fn:
        boot() -> bool {
            appName >> str <- "nC";
            return true;
        }

        greeting() -> str {
            return "Hello, world " + appName + "!";
        }

        run() -> bool {
            boot();
            println(colorBold(greeting(), "cyan"));
            println(color("runtime listo", "green"));
            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
