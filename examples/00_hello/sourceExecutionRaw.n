use <collections:list>;
use <io:output>;
use <memory:stack>;

sourceExecutionRaw :: runtime {
    fn:
        run() -> bool {
            mark >> p<byte> <- stackMark();
            cells >> p<int> <- cast(stackAlloc(3 * sizeOf(int), alignOf(int)));
            items >> list<int> <- listAt(cells, 0, 3);
            wr(off(cells, 0), 1);
            wr(off(cells, 1), 2);
            wr(off(cells, 2), 3);
            items.len <- 3;
            message >> str <- "manual" + "-raw";
            println(message);
            ok >> bool <- rd(cells) == 1;
            stackRestore(mark);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
