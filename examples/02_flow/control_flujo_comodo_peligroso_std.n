use <io:output, render, input>;
use <memory:ptr, heap>;

controlFlujoComodoPeligrosoOficial :: runtime {
    stc:
        p >> p<int>;
        numero  >> int  <- 0;
        cleanup >> bool <- false;
        ok      >> bool <- false;

    fn:
        readInt() -> int {
            return 42;
        }

        probarFinal() -> bool {
            cleanup <- false;
            final cleanup <- true;
            return true;
        }

        run() -> bool {
            p !> p<int> : alloc(16);
            guard p != null else return false;
            defer free(p);

            numero <- readInt();

            ok <- probarFinal() && cleanup && numero == 42;

            println("numero=" + renderInt(numero));
            println("cleanup=" + renderBool(cleanup));
            println("ok=" + renderBool(ok));

            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
