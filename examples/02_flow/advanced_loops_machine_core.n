use <collections:result>;

advancedLoopsMachineCore :: runtime {
    stc:
        arr >> array<int, 4>;
        sum >> int;
        i >> int;
        passed >> bool;

    fn:
        run() -> bool {
            arr <- [1, 2, 3, 4];
            sum <- 0;
            i <- 0;

            async for value in arr {
                sum <- sum + value;
            }

            parallel for n in 0..3 {
                sum <- sum + n;
            }

            comptime for c in 0..=2 step 1 {
                sum <- sum + c;
            }

            comptime for d in 3..=1 step -1 {
                sum <- sum + d;
            }

            do {
                sum <- sum + 1;
            } while (false);

            while let ok(v: int) <- ok(5) {
                sum <- sum + v;
                break;
            }

            outer: loop {
                i <- i + 1;
                inner: loop {
                    if (i == 2) {
                        break outer;
                    }
                    continue outer;
                }
            }

            passed <- sum == 28 && i == 2;
            return passed;
        }

    ref main ->> run;

    fa:
        return true;

}
