use <io:output, render>;

flowCompacto {
    stc:
        i   >> int <- 0;
        acc >> int <- 0;

    fn:
        run() -> bool {
            while (i < 5) {
                acc += i;
                i++;
            }
            println("acc = " + renderInt(acc));
            return acc == 10;
        }

    ref main ->> run;

    fa:
        return true;

}
