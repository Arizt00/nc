use core { math };

typeCore :: system {
    fn:
        test(x >> skk* | null, y >> int | null) -> bool {
            if (x !> skk* : x && y !> int : y) {
                return true;
            } else {
                x !> skk* : x; // aquí x puede ser null
                return false;
            }
        }

    fa:
        return true;

}
