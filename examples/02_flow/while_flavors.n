use <io:output>;

contador {
    ConteoResultado :: type {
            esperado >> int;
            machine >> int;
            structural >> int;
            declarative >> int;
            checksum >> int;
        stable:
            deterministic;
    }

    const:
        CasoNegativo >> int <- 0 - 3;
        CasoCero >> int <- 0;
        CasoUno >> int <- 1;
        CasoSiete >> int <- 7;
        CasosEsperados >> int <- 4;
        TotalEsperado >> int <- 24;

    stc:
        total  >> int  <- 0;
        ultimo >> int  <- 0;
        ok     >> bool <- false;

        limite      >> int <- 0;
        i           >> int <- 0;
        restante    >> int <- 0;
        pasos       >> int <- 0;
        suma        >> int <- 0;
        esperado    >> int <- 0;
        machine     >> int <- 0;
        structural  >> int <- 0;
        declarative >> int <- 0;
        caso        >> int <- 0;

    fn:
        contarMachine(a >> int) -> int {
            limite <- a;
            if (limite < 0) {
                limite <- 0;
            }

            i <- 0;
            restante <- limite;

            while (restante > 0) {
                i <- i + 1;
                restante <- restante - 1;
            }

            if (i != limite) {
                return 0 - 1;
            }
            if (restante != 0) {
                return 0 - 1;
            }
            return i;
        }

        contarStructural(a >> int) -> int {
            limite <- a;
            if (limite < 0) {
                limite <- 0;
            }

            i <- 0;
            pasos <- 0;

            while (i < limite) {
                i <- i + 1;
                pasos <- pasos + 1;
            }

            if (pasos != i) {
                return 0 - 1;
            }
            if (pasos != limite) {
                return 0 - 1;
            }
            return i;
        }

        contarDeclarative(a >> int) -> int {
            limite <- a;
            if (limite < 0) {
                limite <- 0;
            }

            i <- 0;
            suma <- 0;

            while (suma < limite) {
                suma <- suma + 1;
                i <- suma;
            }

            if (i != limite) {
                return 0 - 1;
            }
            if (suma != limite) {
                return 0 - 1;
            }
            return i;
        }

        validarCaso(a >> int) -> bool {
            esperado <- a;
            if (esperado < 0) {
                esperado <- 0;
            }

            machine <- contarMachine(a);
            structural <- contarStructural(a);
            declarative <- contarDeclarative(a);
            ultimo <- machine + structural + declarative;

            if (machine != esperado) {
                return false;
            }
            if (structural != esperado) {
                return false;
            }
            if (declarative != esperado) {
                return false;
            }
            if (machine != structural) {
                return false;
            }
            if (structural != declarative) {
                return false;
            }
            return ultimo == esperado + esperado + esperado;
        }

        sumarCaso(a >> int) -> int {
            ok <- validarCaso(a);
            if (ok == false) {
                return 0 - 1;
            }

            machine <- contarMachine(a);
            structural <- contarStructural(a);
            declarative <- contarDeclarative(a);
            return machine + structural + declarative;
        }

        run() -> bool {
            caso <- 0;
            total <- 0;

            ultimo <- sumarCaso(CasoNegativo);
            if (ultimo < 0) {
                return false;
            }
            caso <- caso + 1;
            total <- total + ultimo;

            ultimo <- sumarCaso(CasoCero);
            if (ultimo < 0) {
                return false;
            }
            caso <- caso + 1;
            total <- total + ultimo;

            ultimo <- sumarCaso(CasoUno);
            if (ultimo < 0) {
                return false;
            }
            caso <- caso + 1;
            total <- total + ultimo;

            ultimo <- sumarCaso(CasoSiete);
            if (ultimo < 0) {
                return false;
            }
            caso <- caso + 1;
            total <- total + ultimo;

            machine <- contarMachine(CasoSiete);
            structural <- contarStructural(CasoSiete);
            declarative <- contarDeclarative(CasoSiete);
            ok <- false;
            if (caso == CasosEsperados) {
                if (total == TotalEsperado) {
                    ok <- true;
                }
            }

            println("contador");
            print("casos = ");
            println(caso);
            print("total = ");
            println(total);
            print("machine(7) = ");
            println(machine);
            print("structural(7) = ");
            println(structural);
            print("declarative(7) = ");
            println(declarative);
            print("ok = ");
            if (ok) {
                println("true");
            } else {
                println("false");
            }
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
