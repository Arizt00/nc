use <collections:list>;
use <io:output, render>;

listasCompactas {
    stc:
        datos >> list<int>;
        total >> int <- 0;

    fn:
        run() -> bool {
            datos <- [2, 4, 6];
            total <- datos.get(0) + datos.get(1) + datos.get(2);
            println("total = " + renderInt(total));
            return total == 12;
        }

    ref main ->> run;

    fa:
        return true;

}
