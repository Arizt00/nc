use <io:output>;

f7ConsoleRenderModes :: runtime {
    stc:
        n >> int;
        s >> str;
        b >> bool;

    to main {
        n >> int  <- 42;
        s >> str  <- "hola";
        b >> bool <- true;

        println(n);
        println(s);
        println(s);
        println(b);
        println(n);

        return true;
    }

    fa:
        return true;

}
