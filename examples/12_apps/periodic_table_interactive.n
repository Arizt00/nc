                if (c == 6) { return 59; }
                if (c == 7) { return 60; }
                if (c == 8) { return 61; }
                if (c == 9) { return 62; }
                if (c == 10) { return 63; }
                if (c == 11) { return 64; }
                if (c == 12) { return 65; }
                if (c == 13) { return 66; }
                if (c == 14) { return 67; }
                if (c == 15) { return 68; }
                if (c == 16) { return 69; }
                if (c == 17) { return 70; }
                if (c == 18) { return 71; }
