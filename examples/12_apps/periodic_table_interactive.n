        grupoAproximado(z >> int) -> int {
            if (z == 1) { return 1; }
            if (z == 2) { return 18; }
            if (familiaId(z) == 1) { return 1; }
            if (familiaId(z) == 2) { return 2; }
            if (familiaId(z) == 7) { return 17; }
            if (familiaId(z) == 8) { return 18; }
            if (rango(z, 21, 30)) { return z - 18; }
            if (rango(z, 39, 48)) { return z - 36; }
            if (rango(z, 72, 80)) { return z - 68; }
            if (rango(z, 104, 112)) { return z - 100; }
            if (rango(z, 5, 10)) { return z + 8; }
            if (rango(z, 13, 18)) { return z; }
            if (rango(z, 31, 36)) { return z - 18; }
            if (rango(z, 49, 54)) { return z - 36; }
            if (rango(z, 81, 86)) { return z - 68; }
            if (rango(z, 113, 118)) { return z - 100; }
            return 3;
        }

