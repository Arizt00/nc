                if (c == 2) { return 88; }
                if (c == 3) { return 89; }
                if (c == 4) { return 104; }
                if (c == 5) { return 105; }
                if (c == 6) { return 106; }
                if (c == 7) { return 107; }
                if (c == 8) { return 108; }
                if (c == 9) { return 109; }
