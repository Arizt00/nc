        celda(z >> int) -> bool {
            if (z == 0) {
                print("        ");
                return true;
            }
            familia >> int <- familiaId(z);
            print(colorBold("[" + n3(z) + simbolo(z) + "]", familiaColor(familia)));
            return true;
        }

        vacio(cuantos >> int) -> bool {
            columna >> int <- 0;
            while (columna < cuantos) {
                print("        ");
                columna >> int <- columna + 1;
            }
            return true;
        }

        filaLineal(nombreFila >> str, inicio >> int, fin >> int) -> bool {
            print(nombreFila);
            numero >> int <- inicio;
            while (numero < fin) {
                celda(numero);
                numero >> int <- numero + 1;
            }
            println("");
            return true;
        }

        cabeceraCanvas() -> bool {
            println("");
            println(colorBold("Canvas 2D terminal: filas 1..9, columnas 1..18", "cyan"));
            println(color("Cada bloque es una celda dibujada por coordenada logica.", "grey"));
            print("      ");
            columna >> int <- 1;
            while (columna < 19) {
                if (columna < 10) {
                    print("   " + renderInt(columna) + "    ");
                }
                if (columna > 9) {
                    print("  " + renderInt(columna) + "    ");
                }
                columna >> int <- columna + 1;
            }
            println("");
            return true;
        }

        dibujarTabla() -> bool {
            cabeceraCanvas();
            print("P1   ");
            celda(1);
            vacio(16);
            celda(2);
            println("");

            print("P2   ");
            celda(3);
            celda(4);
            vacio(10);
            filaLineal("", 5, 11);

            print("P3   ");
            celda(11);
            celda(12);
            vacio(10);
            filaLineal("", 13, 19);

            filaLineal("P4   ", 19, 37);
            filaLineal("P5   ", 37, 55);

            print("P6   ");
            celda(55);
            celda(56);
            celda(57);
            filaLineal("", 72, 87);

            print("P7   ");
            celda(87);
            celda(88);
            celda(89);
            filaLineal("", 104, 119);

            print("Ln   ");
            vacio(3);
            filaLineal("", 57, 72);

            print("Ac   ");
            vacio(3);
            filaLineal("", 89, 104);
            println("");
            println(color("Leyenda: amarillo alcalinos/actinidos, verde alcalinoterreos, cyan transicion/lantanidos, rojo halogenos, gris nobles.", "grey"));
            return true;
        }

        ficha(z >> int) -> bool {
            if (z < 1) {
                println(colorBold("Numero atomico fuera de rango.", "red"));
                return false;
            }
            if (z > 118) {
                println(colorBold("Numero atomico fuera de rango.", "red"));
                return false;
            }
            familia >> int <- familiaId(z);
            linea(familiaColor(familia));
            println(colorBold(nombre(z) + " (" + simbolo(z) + ")", familiaColor(familia)));
            println("Numero atomico: " + renderInt(z));
            println("Familia: " + familiaNombre(familia));
            periodoListo >> bool <- imprimirPeriodo(z);
            println("Grupo aproximado: " + renderInt(grupoAproximado(z)));
            println("Estado a temperatura ambiente: " + estado(z));
            println("Resumen: " + resumenFamilia(familia));
            linea(familiaColor(familia));
            return true;
        }

        buscarNumero() -> bool {
            print(colorBold("Numero atomico (1..118): ", "yellow"));
            numero >> int <- readInt();
            ficha(numero);
            return true;
        }

        buscarTexto() -> bool {
            print(colorBold("Simbolo o nombre exacto: ", "yellow"));
            query >> str <- readLine();
            if (strEq(query, "")) {
                query >> str <- readLine();
            }
            numero >> int <- 1;
            while (numero < 119) {
                if (strEq(query, simbolo(numero))) {
                    ficha(numero);
                    return true;
                }
                if (strEq(query, nombre(numero))) {
                    ficha(numero);
                    return true;
                }
                numero >> int <- numero + 1;
            }
            println(colorBold("No encontrado. Usa mayusculas en simbolos: Fe, Au, Og.", "red"));
            return false;
        }

        listarFamilia() -> bool {
            println(colorBold("Familias", "cyan"));
            println("1 alcalinos");
            println("2 alcalinoterreos");
            println("3 transicion");
            println("4 post-transicion");
            println("5 metaloides");
            println("6 no metales reactivos");
            println("7 halogenos");
            println("8 gases nobles");
            println("9 lantanidos");
            println("10 actinidos");
            print(colorBold("Elige familia: ", "yellow"));
            familia >> int <- readInt();
            numero >> int <- 1;
            while (numero < 119) {
                if (familiaId(numero) == familia) {
                    print(colorBold(n3(numero) + " " + simbolo(numero) + " " + nombre(numero), familiaColor(familia)));
                    println("");
                }
                numero >> int <- numero + 1;
            }
            return true;
        }

