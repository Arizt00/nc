                return false;
            }
            println(color("Click terminal en (" + renderInt(fila) + ", " + renderInt(columna) + ")", "grey"));
            ficha(numero);
            return true;
        }

        prepararGrafica() -> bool {
            layout.ancho <- 1560;
            layout.alto <- 940;
            layout.tablaX <- 24;
            layout.tablaY <- 154;
            layout.celdaW <- 58;
            layout.celdaH <- 56;
            layout.panelX <- 1090;
            layout.panelW <- 430;
            paleta >> array<int, 11> <- [
                0x6b7280,
                0xf2c94c,
                0x6fcf97,
                0x56b4d3,
                0x4f86c6,
                0xb77ad8,
                0xe8e8e8,
                0xef6f6c,
                0x9aa6b2,
                0x58c7b5,
                0xff9f68
            ];
            historial >> list<int> <- listCreate<int>();
            seleccionado >> int <- 0;
            hover >> int <- 0;
            filtro >> int <- 0;
            tick >> int <- 0;
            modoBusqueda >> int <- 0;
            numeroEntrada >> int <- 0;
            query >> str <- "";
            mensajeUi >> str <- "";
            clickPrevio >> bool <- false;
            animacion >> bool <- true;
            sucio >> bool <- true;
            ultimoSeleccionado >> int <- -1;
            ultimoHover >> int <- -1;
            ultimoFiltro >> int <- -1;
            ultimoModo >> int <- -1;
            ultimoNumeroEntrada >> int <- -1;
            ultimaAnimacion >> bool <- false;
            ultimaQuery >> str <- "";
            ultimoMensaje >> str <- "";
            return true;
        }

        familiaRgb(id >> int) -> int {
            if (id < 0) { return paleta[0]; }
            if (id > 10) { return paleta[0]; }
            return paleta[id];
        }

        familiaCorta(id >> int) -> str {
            if (id == 1) { return "Alcalinos"; }
            if (id == 2) { return "Alcalinot."; }
            if (id == 3) { return "Transicion"; }
            if (id == 4) { return "Post-metal"; }
            if (id == 5) { return "Metaloides"; }
            if (id == 6) { return "No metales"; }
            if (id == 7) { return "Halogenos"; }
            if (id == 8) { return "Nobles"; }
            if (id == 9) { return "Lantanidos"; }
            if (id == 10) { return "Actinidos"; }
            return "Todas";
        }

        resumenA(id >> int) -> str {
            if (id == 1) { return "Metal blando y muy reactivo."; }
            if (id == 2) { return "Metal ligero presente en minerales."; }
            if (id == 3) { return "Conductor, ductil y util en aleaciones."; }
            if (id == 4) { return "Metal de bloque p y baja fusion."; }
            if (id == 5) { return "Frontera entre metal y no metal."; }
            if (id == 6) { return "Base de vida, atmosfera y agua."; }
            if (id == 7) { return "Oxidante potente que forma sales."; }
            if (id == 8) { return "Capa electronica cerrada y estable."; }
            if (id == 9) { return "Tierra rara de la serie f."; }
            if (id == 10) { return "Serie f pesada y radiactiva."; }
            return "Propiedades mixtas de frontera.";
        }

        resumenB(id >> int) -> str {
            if (id == 1) { return "Se conserva lejos de agua y aire."; }
            if (id == 2) { return "Importante en estructuras y biologia."; }
            if (id == 3) { return "Clave para energia y maquinaria."; }
            if (id == 4) { return "Uso electrico y estructural."; }
            if (id == 5) { return "Esencial en semiconductores."; }
            if (id == 6) { return "Participa en quimica organica."; }
            if (id == 7) { return "Reacciona con numerosos metales."; }
            if (id == 8) { return "Iluminacion y atmosferas inertes."; }
            if (id == 9) { return "Optica, imanes y catalisis."; }
            if (id == 10) { return "Energia nuclear e investigacion."; }
            return "Depende de estructura y enlace.";
        }

        seleccionar(z >> int) -> bool {
            if (z < 1) { return false; }
            if (z > 118) { return false; }
            seleccionado >> int <- z;
            if (historial.len() > 31) {
                historial.removeAt(0);
            }
            historial.push(z);
            mensajeUi >> str <- "Seleccion: " + nombre(z);
            return true;
        }

        teclaTexto(codigo >> int) -> str {
            if (codigo == 48) { return "0"; }
            if (codigo == 49) { return "1"; }
            if (codigo == 50) { return "2"; }
            if (codigo == 51) { return "3"; }
            if (codigo == 52) { return "4"; }
            if (codigo == 53) { return "5"; }
            if (codigo == 54) { return "6"; }
            if (codigo == 55) { return "7"; }
            if (codigo == 56) { return "8"; }
            if (codigo == 57) { return "9"; }
            if (codigo == 65) { return "a"; }
            if (codigo == 66) { return "b"; }
            if (codigo == 67) { return "c"; }
            if (codigo == 68) { return "d"; }
            if (codigo == 69) { return "e"; }
            if (codigo == 70) { return "f"; }
            if (codigo == 71) { return "g"; }
            if (codigo == 72) { return "h"; }
            if (codigo == 73) { return "i"; }
            if (codigo == 74) { return "j"; }
            if (codigo == 75) { return "k"; }
            if (codigo == 76) { return "l"; }
            if (codigo == 77) { return "m"; }
            if (codigo == 78) { return "n"; }
            if (codigo == 79) { return "o"; }
            if (codigo == 80) { return "p"; }
            if (codigo == 81) { return "q"; }
            if (codigo == 82) { return "r"; }
            if (codigo == 83) { return "s"; }
            if (codigo == 84) { return "t"; }
            if (codigo == 85) { return "u"; }
            if (codigo == 86) { return "v"; }
            if (codigo == 87) { return "w"; }
            if (codigo == 88) { return "x"; }
            if (codigo == 89) { return "y"; }
            if (codigo == 90) { return "z"; }
            if (codigo == 32) { return " "; }
            return "";
        }

        buscarIdGrafico(texto >> str) -> int {
            query >> str <- strToLower(texto);
            numero >> int <- 1;
            while (numero < 119) {
                entradaTecla >> str <- strToLower(simbolo(numero));
                if (strEq(query, entradaTecla)) { return numero; }
                entradaTecla >> str <- strToLower(nombre(numero));
                if (strEq(query, entradaTecla)) { return numero; }
                numero >> int <- numero + 1;
            }
            return 0;
        }

        dentro(px >> int, py >> int, x >> int, y >> int, w >> int, h >> int) -> bool {
            if (px < x) { return false; }
            if (py < y) { return false; }
            if (px >= x + w) { return false; }
            if (py >= y + h) { return false; }
            return true;
        }

        botonGrafico(x >> int, texto >> str, activoBoton >> bool) -> bool {
            drawColor >> int <- 0x263442;
            if (activoBoton) { drawColor <- 0x3f8f9d; }
            uiOk >> bool <- canvasRect(ventana, x, 88, 136, 36, drawColor);
            uiOk >> bool <- canvasText(ventana, x + 14, 99, texto, 0xffffff);
            return true;
        }

        dibujarCabeceraGrafica() -> bool {
            uiOk >> bool <- canvasRect(ventana, 0, 0, layout.ancho, 76, 0x111820);
            uiOk >> bool <- canvasText(ventana, 24, 20, "TABLA PERIODICA INTERACTIVA", 0xf4c95d);
            uiOk >> bool <- canvasText(ventana, 24, 47, "118 elementos | familias | ficha | busqueda | mouse + teclado", 0x9fd3ff);
            drawX >> int <- 24 + ((tick * 13) % 1028);
            uiOk >> bool <- canvasRect(ventana, drawX, 70, 72, 4, 0x58c7b5);
            return true;
        }

        dibujarBusquedaGrafica() -> bool {
            botonGrafico(24, "S  TEXTO", modoBusqueda == 1);
            botonGrafico(170, "N  NUMERO", modoBusqueda == 2);
            botonGrafico(316, "F  FILTRO", filtro > 0);
            botonGrafico(462, "C  LIMPIAR", false);
            uiOk >> bool <- canvasRect(ventana, 620, 88, 448, 36, 0x1a2530);
            if (modoBusqueda == 0) {
                uiOk >> bool <- canvasText(ventana, 636, 99, "Flechas: navegar | Espacio: animacion | ESC: salir", 0xb8c7d4);
            }
            if (modoBusqueda == 1) {
                uiOk >> bool <- canvasText(ventana, 636, 99, "Buscar nombre/simbolo: " + query + "_", 0xffffff);
            }
            if (modoBusqueda == 2) {
                uiOk >> bool <- canvasText(ventana, 636, 99, "Numero atomico: " + renderInt(numeroEntrada) + "_", 0xffffff);
            }
            return true;
        }

        dibujarCeldaGrafica(z >> int, f >> int, c >> int) -> bool {
            drawX >> int <- layout.tablaX + ((c - 1) * layout.celdaW);
            drawY >> int <- layout.tablaY + ((f - 1) * layout.celdaH);
            familia >> int <- familiaId(z);
            drawColor >> int <- familiaRgb(familia);
            drawTextColor >> int <- 0x101820;
            if (filtro > 0) {
                if (familia != filtro) {
                    drawColor >> int <- 0x1b252f;
                    drawTextColor >> int <- 0x748392;
                }
            }
            if (z == seleccionado) {
                uiOk >> bool <- canvasRect(ventana, drawX - 2, drawY - 2, layout.celdaW - 1, layout.celdaH - 1, 0xffffff);
            }
            if (z == hover) {
                uiOk >> bool <- canvasRect(ventana, drawX - 2, drawY - 2, layout.celdaW - 1, layout.celdaH - 1, 0xf4c95d);
            }
            uiOk >> bool <- canvasRect(ventana, drawX, drawY, layout.celdaW - 5, layout.celdaH - 5, drawColor);
            uiOk >> bool <- canvasText(ventana, drawX + 5, drawY + 5, renderInt(z), drawTextColor);
            uiOk >> bool <- canvasText(ventana, drawX + 20, drawY + 26, simbolo(z), drawTextColor);
            return true;
        }

        dibujarTablaGrafica() -> bool {
            uiOk >> bool <- canvasText(ventana, 24, 132, "Grupos  1        2                                                   13   14   15   16   17   18", 0x778899);
            fila >> int <- 1;
            while (fila < 10) {
                columna >> int <- 1;
                while (columna < 19) {
                    numero >> int <- elementoEn(fila, columna);
                    if (numero > 0) {
                        dibujarCeldaGrafica(numero, fila, columna);
                    }
                    columna >> int <- columna + 1;
                }
                fila >> int <- fila + 1;
            }
            uiOk >> bool <- canvasText(ventana, 2, layout.tablaY + (7 * layout.celdaH) + 18, "Ln", 0x58c7b5);
            uiOk >> bool <- canvasText(ventana, 2, layout.tablaY + (8 * layout.celdaH) + 18, "Ac", 0xff9f68);
            return true;
        }

        dibujarLeyendaGrafica() -> bool {
            familia >> int <- 1;
            while (familia < 11) {
                drawX >> int <- 24 + ((familia - 1) * 104);
                if (familia == filtro) {
                    uiOk >> bool <- canvasRect(ventana, drawX - 2, 684, 102, 44, 0xffffff);
                }
                uiOk >> bool <- canvasRect(ventana, drawX, 686, 98, 40, familiaRgb(familia));
                uiOk >> bool <- canvasText(ventana, drawX + 6, 700, familiaCorta(familia), 0x101820);
                familia >> int <- familia + 1;
            }
            return true;
        }

        dibujarFichaGrafica() -> bool {
            uiOk >> bool <- canvasRect(ventana, layout.panelX, 88, layout.panelW, 638, 0x18232d);
            familia >> int <- familiaId(seleccionado);
            uiOk >> bool <- canvasRect(ventana, layout.panelX, 88, 8, 638, familiaRgb(familia));
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 112, "FICHA DEL ELEMENTO", 0x9fd3ff);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 152, n3(seleccionado) + "   " + simbolo(seleccionado), familiaRgb(familia));
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 185, nombre(seleccionado), 0xffffff);
            uiOk >> bool <- canvasLine(ventana, layout.panelX + 24, 216, layout.panelX + 396, 216, 0x405363, 1);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 240, "Familia: " + familiaNombre(familia), 0xd8e2ea);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 272, "Periodo: " + renderInt(periodo(seleccionado)), 0xd8e2ea);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 304, "Grupo aproximado: " + renderInt(grupoAproximado(seleccionado)), 0xd8e2ea);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 336, "Estado: " + estado(seleccionado), 0xd8e2ea);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 386, resumenA(familia), 0xaec2d1);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 414, resumenB(familia), 0xaec2d1);
            uiOk >> bool <- canvasLine(ventana, layout.panelX + 24, 452, layout.panelX + 396, 452, 0x405363, 1);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 476, "Filtro: " + familiaCorta(filtro), 0xf4c95d);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 508, "Historial: " + renderInt(historial.len()) + " selecciones", 0xaec2d1);
            if (hover > 0) {
                uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 540, "Hover: " + nombre(hover) + " (" + simbolo(hover) + ")", 0x58c7b5);
            }
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 588, mensajeUi, 0xffffff);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 644, "Clic: seleccionar | leyenda: filtrar", 0x8095a5);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 674, "N/S buscar | F filtrar | C limpiar", 0x8095a5);
            uiOk >> bool <- canvasText(ventana, layout.panelX + 24, 704, "Flechas navegar | ESC cerrar", 0x8095a5);
            return true;
        }

        dibujarEscenaGrafica() -> bool {
            uiOk >> bool <- canvasClear(ventana, 0x0d141b);
            dibujarCabeceraGrafica();
            dibujarBusquedaGrafica();
            dibujarTablaGrafica();
            dibujarLeyendaGrafica();
            dibujarFichaGrafica();
            return canvasPresent(ventana);
        }

        actualizarHoverGrafico() -> bool {
            mousePx >> int <- mouseX(ventana);
            mousePy >> int <- mouseY(ventana);
            hover >> int <- 0;
            if (mousePx >= layout.tablaX) {
                if (mousePx < layout.tablaX + (18 * layout.celdaW)) {
                    if (mousePy >= layout.tablaY) {
                        if (mousePy < layout.tablaY + (9 * layout.celdaH)) {
                            columna >> int <- ((mousePx - layout.tablaX) / layout.celdaW) + 1;
                            fila >> int <- ((mousePy - layout.tablaY) / layout.celdaH) + 1;
                            hover >> int <- elementoEn(fila, columna);
                        }
                    }
                }
            }
            return true;
        }

        iniciarBusquedaGrafica(modo >> int) -> bool {
            modoBusqueda >> int <- modo;
            query >> str <- "";
            numeroEntrada >> int <- 0;
            mensajeUi >> str <- "Escribe y confirma con ENTER";
            return true;
        }

        ejecutarBusquedaGrafica() -> bool {
            numero >> int <- 0;
            if (modoBusqueda == 1) {
                numero >> int <- buscarIdGrafico(query);
            }
            if (modoBusqueda == 2) {
                numero >> int <- numeroEntrada;
            }
            if (numero > 0) {
                if (numero < 119) {
                    seleccionar(numero);
                    modoBusqueda >> int <- 0;
                    return true;
                }
            }
            mensajeUi >> str <- "No encontrado; revisa la busqueda";
            return false;
        }

        procesarTeclaGrafica(codigo >> int) -> bool {
            if (modoBusqueda > 0) {
                if (codigo == 27) {
                    modoBusqueda >> int <- 0;
                    mensajeUi >> str <- "Busqueda cancelada";
                    return true;
                }
                if (codigo == 13) {
                    return ejecutarBusquedaGrafica();
                }
                if (codigo == 8) {
                    if (modoBusqueda == 1) {
                        numero >> int <- strLen(query);
                        if (numero > 0) {
                            query >> str <- strSubstring(query, 0, numero - 1);
                        }
                    }
                    if (modoBusqueda == 2) {
                        numeroEntrada >> int <- numeroEntrada / 10;
                    }
                    mensajeUi >> str <- "";
                    return true;
                }
                if (modoBusqueda == 2) {
                    if (codigo >= 48) {
                        if (codigo <= 57) {
                            numeroEntrada >> int <- (numeroEntrada * 10) + (codigo - 48);
                        }
                    }
                    return true;
                }
                entradaTecla >> str <- teclaTexto(codigo);
                if (strEq(entradaTecla, "") == false) {
                    query >> str <- query + entradaTecla;
                    mensajeUi >> str <- "";
                }
                return true;
            }
            if (codigo == 27) {
                uiOk >> bool <- windowClose(ventana);
                activo >> bool <- false;
                return true;
            }
            if (codigo == 37) { return seleccionar(seleccionado - 1); }
            if (codigo == 39) { return seleccionar(seleccionado + 1); }
            if (codigo == 78) { return iniciarBusquedaGrafica(2); }
            if (codigo == 83) { return iniciarBusquedaGrafica(1); }
            if (codigo == 67) {
                filtro >> int <- 0;
                mensajeUi >> str <- "Filtro desactivado";
                return true;
            }
            if (codigo == 70) {
                filtro >> int <- filtro + 1;
                if (filtro > 10) { filtro <- 0; }
                mensajeUi >> str <- "Filtro: " + familiaCorta(filtro);
                return true;
            }
            if (codigo == 32) {
                animacion >> bool <- animacion == false;
                return true;
            }
            if (codigo == 13) {
                if (hover > 0) { return seleccionar(hover); }
            }
            return true;
        }

        procesarClickGrafico() -> bool {
            if (dentro(mousePx, mousePy, 24, 88, 136, 36)) { return iniciarBusquedaGrafica(1); }
            if (dentro(mousePx, mousePy, 170, 88, 136, 36)) { return iniciarBusquedaGrafica(2); }
            if (dentro(mousePx, mousePy, 316, 88, 136, 36)) {
                filtro >> int <- filtro + 1;
                if (filtro > 10) { filtro <- 0; }
                mensajeUi >> str <- "Filtro: " + familiaCorta(filtro);
                return true;
            }
            if (dentro(mousePx, mousePy, 462, 88, 136, 36)) {
                filtro >> int <- 0;
                mensajeUi >> str <- "Vista completa";
                return true;
            }
            if (hover > 0) { return seleccionar(hover); }
            if (dentro(mousePx, mousePy, 24, 684, 1040, 44)) {
                familia >> int <- ((mousePx - 24) / 104) + 1;
                if (familia < 11) {
                    filtro >> int <- familia;
                    mensajeUi >> str <- "Filtro: " + familiaCorta(filtro);
                    return true;
                }
            }
            return false;
        }

        actualizarEntradaGrafica() -> bool {
            actualizarHoverGrafico();
            clickActual >> bool <- mouseDown(1);
            if (clickActual) {
                if (clickPrevio == false) {
                    procesarClickGrafico();
                }
            }
            clickPrevio >> bool <- clickActual;
            return true;
        }

        detectarCambioGrafico() -> bool {
            if (ultimoSeleccionado != seleccionado) { sucio <- true; }
            if (ultimoHover != hover) { sucio <- true; }
            if (ultimoFiltro != filtro) { sucio <- true; }
            if (ultimoModo != modoBusqueda) { sucio <- true; }
            if (ultimoNumeroEntrada != numeroEntrada) { sucio <- true; }
            if (ultimaAnimacion != animacion) { sucio <- true; }
            if (strEq(ultimaQuery, query) == false) { sucio <- true; }
            if (strEq(ultimoMensaje, mensajeUi) == false) { sucio <- true; }
            ultimoSeleccionado >> int <- seleccionado;
            ultimoHover >> int <- hover;
            ultimoFiltro >> int <- filtro;
            ultimoModo >> int <- modoBusqueda;
            ultimoNumeroEntrada >> int <- numeroEntrada;
            ultimaAnimacion >> bool <- animacion;
            ultimaQuery >> str <- query;
            ultimoMensaje >> str <- mensajeUi;
            return sucio;
        }

        ejecutarGrafica() -> bool {
            prepararGrafica();
            ventana >> int <- windowOpen("nC - Tabla Periodica Interactiva", layout.ancho, layout.alto);
            if (ventana == 0) { return false; }
            uiOk >> bool <- windowFocus(ventana);
            uiOk >> bool <- seleccionar(1);
            activo >> bool <- true;
            println("Tabla periodica grafica iniciada en ventana Win32.");
            while (activo) {
                tecla >> int <- windowReadKey(ventana);
                if (tecla > 0) { procesarTeclaGrafica(tecla); }
                if (activo) {
                    actualizarEntradaGrafica();
                    if (animacion) { tick <- tick + 1; }
                    detectarCambioGrafico();
                    if (sucio) {
                        dibujarEscenaGrafica();
                        sucio >> bool <- false;
                    } else {
                        if (animacion) {
                            dibujarCabeceraGrafica();
                            uiOk >> bool <- canvasPresent(ventana);
                        }
                    }
                    activo >> bool <- windowPoll(ventana);
                    sleep(24);
                }
            }
            println("Tabla periodica grafica cerrada.");
            return true;
        }

        menu() -> bool {
            linea("cyan");
            println(colorBold("1. Ver tabla completa", "white"));
            println(colorBold("2. Buscar por numero atomico", "white"));
            println(colorBold("3. Buscar por simbolo o nombre", "white"));
            println(colorBold("4. Listar por familia", "white"));
            println(colorBold("5. Evento mouse/canvas por coordenadas", "white"));
            println(colorBold("0. Salir", "white"));
            linea("cyan");
            print(colorBold("Opcion: ", "yellow"));
            opcion >> int <- readInt();
            return true;
        }

        runTerminal() -> bool {
            activo >> bool <- true;
            animarTitulo();
            while (activo) {
                menu();
                if (opcion == 0) {
                    activo >> bool <- false;
                }
                if (opcion == 1) {
                    dibujarTabla();
                    pausa();
                }
                if (opcion == 2) {
                    buscarNumero();
                    pausa();
                }
                if (opcion == 3) {
                    buscarTexto();
                    pausa();
                }
                if (opcion == 4) {
                    listarFamilia();
                    pausa();
                }
                if (opcion == 5) {
                    eventoMouseTerminal();
                    pausa();
                }
            }
            println(colorBold("Tabla cerrada.", "cyan"));
            return true;
        }

        run() -> bool {
            return ejecutarGrafica();
        }

    ref main ->> run;

    fa:
        return true;

}
