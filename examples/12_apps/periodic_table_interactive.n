use <collections:list>;
use <io:output, render>;
use <ui:canvas, input, window>;

tablaPeriodicaInteractiva :: runtime {
    UiLayout :: type {
            ancho >> int;
            alto >> int;
            tablaX >> int;
            tablaY >> int;
            celdaW >> int;
            celdaH >> int;
            panelX >> int;
            panelW >> int;
    }

    stc:
        opcion >> int;
        fila >> int;
        columna >> int;
        numero >> int;
        query >> str;
        familia >> int;
        periodoActual >> int;
        periodoListo >> bool;
        activo >> bool;
        ventana >> int;
        seleccionado >> int;
        hover >> int;
        filtro >> int;
        tick >> int;
        tecla >> int;
        modoBusqueda >> int;
        numeroEntrada >> int;
        mousePx >> int;
        mousePy >> int;
        drawX >> int;
        drawY >> int;
        drawColor >> int;
        drawTextColor >> int;
        clickActual >> bool;
        clickPrevio >> bool;
        animacion >> bool;
        sucio >> bool;
        ultimoSeleccionado >> int;
        ultimoHover >> int;
        ultimoFiltro >> int;
        ultimoModo >> int;
        ultimoNumeroEntrada >> int;
        ultimaAnimacion >> bool;
        ultimaQuery >> str;
        ultimoMensaje >> str;
        uiOk >> bool;
        entradaTecla >> str;
        mensajeUi >> str;
        layout >> UiLayout;
        paleta >> array<int, 11>;
        historial >> list<int>;

    fn:
        linea(colorNombre >> str) -> bool {
            println(colorBold("============================================================================", colorNombre));
            return true;
        }

        pausa() -> bool {
            print(colorBold("Pulsa ENTER para continuar: ", "grey"));
            query >> str <- readLine();
            return true;
        }

        animarTitulo() -> bool {
            linea("cyan");
            println(colorBold("Tabla Periodica Interactiva", "yellow"));
            println(color("Canvas terminal, busqueda, fichas y eventos por coordenadas.", "cyan"));
            linea("cyan");
            sleepMs(70);
            return true;
        }

        n3(z >> int) -> str {
            if (z < 10) {
                return "00" + renderInt(z);
            }
            if (z < 100) {
                return "0" + renderInt(z);
            }
            return renderInt(z);
        }

