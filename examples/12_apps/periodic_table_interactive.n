        resumenFamilia(id >> int) -> str {
            if (id == 1) { return "Muy reactivo, blando y buen conductor; se conserva lejos de agua y aire."; }
            if (id == 2) { return "Metal ligero y reactivo moderado, frecuente en minerales estructurales."; }
            if (id == 3) { return "Conductor denso, ductil y util en aleaciones, energia y maquinaria."; }
            if (id == 4) { return "Metal de bloque p con usos electricos, estructurales o de baja fusion."; }
            if (id == 5) { return "Propiedades intermedias; muy valioso en semiconductores y quimica fina."; }
            if (id == 6) { return "Base de vida, atmosfera, agua, fertilizantes, polimeros y reacciones organicas."; }
            if (id == 7) { return "Oxidante potente; forma sales y compuestos reactivos con metales."; }
            if (id == 8) { return "Muy estable por capa electronica cerrada; usado en iluminacion y atmosfera inerte."; }
            if (id == 9) { return "Serie f de tierras raras, magnetismo, optica, catalisis y tecnologia limpia."; }
            if (id == 10) { return "Serie f pesada; incluye materiales nucleares y sinteticos de alta energia."; }
            return "Elemento de frontera con propiedades mixtas segun estructura y enlace.";
        }

        elementoEn(f >> int, c >> int) -> int {
            if (f == 1) {
                if (c == 1) { return 1; }
                if (c == 18) { return 2; }
            }
            if (f == 2) {
                if (c == 1) { return 3; }
                if (c == 2) { return 4; }
                if (c == 13) { return 5; }
                if (c == 14) { return 6; }
                if (c == 15) { return 7; }
                if (c == 16) { return 8; }
                if (c == 17) { return 9; }
                if (c == 18) { return 10; }
            }
            if (f == 3) {
                if (c == 1) { return 11; }
                if (c == 2) { return 12; }
                if (c == 13) { return 13; }
                if (c == 14) { return 14; }
                if (c == 15) { return 15; }
                if (c == 16) { return 16; }
                if (c == 17) { return 17; }
                if (c == 18) { return 18; }
            }
            if (f == 4) { return c + 18; }
            if (f == 5) { return c + 36; }
            if (f == 6) {
                if (c == 1) { return 55; }
                if (c == 2) { return 56; }
                if (c == 3) { return 57; }
                if (c == 4) { return 72; }
                if (c == 5) { return 73; }
                if (c == 6) { return 74; }
