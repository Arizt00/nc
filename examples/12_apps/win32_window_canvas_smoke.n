use <ui:canvas, input, window>;

win32WindowCanvasSmoke :: runtime {
    stc:
        ventana >> int;
        activo >> bool;
        dibujado >> bool;

    fn:
        dibujar(handle >> int) -> bool {
            dibujado >> bool <- canvasClear(handle, 0x101820);
            dibujado >> bool <- canvasRect(handle, 24, 24, 592, 312, 0x16324a);
            dibujado >> bool <- canvasRect(handle, 42, 62, 112, 112, 0xf4c95d);
            dibujado >> bool <- canvasEllipse(handle, 190, 62, 112, 112, 0x58c7b5);
            dibujado >> bool <- canvasLine(handle, 342, 118, 570, 118, 0xef6f6c, 4);
            dibujado >> bool <- canvasText(handle, 42, 206, "Runtime Win32 nativo", 0xffffff);
            dibujado >> bool <- canvasText(handle, 42, 238, "Cierra la ventana para terminar", 0x9fd3ff);
            return canvasPresent(handle);
        }

        run() -> bool {
            ventana >> int <- windowOpen("nC - Window/Canvas Win32", 680, 420);
            if (ventana == 0) {
                return false;
            }

            activo >> bool <- windowFocus(ventana);
            activo >> bool <- dibujar(ventana);
            while (windowPoll(ventana)) {
                if (mouseDown(1)) {
                    dibujado >> bool <- canvasRect(
                        ventana,
                        mouseX(ventana) - 5,
                        mouseY(ventana) - 5,
                        10,
                        10,
                        0xff5d8f
                    );
                    dibujado >> bool <- canvasPresent(ventana);
                }
                sleep(16);
            }
            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
