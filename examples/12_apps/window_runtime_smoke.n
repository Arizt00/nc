use <ui:window>;

windowRuntimeSmoke :: runtime {
    stc:
        handle >> int;
        running >> bool;

    fn:
        run() -> bool {
            handle >> int <- windowOpen("nC Window Runtime Smoke", 960, 540);
            if (handle == 0) { return false; }
            running >> bool <- true;
            started >> int <- monotonicMs();
            windowSetTitle(handle, "nC Window Poll ACTIVE");
            while (running && monotonicMs() - started < 10000) {
                running >> bool <- windowPoll(handle);
                if (running) { windowWaitEvent(handle, 16); }
            }
            return true;
        }

    ref main ->> run;

    fn:
        shutdown() -> bool {
            if (handle > 0) { windowClose(handle); }
            return true;
        }

}
