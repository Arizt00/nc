    fn:
        public:
            lexiconCount() -> int { return RECORD_COUNT; }

            lexiconFind(value >> str) -> int {
                return nccEmbeddedPack.packFind(pCast<byte>(&payload),
                    pCast<u32>(&recordOffsets), pCast<u32>(&hashSlots),
                    RECORD_COUNT, SLOT_COUNT, BLOCK_SIZE,
                    MAX_KEY_BYTES, value);
            }

            lexiconContains(value >> str) -> bool {
                return lexiconFind(value) >= 0;
            }

            lexiconAt(index >> int) -> str {
                return nccEmbeddedPack.packKeyAt(pCast<byte>(&payload),
                    pCast<u32>(&recordOffsets),
                    RECORD_COUNT, BLOCK_SIZE, MAX_KEY_BYTES, index);
            }

            lexiconRelease(value >> str) -> bool {
                return nccEmbeddedPack.packReleaseText(value);
            }

    fa:
        return true;
}
