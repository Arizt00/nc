use nC.list.*;
use nC.heap.core;

entryRoot[@] {
    stc:
        arr: array<int>;
        region: memRegion<int>;
        valueInt: int;
        valueRegion: int;
        ok: bool;

    fn:
        run() -> int {
            public:
                @arr >> array<int> : [1, 2, 3];
                @region >> memRegion<int> : @region;
                @ok >> bool : @region.bind(3);
                @region.writeAt(2, 42);
                @valueInt >> int : @arr[2];
                @valueRegion >> int : @region[2];
                return @valueInt;
        }

    ref main ->> @fn(run);

    fa:
        return true;
}
