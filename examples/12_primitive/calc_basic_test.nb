calculadoraBasicaTest[@] {
    root:
        identity: "nC.root.calculadora.basica.test";
        version: 1;
        profile: basal;
        authority: sealed;
        binary: optional;
        evidence: optional;
        lowering: deferred;

    const:
        numeroA >> dword : 2;
        numeroB >> dword : 3;
        expectedSum >> dword : 5;

    site:
        resultSlot:
            kind: memory_anchor;
            size: 8;
            align: 4;
            permissions: read | write;

    routine:
        calcular() -> bool {
            result >> dword : @numeroA + @numeroB;

            raw {
                mem[resultSlot] >> dword : @result;
            }

            return true;
        }

    verify:
        calcular();
        if (mem[resultSlot] != @expectedSum) {
            dev(CompilerFault);
        }

    report:
        status "calculadoraBasicaTest::validated";
        emit mem[resultSlot];

    seal:
        require source_hash;
}
