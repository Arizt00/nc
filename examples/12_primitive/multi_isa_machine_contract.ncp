primitive[@] target x86_64:
    type material_target = "multi-isa-machine-contract";
    type material_environment = "freestanding";

    isa:
        x86_64_adx_rdrand_rdseed;
        i386_adx_rdrand_rdseed;
        x86_64_i386_cet_pku;
        x86_64_wbnoinvd_clts;
        x86_64_i386_getsec;
        aarch64_extract_bitfield;
        aarch64_speculation_barriers;
        aarch64_ras_flagm;
        aarch64_dgh;
        armv7_thumb2_dsp_saturation;
        armv7_thumb_yield_hint;
        armv7_hvc_smc;
        armv7_cps_effect_masks;
        riscv32_riscv64_zbs;
        riscv32_riscv64_ztso_zawrs;
        riscv32_riscv64_hypervisor_fences;
        riscv32_riscv64_hypervisor_guest_memory;
        wasm32_sign_extension;
        wasm32_reference_tables;
        wasm32_table_copy;

    opcode:
        adcx_adox;
        endbr64_endbr32_rdpkru_wrpkru;
        extr_ubfm_sbfm_bfm;
        sb_ssbb_pssbb_csdb;
        qadd_qsub_ssat_usat;
        yield_hint;
        bset_bclr_binv_bext;
        fence_tso_wrs_nto_wrs_sto;
        wbnoinvd_clts;
        getsec;
        esb_tsb_xaflag_axflag;
        dgh;
        hvc_smc;
        cpsid_cpsie_aif;
        hfence_hinval;
        hlv_hlvx_hsv;
        table_reference_types;
        table_copy;

    encoding:
        machine_native_bytes;
        exact_decoder_roundtrip;

    relocation:
        target_object_authority;

    abi:
        explicit_target_abi;

    operation materialize():
        barrier compiler;

    anchor:
        multiIsaRoot;

    bridge:
        root.policy.bind;
        root.policy.guard;
        root.memory.resolve;
        machine.machineCore;

    seal:
        multiIsaMaterialized;
