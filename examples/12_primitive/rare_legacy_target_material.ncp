primitive[@] target x86_64:
    type material_target = "machine-rare-legacy-v1";
    type material_environment = "emulated-qemu";

    isa:
        x86_64_cldemote;
        x86_64_i386_cet_pku;
        x86_64_i386_getsec;
        x86_64_i386_rdpmc_rdpid;
        i386_obsolete_adjust;
        i386_undocumented_salc_icebp;
        aarch64_pauth_hint;
        aarch64_speculation_barriers;
        aarch64_dgh;
        aarch64_wfxt;
        armv7_thumb_setend;
        armv7_thumb_yield_hint;
        armv7_cps_effect_masks;
        armv7_thumb_debug_hint;
        riscv32_zicond;
        riscv64_zicond;
        riscv32_riscv64_ztso_zawrs;
        riscv32_riscv64_hypervisor_guest_memory;
        riscv32_riscv64_svinval;
        wasm32_bulk_memory;
        wasm32_table_copy;
        wasm32_passive_segment_lifecycle;

    opcode:
        cldemote_m8;
        endbr64_endbr32_rdpkru_wrpkru;
        getsec;
        rdpmc_rdpid;
        aaa_aad_aam_aas_daa_das_into_pusha_popa;
        salc_icebp;
        paciasp_autiasp_xpaclri;
        sb_ssbb_pssbb_csdb;
        dgh;
        wfet_wfit;
        setend_be_le;
        yield_hint;
        cpsid_cpsie_aif;
        dbg_imm4;
        czero_eqz_nez;
        fence_tso_wrs_nto_wrs_sto;
        hlv_hlvx_hsv;
        sfence_sinval_sequence;
        memory_copy_fill;
        table_copy;
        memory_init_data_drop_table_init_elem_drop;

    encoding:
        exact_little_endian_machine_bytes;
        llvm_mc_oracle_compared;
        internal_decoder_roundtrip;

    relocation:
        target_object_authority;
        no_hidden_assembler;

    abi:
        sysv64;
        i386_sysv;
        aapcs64;
        aapcs32;
        ilp32;
        riscv64;
        wasm;

    operation materializeRareIsa():
        barrier compiler;
        trace exact_bytes;

    anchor:
        rareLegacyRoot;

    bridge:
        root.policy.bind;
        root.policy.guard;
        root.memory.resolve;
        machine.machineCore;

    seal:
        rareLegacyMaterialized;
