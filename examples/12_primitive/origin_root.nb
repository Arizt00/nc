originRoot[@] {
    root:
        identity: "nC.root.origin";
        version: 1;
        profile: basal;
        authority: sealed;
        binary: optional;
        evidence: optional;
        lowering: deferred;

    const:
        rootBase >> addr : 0x1000;

    site:
        originSlot:
            kind: memory_anchor;
            size: 8;
            align: 8;
            permissions: read;

    bind:
        symbol origin_binding -> root.site originSlot;

    routine:
        getBase() -> bool {
            return true;
        }

    verify:
        getBase();

    report:
        status "originRoot::validated";
        emit originSlot;

    seal:
        require source_hash;
}
