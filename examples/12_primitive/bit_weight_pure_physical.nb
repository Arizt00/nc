bitWeightPurePhysical [@] {
    stc:
        strictly physicalWidth >> int : 32;

        src0 >> addr : 0x3000;
        src1 >> addr : 0x3004;
        src2 >> addr : 0x3008;

        dst0Shift >> addr : 0x4000;
        dst0Fold  >> addr : 0x4004;

        dst1Shift >> addr : 0x4008;
        dst1Fold  >> addr : 0x400C;

        dst2Shift >> addr : 0x4010;
        dst2Fold  >> addr : 0x4014;

    binary:
        one  >> dword : 0b1;
        zero >> dword : 0b0;

    bind:
        mem[@src0] >> int : 11;
        mem[@src1] >> int : -1;
        mem[@src2] >> int : 0;

    fn:
        physicalShiftCount(src:addr, dst:addr) -> bool {
            work >> int : 0;
            acc  >> int : 0;
            lsb  >> int : 0;

            raw {
                work >> int : mem[@src];
                acc  >> int : 0;

                while (@work != @zero) {
                    lsb  >> int : @work & @one;
                    acc  >> int : @acc + @lsb;
                    work >> int : @work >>> 1;
                }

                mem[@dst] >> int : @acc;
            }

            return true;
        }

        physicalFoldCount(src:addr, dst:addr) -> bool {
            work >> int : 0;
            acc  >> int : 0;

            raw {
                work >> int : mem[@src];
                acc  >> int : 0;

                while (@work != @zero) {
                    work >> int : @work & (@work - 1);
                    acc  >> int : @acc + 1;
                }

                mem[@dst] >> int : @acc;
            }

            return true;
        }

        physicalAssert(dst:addr) -> bool {
            value >> int : mem[@dst];

            if (@value < 0) {
                dev(irregular);
            }

            if (@value > @physicalWidth) {
                dev(MemoryOverflow @security);
            }

            return true;
        }

    probe:
        @fn(physicalShiftCount, @src0, @dst0Shift);
        @fn(physicalFoldCount,  @src0, @dst0Fold);

        @fn(physicalShiftCount, @src1, @dst1Shift);
        @fn(physicalFoldCount,  @src1, @dst1Fold);

        @fn(physicalShiftCount, @src2, @dst2Shift);
        @fn(physicalFoldCount,  @src2, @dst2Fold);

        if (mem[@dst0Shift] != 3)  { dev(CompilerFault); }
        if (mem[@dst0Fold]  != 3)  { dev(CompilerFault); }

        if (mem[@dst1Shift] != 32) { dev(CompilerFault); }
        if (mem[@dst1Fold]  != 32) { dev(CompilerFault); }

        if (mem[@dst2Shift] != 0)  { dev(CompilerFault); }
        if (mem[@dst2Fold]  != 0)  { dev(CompilerFault); }

        @fn(physicalAssert, @dst0Shift);
        @fn(physicalAssert, @dst0Fold);
        @fn(physicalAssert, @dst1Shift);
        @fn(physicalAssert, @dst1Fold);
        @fn(physicalAssert, @dst2Shift);
        @fn(physicalAssert, @dst2Fold);


    final:
        println("bitWeightPurePhysical::stable");

        println(mem[@dst0Shift]);
        println(mem[@dst0Fold]);
        println(mem[@dst1Shift]);
        println(mem[@dst1Fold]);
        println(mem[@dst2Shift]);
        println(mem[@dst2Fold]);

        return true;
}
