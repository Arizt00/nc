redFisicaInspect[@] {
    stc:
        ipRed: str;
        macRed: str;
        puertoRed: int;
        dirFisicaRam: addr;
        dirFisicaMmio: addr;

    to main {
        @ipRed >> str : "10.0.0.12";
        @macRed >> str : "52:74:F2:B1:9C:AA";
        @puertoRed >> int : 8080;

        @dirFisicaRam >> addr : 0x0000000000100000;
        @dirFisicaMmio >> addr : 0x00000000FEE00000;

        println("network.surface");
        print("ip=" + @ipRed);
        print("mac = " + @macRed));
        print("port = " + @puertoRed);
        println(@puertoRed);

        println(@ipRed);
        println(@macRed);

        println("physical.surface");
        print("phys.ram=");
        println(@dirFisicaRam);
        print("phys.mmio=");
        println(@dirFisicaMmio);

        println(@dirFisicaRam);
        println(@dirFisicaMmio);
        println(@dirFisicaRam);
        println(@dirFisicaMmio);
    }

    fa:
        return true;
}