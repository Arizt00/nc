use <io:output, input>;

pruebaPlugin :: runtime {
    stc:
        inputValue >> int;
        doubled >> int;

    fn:
        run() -> bool {
            println("Hello from nC plugin!");
            print("Enter an integer: ");
            inputValue >> int <- readInt();
            doubled >> int <- inputValue * 2;
            print("Double: ");
            println(doubled);
            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
