use <collections:array, list, result>;
use <io:output, render, random, fsread>;
use <memory:ptr, heap, region>;

runtimeStdPunto9 :: runtime {
    stc:
        path >> str;
        ticket >> int;
        marcas >> array<int, 3>;

    fn:
        run() -> bool {
            path <- "target/tmp/runtime_std_punto9.txt";
            marcas <- [0, 0, 0];

            ticket <- randomRange(1, 9);
            marcas[0] <- ticket;

            writeFile(path, "runtime estandar punto 9");
            readFile(path);

            println(colorBold("Runtime estandar consolidado", "cyan"));
            println("ticket = " + renderInt(ticket));
            println("archivo=target/tmp/runtime_std_punto9.txt");

            return ticket >= 1 && ticket <= 9;
        }

    ref main ->> run;

    fa:
        return true;

}
