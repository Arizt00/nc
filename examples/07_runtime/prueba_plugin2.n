use <io:output, render, input>;

pruebaPlugin :: runtime {
    stc:
        inputValue >> int <- 0;
        doubled    >> int <- 0;

    fn:
        run() -> bool {
            println("Hello from nC plugin!");
            print("Enter an integer: ");

            inputValue <- readInt();
            doubled <- inputValue * 2;

            println("Double: " + renderInt(doubled));
            return true;
        }

    ref main ->> run;

    fa:
        return true;

}