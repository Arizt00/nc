permissionNoC {
    fn:
        run() -> bool {
            readable >> bool <- permissions::canRead("Cargo.toml");
            writable >> bool <- permissions::canWrite("Cargo.toml");
            executable >> bool <- permissions::canExecute("Cargo.toml");
            required <- permissions::requirePermission("Cargo.toml");

            return readable && writable == writable &&
                executable == executable && isOk(required);
        }

    ref main ->> run;

    fa:
        return true;
}
