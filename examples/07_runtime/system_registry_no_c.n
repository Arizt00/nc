systemRegistryNoC {
    fn:
        run() -> bool {
            key >> str <- "ncc_system_registry_no_c";
            if (!registry_write(key, "material-ok")) return false;

            stored >> str <- registry_read(key);
            load >> ft64 <- cpu_load();

            return stored == "material-ok" && load >= -1.0 && load <= 100.0;
        }

    ref main ->> run;

    fa:
        return true;
}
