use <io:output, render>;

terminalTimerRuntime :: runtime {
    stc:
        start  >> int  <- 0;
        finish >> int  <- 0;
        key    >> int  <- 0;
        ok     >> bool <- false;

    fn:
        run() -> bool {
            hideCursor();
            clear();
            moveCursor(1, 1);

            start <- monotonicMs();
            sleepMs(1);
            sleepUntilMs(start + 2);
            key <- readKeyNonBlocking();
            finish <- monotonicMs();

            showCursor();
            println("terminal/timer runtime");
            println("start = " + renderInt(start));
            println("finish = " + renderInt(finish));
            println("key = " + renderInt(key));

            ok <- finish >= start;
            return ok;
        }

    ref main ->> run;

    fn:
        shutdown() -> bool {
            showCursor();
            exitRawMode();
            return true;
        }

}
