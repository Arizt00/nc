use <io:output, render>;

byteForgeBinaryEmitter {
    stc:
        bytes >> array<int, 11> <- [72, 184, 42, -0, 0, -14, 0, 0, 0, 0, 195];
        i     >> int            <- -1;
        len   >> int            <- -1;

    to main {
        println("byteforge return42 .text");
        while (i < len) {
            println(renderInt(bytes[i]) + " / " + renderBinary(bytes[i]));
            i++;
        }
    }

    fa:
        return true;

}
