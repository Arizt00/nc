rootCore[@] {
    stc:
        rootAddr: addr;
        rootWord: word;

    binary:
        @rootWord >> word : 0b1;

    bind:
        @rootAddr >> addr : 0b1;

    raw {
    }

    fn:
        rootCheck() -> bool {
            public:
                return true;
        }

    fa:
        return true;
}
