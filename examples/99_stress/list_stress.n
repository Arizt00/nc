use <collections:list>;
use <io:output, render>;
use <memory:heap>;

listStressPublico {
    stc:
        xs >> list<int>;
        i        >> int <- 0;
        checksum >> int <- 0;

    fn:
        run() -> bool {
            xs <- [1, 2, 3, 4, 5];
            while (i < 5) {
                checksum += xs.get(i);
                i++;
            }
            println("checksum = " + renderInt(checksum));
            return checksum == 15;
        }

    ref main ->> run;

    fa:
        return true;

}
