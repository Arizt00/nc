use <io:output, render>;

renderBinaryOk :: runtime {
    stc:
        cero         >> int <- 0;
        cinco        >> int <- 5;
        cuarentaYDos >> int <- 42;
        negativo     >> int <- -5;

    to main {
        println("bin(0) = " + renderBinary(cero));
        println("bin(5) = " + renderBinary(cinco));
        println("bin(42) = " + renderBin(cuarentaYDos));
        println("bin(-5) = " + renderBinary(negativo));
    }

    fa:
        return true;

}
