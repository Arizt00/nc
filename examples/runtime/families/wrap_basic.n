use <io:output>;
use <text:wrap>;

wrapBasic :: runtime {
    fn:
        run() -> bool {
            hard >> str <- wrap("A界👨‍👩‍👧‍👦áZ", 3);
            words >> str <- wrapWords("uno 界界 tres", 5);
            indented >> str <- indent("uno\n界", 2);

            ok >> bool <-
                hard == "A界\n👨‍👩‍👧‍👦á\nZ" &&
                words == "uno\n界界\ntres" &&
                indented == "  uno\n  界";

            print("manual nC Unicode wrap provider: ");
            if (ok) { println("true"); }
            else { println("false"); }

            wrapRelease(indented);
            wrapRelease(words);
            wrapRelease(hard);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
