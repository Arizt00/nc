use <auth.system:session>;
use <memory:stack>;
use <io:output>;

authSystemSessionManualRaw {
    fn:
        strideCheck() -> bool { return authSystemSessionStride() == 64; }
        writeCopy(table >> p<byte>) -> bool {
            return authSystemSessionWrite(table, 0, 701, 42, 99, 7, 4, 66, 5, 1) &&
                authSystemSessionCopy(table, 1, table, 0);
        }
        identity(table >> p<byte>) -> bool {
            return authSystemSessionKey(table, 1) == 701 &&
                authSystemSessionPrincipal(table, 1) == 42 &&
                authSystemSessionHandle(table, 1) == 99 &&
                authSystemSessionOwner(table, 1) == 66 &&
                authSystemSessionGeneration(table, 1) == 5;
        }
        authority(table >> p<byte>) -> bool {
            return authSystemSessionRights(table, 1) == 7 &&
                authSystemSessionFlags(table, 1) == 4 &&
                authSystemSessionState(table, 1) == 1 &&
                authSystemSessionAllows(table, 1, 3);
        }
        clearRecord(table >> p<byte>) -> bool {
            return authSystemSessionClear(table, 1) && authSystemSessionState(table, 1) == 0;
        }
        run() -> bool {
            table >> p<byte> <- stackAlloc(authSystemSessionStride() * 2, 8);
            ok >> bool <- strideCheck() && writeCopy(table) && identity(table) &&
                authority(table) && clearRecord(table);
            println("manual nC auth system session backend: " + (ok ? "true" : "false"));
            return ok;
        }
    ref main ->> run;
    fa:
        return true;
}
