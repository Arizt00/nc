use <io:concat>;

runtimeFamilyIoConcatBasic :: runtime {
    fn:
        combine(left: str, right: str) -> str {
            return concat(left, right);
        }

        run() -> bool {
            left >> str <- "manual";
            right >> str <- " nC";
            joined >> str <- combine(left, right);
            ok >> bool <- joined == "manual nC" && left == "manual" && right == " nC";
            strRelease(joined);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
