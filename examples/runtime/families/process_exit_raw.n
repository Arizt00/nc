use <io:output>;
use <process:exit>;

rawProcessExit :: runtime {
    fn:
        run() -> bool {
            current >> addr <- processCurrent();
            pid >> int <- processId(current);
            opened >> addr <- processOpen(4096, false, pid);
            openedPid >> int <- processId(opened);
            code >> int <- processExitCode(opened);
            closed >> bool <- processClose(opened);

            ok >> bool <-
                current != null &&
                pid > 0 &&
                opened != null &&
                openedPid == pid &&
                code == 259 &&
                closed;

            print("manual nC process exit backend: ");
            if (ok) { println("true"); }
            else { println("false"); }
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
