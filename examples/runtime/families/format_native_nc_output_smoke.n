use <io:output>;

runtimeFamilyFormatNativeNcOutputSmoke :: runtime {
    fn:
        run() -> int {
            positional >> str <- format(
                "id={:04d} hex={:#x} ok={} {{done}}",
                7,
                255,
                true
            );
            println(positional);

            named >> str <- formatNamed(
                "{name:<5}:{score:03d}",
                "name",
                "Ada",
                "score",
                9
            );
            println(named);

            integer >> str <- formatInt(-42, "+08d");
            println(integer);

            floating >> str <- formatFloat(12.5, ".2f");
            println(floating);

            strRelease(positional);
            strRelease(named);
            strRelease(integer);
            strRelease(floating);
            return 0;
        }

    ref main ->> run;

    fa:
        return true;
}
