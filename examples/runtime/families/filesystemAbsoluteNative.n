use <io:output>;

filesystemAbsoluteNative {
    const:
        CAPACITY >> u64 <- 65536;
    run() -> int {
        path >> p<byte> <- alloc(CAPACITY);
        if (path == null) return 1;
        written >> int <- absolutePathInto("missing/../new-file.txt",path,CAPACITY);
        if (written < 0) {
            print("path error: "); println(written);
            free(path); return 2;
        }
        println(cast<str>(path));
        free(path); return 0;
    }
    ref main ->> run;
    fa: return true;
}
