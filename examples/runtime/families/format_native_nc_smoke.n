

runtimeFamilyFormatNativeNcSmoke :: runtime {
    fn:
        run() -> int {
            positional >> str <- format(
                "id={:04d} hex={:#x} ok={} {{done}}",
                7,
                255,
                true
            );
            named >> str <- formatNamed(
                "{name:<5}:{score:03d}",
                "name",
                "Ada",
                "score",
                9
            );
            integer >> str <- formatInt(-42, "+08d");
            floating >> str <- formatFloat(12.5, ".2f");

            if (positional != "id=0007 hex=0xff ok=true {done}") { return 11; }
            if (named != "Ada  :009") { return 12; }
            if (integer != "-0000042") { return 13; }
            if (floating != "12.50") { return 14; }

            strRelease(positional);
            strRelease(named);
            strRelease(integer);
            strRelease(floating);
            return 0;
        }

    ref main ->> run;

    fa:
        return true;
}
