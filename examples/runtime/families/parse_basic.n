use <text:parse>;

runtimeFamilyParseBasic :: runtime {
    fn:
        run() -> bool {
            signed >> int <- parseInt(" -42 ");
            unsigned >> u64 <- parseUInt("0xff");
            floating >> ft64 <- parseFloat("12.5e1");
            truth >> bool <- parseBool("TRUE");
            character >> char <- parseChar(" Z ");

            outInt >> int <- 0;
            outFloat >> ft64 <- 0.0;
            outBool >> bool <- false;

            intOk >> bool <- tryParseInt("0b101010", &outInt);
            floatOk >> bool <- tryParseFloat("-3.25", &outFloat);
            boolOk >> bool <- tryParseBool("false", &outBool);
            invalid >> bool <- tryParseInt("4x", &outInt);

            return signed == -42 && unsigned == 255 && floating == 125.0 &&
                truth && character == 'Z' && intOk && outInt == 42 &&
                floatOk && outFloat == -3.25 && boolOk && !outBool && !invalid;
        }

    ref main ->> run;

    fa:
        return true;
}
