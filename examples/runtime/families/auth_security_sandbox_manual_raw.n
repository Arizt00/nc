use <auth.security:sandbox>;
use <memory:stack>;
use <io:output>;

authSecuritySandboxManualRaw {
    fn:
        strideCheck() -> bool { return authSandboxStride() == 64; }
        writeCopy(table >> p<byte>) -> bool {
            return authSandboxWrite(table, 0, 1001, 101, 303, 7, 8, 4, 5, 1) &&
                authSandboxCopy(table, 1, table, 0);
        }
        identity(table >> p<byte>) -> bool {
            return authSandboxId(table, 1) == 1001 &&
                authSandboxPrincipal(table, 1) == 101 &&
                authSandboxRoot(table, 1) == 303 &&
                authSandboxGeneration(table, 1) == 5;
        }
        authority(table >> p<byte>) -> bool {
            return authSandboxRights(table, 1) == 7 &&
                authSandboxRestrictions(table, 1) == 8 &&
                authSandboxFlags(table, 1) == 4 && authSandboxState(table, 1) == 1 &&
                authSandboxAllows(table, 1, 3) && !authSandboxAllows(table, 1, 8);
        }
        clearRecord(table >> p<byte>) -> bool {
            return authSandboxClear(table, 1) && authSandboxState(table, 1) == 0;
        }
        run() -> bool {
            table >> p<byte> <- stackAlloc(authSandboxStride() * 2, 8);
            ok >> bool <- strideCheck() && writeCopy(table) && identity(table) &&
                authority(table) && clearRecord(table);
            println("manual nC auth security sandbox backend: " + (ok ? "true" : "false"));
            return ok;
        }
    ref main ->> run;
    fa:
        return true;
}
