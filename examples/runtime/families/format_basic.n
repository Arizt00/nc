runtimeFamilyFormatBasic :: runtime {
    fn:
        run() -> bool {
            positional >> str <- format(
                "id={:04d} hex={:#x} ok={} {{done}}",
                7,
                255,
                true
            );
            named >> str <- formatNamed(
                "{name:<5}:{score:03d}",
                "name",
                "Ada",
                "score",
                9
            );
            integer >> str <- formatInt(-42, "+08d");
            floating >> str <- formatFloat(12.5, ".2f");

            ok >> bool <- positional == "id=0007 hex=0xff ok=true {done}" &&
                named == "Ada  :009" && integer == "-0000042" &&
                floating == "12.50";

            strRelease(positional);
            strRelease(named);
            strRelease(integer);
            strRelease(floating);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
