runtimeFamilyEntropyBasic :: runtime {
    fn:
        run() -> bool {
            mark >> p<byte> <- stackMark();
            bytes >> p<byte> <- stackAlloc(32, 16);
            ok >> bool <- entropyAvailable() && entropyFill(bytes, 32);
            stackRestore(mark);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
