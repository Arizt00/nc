use <io:output>;
use <text:truncate>;

truncateBasic :: runtime {
    fn:
        run() -> bool {
            plain >> str <- truncate("abcdefghij", 6);
            ending >> str <- truncateEnd("abcdefghij", 7);
            middle >> str <- truncateMiddle("abcdefghij", 7);
            short >> str <- truncateEnd("abc", 7);

            ok >> bool <-
                plain == "abcdef" &&
                ending == "abcd..." &&
                middle == "ab...ij" &&
                short == "abc";

            print("manual nC truncate provider: ");
            println(ok ? "true" : "false");

            truncateRelease(short);
            truncateRelease(middle);
            truncateRelease(ending);
            truncateRelease(plain);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
