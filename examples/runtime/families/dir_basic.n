use <collections:list, result>;
use <fs:dir>;

runtimeFamilyDirBasic :: runtime {
    const:
        ROOT >> str <- ".ncc-dir-runtime-smoke";

    fn:
        run() -> bool {
            removeDir(ROOT);

            cwd >> Result<str, FsError> <- currentDir();
            created >> Result<bool, FsError> <- createDir(ROOT);
            listed >> Result<list<str>, FsError> <- listDir(ROOT);
            changed >> Result<bool, FsError> <- changeDir(".");
            removed >> Result<bool, FsError> <- removeDir(ROOT);
            missing >> Result<bool, FsError> <- removeDir(ROOT);

            return isOk(cwd) && isOk(created) && isOk(listed) &&
                isOk(changed) && isOk(removed) && isErr(missing);
        }

    ref main ->> run;

    fa:
        removeDir(ROOT);
        return true;
}
