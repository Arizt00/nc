
runtimeFamilyTerminalBasic :: runtime {
    stc:
        ok >> bool;

    fn:
        run() -> bool {
            ok >> bool <- clear();
            ok >> bool <- moveCursor(1, 1);
            ok >> bool <- hideCursor();
            ok >> bool <- showCursor();
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
