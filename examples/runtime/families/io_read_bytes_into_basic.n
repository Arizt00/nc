use <io:readBytesInto>;

runtimeFamilyIoReadBytesIntoBasic :: runtime {
    fn:
        run() -> bool {
            bytes >> array<byte, 4> <- [0, 0, 0, 0];
            read >> Result<int, FsError> <- readBytesInto(
                "examples/runtime/families/io_read_bytes_into_basic.n",
                bytes
            );
            return isOk(read) && unwrap(read) == 4 &&
                bytes[0] == 117 && bytes[1] == 115 && bytes[2] == 101 && bytes[3] == 32;
        }

    ref main ->> run;

    fa:
        return true;
}
