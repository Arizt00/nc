use <text:pad>;

runtimeFamilyPadBasic :: runtime {
    fn:
        run() -> bool {
            left >> str <- padLeft("7", 3, '0');
            right >> str <- padRight("7", 3, '0');
            both >> str <- padBoth("7", 4, '-');

            ok >> bool <- left == "007" && right == "700" && both == "-7--";

            strRelease(left);
            strRelease(right);
            strRelease(both);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
