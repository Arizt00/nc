filesystemLockRawManual :: runtime {
    const:
        LOCK_FILE >> str <- ".ncc-filesystem-lock.bin";

    fn:
        run() -> bool {
            delete_file(LOCK_FILE);
            handle >> addr <- fsLock(LOCK_FILE, true, false);
            unlocked >> bool <- fsUnlock(handle);
            removed >> bool <- delete_file(LOCK_FILE);
            return unlocked && removed;
        }

    ref main ->> run;

    fa:
        delete_file(LOCK_FILE);
        return true;
}
