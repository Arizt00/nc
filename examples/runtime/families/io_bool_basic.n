runtimeFamilyIoBoolBasic :: runtime {
    fn:
        run() -> bool {
            a >> bool <- randomBool();
            b >> bool <- randomBool();
            c >> bool <- randomBool();
            d >> bool <- randomBool();

            ones >> int <- (a ? 1 : 0) + (b ? 1 : 0) +
                (c ? 1 : 0) + (d ? 1 : 0);
            return ones >= 0 && ones <= 4;
        }

    ref main ->> run;

    fa:
        return true;
}
