use <auth.system:service>;
use <memory:stack>;
use <io:output>;

authSystemServiceManualRaw {
    fn:
        strideCheck() -> bool { return authServiceStride() == 64; }
        writeCopy(table >> p<byte>) -> bool {
            return authServiceWrite(table, 0, 501, 88, 990, 7, 4, 66, 5, 1) &&
                authServiceCopy(table, 1, table, 0);
        }
        identity(table >> p<byte>) -> bool {
            return authServiceKey(table, 1) == 501 && authServiceHandle(table, 1) == 88 &&
                authServiceProcess(table, 1) == 990 && authServiceOwner(table, 1) == 66 &&
                authServiceGeneration(table, 1) == 5;
        }
        authority(table >> p<byte>) -> bool {
            return authServiceRights(table, 1) == 7 && authServiceFlags(table, 1) == 4 &&
                authServiceState(table, 1) == 1 && authServiceAllows(table, 1, 3);
        }
        clearRecord(table >> p<byte>) -> bool {
            return authServiceClear(table, 1) && authServiceState(table, 1) == 0;
        }
        run() -> bool {
            table >> p<byte> <- stackAlloc(authServiceStride() * 2, 8);
            ok >> bool <- strideCheck() && writeCopy(table) && identity(table) &&
                authority(table) && clearRecord(table);
            println("manual nC auth system service backend: " + (ok ? "true" : "false"));
            return ok;
        }
    ref main ->> run;
    fa:
        return true;
}
