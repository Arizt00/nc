use <io:output>;

domHighManualRawNoImport :: runtime {
    fn:
        run() -> bool {
            source >> addr <- adr(b"abc");
            destination >> p<byte> <- stackAlloc(3, 1);
            table >> p<byte> <- stackAlloc(highStride() * 2, 8);
            written >> bool <- highWrite(table, 0, 2, 7, 42, 9, 3, source, 3, 1);
            copied >> bool <- highCopy(table, 1, table, 0);
            sourceView >> addr <- highSource(table, 1);
            fields >> bool <- highKind(table, 1) == 2 && highKey(table, 1) == 7 &&
                highValue(table, 1) == 42 && highAux(table, 1) == 9 &&
                highFlags(table, 1) == 3 && highSourceBytes(table, 1) == 3 &&
                highState(table, 1) == 1;
            evaluated >> int <- highEval(2, 6, 7);
            byteCount >> int <- highCopyBytes(destination, sourceView, 3);
            hash >> int <- highHashBytes(destination, byteCount);
            cleared >> bool <- highClear(table, 1);
            ok >> bool <- highStride() == 64 && written && copied && fields &&
                evaluated == 42 && byteCount == 3 && hash != 0 && cleared &&
                highState(table, 1) == 0;
            println("manual DOM high backend without import: " + (ok ? "true" : "false"));
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
