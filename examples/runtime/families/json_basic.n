use <data:json>;

runtimeFamilyJsonBasic :: runtime {
    fn:
        run() -> bool {
            root >> int <- jsonParse("{\"answer\":42,\"ok\":true}");
            answer >> int <- jsonObjectGet(root, "answer");
            ok >> bool <- root != 0
                && answer != 0
                && jsonGetInt(answer) == 42
                && jsonValidate(jsonStringify(root));
            jsonRelease(answer);
            jsonRelease(root);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
