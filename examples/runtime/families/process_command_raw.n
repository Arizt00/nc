use <io:output>;
use <memory:stack>;
use <process:command>;

rawProcessCommand :: runtime {
    fn:
        run() -> bool {
            mark >> p<byte> <- stackMark();
            output >> p<byte> <- stackAlloc(64, 8);
            pipe >> addr <- commandPipeOpen(false, true);
            writer >> addr <- commandPipeWriteHandle(pipe);
            noInput >> addr <- null;
            process >> addr <- commandOpen(
                "cmd.exe /d /s /c \"echo NC_COMMAND_OK\"",
                "",
                noInput,
                writer,
                writer,
                134217728
            );

            started >> bool <- commandStarted(process);
            processHandle >> addr <- commandProcessHandle(process);
            threadHandle >> addr <- commandThreadHandle(process);
            processId >> int <- commandId(process);
            threadId >> int <- commandThreadId(process);
            writeClosed >> bool <- commandPipeCloseWrite(pipe);
            waited >> int <- commandWait(process, 5000);
            received >> int <- commandPipeRead(pipe, adr(output), 64);
            exitCode >> int <- commandExitCode(process);
            processError >> int <- commandError(process);
            pipeError >> int <- commandPipeError(pipe);

            ok >> bool <-
                started &&
                processHandle != null &&
                threadHandle != null &&
                processId > 0 &&
                threadId > 0 &&
                writeClosed &&
                waited == 0 &&
                exitCode == 0 &&
                processError == 0 &&
                pipeError == 0 &&
                received >= 13 &&
                rd(off(output, 0)) == 78 &&
                rd(off(output, 1)) == 67 &&
                rd(off(output, 2)) == 95 &&
                rd(off(output, 10)) == 95 &&
                rd(off(output, 11)) == 79 &&
                rd(off(output, 12)) == 75;

            commandRelease(process);
            commandPipeRelease(pipe);
            stackRestore(mark);

            print("manual nC process command backend: ");
            if (ok) { println("true"); }
            else { println("false"); }
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
