use <auth.security:policy>;
use <memory:stack>;
use <io:output>;

authSecurityPolicyManualRaw {
    fn:
        strideCheck() -> bool { return authPolicyStride() == 64; }
        writeCopy(table >> p<byte>) -> bool {
            return authPolicyWrite(table, 0, 801, 101, 202, 7, 8, 4, 9, 1) &&
                authPolicyCopy(table, 1, table, 0);
        }
        identity(table >> p<byte>) -> bool {
            return authPolicyId(table, 1) == 801 && authPolicySubject(table, 1) == 101 &&
                authPolicyResource(table, 1) == 202 && authPolicyPriority(table, 1) == 9;
        }
        authority(table >> p<byte>) -> bool {
            return authPolicyRights(table, 1) == 7 && authPolicyDenied(table, 1) == 8 &&
                authPolicyFlags(table, 1) == 4 && authPolicyState(table, 1) == 1 &&
                authPolicyAllows(table, 1, 3) && !authPolicyAllows(table, 1, 8);
        }
        clearRecord(table >> p<byte>) -> bool {
            return authPolicyClear(table, 1) && authPolicyState(table, 1) == 0;
        }
        run() -> bool {
            table >> p<byte> <- stackAlloc(authPolicyStride() * 2, 8);
            ok >> bool <- strideCheck() && writeCopy(table) && identity(table) &&
                authority(table) && clearRecord(table);
            println("manual nC auth security policy backend: " + (ok ? "true" : "false"));
            return ok;
        }
    ref main ->> run;
    fa:
        return true;
}
