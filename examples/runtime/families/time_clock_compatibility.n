runtimeFamilyTimeClockCompatibility :: runtime {
    fn:
        run() -> bool {
            epoch >> str <- formatTime(0);
            current >> str <- date();

            valid >> bool <-
                epoch == "1970-01-01 00:00:00 UTC" &&
                current != "";

            epochReleased >> bool <- timeRelease(epoch);
            currentReleased >> bool <- timeRelease(current);
            return valid && epochReleased && currentReleased;
        }

    ref main ->> run;

    fa:
        return true;
}
