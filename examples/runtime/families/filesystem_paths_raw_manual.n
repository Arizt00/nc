filesystemPathsRawManual :: runtime {
    fn:
        run() -> bool {
            mark >> p<byte> <- stackMark();
            absolute >> p<byte> <- stackAlloc(4096, 8);
            official >> p<byte> <- stackAlloc(4096, 8);

            absoluteBytes >> int <- absolutePathInto(".", absolute, 4096);
            officialBytes >> int <- officialPathInto(".", official, 4096);

            stackRestore(mark);
            return absoluteBytes > 0 && officialBytes > 0;
        }

    ref main ->> run;

    fa:
        return true;
}
