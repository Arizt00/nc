runtimeFamilyEscapeBasic :: runtime {
    fn:
        run() -> bool {
            json >> str <- escapeJson("quote: \" line\n");
            control >> str <- escapeControl("a\tb\n");
            ansi >> str <- escapeAnsi("\x1b[31mred");
            terminal >> str <- sanitizeTerminal("\x1b[31mred\x1b[0m\n");
            log >> str <- sanitizeLog("\x1b[31mred\x1b[0m\n");

            ok >> bool <- json == "quote: \\\" line\\n" &&
                control == "a\\tb\\n" &&
                ansi == "\\x1b[31mred" &&
                terminal == "red\n" && log == "red\\n";

            strRelease(json);
            strRelease(control);
            strRelease(ansi);
            strRelease(terminal);
            strRelease(log);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
