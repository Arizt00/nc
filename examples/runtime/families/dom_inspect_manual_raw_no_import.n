use <io:output>;

domInspectManualRawNoImport :: runtime {
    fn:
        run() -> bool {
            table >> p<byte> <- stackAlloc(inspectStride() * 3, 8);
            first >> bool <- inspectWrite(table, 0, 4, 100, 9, 1, 20, 30, 1, 2);
            second >> bool <- inspectWrite(table, 1, 8, 200, 11, 3, 40, 50, 2, 4);
            copied >> bool <- inspectCopy(table, 2, table, 1);
            fields >> bool <- inspectEvent(table, 2) == 8 && inspectSite(table, 2) == 200 &&
                inspectValue(table, 2) == 11 && inspectFlags(table, 2) == 3 &&
                inspectTick(table, 2) == 40 && inspectDetail(table, 2) == 50 &&
                inspectSequence(table, 2) == 2 && inspectState(table, 2) == 4;
            checksum >> int <- inspectChecksum(table, 2);
            found >> int <- inspectFind(table, 2, 8);
            cleared >> bool <- inspectClear(table, 2);
            ok >> bool <- inspectStride() == 64 && first && second && copied && fields &&
                checksum != 0 && found == 1 && cleared && inspectState(table, 2) == 0;
            println("manual DOM inspect backend without import: " + (ok ? "true" : "false"));
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
