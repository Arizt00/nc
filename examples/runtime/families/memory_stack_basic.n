use <memory:stack>;
use <collections:result>;

runtimeFamilyMemoryStackBasic :: runtime {
    fn:
        run() -> bool {
            limit >> u64 <- stackLimit();
            depth >> u64 <- stackDepth();
            remaining >> u64 <- stackRemaining();
            trace >> StackTraceHandle <- stackTrace();
            frames >> u64 <- stackTraceLen(trace);
            frame >> Result<addr, MemoryError> <- stackTraceFrame(trace, 0);

            ok >> bool <- limit > 0 && depth > 0 && remaining > 0 &&
                frames > 0 && isOk(frame);
            stackTraceRelease(trace);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
