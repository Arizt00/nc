use <io:output>;
use <task:event>;

rawTaskEvent :: runtime {
    fn:
        run() -> bool {
            event >> addr <- eventCreate(null, true, false, null);
            created >> bool <- event != null;
            set >> bool <- eventSet(event);
            signaled >> bool <- eventWait(event, 0) == 0;
            reset >> bool <- eventReset(event);
            timedOut >> bool <- eventWaitEx(event, 0, false) == 258;
            closed >> bool <- eventClose(event);
            ok >> bool <- created && set && signaled && reset && timedOut && closed;

            print("manual nC task event backend: ");
            if (ok) { println("true"); }
            else { println("false"); }
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
