use <io:output>;

staticAggregateNative {
    type:
        Sample { public: id >> u32; values >> array<i32,3>; label >> str; }
    stc:
        stored >> Sample <- Sample(id: 42,values: [7,11,13],label: "static aggregate ready");
    fn:
    run() -> int {
        if (stored.id != 42 || stored.values[0] != 7 || stored.values[2] != 13) return 1;
        stored.values[1] += 1;
        if (stored.values[1] != 12) return 2;
        println(stored.label);
        return 0;
    }
    ref main ->> run;
    fa: return true;
}
