runtimeFamilyConvertBasic :: runtime {
    fn:
        run() -> bool {
            integer >> Result<int, ConvertError> <- safeToInt("42");
            floating >> Result<ft64, ConvertError> <- toFloat("12.5");
            boolean >> Result<bool, ConvertError> <- toBool("true");
            rejected >> Result<int, ConvertError> <- toInt("not-a-number");
            text >> str <- toStr(-7);

            ok >> bool <- isOk(integer) && unwrap(integer) == 42 &&
                isOk(floating) && unwrap(floating) == 12.5 &&
                isOk(boolean) && unwrap(boolean) && isErr(rejected) &&
                text == "-7" && forceToInt("9.75") == 9;

            strRelease(text);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
