use <auth.resource:handle, resource, session>;
use <io:output>;
use <memory:stack>;

authResourceManual :: runtime {
    fn:
        testHandle(table >> addr, value >> addr) -> bool {
            written >> bool <- handleWrite(table, 0, value, 3, 7, 5, 9);
            copied >> bool <- handleCopy(table, 1, table, 0);
            ok >> bool <- written && copied && handleStride() == 40 &&
                handleValue(table, 1) == value && handleKind(table, 1) == 3 &&
                handleRights(table, 1) == 7 && handleFlags(table, 1) == 5 &&
                handleGeneration(table, 1) == 9 && handleAllows(table, 1, 3, 8);
            cleared >> bool <- handleClear(table, 1);
            return ok && cleared;
        }

        testResource(table >> addr, handleValue >> p<byte>, base >> p<byte>) -> bool {
            written >> bool <- resourceWrite(
                table, 0, 1001, adr(handleValue), adr(base), 64, 2, 7, 5, 99
            );
            copied >> bool <- resourceCopy(table, 1, table, 0);
            inside >> addr <- adr(off(base, 8));
            ok >> bool <- written && copied && resourceStride() == 64 &&
                resourceId(table, 1) == 1001 &&
                resourceHandle(table, 1) == adr(handleValue) &&
                resourceBase(table, 1) == adr(base) &&
                resourceBytes(table, 1) == 64 && resourceKind(table, 1) == 2 &&
                resourceRights(table, 1) == 7 && resourceFlags(table, 1) == 5 &&
                resourceOwner(table, 1) == 99 &&
                resourceContains(table, 1, inside, 16) &&
                resourceAllows(table, 1, 3, 8);
            cleared >> bool <- resourceClear(table, 1);
            return ok && cleared;
        }

        testSession(table >> addr, token >> p<byte>, resources >> p<byte>) -> bool {
            written >> bool <- sessionWrite(
                table, 0, 77, 99, adr(token), adr(resources), 2, 7, 1
            );
            copied >> bool <- sessionCopy(table, 1, table, 0);
            stride >> int <- resourceStride();
            second >> addr <- sessionResourceAt(table, 1, 1, stride);
            expected >> addr <- adr(off(resources, stride));
            ok >> bool <- written && copied && sessionStride() == 56 &&
                sessionId(table, 1) == 77 && sessionOwner(table, 1) == 99 &&
                sessionToken(table, 1) == adr(token) &&
                sessionResources(table, 1) == adr(resources) &&
                sessionResourceCount(table, 1) == 2 && sessionRights(table, 1) == 7 &&
                sessionState(table, 1) == 1 && sessionHasRight(table, 1, 3) &&
                second == expected;
            cleared >> bool <- sessionClear(table, 1);
            return ok && cleared;
        }

        run() -> bool {
            mark >> p<byte> <- stackMark();
            handles >> p<byte> <- stackAlloc(handleStride() * 2, 8);
            resources >> p<byte> <- stackAlloc(resourceStride() * 2, 8);
            sessions >> p<byte> <- stackAlloc(sessionStride() * 2, 8);
            payload >> p<byte> <- stackAlloc(64, 8);
            ok >> bool <- testHandle(adr(handles), adr(payload)) &&
                testResource(adr(resources), payload, payload) &&
                testSession(adr(sessions), payload, resources);
            print("manual nC auth resource backend: ");
            if (ok) { println("true"); } else { println("false"); }
            stackRestore(mark);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
