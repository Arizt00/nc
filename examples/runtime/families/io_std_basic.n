use <io:std>;

runtimeFamilyIoStdBasic :: runtime {
    fn:
        run() -> bool {
            input >> addr <- stdIn();
            output >> addr <- stdOut();
            error >> addr <- stdErr();
            first >> bool <- isInteractive();
            second >> bool <- isInteractive();

            return input == input && output == output && error == error &&
                first == second;
        }

    ref main ->> run;

    fa:
        return true;
}
