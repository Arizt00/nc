use <io:output>;
use <process:args>;

rawProcessArgs :: runtime {
    fn:
        run() -> bool {
            handle >> addr <- argsOpen();
            count >> int <- argsCount(handle);
            first >> str <- argsAt(handle, 1);
            second >> str <- argsAt(handle, 2);
            bytes >> int <- argsBytes(handle);
            vector >> addr <- argsData(handle);
            error >> int <- argsError(handle);

            ok >> bool <-
                vector != null &&
                error == 0 &&
                count >= 3 &&
                bytes >= 12 &&
                first == "alpha" &&
                second == "dos palabras";

            argsRelease(handle);

            print("manual nC process args backend: ");
            if (ok) { println("true"); }
            else { println("false"); }
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
