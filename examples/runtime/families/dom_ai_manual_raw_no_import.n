use <io:output>;

domAiManualRawNoImport :: runtime {
    fn:
        run() -> bool {
            table >> p<byte> <- stackAlloc(aiStride() * 3, 8);
            first >> bool <- aiWrite(table, 0, 10, 1, 2, 3, 2, 1, 4, 5);
            second >> bool <- aiWrite(table, 1, 11, 2, 4, 5, 3, 0, 6, 7);
            copied >> bool <- aiCopy(table, 2, table, 0);
            fields >> bool <- aiId(table, 2) == 10 && aiKind(table, 2) == 1 &&
                aiInput(table, 2) == 2 && aiOutput(table, 2) == 3 &&
                aiWeight(table, 2) == 2 && aiBias(table, 2) == 1 &&
                aiFlags(table, 2) == 4 && aiState(table, 2) == 5;
            score >> int <- aiScore(table, 0, 5);
            selected >> int <- aiSelect(table, 2, 5);
            cleared >> bool <- aiClear(table, 2);
            ok >> bool <- aiStride() == 64 && first && second && copied && fields &&
                score == 11 && selected == 1 && cleared && aiState(table, 2) == 0;
            println("manual DOM AI backend without import: " + (ok ? "true" : "false"));
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
