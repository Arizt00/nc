use <audit:assert>;
use <io:output>;

rawAuditAssert :: runtime {
    fn:
        run() -> bool {
            value >> int <- 42;
            checked >> bool <- assert(value == 42);
            equal >> bool <- assertEq(value, 42);
            ranged >> bool <- assertRange(value, 0, 100);
            messaged >> bool <- assertMsg(checked && equal && ranged, null, 0);
            ok >> bool <- checked && equal && ranged && messaged;

            print("manual nC audit assert backend: ");
            if (ok) { println("true"); }
            else { println("false"); }
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
