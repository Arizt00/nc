runtimeFamilyMemoryAlignBasic :: runtime {
    fn:
        run() -> bool {
            left >> str <- alignLeft("nC", 5);
            right >> str <- alignRight("nC", 5);
            center >> str <- alignCenter("nC", 5);
            narrow >> str <- alignLeft("nC", 1);
            negative >> str <- alignRight("nC", -4);
            odd >> str <- alignCenter("nC", 7);

            ok >> bool <- left == "nC   " && right == "   nC" &&
                center == " nC  " && narrow == "nC" && negative == "nC" &&
                odd == "  nC   ";
            strRelease(left);
            strRelease(right);
            strRelease(center);
            strRelease(narrow);
            strRelease(negative);
            strRelease(odd);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
