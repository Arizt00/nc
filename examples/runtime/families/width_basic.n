use <io:output>;
use <text:width>;

widthBasic :: runtime {
    fn:
        run() -> bool {
            text >> str <- "A界👨‍👩‍👧‍👦á";
            ok >> bool <-
                byteLength("Café") == 5 &&
                charCount("Café") == 4 &&
                graphemeCount(text) == 4 &&
                displayWidth(text) == 6 &&
                ansiVisibleWidth("\x1b[31mA界\x1b[0m") == 3;

            print("manual nC Unicode width provider: ");
            if (ok) { println("true"); }
            else { println("false"); }
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
