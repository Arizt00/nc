runtimeFamilyIoUuidBasic :: runtime {
    fn:
        run() -> bool {
            mark >> p<byte> <- stackMark();
            bytes >> p<byte> <- stackAlloc(16, 16);
            fixed >> p<byte> <- stackAlloc(37, 1);
            generated >> p<byte> <- stackAlloc(37, 1);
            index >> int <- 0;
            while (index < 16) {
                wr(off(bytes, index), index);
                index += 1;
            }

            fixedBytes >> int <- uuidFromBytesInto(bytes, fixed, 37);
            generatedBytes >> int <- uuidV4Into(generated, 37);
            fixedText >> str <- cast(fixed);
            generatedText >> str <- cast(generated);
            ok >> bool <- fixedBytes == 36 && generatedBytes == 36 &&
                fixedText == "00010203-0405-0607-0809-0a0b0c0d0e0f" &&
                isUuid(fixedText) && isUuid(generatedText) && !isUuid("invalid");
            stackRestore(mark);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
