use <auth.security:capability>;
use <memory:stack>;
use <io:output>;

authSecurityCapabilityManualRaw {
    fn:
        strideCheck() -> bool { return authCapabilityStride() == 64; }
        writeCopy(table >> p<byte>) -> bool {
            return authCapabilityWrite(table, 0, 901, 101, 202, 7, 3, 4, 5, 1) &&
                authCapabilityCopy(table, 1, table, 0);
        }
        identity(table >> p<byte>) -> bool {
            return authCapabilityId(table, 1) == 901 &&
                authCapabilitySubject(table, 1) == 101 &&
                authCapabilityResource(table, 1) == 202 &&
                authCapabilityScope(table, 1) == 3 &&
                authCapabilityGeneration(table, 1) == 5;
        }
        authority(table >> p<byte>) -> bool {
            return authCapabilityRights(table, 1) == 7 &&
                authCapabilityFlags(table, 1) == 4 &&
                authCapabilityState(table, 1) == 1 &&
                authCapabilityAllows(table, 1, 3);
        }
        clearRecord(table >> p<byte>) -> bool {
            return authCapabilityClear(table, 1) && authCapabilityState(table, 1) == 0;
        }
        run() -> bool {
            table >> p<byte> <- stackAlloc(authCapabilityStride() * 2, 8);
            ok >> bool <- strideCheck() && writeCopy(table) && identity(table) &&
                authority(table) && clearRecord(table);
            println("manual nC auth security capability backend: " + (ok ? "true" : "false"));
            return ok;
        }
    ref main ->> run;
    fa:
        return true;
}
