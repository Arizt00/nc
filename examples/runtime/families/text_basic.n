use <io:output>;
use <text:text>;

textBasic :: runtime {
    fn:
        run() -> bool {
            replaced >> str <- textReplace("one fish two fish", "fish", "byte");
            trimmed >> str <- textTrim("  raw text  ");
            parts >> array<str> <- textSplit("alpha::beta::gamma", "::");

            ok >> bool <-
                textLength("manual") == 6 &&
                textIsEmpty("") &&
                textContains(replaced, "two byte") &&
                replaced == "one byte two byte" &&
                trimmed == "raw text" &&
                parts.len == 3 &&
                parts[0] == "alpha" &&
                parts[1] == "beta" &&
                parts[2] == "gamma";

            print("manual nC text provider: ");
            println(ok ? "true" : "false");

            textSplitRelease(cast<byte>(&parts));
            textRelease(trimmed);
            textRelease(replaced);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
