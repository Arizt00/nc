use <auth.system:permission>;
use <memory:stack>;
use <io:output>;

authSystemPermissionManualRaw {
    fn:
        strideCheck() -> bool { return authPermissionStride() == 64; }

        writeCopy(table >> p<byte>) -> bool {
            written >> bool <- authPermissionWrite(table, 0, 101, 202, 7, 8, 4, 66, 5, 1);
            copied >> bool <- authPermissionCopy(table, 1, table, 0);
            return written && copied;
        }

        identity(table >> p<byte>) -> bool {
            return authPermissionSubject(table, 1) == 101 &&
                authPermissionResource(table, 1) == 202 &&
                authPermissionOwner(table, 1) == 66 &&
                authPermissionGeneration(table, 1) == 5;
        }

        authority(table >> p<byte>) -> bool {
            return authPermissionRights(table, 1) == 7 &&
                authPermissionDenied(table, 1) == 8 &&
                authPermissionFlags(table, 1) == 4 &&
                authPermissionState(table, 1) == 1 &&
                authPermissionAllows(table, 1, 3) &&
                !authPermissionAllows(table, 1, 8);
        }

        clearRecord(table >> p<byte>) -> bool {
            cleared >> bool <- authPermissionClear(table, 1);
            return cleared && authPermissionState(table, 1) == 0;
        }

        run() -> bool {
            table >> p<byte> <- stackAlloc(authPermissionStride() * 2, 8);
            ok >> bool <- strideCheck() && writeCopy(table) && identity(table) &&
                authority(table) && clearRecord(table);
            println("manual nC auth system permission backend: " + (ok ? "true" : "false"));
            return ok;
        }

    ref main ->> run;

    fa:
        return true;
}
