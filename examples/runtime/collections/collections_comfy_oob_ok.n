use <collections:list, queue>;
use <io:output, render>;

collectionsComfyOob :: runtime {
    stc:
        lista >> list<int>;
        cola >> queue<int>;
        first >> int;
        missing >> int;
        removed >> int;
        qFirst >> int;
        qMissing >> int;
        qFuncMissing >> int;
        qLen >> int;
        qFuncLen >> int;
        ok >> bool;

    fn:
        run() -> bool {
            lista >> list<int> <- listCreate<int>();
            cola >> queue<int> <- queueCreate<int>();

            lista.push(10);
            lista.push(11);
            lista.set(99, 33);
            lista.insert(99, 44);
            first >> int <- lista.get(0);
            missing >> int <- lista.get(99);
            removed >> int <- lista.removeAt(99);

            cola.push(20);
            cola.push(30);
            qFirst >> int <- cola.pop();
            qMissing >> int <- cola.get(99);
            qLen >> int <- cola.len();
            qFuncMissing >> int <- queueGet(cola, 99);
            qFuncLen >> int <- queueLen(cola);

            println("list first: " + renderInt(first));
            println("list missing: " + renderInt(missing));
            println("queue pop: " + renderInt(qFirst));
            println("queue missing: " + renderInt(qMissing));
            println("queue function missing: " + renderInt(qFuncMissing));
            println("queue len: " + renderInt(qLen));

            ok >> bool <- first == 10
                && missing == 0
                && removed == 0
                && qFirst == 20
                && qMissing == 0
                && qFuncMissing == 0
                && qLen == 1
                && qFuncLen == 1
                && lista.len() == 2;
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
