use <collections:list>;
use <io:output, render>;

listEmptyDefaultOk :: runtime {
    stc:
        values >> list<int>;
        got >> int;

    fn:
        run() -> bool {
            values >> list<int> <- listCreate<int>();
            got >> int <- listGet(values, 0);
            println("empty default: " + renderInt(got));
            return got == 0;
        }

    ref main ->> run;

    fa:
        return true;

}
