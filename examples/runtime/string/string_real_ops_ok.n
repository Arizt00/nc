use <io:output, render>;

stringRealOps :: runtime {
    stc:
        source >> str;
        part >> str;
        joined >> str;
        logicalLen >> int;
        byteLen >> int;
        cmp >> int;
        ok >> bool;

    fn:
        run() -> bool {
            source >> str <- "A\nB\t\"C\" \\ \? \& \#";
            part >> str <- strSubstring("abcdef", 2, 3);
            joined >> str <- strConcat("n", "C");
            logicalLen >> int <- strLen(source);
            byteLen >> int <- strByteLen(source);
            cmp >> int <- strCompare("alfa", "beta");

            println("part=" + part);
            println("join=" + joined);
            println("len=" + renderInt(logicalLen));
            println("bytes=" + renderInt(byteLen));
            println("upper=" + strToUpper("ncc"));
            println("from=" + strFromInt(42) + ":" + strFromBool(true) + ":" + strFromFt64(3.5));

            ok >> bool <- part == "cde"
                && joined == "nC"
                && logicalLen == 15
                && byteLen == 15
                && cmp < 0
                && strContains(source, "B")
                && strIndexOf(source, "C") == 5
                && strStartsWith(source, "A")
                && strEndsWith(source, "#")
                && strFromInt(42) == "42"
                && strFromBool(true) == "true"
                && strFromFt64(3.5) == "3.5";
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
