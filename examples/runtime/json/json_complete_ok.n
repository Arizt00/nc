use <data:json>;

jsonCompleteOk :: runtime {
    stc:
        root >> int;
        element >> int;
        isotopes >> int;
        first >> int;
        ok >> bool;

    fn:
        run() -> bool {
            root >> int <- jsonParse("{\"element\":\"Cm\",\"number\":96,\"isotopes\":[242,244,247]}");
            element >> int <- jsonObjectGet(root, "element");
            isotopes >> int <- jsonObjectGet(root, "isotopes");
            first >> int <- jsonArrayGet(isotopes, 0);
            ok >> bool <- jsonGetString(element) == "Cm"
                && jsonGetInt(first) == 242
                && jsonArrayLen(isotopes) == 3
                && jsonValidate(jsonStringify(root));
            jsonRelease(first);
            jsonRelease(isotopes);
            jsonRelease(element);
            jsonRelease(root);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
