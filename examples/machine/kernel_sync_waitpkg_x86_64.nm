kernelSyncWaitpkgX86_64[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: kernel;
        features: waitpkg,serialize;

    symbol:
        waitForKernelEvent:
            section: .text;
            binding: global;
            type: routine;

    entry:
        waitForKernelEvent;

    proc:
        waitForKernelEvent:
            abi: sysv64;

    instr:
        mfence;
        umonitor rax;
        umwait eax;
        tpause eax;
        serialize;
        ret;

    verify:
        target;
        abi;
        symbols;
        encoding;
        object;

    seal:
        artifact: object;
        require: verified;
}
