x86VirtualizationVmcsVmcb[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: kernel;
        features: vmx,ept,vpid,invpcid,svm;

    symbol:
        virtualizationEncodingProbe:
            section: .text;
            binding: global;
            type: routine;

    entry:
        virtualizationEncodingProbe;

    proc:
        virtualizationEncodingProbe:
            abi: sysv64;

    instr:
        vmxon [rax];
        vmclear [rax];
        vmptrld [rax];
        vmptrst [rax];
        vmread rax, rbx;
        vmread [rax], rbx;
        vmwrite rax, rbx;
        vmwrite rax, [rbx];
        invept rax, [rbx];
        invvpid rax, [rbx];
        invpcid rax, [rbx];
        vmcall;
        vmxoff;
        vmlaunch;
        vmresume;
        vmrun;
        vmmcall;
        vmload;
        vmsave;
        stgi;
        clgi;
        invlpga;
        ret;

    verify:
        target;
        abi;
        symbols;
        encoding;
        object;

    seal:
        artifact: object;
        require: verified;
}
