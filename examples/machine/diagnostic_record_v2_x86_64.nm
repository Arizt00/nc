diagnosticRecordV2X86_64[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            abi: sysv64;

            instr:
                lea rdi, [rel diagnostic_record];
                mov rax, 0x008000024944434e;
                mov [rdi], rax;
                mov rax, 0x0000000000000403;
                mov [rdi + 8], rax;
                mov rax, 0x7eb89aab7dd8ef64;
                mov [rdi + 16], rax;
                mov rax, 0x0000000d00000005;
                mov [rdi + 80], rax;
                mov [rdi + 88], rax;
                mov rax, 0x00000000ffffffff;
                mov [rdi + 96], rax;

                mov rax, [rdi];
                mov rbx, 0x008000024944434e;
                cmp rax, rbx;
                jne invalid_record;
                mov rax, [rdi + 16];
                mov rbx, 0x7eb89aab7dd8ef64;
                cmp rax, rbx;
                jne invalid_record;
                mov rax, 0;
                ret;

                label invalid_record;
                mov rax, 1;
                ret;

    bss:
        diagnostic_record:
            resq 16;

    verify:
        target;
        abi;
        registers;
        operands;
        symbols;
        encoding;
        object;

    seal:
        artifact: executable;
        require: verified;
        hash: required;
}
