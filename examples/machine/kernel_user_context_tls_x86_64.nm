kernelUserContextTlsX86_64[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: kernel;
        features: fsgsbase;

    symbol:
        preserveTlsBases:
            section: .text;
            binding: global;
            type: routine;

    entry:
        preserveTlsBases;

    proc:
        preserveTlsBases:
            abi: sysv64;

    instr:
        rdfsbase rax;
        rdgsbase r9;
        wrfsbase rax;
        wrgsbase r9;
        ret;

    verify:
        target;
        abi;
        symbols;
        encoding;
        object;

    seal:
        artifact: object;
        require: verified;
}
