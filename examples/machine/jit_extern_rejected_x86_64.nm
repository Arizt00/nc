jitExternRejectedX86_64[@machine] {
    target:
        arch: x86_64;
        abi: win64;
        object: coff;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    extern:
        hostExit:
            abi: win64;
            symbol: "ExitProcess";

    symbol:
        entry:
            section: .text;
            binding: global;
            type: routine;

    entry:
        entry;

    proc:
        entry:
            abi: win64;

    instr:
        sub rsp, 40;
        mov rcx, 42;
        call hostExit;
        add rsp, 40;
        ret;

    reloc:
        host_exit_call:
            type: IMAGE_REL_AMD64_REL32;
            symbol: hostExit;
            section: .text;
            offset: 15;
            addend: -4;

    verify:
        target;
        abi;
        symbols;
        relocations;
        encoding;
        object;

    seal:
        artifact: object;
        require: verified;
}
