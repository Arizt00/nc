jitReturn42X86_64[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        jitReturn42:
            section: .text;
            binding: global;
            type: routine;

    entry:
        jitReturn42;

    proc:
        jitReturn42:
            abi: sysv64;

    instr:
        mov rax, 42;
        ret;

    verify:
        target;
        abi;
        symbols;
        encoding;
        object;

    seal:
        artifact: bytes;
        require: verified;
}
