riscv32_hypervisor_fences :: machine {
    target:
        arch: riscv32;
        abi: ilp32;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: system;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                hfence.vvma zero, zero;
                hfence.gvma zero, zero;
                hinval.vvma zero, zero;
                hinval.gvma zero, zero;
                hlv.b a0, (a1);
                hlv.bu a0, (a1);
                hlv.h a0, (a1);
                hlv.hu a0, (a1);
                hlv.w a0, (a1);
                hlvx.hu a0, (a1);
                hsv.b a0, (a1);
                hsv.h a0, (a1);
                hsv.w a0, (a1);
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
