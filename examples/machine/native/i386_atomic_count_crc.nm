i386_atomic_count_crc :: machine {
    target:
        arch: i386;
        abi: i386-sysv;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                cmpxchg eax, ebx;
                xadd [eax + 4], ebx;
                cmpxchg8b [esi];
                popcnt eax, ebx;
                lzcnt ecx, edx;
                tzcnt esi, edi;
                crc32 eax, ebx;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
