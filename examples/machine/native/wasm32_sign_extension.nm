wasm32_sign_extension :: machine {
    target:
        arch: wasm32;
        abi: wasm;
        object: wasm;
        endian: little;
        pointerWidth: 32;
        profile: nC-wasm32-core-v1;

    symbol:
        main:
            section: code;
            binding: export;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                i32.const 255;
                i32.extend8_s;
                i32.extend16_s;
                i64.const 65535;
                i64.extend8_s;
                i64.extend16_s;
                i64.extend32_s;
                return;

    verify:
        target;
        abi;
        operands;
        encoding;
        object;

    seal:
        artifact: wasm;
        require: verified;
}
