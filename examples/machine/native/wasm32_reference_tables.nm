wasm32_reference_tables :: machine {
    target:
        arch: wasm32;
        abi: wasm;
        object: wasm;
        endian: little;
        pointerWidth: 32;
        profile: userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                i32.const 0;
                ref.null funcref;
                table.set 0;
                i32.const 0;
                table.get 0;
                ref.is_null;
                drop;
                table.size 0;
                drop;
                i32.const 0;
                i32.const 0;
                i32.const 0;
                table.copy 0, 0;
                i32.const 0;
                return;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: wasm;
        require: verified;
}
