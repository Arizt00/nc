armv7_thumb_dsp_saturation :: machine {
    target:
        arch: armv7em;
        abi: aapcs32-m;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: firmware;

    symbol:
        reset:
            section: .text;
            binding: global;
            type: routine;

    entry:
        reset;

    proc:
        reset:
            instr:
                qadd r0, r1, r2;
                qsub r6, r7, r8;
                ssat r6, 12, r7;
                usat r0, 9, r1;
                bx lr;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
