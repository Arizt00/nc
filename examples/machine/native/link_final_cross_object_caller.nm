linkFinalCrossObjectCaller[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    extern:
        linkfinalcallee:

    symbol:
        linkfinalcaller:
            section: .text;
            binding: global;
            type: routine;

    entry:
        linkfinalcaller;

    proc:
        linkfinalcaller:

    instr:
        sub rsp, 8;
        call linkfinalcallee;
        add rsp, 8;
        ret;

    seal:
        artifact: executable;
        require: verified;
}
