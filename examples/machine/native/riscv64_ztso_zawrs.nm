riscv64_ztso_zawrs :: machine {
    target:
        arch: riscv64;
        abi: riscv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: system;
        features: ztso,zawrs;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                fence.tso;
                wrs.nto;
                wrs.sto;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
