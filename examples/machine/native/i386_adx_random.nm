i386_adx_random :: machine {
    target:
        arch: i386;
        abi: i386-sysv;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: userland;
        features: adx,rdrand,rdseed;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                adcx eax, ebx;
                adox ecx, edx;
                rdrand esi;
                rdseed edi;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
