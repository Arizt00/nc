armv7_bit_reverse :: machine {
    target:
        arch: armv7em;
        abi: aapcs32-m;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: firmware;

    symbol:
        reset:
            section: .text;
            binding: global;
            type: routine;

    entry:
        reset;

    proc:
        reset:
            instr:
                rbit r0, r1;
                clz r2, r3;
                rev r4, r5;
                rev16 r6, r7;
                revsh r0, r1;
                bx lr;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
