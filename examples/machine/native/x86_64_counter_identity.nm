x86_64_counter_identity :: machine {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: system;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                rdpmc;
                rdpid rax;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
