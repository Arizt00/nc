aarch64_scalar_bitops :: machine {
    target:
        arch: aarch64;
        abi: aapcs64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                rbit x0, x1;
                rev16 x4, x5;
                rev32 x8, x9;
                rev x10, x11;
                clz x14, x15;
                cls w16, w17;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
