linkElf32DynamicImports[@machine] {
    target:
        arch: i386;
        abi: i386-sysv;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: userland;

    extern:
        printf:

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            frame:
                abi: i386-sysv;
                stackAlign: 4;

            instr:
                sub esp, 4;
                call printf;
                add esp, 4;
                mov eax, 0;
                ret;

    seal:
        artifact: executable;
        require: verified;
}
