riscv32_zbs_bitops :: machine {
    target:
        arch: riscv32;
        abi: ilp32;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: freestanding;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                bset a0, a1, a2;
                bclr a3, a4, a5;
                binv a6, a7, t0;
                bext t1, t2, t3;
                bseti a0, a1, 17;
                bclri a2, a3, 7;
                binvi a4, a5, 23;
                bexti a6, a7, 31;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
