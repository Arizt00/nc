linkMachODynamicImports[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: macho;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    extern:
        _puts:

    symbol:
        _main:
            section: __text;
            binding: global;
            type: routine;

    entry:
        _main;

    proc:
        _main:

    instr:
        sub rsp, 8;
        call _puts;
        add rsp, 8;
        mov rax, 0;
        ret;

    seal:
        artifact: executable;
        require: verified;
}
