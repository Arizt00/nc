riscv64_zbs_bitops :: machine {
    target:
        arch: riscv64;
        abi: riscv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: freestanding;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                bset a0, a1, a2;
                bclr a3, a4, a5;
                binv a6, a7, t0;
                bext t1, t2, t3;
                bseti a0, a1, 48;
                bclri a2, a3, 40;
                binvi a4, a5, 63;
                bexti a6, a7, 32;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
