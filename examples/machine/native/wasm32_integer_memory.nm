wasm32_integer_memory :: machine {
    target:
        arch: wasm32;
        abi: wasm;
        object: wasm;
        endian: little;
        pointerWidth: 32;
        profile: nC-wasm32-core-v1;

    symbol:
        main:
            section: code;
            binding: export;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                i32.const 0;
                i32.const -1;
                i32.store;
                i32.const 0;
                i32.load8_u;
                i32.const 1;
                i32.rotl;
                return;

    verify:
        target;
        abi;
        operands;
        encoding;
        object;

    seal:
        artifact: wasm;
        require: verified;
}
