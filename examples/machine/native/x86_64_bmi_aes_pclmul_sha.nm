x86_64_bmi_aes_pclmul_sha :: machine {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;
        features: bmi1,bmi2,aes,pclmul,sha;

    symbol:
        extensionBytes:
            section: .text;
            binding: global;
            type: routine;

    entry:
        extensionBytes;

    proc:
        extensionBytes:
            abi: sysv64;

    instr:
        andn rax, rbx, rcx;
        bextr rdx, r8, r9;
        blsi r10, r11;
        blsmsk r12, r13;
        blsr r14, r15;
        bzhi rax, rbx, rcx;
        mulx r8, r9, r10;
        pdep r11, r12, r13;
        pext r14, r15, rax;
        rorx rbx, rcx, 7;
        sarx rdx, r8, r9;
        shlx r10, r11, r12;
        shrx r13, r14, r15;
        aesenc xmm0, xmm1;
        aesenclast xmm2, xmm3;
        aesdec xmm4, xmm5;
        aesdeclast xmm6, xmm7;
        aesimc xmm8, xmm9;
        aeskeygenassist xmm10, xmm11, 0x1b;
        pclmulqdq xmm12, xmm13, 0x11;
        sha1msg1 xmm0, xmm1;
        sha1msg2 xmm2, xmm3;
        sha1nexte xmm4, xmm5;
        sha1rnds4 xmm6, xmm7, 2;
        sha256msg1 xmm8, xmm9;
        sha256msg2 xmm10, xmm11;
        sha256rnds2 xmm12, xmm13;
        ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: object;
        require: verified;
}
