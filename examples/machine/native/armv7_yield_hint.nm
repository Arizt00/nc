armv7_yield_hint :: machine {
    target:
        arch: armv7;
        abi: aapcs32;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: firmware;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                yield;
                bx lr;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
