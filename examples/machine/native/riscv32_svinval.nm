riscv32_svinval :: machine {
    target:
        arch: riscv32;
        abi: ilp32;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: system;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                sfence.w.inval;
                sinval.vma a0, a1;
                sfence.inval.ir;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
