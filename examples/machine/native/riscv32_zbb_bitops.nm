riscv32_zbb_bitops :: machine {
    target:
        arch: riscv32;
        abi: ilp32;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: freestanding;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                clz a0, a1;
                ctz a2, a3;
                cpop a4, a5;
                sext.b a0, a1;
                sext.h a2, a3;
                zext.h a4, a5;
                orc.b a6, a7;
                rev8 s0, s1;
                andn a0, a1, a2;
                orn a3, a4, a5;
                xnor a6, a7, t0;
                min t1, t2, t3;
                max t4, t5, t6;
                minu a0, a1, a2;
                maxu a3, a4, a5;
                rol a6, a7, t0;
                ror t1, t2, t3;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
