aarch64_pauth_return :: machine {
    target:
        arch: aarch64;
        abi: aapcs64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;
        features: pauth;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                paciasp;
                xpaclri;
                xpaci x0;
                xpacd x1;
                paciza x2;
                autiza x3;
                pacia x4, x5;
                autda x6, x7;
                autiasp;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
