riscv64_zicond :: machine {
    target:
        arch: riscv64;
        abi: riscv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;
        features: zicond;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                czero.eqz a0, a1, a2;
                czero.nez a3, a4, a5;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
