riscv64_svinval :: machine {
    target:
        arch: riscv64;
        abi: riscv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: system;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                sfence.w.inval;
                sinval.vma a0, a1;
                sfence.inval.ir;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
