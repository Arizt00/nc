linkFinalDataSymbols[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:

    instr:
        mov rax, 0;
        ret;

    data:
        first:
            db 1, 2, 3;
        second:
            dq 9;
        third:
            asciz "ok";

    bss:
        scratch:
            resq 2;

    seal:
        artifact: executable;
        require: verified;
}
