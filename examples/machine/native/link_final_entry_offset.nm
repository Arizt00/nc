linkFinalEntryOffset[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        entrypad:
            section: .text;
            binding: global;
            type: routine;
        realentry:
            section: .text;
            binding: global;
            type: routine;

    entry:
        realentry;

    proc:
        entrypad:
        realentry:

    instr:
        label entrypad;
        nop;
        label realentry;
        mov rax, 7;
        ret;

    seal:
        artifact: executable;
        require: verified;
}
