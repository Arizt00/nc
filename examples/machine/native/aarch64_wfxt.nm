aarch64_wfxt :: machine {
    target:
        arch: aarch64;
        abi: aapcs64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: system;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                wfet x0;
                wfit x1;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
