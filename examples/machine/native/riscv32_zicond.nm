riscv32_zicond :: machine {
    target:
        arch: riscv32;
        abi: ilp32;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: userland;
        features: zicond;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                czero.eqz a0, a1, a2;
                czero.nez a3, a4, a5;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
