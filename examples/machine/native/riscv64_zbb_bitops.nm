riscv64_zbb_bitops :: machine {
    target:
        arch: riscv64;
        abi: riscv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: freestanding;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                clz a0, a1;
                ctz a2, a3;
                cpop a4, a5;
                sext.b a0, a1;
                sext.h a2, a3;
                zext.h a4, a5;
                orc.b a6, a7;
                rev8 s0, s1;
                andn a0, a1, a2;
                min t1, t2, t3;
                rol a6, a7, t0;
                clzw a0, a1;
                ctzw a2, a3;
                cpopw a4, a5;
                rolw a6, a7, t0;
                rorw t1, t2, t3;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
