i386_counter_identity :: machine {
    target:
        arch: i386;
        abi: i386-sysv;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: system;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                rdpmc;
                rdpid eax;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
