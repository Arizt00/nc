wasm32_segment_lifecycle :: machine {
    target:
        arch: wasm32;
        abi: wasm;
        object: wasm;
        endian: little;
        pointerWidth: 32;
        profile: nC-wasm32-core-v1;

    symbol:
        main:
            section: code;
            binding: export;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                i32.const 0;
                i32.const 0;
                i32.const 0;
                memory.init 0, 0;
                data.drop 0;
                i32.const 0;
                i32.const 0;
                i32.const 0;
                table.init 0, 0;
                elem.drop 0;
                i32.const 0;
                return;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: wasm;
        require: verified;
}
