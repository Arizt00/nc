aarch64_bitfield_extract :: machine {
    target:
        arch: aarch64;
        abi: aapcs64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                extr x0, x1, x2, 7;
                ubfm x3, x4, 5, 27;
                sbfm w5, w6, 3, 15;
                bfm x7, x8, 9, 31;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
