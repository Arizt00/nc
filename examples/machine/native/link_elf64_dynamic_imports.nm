linkElf64DynamicImports[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    extern:
        printf:

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:

    instr:
        sub rsp, 8;
        call printf;
        add rsp, 8;
        mov rax, 0;
        ret;

    seal:
        artifact: executable;
        require: verified;
}
