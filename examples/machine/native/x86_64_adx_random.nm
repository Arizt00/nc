x86_64_adx_random :: machine {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;
        features: adx,rdrand,rdseed;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                adcx rax, rbx;
                adox rcx, rdx;
                rdrand r8;
                rdseed r9;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        encoding;
        object;

    seal:
        artifact: elf64;
        require: verified;
}
