i386_obsolete_adjust :: machine {
    target:
        arch: i386;
        abi: i386-sysv;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: legacy-userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                getsec;
                aaa;
                aad;
                aam 16;
                aas;
                daa;
                das;
                salc;
                icebp;
                into;
                xlatb;
                pushad;
                popad;
                ret;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
