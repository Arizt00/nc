linkFinalWindowsExit42[@machine] {
    target:
        arch: x86_64;
        abi: win64;
        object: coff;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    extern:
        ExitProcess:
            abi: win64;
            symbol: "ExitProcess";

    symbol:
        mainCRTStartup:
            section: .text;
            binding: global;
            type: routine;

    entry:
        mainCRTStartup;

    proc:
        mainCRTStartup:
            abi: win64;

    instr:
        sub rsp, 40;
        mov rcx, 42;
        call ExitProcess;
        add rsp, 40;
        ret;

    reloc:
        exit_process_call:
            type: IMAGE_REL_AMD64_REL32;
            symbol: ExitProcess;
            section: .text;
            offset: 15;
            addend: -4;

    verify:
        target;
        abi;
        symbols;
        relocations;
        encoding;
        object;

    seal:
        artifact: executable;
        require: verified;
}
