i386AddTwoMachine[@machine] {
    target:
        arch: i386;
        abi: i386-sysv;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: userland;

    symbol:
        addTwoI386:
            section: .text;
            binding: global;
            type: routine;

    entry:
        addTwoI386;

    proc:
        addTwoI386:
            frame:
                abi: i386-sysv;
                stackAlign: 4;

            instr:
                mov eax, dword [esp + 4];
                add eax, dword [esp + 8];
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        symbols;
        encoding;

    seal:
        artifact: elf32;
        require: verified;
        hash: required;
}
