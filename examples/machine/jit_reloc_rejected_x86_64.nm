jitRelocRejectedX86_64[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        entry:
            section: .text;
            binding: global;
            type: routine;
        targetvalue:
            section: .text;
            binding: local;
            type: object;

    entry:
        entry;

    proc:
        entry:
            abi: sysv64;

    instr:
        mov rax, 0;
        ret;
        label targetvalue;

    reloc:
        local_abs64:
            type: R_X86_64_64;
            symbol: targetvalue;
            section: .text;
            offset: 2;
            addend: 0;

    verify:
        target;
        abi;
        symbols;
        relocations;
        encoding;
        object;

    seal:
        artifact: object;
        require: verified;
}
