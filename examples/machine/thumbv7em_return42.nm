thumbv7emReturn42[@machine] {
    target:
        arch: armv7em;
        abi: aapcs32-m;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: firmware;

    symbol:
        reset:
            section: .text;
            binding: global;
            type: routine;

    entry:
        reset;

    proc:
        reset:
            instr:
                movs r0, 40;
                adds r0, 2;
                svc 7;
                bx lr;

    verify:
        target;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
