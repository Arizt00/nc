flagsImulOverflowSysv64[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:

    instr:
        mov rax, 9223372036854775807;
        mov rbx, 2;
        imul rax, rbx;
        jo overflow;
        mov rax, 0;
        ret;
        label overflow;
        mov rax, 1;
        ret;

    seal:
        artifact: executable;
        require: verified;
}
