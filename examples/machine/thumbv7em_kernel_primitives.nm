thumbv7emKernelPrimitives[@machine] {
    target:
        arch: armv7em;
        abi: aapcs32-m;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: firmware;

    symbol:
        reset:
            section: .text;
            binding: global;
            type: routine;

    entry:
        reset;

    proc:
        reset:
            instr:
                mrs r0, primask;
                msr primask, r0;
                mrs r1, control;
                msr control, r1;
                ldrex r0, [r1];
                strex r2, r0, [r1];
                clrex;
                ands r0, r1;
                orrs r0, r1;
                eors r0, r1;
                muls r0, r1, r0;
                lsls r0, r0, 3;
                lsrs r0, r0, 4;
                asrs r0, r0, 5;
                blx r3;
                bx lr;

    verify:
        target;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
}
