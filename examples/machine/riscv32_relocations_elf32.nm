riscv32RelocationsMachine[@machine] {
    target:
        arch: riscv32;
        abi: ilp32;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: freestanding;

    extern:
        extcall:
            abi: C;
            symbol: "extcall";

    symbol:
        relocRv32:
            section: .text;
            binding: global;
            type: routine;

    entry:
        relocRv32;

    proc:
        relocRv32:
            frame:
                abi: ilp32;
                stackAlign: 16;

            instr:
                auipc a0, 0;
                addi a0, a0, 0;
                jal ra, extcall;
                beq a0, a1, extcall;
                lui a1, 0;
                addi a1, a1, 0;
                ret;

    reloc:
        abs32:
            type: R_RISCV_32;
            symbol: extcall;
            section: .text;
            offset: 0;
        branch:
            type: R_RISCV_BRANCH;
            symbol: extcall;
            section: .text;
            offset: 12;
        jal:
            type: R_RISCV_JAL;
            symbol: extcall;
            section: .text;
            offset: 8;
        call:
            type: R_RISCV_CALL;
            symbol: extcall;
            section: .text;
            offset: 0;
        hi20:
            type: R_RISCV_HI20;
            symbol: extcall;
            section: .text;
            offset: 16;
        lo12:
            type: R_RISCV_LO12;
            symbol: extcall;
            section: .text;
            offset: 20;
        pcrel_hi20:
            type: R_RISCV_PCREL_HI20;
            symbol: extcall;
            section: .text;
            offset: 0;
        pcrel_lo12:
            type: R_RISCV_PCREL_LO12;
            symbol: extcall;
            section: .text;
            offset: 4;
        relax:
            type: R_RISCV_RELAX;
            section: .text;
            offset: 0;

    verify:
        target;
        abi;
        registers;
        operands;
        symbols;
        relocations;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
        hash: required;
}
