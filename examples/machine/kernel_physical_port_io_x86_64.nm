kernelPhysicalPortIoX86_64[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: kernel;

    symbol:
        transferPortBlocks:
            section: .text;
            binding: global;
            type: routine;

    entry:
        transferPortBlocks;

    proc:
        transferPortBlocks:
            abi: sysv64;

    instr:
        insb;
        insw;
        insd;
        outsb;
        outsw;
        outsd;
        ret;

    verify:
        target;
        abi;
        symbols;
        encoding;
        object;

    seal:
        artifact: object;
        require: verified;
}
