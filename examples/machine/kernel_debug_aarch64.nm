kernelDebugAarch64[@machine] {
    target:
        arch: aarch64;
        abi: aapcs64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: kernel;

    symbol:
        debugEntry:
            section: .text;
            binding: global;
            type: routine;

    entry:
        debugEntry;

    proc:
        debugEntry:
            abi: aapcs64;

    instr:
        brk 0x1234;
        hlt 0x2345;
        ret;

    verify:
        target;
        abi;
        symbols;
        encoding;

    seal:
        artifact: bytes;
        require: verified;
}
