i386RelocationsMachine[@machine] {
    target:
        arch: i386;
        abi: i386-sysv;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: userland;

    extern:
        externalroutine:
            abi: C;
            symbol: "externalroutine";

    symbol:
        relocI386:
            section: .text;
            binding: global;
            type: routine;

    entry:
        relocI386;

    proc:
        relocI386:
            frame:
                abi: i386-sysv;
                stackAlign: 4;

            instr:
                call externalroutine;
                mov eax, 0;
                mov ebx, 0;
                jmp externalroutine;
                ret;

    reloc:
        plt_call:
            type: R_386_PLT32;
            symbol: externalroutine;
            section: .text;
            offset: 1;
        abs_data:
            type: R_386_32;
            symbol: externalroutine;
            section: .text;
            offset: 6;
        got_slot:
            type: R_386_GOT32;
            symbol: externalroutine;
            section: .text;
            offset: 11;
        pc_jump:
            type: R_386_PC32;
            symbol: externalroutine;
            section: .text;
            offset: 16;

    verify:
        target;
        abi;
        registers;
        operands;
        symbols;
        relocations;
        encoding;
        object;

    seal:
        artifact: elf32;
        require: verified;
        hash: required;
}
