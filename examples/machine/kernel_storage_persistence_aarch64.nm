kernelStoragePersistenceAarch64[@machine] {
    target:
        arch: aarch64;
        abi: aapcs64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: kernel;

    entry:
        persistRange;

    proc:
        persistRange:
            abi: aapcs64;

    instr:
        dc cvac, x0;
        dc civac, x1;
        dc zva, x2;
        dsb ish;
        ic ivau, x0;
        isb sy;
        ret;

    verify:
        target;
        abi;
        encoding;

    seal:
        artifact: bytes;
        require: verified;
}
