kernelStoragePersistenceRiscv64[@machine] {
    target:
        arch: riscv64;
        abi: riscv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: kernel;

    entry:
        persistRange;

    proc:
        persistRange:
            abi: riscv64;

    instr:
        cbo.clean (a0);
        cbo.flush (a1);
        cbo.inval (a2);
        cbo.zero (a3);
        fence;
        ret;

    verify:
        target;
        abi;
        encoding;

    seal:
        artifact: bytes;
        require: verified;
}
