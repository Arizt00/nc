riscv32AddTwoMachine[@machine] {
    target:
        arch: riscv32;
        abi: ilp32;
        object: elf32;
        endian: little;
        pointerWidth: 32;
        profile: freestanding;

    symbol:
        addTwoRv32:
            section: .text;
            binding: global;
            type: routine;

    entry:
        addTwoRv32;

    proc:
        addTwoRv32:
            frame:
                abi: ilp32;
                stackAlign: 16;

            instr:
                add a0, a0, a1;
                ret;

    verify:
        target;
        abi;
        registers;
        operands;
        symbols;
        encoding;

    seal:
        artifact: elf32;
        require: verified;
        hash: required;
}
