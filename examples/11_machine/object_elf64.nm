objectElfPublic[@machine] {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: userland;

    symbol:
        main:
            section: .text;
            binding: global;
            type: routine;

    entry:
        main;

    proc:
        main:
            instr:
                mov rax, 0;
                ret;

    verify:
        object;
        encoding;

    seal:
        artifact: elf64;
        require: verified;
}
