kernelArchPrimitives :: kernel {
    fn:
        archReady() -> bool {
            destination at 0x1000;
            source      at 0x2000;

            guard arch_capability(1) else return false;
            guard cpu_relax() else return false;
            guard memory_barrier() && instruction_barrier() else return false;
            guard interrupt_disable() && interrupt_enable() else return false;
            guard cycle_counter() >= 0 else return false;

            return memcpy(destination, source, 0) == destination &&
                   memset(destination, 0, 0) == destination;
        }

        haltCpu() -> bool {
            return cpu_halt();
        }

    ref main ->> archReady;
}
