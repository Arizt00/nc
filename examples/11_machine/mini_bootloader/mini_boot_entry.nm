mini_boot_entry :: machine {
    target:
        arch: x86_64;
        abi: sysv64;
        object: elf64;
        endian: little;
        pointerWidth: 64;
        profile: kernel;

    extern:
        kmain:

    symbol:
        _start:
            section: .text;
            binding: global;
            type: routine;

    entry:
        _start;

    proc:
        _start:
            instr:
                cli;
                cld;
                mov rsp, 0x90000;
                xor rbp, rbp;
                sub rsp, 8;
                call kmain;
                add rsp, 8;
                label halt_loop;
                hlt;
                jmp halt_loop;

    verify:
        target;
        operands;
        encoding;
        object;

    seal:
        artifact: object;
        require: verified;
}
