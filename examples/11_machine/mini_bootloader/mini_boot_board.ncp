primitive[@] target x86_64:
    type material_target = "mini-bootloader-board-v1";
    type material_environment = "physical-or-emulated-firmware";

    isa:
        x86_64_reset_entry;
        x86_64_interrupt_control;
        x86_64_port_io;
        x86_64_halt_loop;

    opcode:
        cli_cld;
        mov_stack_pointer;
        call_rel32;
        hlt_jmp;

    encoding:
        exact_little_endian_machine_bytes;
        relocation_retained_for_kmain;

    relocation:
        rel32_kmain;

    abi:
        sysv64;

    operation resetToEntry():
        barrier compiler;
        trace reset_vector_to_start;

    anchor:
        miniBootRoot;

    bridge:
        root.policy.bind;
        root.policy.guard;
        root.memory.resolve;
        machine.machineCore;

    seal:
        miniBootMaterialized;
