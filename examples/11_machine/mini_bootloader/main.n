mini_boot_system :: system {
    const:
        BOOT_MAGIC >> int <- 0x4E43424F;
        BOOT_VERSION >> int <- 1;

    stc:
        launches >> int <- 0;

    fn:
        contractReady(magic >> int, version >> int) -> bool {
            return magic == BOOT_MAGIC && version == BOOT_VERSION;
        }

        run() -> int {
            guard contractReady(BOOT_MAGIC, BOOT_VERSION) else return 2;

            launches += 1;
            return 0;
        }

    ref main ->> run;

    fa:
        return true;
}
