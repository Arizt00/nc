kernelVirtualDevicesPciVirtio :: kernel {
    fn:
        verifyDeviceSurface() -> bool {
            ecam       at 0xE0000000;
            notifyBase at 0xD0000000;

            guard pci_config_read32(0, 1, 0, 0) >= 0 else return false;
            guard pci_config_write32(0, 1, 0, 4, 6) else return false;
            guard pci_ecam_read32(ecam, 0, 1, 0, 0) >= 0 else return false;
            guard pci_ecam_write32(ecam, 0, 1, 0, 4, 6) else return false;
            guard virtio_notify(notifyBase, 0) else return false;

            return debug_break();
        }

    ref main ->> verifyDeviceSurface;
}
