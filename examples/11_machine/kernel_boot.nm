kernelBoot[@machine] {
    stc:
        bootAddr: int;

    str:
        label init:
            reg.ax <- 0x01;
            cmp(reg.ax, 0x01);
            jmp.eq -> ok;
            jmp.ne -> fail;

        label ok:
            halt;

        label fail:
            halt;

    fa:
        to main@<machine.kernel.boot> {
        }
}
