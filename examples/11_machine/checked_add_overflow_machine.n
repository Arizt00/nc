machineCheckedAdd[@machine] {
    reg:
        rax;
        rbx;

    label:
        entryPoint;
        overflow;
        finish;

    inst:
        entryPoint:
        add rax, rbx;
        jmp.ov overflow;
        jmp finish;

        overflow:
        halt;

        finish:
        ret;

    final:
        ret;
}
