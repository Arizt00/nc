{
  "artifact": {
    "path": "EDIT_ME_BOOT_IMAGE_OR_ELF",
    "sha256": "auto"
  },
  "board": {
    "architecture": "riscv64",
    "hardware_revision": "EDIT_ME",
    "id": "riscv64-lab-board-01",
    "model": "EDIT_ME",
    "serial": "EDIT_ME_UNIQUE_BOARD_SERIAL",
    "target": "riscv64-unknown-elf",
    "vendor": "EDIT_ME"
  },
  "commands": {
    "capture": {
      "allow_timeout": true,
      "argv": [
        "picocom",
        "--baud",
        "{baud}",
        "--quiet",
        "{transport_port}"
      ],
      "success_exit_codes": [
        0
      ],
      "timeout_ms": 30000
    },
    "framebuffer": {
      "argv": [
        "EDIT_ME_FRAMEBUFFER_CAPTURE_TOOL",
        "--output",
        "{framebuffer_path}"
      ],
      "success_exit_codes": [
        0
      ],
      "timeout_ms": 30000
    },
    "flash": {
      "argv": [
        "openocd",
        "-f",
        "EDIT_ME_BOARD_CONFIG.cfg",
        "-c",
        "program {artifact} verify reset exit"
      ],
      "success_exit_codes": [
        0
      ],
      "timeout_ms": 180000
    },
    "probe": {
      "argv": [
        "openocd",
        "-f",
        "EDIT_ME_BOARD_CONFIG.cfg",
        "-c",
        "adapter serial {probe_serial}; init; shutdown"
      ],
      "success_exit_codes": [
        0
      ],
      "timeout_ms": 30000
    },
    "reset": {
      "argv": [
        "openocd",
        "-f",
        "EDIT_ME_BOARD_CONFIG.cfg",
        "-c",
        "reset run; shutdown"
      ],
      "success_exit_codes": [
        0
      ],
      "timeout_ms": 30000
    }
  },
  "framebuffer": {
    "height": 768,
    "pixel_format": "xrgb8888",
    "stride": 4096,
    "width": 1024
  },
  "identity": {
    "forbidden_markers": [
      "QEMU",
      "TCG",
      "EMULATOR",
      "SIMULATOR",
      "RENODE",
      "GEM5"
    ],
    "ordered_markers": [
      "NCC_BOOT_START",
      "NCC_BOOT_OK"
    ],
    "probe_markers": [
      "{probe_serial}"
    ],
    "required_markers": [
      "NCC_BOOT_START",
      "NCC_BOOT_OK"
    ]
  },
  "limits": {
    "max_artifact_bytes": 536870912,
    "max_log_bytes": 8388608,
    "max_timeout_ms": 600000
  },
  "manifest_version": 1,
  "policy": {
    "reject_emulated_transport": true,
    "require_clean_git": false,
    "require_framebuffer_capture": true,
    "retain_full_command_logs_within_limits": true
  },
  "schema": "ncc.machine.physical_board_manifest.v1",
  "transport": {
    "baud": 115200,
    "kind": "uart+jtag",
    "physical": true,
    "port": "/dev/ttyUSB0",
    "probe_serial": "EDIT_ME_UNIQUE_DEBUG_PROBE_SERIAL"
  }
}
