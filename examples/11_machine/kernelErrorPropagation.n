kernelErrorPropagation :: kernel {
    stc:
        cleaned >> int <- 0;

    fn:
        source(enabled >> bool) -> Option<int> {
            if (enabled) {
                return some(41);
            }
            return none();
        }

        boot() -> Option<int> {
            defer {
                cleaned += 1;
            }
            value >> int <- source(true)?;
            return some(value + 1);
        }

        run() -> bool {
            result >> Option<int> <- boot();
            return cleaned == 1;
        }

    ref main ->> run;
}
