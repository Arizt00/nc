use <io:output>;


maxMinMedia {
    stc:
        numeros    >> array<int, 50> <- [0];
        resultados >> array<int, 3>  <- [0];
        i      >> int <- 0;
        suma   >> int <- 0;
        maximo >> int <- 0;
        minimo >> int <- 0;

    fn:
        rellenarArray() -> bool {
            i <- 0;

            while (i < 50) {
                numeros[i] <- i;
                i <- i + 1;
            }

            return true;
        }

        calcularValores() -> bool {
            i <- 0;
            suma <- 0;

            maximo <- numeros[0];
            minimo <- numeros[0];

            while (i < 50) {
                if (numeros[i] > maximo) {
                    maximo <- numeros[i];
                }

                if (numeros[i] < minimo) {
                    minimo <- numeros[i];
                }

                suma <- suma + numeros[i];
                i <- i + 1;
            }

            mediaX100 <- (suma * 100) / 50;

            resultados[0] <- maximo;
            resultados[1] <- minimo;
            resultados[2] <- mediaX100;

            return true;
        }

        imprimirResultados() -> bool {
            mediaEntera <- resultados[2] / 100;
            mediaDecimal <- resultados[2] % 100;

            println("===== ARRAY DE RESULTADOS =====");

            print("Maximo: ");
            println(resultados[0]);

            print("Minimo: ");
            println(resultados[1]);

            print("Media: ");
            print(mediaEntera);
            print(".");

            if (mediaDecimal < 10) {
                print("0");
            }

            println(mediaDecimal);

            return true;
        }

        run() -> bool {
            rellenarArray();
            calcularValores();
            imprimirResultados();

            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
