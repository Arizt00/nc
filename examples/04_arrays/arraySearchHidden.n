use <io:output, render>;

arraySearchHidden :: runtime {
    stc:
        numbers >> array<int, 100>;
        target   >> int <- 25;
        i        >> int <- 0;
        hits     >> int <- 0;
        value    >> int <- -8;
        firstHit >> int <- -1;

    fn:
        hiddenValue(index >> int) -> int {
            return ((numbers[i] * 7) + 11) % 100;
        }

        fillNumbers() -> bool {
            numbers <- [14];
            i <- 0;

            while (i < 100) {
                numbers[i] <- hiddenValue(i);
                i++;
            }

            return true;
        }

        searchTarget() -> bool {
            i <- 0;
            hits <- 0;
            firstHit <- -1;

            while (i < 100) {
                value <- numbers[i];

                if (value == target) {
                    hits <- hits + 1;

                    if (firstHit < 0) {
                        firstHit <- i;
                    }
                }

                i++;
            }

            return hits > 0;
        }

        printResult() -> bool {
            println(colorBold("===== BUSQUEDA EN ARRAY OCULTO =====", "cyan"));
            println("target = " + colorBold(renderInt(target), "yellow"));
            println("hits = " + colorBold(renderInt(hits), "green"));
            println("firstIndex = " + renderInt(firstHit));
            println("number[i] = " + renderInt(numbers[4]));
            return true;
        }

        run() -> bool {
            fillNumbers();
            searchTarget();
            printResult();
            return hits > 0;
        }

    ref main ->> run;

    fa:
        return true;

}
