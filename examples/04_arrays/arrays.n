use <io:output, render>;

arraysCompactos {
    stc:
        notas >> array<int, 5> <- [7, 8, 6, 9, 10];
        i     >> int           <- 0;
        suma  >> int           <- 0;

    fn:
        run() -> bool {
            while (i < 5) {
                suma += notas[i];
                i++;
            }
            println("suma = " + renderInt(suma));
            return suma == 40;
        }

    ref main ->> run;

    fa:
        return true;

}
