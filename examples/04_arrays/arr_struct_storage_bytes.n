use <io:output, render>;

arrStructStorageBytes :: runtime {
    Cell :: type {
            value >> int;
            code >> char;
    }

    stc:
        cells >> array<Cell, 2>;
        ok >> bool <- true;

    to main {
        cells <- [0];
        cells[2].value <- 77;
        println(colorBold("Array de structs con storage real", "cyan"));
        println("Cells[1] Value = " + renderInt(cells[1].value));
        println(color("ok = " + renderBool(ok), "173, 232, 244"));
    }

    fa:
        return true;

}
