use <io:output, render>;

maxMinMediaArray {
    stc:
        numeros >> array<int, 10>;

        i >> int;
        suma >> int;
        maximo >> int;
        minimo >> int;

        mediaX100 >> int;
        mediaEntera >> int;
        mediaDecimal >> int;

    fn:
        inicializarArray() -> bool {
            numeros >> array<int, 10> <- [12, 5, 7, 99, 3, 18, 42, 1, 30, 10];
            return true;
        }

        calcularValores() -> bool {
            i >> int <- 0;
            suma >> int <- 0;

            maximo >> int <- numeros[0];
            minimo >> int <- numeros[0];

            while (i < 10) {
                if (numeros[i] > maximo) {
                    maximo >> int <- numeros[i];
                }

                if (numeros[i] < minimo) {
                    minimo >> int <- numeros[i];
                }

                suma >> int <- suma + numeros[i];
                i >> int <- i + 1;
            }

            mediaX100 >> int <- (suma * 100) / 10;
            mediaEntera >> int <- mediaX100 / 100;
            mediaDecimal >> int <- mediaX100 % 100;

            return true;
        }

        imprimirResultados() -> bool {
            println("===== RESULTADOS DEL ARRAY =====");

            println("Valor maximo: " + renderInt(maximo));
            println("Valor minimo: " + renderInt(minimo));
            println("Media: " + renderInt(mediaEntera) + ".");

            if (mediaDecimal < 10) {
                print("0");
            }

            println(mediaDecimal);

            return true;
        }

        run() -> bool {
            inicializarArray();
            calcularValores();
            imprimirResultados();

            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
