use <io:output>;


arrayCapicua {
    stc:
        numeros >> array<int, 7>;

        inicio >> int;
        fin >> int;
        esCapicua >> bool;

    fn:
        inicializarArray() -> bool {
            numeros >> array<int, 7> <- [1, 2, 3, 4, 3, 2, 1];

            inicio >> int <- 0;
            fin >> int <- 6;
            esCapicua >> bool <- true;

            return true;
        }

        comprobarCapicua() -> bool {
            while (inicio < fin) {
                if (numeros[inicio] != numeros[fin]) {
                    esCapicua >> bool <- false;
                    return false;
                }

                inicio >> int <- inicio + 1;
                fin >> int <- fin - 1;
            }

            return true;
        }

        imprimirResultado() -> bool {
            if (esCapicua) {
                println("El array es capicua.");
            } else {
                println("El array no es capicua.");
            }

            return true;
        }

        run() -> bool {
            inicializarArray();
            comprobarCapicua();
            imprimirResultado();

            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
