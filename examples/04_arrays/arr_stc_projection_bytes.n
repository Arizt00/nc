use <io:output, render>;

arrStcProjectionBytes :: runtime {
    stc:
        base  >> int           <- -8;
        serie >> array<int, 3> <- [1, -2, base + 11];
        ok    >> bool          <- true;

    to main {
        println(colorBold("Array stc proyectado a bytes reales", "cyan"));
        println("serie[0] = " + renderInt(serie[0]));
        println("serie[1] = " + renderInt(serie[1]));
        println("serie[2] = " + renderInt(serie[2]));
        println("ok = " + renderBool(ok));
    }

    fa:
        return true;

}
