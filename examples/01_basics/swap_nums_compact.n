use <io:output, render>;

swapNumerosCompacto :: runtime {
    stc:
        first  >> int  <- 5;
        second >> int  <- 10;
        ok     >> bool <- false;

    fn:
        show(titulo >> str) -> bool {
            println(colorBold(titulo, "cyan"));
            println("First number  = " + renderInt(first));
            println("Second number = " + renderInt(second));
            return true;
        }

        run() -> bool {
            show("--Before swap--");

            swap(first, second);
            ok <- first == 10 && second == 5;

            println("");
            show("--After swap--");
            println("Swap correcto = " + renderBool(ok));

            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
