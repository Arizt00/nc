use <io:output, render>;

postIncrementCompact :: runtime {
    stc:
        i  >> int  <- 0;
        ok >> bool <- false;

    fn:
        run() -> bool {
            i++;
            i <- i++;
            ok <- i == 2;

            println("i=" + renderInt(i));
            println("ok=" + renderBool(ok));

            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
