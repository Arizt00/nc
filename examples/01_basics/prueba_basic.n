/*vamos a crear un programa que te pida tu nombre y te salude*/

use <io:output, input>;

pruebaBasica {
    stc:
        nombre >> str;

    fn:
        leerNombre() -> bool {
            println("¿Cuál es tu nombre?");
            nombre <- readStr();
            return true;
        }
        saludar() -> bool {
            println("Hola, " + nombre + "!");
            return true;
        }
}
