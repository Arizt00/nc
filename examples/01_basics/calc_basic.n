use <io:output, input>;

calculadoraBasica {
    stc:
        numeroA >> int;
        numeroB >> int;
        opcion >> int;
        resultado >> int;
    fn:
        ejecutar() -> bool {
            println("Introduce el primer numero: "); numeroA <- readInt(); numeroA !> int : dev(runtime.InputParserError);
            println("Introduce segundo numero: "); numeroB <- readInt(); numeroB !> int : dev(runtime.InputParserError);
            println("Que quieres hacer?:"); println("1. Sumar"); println("2. Restar"); println("3. Multiplicar"); println("4. Salir"); print(">");
            opcion >> int <- readInt();
            opcion !> int : dev(runtime.InputParseError);
            if (opcion == 1) { resultado <- numeroA + numeroB;
                println("Resultado de la suma:"); println(resultado); return true; }
            if (opcion == 2) { resultado <- numeroA - numeroB;
                println("Resultado de la resta:"); println(resultado); return true; }
            if (opcion == 3) { resultado <- numeroA * numeroB; println("Resultado de la multiplicacion:"); println(resultado); return true; }
            if (opcion == 4) { println("Saliendo."); return true; }
            println("Opcion no valida."); return false;
        }
    ref main ->> ejecutar;
    fa:
        return true;

}
