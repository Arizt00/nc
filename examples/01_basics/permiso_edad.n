use <io:output, input>;

permisoEdad {
    stc:
        edadMinimaAcceso >> int;
        edadActual >> int;
        edadClasificar >> int;
        mensaje >> str;

    fn:
        boot() -> bool {
            edadMinimaAcceso >> int <- 18;
            return true;
        }

        comprobarPermiso() -> bool {
            if (edadActual < edadMinimaAcceso) {
                println("Eres menor de edad.");
                println("Acceso denegado.");
                return false;
            }

            println("Acceso permitido.");
            return true;
        }

        clasificarEdad() -> str {
            if (edadClasificar < 18) {
                return "Eres menor de edad.";
            } else if (edadClasificar <= 25) {
                return "Eres joven.";
            } else if (edadClasificar <= 64) {
                return "Eres adulto.";
            } else {
                return "Eres anciano.";
            }
        }

        ejecutar() -> bool {
            boot();

            println("=== CONTROL DE ACCESO POR EDAD ===");
            print("Introduce tu edad para comprobar el acceso: ");
            edadActual >> int <- readInt();
            comprobarPermiso();

            println("");
            println("=== CLASIFICADOR DE EDAD ===");
            print("Introduce nuevamente tu edad: ");
            edadClasificar >> int <- readInt();

            mensaje >> str <- clasificarEdad();
            println(mensaje);

            return true;
        }

    ref main ->> ejecutar;

    fa:
        return true;

}
