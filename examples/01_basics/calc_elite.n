use <io:output, render>;

calculadoraElite {
    stc:
        numeroA >> int;
        numeroB >> int;
        opcion >> int;
        resultado >> int;
        historial >> array<int, 5>;
        historialIndex >> int;

    fn:
        ejecutar() -> bool {
            numeroA <- 7;
            numeroB <- 3;
            opcion <- 1;
            historial <- [1];
            historialIndex <- 1;

            if (opcion == 1) {
                resultado <- numeroA + numeroB;
            } else {
                resultado <- numeroA - numeroB;
            }

            historial[historialIndex] <- resultado;

            println("resultado = " + renderInt(resultado));

            return true;
        }

    ref main ->> ejecutar;

    fa:
        return true;

}
