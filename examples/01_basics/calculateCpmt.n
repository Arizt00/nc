use <io:output, render>;

calculadoraElite {
   stc:
        resultado >> int <- 0;
        numeroA >> int <- 7;
        numeroB >> int <- 3;
        opcion  >> int <- 0;

   to main {
        if(opcion == 1) {
            resultado <- numeroA + numeroB;
            } else {
                resultado <- numeroA - numeroB;
        }
        println("Resultado = " + renderInt(resultado));
   }
    fa:
        return true;

}
