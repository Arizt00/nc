use <io:output>;

validarOperacion {
    stc:
            a >> int;
            b >> int;
            c >> int;
            ok >> bool;
            totalTests >> int;
            testsValidos >> int;

        fn:
            validarBase(a >> int, b >> int, c >> int) -> bool {
                    if (c <= 0) {
                        println("Fallo: c no es positivo");
                        println(c);
                        return false;
                    }

                    if (a >= c) {
                        println("Fallo: a no es menor que c");
                        println(a);
                        println(c);
                        return false;
                    }

                    if ((a + c) != b) {
                        println("Fallo: a + c no coincide con b");
                        println(a);
                        println(b);
                        println(c);
                        return false;
                    }

                    return true;
                }

            validarOperacion(a >> int, b >> int, c >> int) -> bool {
                if (!validarBase(a, b, c)) {
                    return false;
                }

                if ((b % 2) != 0) {
                    dev(numeroImpar);
                }

                println("Operacion valida");
                print("a = ");
                print(a);
                print(" b = ");
                print(b);
                print(" c = ");
                println(c);

                return true;
            }

            ejecutarCaso(a >> int, b >> int, c >> int) -> bool {
                totalTests >> int <- totalTests + 1;

                println("=== nuevo caso ===");
                print("entrada -> ");
                print("a = ");
                print(a);
                print(" b = ");
                print(b);
                print(" c = ");
                println(c);

                if (validarOperacion(a, b, c)) {
                    testsValidos >> int <- testsValidos + 1;
                    println("Resultado: caso correcto");
                    return true;
                }

                println("Resultado: caso invalido");
                return false;
            }

        to main {
        totalTests >> int <- 0;
        testsValidos >> int <- 0;

        // Caso 1: correcto
        ejecutarCaso(4, 12, 8);

        // Caso 2: c no es positivo
        ejecutarCaso(2, 1, -1);

        // Caso 3: a no es menor que c
        ejecutarCaso(9, 15, 4);

        // Caso 4: suma incorrecta
        ejecutarCaso(3, 20, 6);

        // Caso 5: base correcta pero b impar -> dev(numeroImpar)
        ejecutarCaso(2, 7, 5);

        println("=== resumen final ===");
        print("tests totales =");
        print(totalTests);
        print(" validos =");
        println(testsValidos);
        }

        fa:
            return true;

    }
