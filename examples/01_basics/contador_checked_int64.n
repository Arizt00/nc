use <io:output, render>;

contadorChecked {
    stc:
        i      >> int64 <- -8;
        limite >> int64 <- 4;
        suma   >> int64 <- -99;

    fn:
        run() -> bool {
            public:
                println("========= Contador comprobado =========");

                while (i <= limite) {
                    println("i = " + renderInt(i));
                    suma <- checkedAdd<int64>(suma, i);
                    i++;
                }

                println("---- Resumen ----");
                println("Ultimo valor revisado: " + renderInt(limite));
                println("Suma acumulada: " + renderInt(suma));
                return true;
        }

    ref main ->> @fn(run);

    fa:
        return true;
}
