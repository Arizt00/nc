use <io:output, render>;
use <memory:ptr, heap>;

compoundOperatorsOficial :: runtime {
    Counter :: type {
            campo >> int;
    }

    stc:
        i >> int <- 1;
        x >> int <- 3;
        obj >> Counter;
        base >> p<int>;
        p >> p<int>;
        primero   >> int  <- 0;
        segundo   >> int  <- 0;
        distancia >> int  <- 0;
        checksum  >> int  <- 0;
        ok        >> bool <- false;

    fn:
        preparar() -> bool {
            obj.campo <- 4;
            base !> p<int> : alloc(16);
            p <- base;
            return true;
        }

        operarEnteros() -> bool {
            i++;
            i--;
            i += 5;
            i -= 2;
            x *= 2;
            return true;
        }

        operarStruct() -> bool {
            obj.campo++;
            return true;
        }

        operarPuntero() -> bool {
            *p <- 100;
            primero <- *p;
            p++;
            *p <- 200;
            segundo <- *p;
            distancia <- pDiff(p, base);
            return true;
        }

        validar() -> bool {
            checksum <- i + x + obj.campo + distancia + primero + segundo;
            ok <- i == 4 && x == 6 && obj.campo == 5 && distancia == 1 && primero == 100 && segundo == 200 && checksum == 316;
            return ok;
        }

        mostrar() -> bool {
            println(colorBold("===== OPERADORES COMPUESTOS =====", "cyan"));
            println("i = " + renderInt(i));
            println("x = " + renderInt(x));
            println("campo = " + renderInt(obj.campo));
            println("primero = " + renderInt(primero));
            println("segundo = " + renderInt(segundo));
            println("distancia = " + renderInt(distancia));
            println("checksum = " + renderInt(checksum));
            println("ok = " + renderBool(ok));
            return true;
        }

        liberar() -> bool {
            free(base);
            return true;
        }

        run() -> bool {
            preparar();
            operarEnteros();
            operarStruct();
            operarPuntero();
            validar();
            mostrar();
            liberar();
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
