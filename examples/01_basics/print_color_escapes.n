use <io:output, render>;

printColorEscapes :: runtime {
    to main {
        println(colorBold("nC print/color demo", "cyan"));
        println("##");
        println("Linea 1\nLinea 2 con \& literal, \? literal y \# literal");
        print("Estado: ");
        println(color("ok", "verde"));
    }

    fa:
        return true;

}
