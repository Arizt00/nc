use <io:output, render>;
renderBinary {
    stc:
        cero         >> int <- 0;
        cinco        >> int <- 5;
        cuarentaYDos >> int <- 42;
        negativo     >> int <- -65;

    to main {
        println("bin(0) = " + renderBinary(cero));
        println("bin(5) = " + renderBinary(cinco));
        println("bin(42) = " + renderBinary(cuarentaYDos));
        println("bin(-7) = " + renderBinary(negativo));
    }
    fa:
        return true;

}