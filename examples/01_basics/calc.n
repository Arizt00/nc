use <io:output, render>;

calcBasica {
    stc:
        a        >> int <- 8;
        b        >> int <- 4;
        suma     >> int <- 0;
        producto >> int <- 0;

    fn:
        run() -> bool {
            suma <- a + b;
            producto <- a * b;
            println("suma = " + renderInt(suma));
            println("producto = " + renderInt(producto));
            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
