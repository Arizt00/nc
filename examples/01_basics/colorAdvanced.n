use <io:output, render>;

colorAdvanced :: runtime {
    stc:
        a        >> int  <- 0;
        b        >> int  <- 0;
        etiqueta >> str  <- "";
        ok       >> bool <- false;

    fn:
        run() -> bool {
            /*
             * Comentario de bloque real: el lexer lo descarta igual que //,
             * y el plugin lo debe pintar como comentario normal.
            */
            a <- 0;
            b <- (a != 0) ? 10 : 20;
            etiqueta <- ("nC" != "") ? "texto-activo" : "texto-vacio";
            ok <- b == 20 && etiqueta == "texto-activo";

            println(colorBold("color + ?: + /**/ funcionando", "#1E90FF"));
            println(color("derivado neon", "rojo neon"));
            println(color("rgb directo", "RGB(18, 128, 4)"));
            println("b = " + renderInt(b));
            println("ok = " + renderBool(ok));
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
