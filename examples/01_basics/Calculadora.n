/*
 * Una operacion binaria trabaja con dos operandos.
 * Aqui leemos dos numeros y aplicamos suma, resta, multiplicacion y division.
 */

use <io:output, render, input>;

Calculadora :: runtime {
    stc:
        num1      >> int <- 0;
        num2      >> int <- 0;
        resultado >> int <- 0;

    fn:
        leerNumeros() -> bool {
            print("Introduce el primer numero: ");
            num1 >> int <- readInt();

            print("Introduce el segundo numero: ");
            num2 >> int <- readInt();

            return true;
        }

        sumar() -> bool {
            resultado >> int <- num1 + num2;
            println("Suma = " + renderInt(resultado));
            return true;
        }

        restar() -> bool {
            resultado >> int <- num1 - num2;
            println("Resta = " + renderInt(resultado));
            return true;
        }

        multiplicar() -> bool {
            resultado >> int <- num1 * num2;
            println("Multiplicacion = " + renderInt(resultado));
            return true;
        }

        dividir() -> bool {
            if (num2 == 0) {
                println("No se puede dividir entre 0.");
                return false;
            }

            resultado >> int <- num1 / num2;
            println("Division = " + renderInt(resultado));
            return true;
        }

        run() -> bool {
            leerNumeros();

            println("----- RESULTADOS -----");
            sumar();
            restar();
            multiplicar();
            dividir();

            return true;
        }

    ref main ->> run;

    fa:
        return true;

}