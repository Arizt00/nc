/*
En este ejemplo veremos cómo nC imprime por pantalla
el resultado de comparar dos valores booleanos.

El operador != significa "distinto de".
Devuelve true cuando los dos valores comparados son diferentes.
Devuelve false cuando los dos valores son iguales.
*/

use <io:output, render>;

comparacionBooleana :: runtime {
    stc:
        a >> bool <- false;
        b >> bool <- false;
        c >> bool <- false;

    to main {
            /*
            Como a y b valen false, ambos valores son iguales.
            Por tanto, a != b devuelve false.
            */
            c >> bool <- a != b;

            println("c = " + renderBool(c));

            return true;
        }


    fa:
        return true;

}

/*
Tabla de resultados del operador != con booleanos:

false != false -> false
false != true  -> true
true  != false -> true
true  != true  -> false

No se está realizando una suma.
Se está comprobando si los dos valores booleanos son distintos.
*/