use <io:output, render>;
contador {
    stc:
        i      >> int <- 0;
        limite >> int <- 4;
        suma   >> int <- 0;
        desbordamiento >> int <- -2;

    fn:
        run () -> void {
            println("========= Contador ========");
            /*
            * i recorre desde -8 hasta el limite (4).
            * suma es una variable acumulativa de cada valor recorrido.
            */
            if(limite > desbordamiento || limite < -desbordamiento) {
                println("Err: desbordamiento en el buffer.");
            } else {
                while(i <= limite) {
                    println("i = " + renderInt(i));
                    suma <- suma + i;
                    i++;
                }
                println("---- Resumen ----");
                println("Ultimo valor registraado: " + renderInt(limite));
                println("Suma desde i hasta limie: " + renderInt(suma));
        }
        return;
    }

    ref main ->> run;

    fa:
        return true;

}
