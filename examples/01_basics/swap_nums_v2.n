use <io:output, render>;

swapNumerosMejorado :: runtime {
    /*
     * SwapTrace documenta el contrato logico del ejercicio:
     * antes tenemos (first, second) y despues esos valores deben aparecer
     * intercambiados. En Java esto queda implicito; en nC lo dejamos
     * nombrado para que el programa sea mas verificable.
     */
    SwapTrace :: type {
            firstAntes >> int;
            secondAntes >> int;
            firstDespues >> int;
            secondDespues >> int;
    }

    stc:
        /*
         * stc guarda el estado persistente del programa.
         * first y second cambian durante la ejecucion; ok resume si el swap
         * cumplio el contrato esperado.
         */
        first >> int;
        second >> int;
        ok >> bool;
        /*
         * temporary es scratch temporal: solo sirve durante el intercambio.
         * Por eso vive en local y no en stc.
         */
        temporary >> int <- 0;

    fn:
        boot() -> bool {
            first >> int <- 5;
            second >> int <- 10;
            ok >> bool <- false;
            return true;
        }

        imprimirEstado(titulo >> str) -> bool {
            println(colorBold(titulo, "cyan"));
            println("First number  = " + renderInt(first));
            println("Second number = " + renderInt(second));
            return true;
        }

        intercambiar() -> bool {
            temporary >> int <- first;
            first >> int <- second;
            second >> int <- temporary;
            return true;
        }

        validarSwap() -> bool {
            return first == 10 && second == 5;
        }

        run() -> bool {
            boot();
            imprimirEstado("--Before swap--");
            intercambiar();
            ok >> bool <- validarSwap();
            println("");
            imprimirEstado("--After swap--");
            println("Swap correcto = " + renderBool(ok));
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
