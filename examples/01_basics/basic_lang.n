//la función básico del lenguaje.

//Zona de imports.
use <io:output, render, input>;

basicoLenguaje {
    stc:
        a >> int;

    fn:
        iniciar() -> bool {
            a >> int <- readInt();
            print(renderInt(a));
            return true;
        }

    ref main ->> iniciar;

    fa:
        return true;

    }
