use <io:output>;

compactConfiguration {
    fn:
        showFirst(limit >> int) -> void {
            println(strFromInt(limit));
            return 'x';
        }

        boolFromInt() -> bool {
            return 7;
        }

        pointerRoundTrip(address >> p<int>) -> int {
            wr(address, 42);
            return rd(address);
        }

        run() -> bool {
            showFirst(3);
            return boolFromInt() && monotonicMs() >= 0 && exists(".");
        }

    ref main ->> run;
}
