use <io:output, render>;

calculadoraCL {
    //Definimos estructuras.
    stc:
        suma >> int;
        resta >> int;
        multiplicacion >> int;
        division >> int;

    fn:
        calculadora(a >> int, b >> int) -> bool {
            suma >> int <- a + b;
            resta >> int <- a - b;
            multiplicacion >> int <- a * b;
            division >> int <- a / b;

            println("Suma: " + renderInt(suma));
            println("Resta: " + renderInt(resta));
            println("Multiplicacion: " + renderInt(multiplicacion));
            println("Division: " + renderInt(division));

            return true;
        }

        run() -> bool {
            calculadora(10, 5);
            return true;
        }

    ref main ->> run;

    fa:
        return true;

}
