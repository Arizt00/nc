use <io:output, render, input>;

calculadoraAvanzada {
    stc:
        numeroA >> int;
        numeroB >> int;
        opcion >> int;
        resultado >> int;
        operacionesRealizadas >> int;
        continuar >> bool;
        operacionValida >> bool;

    fn:
        leerNumeros() -> bool {
            println("Introduce el primer numero:");
            numeroA >> int <- readInt();
            numeroA !> int : dev(runtime.InputParseError);

            println("Introduce el segundo numero:");
            numeroB >> int <- readInt();
            numeroB !> int : dev(runtime.InputParseError);

            return true;
        }

        mostrarMenu() -> bool {
            println("");
            println("===== CALCULADORA AVANZADA nC =====");
            println("1. Sumar");
            println("2. Restar");
            println("3. Multiplicar");
            println("4. Dividir");
            println("5. Comparar numeros");
            println("6. Mostrar ultimo resultado");
            println("7. Introducir nuevos numeros");
            println("8. Salir");
            print("> ");

            opcion >> int <- readInt();
            opcion !> int : dev(runtime.InputParseError);

            return true;
        }

        validarOpcion() -> bool {
            if (opcion >= 1 && opcion <= 8) {
                return true;
            }

            println("Opcion no valida.");
            return false;
        }

        sumar() -> bool {
            resultado >> int <- numeroA + numeroB;

            println("Resultado de la suma: " + renderInt(resultado));

            operacionesRealizadas >> int <- operacionesRealizadas + 1;
            return true;
        }

        restar() -> bool {
            resultado >> int <- numeroA - numeroB;

            println("Resultado de la resta:" + renderInt(resultado));

            operacionesRealizadas >> int <- operacionesRealizadas + 1;
            return true;
        }

        multiplicar() -> bool {
            resultado >> int <- numeroA * numeroB;

            println("Resultado de la multiplicacion:" + renderInt(resultado));

            operacionesRealizadas >> int <- operacionesRealizadas + 1;
            return true;
        }

        dividir() -> bool {
            if (numeroB == 0) {
                println("No se puede dividir entre cero.");
                return false;
            }

            resultado >> int <- numeroA / numeroB;

            println("Resultado de la division entera:" + renderInt(resultado));

            operacionesRealizadas >> int <- operacionesRealizadas + 1;
            return true;
        }

        comparar() -> bool {
            if (numeroA > numeroB) {
                println("El primer numero es mayor que el segundo.");
                resultado >> int <- numeroA;
                operacionesRealizadas >> int <- operacionesRealizadas + 1;
                return true;
            }

            if (numeroA < numeroB) {
                println("El segundo numero es mayor que el primero.");
                resultado >> int <- numeroB;
                operacionesRealizadas >> int <- operacionesRealizadas + 1;
                return true;
            }

            println("Los dos numeros son iguales.");
            resultado >> int <- numeroA;
            operacionesRealizadas >> int <- operacionesRealizadas + 1;
            return true;
        }

        mostrarUltimoResultado() -> bool {
            println("Ultimo resultado registrado:" + renderInt(resultado));

            return true;
        }

        mostrarResumenFinal() -> bool {
            println("");
            println("===== RESUMEN FINAL =====");

            println("Operaciones realizadas: " + renderInt(operacionesRealizadas));

            println("Ultimo resultado: " + renderInt(resultado));

            println("Programa finalizado.");

            return true;
        }

        ejecutarOperacion() -> bool {
            operacionValida >> bool <- validarOpcion();

            if (!operacionValida) {
                return false;
            }

            if (opcion == 1) {
                return sumar();
            }

            if (opcion == 2) {
                return restar();
            }

            if (opcion == 3) {
                return multiplicar();
            }

            if (opcion == 4) {
                return dividir();
            }

            if (opcion == 5) {
                return comparar();
            }

            if (opcion == 6) {
                return mostrarUltimoResultado();
            }

            if (opcion == 7) {
                return leerNumeros();
            }

            if (opcion == 8) {
                continuar >> bool <- false;
                return true;
            }

            return false;
        }

        iniciarEstado() -> bool {
            resultado >> int <- 0;
            operacionesRealizadas >> int <- 0;
            continuar >> bool <- true;
            operacionValida >> bool <- false;

            return true;
        }

        ejecutar() -> bool {
            iniciarEstado();
            leerNumeros();

            while (continuar) {
                mostrarMenu();
                ejecutarOperacion();
            }

            mostrarResumenFinal();

            return true;
        }

    ref main ->> ejecutar;

    fa:
        return true;

}