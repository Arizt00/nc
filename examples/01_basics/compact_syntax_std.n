use <io:output, render>;
use <memory:ptr, heap>;

compactSyntaxOficial :: runtime {
    stc:
        base >> p<int>;
        p >> p<int>;
        a       >> int  <- 10;
        b       >> bool <- true;
        primero >> int  <- 0;
        segundo >> int  <- 0;
        ok      >> bool <- false;

    fn:
        run() -> bool {
            base !> p<int> : alloc(16);
            p <- base;

            *p <- b ? a : 0;
            primero <- *p;
            p++;
            *p <- 20;
            segundo <- *p;

            swap(primero, segundo);
            ok <- primero == 20 && segundo == 10;

            println("primero = " + renderInt(primero));
            println("segundo = " + renderInt(segundo));
            println("ok = " + renderBool(ok));
            free(base);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
