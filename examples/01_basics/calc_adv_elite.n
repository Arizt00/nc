/* Eje. 1: crea una calculadora capaza de
devolver el resultado de cualquier numero,
haciendo uso de multiples funciones. */

//Importamos la libreria de entrada/salida
use <io:output, render, input>;
 //Estos imports nos serviran para leer y mostrar la entrada del usuario
 //Definimos la estructura de la calculadora

calculadoraAvanzadaElite {
    //Definimos los campos de la estructura
    stc:
        numeroA >> int;
        numeroB >> int;
        opcion >> int;
        resultado >> int;
        operacionesRealizadas >> int;
        continuar >> bool;
        operacionValida >> bool;
        salir >> bool;

       //N Definimos las funciones de la calculadora
    fn:
        leerNumeros() -> bool{
            println("Introduce el primer número:");
            numeroA <- readInt();
            numeroA !> int : dev(runtime.InputParseError);

            println("Introduce el segundo número:");
            numeroB <- readInt();
            numeroB !> int : dev(runtime.InputParseError);

            return true;
        }

        mostrarMenu() -> bool {
            println("");
        println("===== CALCULADORA ===");
        println("1. Sumar");
        println("2. Restar");
        println("3. Multiplicar");
        println("4. Dividir");
        println("5. Guardar resultado en memoria");
        println("6. Mostrar ultimo resultado");
        println("7. Introducir nuevos numeros");
        println("8. Salir");
        print("> ");

        opcion <- readInt();
        opcion !> int : dev(runtime.InputParseError);
        return true;
        }

        validarOpcion() -> bool {
            if (opcion >= 1 && opcion <= 8) {
                return true;
            }

            println("Opcion no valida.");
            return false;
        }

        sumar() -> bool {
            resultado <- numeroA + numeroB;

            println("Resultado de la suma:");
            println(resultado);
            return true;
        }

        restar() -> bool {
            resultado <- numeroA - numeroB;

            println("Resultado de la resta:");
            println(resultado);
            return true;
        }

        multiplicar() -> bool {
            resultado <- numeroA * numeroB;

            println("Resultado de la multiplicacion:");
            println(resultado);
            return true;
        }

        dividir() -> bool {
            if (numeroB == 0) {
                println("Error: No se puede dividir por cero.");
                return false;
            }

            resultado <- numeroA / numeroB;

            println("Resultado de la division:");
            println(resultado);
            return true;
        }

        porcentaje() -> bool {
            if (numeroB == 0) {
                println("Error: No se puede calcular el porcentaje con un divisor de cero.");
                return false;
            }

            resultado <- (numeroA * 100) / numeroB;

            println("Resultado del porcentaje:");
            println(resultado);
            return true;
        }

        guardarEnMemoria() -> bool {
            // Aquí podrías implementar la lógica para guardar el resultado en memoria
            println("Resultado guardado en memoria.");
            return true;
        }

        mostrarUltimoResultado() -> bool {
            // Aquí podrías implementar la lógica para mostrar el último resultado guardado
            println("Último resultado guardado:");
            println(resultado);
            return true;
        }

        mostrarResumenFinal() -> bool {
    println("");
    println("===== RESUMEN FINAL =====");

    print("Operaciones realizadas: ");
    println(operacionesRealizadas);

    print("Ultimo resultado: ");
    println(resultado);

    println("Programa finalizado.");

    return true;
    }

        ejecutarOperacion() -> bool {
            operacionValida <- validarOpcion();

            if (!operacionValida) {
                return false;
            }

            if (opcion == 1) {
                return sumar();
            }

            if (opcion == 2) {
                return restar();
            }

            if (opcion == 3) {
                return multiplicar();
            }

            if (opcion == 4) {
                return dividir();
            }

            if (opcion == 5) {
                return guardarEnMemoria();
            }

            if (opcion == 6) {
                return mostrarUltimoResultado();
            }

            if (opcion == 7) {
                return leerNumeros();
            }

            if (opcion == 8) {
                continuar <- false;
                return true;
            }

            return false;
        }

        iniciarEstado() -> bool {
            resultado <- 0;
            operacionesRealizadas <- 0;
            continuar <- true;
            operacionValida <- false;

            return true;
        }

        ejecutar() -> bool {
            iniciarEstado();
            leerNumeros();

            while (continuar) {
                mostrarMenu();
                ejecutarOperacion();
            }

            mostrarResumenFinal();

            return true;
        }

    ref main ->> ejecutar;

    fa:
        return true;

}
