use <io:output, render>;
use <memory:ptr, heap>;

postIncrementCForms :: runtime {
    Counter :: type {
            value >> int;
    }

    stc:
        obj >> Counter;
        pBase >> p<int>;
        p >> p<int>;
        q >> p<int>;
        fieldOld >> int;
        ptrOld >> int;
        nextValue >> int;
        ok >> bool;

    fn:
        run() -> bool {
            obj.value <- 4;
            pBase !> p<int> : alloc(16);
            p >> p<int> <- pBase;
            q >> p<int> <- off(pBase, 1);

            wr(pBase, 41);
            wr(q, 99);

            fieldOld >> int <- obj.value++;
            ptrOld >> int <- *p++;
            nextValue >> int <- rd(p);

            ok >> bool <- fieldOld == 4 && obj.value == 5 && ptrOld == 41 && nextValue == 99;

            println("fieldOld=" + renderInt(fieldOld));
            println("fieldNow=" + renderInt(obj.value));
            println("ptrOld=" + renderInt(ptrOld));
            println("nextValue=" + renderInt(nextValue));
            println("ok=" + renderBool(ok));

            free(pBase);
            return ok;
        }

    ref main ->> run;

    fa:
        return true;

}
