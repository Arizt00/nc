{
  "version": "1.0.1",
  "state": "frozen",
  "effective_date": "2026-05-02",
  "series": "1.x",
  "phase": "phase3_runtime_stdlib",
  "runtime_models": [
    "hosted",
    "portable",
    "freestanding"
  ],
  "distribution": {
    "runtime_stdlib_package": "ncc-runtime-stdlib",
    "shipped_with_toolchain": true,
    "import_activation_bytes_owned_by_mct": true,
    "hosted_runtime_symbols_owned_by_package": true,
    "provider_policy": "os-probed-provider-with-portable-exact-fallback",
    "render_binary": {
      "surface": [
        "renderBinary(int)->str",
        "renderBin(int)->str"
      ],
      "preferred_host_provider": "external-libc-percent-b",
      "probe": "snprintf(\"%llb\", 5) == \"101\"",
      "fallback": "portable-exact-byte-renderer",
      "stable_outputs": {
        "0": "0",
        "5": "101",
        "-5": "-101"
      }
    }
  },
  "modules": [
    "io",
    "mem",
    "collections",
    "net",
    "time",
    "trace",
    "inspect"
  ],
  "contracts": {
    "io": [
      "system.io.core.write(str)->bool"
    ],
    "mem": [
      "memory.heap.manager.alloc(int)->addr",
      "memory.heap.manager.free(addr)->bool",
      "memory.heap.manager.realloc(addr,int)->addr",
      "memory.heap.manager.zero(addr,int)->bool"
    ],
    "collections": [
      "list<T>.push/get/set/len",
      "queue<T>.enqueue/dequeue/front/isEmpty",
      "watchList<T>.push/len",
      "traceList<T>.push/len",
      "memList<T>.push/get/set/len"
    ],
    "net": [
      "system.net.core.connect(str,int)->bool",
      "system.net.core.listen()->bool",
      "system.net.core.accept()->bool",
      "system.net.core.send(str)->bool",
      "system.net.core.recv()->bool",
      "system.net.core.disconnect()->bool",
      "alt.net.core.* mirrors system.net.core"
    ],
    "time": [
      "runtime.time.now()->int",
      "runtime.time.monotonic()->int",
      "runtime.time.sleep(int)->bool"
    ],
    "trace": [
      "runtime.trace.mark(str)->bool",
      "runtime.alias.mark(str)->bool"
    ],
    "inspect": [
      "inspect runtime paths: heap.*, net.*, system.*, kernel.*, security.*, ai.*",
      "print.inspect/print.mem/print.st"
    ]
  },
  "alias_surface": {
    "nC.runtime.heap": "memory.heap.manager",
    "nC.runtime.net": "system.net.core|alt.net.core",
    "nC.runtime.trace": "runtime.trace",
    "nC.runtime.alias": "runtime.alias",
    "nC.runtime.time": "runtime.time"
  },
  "no_breaking_without_rfc": true,
  "rfc_template": "docs/spec/release/rfc/RFC_TEMPLATE.md",
  "required_gates": [
    "release_phase3_runtime_stdlib_gate_tests",
    "release_phase2_toolchain_model_gate_tests",
    "release_phase1_language_base_gate_tests",
    "release_f23_compatibility_gate_tests"
  ],
  "open_phase": "none",
  "runtime_families": [
    "nC.runtime.input",
    "nC.runtime.output",
    "nC.runtime.errorOutput",
    "nC.runtime.channel",
    "nC.runtime.flush",
    "nC.runtime.std",
    "nC.runtime.args",
    "nC.runtime.env",
    "nC.runtime.exit",
    "nC.runtime.session",
    "nC.runtime.text",
    "nC.runtime.string",
    "nC.runtime.render",
    "nC.runtime.format",
    "nC.runtime.concat",
    "nC.runtime.parse",
    "nC.runtime.convert",
    "nC.runtime.validate",
    "nC.runtime.width",
    "nC.runtime.align",
    "nC.runtime.pad",
    "nC.runtime.truncate",
    "nC.runtime.wrap",
    "nC.runtime.escape",
    "nC.runtime.unicode",
    "nC.runtime.result",
    "nC.runtime.option",
    "nC.runtime.error",
    "nC.runtime.diagnostic",
    "nC.runtime.log",
    "nC.runtime.trace",
    "nC.runtime.debug",
    "nC.runtime.assert",
    "nC.runtime.status",
    "nC.runtime.buffer",
    "nC.runtime.memory",
    "nC.runtime.heap",
    "nC.runtime.stack",
    "nC.runtime.region",
    "nC.runtime.slice",
    "nC.runtime.span",
    "nC.runtime.ptr",
    "nC.runtime.addr",
    "nC.runtime.bytes",
    "nC.runtime.endian",
    "nC.runtime.layout",
    "nC.runtime.alloc",
    "nC.runtime.fs",
    "nC.runtime.path",
    "nC.runtime.dir",
    "nC.runtime.file",
    "nC.runtime.stream",
    "nC.runtime.process",
    "nC.runtime.command",
    "nC.runtime.os",
    "nC.runtime.user",
    "nC.runtime.permission",
    "nC.runtime.temp",
    "nC.runtime.service",
    "nC.runtime.signal",
    "nC.runtime.time",
    "nC.runtime.clock",
    "nC.runtime.timer",
    "nC.runtime.sleep",
    "nC.runtime.random",
    "nC.runtime.entropy",
    "nC.runtime.uuid",
    "nC.runtime.task",
    "nC.runtime.thread",
    "nC.runtime.async",
    "nC.runtime.sync",
    "nC.runtime.atomic",
    "nC.runtime.lock",
    "nC.runtime.queue",
    "nC.runtime.event",
    "nC.runtime.scheduler",
    "nC.runtime.cancel",
    "nC.runtime.net",
    "nC.runtime.socket",
    "nC.runtime.tcp",
    "nC.runtime.udp",
    "nC.runtime.dns",
    "nC.runtime.http",
    "nC.runtime.tls",
    "nC.runtime.capability",
    "nC.runtime.policy",
    "nC.runtime.profile",
    "nC.runtime.bridge",
    "nC.runtime.sandbox",
    "nC.runtime.resource"
  ],
  "runtime_family_count": 90
}
