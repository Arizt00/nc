{
  "version": "1.0.1",
  "state": "frozen",
  "series": "1.x",
  "phase": "phase7_package_ecosystem",
  "npkg_actions": [
    "manifest",
    "check-imports",
    "list-imports",
    "resolve",
    "lock",
    "verify-lock"
  ],
  "schemas": {
    "registry": "npkg.registry.v1",
    "resolve": "npkg.resolve.v1",
    "lock": "npkg.lock.v1"
  },
  "semver_contract": {
    "version_shape": "major.minor.patch",
    "supported_requirements": [
      "^",
      "~",
      "wildcard",
      "comparators"
    ],
    "selection_policy": "max_satisfying"
  },
  "determinism_contract": {
    "dependency_order": "stable_sorted",
    "same_input_same_registry_same_output": true,
    "verify_lock_must_detect_drift": true
  },
  "external_project_contract": {
    "requires_repo_cwd": false,
    "absolute_input_paths_supported": true,
    "clean_cwd_supported": true
  },
  "no_breaking_without_rfc": true,
  "required_gates": [
    "release_phase7_package_ecosystem_gate_tests",
    "release_phase6_quality_extreme_gate_tests",
    "release_phase5_toolchain_complete_gate_tests",
    "release_phase4_backend_sovereign_gate_tests",
    "release_phase3_runtime_stdlib_gate_tests",
    "release_phase2_toolchain_model_gate_tests",
    "release_phase1_language_base_gate_tests"
  ]
}
