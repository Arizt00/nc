{
  "schema": "nc.phase10.telemetry.contract.v1",
  "version": "2.0.0",
  "state": "frozen",
  "series": "2.x",
  "phase": "phase10_p15_telemetry",
  "policy": {
    "mode": "opt-in-only",
    "default_opt_in": false,
    "env_override": "NCUP_TELEMETRY_OPT_IN"
  },
  "minimum_metrics": [
    "install_status",
    "ncup_version",
    "target"
  ],
  "privacy": {
    "collect_source_code": false,
    "collect_source_contents": false,
    "collect_source_snippets": false
  },
  "event_sink": {
    "path": "logs/telemetry-events.v1.ndjson",
    "format": "ndjson"
  },
  "required_artifacts": [
    "docs/spec/release/v2_0_0_phase10_telemetry_spec.md",
    "docs/spec/release/v2_0_0_phase10_telemetry_compatibility_spec.md",
    "docs/spec/release/v2_0_0_phase10_telemetry_contract.json",
    "docs/status/STATUS_PHASE10_punto15_telemetry_v2_0_0.md",
    "docs/status/F10_P15_telemetry_report.json",
    "tools/ncc/nc/src/verification/dist_telemetry.n",
    "tools/release/qa_phase10_p15_v2_0_0.sh"
  ],
  "required_gates": [
    "release_phase10_telemetry_gate_tests"
  ],
  "no_breaking_without_rfc": true
}
