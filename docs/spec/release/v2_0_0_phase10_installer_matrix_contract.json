{
  "schema": "nc.phase10.installer.matrix.contract.v1",
  "version": "2.0.0",
  "state": "frozen",
  "series": "2.x",
  "phase": "phase10_p16_installer_matrix",
  "scenarios": {
    "fresh_install": true,
    "upgrade": true,
    "downgrade": true,
    "rollback": true,
    "corrupt_download": true,
    "invalid_signature": true,
    "insufficient_space": true,
    "path_empty": true,
    "path_existing": true,
    "multi_toolchain_override": true,
    "os_runner_matrix": [
      "ubuntu-latest",
      "windows-latest",
      "macos-latest"
    ]
  },
  "fault_injection": {
    "env_var": "NCUP_FAULT_INJECT_NO_SPACE",
    "required_diagnostic_contains": "no space left on device"
  },
  "required_artifacts": [
    "docs/spec/release/v2_0_0_phase10_installer_matrix_spec.md",
    "docs/spec/release/v2_0_0_phase10_installer_matrix_compatibility_spec.md",
    "docs/spec/release/v2_0_0_phase10_installer_matrix_contract.json",
    "docs/status/STATUS_PHASE10_punto16_installer_matrix_v2_0_0.md",
    "docs/status/F10_P16_installer_matrix_report.json",
    "tools/ncc/nc/src/verification/release43_installer.n",
    "tools/release/qa_phase10_p16_v2_0_0.sh",
    ".github/workflows/phase10-installer-matrix.yml"
  ],
  "required_gates": [
    "release_phase10_installer_matrix_gate_tests"
  ],
  "no_breaking_without_rfc": true
}
