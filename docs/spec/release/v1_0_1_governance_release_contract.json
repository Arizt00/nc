{
  "version": "1.0.1",
  "state": "frozen",
  "series": "1.x",
  "phase": "phase9_governance_release",
  "release_train": {
    "channels": ["stable", "beta", "nightly"],
    "cadence_days": {
      "stable": 28,
      "beta": 7,
      "nightly": 1
    },
    "promotion_flow": ["nightly->beta", "beta->stable"],
    "no_breaking_in_1x": true,
    "promotion_automation": {
      "workflow": ".github/workflows/release-train-promotion.yml",
      "script": "tools/release/promote_release_train_v1_0_1.sh",
      "state_file": "var/release/release_train_state_v1_0_1.json"
    }
  },
  "compatibility_policy": {
    "doc": "docs/spec/release/v1_0_compatibility_policy_1x.md",
    "major_breaking_only": true,
    "requires_rfc_for_breaking": true,
    "predictability_contract": "users know exactly what breaks, when and why"
  },
  "governance": {
    "rfc_process_doc": "docs/spec/release/rfc/README.md",
    "rfc_template": "docs/spec/release/rfc/RFC_TEMPLATE.md",
    "deprecation_min_stable_releases_before_removal": 2,
    "lts_support_window_months": 24,
    "enterprise_tracks": ["stable", "lts"],
    "enterprise_security_sla_hours": 24,
    "enterprise_hotfix_target_hours": 72
  },
  "deprecation_runtime": {
    "warning_codes": ["NCC-DEPRECATION-0001", "NCC-DEPRECATION-0002"],
    "minimum_stable_releases_before_removal": 2,
    "compiler_warning_required": true
  },
  "artifact_integrity": {
    "checksums_algorithm": "sha256",
    "sbom_schema": "ncc.sbom.v1",
    "attestation_schema": "ncc.release.integrity.attestation.v1",
    "scripts": [
      "tools/release/sign_artifacts_v1_0_1.sh",
      "tools/release/verify_artifacts_v1_0_1.sh",
      "tools/release/generate_sbom_v1_0_1.sh"
    ],
    "workflow": ".github/workflows/release-artifact-integrity.yml"
  },
  "runbook_sla": {
    "script": "tools/release/runbook_lts_enterprise_sla_v1_0_1.sh",
    "security_response_hours_max": 24,
    "critical_hotfix_hours_max": 72
  },
  "required_gates": [
    "release_phase9_governance_release_gate_tests",
    "release_phase8_dx_observability_gate_tests",
    "release_phase7_package_ecosystem_gate_tests",
    "release_phase6_quality_extreme_gate_tests",
    "release_phase5_toolchain_complete_gate_tests",
    "release_phase4_backend_sovereign_gate_tests",
    "release_phase3_runtime_stdlib_gate_tests",
    "release_phase2_toolchain_model_gate_tests",
    "release_phase1_language_base_gate_tests"
  ],
  "no_breaking_without_rfc": true
}
