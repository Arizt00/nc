{
  "version": "2.0.0",
  "state": "frozen",
  "series": "2.x",
  "phase": "phase10_p8_manifest_format",
  "schema": "nc.phase10.manifest.format.contract.v1",
  "channel_manifest": {
    "path_pattern": "manifests/channels/<channel>/channel-manifest.toml",
    "channels": ["stable", "beta", "nightly"],
    "required_fields": [
      "schema",
      "version",
      "state",
      "channel",
      "min_ncup_version",
      "breaking_notes",
      "compatibility",
      "components",
      "entries"
    ]
  },
  "release_manifest": {
    "path": "manifests/release-manifest.json",
    "required_fields": [
      "schema",
      "version",
      "state",
      "generated_at",
      "min_ncup_version",
      "breaking_notes",
      "channels",
      "components",
      "packages",
      "integrity_bundle"
    ]
  },
  "semantic_compatibility": {
    "required": true,
    "fields": ["min_ncup_version", "breaking_notes"]
  },
  "required_artifacts": [
    "docs/spec/release/v2_0_0_phase10_manifest_format_spec.md",
    "docs/spec/release/v2_0_0_phase10_manifest_format_compatibility_spec.md",
    "docs/spec/release/v2_0_0_phase10_manifest_format_contract.json",
    "docs/status/STATUS_PHASE10_punto8_manifest_format_v2_0_0.md",
    "docs/status/F10_P8_manifest_format_report.json",
    "tools/ncc/nc/src/verification/release43_manifest.n",
    "tools/release/qa_phase10_p8_v2_0_0.sh"
  ],
  "required_gates": [
    "release_phase10_manifest_format_gate_tests"
  ],
  "no_breaking_without_rfc": true
}
