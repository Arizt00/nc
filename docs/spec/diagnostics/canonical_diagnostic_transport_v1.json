{
  "schema": "nc.diagnostic.transport.v1",
  "jsonl": {
    "schema": "nc.diagnostic.jsonl.v1",
    "encoding": "UTF-8",
    "framing": "one canonical diagnostic JSON object per line",
    "lossless_machine_fields": [
      "machine_record_hex",
      "machine_arena_hex"
    ]
  },
  "ndiag": {
    "schema": "nc.diagnostic.ndiag.v1",
    "endianness": "little",
    "magic_ascii": "NDIAG\\0\\0\\0",
    "version": 1,
    "header_bytes": 32,
    "record_abi": "nc.diagnostic.machine.v2",
    "record_bytes": 128,
    "frame_magic_ascii": "NDFR",
    "frame_header_bytes": 16,
    "frame_alignment": 8,
    "checksums": {
      "file_payload": "FNV-1a-32",
      "frame_record_and_arena": "FNV-1a-32",
      "diagnostic_stable_id": "FNV-1a-64(code)"
    }
  },
  "cli": {
    "format_option": "--diagnostic-format",
    "formats": [
      "terminal",
      "jsonl",
      "ndiag"
    ],
    "output_option": "--diagnostic-out",
    "default_streams": {
      "terminal": "stderr",
      "jsonl": "stdout",
      "ndiag": "stdout"
    },
    "option_scan_terminator": "--",
    "process_error_type": "CliFailure",
    "typed_family_entrypoints": {
      "tooling": [
        "nfmt",
        "nlint",
        "nide",
        "nclsp"
      ],
      "ghor": [
        "npkg",
        "package",
        "ghor"
      ]
    },
    "actionable_error": {
      "type": "CommandDiagnosticError",
      "code": "NCC-CLI-0001",
      "fields": [
        "phase",
        "message",
        "help",
        "file"
      ],
      "legacy_display_only": true,
      "process_requires_display_reparse": false
    },
    "external_causes": {
      "parent_cause_linkage": {
        "parent_cause_index": 1,
        "parent_cause_count": 1,
        "cause_severity": "note"
      },
      "families": [
        {
          "kind": "filesystem",
          "error_code": "E_CLI_FILESYSTEM_001",
          "cause_code": "N_CLI_FILESYSTEM_CAUSE_001",
          "retains": ["phase", "path", "operation", "os_error"]
        },
        {
          "kind": "json",
          "error_code": "E_CLI_JSON_001",
          "cause_code": "N_CLI_JSON_CAUSE_001",
          "retains": ["phase", "path", "operation", "line", "column", "serde_error"]
        },
        {
          "kind": "subprocess",
          "error_code": "E_CLI_SUBPROCESS_001",
          "cause_code": "N_CLI_SUBPROCESS_CAUSE_001",
          "retains": ["phase", "program", "operation", "spawn_or_exit_error"]
        },
        {
          "kind": "backend",
          "error_code": "E_CLI_BACKEND_001",
          "cause_code": "N_CLI_BACKEND_CAUSE_001",
          "retains": ["phase", "artifact", "operation", "backend_diagnostics"]
        }
      ],
      "migrated_call_graphs": [
        "tooling.nfmt",
        "tooling.nlint",
        "package.complete",
        "ghor.tool.process",
        "mct.emit-llvm.zero-functions"
      ]
    }
  },
  "consumers": [
    "terminal",
    "nide",
    "nc-sys-lsp",
    "machine",
    "basal",
    "mct",
    "ghor"
  ],
  "source_span": {
    "stored_base": 1,
    "lsp_base": 0
  }
}
