{
  "schema": "nc.diagnostic.machine.v2",
  "version": 2,
  "magic_ascii": "NCDI",
  "magic_u32_le": "0x4944434e",
  "endianness": "little",
  "record_bytes": 128,
  "arena": {
    "ownership": "caller",
    "reference": "u32 offset plus u32 byte length",
    "encoding": "UTF-8",
    "nul_termination_required": false
  },
  "fields": [
    { "offset": 0, "bytes": 4, "name": "magic", "type": "u32" },
    { "offset": 4, "bytes": 2, "name": "abi_version", "type": "u16" },
    { "offset": 6, "bytes": 2, "name": "record_bytes", "type": "u16" },
    { "offset": 8, "bytes": 1, "name": "severity", "type": "u8" },
    { "offset": 9, "bytes": 1, "name": "domain", "type": "u8" },
    { "offset": 10, "bytes": 2, "name": "reserved0", "type": "u16" },
    { "offset": 12, "bytes": 4, "name": "flags", "type": "u32" },
    { "offset": 16, "bytes": 8, "name": "stable_id", "type": "u64-fnv1a-code" },
    { "offset": 24, "bytes": 8, "name": "code", "type": "text_ref" },
    { "offset": 32, "bytes": 8, "name": "message", "type": "text_ref" },
    { "offset": 40, "bytes": 8, "name": "file", "type": "text_ref" },
    { "offset": 48, "bytes": 8, "name": "phase", "type": "text_ref" },
    { "offset": 56, "bytes": 8, "name": "expected", "type": "text_ref" },
    { "offset": 64, "bytes": 8, "name": "found", "type": "text_ref" },
    { "offset": 72, "bytes": 8, "name": "help", "type": "text_ref" },
    { "offset": 80, "bytes": 4, "name": "line", "type": "u32" },
    { "offset": 84, "bytes": 4, "name": "column", "type": "u32" },
    { "offset": 88, "bytes": 4, "name": "end_line", "type": "u32" },
    { "offset": 92, "bytes": 4, "name": "end_column", "type": "u32" },
    { "offset": 96, "bytes": 4, "name": "cause_index", "type": "u32" },
    { "offset": 100, "bytes": 4, "name": "cause_count", "type": "u32" },
    { "offset": 104, "bytes": 24, "name": "reserved", "type": "bytes" }
  ],
  "severity": {
    "0": "note",
    "1": "help",
    "2": "warning",
    "3": "error",
    "4": "fatal"
  },
  "domain": {
    "0": "primitive",
    "1": "basal",
    "2": "machine",
    "3": "lexer",
    "4": "parser",
    "5": "sema",
    "6": "ir",
    "7": "mct",
    "8": "linker",
    "9": "runtime",
    "10": "kernel",
    "11": "high-level",
    "12": "tooling",
    "13": "ghor",
    "255": "unknown"
  },
  "integrated_producers": {
    "mct": "CanonicalDiagnostic-backed MctDiagnosticIR constructor",
    "machine": "CanonicalDiagnostic-backed adapter",
    "basal": "CanonicalDiagnostic-backed adapter with byte span",
    "ghor": "CanonicalDiagnostic-backed adapter",
    "nide": "canonical JSON consumer"
  },
  "structured_sink": "ncc-cli::canonical_diagnostic_to_json",
  "source_authority": "runtime/nc/diagnostic.n",
  "bootstrap_bridge": "crates/ncc-diagnostics/src/lib.rs"
}
