{
  "schema": "nc.compiler.raw_pointer_contract.v1",
  "status": "canonical",
  "surface": {
    "compact": "p<T>",
    "canonical_ast": "ptr<T>",
    "address": "addr"
  },
  "normal_compilation": {
    "mode": "manual_raw",
    "required_metadata": [],
    "required_authority": [],
    "accepted_hazards": [
      "null",
      "uninitialized",
      "misaligned",
      "aliasing",
      "out_of_range",
      "dangling",
      "use_after_free",
      "double_free",
      "address_overflow"
    ],
    "undefined_behavior": "C-like; no stable value, crash, trap, or repeatable result is guaranteed"
  },
  "lowering": {
    "typed_stride": "index * sizeof(T)",
    "address_arithmetic": "wrapping at target pointer width",
    "llvm_gep": "not inbounds",
    "llvm_overflow_promises": [],
    "inferred_noalias": false,
    "hidden_checks": false
  },
  "audit": {
    "command": "ncc compiler pointer-audit <file.n>",
    "optional": true,
    "read_only": true,
    "affects_ast": false,
    "affects_ir": false,
    "affects_codegen": false
  },
  "legacy_annotations": {
    "risk.rawPtr": "no_op_evidence",
    "risk.rawAddr": "no_op_evidence",
    "risk.rawSite": "no_op_evidence",
    "risk.silentPointer": "no_op_evidence"
  },
  "separate_bounded_types": [
    "array<T,N>",
    "vector<T>",
    "slice<T>",
    "buffer<T>",
    "site<T>",
    "memRegion<T>"
  ]
}
