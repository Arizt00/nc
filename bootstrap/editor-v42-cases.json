{
  "schema": "nc.editor.cases.v42",
  "hosts": ["windows", "linux"],
  "industrial": ["positive", "version", "boolean", "color", "png", "logo", "snippets", "node", "json"],
  "rpc": ["none", "capability", "uri", "diagnostic", "items", "fractional-items", "completion", "shutdown", "missing-shutdown", "malformed", "truncated", "no-frames", "nonzero"],
  "industrial_prepare": "NATIVE editor-fixture-v42 --root CASE_ROOT --case CASE",
  "industrial_native": "NATIVE editor-industrial --root CASE_ROOT --out HOST/evidence/industrial-CASE-native.json",
  "industrial_oracle": "PYTHON CASE_ROOT/tools/release/verify_high_level_ide_release_industrial.py",
  "industrial_peer_environment": {"PATH": "HOST/peer/bin first, followed by original PATH"},
  "rpc_prepare": "NATIVE editor-fixture-v42 --root CASE_ROOT --case rpc-CASE --out HOST/evidence/rpc-CASE-response.bin",
  "rpc_nonzero_prepare_case": "rpc-none",
  "rpc_native": "NATIVE editor-lsp-smoke --root CASE_ROOT --adapter PEER --out HOST/evidence/rpc-CASE",
  "rpc_oracle": "PYTHON CASE_ROOT/tools/release/nc_sys_lsp_jsonrpc_smoke_v2_0_0.py",
  "rpc_peer_environment": {"NC_SYS_LSP_BIN": "absolute PEER", "EDITOR_V42_RESPONSE": "absolute response file", "EDITOR_V42_NONZERO": "set to 1 only for nonzero, absent otherwise"},
  "expected_success_cases": ["industrial:positive", "rpc:none"],
  "expected_negative_exit": 1,
  "expected_rpc_child_exit": 0,
  "expected_rpc_nonzero_child_exit": 7,
  "industrial_report_projection": ["schema", "status", "scope", "checks", "commands[].cmd", "commands[].code", "commands[].stdout", "commands[].stderr", "commands[].ok"],
  "malformed_json_exception": "Oracle raises without report; native rejects with an explicit error report. Compare exit and rejection, not report equality.",
  "fixture_certification": "nC controlled processes and synthetic corpus only; not external Node, IDE or LSP certification",
  "real_external_runs": ["Node --check extension.js", "Node --check nc_semantic.js", "Node smoke_test.js", "prebuilt nc-sys-lsp lsp"],
  "all_originals_retained": true
}
