{
  "schema": "nc.frontend.rebuild-plan.v81",
  "builder": "native nC per-unit objects + explicit platform linker; no whole-program LTO in this certification profile",
  "generation_contract": "All declared module2 provider objects rebuilt from nC on Windows and Ubuntu/WSL; no retained project object inputs; clean B to C",
  "source_sha256_pins": "audit identity; builder copy operations are checked separately",
  "runtime_provider": {
    "schema": "nc.native.runtime-projects.v77",
    "source_manifest": "bootstrap/runtime-native-units-v81.json",
    "platform_abi": "bootstrap/native-platform-abi-v81.json",
    "body_language": "nC",
    "unit_action": "project objects --no-incremental",
    "publisher": "tools/scripts/link_native_providers73.n",
    "json_preparer": "tools/scripts/prepare_runtime_json77.n",
    "project_object_inputs": "only objects freshly materialized for the same generation; never retained V64/V69/V72 objects",
    "platform_dependencies": "explicit Windows SDK import libraries or Linux system shared libraries; no C source bodies",
    "entry_unit": "tools/tests/native_runtime_entry77.n (graph only, excluded from shared library)",
    "exports": {
      "windows": 200,
      "linux": 175
    },
    "json_profile": "native binary64 JSON constructor/getter/default; deterministic finite round-trip output and exact decimal conversion in nC",
    "builder": "tools/scripts/build_native_runtime81.n",
    "publication_templates": [
      "bootstrap/runtime-publication-v81.windows.json",
      "bootstrap/runtime-publication-v81.linux.json"
    ]
  },
