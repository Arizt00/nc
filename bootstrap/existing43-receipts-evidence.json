  "schema": "nc.existing-retirement.receipts-evidence.v43",
  "status": "sealed-two-host-native-receipt-validator-tested",
  "implementation_language": "nC",
  "passed": true,
  "failures": 0,
  "checks": 620,
  "originals_deleted": false,
  "gate_edited": false,
  "common59_edited": false,
  "stage0_retained": true,
  "historical_original_equivalence_goldens_edited": false,
  "not_original_retirement_authorization": true,
  "scope": "New batch-only receipt validator and isolated native tests. Old20 qualification dossier and all46 recovery bytes remain unchanged. Parent gate owns per-original native family, uniform executable/source/object bindings, Stage0/recovery and final deletion.",
  "api": {
    "source": "tools/ncc/nc/src/verification/retirement43_receipts.n",
    "namespace": "retirement43Receipts",
    "call": "retirement43_receipts.retirement43Receipts.check(original, host, receiptPath, candidatePath, candidateSHA, root) -> bool",
    "argument_types": [
      "str",
      "str",
      "str",
      "str",
      "str",
      "str"
    ],
    "path_contract": "original/receiptPath/candidatePath and proof path values are safe forward-slash relative paths under root; root is a nonempty host-native repository root.",
    "receipt_schema": "nc.native-tools.equivalence-receipt.v43",
    "candidate_binding": "Receipt candidate path and lowercase SHA256 must exactly match API inputs; actual nonempty regular candidate file is SHA256 checked before and after proof validation.",
    "minimum_proof_reports": 1,
    "proof_contract": [
      "Every proof entry is an object with typed relative path and lowercase SHA256. Hash is calculated by nC SHA256 on the same exact bytes subsequently parsed.",
      "Report is an object with nc.* schema, strict boolean passed:true; receipt and batch-check schemas are rejected to prevent circular proof.",
      "Optional failures/failed fields, at root or each row, must be lexical integer 0 or -0. Strings, booleans, fractions, exponents and overflow are rejected.",
      "cases/checks collections accept nonempty arrays or maps of object rows; rows explicitly accepts nonempty arrays. Every row has strict boolean passed:true.",
      "checks may be a nonnegative lexical integer counter bounded by MAX_ITEMS when independently validated rows or cases are present; a counter alone is not evidence. Counter need not equal rows length because existing reports count assertions separately.",
      "Every present cases/rows/checks collection is validated; one valid collection does not mask another invalid or empty collection.",
      "Optional report covered_originals must be a nonempty array of valid relative .py strings containing the exact requested original. Optional report host must exactly match.",
      "Optional dossier metadata is ignored as qualification evidence; raw dossiers in proof_reports are rejected unless they independently satisfy the proof contract."
    ],
    "dependencies": [
      {
        "source": "tools/ncc/nc/src/verification/release_io.n",
        "existing_batch_dependency": true
      },
      {
        "source": "tools/ncc/nc/src/sha256.n",
        "existing_batch_dependency": true
      },
      {
        "source": "tools/ncc/nc/src/verification/editor_json.n",
        "add_to_batch_if_absent": true
      }
    ],
    "no_common59_addition": true,
    "limits": {
      "json_bytes": 16777216,
      "candidate_bytes": 268435456,
      "proof_reports": 1024,
      "collection_items": 1048576,
      "relative_path_bytes": 8192
    },
    "boundaries": [
      "Hashes and strict report semantics do not independently prove execution provenance or original-to-case adequacy; parent produces real per-original native proof reports and verifies family/source/object/executable bindings.",
      "Paths are syntactically relative; this helper is not a hostile mutable-filesystem sandbox, and does not attest symlink/junction confinement or atomic filesystem snapshots.",
      "The helper never opens, executes or deletes an original .py. It supports post-deletion receipt checks without Python.",
      "Malformed JSON returns false. Explicit invalid-handle guards avoid unsafe jsonObjectHas(0) native runtime calls without any shared runtime/compiler change."
    ]
  },
