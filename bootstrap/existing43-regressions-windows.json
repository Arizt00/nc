{
  "schema": "nc.existing-retirement.regression-cases.v43",
  "host": "windows",
  "scope": "97 newly added nC assertions plus legacy52 image regressions; real Stage0 LLVM CLI status preserved, no missing tool or link failure hidden.",
  "cases": [
    {
      "name": "existing43-images",
      "command": [
        "{root}/target/tmp/existing43/{host}/images/bin/images.exe",
        "{out}/images"
      ],
      "exit": 0,
      "report": "{out}/images/report.json",
      "expect": {
        "passed": true,
        "checks": 37
      }
    },
    {
      "name": "existing43-mctpaths",
      "command": [
        "{root}/target/tmp/existing43/{host}/mctpaths/bin/mctpaths.exe",
        "{out}/mctpaths.json"
      ],
      "exit": 0,
      "report": "{out}/mctpaths.json",
      "expect": {
        "passed": true
      }
    },
    {
      "name": "existing43-bytes",
      "command": [
        "{root}/target/tmp/existing43/{host}/bytes/bin/bytes.exe",
        "{out}/bytes.json"
      ],
      "exit": 0,
      "report": "{out}/bytes.json",
      "expect": {
        "passed": true,
        "failures": 0
      }
    },
    {
      "name": "existing43-router",
      "command": [
        "{root}/target/tmp/existing43/{host}/router/bin/router-tests.exe",
        "{out}/router.json"
      ],
      "exit": 0,
      "report": "{out}/router.json",
      "expect": {
        "passed": true
      }
    },
    {
      "name": "mct-real-strict",
      "command": [
        "{helper}",
        "mct-smoke",
        "--root",
        "{root}",
        "--ncc",
        "{stage0}",
        "--out-dir",
        "{out}/mct-strict"
      ],
      "exit": 1,
      "report": "{out}/mct-strict/toolchain_smoke.json",
      "expect": {
        "status": "mct_llvm_toolchain_matrix_missing_tools"
      },
      "cwd": "{root}"
    },
    {
      "name": "mct-real-allow",
      "command": [
        "{helper}",
        "mct-smoke",
        "--root",
        "{root}",
        "--ncc",
        "{stage0}",
        "--out-dir",
        "{out}/mct-allow",
        "--allow-missing-tools"
      ],
      "exit": 0,
      "report": "{out}/mct-allow/toolchain_smoke.json",
      "expect": {
        "status": "mct_llvm_toolchain_matrix_missing_tools"
      },
      "cwd": "{root}"
    },
    {
      "name": "runner-rejects-missing-oracle-report",
      "command": [
        "{root}/target/tmp/existing43/{host}/replay/bin/replay.exe",
        "verify",
        "--catalog",
        "{root}/bootstrap/existing43-runner-missing-report.json",
        "--variables",
        "{root}/bootstrap/existing43-windows-variables.json",
        "--out",
        "{out}/runner-negative"
      ],
      "exit": 1,
      "report": "{out}/runner-negative/report.json",
      "expect": {
        "passed": false,
        "failures": 1
      }
    }
  ]
}
