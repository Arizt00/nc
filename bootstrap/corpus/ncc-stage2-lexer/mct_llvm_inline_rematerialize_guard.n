mctLlvmInlineRematerializeGuard {
    fn:
        private:
            duplicate(value >> int) -> int {
                return value + value;
            }

        public:
            run() -> int {
                source >> int <- 4;
                value >> int <- duplicate(source);
                return value;
            }

    ref main ->> run;

    fa:
        return true;
}
