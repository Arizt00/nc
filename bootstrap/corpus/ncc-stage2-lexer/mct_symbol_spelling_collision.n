use <io:output>;

mctSymbolSpellingCollision {
    const:
        LEFT >> int <- 11;
        RIGHT >> int <- 31;

    type:
        SymbolProbe {
            public:
                value >> int;
                valid >> bool;
        }

    stc:
        runs >> u64 <- 0;

    local:
        last >> int <- 0;

    fn:
        private:
            sym1r(value >> int) -> int {
                return value + LEFT;
            }

        internal:
            sym30(value >> int) -> int {
                return value + RIGHT;
            }

        public:
            run() -> bool {
                probe >> SymbolProbe <- SymbolProbe { value: 0, valid: true };
                probe.value <- sym1r(probe.value);
                probe.value <- sym30(probe.value);
                println("source-spelling-collision");
                last <- probe.value;
                runs += 1;
                return probe.value == LEFT + RIGHT;
            }

    ref main ->> run;

    fa:
        return true;
}
