mctLlvmGvnLinked {
    fn:
        public:
            compute(value >> int) -> int {
                first >> int <- value * 3 + 7;
                second >> int <- value * 3 + 7;
                return first + second;
            }

            run() -> int {
                return compute(5);
            }

    ref main ->> run;

    fa:
        return true;
}
