genericTraitAbiOk {
    hostWin64 :: abi {
        target <- "x86_64-pc-windows-msvc";
        pointer.bits <- 64;
        stack.align <- 16;
        stack.shadow <- 32;
        stack.redzone <- 0;
        args.int <- [rcx, rdx, r8, r9];
        args.float <- [xmm0, xmm1, xmm2, xmm3];
        returns.int <- [rax];
        returns.float <- [xmm0];
        preserve <- [rbx, rbp, rdi, rsi, r12, r13, r14, r15];
        clobber <- [rax, rcx, rdx, r8, r9, r10, r11];
        sret <- rcx;
    }

    trait:
        Source<T> {
            type Item;
            fn get(value >> T) -> Item;
        }

    impl:
        Source<int> for int {
            type Item = int;
            fn get(value >> int) -> int {
                return value;
            }
        }

    fn:
        width<const N: byte>() -> int {
            return N;
        }

        read<S: Source<S>>(source >> S) -> S.Item {
            return get(source);
        }

        run() -> bool {
            return width<32>() == 32 && read(19) == 19;
        }

    bind main <- run using hostWin64;
    ref main ->> run;

    fa:
        return true;
}
