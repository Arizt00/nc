use <io:output>;

astDeclarations {
    const:
        LEFT >> int <- 4;
        RIGHT >> int <- 7;

    type:
        Packet {
            public:
                tag >> int;
            internal:
                flags >> byte;
        }

    stc:
        calls >> int <- 0;

    local:
        last >> int <- 0;

    fn:
        public:
            add(left >> int, right >> int) -> int {
                return left + right;
            }

            run() -> bool {
                last <- add(LEFT, RIGHT);
                calls += 1;
                return last == 11;
            }

    ref main ->> run;

    fa:
        return true;
}
