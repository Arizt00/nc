mctPointerIntrinsics {
    fn:
        run() -> bool {
            baseAddress >> addr <- 4096;
            raw >> p<byte> <- from<byte>(baseAddress);
            data >> p<int> <- cast<int>(raw);
            wr<int>(data, 7);
            value >> int <- rd<int>(data);
            next >> p<int> <- off<int>(data, 1);
            distance >> int <- dist<int>(next, data);
            address >> addr <- adr(data);
            empty >> bool <- nil(data);
            return value == 7 && distance == 1 && address == baseAddress && !empty;
        }

    ref main ->> run;

    fa:
        return true;
}
