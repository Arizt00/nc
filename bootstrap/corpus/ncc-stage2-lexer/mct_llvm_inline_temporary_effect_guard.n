mctLlvmInlineTemporaryEffectGuard {
    fn:
        private:
            duplicate(value >> int) -> int {
                return value + value;
            }

        public:
            observe() -> int {
                value >> int <- 4;
                return value;
            }

            run() -> int {
                value >> int <- duplicate(observe());
                return value;
            }

    ref main ->> run;

    fa:
        return true;
}
