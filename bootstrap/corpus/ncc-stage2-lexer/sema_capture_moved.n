captureMoved {
    fn:
        run() -> bool {
            movedSeed >> int <- 4;
            mapper >> fn(int) -> int <- move |value >> int| -> int
                captures(move movedSeed) {
                    return value + movedSeed;
                };
            return mapper(movedSeed) > 0;
        }
    ref main ->> run;
    fa:
        return true;
}
