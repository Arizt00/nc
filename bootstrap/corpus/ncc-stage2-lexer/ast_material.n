use <io:output>;

astMaterial {
    const:
        BASE >> int <- (2 + 2) * 8;

    type:
        Envelope {
            public:
                bytes >> array<p<byte>, 4>;
                callback >> fn(int, p<byte>) -> Result<int, byte>;
        }

    stc:
        current >> Option<Result<int, byte>>;

    fn:
        public:
            compute(left >> int, right >> array<int, 4>) -> int {
                first >> int <- right[0];
                return !(left == 0) ? left + first * 2 : first;
            }

            run() -> bool {
                values >> array<int, 4> <- [1, 2, 3, 4];
                return compute(BASE, values) > 0 && values[1] == 2;
            }

    ref main ->> run;

    fa:
        return true;
}
