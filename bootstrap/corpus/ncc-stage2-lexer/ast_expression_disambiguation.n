parserExpressionDisambiguation[@runtime] {
    fn:
        public:
            join(left >> int, right >> int) -> int {
                return left + right;
            }

            choose(enabled >> bool) -> int {
                copy >> int <- enabled ? join(20, 22) : 0;
                copy += 0;
                return copy;
            }

            wait(task >> int) -> int {
                completed >> int <- join task;
                return completed;
            }

    fa:
        return true;
}
