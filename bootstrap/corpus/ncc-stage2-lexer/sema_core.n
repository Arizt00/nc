semaCore {
    const:
        LIMIT >> int <- 4;

    type:
        Packet {
            public:
                tag >> int;
                ready >> bool;
        }

    stc:
        calls >> int <- 0;

    fn:
        private:
            add(left >> int, right >> int) -> int {
                return left + right;
            }

        public:
            run() -> bool {
                value >> int <- add(LIMIT, 3);
                active >> bool <- value > 0;
                while (active) {
                    value -= 1;
                    active <- value > 0;
                    if (value == 2) { break; }
                }
                calls += 1;
                return value >= 0;
            }

    ref main ->> run;

    fa:
        return true;
}
