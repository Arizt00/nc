mctLlvmInlineTemporaryPair {
    fn:
        private:
            combine(left >> int, right >> int) -> int {
                return left + left + right + right;
            }

        public:
            run() -> int {
                first >> int <- 3;
                second >> int <- 4;
                value >> int <- combine(first, second);
                return value;
            }

    ref main ->> run;

    fa:
        return true;
}
