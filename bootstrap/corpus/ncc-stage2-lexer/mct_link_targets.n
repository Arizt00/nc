use <io:output>;

mctLinkTargets {
    const:
        LIMIT >> int <- 2;

    type:
        LinkProbe {
            public:
                value >> int;
                ready >> bool;
        }

    stc:
        runs >> u64 <- 0;

    local:
        last >> int <- 0;

    fn:
        private:
            step(value >> int) -> int {
                return value + 1;
            }

        public:
            run() -> bool {
                probe >> LinkProbe <- LinkProbe { value: 0, ready: true };
                println("mct-link-targets");
                while (probe.value < LIMIT) {
                    probe.value <- step(probe.value);
                }
                last <- probe.value;
                runs += 1;
                return probe.ready;
            }

    ref main ->> run;

    fa:
        return true;
}
