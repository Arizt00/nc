mctLlvmInlineParameters {
    fn:
        private:
            affine(left >> int, right >> int) -> int {
                return left * 2 + right;
            }

        public:
            run() -> int {
                value >> int <- affine(6, 7);
                return value;
            }

    ref main ->> run;

    fa:
        return true;
}
