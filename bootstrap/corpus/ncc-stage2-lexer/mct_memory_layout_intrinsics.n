mctMemoryLayoutIntrinsics {
    fn:
        run() -> bool {
            source >> p<byte> <- cast<byte>(alloc(4));
            target >> p<byte> <- cast<byte>(alloc(4));
            cp(target, source, 4);
            width >> int <- sizeOf(int);
            free(target);
            free(source);
            return width == 4;
        }

    ref main ->> run;

    fa:
        return true;
}
