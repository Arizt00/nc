mctLlvmInlineTemporaryCapacityGuard {
    fn:
        private:
            combine(first >> int, second >> int, third >> int) -> int {
                return first + first + second + second + third + third;
            }

        public:
            run() -> int {
                one >> int <- 1;
                two >> int <- 2;
                three >> int <- 3;
                value >> int <- combine(one, two, three);
                return value;
            }

    ref main ->> run;

    fa:
        return true;
}
