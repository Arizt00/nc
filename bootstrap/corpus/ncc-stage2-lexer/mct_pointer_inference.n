mctPointerInference {
    fn:
        base(state >> p<int>) -> p<int> {
            return state;
        }

        mutate(state >> p<int>) -> int {
            wr(off(base(state), 0), 7);
            return rd(off(base(state), 0));
        }

        reservedNames() -> int {
            state >> p<int> <- cast<int>(alloc(8));
            slot >> p<int> <- off(state, 1);
            wr(off(slot, 0), 9);
            value >> int <- rd(off(slot, 0));
            free(state);
            return value;
        }

        run() -> bool {
            data >> p<int> <- cast<int>(alloc(4));
            value >> int <- mutate(data);
            free(data);
            return value == 7 && reservedNames() == 9;
        }

    ref main ->> run;

    fa:
        return true;
}
