captureDuplicate {
    fn:
        run() -> bool {
            seed >> int <- 4;
            mapper >> fn(int) -> int <- |value >> int| -> int
                captures(ref seed, ref seed) {
                    return value + seed;
                };
            return mapper(1) > 0;
        }
    ref main ->> run;
    fa:
        return true;
}
