mctLlvmTransformCfg {
    fn:
        run() -> int {
            value >> int <- 1;

            if true {
                value <- value + 2;
            } else {
                value <- 90;
            }

            if false {
                value <- 100;
            }

            while false {
                value <- value + 1000;
            }

            return value;
            value <- 7;
        }

    ref main ->> run;

    fa:
        return true;
}
