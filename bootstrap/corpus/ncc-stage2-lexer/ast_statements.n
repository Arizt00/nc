use <io:output>;

astStatements {
    fn:
        private:
            touch(value >> int) -> bool {
                return value >= 0;
            }

        public:
            run() -> bool {
                limit >> int <- 9;
                total >> int <- 0;
                i >> int <- 0;
                defer touch(total);
                guard limit > 0 else return false;

                while (i < limit) {
                    i += 1;
                    if (i == 2) {
                        continue;
                    } else if (i == 8) {
                        break;
                    } else {
                        total <- total + i;
                    }
                }

                for (i <- 0; i < 3; i <- i + 1) {
                    total += i;
                }

                touch(total);
                return total > 0;
            }

    ref main ->> run;

    fa:
        return true;
}
