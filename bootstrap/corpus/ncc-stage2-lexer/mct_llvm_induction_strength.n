mctLlvmInductionStrength {
    fn:
        seed() -> u32 {
            return 7;
        }

        run() -> u32 {
            value >> u32 <- seed();
            scaled >> u32 <- value * 8;
            divided >> u32 <- scaled / 4;
            index >> u32 <- 0;
            total >> u32 <- 0;

            while (index < 4) {
                total += index;
                index += 1;
            }

            return divided + total;
        }

    ref main ->> run;

    fa:
        return true;
}
