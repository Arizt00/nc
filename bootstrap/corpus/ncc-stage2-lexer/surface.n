use <io:output>;

lexerSurface {
    fn:
        run() -> bool {
            hex >> int <- 0x03F8;
            binary >> int <- 0b1010_0001;
            octal >> int <- 0o7_55;
            decimal >> ft64 <- 10_000.25;
            text >> str <- "line\nquote\"slash\\tab\tzero\0amp\&query\?hash\#hex\x41unicode\u{00F1}";
            letter >> char <- '\x41';
            direct >> str <- "ñ🙂";
            latin >> char <- 'ñ';
            /* block comment
               retained for line accounting */
            if (hex >= 0 && binary != octal || !false) {
                decimal += 1;
            }
            return text != "" && direct != "" && letter == 'A' && latin == 'ñ';
        }

    ref main ->> run;

    fa:
        return true;
}
