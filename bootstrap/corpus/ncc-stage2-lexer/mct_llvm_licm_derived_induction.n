mctLlvmLicmDerivedInduction {
    fn:
        run() -> u32 {
            factor >> u32 <- 3;
            bias >> u32 <- 5;
            index >> u32 <- 0;
            cursor >> u32 <- 0;
            total >> u32 <- 0;

            while (index < 4) {
                invariant >> u32 <- factor + bias;
                total += invariant + cursor;
                index += 1;
                cursor += 3;
            }

            return total;
        }

    ref main ->> run;

    fa:
        return true;
}
