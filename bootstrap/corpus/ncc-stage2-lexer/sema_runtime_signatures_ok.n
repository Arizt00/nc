use <data:json | sync:atomic | time:clock | text:format | io:output>;

semaRuntimeSignaturesOk :: runtime {
    fn:
        run() -> bool {
            parsed >> int <- jsonParse("{}");
            valid >> bool <- jsonValidate("{}");
            now >> u64 <- monotonic();
            label >> str <- format("value", parsed, now);
            atomicFence();
            println(label);
            println();
            return valid;
        }

    ref main ->> run;

    fa:
        return true;
}
