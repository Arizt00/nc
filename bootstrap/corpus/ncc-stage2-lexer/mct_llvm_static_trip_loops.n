mctLlvmStaticTripLoops {
    fn:
        run() -> int {
            value >> int <- 0;
            index >> int <- 0;

            while (true) {
                value += 1;
                break;
            }

            loop {
                value += 2;
                break;
            }

            do {
                value += 4;
            } while (false);

            repeat {
                value += 8;
            } until (true);

            for (index <- 0; false; index += 1) {
                value += 16;
            }

            return value;
        }

    ref main ->> run;

    fa:
        return true;
}
