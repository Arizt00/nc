use <io:output>;

astCompactRoles {
    const:
        LIMIT >> int <- 7;

    Packet :: type [repr C | align 16] {
        public:
            tag >> int;
            flags >> byte;
    }

    stc:
        visits >> int <- 0;

    add :: fn(left >> int, right >> int) -> int {
        return left + right;
    }

    run :: fn() -> bool {
        result >> int <- add(LIMIT, 4);
        visits += 1;
        return result == 11;
    }

    ref main ->> run;
    fa:
        return true;
}
