use <io:output>;

irMaterialAll {
    const:
        LIMIT >> int <- 4;

    type:
        Packet {
            public:
                tag >> int;
                flags >> byte;
        }

    stc:
        runs >> u64 <- 0;

    local:
        last >> int <- 0;

    fn:
        private:
            add(left >> int, right >> int) -> int {
                return left + right;
            }

        public:
            run() -> bool {
                packet >> Packet <- Packet { tag: 7, flags: 1 };
                index >> int <- 0;
                total >> int <- 0;

                defer {
                    last <- total;
                }

                while (index < LIMIT) {
                    total <- add(total, index);
                    index += 1;
                }

                if (packet.tag == 7 && total == 6) {
                    runs += 1;
                    return true;
                } else {
                    return false;
                }
            }

    ref main ->> run;

    fa:
        return true;
}
