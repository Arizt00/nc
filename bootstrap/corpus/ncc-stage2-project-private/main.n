use <project:worker>;

stage2PrivateMain {
    const:
        EXPECTED >> int <- 9;

    type:
        PrivateProbe {
            public:
                value >> int;
        }

    stc:
        runs >> u64 <- 0;

    local:
        last >> int <- 0;

    fn:
        run() -> bool {
            last <- worker.stage2PrivateWorker.hidden();
            runs += 1;
            return last == EXPECTED;
        }

    ref main ->> run;

    fa:
        return true;
}
