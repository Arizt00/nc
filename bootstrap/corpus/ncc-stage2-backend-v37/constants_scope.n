const GLOBAL >> int <- 6;

constantsScope {
    const:
        EXPECTED >> int <- NEXT + GLOBAL;
        NEXT >> int <- 6 * 6;
    fn:
        public:
            run() -> int {
                return EXPECTED;
            }
            shadow(EXPECTED >> int) -> int {
                return EXPECTED + 1;
            }
    ref main ->> run;
    fa:
        return true;
}
