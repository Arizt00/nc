use <project:worker>;

stage2ProjectMain {
    const:
        EXPECTED >> int <- 49;

    type:
        ResultCell {
            public:
                value >> int;
        }

    stc:
        runs >> u64 <- 0;

    local:
        last >> int <- 0;

    fn:
        private:
            projectOffset() -> int {
                return 1000;
            }

        run() -> bool {
            last <- worker.stage2ProjectWorker.answer(5) +
                worker.stage2ProjectWorker.projectOffset();
            runs += 1;
            return last == EXPECTED;
        }

    ref main ->> run;

    fa:
        return true;
}
