stage2ProjectWorker {
    const:
        MATERIAL >> int <- 42;

    type:
        WorkerWord {
            public:
                value >> int;
        }

    stc:
        calls >> u64 <- 0;

    local:
        cached >> int <- MATERIAL;

    fn:
        public:
            answer(value >> int) -> int {
                first >> int <- value * 3 + 6;
                second >> int <- value * 3 + 6;
                calls += 1;
                return first + second;
            }

        internal:
            projectOffset() -> int {
                return 7;
            }

        private:
            unitSecret() -> int {
                return 99;
            }

    fa:
        return true;
}
