{
  "schema": "ncc.public_beta.manifest.v1",
  "public_name": "ncc",
  "dist_root": "dist/public-beta/ncc",
  "public_files": [
    "LICENSE"
  ],
  "public_doc_files": [
    "docs/public.md"
  ],
  "public_tool_files": [
    "tools/release/public_beta_manifest.json"
  ],
  "public_trees": [
    "crates",
    "assets"
  ],
  "public_fixture_trees": [
    {
      "source": "fixtures",
      "dest": "tests/fixtures"
    }
  ],
  "private_roots": [
    "private"
  ],
  "private_segments": [
    "private"
  ],
  "private_file_suffixes": [
    ".secret"
  ],
  "private_path_fragments": [
    "/hidden/"
  ],
  "public_package_prune": {
    "crate_integration_tests": true
  },
  "public_test_groups": [
    "tests/parser",
    "tests/sema"
  ],
  "public_examples": [
    {
      "source": "examples/ok.n",
      "dest": "examples/topic.n"
    },
    {
      "source": "examples/missing.n",
      "dest": "examples/missing.n"
    }
  ],
  "forbidden_public_roots": [
    "private",
    "reports"
  ],
  "public_example_name_policy": {
    "forbid_path_tokens": [
      "phase"
    ],
    "description": "internal"
  },
  "ignored_metadata": "\ud800"
}
