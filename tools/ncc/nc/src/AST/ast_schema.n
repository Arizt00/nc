nccAstSchema {
    const:
        AST_PROGRAM >> int <- 1;
        AST_USE_GROUP >> int <- 2;
        AST_CONTAINER >> int <- 3;
        AST_CONST_SECTION >> int <- 4;
        AST_TYPE_SECTION >> int <- 5;
        AST_STC_SECTION >> int <- 6;
        AST_LOCAL_SECTION >> int <- 7;
        AST_FN_SECTION >> int <- 8;
        AST_FA_SECTION >> int <- 9;
        AST_GLOBAL_CONST >> int <- 10;
        AST_GLOBAL_TYPE >> int <- 11;
        AST_VALUE_DECL >> int <- 12;
        AST_TYPE_DECL >> int <- 13;
        AST_FIELD_DECL >> int <- 14;
        AST_FUNCTION_DECL >> int <- 15;
        AST_PARAMETER_DECL >> int <- 16;
        AST_ENTRY_REF >> int <- 17;
        AST_TYPE_NAME >> int <- 18;
        AST_TYPE_APPLY >> int <- 19;
        AST_TYPE_POINTER >> int <- 20;
        AST_TYPE_ARRAY >> int <- 21;
        AST_TYPE_UNION >> int <- 22;
        AST_TYPE_FUNCTION >> int <- 23;
        AST_TYPE_CONST >> int <- 24;
        AST_EXPR_LITERAL >> int <- 25;
        AST_EXPR_NAME >> int <- 26;
        AST_EXPR_UNARY >> int <- 27;
        AST_EXPR_BINARY >> int <- 28;
        AST_EXPR_CALL >> int <- 29;
        AST_EXPR_MEMBER >> int <- 30;
        AST_EXPR_INDEX >> int <- 31;
        AST_EXPR_TERNARY >> int <- 32;
        AST_EXPR_ARRAY >> int <- 33;
        AST_BLOCK >> int <- 34;
        AST_STMT_EXPRESSION >> int <- 35;
        AST_STMT_ASSIGN >> int <- 36;
        AST_STMT_RETURN >> int <- 37;
        AST_STMT_IF >> int <- 38;
        AST_STMT_WHILE >> int <- 39;
        AST_STMT_FOR >> int <- 40;
        AST_STMT_GUARD >> int <- 41;
        AST_STMT_DEFER >> int <- 42;
        AST_STMT_BREAK >> int <- 43;
        AST_STMT_CONTINUE >> int <- 44;
        AST_EXPR_STRUCT >> int <- 45;
        AST_EXPR_FIELD >> int <- 46;
        AST_EXPR_CLOSURE >> int <- 47;
        AST_EXPR_TRY >> int <- 48;
        AST_EXPR_PREFIX >> int <- 49;
        AST_EXPR_IF >> int <- 50;
        AST_STMT_MATCH >> int <- 51;
        AST_MATCH_ARM >> int <- 52;
        AST_STMT_FOR_IN >> int <- 53;
        AST_STMT_FOR_RANGE >> int <- 54;
        AST_STMT_LOOP >> int <- 55;
        AST_STMT_REPEAT >> int <- 56;
        AST_STMT_DO_WHILE >> int <- 57;
        AST_STMT_UNLESS >> int <- 58;
        AST_STMT_YIELD >> int <- 59;
        AST_PATTERN_WILDCARD >> int <- 60;
        AST_PATTERN_LITERAL >> int <- 61;
        AST_PATTERN_BINDING >> int <- 62;
        AST_PATTERN_VARIANT >> int <- 63;
        AST_PATTERN_STRUCT >> int <- 64;
        AST_PATTERN_FIELD >> int <- 65;
        AST_PATTERN_ARRAY >> int <- 66;
        AST_PATTERN_RANGE >> int <- 67;
        AST_PATTERN_REST >> int <- 68;
        AST_CLOSURE_PARAMETER >> int <- 69;
        AST_CLOSURE_CAPTURE >> int <- 70;
        AST_CLOSURE_EFFECT >> int <- 71;
        AST_GENERIC_DECL >> int <- 72;
        AST_GENERIC_PARAM >> int <- 73;
        AST_GENERIC_APPLY >> int <- 74;
        AST_TRAIT_DECL >> int <- 75;
        AST_IMPL_DECL >> int <- 76;
        AST_ASSOCIATED_TYPE >> int <- 77;
        AST_ABI_CONTRACT >> int <- 78;
        AST_ABI_FIELD >> int <- 79;
        AST_ABI_BINDING >> int <- 80;
        AST_MODULE_DECL >> int <- 81;
        AST_PACKAGE_DECL >> int <- 82;
        AST_PATH_SEGMENT >> int <- 83;
        AST_PACKAGE_VERSION >> int <- 84;
        AST_PACKAGE_PROFILE >> int <- 85;
        AST_TYPE_CLAUSE >> int <- 86;
        AST_CONTRACT_ITEM >> int <- 87;
        AST_TYPE_VARIANT >> int <- 88;
        AST_TYPE_GENERIC_PARAM >> int <- 89;

    fn:
        public:
            kindName(value >> int) -> str {
                if (value == AST_PROGRAM) return "Program";
                if (value == AST_USE_GROUP) return "UseGroup";
                if (value == AST_CONTAINER) return "Container";
                if (value == AST_CONST_SECTION) return "ConstSection";
                if (value == AST_TYPE_SECTION) return "TypeSection";
                if (value == AST_STC_SECTION) return "StcSection";
                if (value == AST_LOCAL_SECTION) return "LocalSection";
                if (value == AST_FN_SECTION) return "FnSection";
                if (value == AST_FA_SECTION) return "FaSection";
                if (value == AST_GLOBAL_CONST) return "GlobalConst";
                if (value == AST_GLOBAL_TYPE) return "GlobalType";
                if (value == AST_VALUE_DECL) return "ValueDecl";
                if (value == AST_TYPE_DECL) return "TypeDecl";
                if (value == AST_FIELD_DECL) return "FieldDecl";
                if (value == AST_FUNCTION_DECL) return "FunctionDecl";
                if (value == AST_PARAMETER_DECL) return "ParameterDecl";
                if (value == AST_ENTRY_REF) return "EntryRef";
                if (value == AST_TYPE_NAME) return "TypeName";
                if (value == AST_TYPE_APPLY) return "TypeApply";
                if (value == AST_TYPE_POINTER) return "TypePointer";
                if (value == AST_TYPE_ARRAY) return "TypeArray";
                if (value == AST_TYPE_UNION) return "TypeUnion";
                if (value == AST_TYPE_FUNCTION) return "TypeFunction";
                if (value == AST_TYPE_CONST) return "TypeConst";
                if (value == AST_EXPR_LITERAL) return "ExprLiteral";
                if (value == AST_EXPR_NAME) return "ExprName";
                if (value == AST_EXPR_UNARY) return "ExprUnary";
                if (value == AST_EXPR_BINARY) return "ExprBinary";
                if (value == AST_EXPR_CALL) return "ExprCall";
                if (value == AST_EXPR_MEMBER) return "ExprMember";
                if (value == AST_EXPR_INDEX) return "ExprIndex";
                if (value == AST_EXPR_TERNARY) return "ExprTernary";
                if (value == AST_EXPR_ARRAY) return "ExprArray";
                if (value == AST_BLOCK) return "Block";
                if (value == AST_STMT_EXPRESSION) return "ExprStmt";
                if (value == AST_STMT_ASSIGN) return "AssignStmt";
                if (value == AST_STMT_RETURN) return "ReturnStmt";
                if (value == AST_STMT_IF) return "IfStmt";
                if (value == AST_STMT_WHILE) return "WhileStmt";
                if (value == AST_STMT_FOR) return "ForStmt";
                if (value == AST_STMT_GUARD) return "GuardStmt";
                if (value == AST_STMT_DEFER) return "DeferStmt";
                if (value == AST_STMT_BREAK) return "BreakStmt";
                if (value == AST_STMT_CONTINUE) return "ContinueStmt";
                if (value == AST_EXPR_STRUCT) return "ExprStruct";
                if (value == AST_EXPR_FIELD) return "ExprField";
                if (value == AST_EXPR_CLOSURE) return "ExprClosure";
                if (value == AST_EXPR_TRY) return "ExprTry";
                if (value == AST_EXPR_PREFIX) return "ExprPrefix";
                if (value == AST_EXPR_IF) return "ExprIf";
                if (value == AST_STMT_MATCH) return "MatchStmt";
                if (value == AST_MATCH_ARM) return "MatchArm";
                if (value == AST_STMT_FOR_IN) return "ForInStmt";
                if (value == AST_STMT_FOR_RANGE) return "ForRangeStmt";
                if (value == AST_STMT_LOOP) return "LoopStmt";
                if (value == AST_STMT_REPEAT) return "RepeatStmt";
                if (value == AST_STMT_DO_WHILE) return "DoWhileStmt";
                if (value == AST_STMT_UNLESS) return "UnlessStmt";
                if (value == AST_STMT_YIELD) return "YieldStmt";
                if (value == AST_PATTERN_WILDCARD) return "PatternWildcard";
                if (value == AST_PATTERN_LITERAL) return "PatternLiteral";
                if (value == AST_PATTERN_BINDING) return "PatternBinding";
                if (value == AST_PATTERN_VARIANT) return "PatternVariant";
                if (value == AST_PATTERN_STRUCT) return "PatternStruct";
                if (value == AST_PATTERN_FIELD) return "PatternField";
                if (value == AST_PATTERN_ARRAY) return "PatternArray";
                if (value == AST_PATTERN_RANGE) return "PatternRange";
                if (value == AST_PATTERN_REST) return "PatternRest";
                if (value == AST_CLOSURE_PARAMETER) return "ClosureParameter";
                if (value == AST_CLOSURE_CAPTURE) return "ClosureCapture";
                if (value == AST_CLOSURE_EFFECT) return "ClosureEffect";
                if (value == AST_GENERIC_DECL) return "GenericDecl";
                if (value == AST_GENERIC_PARAM) return "GenericParam";
                if (value == AST_GENERIC_APPLY) return "GenericApply";
                if (value == AST_TRAIT_DECL) return "TraitDecl";
                if (value == AST_IMPL_DECL) return "ImplDecl";
                if (value == AST_ASSOCIATED_TYPE) return "AssociatedType";
                if (value == AST_ABI_CONTRACT) return "AbiContract";
                if (value == AST_ABI_FIELD) return "AbiField";
                if (value == AST_ABI_BINDING) return "AbiBinding";
                if (value == AST_MODULE_DECL) return "ModuleDecl";
                if (value == AST_PACKAGE_DECL) return "PackageDecl";
                if (value == AST_PATH_SEGMENT) return "PathSegment";
                if (value == AST_PACKAGE_VERSION) return "PackageVersion";
                if (value == AST_PACKAGE_PROFILE) return "PackageProfile";
                if (value == AST_TYPE_CLAUSE) return "TypeClause";
                if (value == AST_CONTRACT_ITEM) return "ContractItem";
                if (value == AST_TYPE_VARIANT) return "TypeVariant";
                if (value == AST_TYPE_GENERIC_PARAM) return "TypeGenericParam";
                return "Invalid";
            }

    fa:
        return true;
}
