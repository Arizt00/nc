nccJsonAbi {
    fn:
        internal:
            same(data >> p<byte>, bytes >> int, text >> str, count >> int) -> bool {
                if (data == null || bytes != count) return false;
                at >> int <- 0;
                while (at < bytes) {
                    if (rd(off(data,at)) != rd<byte>(off(cast<byte>(text),at))) return false;
                    at += 1;
                }
                return true;
            }
            resolve(name >> p<byte>, bytes >> int) -> int {
                if (same(name,bytes,"jsonNewBool",11)) return 1;
                if (same(name,bytes,"jsonObjectSet",13)) return 2;
                if (same(name,bytes,"jsonNewObject",13)) return 3;
                if (same(name,bytes,"jsonRelease",11)) return 4;
                if (same(name,bytes,"jsonGetBool",11)) return 5;
                if (same(name,bytes,"jsonKind",8)) return 6;
                if (same(name,bytes,"jsonObjectBorrow",16)) return 7;
                if (same(name,bytes,"jsonObjectLen",13)) return 8;
                if (same(name,bytes,"jsonObjectHas",13)) return 9;
                if (same(name,bytes,"jsonObjectGet",13)) return 10;
                if (same(name,bytes,"jsonClone",9)) return 11;
                if (same(name,bytes,"jsonNewNull",11)) return 12;
                if (same(name,bytes,"jsonNewInt",10)) return 13;
                if (same(name,bytes,"jsonNewString",13)) return 14;
                if (same(name,bytes,"jsonNewArray",12)) return 15;
                if (same(name,bytes,"jsonArrayPush",13)) return 16;
                if (same(name,bytes,"jsonArrayBorrow",15)) return 17;
                if (same(name,bytes,"jsonArrayLen",12)) return 18;
                if (same(name,bytes,"jsonGetInt",10)) return 19;
                if (same(name,bytes,"jsonStringView",14)) return 20;
                if (same(name,bytes,"jsonObjectRemove",16)) return 21;
                if (same(name,bytes,"jsonEquals",10)) return 22;
                if (same(name,bytes,"jsonObjectKeyAt",15)) return 23;
                if (same(name,bytes,"jsonStringify",13)) return 24;
                if (same(name,bytes,"jsonGetBoolOr",13)) return 25;
                if (same(name,bytes,"jsonGetIntOr",12)) return 26;
                if (same(name,bytes,"jsonStringifyPretty",19)) return 27;
                if (same(name,bytes,"jsonParse",9)) return 28;
                if (same(name,bytes,"jsonGetStringOr",15)) return 29;
                if (same(name,bytes,"jsonParseFile",13)) return 30;
                if (same(name,bytes,"jsonValidate",12)) return 31;
                if (same(name,bytes,"jsonSaveFile",12)) return 32;
                if (same(name,bytes,"jsonGetString",13)) return 33;
                if (same(name,bytes,"jsonArrayGet",12)) return 34;
                if (same(name,bytes,"jsonArrayInsert",15)) return 35;
                if (same(name,bytes,"jsonArrayRemove",15)) return 36;
                if (same(name,bytes,"jsonGetNumberText",17)) return 37;
                if (same(name,bytes,"jsonIsNull",10)) return 38;
                if (same(name,bytes,"jsonErrorCode",13)) return 39;
                if (same(name,bytes,"jsonErrorLine",13)) return 40;
                if (same(name,bytes,"jsonErrorColumn",15)) return 41;
                if (same(name,bytes,"jsonNewFloat",12)) return 42;
                if (same(name,bytes,"jsonGetFloat",12)) return 43;
                if (same(name,bytes,"jsonGetFloatOr",14)) return 44;
                return 0;
            }
            owned(name >> p<byte>, bytes >> int, owner >> p<byte>, ownerBytes >> int) -> int {
                return same(owner,ownerBytes,"json",4) ? resolve(name,bytes) : 0;
            }
            arity(id >> int) -> int {
                if (id == 42 || id == 43) return 1;
                if (id == 44) return 2;
                if (id == 1) return 1;
                if (id == 2) return 3;
                if (id == 3) return 0;
                if (id == 4) return 1;
                if (id == 5) return 1;
                if (id == 6) return 1;
                if (id == 7) return 2;
                if (id == 8) return 1;
                if (id == 9) return 2;
                if (id == 10) return 2;
                if (id == 11) return 1;
                if (id == 12) return 0;
                if (id == 13) return 1;
                if (id == 14) return 1;
                if (id == 15) return 0;
                if (id == 16) return 2;
                if (id == 17) return 2;
                if (id == 18) return 1;
                if (id == 19) return 1;
                if (id == 20) return 2;
                if (id == 21) return 2;
                if (id == 22) return 2;
                if (id == 23) return 2;
                if (id == 24) return 1;
                if (id == 25) return 2;
                if (id == 26 || id == 27 || id == 29) return 2;
                if (id == 28 || id == 30 || id == 31) return 1;
                if (id == 32) return 3;
                if (id == 34 || id == 36) return 2;
                if (id == 35) return 3;
                if (id >= 33 && id <= 38) return 1;
                if (id >= 39 && id <= 41) return 0;
                return -1;
            }
            argumentCode(id >> int, index >> int) -> int {
                if (id == 42) return index == 0 ? 41 : -1;
                if (id == 43) return index == 0 ? 20 : -1;
                if (id == 44) return index == 0 ? 20 : (index == 1 ? 41 : -1);
                if (id == 1) return index == 0 ? 33 : -1;
                if (id == 2) return index == 0 ? 20 : index == 1 ? 34 : index == 2 ? 20 : -1;
                if (id == 4) return index == 0 ? 20 : -1;
                if (id == 5) return index == 0 ? 20 : -1;
                if (id == 6) return index == 0 ? 20 : -1;
                if (id == 7) return index == 0 ? 20 : index == 1 ? 34 : -1;
                if (id == 8) return index == 0 ? 20 : -1;
                if (id == 9) return index == 0 ? 20 : index == 1 ? 34 : -1;
                if (id == 10) return index == 0 ? 20 : index == 1 ? 34 : -1;
                if (id == 11) return index == 0 ? 20 : -1;
                if (id == 13) return index == 0 ? 20 : -1;
                if (id == 14) return index == 0 ? 34 : -1;
                if (id == 16) return index == 0 ? 20 : index == 1 ? 20 : -1;
                if (id == 17) return index == 0 ? 20 : index == 1 ? 20 : -1;
                if (id == 18) return index == 0 ? 20 : -1;
                if (id == 19) return index == 0 ? 20 : -1;
                if (id == 20) return index == 0 ? 20 : index == 1 ? 34 : -1;
                if (id == 21) return index == 0 ? 20 : index == 1 ? 34 : -1;
                if (id == 22) return index == 0 ? 20 : index == 1 ? 20 : -1;
                if (id == 23) return index == 0 ? 20 : index == 1 ? 20 : -1;
                if (id == 24) return index == 0 ? 20 : -1;
                if (id == 25) return index == 0 ? 20 : index == 1 ? 33 : -1;
                if (id == 26 || id == 27) return index >= 0 && index <= 1 ? 20 : -1;
                if (id == 28 || id == 30 || id == 31) return index == 0 ? 34 : -1;
                if (id == 29) return index == 0 ? 20 : index == 1 ? 34 : -1;
                if (id == 32) return index == 0 || index == 2 ? 20 : index == 1 ? 34 : -1;
                if (id >= 33 && id <= 38) return index >= 0 && index < arity(id) ? 20 : -1;
                return -1;
            }
            resultCode(id >> int) -> int {
                if (id == 42) return 20;
                if (id == 43 || id == 44) return 41;
                if (id == 1) return 20;
                if (id == 2) return 33;
                if (id == 3) return 20;
                if (id == 4) return 33;
                if (id == 5) return 33;
                if (id == 6) return 20;
                if (id == 7) return 20;
                if (id == 8) return 20;
                if (id == 9) return 33;
                if (id == 10) return 20;
                if (id == 11) return 20;
                if (id == 12) return 20;
                if (id == 13) return 20;
                if (id == 14) return 20;
                if (id == 15) return 20;
                if (id == 16) return 33;
                if (id == 17) return 20;
                if (id == 18) return 20;
                if (id == 19) return 20;
                if (id == 20) return 34;
                if (id == 21) return 20;
                if (id == 22) return 33;
                if (id == 23) return 34;
                if (id == 24) return 34;
                if (id == 25) return 33;
                if (id == 26 || id == 28 || id == 30) return 20;
                if (id == 27 || id == 29) return 34;
                if (id == 31 || id == 32) return 33;
                if (id == 33 || id == 37) return 34;
                if (id == 35 || id == 38) return 33;
                if (id == 34 || id == 36 || (id >= 39 && id <= 41)) return 20;
                return -1;
            }
    fa: return true;
}

