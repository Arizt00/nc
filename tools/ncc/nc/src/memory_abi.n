use <project:platform_abi>;

nccMemoryAbi {
    fn:
        internal:
    same(data >> p<byte>, bytes >> int, text >> str) -> bool {
        if (bytes != strByteLen(text)) return false;
        at >> int <- 0;
        while (at < bytes) {
            if (rd(off(data,at)) != rd(off(cast<byte>(text),at))) return false;
            at += 1;
        }
        return true;
    }
    resolve(data >> p<byte>, bytes >> int) -> int {
        if (data == null || bytes < 3) return 0;
        first >> int <- rd(data);
        second >> int <- rd(off(data,1));
        if (!((first == 118 && second == 109) || (first == 111 && second == 115))) return 0;
        if (bytes > 3 && first == 111 && (rd(off(data,2)) == 87 || rd(off(data,2)) == 76))
            return platform_abi.nccPlatformAbi.resolve(data,bytes);
        if (same(data,bytes,"vmPageSize")) return 1;
        if (same(data,bytes,"vmAllocationGranularity")) return 2;
        if (same(data,bytes,"vmReserve")) return 3;
        if (same(data,bytes,"vmCommit")) return 4;
        if (same(data,bytes,"vmDecommit")) return 5;
        if (same(data,bytes,"vmRelease")) return 6;
        if (same(data,bytes,"vmProtect")) return 7;
        if (same(data,bytes,"vmGuard")) return 8;
        if (same(data,bytes,"vmExecutable")) return 9;
        if (same(data,bytes,"vmLastError")) return 10;
        if (same(data,bytes,"vmLock")) return 11;
        if (same(data,bytes,"vmUnlock")) return 12;
        if (same(data,bytes,"vmMap")) return 13;
        if (same(data,bytes,"vmUnmap")) return 14;
        if (same(data,bytes,"vmAdvise")) return 15;
        if (same(data,bytes,"vmSync")) return 16;
        if (same(data,bytes,"vmRemap")) return 17;
        if (same(data,bytes,"vmReadWriteProtection")) return 18;
        if (same(data,bytes,"osVirtualAlloc")) return 101;
        if (same(data,bytes,"osVirtualFree")) return 102;
        if (same(data,bytes,"osVirtualProtect")) return 103;
        if (same(data,bytes,"osGetSystemInfo")) return 104;
        if (same(data,bytes,"osGetLastError")) return 105;
        if (same(data,bytes,"osSetLastError")) return 106;
        if (same(data,bytes,"osVirtualLock")) return 107;
        if (same(data,bytes,"osVirtualUnlock")) return 108;
        if (same(data,bytes,"osGetCurrentProcess")) return 109;
        if (same(data,bytes,"osFlushInstructionCache")) return 110;
        if (same(data,bytes,"osMapViewOfFileEx")) return 111;
        if (same(data,bytes,"osUnmapViewOfFile")) return 112;
        if (same(data,bytes,"osDiscardVirtualMemory")) return 113;
        if (same(data,bytes,"osFlushViewOfFile")) return 114;
        if (same(data,bytes,"osCreateFileW")) return 115;
        if (same(data,bytes,"osCreateFileMappingW")) return 116;
        if (same(data,bytes,"osOpenFileMappingW")) return 117;
        if (same(data,bytes,"osCloseHandle")) return 118;
        if (same(data,bytes,"osSetFilePointerEx")) return 119;
        if (same(data,bytes,"osSetEndOfFile")) return 120;
        if (same(data,bytes,"osFlushFileBuffers")) return 121;
        if (same(data,bytes,"osReadFile")) return 122;
        if (same(data,bytes,"osDeleteFileW")) return 123;
        if (same(data,bytes,"osGetFileSizeEx")) return 124;
        if (same(data,bytes,"osDeviceIoControl")) return 125;
        if (same(data,bytes,"osGetCompressedFileSizeW")) return 126;
        if (same(data,bytes,"osErrnoSlot")) return 201;
        return 0;
    }
    arity(id >> int) -> int {
        if (id >= 300) return platform_abi.nccPlatformAbi.arity(id);
        if (id == 115) return 7;
        if (id == 116) return 6;
        if (id == 117) return 3;
        if (id == 118 || id == 120 || id == 121 || id == 123) return 1;
        if (id == 119) return 4;
        if (id == 122) return 5;
        if (id == 124 || id == 126) return 2;
        if (id == 125) return 8;
        if (id == 1 || id == 2 || id == 10 || id == 18 || id == 105 || id == 109 || id == 201) return 0;
        if (id == 104 || id == 106 || id == 112) return 1;
        if (id == 5 || id == 6 || id == 9 || id == 11 || id == 12 || id == 14 ||
            id == 107 || id == 108 || id == 113 || id == 114) return 2;
        if (id == 3 || id == 4 || id == 7 || id == 8 || id == 15 || id == 16 || id == 102 || id == 110) return 3;
        if (id == 101 || id == 103) return 4;
        if (id == 13 || id == 17 || id == 111) return 6;
        return -1;
    }
    argumentCode(id >> int, at >> int) -> int {
        if (id >= 300) return platform_abi.nccPlatformAbi.argumentCode(id,at);
        if (at < 0 || at >= arity(id)) return -1;
        if (id >= 115 && id <= 126) {
            if (id == 119 && at == 1) return 24;
            if (id == 117 && at == 1) return 20;
            if ((id == 115 && (at == 1 || at == 2 || at == 4 || at == 5)) ||
                (id == 116 && at >= 2 && at <= 4) || (id == 117 && at == 0) ||
                (id == 119 && at == 3) || (id == 122 && at == 2) ||
                (id == 125 && (at == 1 || at == 3 || at == 5))) return 4;
            return 8;
        }
        if (id >= 101 && id <= 114) {
            if ((id == 101 && at >= 2) || (id == 102 && at == 2) || (id == 103 && at == 2) ||
                id == 106 || (id == 111 && at >= 1 && at <= 3)) return 4;
        }
        return 8;
    }
    pointerArgument(id >> int, at >> int) -> bool {
        if (id >= 300) return platform_abi.nccPlatformAbi.pointerArgument(id,at);
        if (id >= 115 && id <= 126) {
            if (at < 0 || at >= arity(id)) return false;
            if (id == 115) return at == 0 || at == 3 || at == 6;
            if (id == 116) return at == 0 || at == 1 || at == 5;
            if (id == 117) return at == 2;
            if (id == 119) return at == 0 || at == 2;
            if (id == 122) return at != 2;
            if (id == 125) return at == 0 || at == 2 || at == 4 || at == 6 || at == 7;
            return true;
        }
        return (at == 0 && id != 106 && id != 111) ||
            (id == 17 && at == 5) || (id == 103 && at == 3) ||
            (id == 110 && at == 1) || (id == 111 && (at == 0 || at == 5));
    }
    resultCode(id >> int) -> int {
        if (id >= 300) return platform_abi.nccPlatformAbi.resultCode(id);
        if (id == 115 || id == 116 || id == 117) return 8;
        if (id == 126) return 4;
        if (id == 1 || id == 2 || id == 10 || id == 18) return 20;
        if (id == 3 || id == 13 || id == 17 || id == 101 || id == 109 || id == 111 || id == 201) return 8;
        if (id == 104 || id == 106) return 0;
        if (id == 105 || id == 113) return 4;
        if (id >= 100 && id < 200) return 20;
        return id > 0 ? 33 : -1;
    }
    pointerResult(id >> int) -> bool {
        return id >= 300 ? platform_abi.nccPlatformAbi.pointerResult(id) : resultCode(id) == 8;
    }
    owner(id >> int) -> str {
        if (id >= 300) return id >= 1000 ? "os_linux" : "os_windows";
        return id >= 200 ? "os_linux" : (id >= 100 ? "os_windows" : "vm");
    }
    ownerData(id >> int) -> p<byte> { return cast<byte>(owner(id)); }
    ownerBytes(id >> int) -> int { return strByteLen(owner(id)); }
    selfTest() -> bool {
        return resolve(cast<byte>("vmReserve"),9) == 3 && arity(101) == 4 &&
            argumentCode(103,3) == 8 && resultCode(201) == 8 && owner(4) == "vm" &&
            resolve(cast<byte>("osCreateFileW"),13) == 115 && arity(115) == 7 &&
            resolve(cast<byte>("osDeviceIoControl"),17) == 125 && arity(125) == 8 &&
            argumentCode(115,4) == 4 && argumentCode(119,1) == 24 &&
            argumentCode(117,1) == 20 && argumentCode(125,7) == 8 &&
            pointerArgument(115,6) && !pointerArgument(115,5) &&
            pointerArgument(125,6) && !pointerArgument(125,5) &&
            resultCode(115) == 8 && resultCode(126) == 4 && resultCode(122) == 20 &&
            owner(125) == "os_windows" && platform_abi.nccPlatformAbi.selfTest();
    }
    fa: return true;
}
