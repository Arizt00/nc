use <io:output, render>;
use <project:ir, sema, diagnostics, intrinsics, mct_llvm, mct_values, native_body>;

nccMct {
    const:
        MCT_MAGIC >> int <- 1413698382;
        MCT_VERSION >> int <- 4;
        HEADER_BYTES >> int <- 192;
        RECORD_BYTES >> int <- 72;
        IDENTITY_BYTES >> int <- 32;
        MAX_INSTRUCTION_BYTES >> int <- 32;

        H_MAGIC >> int <- 0;
        H_VERSION >> int <- 4;
        H_TARGET >> int <- 8;
        H_FAMILY >> int <- 12;
        H_POINTER_BITS >> int <- 16;
        H_OBJECT >> int <- 20;
        H_ABI >> int <- 24;
        H_IR_NODES >> int <- 28;
        H_RECORD_BYTES >> int <- 32;
        H_INSTRUCTIONS >> int <- 36;
        H_TEXT_BYTES >> int <- 40;
        H_RELOCATIONS >> int <- 44;
        H_CALLS >> int <- 48;
        H_BRANCHES >> int <- 52;
        H_RETURNS >> int <- 56;
        H_LOADS >> int <- 60;
        H_STORES >> int <- 64;
        H_MAX_INSTRUCTION >> int <- 68;
        H_ALIGNMENT >> int <- 72;
        H_IR_FINGERPRINT >> int <- 76;
        H_TEXT_HASH >> int <- 80;
        H_FINGERPRINT >> int <- 84;
        H_RECORDS_OFFSET >> int <- 88;
        H_TEXT_OFFSET >> int <- 92;
        H_MATERIAL_BYTES >> int <- 96;
        H_TARGETS >> int <- 100;
        H_LOCAL_TARGETS >> int <- 104;
        H_EXTERNAL_TARGETS >> int <- 108;
        H_CONTROL_TARGETS >> int <- 112;
        H_UNRESOLVED_TARGETS >> int <- 116;
        H_IDENTITIES_OFFSET >> int <- 120;
        H_STRINGS_OFFSET >> int <- 124;
        H_STRING_BYTES >> int <- 128;
        H_IDENTITY_FINGERPRINT >> int <- 132;
        H_SOURCE_MAP_OFFSET >> int <- 136;
        H_SOURCE_MAP_BYTES >> int <- 140;
        H_SOURCE_MAP_RECORD_BYTES >> int <- 144;
        H_SOURCE_MAP_LINES >> int <- 148;
        H_INTRINSIC_TARGETS >> int <- 152;
        H_RUNTIME_TARGETS >> int <- 156;
        H_DATA_OFFSET >> int <- 160;
        H_DATA_BYTES >> int <- 164;
        H_BSS_BYTES >> int <- 168;
        H_RODATA_OFFSET >> int <- 172;
        H_RODATA_BYTES >> int <- 176;
        H_STORAGE_HASH >> int <- 180;
        H_STORAGE_ALIGNMENT >> int <- 184;
        H_STORAGE_RESERVED >> int <- 188;

        SOURCE_MAP_RECORD_BYTES >> int <- 8;
        S_LINE >> int <- 0;
        S_COLUMN >> int <- 4;

        R_IR_INDEX >> int <- 0;
        R_IR_OPCODE >> int <- 4;
        R_FAMILY >> int <- 8;
        R_TEXT_OFFSET >> int <- 12;
        R_BYTE_LENGTH >> int <- 16;
        R_RELOCATION >> int <- 20;
        R_RELOCATION_OFFSET >> int <- 24;
        R_ADDEND >> int <- 28;
        R_SECTION >> int <- 32;
        R_REGISTER_CLASS >> int <- 36;
        R_EFFECTS >> int <- 40;
        R_FLAGS >> int <- 44;
        R_NAME_HASH >> int <- 48;
        R_TYPE_HASH >> int <- 52;
        R_CHECKSUM >> int <- 56;
        R_ALIGNMENT >> int <- 60;
        R_TARGET_KIND >> int <- 64;
        R_TARGET_VALUE >> int <- 68;

        I_NAME_OFFSET >> int <- 0;
        I_NAME_BYTES >> int <- 4;
        I_OWNER_OFFSET >> int <- 8;
        I_OWNER_BYTES >> int <- 12;
        I_VISIBILITY >> int <- 16;
        I_KIND >> int <- 20;
        I_HASH_A >> int <- 24;
        I_HASH_B >> int <- 28;

        TARGET_NONE >> int <- 0;
        TARGET_LOCAL_SYMBOL >> int <- 1;
        TARGET_EXTERNAL_SYMBOL >> int <- 2;
        TARGET_CONTROL_NODE >> int <- 3;
        TARGET_UNRESOLVED >> int <- 4;

        EXTERNAL_PROJECT >> int <- 1;
        EXTERNAL_INTRINSIC >> int <- 2;
        EXTERNAL_RUNTIME >> int <- 3;

        FAMILY_X86_64 >> int <- 1;
        FAMILY_I386 >> int <- 2;
        FAMILY_AARCH64 >> int <- 3;
        FAMILY_ARMV7 >> int <- 4;
        FAMILY_RISCV32 >> int <- 5;
        FAMILY_RISCV64 >> int <- 6;
        FAMILY_WASM32 >> int <- 7;

        REGISTER_GPR64 >> int <- 1;
        REGISTER_GPR32 >> int <- 2;
        REGISTER_AARCH64_X >> int <- 3;
        REGISTER_ARM_R >> int <- 4;
        REGISTER_RISCV32_X >> int <- 5;
        REGISTER_RISCV64_X >> int <- 6;
        REGISTER_WASM_STACK >> int <- 7;

        ABI_SYSV64 >> int <- 1;
        ABI_WIN64 >> int <- 2;
        ABI_AAPCS64 >> int <- 3;
        ABI_SYSV32 >> int <- 4;
        ABI_AAPCS32 >> int <- 5;
        ABI_RISCV32 >> int <- 6;
        ABI_RISCV64 >> int <- 7;
        ABI_WASM >> int <- 8;

        SECTION_TEXT >> int <- 1;
        SECTION_DATA >> int <- 2;
        SECTION_BSS >> int <- 3;
        SECTION_RODATA >> int <- 4;
        RELOC_X86_ABS64 >> int <- 18;

        RELOC_NONE >> int <- 0;
        RELOC_X86_PCREL32 >> int <- 1;
        RELOC_X86_BRANCH32 >> int <- 2;
        RELOC_X86_DATA_PCREL32 >> int <- 3;
        RELOC_AARCH64_CALL26 >> int <- 4;
        RELOC_AARCH64_BRANCH26 >> int <- 5;
        RELOC_AARCH64_CONDBR19 >> int <- 6;
        RELOC_AARCH64_ADR_PREL21 >> int <- 7;
        RELOC_ARM_CALL >> int <- 8;
        RELOC_ARM_JUMP24 >> int <- 9;
        RELOC_ARM_REL32 >> int <- 10;
        RELOC_RISCV_CALL >> int <- 11;
        RELOC_RISCV_BRANCH >> int <- 12;
        RELOC_RISCV_JAL >> int <- 13;
        RELOC_RISCV_PCREL_HI20 >> int <- 14;
        RELOC_WASM_FUNCTION_INDEX >> int <- 15;
        RELOC_WASM_LABEL_INDEX >> int <- 16;

        IR_META >> int <- 1;
        IR_FUNCTION >> int <- 2;
        IR_DECLARE >> int <- 3;
        IR_TYPE >> int <- 4;
        IR_CONSTANT >> int <- 5;
        IR_LOAD >> int <- 6;
        IR_COMPUTE >> int <- 7;
        IR_CALL >> int <- 8;
        IR_STORE >> int <- 9;
        IR_BLOCK >> int <- 10;
        IR_RETURN >> int <- 11;
        IR_BRANCH >> int <- 12;
        IR_JUMP >> int <- 13;
        IR_DEFER >> int <- 14;
        IR_CLOSURE >> int <- 15;
        IR_COROUTINE >> int <- 16;
        IR_PATTERN >> int <- 17;
        IR_ABI >> int <- 18;
        IR_ENTRY >> int <- 19;
        IR_INTRINSIC >> int <- 20;

        ROLE_STRENGTH_SHL_BASE >> int <- 4096;
        ROLE_STRENGTH_SHR_U_BASE >> int <- 4160;
        ROLE_LICM_BASE >> int <- 4224;
        ROLE_INLINE_BASE >> int <- 8192;
        ROLE_GVN_SOURCE_BASE >> int <- 12288;
        ROLE_GVN_REUSE_BASE >> int <- 12304;

        FLAG_PROJECT_EXPORT >> int <- 1048576;
        AST_FUNCTION_DECL >> int <- 15;
        AST_PARAMETER_DECL >> int <- 16;
        AST_TYPE_NAME >> int <- 18;
        AST_EXPR_LITERAL >> int <- 25;
        AST_EXPR_NAME >> int <- 26;
        AST_EXPR_UNARY >> int <- 27;
        AST_STMT_WHILE >> int <- 39;
        AST_EXPR_CALL >> int <- 29;
        AST_EXPR_MEMBER >> int <- 30;
        AST_GENERIC_APPLY >> int <- 74;

    type:
        MctTarget {
            public:
                id >> int;
                family >> int;
                pointerBits >> int;
                objectFormat >> int;
                abi >> int;
                alignment >> int;
        }

        MctArtifact {
            public:
                bytes >> p<byte>;
                materialBytes >> int;
                textBytes >> int;
                relocations >> int;
                fingerprint >> int;
        }

        TargetIdentity {
            public:
                name >> p<byte>;
                nameBytes >> int;
                owner >> p<byte>;
                ownerBytes >> int;
                visibility >> int;
                kind >> int;
        }

    stc:
        translations >> u64 <- 0;
        bytesSelected >> u64 <- 0;

    local:
        lastTarget >> int <- 0;
        lastTextBytes >> int <- 0;
        lastFingerprint >> int <- 0;
        lastIdentityBytes >> int <- 0;

    fn:
        private:
            integer(base >> p<byte>, at >> int) -> int {
                return rd<int>(off(base, at));
            }

            putInteger(base >> p<byte>, at >> int, value >> int) -> void {
                wr<int>(off(base, at), value);
            }

            unsignedByte(value >> int) -> int {
                return value < 0 ? value + 256 : value;
            }

            stable(value >> int) -> int {
                if (value < 0) return 0 - (value % 1000003);
                return value % 1000003;
            }

            records(artifact >> p<byte>) -> p<byte> {
                return off(artifact, integer(artifact, H_RECORDS_OFFSET));
            }

            record(artifact >> p<byte>, index >> int) -> p<byte> {
                return off(records(artifact), index * RECORD_BYTES);
            }

            text(artifact >> p<byte>) -> p<byte> {
                return off(artifact, integer(artifact, H_TEXT_OFFSET));
            }

            identities(artifact >> p<byte>) -> p<byte> {
                return off(artifact, integer(artifact, H_IDENTITIES_OFFSET));
            }

            identity(artifact >> p<byte>, index >> int) -> p<byte> {
                return off(identities(artifact), index * IDENTITY_BYTES);
            }

            strings(artifact >> p<byte>) -> p<byte> {
                return off(artifact, integer(artifact, H_STRINGS_OFFSET));
            }

            sourceMap(artifact >> p<byte>) -> p<byte> {
                return off(artifact, integer(artifact, H_SOURCE_MAP_OFFSET));
            }

            sourceRecord(artifact >> p<byte>, index >> int) -> p<byte> {
                return off(sourceMap(artifact), index * SOURCE_MAP_RECORD_BYTES);
            }

            bytesEqual(left >> p<byte>, leftBytes >> int,
                right >> p<byte>, rightBytes >> int) -> bool {
                guard leftBytes == rightBytes else return false;
                at >> int <- 0;
                while (at < leftBytes) {
                    if (rd<byte>(off(left, at)) != rd<byte>(off(right, at))) return false;
                    at += 1;
                }
                return true;
            }

            graphTextEqual(graph >> p<byte>, index >> int, value >> str) -> bool {
                count >> int <- ir.nccIr.graphNodeNameBytes(graph, index);
                guard count == strByteLen(value) else return false;
                return bytesEqual(ir.nccIr.graphNodeName(graph, index), count,
                    cast<byte>(value), count);
            }

            rawIntrinsic(graph >> p<byte>, index >> int) -> bool {
                return intrinsics.nccIntrinsics.resolve(
                    ir.nccIr.graphNodeName(graph, index),
                    ir.nccIr.graphNodeNameBytes(graph, index)) != 0;
            }

            externalClass(graph >> p<byte>, sourceNode >> int) -> int {
                guard sourceNode >= 0 else return EXTERNAL_PROJECT;
                if (ir.nccIr.graphNodeRuntimeIdentity(graph, sourceNode))
                    return EXTERNAL_RUNTIME;
                if (ir.nccIr.graphNodeAstKind(graph, sourceNode) == AST_EXPR_MEMBER)
                    return EXTERNAL_PROJECT;
                return rawIntrinsic(graph, sourceNode) ?
                    EXTERNAL_INTRINSIC : EXTERNAL_RUNTIME;
            }

            identityHash(bytes >> p<byte>, count >> int, seed >> int) -> int {
                value >> int <- seed;
                at >> int <- 0;
                while (at < count) {
                    value <- (value * 257 + unsignedByte(rd<byte>(off(bytes, at))) + at + 1) %
                        2147483629;
                    at += 1;
                }
                return value;
            }

            put1(out >> p<byte>, at >> int, a >> int) -> int {
                wr<byte>(off(out, at), a);
                return at + 1;
            }

            put2(out >> p<byte>, at >> int, a >> int, b >> int) -> int {
                at <- put1(out, at, a);
                return put1(out, at, b);
            }

            put3(out >> p<byte>, at >> int, a >> int, b >> int, c >> int) -> int {
                at <- put2(out, at, a, b);
                return put1(out, at, c);
            }

            put4(out >> p<byte>, at >> int, a >> int, b >> int, c >> int, d >> int) -> int {
                at <- put3(out, at, a, b, c);
                return put1(out, at, d);
            }

            put5(out >> p<byte>, at >> int, a >> int, b >> int, c >> int,
                d >> int, e >> int) -> int {
                at <- put4(out, at, a, b, c, d);
                return put1(out, at, e);
            }

            put6(out >> p<byte>, at >> int, a >> int, b >> int, c >> int,
                d >> int, e >> int, f >> int) -> int {
                at <- put5(out, at, a, b, c, d, e);
                return put1(out, at, f);
            }

            put7(out >> p<byte>, at >> int, a >> int, b >> int, c >> int,
                d >> int, e >> int, f >> int, g >> int) -> int {
                at <- put6(out, at, a, b, c, d, e, f);
                return put1(out, at, g);
            }

            put8(out >> p<byte>, at >> int, a >> int, b >> int, c >> int,
                d >> int, e >> int, f >> int, g >> int, h >> int) -> int {
                at <- put7(out, at, a, b, c, d, e, f, g);
                return put1(out, at, h);
            }

            putWord(out >> p<byte>, at >> int, value >> int) -> int {
                return put4(out, at, value, value >>> 8, value >>> 16,
                    value >>> 24);
            }

            putWide(out >> p<byte>, at >> int, value >> int) -> int {
                at <- putWord(out, at, value);
                return putWord(out, at, value >>> 32);
            }

            encodeX64Constant(out >> p<byte>, at >> int, value >> int) -> int {
                if (value == 0) return put2(out, at, 49, 192);
                if (value >= 0 && value <= 0xFFFFFFFF) {
                    at <- put1(out, at, 184);
                    return putWord(out, at, value);
                }
                at <- put2(out, at, 72, 184);
                return putWide(out, at, value);
            }

            encodeI386Constant(out >> p<byte>, at >> int, value >> int) -> int {
                if (value == 0) return put2(out, at, 49, 192);
                at <- put1(out, at, 184);
                return putWord(out, at, value);
            }

            aarch64MoveWide(register >> int, value >> int, shift >> int,
                keep >> bool) -> int {
                base >> int <- keep ? 0xF2800000 : 0xD2800000;
                return base | (((shift / 16) & 3) << 21) |
                    ((value & 0xFFFF) << 5) | (register & 31);
            }

            encodeAarch64Constant(out >> p<byte>, at >> int, value >> int) -> int {
                at <- putWord(out, at, aarch64MoveWide(0, value, 0, false));
                if (((value >>> 16) & 0xFFFF) != 0)
                    at <- putWord(out, at,
                        aarch64MoveWide(0, value >>> 16, 16, true));
                if (((value >>> 32) & 0xFFFF) != 0)
                    at <- putWord(out, at,
                        aarch64MoveWide(0, value >>> 32, 32, true));
                if (((value >>> 48) & 0xFFFF) != 0)
                    at <- putWord(out, at,
                        aarch64MoveWide(0, value >>> 48, 48, true));
                return at;
            }

            armMoveWide(register >> int, value >> int, top >> bool) -> int {
                base >> int <- top ? 0xE3400000 : 0xE3000000;
                return base | ((value & 0xF000) << 4) |
                    ((register & 15) << 12) | (value & 0x0FFF);
            }

            encodeArmv7Constant(out >> p<byte>, at >> int, value >> int) -> int {
                if (value == 0) return putWord(out, at, 0xE3A00000);
                at <- putWord(out, at, armMoveWide(0, value, false));
                if (((value >>> 16) & 0xFFFF) != 0)
                    at <- putWord(out, at, armMoveWide(0, value >>> 16, true));
                return at;
            }

            riscvAddi(rdReg >> int, rsReg >> int, value >> int) -> int {
                return ((value & 0xFFF) << 20) | ((rsReg & 31) << 15) |
                    ((rdReg & 31) << 7) | 0x13;
            }

            riscvLui(rdReg >> int, value >> int) -> int {
                return ((value & 0xFFFFF) << 12) | ((rdReg & 31) << 7) | 0x37;
            }

            encodeRiscvWord(out >> p<byte>, at >> int, value >> int,
                rdReg >> int) -> int {
                if (value >= -2048 && value <= 2047)
                    return putWord(out, at, riscvAddi(rdReg, 0, value));
                low >> int <- value & 0xFFF;
                if (low >= 2048) low -= 4096;
                high >> int <- (value - low) >> 12;
                at <- putWord(out, at, riscvLui(rdReg, high));
                return low == 0 ? at :
                    putWord(out, at, riscvAddi(rdReg, rdReg, low));
            }

            encodeRiscvConstant(out >> p<byte>, at >> int, value >> int,
                wide >> bool) -> int {
                if (!wide || (value >= -2147483648 && value <= 2147483647))
                    return encodeRiscvWord(out, at, value, 10);
                high >> int <- value >> 32;
                low >> int <- value & 0xFFFFFFFF;
                if (low >= 2147483648) low -= 4294967296;
                at <- encodeRiscvWord(out, at, high, 10);
                at <- putWord(out, at, 0x02051513);
                at <- encodeRiscvWord(out, at, low, 5);
                at <- putWord(out, at, 0x02029293);
                at <- putWord(out, at, 0x0202D293);
                return putWord(out, at, 0x00550533);
            }

            encodeWasmConstant(out >> p<byte>, at >> int, value >> int) -> int {
                at <- put1(out, at, 66);
                more >> bool <- true;
                current >> int <- value;
                while (more) {
                    part >> int <- current & 127;
                    next >> int <- current >> 7;
                    sign >> bool <- (part & 64) != 0;
                    more <- !((next == 0 && !sign) || (next == -1 && sign));
                    at <- put1(out, at, part | (more ? 128 : 0));
                    current <- next;
                }
                return at;
            }

            family(target >> int) -> int {
                if (target >= 1 && target <= 3) return FAMILY_X86_64;
                if (target == 4) return FAMILY_I386;
                if (target == 5 || target == 6) return FAMILY_AARCH64;
                if (target == 7) return FAMILY_ARMV7;
                if (target == 8) return FAMILY_RISCV32;
                if (target == 9) return FAMILY_RISCV64;
                if (target == 10) return FAMILY_WASM32;
                return 0;
            }

            familyName(value >> int) -> str {
                if (value == FAMILY_X86_64) return "x86_64";
                if (value == FAMILY_I386) return "i386";
                if (value == FAMILY_AARCH64) return "aarch64";
                if (value == FAMILY_ARMV7) return "armv7";
                if (value == FAMILY_RISCV32) return "riscv32";
                if (value == FAMILY_RISCV64) return "riscv64";
                if (value == FAMILY_WASM32) return "wasm32";
                return "unknown";
            }

            alignment(targetFamily >> int) -> int {
                if (targetFamily == FAMILY_AARCH64 || targetFamily == FAMILY_ARMV7 ||
                    targetFamily == FAMILY_RISCV32 || targetFamily == FAMILY_RISCV64) return 4;
                return 1;
            }

            registerClass(targetFamily >> int) -> int {
                if (targetFamily == FAMILY_X86_64) return REGISTER_GPR64;
                if (targetFamily == FAMILY_I386) return REGISTER_GPR32;
                if (targetFamily == FAMILY_AARCH64) return REGISTER_AARCH64_X;
                if (targetFamily == FAMILY_ARMV7) return REGISTER_ARM_R;
                if (targetFamily == FAMILY_RISCV32) return REGISTER_RISCV32_X;
                if (targetFamily == FAMILY_RISCV64) return REGISTER_RISCV64_X;
                return REGISTER_WASM_STACK;
            }

            emits(opcode >> int) -> bool {
                return opcode != IR_META && opcode != IR_TYPE && opcode != IR_BLOCK;
            }

            pointerShift(width >> int) -> int {
                if (width == 1) return 0;
                if (width == 2) return 1;
                if (width == 4) return 2;
                if (width == 8) return 3;
                return -1;
            }

            encodeX64Intrinsic(out >> p<byte>, at >> int, id >> int,
                width >> int, signedValue >> bool, win64 >> bool) -> int {
                if (intrinsics.nccIntrinsics.isCopy(id)) {
                    if (!win64) return put5(out, at, 72, 137, 209, 243, 164);
                    at <- put2(out, at, 87, 86);
                    at <- put3(out, at, 72, 137, 207);
                    at <- put3(out, at, 72, 137, 214);
                    at <- put3(out, at, 76, 137, 193);
                    at <- put2(out, at, 243, 164);
                    return put2(out, at, 94, 95);
                }
                if (intrinsics.nccIntrinsics.isLayoutSize(id))
                    return put5(out, at, 184, width, 0, 0, 0);
                if (intrinsics.nccIntrinsics.isIdentity(id))
                    return win64 ? put3(out, at, 72, 137, 200) :
                        put3(out, at, 72, 137, 248);
                if (intrinsics.nccIntrinsics.isNull(id)) {
                    at <- win64 ? put3(out, at, 72, 133, 201) :
                        put3(out, at, 72, 133, 255);
                    at <- put3(out, at, 15, 148, 192);
                    return put3(out, at, 15, 182, 192);
                }
                base >> int <- win64 ? 1 : 7;
                if (intrinsics.nccIntrinsics.isRead(id)) {
                    if (width == 1) return put3(out, at, 15,
                        signedValue ? 190 : 182, base);
                    if (width == 2) return put3(out, at, 15,
                        signedValue ? 191 : 183, base);
                    if (width == 4) return put2(out, at, 139, base);
                    if (width == 8) return put3(out, at, 72, 139, base);
                    return at;
                }
                if (intrinsics.nccIntrinsics.isWrite(id)) {
                    if (width == 1) at <- win64 ? put2(out, at, 136, 17) :
                        put3(out, at, 64, 136, 55);
                    else if (width == 2) at <- win64 ? put3(out, at, 102, 137, 17) :
                        put3(out, at, 102, 137, 55);
                    else if (width == 4) at <- win64 ? put2(out, at, 137, 17) :
                        put2(out, at, 137, 55);
                    else if (width == 8) at <- win64 ? put3(out, at, 72, 137, 17) :
                        put3(out, at, 72, 137, 55);
                    else return at;
                    return put5(out, at, 184, 1, 0, 0, 0);
                }
                shift >> int <- pointerShift(width);
                guard shift >= 0 else return at;
                if (intrinsics.nccIntrinsics.isOffset(id)) {
                    sib >> int <- win64 ? 17 + shift * 64 : 55 + shift * 64;
                    return put4(out, at, 72, 141, 4, sib);
                }
                if (intrinsics.nccIntrinsics.isDiff(id)) {
                    at <- win64 ? put3(out, at, 72, 137, 200) :
                        put3(out, at, 72, 137, 248);
                    at <- win64 ? put3(out, at, 72, 41, 208) :
                        put3(out, at, 72, 41, 240);
                    if (shift == 0) return at;
                    if (shift == 1) return put3(out, at, 72, 209, 248);
                    return put4(out, at, 72, 193, 248, shift);
                }
                return at;
            }

            encodeI386Intrinsic(out >> p<byte>, at >> int, id >> int,
                width >> int, signedValue >> bool) -> int {
                if (intrinsics.nccIntrinsics.isCopy(id)) {
                    at <- put2(out, at, 87, 86);
                    at <- put4(out, at, 139, 124, 36, 12);
                    at <- put4(out, at, 139, 116, 36, 16);
                    at <- put4(out, at, 139, 76, 36, 20);
                    at <- put2(out, at, 243, 164);
                    return put2(out, at, 94, 95);
                }
                if (intrinsics.nccIntrinsics.isLayoutSize(id))
                    return put5(out, at, 184, width, 0, 0, 0);
                if (intrinsics.nccIntrinsics.isIdentity(id))
                    return put4(out, at, 139, 68, 36, 4);
                if (intrinsics.nccIntrinsics.isNull(id)) {
                    at <- put4(out, at, 139, 68, 36, 4);
                    at <- put2(out, at, 133, 192);
                    at <- put3(out, at, 15, 148, 192);
                    return put3(out, at, 15, 182, 192);
                }
                if (intrinsics.nccIntrinsics.isRead(id)) {
                    at <- put4(out, at, 139, 68, 36, 4);
                    if (width == 1) return put3(out, at, 15,
                        signedValue ? 190 : 182, 0);
                    if (width == 2) return put3(out, at, 15,
                        signedValue ? 191 : 183, 0);
                    if (width == 4) return put2(out, at, 139, 0);
                    if (width == 8) {
                        at <- put3(out, at, 139, 80, 4);
                        return put2(out, at, 139, 0);
                    }
                    return at;
                }
                if (intrinsics.nccIntrinsics.isWrite(id)) {
                    at <- put4(out, at, 139, 68, 36, 4);
                    at <- put4(out, at, 139, 84, 36, 8);
                    if (width == 1) at <- put2(out, at, 136, 16);
                    else if (width == 2) at <- put3(out, at, 102, 137, 16);
                    else if (width == 4) at <- put2(out, at, 137, 16);
                    else if (width == 8) {
                        at <- put2(out, at, 137, 16);
                        at <- put4(out, at, 139, 84, 36, 12);
                        at <- put3(out, at, 137, 80, 4);
                    } else return at;
                    return put5(out, at, 184, 1, 0, 0, 0);
                }
                shift >> int <- pointerShift(width);
                guard shift >= 0 else return at;
                at <- put4(out, at, 139, 68, 36, 4);
                at <- put4(out, at, 139, 84, 36, 8);
                if (intrinsics.nccIntrinsics.isOffset(id))
                    return put3(out, at, 141, 4, 16 + shift * 64);
                if (intrinsics.nccIntrinsics.isDiff(id)) {
                    at <- put2(out, at, 41, 208);
                    if (shift == 0) return at;
                    if (shift == 1) return put2(out, at, 209, 248);
                    return put3(out, at, 193, 248, shift);
                }
                return at;
            }

            encodeAarch64Intrinsic(out >> p<byte>, at >> int, id >> int,
                width >> int, signedValue >> bool) -> int {
                if (intrinsics.nccIntrinsics.isCopy(id)) {
                    at <- put4(out, at, 162, 0, 0, 180);
                    at <- put4(out, at, 35, 20, 64, 56);
                    at <- put4(out, at, 3, 20, 0, 56);
                    at <- put4(out, at, 66, 4, 0, 241);
                    return put4(out, at, 161, 255, 255, 84);
                }
                if (intrinsics.nccIntrinsics.isLayoutSize(id))
                    return put4(out, at, (width * 32) % 256, width / 8, 128, 82);
                if (intrinsics.nccIntrinsics.isIdentity(id))
                    return put4(out, at, 224, 3, 0, 170);
                if (intrinsics.nccIntrinsics.isNull(id)) {
                    at <- put4(out, at, 31, 0, 0, 241);
                    return put4(out, at, 224, 23, 159, 26);
                }
                if (intrinsics.nccIntrinsics.isRead(id)) {
                    if (width == 1) return put4(out, at, 0, 0,
                        signedValue ? 192 : 64, 57);
                    if (width == 2) return put4(out, at, 0, 0,
                        signedValue ? 192 : 64, 121);
                    if (width == 4) return put4(out, at, 0, 0, 64, 185);
                    if (width == 8) return put4(out, at, 0, 0, 64, 249);
                    return at;
                }
                if (intrinsics.nccIntrinsics.isWrite(id)) {
                    if (width == 1) at <- put4(out, at, 1, 0, 0, 57);
                    else if (width == 2) at <- put4(out, at, 1, 0, 0, 121);
                    else if (width == 4) at <- put4(out, at, 1, 0, 0, 185);
                    else if (width == 8) at <- put4(out, at, 1, 0, 0, 249);
                    else return at;
                    return put4(out, at, 32, 0, 128, 82);
                }
                shift >> int <- pointerShift(width);
                guard shift >= 0 else return at;
                if (intrinsics.nccIntrinsics.isOffset(id))
                    return put4(out, at, 0, shift * 4, 1, 139);
                if (intrinsics.nccIntrinsics.isDiff(id)) {
                    at <- put4(out, at, 0, 0, 1, 203);
                    if (shift == 0) return at;
                    return put4(out, at, 0, 252, 64 + shift, 147);
                }
                return at;
            }

            encodeArmv7Intrinsic(out >> p<byte>, at >> int, id >> int,
                width >> int, signedValue >> bool) -> int {
                if (intrinsics.nccIntrinsics.isCopy(id)) {
                    at <- put4(out, at, 0, 0, 82, 227);
                    at <- put4(out, at, 3, 0, 0, 10);
                    at <- put4(out, at, 1, 48, 209, 228);
                    at <- put4(out, at, 1, 48, 192, 228);
                    at <- put4(out, at, 1, 32, 82, 226);
                    return put4(out, at, 251, 255, 255, 26);
                }
                if (intrinsics.nccIntrinsics.isLayoutSize(id))
                    return put4(out, at, width, 0, 160, 227);
                if (intrinsics.nccIntrinsics.isIdentity(id))
                    return put4(out, at, 0, 0, 160, 225);
                if (intrinsics.nccIntrinsics.isNull(id)) {
                    at <- put4(out, at, 0, 0, 80, 227);
                    at <- put4(out, at, 1, 0, 160, 3);
                    return put4(out, at, 0, 0, 160, 19);
                }
                if (intrinsics.nccIntrinsics.isRead(id)) {
                    if (width == 1) return signedValue ?
                        put4(out, at, 208, 0, 208, 225) :
                        put4(out, at, 0, 0, 208, 229);
                    if (width == 2) return signedValue ?
                        put4(out, at, 240, 0, 208, 225) :
                        put4(out, at, 176, 0, 208, 225);
                    if (width == 4) return put4(out, at, 0, 0, 144, 229);
                    if (width == 8) {
                        at <- put4(out, at, 208, 32, 192, 225);
                        at <- put4(out, at, 2, 0, 160, 225);
                        return put4(out, at, 3, 16, 160, 225);
                    }
                    return at;
                }
                if (intrinsics.nccIntrinsics.isWrite(id)) {
                    if (width == 1) at <- put4(out, at, 0, 16, 192, 229);
                    else if (width == 2) at <- put4(out, at, 176, 16, 192, 225);
                    else if (width == 4) at <- put4(out, at, 0, 16, 128, 229);
                    else if (width == 8) at <- put4(out, at, 240, 32, 192, 225);
                    else return at;
                    return put4(out, at, 1, 0, 160, 227);
                }
                shift >> int <- pointerShift(width);
                guard shift >= 0 else return at;
                if (intrinsics.nccIntrinsics.isOffset(id))
                    return put4(out, at, (1 + shift * 128) % 256, shift / 2,
                        128, 224);
                if (intrinsics.nccIntrinsics.isDiff(id)) {
                    at <- put4(out, at, 1, 0, 64, 224);
                    if (shift == 0) return at;
                    return put4(out, at, 64 + (shift % 2) * 128, shift / 2,
                        160, 225);
                }
                return at;
            }

            encodeRiscvIntrinsic(out >> p<byte>, at >> int, id >> int,
                width >> int, signedValue >> bool, wide >> bool) -> int {
                if (intrinsics.nccIntrinsics.isCopy(id)) {
                    at <- put4(out, at, 99, 14, 6, 0);
                    at <- put4(out, at, 131, 194, 5, 0);
                    at <- put4(out, at, 35, 0, 85, 0);
                    at <- put4(out, at, 147, 133, 21, 0);
                    at <- put4(out, at, 19, 5, 21, 0);
                    at <- put4(out, at, 19, 6, 246, 255);
                    return put4(out, at, 227, 22, 6, 254);
                }
                if (intrinsics.nccIntrinsics.isLayoutSize(id))
                    return put4(out, at, 19, 5, width * 16, 0);
                if (intrinsics.nccIntrinsics.isIdentity(id))
                    return put4(out, at, 19, 5, 5, 0);
                if (intrinsics.nccIntrinsics.isNull(id))
                    return put4(out, at, 19, 53, 21, 0);
                if (intrinsics.nccIntrinsics.isRead(id)) {
                    if (width == 1) return put4(out, at, 3,
                        signedValue ? 5 : 69, 5, 0);
                    if (width == 2) return put4(out, at, 3,
                        signedValue ? 21 : 85, 5, 0);
                    if (width == 4) return put4(out, at, 3, 37, 5, 0);
                    if (width == 8 && wide) return put4(out, at, 3, 53, 5, 0);
                    return at;
                }
                if (intrinsics.nccIntrinsics.isWrite(id)) {
                    if (width == 1) at <- put4(out, at, 35, 0, 181, 0);
                    else if (width == 2) at <- put4(out, at, 35, 16, 181, 0);
                    else if (width == 4) at <- put4(out, at, 35, 32, 181, 0);
                    else if (width == 8 && wide) at <- put4(out, at, 35, 48, 181, 0);
                    else return at;
                    return put4(out, at, 19, 5, 16, 0);
                }
                shift >> int <- pointerShift(width);
                guard shift >= 0 else return at;
                if (intrinsics.nccIntrinsics.isOffset(id)) {
                    if (shift > 0) at <- put4(out, at, 147, 149,
                        5 + shift * 16, 0);
                    return put4(out, at, 51, 5, 181, 0);
                }
                if (intrinsics.nccIntrinsics.isDiff(id)) {
                    at <- put4(out, at, 51, 5, 181, 64);
                    if (shift == 0) return at;
                    return put4(out, at, 19, 85, 5 + shift * 16, 64);
                }
                return at;
            }

            encodeWasmIntrinsic(out >> p<byte>, at >> int, id >> int,
                width >> int, signedValue >> bool) -> int {
                if (intrinsics.nccIntrinsics.isCopy(id)) {
                    at <- put6(out, at, 32, 0, 32, 1, 32, 2);
                    return put4(out, at, 252, 10, 0, 0);
                }
                if (intrinsics.nccIntrinsics.isLayoutSize(id))
                    return put2(out, at, 65, width);
                if (intrinsics.nccIntrinsics.isIdentity(id))
                    return put2(out, at, 32, 0);
                if (intrinsics.nccIntrinsics.isNull(id)) {
                    at <- put2(out, at, 32, 0);
                    return put1(out, at, 69);
                }
                if (intrinsics.nccIntrinsics.isRead(id)) {
                    at <- put2(out, at, 32, 0);
                    operation >> int <- width == 1 ? (signedValue ? 44 : 45) :
                        (width == 2 ? (signedValue ? 46 : 47) :
                        (width == 4 ? 40 : 41));
                    at <- put1(out, at, operation);
                    return put2(out, at, 0, 0);
                }
                if (intrinsics.nccIntrinsics.isWrite(id)) {
                    at <- put2(out, at, 32, 0);
                    at <- put2(out, at, 32, 1);
                    operation >> int <- width == 1 ? 58 :
                        (width == 2 ? 59 : (width == 4 ? 54 : 55));
                    at <- put1(out, at, operation);
                    at <- put2(out, at, 0, 0);
                    return put2(out, at, 65, 1);
                }
                guard width == 1 || width == 2 || width == 4 || width == 8 else return at;
                at <- put2(out, at, 32, 0);
                at <- put2(out, at, 32, 1);
                if (intrinsics.nccIntrinsics.isOffset(id)) {
                    if (width > 1) {
                        at <- put2(out, at, 65, width);
                        at <- put1(out, at, 108);
                    }
                    return put1(out, at, 106);
                }
                if (intrinsics.nccIntrinsics.isDiff(id)) {
                    at <- put1(out, at, 107);
                    if (width == 1) return at;
                    at <- put2(out, at, 65, width);
                    return put1(out, at, 109);
                }
                return at;
            }

            encodeIntrinsic(out >> p<byte>, at >> int, targetFamily >> int,
                targetAbi >> int, id >> int, width >> int, signedValue >> bool) -> int {
                if (intrinsics.nccIntrinsics.isLayoutQuery(id)) {
                    if (targetFamily == FAMILY_X86_64) return encodeX64Constant(out,at,width);
                    if (targetFamily == FAMILY_I386) return encodeI386Constant(out,at,width);
                    if (targetFamily == FAMILY_AARCH64) return encodeAarch64Constant(out,at,width);
                    if (targetFamily == FAMILY_ARMV7) return encodeArmv7Constant(out,at,width);
                    if (targetFamily == FAMILY_RISCV32 || targetFamily == FAMILY_RISCV64)
                        return encodeRiscvConstant(out,at,width,targetFamily == FAMILY_RISCV64);
                    return encodeWasmConstant(out,at,width);
                }
                if (targetFamily == FAMILY_X86_64)
                    return encodeX64Intrinsic(out, at, id, width, signedValue,
                        targetAbi == ABI_WIN64);
                if (targetFamily == FAMILY_I386)
                    return encodeI386Intrinsic(out, at, id, width, signedValue);
                if (targetFamily == FAMILY_AARCH64)
                    return encodeAarch64Intrinsic(out, at, id, width, signedValue);
                if (targetFamily == FAMILY_ARMV7)
                    return encodeArmv7Intrinsic(out, at, id, width, signedValue);
                if (targetFamily == FAMILY_RISCV32)
                    return encodeRiscvIntrinsic(out, at, id, width, signedValue, false);
                if (targetFamily == FAMILY_RISCV64)
                    return encodeRiscvIntrinsic(out, at, id, width, signedValue, true);
                return encodeWasmIntrinsic(out, at, id, width, signedValue);
            }

            encodeLayout(out >> p<byte>, at >> int, family >> int, value >> u64) -> int {
                low >> int <- value;
                if (family == FAMILY_X86_64) {
                    at <- put2(out,at,0x48,0xB8);
                    piece >> int <- 0;
                    while (piece < 8) {
                        shifted >> u64 <- value >> (piece*8);
                        byteValue >> int <- shifted; at <- put1(out,at,byteValue); piece += 1;
                    }
                    return at;
                }
                if (family == FAMILY_I386) return encodeI386Constant(out,at,low);
                if (family == FAMILY_ARMV7) return encodeArmv7Constant(out,at,low);
                if (family == FAMILY_AARCH64) {
                    part >> int <- low & 65535;
                    at <- putWord(out,at,aarch64MoveWide(0,part,0,false));
                    shift >> int <- 16;
                    while (shift < 64) {
                        shifted >> u64 <- value >> shift; part <- shifted & 65535;
                        if (part != 0) at <- putWord(out,at,aarch64MoveWide(0,part,shift,true));
                        shift += 16;
                    }
                    return at;
                }
                if (family == FAMILY_RISCV32) return encodeRiscvWord(out,at,low,10);
                if (family == FAMILY_RISCV64) {
                    shifted >> u64 <- value >> 55; chunk >> int <- shifted;
                    at <- putWord(out,at,riscvAddi(10,0,chunk));
                    shift >> int <- 44;
                    while (shift >= 0) {
                        at <- putWord(out,at,0x00B51513);
                        shifted <- value >> shift; chunk <- shifted & 2047;
                        if (chunk != 0) at <- putWord(out,at,riscvAddi(10,10,chunk));
                        shift -= 11;
                    }
                    return at;
                }
                return encodeWasmConstant(out,at,low);
            }

            encodeX64(out >> p<byte>, at >> int, opcode >> int,
                win64 >> bool, constantValue >> int, entryBool >> bool) -> int {
                if (!emits(opcode)) return at;
                if (opcode == IR_FUNCTION) {
                    at <- put4(out, at, 85, 72, 137, 229);
                    return win64 ? put4(out, at, 72, 131, 236, 32) :
                        put4(out, at, 72, 131, 236, 16);
                }
                if (opcode == IR_DECLARE) return put4(out, at, 72, 131, 236, 8);
                if (opcode == IR_CONSTANT)
                    return encodeX64Constant(out, at, constantValue);
                if (opcode == IR_LOAD) return put4(out, at, 72, 139, 4, 36);
                if (opcode == IR_COMPUTE) return put3(out, at, 131, 192, 1);
                if (opcode == IR_CALL) return put5(out, at, 232, 0, 0, 0, 0);
                if (opcode == IR_ENTRY) {
                    at <- put4(out, at, 85, 72, 137, 229);
                    at <- put4(out, at, 72, 131, 236, win64 ? 32 : 16);
                    at <- put5(out, at, 232, 0, 0, 0, 0);
                    if (entryBool) {
                        at <- put2(out, at, 133, 192);
                        at <- put3(out, at, 15, 148, 192);
                        at <- put3(out, at, 15, 182, 192);
                    }
                    return put2(out, at, 201, 195);
                }
                if (opcode == IR_STORE) return put4(out, at, 72, 137, 4, 36);
                if (opcode == IR_RETURN) return put2(out, at, 201, 195);
                if (opcode == IR_BRANCH) return put6(out, at, 15, 133, 0, 0, 0, 0);
                if (opcode == IR_JUMP) return put5(out, at, 233, 0, 0, 0, 0);
                if (opcode == IR_DEFER || opcode == IR_ABI) return put1(out, at, 144);
                if (opcode == IR_CLOSURE) return put7(out, at, 72, 141, 5, 0, 0, 0, 0);
                if (opcode == IR_COROUTINE) return put2(out, at, 243, 144);
                if (opcode == IR_PATTERN) return put2(out, at, 133, 192);
                return put1(out, at, 144);
            }

            encodeI386(out >> p<byte>, at >> int, opcode >> int,
                constantValue >> int, entryBool >> bool) -> int {
                if (!emits(opcode)) return at;
                if (opcode == IR_FUNCTION) {
                    at <- put3(out, at, 85, 137, 229);
                    return put3(out, at, 131, 236, 4);
                }
                if (opcode == IR_DECLARE) return put3(out, at, 131, 236, 4);
                if (opcode == IR_CONSTANT)
                    return encodeI386Constant(out, at, constantValue);
                if (opcode == IR_LOAD) return put3(out, at, 139, 4, 36);
                if (opcode == IR_COMPUTE) return put3(out, at, 131, 192, 1);
                if (opcode == IR_CALL) return put5(out, at, 232, 0, 0, 0, 0);
                if (opcode == IR_ENTRY) {
                    at <- put3(out, at, 85, 137, 229);
                    at <- put3(out, at, 131, 236, 4);
                    at <- put5(out, at, 232, 0, 0, 0, 0);
                    if (entryBool) {
                        at <- put2(out, at, 133, 192);
                        at <- put3(out, at, 15, 148, 192);
                        at <- put3(out, at, 15, 182, 192);
                    }
                    return put2(out, at, 201, 195);
                }
                if (opcode == IR_STORE) return put3(out, at, 137, 4, 36);
                if (opcode == IR_RETURN) return put2(out, at, 201, 195);
                if (opcode == IR_BRANCH) return put6(out, at, 15, 133, 0, 0, 0, 0);
                if (opcode == IR_JUMP) return put5(out, at, 233, 0, 0, 0, 0);
                if (opcode == IR_DEFER || opcode == IR_ABI) return put1(out, at, 144);
                if (opcode == IR_CLOSURE) return put5(out, at, 184, 0, 0, 0, 0);
                if (opcode == IR_COROUTINE) return put2(out, at, 243, 144);
                if (opcode == IR_PATTERN) return put2(out, at, 133, 192);
                return put1(out, at, 144);
            }

            encodeAarch64(out >> p<byte>, at >> int, opcode >> int,
                constantValue >> int, entryBool >> bool) -> int {
                if (!emits(opcode)) return at;
                if (opcode == IR_FUNCTION) return put8(out, at, 253, 123, 191, 169, 253, 3, 0, 145);
                if (opcode == IR_DECLARE) return put4(out, at, 255, 67, 0, 209);
                if (opcode == IR_CONSTANT)
                    return encodeAarch64Constant(out, at, constantValue);
                if (opcode == IR_LOAD) return put4(out, at, 224, 3, 64, 249);
                if (opcode == IR_COMPUTE) return put4(out, at, 0, 4, 0, 17);
                if (opcode == IR_CALL) return put4(out, at, 0, 0, 0, 148);
                if (opcode == IR_ENTRY) {
                    at <- put8(out, at, 253, 123, 191, 169, 253, 3, 0, 145);
                    at <- put4(out, at, 0, 0, 0, 148);
                    if (entryBool) {
                        at <- putWord(out, at, 0x7100001F);
                        at <- putWord(out, at, 0x1A9F17E0);
                    }
                    return put8(out, at, 253, 123, 193, 168, 192, 3, 95, 214);
                }
                if (opcode == IR_STORE) return put4(out, at, 224, 3, 0, 249);
                if (opcode == IR_RETURN) return put8(out, at, 253, 123, 193, 168, 192, 3, 95, 214);
                if (opcode == IR_BRANCH) return put4(out, at, 1, 0, 0, 84);
                if (opcode == IR_JUMP) return put4(out, at, 0, 0, 0, 20);
                if (opcode == IR_DEFER || opcode == IR_ABI) return put4(out, at, 31, 32, 3, 213);
                if (opcode == IR_CLOSURE) return put4(out, at, 0, 0, 0, 16);
                if (opcode == IR_COROUTINE) return put4(out, at, 63, 32, 3, 213);
                if (opcode == IR_PATTERN) return put4(out, at, 31, 0, 0, 113);
                return put4(out, at, 31, 32, 3, 213);
            }

            encodeArmv7(out >> p<byte>, at >> int, opcode >> int,
                constantValue >> int, entryBool >> bool) -> int {
                if (!emits(opcode)) return at;
                if (opcode == IR_FUNCTION) return put8(out, at, 0, 72, 45, 233, 0, 176, 141, 226);
                if (opcode == IR_DECLARE) return put4(out, at, 8, 208, 77, 226);
                if (opcode == IR_CONSTANT)
                    return encodeArmv7Constant(out, at, constantValue);
                if (opcode == IR_LOAD) return put4(out, at, 0, 0, 157, 229);
                if (opcode == IR_COMPUTE) return put4(out, at, 1, 0, 128, 226);
                if (opcode == IR_CALL) return put4(out, at, 0, 0, 0, 235);
                if (opcode == IR_ENTRY) {
                    at <- put8(out, at, 0, 72, 45, 233, 0, 176, 141, 226);
                    at <- put4(out, at, 0, 0, 0, 235);
                    if (entryBool) {
                        at <- putWord(out, at, 0xE3500000);
                        at <- putWord(out, at, 0x03A00001);
                        at <- putWord(out, at, 0x13A00000);
                    }
                    return put4(out, at, 0, 136, 189, 232);
                }
                if (opcode == IR_STORE) return put4(out, at, 0, 0, 141, 229);
                if (opcode == IR_RETURN) return put4(out, at, 0, 136, 189, 232);
                if (opcode == IR_BRANCH) return put4(out, at, 0, 0, 0, 26);
                if (opcode == IR_JUMP) return put4(out, at, 0, 0, 0, 234);
                if (opcode == IR_DEFER || opcode == IR_ABI) return put4(out, at, 0, 240, 32, 227);
                if (opcode == IR_CLOSURE) return put4(out, at, 8, 0, 79, 226);
                if (opcode == IR_COROUTINE) return put4(out, at, 1, 240, 32, 227);
                if (opcode == IR_PATTERN) return put4(out, at, 0, 0, 80, 227);
                return put4(out, at, 0, 240, 32, 227);
            }

            encodeRiscv(out >> p<byte>, at >> int, opcode >> int, wide >> bool,
                constantValue >> int, entryBool >> bool) -> int {
                if (!emits(opcode)) return at;
                if (opcode == IR_FUNCTION) {
                    at <- put4(out, at, 19, 1, 1, 255);
                    return wide ? put4(out, at, 35, 52, 17, 0) : put4(out, at, 35, 38, 17, 0);
                }
                if (opcode == IR_DECLARE) return put4(out, at, 19, 1, 1, 255);
                if (opcode == IR_CONSTANT)
                    return encodeRiscvConstant(out, at, constantValue, wide);
                if (opcode == IR_LOAD) return wide ? put4(out, at, 3, 53, 1, 0) : put4(out, at, 3, 37, 1, 0);
                if (opcode == IR_COMPUTE) return put4(out, at, 19, 5, 21, 0);
                if (opcode == IR_CALL) return put8(out, at, 151, 0, 0, 0, 231, 128, 0, 0);
                if (opcode == IR_ENTRY) {
                    at <- put4(out, at, 19, 1, 1, 255);
                    at <- wide ? put4(out, at, 35, 52, 17, 0) :
                        put4(out, at, 35, 38, 17, 0);
                    at <- put8(out, at, 151, 0, 0, 0, 231, 128, 0, 0);
                    if (entryBool) at <- putWord(out, at, 0x00153513);
                    at <- wide ? put4(out, at, 131, 48, 129, 0) :
                        put4(out, at, 131, 32, 193, 0);
                    at <- put4(out, at, 19, 1, 1, 1);
                    return put4(out, at, 103, 128, 0, 0);
                }
                if (opcode == IR_STORE) return wide ? put4(out, at, 35, 48, 161, 0) : put4(out, at, 35, 32, 161, 0);
                if (opcode == IR_RETURN) {
                    at <- wide ? put4(out, at, 131, 48, 129, 0) : put4(out, at, 131, 32, 193, 0);
                    at <- put4(out, at, 19, 1, 1, 1);
                    return put4(out, at, 103, 128, 0, 0);
                }
                if (opcode == IR_BRANCH) return put4(out, at, 99, 16, 5, 0);
                if (opcode == IR_JUMP) return put4(out, at, 111, 0, 0, 0);
                if (opcode == IR_DEFER || opcode == IR_ABI) return put4(out, at, 19, 0, 0, 0);
                if (opcode == IR_CLOSURE) return put4(out, at, 23, 5, 0, 0);
                if (opcode == IR_COROUTINE) return put4(out, at, 15, 0, 240, 15);
                if (opcode == IR_PATTERN) return put4(out, at, 51, 53, 160, 0);
                return put4(out, at, 19, 0, 0, 0);
            }

            encodeWasm(out >> p<byte>, at >> int, opcode >> int,
                constantValue >> int) -> int {
                if (!emits(opcode)) return at;
                if (opcode == IR_FUNCTION || opcode == IR_DECLARE || opcode == IR_DEFER ||
                    opcode == IR_ABI || opcode == IR_COROUTINE) return put1(out, at, 1);
                if (opcode == IR_CONSTANT)
                    return encodeWasmConstant(out, at, constantValue);
                if (opcode == IR_LOAD) return put3(out, at, 40, 0, 0);
                if (opcode == IR_COMPUTE) return put3(out, at, 65, 1, 106);
                if (opcode == IR_CALL || opcode == IR_ENTRY)
                    return put6(out, at, 16, 128, 128, 128, 128, 0);
                if (opcode == IR_STORE) return put3(out, at, 54, 0, 0);
                if (opcode == IR_RETURN) return put1(out, at, 15);
                if (opcode == IR_BRANCH) return put6(out, at, 13, 128, 128, 128, 128, 0);
                if (opcode == IR_JUMP) return put6(out, at, 12, 128, 128, 128, 128, 0);
                if (opcode == IR_CLOSURE) return put6(out, at, 210, 128, 128, 128, 128, 0);
                if (opcode == IR_PATTERN) return put1(out, at, 69);
                return put1(out, at, 1);
            }

            strengthShift(role >> int, base >> int) -> int {
                shift >> int <- role - base;
                return shift > 0 && shift < 32 ? shift : -1;
            }

            encodeStrength(out >> p<byte>, at >> int, targetFamily >> int,
                role >> int) -> int {
                left >> bool <- role > ROLE_STRENGTH_SHL_BASE &&
                    role < ROLE_STRENGTH_SHL_BASE + 32;
                shift >> int <- strengthShift(role, left ?
                    ROLE_STRENGTH_SHL_BASE : ROLE_STRENGTH_SHR_U_BASE);
                guard shift > 0 else return at;
                if (targetFamily == FAMILY_X86_64 || targetFamily == FAMILY_I386)
                    return put3(out, at, 193, left ? 224 : 232, shift);
                if (targetFamily == FAMILY_AARCH64) {
                    if (left) return put4(out, at, 0, ((31 - shift) * 4) % 256,
                        32 - shift, 83);
                    return put4(out, at, 0, 124, shift, 83);
                }
                if (targetFamily == FAMILY_ARMV7) {
                    low >> int <- (shift % 2) * 128 + (left ? 0 : 32);
                    return put4(out, at, low, shift / 2, 160, 225);
                }
                if (targetFamily == FAMILY_RISCV32 ||
                    targetFamily == FAMILY_RISCV64)
                    return put4(out, at, 19, left ? 21 : 85,
                        5 + (shift % 16) * 16, shift / 16);
                return put3(out, at, 65, shift, left ? 116 : 118);
            }

            encode(out >> p<byte>, at >> int, targetFamily >> int, targetAbi >> int,
                opcode >> int, role >> int, intrinsic >> int, width >> int,
                signedValue >> bool, constantValue >> int, entryBool >> bool) -> int {
                if (opcode == IR_INTRINSIC)
                    return encodeIntrinsic(out, at, targetFamily, targetAbi,
                        intrinsic, width, signedValue);
                if (opcode == IR_COMPUTE &&
                    ((role > ROLE_STRENGTH_SHL_BASE &&
                    role < ROLE_STRENGTH_SHL_BASE + 32) ||
                    (role > ROLE_STRENGTH_SHR_U_BASE &&
                    role < ROLE_STRENGTH_SHR_U_BASE + 32)))
                    return encodeStrength(out, at, targetFamily, role);
                if (targetFamily == FAMILY_X86_64)
                    return encodeX64(out, at, opcode, targetAbi == ABI_WIN64,
                        constantValue, entryBool);
                if (targetFamily == FAMILY_I386)
                    return encodeI386(out, at, opcode, constantValue, entryBool);
                if (targetFamily == FAMILY_AARCH64)
                    return encodeAarch64(out, at, opcode, constantValue, entryBool);
                if (targetFamily == FAMILY_ARMV7)
                    return encodeArmv7(out, at, opcode, constantValue, entryBool);
                if (targetFamily == FAMILY_RISCV32)
                    return encodeRiscv(out, at, opcode, false, constantValue, entryBool);
                if (targetFamily == FAMILY_RISCV64)
                    return encodeRiscv(out, at, opcode, true, constantValue, entryBool);
                return encodeWasm(out, at, opcode, constantValue);
            }

            relocation(targetFamily >> int, opcode >> int) -> int {
                call >> bool <- opcode == IR_CALL || opcode == IR_ENTRY;
                if (targetFamily == FAMILY_X86_64 || targetFamily == FAMILY_I386) {
                    if (call || opcode == IR_JUMP) return RELOC_X86_PCREL32;
                    if (opcode == IR_BRANCH) return RELOC_X86_BRANCH32;
                    if (opcode == IR_CLOSURE) return RELOC_X86_DATA_PCREL32;
                }
                if (targetFamily == FAMILY_AARCH64) {
                    if (call) return RELOC_AARCH64_CALL26;
                    if (opcode == IR_JUMP) return RELOC_AARCH64_BRANCH26;
                    if (opcode == IR_BRANCH) return RELOC_AARCH64_CONDBR19;
                    if (opcode == IR_CLOSURE) return RELOC_AARCH64_ADR_PREL21;
                }
                if (targetFamily == FAMILY_ARMV7) {
                    if (call) return RELOC_ARM_CALL;
                    if (opcode == IR_JUMP || opcode == IR_BRANCH) return RELOC_ARM_JUMP24;
                    if (opcode == IR_CLOSURE) return RELOC_ARM_REL32;
                }
                if (targetFamily == FAMILY_RISCV32 || targetFamily == FAMILY_RISCV64) {
                    if (call) return RELOC_RISCV_CALL;
                    if (opcode == IR_BRANCH) return RELOC_RISCV_BRANCH;
                    if (opcode == IR_JUMP) return RELOC_RISCV_JAL;
                    if (opcode == IR_CLOSURE) return RELOC_RISCV_PCREL_HI20;
                }
                if (targetFamily == FAMILY_WASM32) {
                    if (call || opcode == IR_CLOSURE) return RELOC_WASM_FUNCTION_INDEX;
                    if (opcode == IR_BRANCH || opcode == IR_JUMP) return RELOC_WASM_LABEL_INDEX;
                }
                return RELOC_NONE;
            }

            relocationOffset(targetFamily >> int, targetAbi >> int,
                opcode >> int, start >> int) -> int {
                if (targetFamily == FAMILY_X86_64 || targetFamily == FAMILY_I386) {
                    if (opcode == IR_BRANCH) return start + 2;
                    if (opcode == IR_CLOSURE && targetFamily == FAMILY_X86_64) return start + 3;
                    if (opcode == IR_ENTRY)
                        return start + (targetFamily == FAMILY_X86_64 ?
                            9 : 7);
                    if (opcode == IR_CALL || opcode == IR_ENTRY || opcode == IR_JUMP ||
                        opcode == IR_CLOSURE) return start + 1;
                }
                if (opcode == IR_ENTRY &&
                    (targetFamily == FAMILY_AARCH64 || targetFamily == FAMILY_ARMV7 ||
                    targetFamily == FAMILY_RISCV32 || targetFamily == FAMILY_RISCV64))
                    return start + 8;
                if (targetFamily == FAMILY_WASM32) return start + 1;
                return start;
            }

            sameGraphIdentity(graph >> p<byte>, left >> int, right >> int) -> bool {
                return bytesEqual(ir.nccIr.graphNodeName(graph, left),
                        ir.nccIr.graphNodeNameBytes(graph, left),
                        ir.nccIr.graphNodeName(graph, right),
                        ir.nccIr.graphNodeNameBytes(graph, right)) &&
                    bytesEqual(ir.nccIr.graphNodeOwner(graph, left),
                        ir.nccIr.graphNodeOwnerBytes(graph, left),
                        ir.nccIr.graphNodeOwner(graph, right),
                        ir.nccIr.graphNodeOwnerBytes(graph, right));
            }

            functionIdentityHash(graph >> p<byte>, index >> int) -> int {
                value >> int <- identityHash(ir.nccIr.graphNodeName(graph, index),
                    ir.nccIr.graphNodeNameBytes(graph, index), 5381);
                ownerBytes >> int <- ir.nccIr.graphNodeOwnerBytes(graph, index);
                if (ownerBytes > 0) value <- identityHash(
                    ir.nccIr.graphNodeOwner(graph, index), ownerBytes, value);
                return value;
            }

            functionTableCapacity(graph >> p<byte>) -> int {
                functions >> int <- 0;
                at >> int <- 0;
                while (at < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeOpcode(graph, at) == IR_FUNCTION &&
                        ir.nccIr.graphNodeNameBytes(graph, at) > 0) functions += 1;
                    at += 1;
                }
                capacity >> int <- 16;
                while (capacity < functions * 2 + 1) { capacity *= 2; }
                return capacity;
            }

            appendEmissionSubtree(graph >> p<byte>, index >> int,
                order >> p<int>, emitted >> int) -> int {
                opcode >> int <- ir.nccIr.graphNodeOpcode(graph, index);
                prefix >> bool <- opcode == IR_FUNCTION || opcode == IR_DECLARE;
                if (prefix) {
                    wr<int>(off(order, emitted), index);
                    emitted += 1;
                }
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, index);
                if (opcode == IR_BRANCH && child >= 0) {
                    emitted <- appendEmissionSubtree(graph, child, order, emitted);
                    wr<int>(off(order, emitted), index);
                    emitted += 1;
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                while (child >= 0) {
                    emitted <- appendEmissionSubtree(graph, child, order, emitted);
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                if (!prefix && opcode != IR_BRANCH) {
                    wr<int>(off(order, emitted), index);
                    emitted += 1;
                }
                return emitted;
            }

            emissionOrder(graph >> p<byte>, count >> int) -> p<int> {
                guard graph != null && count > 0 else return null;
                order >> p<int> <- cast<int>(alloc(count * sizeOf<int>()));
                guard order != null else return null;
                emitted >> int <- 0;
                root >> int <- 0;
                while (root < count) {
                    if (ir.nccIr.graphNodeParent(graph, root) < 0)
                        emitted <- appendEmissionSubtree(graph, root, order, emitted);
                    root += 1;
                }
                if (emitted != count) {
                    free(order);
                    return null;
                }
                return order;
            }

            buildFunctionTable(graph >> p<byte>, capacity >> int) -> p<int> {
                table >> p<int> <- cast<int>(alloc(capacity * sizeOf<int>()));
                guard table != null else return null;
                slot >> int <- 0;
                while (slot < capacity) { wr<int>(off(table, slot), 0); slot += 1; }
                at >> int <- 0;
                while (at < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeOpcode(graph, at) == IR_FUNCTION &&
                        ir.nccIr.graphNodeNameBytes(graph, at) > 0) {
                        slot <- functionIdentityHash(graph, at) % capacity;
                        if (slot < 0) slot += capacity;
                        while (rd<int>(off(table, slot)) != 0) {
                            slot <- (slot + 1) % capacity;
                        }
                        wr<int>(off(table, slot), at + 1);
                    }
                    at += 1;
                }
                return table;
            }

            functionReturnsBool(graph >> p<byte>, function >> int) -> bool {
                guard function >= 0 else return false;
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, function);
                while (child >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, child) == AST_TYPE_NAME &&
                        ir.nccIr.graphTextValue(graph, child, "bool")) return true;
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return false;
            }

            entryReturnsBool(graph >> p<byte>, entry >> int,
                table >> p<int>, capacity >> int) -> bool {
                source >> int <- targetSourceNode(graph, entry, IR_ENTRY);
                return functionReturnsBool(graph,
                    findFunction(graph, source, table, capacity));
            }

            findFunction(graph >> p<byte>, sourceNode >> int,
                table >> p<int>, capacity >> int) -> int {
                guard sourceNode >= 0 && table != null && capacity > 0 &&
                    ir.nccIr.graphNodeNameBytes(graph, sourceNode) > 0 else return -1;
                slot >> int <- functionIdentityHash(graph, sourceNode) % capacity;
                if (slot < 0) slot += capacity;
                probes >> int <- 0;
                while (probes < capacity) {
                    encoded >> int <- rd<int>(off(table, slot));
                    if (encoded == 0) return -1;
                    candidate >> int <- encoded - 1;
                    if (sameGraphIdentity(graph, candidate, sourceNode)) return candidate;
                    slot <- (slot + 1) % capacity;
                    probes += 1;
                }
                return -1;
            }

            entryFunction(graph >> p<byte>, function >> int,
                table >> p<int>, capacity >> int) -> bool {
                guard function >= 0 else return false;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeOpcode(graph, node) == IR_ENTRY) {
                        resolved >> int <- findFunction(graph,
                            targetSourceNode(graph, node, IR_ENTRY), table, capacity);
                        if (resolved == function ||
                            (ir.nccIr.graphNodeRoleHash(graph, node) != 0 &&
                            ir.nccIr.graphNodeNameHash(graph, function) ==
                                ir.nccIr.graphNodeRoleHash(graph, node))) return true;
                    }
                    node += 1;
                }
                return false;
            }

            entryRetainsNode(graph >> p<byte>, node >> int,
                table >> p<int>, capacity >> int) -> bool {
                return ir.nccIr.graphNodeOpcode(graph, node) == IR_FUNCTION &&
                    entryFunction(graph, node, table, capacity);
            }

            afterSubtree(graph >> p<byte>, index >> int) -> int {
                current >> int <- index;
                while (current >= 0) {
                    next >> int <- ir.nccIr.graphNodeNextSibling(graph, current);
                    if (next >= 0) return next;
                    current <- ir.nccIr.graphNodeParent(graph, current);
                }
                return -1;
            }

            enclosingControl(graph >> p<byte>, index >> int) -> int {
                current >> int <- ir.nccIr.graphNodeParent(graph, index);
                while (current >= 0) {
                    operation >> int <- ir.nccIr.graphNodeOpcode(graph, current);
                    if (operation == IR_BRANCH) return current;
                    current <- ir.nccIr.graphNodeParent(graph, current);
                }
                return -1;
            }

            targetSourceNode(graph >> p<byte>, index >> int, opcode >> int) -> int {
                if (opcode == IR_ENTRY) return index;
                if (opcode == IR_CALL) {
                    if (native_body.nccNativeBody.stringConcat(graph,index)) return index;
                    source >> int <- ir.nccIr.graphNodeFirstChild(graph, index);
                    if (source >= 0 &&
                        ir.nccIr.graphNodeAstKind(graph, source) == AST_GENERIC_APPLY)
                        return ir.nccIr.graphNodeFirstChild(graph, source);
                    return source;
                }
                return -1;
            }

            targetIdentityNode(graph >> p<byte>, index >> int, opcode >> int,
                table >> p<int>, capacity >> int) -> int {
                if (opcode == IR_FUNCTION &&
                    (ir.nccIr.graphNodeFlags(graph, index) & FLAG_PROJECT_EXPORT) != 0)
                    return index;
                sourceNode >> int <- targetSourceNode(graph, index, opcode);
                if (opcode == IR_CALL || opcode == IR_ENTRY) {
                    if (native_body.nccNativeBody.stringConcat(graph,index)) return index;
                    functionNode >> int <- findFunction(graph, sourceNode, table, capacity);
                    return functionNode >= 0 ? functionNode : sourceNode;
                }
                return -1;
            }

            destinationValue(graph >> p<byte>, index >> int, opcode >> int) -> int {
                if (opcode == IR_ENTRY) return ir.nccIr.graphNodeRoleHash(graph, index);
                if (opcode == IR_COMPUTE) {
                    role >> int <- ir.nccIr.graphNodeRoleHash(graph, index);
                    if ((role > ROLE_STRENGTH_SHL_BASE &&
                        role < ROLE_STRENGTH_SHL_BASE + 32) ||
                        (role > ROLE_STRENGTH_SHR_U_BASE &&
                        role < ROLE_STRENGTH_SHR_U_BASE + 32)) return role;
                }
                if (opcode == IR_CALL) {
                    sourceNode >> int <- targetSourceNode(graph, index, opcode);
                    return sourceNode >= 0 ? ir.nccIr.graphNodeNameHash(graph, sourceNode) : 0;
                }
                if (opcode == IR_BRANCH) return afterSubtree(graph, index);
                if (opcode == IR_JUMP) return enclosingControl(graph, index);
                if (opcode == IR_CLOSURE) return index;
                return 0;
            }

            destinationKind(graph >> p<byte>, index >> int, opcode >> int,
                value >> int, table >> p<int>, capacity >> int) -> int {
                if (opcode == IR_CALL || opcode == IR_ENTRY) {
                    if (native_body.nccNativeBody.stringConcat(graph,index)) return TARGET_EXTERNAL_SYMBOL;
                    sourceNode >> int <- targetSourceNode(graph, index, opcode);
                    if (sourceNode < 0 || ir.nccIr.graphNodeNameBytes(graph, sourceNode) == 0)
                        return TARGET_UNRESOLVED;
                    return findFunction(graph, sourceNode, table, capacity) >= 0 ?
                        TARGET_LOCAL_SYMBOL : TARGET_EXTERNAL_SYMBOL;
                }
                if (opcode == IR_BRANCH || opcode == IR_JUMP || opcode == IR_CLOSURE)
                    return value >= 0 ? TARGET_CONTROL_NODE : TARGET_UNRESOLVED;
                return TARGET_NONE;
            }

            targetStringBytes(graph >> p<byte>, table >> p<int>, capacity >> int) -> int {
                total >> int <- 0;
                at >> int <- 0;
                while (at < ir.nccIr.graphNodes(graph)) {
                    if (native_body.nccNativeBody.stringConcat(graph,at)) total += 12;
                    opcode >> int <- ir.nccIr.graphNodeOpcode(graph, at);
                    relocationKind >> int <- relocation(family(ir.nccIr.graphTarget(graph)), opcode);
                    functionDefinition >> bool <- opcode == IR_FUNCTION &&
                        ir.nccIr.graphNodeNameBytes(graph, at) > 0;
                    if (relocationKind != RELOC_NONE || functionDefinition) {
                        sourceNode >> int <- targetIdentityNode(
                            graph, at, opcode, table, capacity);
                        if (functionDefinition) sourceNode <- at;
                        if (sourceNode >= 0) {
                            total += ir.nccIr.graphNodeNameBytes(graph, sourceNode);
                            targetSource >> int <- targetSourceNode(graph, at, opcode);
                            if (functionDefinition || ir.nccIr.graphNodeRuntimeIdentity(
                                graph, sourceNode) ||
                                findFunction(graph, targetSource, table, capacity) >= 0 ||
                                ir.nccIr.graphNodeAstKind(graph, sourceNode) == AST_EXPR_MEMBER)
                                total += ir.nccIr.graphNodeOwnerBytes(graph, sourceNode);
                        }
                    }
                    at += 1;
                }
                return total;
            }

            copyBytes(out >> p<byte>, cursor >> int, source >> p<byte>, count >> int) -> int {
                if (count > 0) cp(off(out, cursor), source, count);
                return cursor + count;
            }
            nativeIdentityBytes(graph >> p<byte>, source >> int, opcode >> int,
                table >> p<int>, capacity >> int) -> int {
                if (opcode == IR_CALL && native_body.nccNativeBody.stringConcat(graph,source)) return 12;
                node >> int <- opcode == IR_FUNCTION ? source : targetIdentityNode(graph,source,opcode,table,capacity);
                if (node < 0) return 0;
                bytes >> int <- ir.nccIr.graphNodeNameBytes(graph,node);
                if (opcode == IR_FUNCTION || ir.nccIr.graphNodeRuntimeIdentity(graph,node) ||
                    ir.nccIr.graphNodeAstKind(graph,node) == AST_EXPR_MEMBER ||
                    findFunction(graph,targetSourceNode(graph,source,opcode),table,capacity) >= 0)
                    bytes += ir.nccIr.graphNodeOwnerBytes(graph,node);
                return bytes;
            }

            fillTargetIdentity(graph >> p<byte>, artifact >> p<byte>, index >> int,
                opcode >> int, kind >> int, cursor >> int,
                table >> p<int>, capacity >> int) -> int {
                return fillTargetIdentitySource(graph,artifact,index,index,opcode,kind,cursor,table,capacity);
            }

            fillTargetIdentitySource(graph >> p<byte>, artifact >> p<byte>, index >> int,
                source >> int, opcode >> int, kind >> int, cursor >> int,
                table >> p<int>, capacity >> int) -> int {
                item >> p<byte> <- identity(artifact, index);
                if (opcode == IR_CALL && native_body.nccNativeBody.stringConcat(graph,source)) {
                    putInteger(item,I_NAME_OFFSET,cursor); putInteger(item,I_NAME_BYTES,6);
                    cursor <- copyBytes(strings(artifact),cursor,cast<byte>("concat"),6);
                    putInteger(item,I_OWNER_OFFSET,cursor); putInteger(item,I_OWNER_BYTES,6);
                    cursor <- copyBytes(strings(artifact),cursor,cast<byte>("concat"),6);
                    putInteger(item,I_KIND,EXTERNAL_RUNTIME);
                    putInteger(item,I_HASH_A,identityHash(cast<byte>("concat"),6,5381));
                    putInteger(item,I_HASH_B,identityHash(cast<byte>("concat"),6,
                        identityHash(cast<byte>("concat"),6,65537)));
                    return cursor;
                }
                sourceNode >> int <- targetIdentityNode(
                    graph, source, opcode, table, capacity);
                nameBytes >> int <- sourceNode >= 0 ?
                    ir.nccIr.graphNodeNameBytes(graph, sourceNode) : 0;
                ownerBytes >> int <- 0;
                if (sourceNode >= 0 && (kind == TARGET_LOCAL_SYMBOL ||
                    ir.nccIr.graphNodeRuntimeIdentity(graph, sourceNode) ||
                    ir.nccIr.graphNodeAstKind(graph, sourceNode) == AST_EXPR_MEMBER))
                    ownerBytes <- ir.nccIr.graphNodeOwnerBytes(graph, sourceNode);

                putInteger(item, I_NAME_OFFSET, cursor);
                putInteger(item, I_NAME_BYTES, nameBytes);
                if (nameBytes > 0) cursor <- copyBytes(strings(artifact), cursor,
                    ir.nccIr.graphNodeName(graph, sourceNode), nameBytes);
                putInteger(item, I_OWNER_OFFSET, cursor);
                putInteger(item, I_OWNER_BYTES, ownerBytes);
                if (ownerBytes > 0) cursor <- copyBytes(strings(artifact), cursor,
                    ir.nccIr.graphNodeOwner(graph, sourceNode), ownerBytes);
                putInteger(item, I_VISIBILITY,
                    sourceNode >= 0 ? ir.nccIr.graphNodeVisibility(graph, sourceNode) : 0);
                putInteger(item, I_KIND, kind == TARGET_EXTERNAL_SYMBOL ?
                    externalClass(graph, sourceNode) : 0);
                putInteger(item, I_HASH_A, nameBytes > 0 ? identityHash(
                    ir.nccIr.graphNodeName(graph, sourceNode), nameBytes, 5381) : 0);
                combined >> int <- nameBytes > 0 ? identityHash(
                    ir.nccIr.graphNodeName(graph, sourceNode), nameBytes, 65537) : 0;
                if (ownerBytes > 0) combined <- identityHash(
                    ir.nccIr.graphNodeOwner(graph, sourceNode), ownerBytes, combined);
                putInteger(item, I_HASH_B, combined);
                return cursor;
            }

            checksum(base >> p<byte>, start >> int, count >> int) -> int {
                value >> int <- 0;
                at >> int <- 0;
                while (at < count) {
                    value <- (value + unsignedByte(rd<byte>(off(base, start + at))) * (at + 1)) % 1000003;
                    at += 1;
                }
                return value;
            }

            licmRole(role >> int) -> bool {
                return role > ROLE_LICM_BASE && role < ROLE_LICM_BASE + 128;
            }

            inlineExpressionNode(graph >> p<byte>, index >> int, role >> int) -> int {
                guard ir.nccIr.graphNodeAstKind(graph, index) == AST_EXPR_CALL &&
                    role > ROLE_INLINE_BASE else return -1;
                node >> int <- role - ROLE_INLINE_BASE;
                return node >= 0 && node < ir.nccIr.graphNodes(graph) ? node : -1;
            }

            gvnSourceSlot(role >> int) -> int {
                return role >= ROLE_GVN_SOURCE_BASE &&
                    role < ROLE_GVN_SOURCE_BASE + 2 ?
                    role - ROLE_GVN_SOURCE_BASE : -1;
            }

            gvnReuseSlot(role >> int) -> int {
                return role >= ROLE_GVN_REUSE_BASE &&
                    role < ROLE_GVN_REUSE_BASE + 2 ?
                    role - ROLE_GVN_REUSE_BASE : -1;
            }

            encodeGvnSave(out >> p<byte>, at >> int,
                targetFamily >> int, slot >> int) -> int {
                if (targetFamily == FAMILY_X86_64)
                    return put3(out, at, 73, 137, slot == 0 ? 194 : 195);
                if (targetFamily == FAMILY_I386)
                    return put2(out, at, 137, slot == 0 ? 193 : 194);
                if (targetFamily == FAMILY_AARCH64)
                    return slot == 0 ? put4(out, at, 233, 3, 0, 170) :
                        put4(out, at, 234, 3, 0, 170);
                if (targetFamily == FAMILY_ARMV7)
                    return slot == 0 ? put4(out, at, 0, 16, 160, 225) :
                        put4(out, at, 0, 32, 160, 225);
                if (targetFamily == FAMILY_RISCV32 ||
                    targetFamily == FAMILY_RISCV64)
                    return slot == 0 ? put4(out, at, 147, 2, 5, 0) :
                        put4(out, at, 19, 3, 5, 0);
                return put2(out, at, 34, slot);
            }

            encodeGvnLoad(out >> p<byte>, at >> int,
                targetFamily >> int, slot >> int) -> int {
                if (targetFamily == FAMILY_X86_64)
                    return put3(out, at, 76, 137, slot == 0 ? 208 : 216);
                if (targetFamily == FAMILY_I386)
                    return put2(out, at, 137, slot == 0 ? 200 : 208);
                if (targetFamily == FAMILY_AARCH64)
                    return slot == 0 ? put4(out, at, 224, 3, 9, 170) :
                        put4(out, at, 224, 3, 10, 170);
                if (targetFamily == FAMILY_ARMV7)
                    return slot == 0 ? put4(out, at, 1, 0, 160, 225) :
                        put4(out, at, 2, 0, 160, 225);
                if (targetFamily == FAMILY_RISCV32 ||
                    targetFamily == FAMILY_RISCV64)
                    return slot == 0 ? put4(out, at, 19, 133, 2, 0) :
                        put4(out, at, 19, 5, 3, 0);
                return put2(out, at, 32, slot);
            }

            functionOf(graph >> p<byte>, index >> int) -> int {
                current >> int <- index;
                while (current >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, current) ==
                        AST_FUNCTION_DECL) return current;
                    current <- ir.nccIr.graphNodeParent(graph, current);
                }
                return -1;
            }

            inlineParameterPosition(graph >> p<byte>, function >> int,
                expression >> int) -> int {
                guard function >= 0 && expression >= 0 &&
                    ir.nccIr.graphNodeAstKind(graph, expression) == AST_EXPR_NAME
                    else return -1;
                position >> int <- 0;
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, function);
                while (child >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, child) ==
                        AST_PARAMETER_DECL) {
                        if (ir.nccIr.graphNodeNameEqual(
                            graph, child, expression)) return position;
                        position += 1;
                    }
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return -1;
            }

            inlineCallArgument(graph >> p<byte>, call >> int,
                position >> int) -> int {
                source >> int <- ir.nccIr.graphNodeFirstChild(graph, call);
                guard source >= 0 else return -1;
                argument >> int <- ir.nccIr.graphNodeNextSibling(graph, source);
                at >> int <- 0;
                while (argument >= 0 && at < position) {
                    argument <- ir.nccIr.graphNodeNextSibling(graph, argument);
                    at += 1;
                }
                return argument;
            }

            inlineDescendantOf(graph >> p<byte>, node >> int, root >> int) -> bool {
                current >> int <- node;
                while (current >= 0) {
                    if (current == root) return true;
                    current <- ir.nccIr.graphNodeParent(graph, current);
                }
                return false;
            }

            inlineParameterNode(graph >> p<byte>, function >> int,
                position >> int) -> int {
                at >> int <- 0;
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, function);
                while (child >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, child) ==
                        AST_PARAMETER_DECL) {
                        if (at == position) return child;
                        at += 1;
                    }
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return -1;
            }

            inlineParameterUses(graph >> p<byte>, expression >> int,
                parameter >> int) -> int {
                guard expression >= 0 && parameter >= 0 else return 0;
                uses >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (inlineDescendantOf(graph, node, expression) &&
                        ir.nccIr.graphNodeAstKind(graph, node) == AST_EXPR_NAME &&
                        ir.nccIr.graphNodeNameEqual(graph, node, parameter)) uses += 1;
                    node += 1;
                }
                return uses;
            }

            inlineRematerializableArgument(graph >> p<byte>, root >> int) -> bool {
                guard root >= 0 else return false;
                count >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (inlineDescendantOf(graph, node, root)) {
                        kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                        if (kind != AST_EXPR_LITERAL && kind != AST_EXPR_UNARY)
                            return false;
                        count += 1;
                    }
                    node += 1;
                }
                return count > 0 && count <= 2;
            }

            inlineTemporarySlot(graph >> p<byte>, call >> int,
                targetFunction >> int, expression >> int, position >> int) -> int {
                slot >> int <- 0;
                at >> int <- 0;
                while (at <= position) {
                    parameter >> int <- inlineParameterNode(graph, targetFunction, at);
                    argument >> int <- inlineCallArgument(graph, call, at);
                    temporary >> bool <- inlineParameterUses(
                        graph, expression, parameter) > 1 &&
                        !inlineRematerializableArgument(graph, argument);
                    if (at == position) return temporary ? slot : -1;
                    if (temporary) slot += 1;
                    at += 1;
                }
                return -1;
            }

            encodeInlineTemporarySave(out >> p<byte>, at >> int,
                targetFamily >> int, slot >> int) -> int {
                if (targetFamily == FAMILY_X86_64)
                    return put3(out, at, 73, 137, 192 + slot);
                if (targetFamily == FAMILY_I386)
                    return put2(out, at, 137, slot == 0 ? 193 : 194);
                if (targetFamily == FAMILY_AARCH64)
                    return put4(out, at, 233 + slot, 3, 0, 170);
                if (targetFamily == FAMILY_ARMV7)
                    return put4(out, at, 0, (slot + 1) * 16, 160, 225);
                if (targetFamily == FAMILY_RISCV32 ||
                    targetFamily == FAMILY_RISCV64)
                    return slot == 0 ? put4(out, at, 147, 2, 5, 0) :
                        put4(out, at, 19, 3, 5, 0);
                return put2(out, at, 33, slot);
            }

            encodeInlineTemporaryLoad(out >> p<byte>, at >> int,
                targetFamily >> int, slot >> int) -> int {
                if (targetFamily == FAMILY_X86_64)
                    return put3(out, at, 76, 137, slot == 0 ? 192 : 200);
                if (targetFamily == FAMILY_I386)
                    return put2(out, at, 137, slot == 0 ? 200 : 208);
                if (targetFamily == FAMILY_AARCH64)
                    return put4(out, at, 224, 3, 9 + slot, 170);
                if (targetFamily == FAMILY_ARMV7)
                    return put4(out, at, slot + 1, 0, 160, 225);
                if (targetFamily == FAMILY_RISCV32 ||
                    targetFamily == FAMILY_RISCV64)
                    return slot == 0 ? put4(out, at, 19, 133, 2, 0) :
                        put4(out, at, 19, 5, 3, 0);
                return put2(out, at, 32, slot);
            }

            emitInlineTemporaryArguments(graph >> p<byte>, code >> p<byte>,
                cursor >> int, targetFamily >> int, call >> int,
                targetFunction >> int, expression >> int) -> int {
                position >> int <- 0;
                parameter >> int <- inlineParameterNode(
                    graph, targetFunction, position);
                while (parameter >= 0) {
                    slot >> int <- inlineTemporarySlot(
                        graph, call, targetFunction, expression, position);
                    if (slot >= 0) {
                        argument >> int <- inlineCallArgument(graph, call, position);
                        cursor <- emitInlineExpression(
                            graph, code, cursor, argument, targetFamily,
                            -1, -1, -1);
                        cursor <- encodeInlineTemporarySave(
                            code, cursor, targetFamily, slot);
                    }
                    position += 1;
                    parameter <- inlineParameterNode(
                        graph, targetFunction, position);
                }
                return cursor;
            }

            emitInlineExpression(graph >> p<byte>, code >> p<byte>, cursor >> int,
                root >> int, targetFamily >> int, call >> int,
                targetFunction >> int, expression >> int) -> int {
                parameter >> int <- inlineParameterPosition(
                    graph, targetFunction, root);
                if (parameter >= 0) {
                    slot >> int <- inlineTemporarySlot(
                        graph, call, targetFunction, expression, parameter);
                    if (slot >= 0) return encodeInlineTemporaryLoad(
                        code, cursor, targetFamily, slot);
                    argument >> int <- inlineCallArgument(graph, call, parameter);
                    guard argument >= 0 else return cursor;
                    return emitInlineExpression(
                        graph, code, cursor, argument, targetFamily, -1, -1, -1);
                }
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, root);
                while (child >= 0) {
                    cursor <- emitInlineExpression(
                        graph, code, cursor, child, targetFamily,
                        call, targetFunction, expression);
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                if (ir.nccIr.graphNodeLayoutValid(graph,root))
                    return encodeLayout(code,cursor,targetFamily,ir.nccIr.graphNodeLayoutValue(graph,root));
                return encode(code, cursor, targetFamily, ir.nccIr.graphAbi(graph),
                    ir.nccIr.graphNodeOpcode(graph, root),
                    ir.nccIr.graphNodeRoleHash(graph, root),
                    ir.nccIr.graphNodeIntrinsicId(graph, root),
                    ir.nccIr.graphNodeIntrinsicTypeBytes(graph, root),
                    ir.nccIr.graphNodeIntrinsicTypeSigned(graph, root),
                    ir.nccIr.graphNodeOpcode(graph, root) == IR_CONSTANT ?
                        ir.nccIr.graphNodeIntegerLiteral(graph, root) : 0, false);
            }

            enclosingWhile(graph >> p<byte>, index >> int) -> int {
                current >> int <- ir.nccIr.graphNodeParent(graph, index);
                while (current >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, current) ==
                        AST_STMT_WHILE) return current;
                    current <- ir.nccIr.graphNodeParent(graph, current);
                }
                return -1;
            }

            emitLoopHoists(graph >> p<byte>, artifact >> p<byte>, code >> p<byte>,
                cursor >> int, loopNode >> int, targetFamily >> int) -> int {
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    role >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                    if (licmRole(role) && enclosingWhile(graph, node) == loopNode &&
                        !ir.nccIr.graphNodeOptimizedOut(graph, node)) {
                        start >> int <- cursor;
                        if (ir.nccIr.graphNodeLayoutValid(graph,node))
                            cursor <- encodeLayout(code,cursor,targetFamily,ir.nccIr.graphNodeLayoutValue(graph,node));
                        else cursor <- encode(code, cursor, targetFamily,
                            ir.nccIr.graphAbi(graph),
                            ir.nccIr.graphNodeOpcode(graph, node), role,
                            ir.nccIr.graphNodeIntrinsicId(graph, node),
                            ir.nccIr.graphNodeIntrinsicTypeBytes(graph, node),
                            ir.nccIr.graphNodeIntrinsicTypeSigned(graph, node),
                            ir.nccIr.graphNodeOpcode(graph, node) == IR_CONSTANT ?
                                ir.nccIr.graphNodeIntegerLiteral(graph, node) : 0, false);
                        item >> p<byte> <- record(artifact, node);
                        putInteger(item, R_TEXT_OFFSET, start);
                        putInteger(item, R_BYTE_LENGTH, cursor - start);
                        putInteger(item, R_CHECKSUM,
                            checksum(code, start, cursor - start));
                    }
                    node += 1;
                }
                return cursor;
            }

            textHash(base >> p<byte>, count >> int) -> int {
                value >> int <- 216613;
                at >> int <- 0;
                while (at < count) {
                    weight >> int <- (at % 251) + 1;
                    value <- (value + unsignedByte(rd<byte>(off(base, at))) * weight + at * 17) % 1000000007;
                    at += 1;
                }
                return value;
            }

            fingerprint(artifact >> p<byte>) -> int {
                value >> int <- 524287;
                value <- (value + integer(artifact, H_TARGET) * 17) % 1000000007;
                value <- (value + integer(artifact, H_FAMILY) * 19) % 1000000007;
                value <- (value + integer(artifact, H_POINTER_BITS) * 23) % 1000000007;
                value <- (value + stable(integer(artifact, H_IR_FINGERPRINT)) * 29) % 1000000007;
                value <- (value + stable(integer(artifact, H_TEXT_HASH)) * 31) % 1000000007;
                value <- (value + stable(integer(artifact, H_STORAGE_HASH)) * 41 + integer(artifact,H_BSS_BYTES)*43) % 1000000007;
                value <- (value + integer(artifact, H_RELOCATIONS) * 37) % 1000000007;
                at >> int <- 0;
                while (at < integer(artifact, H_IR_NODES)) {
                    item >> p<byte> <- record(artifact, at);
                    value <- (value + integer(item, R_CHECKSUM) * ((at % 89) + 1)) % 1000000007;
                    value <- (value + integer(item, R_RELOCATION) * ((at % 43) + 3)) % 1000000007;
                    value <- (value + stable(integer(item, R_TARGET_KIND)) * ((at % 37) + 5)) % 1000000007;
                    value <- (value + stable(integer(item, R_TARGET_VALUE)) * ((at % 31) + 7)) % 1000000007;
                    identityItem >> p<byte> <- identity(artifact, at);
                    value <- (value + stable(integer(identityItem, I_HASH_A)) *
                        ((at % 29) + 11)) % 1000000007;
                    value <- (value + stable(integer(identityItem, I_HASH_B)) *
                        ((at % 23) + 13)) % 1000000007;
                    value <- (value + stable(integer(identityItem, I_VISIBILITY)) *
                        ((at % 19) + 17)) % 1000000007;
                    at += 1;
                }
                at <- 0;
                while (at < integer(artifact, H_STRING_BYTES)) {
                    value <- (value + unsignedByte(rd<byte>(off(strings(artifact), at))) *
                        ((at % 251) + 193)) % 1000000007;
                    at += 1;
                }
                return value;
            }

            selectedIntrinsicCount(artifact >> p<byte>) -> int {
                total >> int <- 0;
                at >> int <- 0;
                while (at < integer(artifact, H_IR_NODES)) {
                    if (integer(record(artifact, at), R_IR_OPCODE) == IR_INTRINSIC) total += 1;
                    at += 1;
                }
                return total;
            }

            lowerNativeGraph(graph >> p<byte>) -> p<byte> {
                plan >> p<byte> <- native_body.nccNativeBody.create(graph);
                if (!native_body.nccNativeBody.healthy(plan)) {
                    native_body.nccNativeBody.release(plan); return null;
                }
                planned >> int <- native_body.nccNativeBody.count(plan);
                entries >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeOpcode(graph,node) == IR_ENTRY) entries += 1;
                    node += 1;
                }
                count >> int <- planned+entries;
                functionCapacity >> int <- functionTableCapacity(graph);
                functionTable >> p<int> <- buildFunctionTable(graph,functionCapacity);
                if (functionTable == null) { native_body.nccNativeBody.release(plan); return null; }
                stringBytes >> int <- 0;
                at >> int <- 0;
                while (at < planned) {
                    step >> p<byte> <- native_body.nccNativeBody.record(plan,at);
                    opcode >> int <- rd<int>(off(step,4));
                    named >> int <- rd<int>(off(step,24));
                    if (rd<int>(off(step,16)) >= 0 && named >= 0 &&
                        ir.nccIr.graphNodeAstKind(graph,named) == AST_FUNCTION_DECL &&
                        ir.nccIr.graphNodeOptimizedOut(graph,named)) {
                        free(functionTable); native_body.nccNativeBody.release(plan); return null;
                    }
                    if (opcode == IR_DECLARE && rd<int>(off(step,28)) != SECTION_RODATA)
                        named <- rd<int>(step);
                    if (named >= 0 && ir.nccIr.graphNodeAstKind(graph,named) != 25)
                        stringBytes += ir.nccIr.graphNodeNameBytes(graph,named)+ir.nccIr.graphNodeOwnerBytes(graph,named);
                    else if (opcode == IR_FUNCTION || (rd<int>(off(step,16)) >= 0 && named < 0))
                        stringBytes += nativeIdentityBytes(graph,rd<int>(step),opcode,functionTable,functionCapacity);
                    at += 1;
                }
                at <- 0;
                while (at < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeOpcode(graph,at) == IR_ENTRY)
                        stringBytes += nativeIdentityBytes(graph,at,IR_ENTRY,functionTable,functionCapacity);
                    at += 1;
                }
                identitiesAt >> int <- HEADER_BYTES+count*RECORD_BYTES;
                stringsAt >> int <- identitiesAt+count*IDENTITY_BYTES;
                sourceMapAt >> int <- stringsAt+stringBytes;
                textAt >> int <- sourceMapAt+count*SOURCE_MAP_RECORD_BYTES;
                capacity >> int <- native_body.nccNativeBody.bytes(plan)+entries*MAX_INSTRUCTION_BYTES;
                total >> int <- textAt+capacity+16+native_body.nccNativeBody.dataBytes(plan)+native_body.nccNativeBody.rodataBytes(plan);
                artifact >> p<byte> <- cast<byte>(calloc(1,total));
                if (artifact == null) { free(functionTable); native_body.nccNativeBody.release(plan); return null; }
                target >> int <- ir.nccIr.graphTarget(graph);
                putInteger(artifact,H_MAGIC,MCT_MAGIC); putInteger(artifact,H_VERSION,MCT_VERSION);
                putInteger(artifact,H_TARGET,target); putInteger(artifact,H_FAMILY,FAMILY_X86_64);
                putInteger(artifact,H_POINTER_BITS,ir.nccIr.graphPointerBits(graph));
                putInteger(artifact,H_OBJECT,ir.nccIr.graphObject(graph));
                putInteger(artifact,H_ABI,ir.nccIr.graphAbi(graph));
                putInteger(artifact,H_IR_NODES,count); putInteger(artifact,H_RECORD_BYTES,RECORD_BYTES);
                putInteger(artifact,H_MAX_INSTRUCTION,MAX_INSTRUCTION_BYTES);
                putInteger(artifact,H_ALIGNMENT,alignment(FAMILY_X86_64));
                putInteger(artifact,H_IR_FINGERPRINT,ir.nccIr.graphFingerprint(graph));
                putInteger(artifact,H_RECORDS_OFFSET,HEADER_BYTES);
                putInteger(artifact,H_IDENTITIES_OFFSET,identitiesAt);
                putInteger(artifact,H_STRINGS_OFFSET,stringsAt); putInteger(artifact,H_STRING_BYTES,stringBytes);
                putInteger(artifact,H_SOURCE_MAP_OFFSET,sourceMapAt);
                putInteger(artifact,H_SOURCE_MAP_BYTES,count*SOURCE_MAP_RECORD_BYTES);
                putInteger(artifact,H_SOURCE_MAP_RECORD_BYTES,SOURCE_MAP_RECORD_BYTES);
                putInteger(artifact,H_TEXT_OFFSET,textAt);
                cursor >> int <- native_body.nccNativeBody.bytes(plan);
                copyBytes(text(artifact),0,native_body.nccNativeBody.code(plan),cursor);
                entryNode >> int <- 0;
                stringAt >> int <- 0;
                index >> int <- 0;
                while (index < count) {
                    source >> int <- -1;
                    opcode >> int <- IR_ENTRY;
                    start >> int <- cursor;
                    length >> int <- 0;
                    relocAt >> int <- -1;
                    section >> int <- SECTION_TEXT;
                    named >> int <- -1;
                    storageAlignment >> int <- 1;
                    if (index < planned) {
                        step >> p<byte> <- native_body.nccNativeBody.record(plan,index);
                        source <- rd<int>(step); opcode <- rd<int>(off(step,4));
                        start <- rd<int>(off(step,8)); length <- rd<int>(off(step,12));
                        relocAt <- rd<int>(off(step,16));
                        section <- rd<int>(off(step,28)); named <- rd<int>(off(step,24));
                        if (opcode == IR_DECLARE && section != SECTION_TEXT && section != SECTION_RODATA)
                            storageAlignment <- rd<int>(off(step,20));
                        if (opcode == IR_DECLARE && section != SECTION_RODATA) named <- source;
                    }
                    else {
                        while (entryNode < ir.nccIr.graphNodes(graph) &&
                            ir.nccIr.graphNodeOpcode(graph,entryNode) != IR_ENTRY) { entryNode += 1; }
                        source <- entryNode; entryNode += 1;
                        cursor <- encodeX64(text(artifact),cursor,IR_ENTRY,
                            ir.nccIr.graphAbi(graph) == ABI_WIN64,0,
                            entryReturnsBool(graph,source,functionTable,functionCapacity));
                        length <- cursor-start;
                        relocAt <- relocationOffset(FAMILY_X86_64,ir.nccIr.graphAbi(graph),IR_ENTRY,start);
                    }
                    item >> p<byte> <- record(artifact,index);
                    reloc >> int <- relocAt >= 0 ? (section == SECTION_DATA ? RELOC_X86_ABS64 :
                        (named >= 0 ? RELOC_X86_DATA_PCREL32 : RELOC_X86_PCREL32)) : RELOC_NONE;
                    definition >> bool <- opcode == IR_FUNCTION || (opcode == IR_DECLARE && section != SECTION_TEXT);
                    targetValue >> int <- definition ? ir.nccIr.graphNodeNameHash(graph,source) :
                        (reloc == RELOC_NONE ? 0 : destinationValue(graph,source,opcode));
                    targetKind >> int <- definition ? TARGET_LOCAL_SYMBOL :
                        (reloc == RELOC_NONE ? TARGET_NONE : destinationKind(graph,source,opcode,
                            targetValue,functionTable,functionCapacity));
                    if (named >= 0) { targetValue <- ir.nccIr.graphNodeNameHash(graph,named); targetKind <- TARGET_LOCAL_SYMBOL; }
                    if (named >= 0 && ir.nccIr.graphNodeAstKind(graph,named) == 30 && ir.nccIr.graphSignatureArity(graph,named) >= 0)
                        targetKind <- TARGET_EXTERNAL_SYMBOL;
                    if ((named >= 0 && ir.nccIr.graphNodeAstKind(graph,named) == 25) ||
                        (definition && section == SECTION_RODATA)) {
                        targetKind <- TARGET_CONTROL_NODE;
                        targetValue <- index;
                        if (!definition) {
                            search >> int <- 0;
                            while (search < planned) {
                                candidate >> p<byte> <- native_body.nccNativeBody.record(plan,search);
                                if (rd<int>(candidate) == named && rd<int>(off(candidate,4)) == IR_DECLARE &&
                                    rd<int>(off(candidate,28)) == SECTION_RODATA) { targetValue <- search; break; }
                                search += 1;
                            }
                            if (search == planned) { free(artifact); free(functionTable); native_body.nccNativeBody.release(plan); return null; }
                        }
                    }
                    putInteger(item,R_IR_INDEX,source); putInteger(item,R_IR_OPCODE,opcode);
                    putInteger(item,R_FAMILY,FAMILY_X86_64); putInteger(item,R_TEXT_OFFSET,start);
                    putInteger(item,R_BYTE_LENGTH,length); putInteger(item,R_RELOCATION,reloc);
                    putInteger(item,R_RELOCATION_OFFSET,relocAt); putInteger(item,R_SECTION,section);
                    putInteger(item,R_REGISTER_CLASS,REGISTER_GPR64);
                    putInteger(item,R_EFFECTS,ir.nccIr.graphNodeEffects(graph,source));
                    putInteger(item,R_FLAGS,ir.nccIr.graphNodeFlags(graph,source));
                    putInteger(item,R_NAME_HASH,ir.nccIr.graphNodeNameHash(graph,source));
                    putInteger(item,R_TYPE_HASH,ir.nccIr.graphNodeTypeHash(graph,source));
                    selected >> p<byte> <- section == SECTION_DATA ? native_body.nccNativeBody.data(plan) :
                        (section == SECTION_RODATA ? native_body.nccNativeBody.rodata(plan) : text(artifact));
                    putInteger(item,R_CHECKSUM,section == SECTION_BSS ? 0 : checksum(selected,start,length));
                    putInteger(item,R_ALIGNMENT,storageAlignment); putInteger(item,R_TARGET_KIND,targetKind);
                    putInteger(item,R_TARGET_VALUE,targetValue);
                    sourceItem >> p<byte> <- sourceRecord(artifact,index);
                    putInteger(sourceItem,S_LINE,ir.nccIr.graphNodeLine(graph,source));
                    putInteger(sourceItem,S_COLUMN,ir.nccIr.graphNodeColumn(graph,source));
                    if ((definition && section != SECTION_RODATA) || (named >= 0 && (targetKind == TARGET_LOCAL_SYMBOL || targetKind == TARGET_EXTERNAL_SYMBOL))) {
                        id >> p<byte> <- identity(artifact,index);
                        identitySource >> int <- named >= 0 ? named : source;
                        nameBytes >> int <- ir.nccIr.graphNodeNameBytes(graph,identitySource);
                        ownerBytes >> int <- ir.nccIr.graphNodeOwnerBytes(graph,identitySource);
                        putInteger(id,I_NAME_OFFSET,stringAt); putInteger(id,I_NAME_BYTES,nameBytes);
                        stringAt <- copyBytes(strings(artifact),stringAt,ir.nccIr.graphNodeName(graph,identitySource),nameBytes);
                        putInteger(id,I_OWNER_OFFSET,stringAt); putInteger(id,I_OWNER_BYTES,ownerBytes);
                        stringAt <- copyBytes(strings(artifact),stringAt,ir.nccIr.graphNodeOwner(graph,identitySource),ownerBytes);
                        putInteger(id,I_VISIBILITY,ir.nccIr.graphNodeVisibility(graph,identitySource));
                        putInteger(id,I_HASH_A,identityHash(ir.nccIr.graphNodeName(graph,identitySource),nameBytes,5381));
                        combined >> int <- identityHash(ir.nccIr.graphNodeName(graph,identitySource),nameBytes,65537);
                        if (ownerBytes > 0) combined <- identityHash(ir.nccIr.graphNodeOwner(graph,identitySource),ownerBytes,combined);
                        putInteger(id,I_HASH_B,combined);
                    }
                    else if (reloc != RELOC_NONE && targetKind != TARGET_CONTROL_NODE) stringAt <- fillTargetIdentitySource(graph,artifact,index,source,opcode,
                        targetKind,stringAt,functionTable,functionCapacity);
                    putInteger(artifact,H_INSTRUCTIONS,integer(artifact,H_INSTRUCTIONS)+1);
                    putInteger(artifact,H_SOURCE_MAP_LINES,integer(artifact,H_SOURCE_MAP_LINES)+1);
                    if (reloc != RELOC_NONE) putInteger(artifact,H_RELOCATIONS,integer(artifact,H_RELOCATIONS)+1);
                    if (targetKind != TARGET_NONE) putInteger(artifact,H_TARGETS,integer(artifact,H_TARGETS)+1);
                    if (targetKind == TARGET_LOCAL_SYMBOL) putInteger(artifact,H_LOCAL_TARGETS,integer(artifact,H_LOCAL_TARGETS)+1);
                    if (targetKind == TARGET_CONTROL_NODE) putInteger(artifact,H_CONTROL_TARGETS,integer(artifact,H_CONTROL_TARGETS)+1);
                    if (targetKind == TARGET_EXTERNAL_SYMBOL) {
                        putInteger(artifact,H_EXTERNAL_TARGETS,integer(artifact,H_EXTERNAL_TARGETS)+1);
                        sourceNode >> int <- targetIdentityNode(graph,source,opcode,functionTable,functionCapacity);
                        externalKind >> int <- externalClass(graph,sourceNode);
                        if (externalKind == EXTERNAL_RUNTIME) putInteger(artifact,H_RUNTIME_TARGETS,integer(artifact,H_RUNTIME_TARGETS)+1);
                        if (externalKind == EXTERNAL_INTRINSIC) putInteger(artifact,H_INTRINSIC_TARGETS,integer(artifact,H_INTRINSIC_TARGETS)+1);
                    }
                    if (targetKind == TARGET_UNRESOLVED) putInteger(artifact,H_UNRESOLVED_TARGETS,integer(artifact,H_UNRESOLVED_TARGETS)+1);
                    if (opcode == IR_CALL || opcode == IR_ENTRY) putInteger(artifact,H_CALLS,integer(artifact,H_CALLS)+1);
                    if (opcode == IR_BRANCH || opcode == IR_JUMP) putInteger(artifact,H_BRANCHES,integer(artifact,H_BRANCHES)+1);
                    if (opcode == IR_RETURN) putInteger(artifact,H_RETURNS,integer(artifact,H_RETURNS)+1);
                    if (opcode == IR_LOAD) putInteger(artifact,H_LOADS,integer(artifact,H_LOADS)+1);
                    if (opcode == IR_STORE) putInteger(artifact,H_STORES,integer(artifact,H_STORES)+1);
                    index += 1;
                }
                putInteger(artifact,H_STRING_BYTES,stringAt);
                putInteger(artifact,H_TEXT_BYTES,cursor); putInteger(artifact,H_TEXT_HASH,textHash(text(artifact),cursor));
                dataAt >> int <- (textAt+cursor+7) & ~7;
                dataBytes >> int <- native_body.nccNativeBody.dataBytes(plan);
                rodataAt >> int <- dataAt+dataBytes;
                rodataBytes >> int <- native_body.nccNativeBody.rodataBytes(plan);
                putInteger(artifact,H_DATA_OFFSET,dataAt); putInteger(artifact,H_DATA_BYTES,dataBytes);
                putInteger(artifact,H_BSS_BYTES,native_body.nccNativeBody.bssBytes(plan));
                putInteger(artifact,H_RODATA_OFFSET,rodataAt); putInteger(artifact,H_RODATA_BYTES,rodataBytes);
                storageAlignment >> int <- 16;
                at <- 0;
                while (at < planned) {
                    step >> p<byte> <- native_body.nccNativeBody.record(plan,at);
                    if (rd<int>(off(step,4)) == IR_DECLARE &&
                        (rd<int>(off(step,28)) == SECTION_DATA || rd<int>(off(step,28)) == SECTION_BSS) &&
                        rd<int>(off(step,20)) > storageAlignment) storageAlignment <- rd<int>(off(step,20));
                    at += 1;
                }
                putInteger(artifact,H_STORAGE_ALIGNMENT,storageAlignment);
                copyBytes(artifact,dataAt,native_body.nccNativeBody.data(plan),dataBytes);
                copyBytes(artifact,rodataAt,native_body.nccNativeBody.rodata(plan),rodataBytes);
                putInteger(artifact,H_STORAGE_HASH,textHash(off(artifact,dataAt),dataBytes+rodataBytes));
                putInteger(artifact,H_MATERIAL_BYTES,rodataAt+rodataBytes);
                putInteger(artifact,H_IDENTITY_FINGERPRINT,textHash(strings(artifact),stringAt));
                putInteger(artifact,H_FINGERPRINT,fingerprint(artifact));
                free(functionTable); native_body.nccNativeBody.release(plan); return artifact;
            }

            lowerGraph(graph >> p<byte>) -> p<byte> {
                target >> int <- ir.nccIr.graphTarget(graph);
                targetFamily >> int <- family(target);
                if (targetFamily == FAMILY_X86_64) return lowerNativeGraph(graph);
                count >> int <- ir.nccIr.graphNodes(graph);
                recordsBytes >> int <- count * RECORD_BYTES;
                identitiesBytes >> int <- count * IDENTITY_BYTES;
                functionCapacity >> int <- functionTableCapacity(graph);
                functionTable >> p<int> <- buildFunctionTable(graph, functionCapacity);
                guard functionTable != null else return null;
                constants >> p<byte> <- mct_values.nccMctValues.create(graph);
                guard constants != null else { free(functionTable); return null; }
                stringBytes >> int <- targetStringBytes(
                    graph, functionTable, functionCapacity);
                sourceMapBytes >> int <- count * SOURCE_MAP_RECORD_BYTES;
                capacity >> int <- count * MAX_INSTRUCTION_BYTES;
                identitiesAt >> int <- HEADER_BYTES + recordsBytes;
                stringsAt >> int <- identitiesAt + identitiesBytes;
                sourceMapAt >> int <- stringsAt + stringBytes;
                textAt >> int <- sourceMapAt + sourceMapBytes;
                graphBytes >> int <- target == 10 ? ir.nccIr.graphMaterialBytes(graph) : 0;
                total >> int <- textAt + capacity + graphBytes + 7;
                order >> p<int> <- emissionOrder(graph, count);
                guard order != null else { free(constants); free(functionTable); return null; }
                artifact >> p<byte> <- cast<byte>(alloc(total));
                guard artifact != null else {
                    free(order);
                    free(constants);
                    free(functionTable);
                    return null;
                }
                at >> int <- 0;
                while (at < total) { wr<byte>(off(artifact, at), 0); at += 1; }

                putInteger(artifact, H_MAGIC, MCT_MAGIC);
                putInteger(artifact, H_VERSION, MCT_VERSION);
                putInteger(artifact, H_TARGET, target);
                putInteger(artifact, H_FAMILY, targetFamily);
                putInteger(artifact, H_POINTER_BITS, ir.nccIr.graphPointerBits(graph));
                putInteger(artifact, H_OBJECT, ir.nccIr.graphObject(graph));
                putInteger(artifact, H_ABI, ir.nccIr.graphAbi(graph));
                putInteger(artifact, H_IR_NODES, count);
                putInteger(artifact, H_RECORD_BYTES, RECORD_BYTES);
                putInteger(artifact, H_MAX_INSTRUCTION, MAX_INSTRUCTION_BYTES);
                putInteger(artifact, H_ALIGNMENT, alignment(targetFamily));
                putInteger(artifact, H_IR_FINGERPRINT, ir.nccIr.graphFingerprint(graph));
                putInteger(artifact, H_RECORDS_OFFSET, HEADER_BYTES);
                putInteger(artifact, H_IDENTITIES_OFFSET, identitiesAt);
                putInteger(artifact, H_STRINGS_OFFSET, stringsAt);
                putInteger(artifact, H_STRING_BYTES, stringBytes);
                putInteger(artifact, H_SOURCE_MAP_OFFSET, sourceMapAt);
                putInteger(artifact, H_SOURCE_MAP_BYTES, sourceMapBytes);
                putInteger(artifact, H_SOURCE_MAP_RECORD_BYTES, SOURCE_MAP_RECORD_BYTES);
                putInteger(artifact, H_TEXT_OFFSET, textAt);

                code >> p<byte> <- text(artifact);
                cursor >> int <- 0;
                stringAt >> int <- 0;
                position >> int <- 0;
                while (position < count) {
                    at <- rd<int>(off(order, position));
                    opcode >> int <- ir.nccIr.graphNodeOpcode(graph, at);
                    constantNode >> bool <- mct_values.nccMctValues.status(constants, at) == 2;
                    constantHidden >> bool <- mct_values.nccMctValues.knownAncestor(graph, constants, at);
                    if (opcode == IR_LOAD && ir.nccIr.graphNodeAstKind(graph, at) == AST_EXPR_NAME &&
                        mct_values.nccMctValues.isConstant(graph, mct_values.nccMctValues.resolve(graph, at)) &&
                        !constantNode) {
                        free(artifact); free(constants); free(order); free(functionTable);
                        return null;
                    }
                    if (constantNode) opcode <- IR_CONSTANT;
                    optimizedOut >> bool <- ir.nccIr.graphNodeOptimizedOut(graph, at) &&
                        !entryRetainsNode(graph, at, functionTable, functionCapacity);
                    if (!optimizedOut && ir.nccIr.graphNodeAstKind(graph, at) ==
                        AST_STMT_WHILE) cursor <- emitLoopHoists(
                        graph, artifact, code, cursor, at, targetFamily);
                    item >> p<byte> <- record(artifact, at);
                    role >> int <- ir.nccIr.graphNodeRoleHash(graph, at);
                    prehoisted >> bool <- licmRole(role) &&
                        integer(item, R_BYTE_LENGTH) > 0;
                    inlineNode >> int <- inlineExpressionNode(graph, at, role);
                    valueSource >> int <- ir.nccIr.graphNodeGvnSource(graph,at);
                    gvnSource >> int <- valueSource == at ? ir.nccIr.graphNodeGvnSlot(graph,at) : -1;
                    gvnReuse >> int <- valueSource >= 0 && valueSource != at ? ir.nccIr.graphNodeGvnSlot(graph,at) : -1;
                    start >> int <- prehoisted ? integer(item, R_TEXT_OFFSET) : cursor;
                    intrinsic >> int <- ir.nccIr.graphNodeIntrinsicId(graph, at);
                    width >> int <- ir.nccIr.graphNodeIntrinsicTypeBytes(graph, at);
                    signedValue >> bool <- ir.nccIr.graphNodeIntrinsicTypeSigned(graph, at);
                    constantValue >> int <- constantNode ? mct_values.nccMctValues.value(constants, at) : 0;
                    entryBool >> bool <- opcode == IR_ENTRY && entryReturnsBool(
                        graph, at, functionTable, functionCapacity);
                    if (!optimizedOut && !prehoisted && !constantHidden) {
                        if (gvnReuse >= 0)
                            cursor <- encodeGvnLoad(
                                code, cursor, targetFamily, gvnReuse);
                        else if (inlineNode >= 0) {
                            targetFunction >> int <- functionOf(graph, inlineNode);
                            cursor <- emitInlineTemporaryArguments(
                                graph, code, cursor, targetFamily, at,
                                targetFunction, inlineNode);
                            cursor <- emitInlineExpression(
                                graph, code, cursor, inlineNode, targetFamily, at,
                                targetFunction, inlineNode);
                        }
                        else if (ir.nccIr.graphNodeLayoutValid(graph,at))
                            cursor <- encodeLayout(code,cursor,targetFamily,ir.nccIr.graphNodeLayoutValue(graph,at));
                        else cursor <- encode(code, cursor, targetFamily,
                            ir.nccIr.graphAbi(graph), opcode, role, intrinsic, width,
                            signedValue, constantValue, entryBool);
                        if (gvnSource >= 0)
                            cursor <- encodeGvnSave(
                                code, cursor, targetFamily, gvnSource);
                    }
                    length >> int <- prehoisted ?
                        integer(item, R_BYTE_LENGTH) : cursor - start;
                    relocationKind >> int <- optimizedOut || constantHidden || inlineNode >= 0 ? RELOC_NONE :
                        relocation(targetFamily, opcode);
                    putInteger(item, R_IR_INDEX, at);
                    putInteger(item, R_IR_OPCODE, opcode);
                    putInteger(item, R_FAMILY, targetFamily);
                    putInteger(item, R_TEXT_OFFSET, start);
                    putInteger(item, R_BYTE_LENGTH, length);
                    putInteger(item, R_RELOCATION, relocationKind);
                    putInteger(item, R_RELOCATION_OFFSET,
                        relocationKind == RELOC_NONE ? -1 : relocationOffset(
                            targetFamily, ir.nccIr.graphAbi(graph), opcode, start));
                    putInteger(item, R_ADDEND, 0);
                    putInteger(item, R_SECTION, length == 0 ? 0 : SECTION_TEXT);
                    putInteger(item, R_REGISTER_CLASS, registerClass(targetFamily));
                    putInteger(item, R_EFFECTS, ir.nccIr.graphNodeEffects(graph, at));
                    putInteger(item, R_FLAGS, ir.nccIr.graphNodeFlags(graph, at));
                    putInteger(item, R_NAME_HASH, ir.nccIr.graphNodeNameHash(graph, at));
                    putInteger(item, R_TYPE_HASH, ir.nccIr.graphNodeTypeHash(graph, at));
                    putInteger(item, R_CHECKSUM, checksum(code, start, length));
                    putInteger(item, R_ALIGNMENT, alignment(targetFamily));

                    functionDefinition >> bool <- opcode == IR_FUNCTION &&
                        ir.nccIr.graphNodeNameBytes(graph, at) > 0;
                    targetValue >> int <- functionDefinition ?
                        ir.nccIr.graphNodeNameHash(graph, at) :
                        (relocationKind == RELOC_NONE ? 0 : destinationValue(graph, at, opcode));
                    targetKind >> int <- functionDefinition ? TARGET_LOCAL_SYMBOL :
                        (relocationKind == RELOC_NONE ? TARGET_NONE :
                        destinationKind(graph, at, opcode, targetValue,
                            functionTable, functionCapacity));
                    putInteger(item, R_TARGET_KIND, targetKind);
                    putInteger(item, R_TARGET_VALUE, targetValue);
                    sourceItem >> p<byte> <- sourceRecord(artifact, at);
                    line >> int <- ir.nccIr.graphNodeLine(graph, at);
                    putInteger(sourceItem, S_LINE, line);
                    putInteger(sourceItem, S_COLUMN, ir.nccIr.graphNodeColumn(graph, at));
                    if (length > 0 && line > 0) putInteger(artifact, H_SOURCE_MAP_LINES,
                        integer(artifact, H_SOURCE_MAP_LINES) + 1);
                    if (functionDefinition) {
                        identityItem >> p<byte> <- identity(artifact, at);
                        nameBytes >> int <- ir.nccIr.graphNodeNameBytes(graph, at);
                        ownerBytes >> int <- ir.nccIr.graphNodeOwnerBytes(graph, at);
                        putInteger(identityItem, I_NAME_OFFSET, stringAt);
                        putInteger(identityItem, I_NAME_BYTES, nameBytes);
                        stringAt <- copyBytes(strings(artifact), stringAt,
                            ir.nccIr.graphNodeName(graph, at), nameBytes);
                        putInteger(identityItem, I_OWNER_OFFSET, stringAt);
                        putInteger(identityItem, I_OWNER_BYTES, ownerBytes);
                        stringAt <- copyBytes(strings(artifact), stringAt,
                            ir.nccIr.graphNodeOwner(graph, at), ownerBytes);
                        putInteger(identityItem, I_VISIBILITY,
                            ir.nccIr.graphNodeVisibility(graph, at));
                        putInteger(identityItem, I_KIND, 0);
                        putInteger(identityItem, I_HASH_A, identityHash(
                            ir.nccIr.graphNodeName(graph, at), nameBytes, 5381));
                        combined >> int <- identityHash(
                            ir.nccIr.graphNodeName(graph, at), nameBytes, 65537);
                        if (ownerBytes > 0) combined <- identityHash(
                            ir.nccIr.graphNodeOwner(graph, at), ownerBytes, combined);
                        putInteger(identityItem, I_HASH_B, combined);
                    }
                    else stringAt <- fillTargetIdentity(graph, artifact, at, opcode,
                        targetKind, stringAt, functionTable, functionCapacity);

                    if (length > 0) putInteger(artifact, H_INSTRUCTIONS,
                        integer(artifact, H_INSTRUCTIONS) + 1);
                    if (relocationKind != RELOC_NONE) putInteger(artifact, H_RELOCATIONS,
                        integer(artifact, H_RELOCATIONS) + 1);
                    if (targetKind != TARGET_NONE) putInteger(artifact, H_TARGETS,
                        integer(artifact, H_TARGETS) + 1);
                    if (targetKind == TARGET_LOCAL_SYMBOL) putInteger(artifact, H_LOCAL_TARGETS,
                        integer(artifact, H_LOCAL_TARGETS) + 1);
                    if (targetKind == TARGET_EXTERNAL_SYMBOL) putInteger(artifact, H_EXTERNAL_TARGETS,
                        integer(artifact, H_EXTERNAL_TARGETS) + 1);
                    if (targetKind == TARGET_EXTERNAL_SYMBOL) {
                        sourceNode >> int <- targetIdentityNode(
                            graph, at, opcode, functionTable, functionCapacity);
                        externalKind >> int <- externalClass(graph, sourceNode);
                        if (externalKind == EXTERNAL_INTRINSIC)
                            putInteger(artifact, H_INTRINSIC_TARGETS,
                                integer(artifact, H_INTRINSIC_TARGETS) + 1);
                        if (externalKind == EXTERNAL_RUNTIME)
                            putInteger(artifact, H_RUNTIME_TARGETS,
                                integer(artifact, H_RUNTIME_TARGETS) + 1);
                    }
                    if (targetKind == TARGET_CONTROL_NODE) putInteger(artifact, H_CONTROL_TARGETS,
                        integer(artifact, H_CONTROL_TARGETS) + 1);
                    if (targetKind == TARGET_UNRESOLVED) putInteger(artifact, H_UNRESOLVED_TARGETS,
                        integer(artifact, H_UNRESOLVED_TARGETS) + 1);
                    if (length > 0 && (opcode == IR_CALL || opcode == IR_ENTRY ||
                        opcode == IR_INTRINSIC))
                        putInteger(artifact, H_CALLS,
                        integer(artifact, H_CALLS) + 1);
                    if (length > 0 && (opcode == IR_BRANCH || opcode == IR_JUMP))
                        putInteger(artifact, H_BRANCHES,
                        integer(artifact, H_BRANCHES) + 1);
                    if (length > 0 && opcode == IR_RETURN) putInteger(artifact, H_RETURNS,
                        integer(artifact, H_RETURNS) + 1);
                    if (length > 0 && (opcode == IR_LOAD || (opcode == IR_INTRINSIC &&
                        intrinsics.nccIntrinsics.readsMemory(intrinsic))))
                        putInteger(artifact, H_LOADS,
                        integer(artifact, H_LOADS) + 1);
                    if (length > 0 && (opcode == IR_STORE || (opcode == IR_INTRINSIC &&
                        intrinsics.nccIntrinsics.writesMemory(intrinsic))))
                        putInteger(artifact, H_STORES,
                        integer(artifact, H_STORES) + 1);
                    position += 1;
                }

                putInteger(artifact, H_TEXT_BYTES, cursor);
                putInteger(artifact, H_TEXT_HASH, textHash(code, cursor));
                graphStart >> int <- (textAt + cursor + 7) & ~7;
                if (graphBytes > 0) ir.nccIr.graphCopyInto(graph, off(artifact, graphStart));
                putInteger(artifact, H_MATERIAL_BYTES, graphBytes > 0 ? graphStart + graphBytes : textAt + cursor);
                putInteger(artifact, H_IDENTITY_FINGERPRINT,
                    textHash(strings(artifact), stringBytes));
                putInteger(artifact, H_FINGERPRINT, fingerprint(artifact));
                free(order);
                free(constants);
                free(functionTable);
                return artifact;
            }

            emitPrefix(artifact >> p<byte>) -> bool {
                print("[");
                count >> int <- integer(artifact, H_TEXT_BYTES);
                if (count > 32) count <- 32;
                at >> int <- 0;
                while (at < count) {
                    if (at > 0) print(",");
                    print(renderInt(unsignedByte(rd<byte>(off(text(artifact), at)))));
                    at += 1;
                }
                print("]");
                return true;
            }

            emitArtifact(artifact >> p<byte>, json >> bool) -> bool {
                target >> int <- integer(artifact, H_TARGET);
                if (!json) {
                    print("MCT target="); println(ir.nccIr.targetName(target));
                    print("instructions="); print(renderInt(integer(artifact, H_INSTRUCTIONS)));
                    print(" text_bytes="); println(renderInt(integer(artifact, H_TEXT_BYTES)));
                    print("fingerprint="); println(renderInt(integer(artifact, H_FINGERPRINT)));
                    return true;
                }
                print("{\"schema\":\"nc.bootstrap.mct.material.v4\"");
                print(",\"target\":\""); print(ir.nccIr.targetName(target)); print("\"");
                print(",\"target_id\":"); print(renderInt(target));
                print(",\"family\":\""); print(familyName(integer(artifact, H_FAMILY))); print("\"");
                print(",\"family_id\":"); print(renderInt(integer(artifact, H_FAMILY)));
                print(",\"pointer_bits\":"); print(renderInt(integer(artifact, H_POINTER_BITS)));
                print(",\"object\":\""); print(ir.nccIr.targetObjectName(target)); print("\"");
                print(",\"abi\":\""); print(ir.nccIr.targetAbiName(target)); print("\"");
                print(",\"header_bytes\":"); print(renderInt(HEADER_BYTES));
                print(",\"record_bytes\":"); print(renderInt(RECORD_BYTES));
                print(",\"identity_record_bytes\":"); print(renderInt(IDENTITY_BYTES));
                print(",\"identity_bytes\":"); print(renderInt(integer(artifact, H_STRING_BYTES)));
                print(",\"identity_fingerprint\":"); print(renderInt(
                    integer(artifact, H_IDENTITY_FINGERPRINT)));
                print(",\"source_map_record_bytes\":"); print(renderInt(
                    integer(artifact, H_SOURCE_MAP_RECORD_BYTES)));
                print(",\"source_map_bytes\":"); print(renderInt(
                    integer(artifact, H_SOURCE_MAP_BYTES)));
                print(",\"source_map_lines\":"); print(renderInt(
                    integer(artifact, H_SOURCE_MAP_LINES)));
                print(",\"ir_nodes\":"); print(renderInt(integer(artifact, H_IR_NODES)));
                print(",\"instruction_records\":"); print(renderInt(integer(artifact, H_INSTRUCTIONS)));
                print(",\"text_bytes\":"); print(renderInt(integer(artifact, H_TEXT_BYTES)));
                print(",\"data_bytes\":"); print(renderInt(integer(artifact,H_DATA_BYTES)));
                print(",\"bss_bytes\":"); print(renderInt(integer(artifact,H_BSS_BYTES)));
                print(",\"rodata_bytes\":"); print(renderInt(integer(artifact,H_RODATA_BYTES)));
                print(",\"relocations\":"); print(renderInt(integer(artifact, H_RELOCATIONS)));
                print(",\"targets\":"); print(renderInt(integer(artifact, H_TARGETS)));
                print(",\"local_targets\":"); print(renderInt(integer(artifact, H_LOCAL_TARGETS)));
                print(",\"external_targets\":"); print(renderInt(integer(artifact, H_EXTERNAL_TARGETS)));
                print(",\"control_targets\":"); print(renderInt(integer(artifact, H_CONTROL_TARGETS)));
                print(",\"unresolved_targets\":"); print(renderInt(integer(artifact, H_UNRESOLVED_TARGETS)));
                print(",\"intrinsic_targets_pending_selection\":"); print(renderInt(
                    integer(artifact, H_INTRINSIC_TARGETS)));
                print(",\"selected_intrinsics\":"); print(renderInt(
                    selectedIntrinsicCount(artifact)));
                print(",\"runtime_import_targets\":"); print(renderInt(
                    integer(artifact, H_RUNTIME_TARGETS)));
                print(",\"project_external_targets\":"); print(renderInt(
                    integer(artifact, H_EXTERNAL_TARGETS) -
                    integer(artifact, H_INTRINSIC_TARGETS) -
                    integer(artifact, H_RUNTIME_TARGETS)));
                print(",\"link_selection_ready\":"); print(
                    integer(artifact, H_INTRINSIC_TARGETS) == 0 &&
                    integer(artifact, H_UNRESOLVED_TARGETS) == 0 ? "true" : "false");
                print(",\"calls\":"); print(renderInt(integer(artifact, H_CALLS)));
                print(",\"branches\":"); print(renderInt(integer(artifact, H_BRANCHES)));
                print(",\"returns\":"); print(renderInt(integer(artifact, H_RETURNS)));
                print(",\"loads\":"); print(renderInt(integer(artifact, H_LOADS)));
                print(",\"stores\":"); print(renderInt(integer(artifact, H_STORES)));
                print(",\"alignment\":"); print(renderInt(integer(artifact, H_ALIGNMENT)));
                print(",\"max_instruction_bytes\":"); print(renderInt(MAX_INSTRUCTION_BYTES));
                print(",\"ir_fingerprint\":"); print(renderInt(integer(artifact, H_IR_FINGERPRINT)));
                print(",\"text_hash\":"); print(renderInt(integer(artifact, H_TEXT_HASH)));
                print(",\"material_bytes\":"); print(renderInt(integer(artifact, H_MATERIAL_BYTES)));
                print(",\"text_prefix\":"); emitPrefix(artifact);
                print(",\"fingerprint\":"); print(renderInt(integer(artifact, H_FINGERPRINT)));
                println("}");
                return true;
            }

            writeArtifact(artifact >> p<byte>, path >> str) -> bool {
                if (path == "") return true;
                bytes >> int <- integer(artifact, H_MATERIAL_BYTES);
                return fsWriteFrom(path, artifact, bytes, false) == bytes;
            }

            openArtifact(path >> str) -> p<byte> {
                bytes >> int <- fsSize(path);
                guard bytes >= HEADER_BYTES else return null;
                artifact >> p<byte> <- cast<byte>(alloc(bytes));
                guard artifact != null else return null;
                if (fsReadInto(path, artifact, bytes) != bytes ||
                    integer(artifact, H_MAGIC) != MCT_MAGIC ||
                    integer(artifact, H_VERSION) != MCT_VERSION ||
                    integer(artifact, H_MATERIAL_BYTES) != bytes) {
                    free(artifact);
                    return null;
                }
                dataAt >> int <- integer(artifact,H_DATA_OFFSET);
                dataBytes >> int <- integer(artifact,H_DATA_BYTES);
                roAt >> int <- integer(artifact,H_RODATA_OFFSET);
                roBytes >> int <- integer(artifact,H_RODATA_BYTES);
                storageAlignment >> int <- integer(artifact,H_STORAGE_ALIGNMENT);
                if (storageAlignment != 0 && (storageAlignment < 16 || storageAlignment > 1048576 ||
                    (storageAlignment & (storageAlignment-1)) != 0)) { free(artifact); return null; }
                if (dataBytes < 0 || roBytes < 0 || integer(artifact,H_BSS_BYTES) < 0 ||
                    ((dataBytes > 0 || roBytes > 0) && dataAt < integer(artifact,H_TEXT_OFFSET)+integer(artifact,H_TEXT_BYTES)) ||
                    (dataAt != 0 && (dataAt < HEADER_BYTES || dataAt > bytes || dataBytes > bytes-dataAt)) ||
                    (roAt != 0 && (roAt < HEADER_BYTES || roAt > bytes || roBytes > bytes-roAt)) ||
                    ((dataBytes > 0 || roBytes > 0) && (roAt != dataAt+dataBytes ||
                        textHash(off(artifact,dataAt),dataBytes+roBytes) != integer(artifact,H_STORAGE_HASH)))) {
                    free(artifact); return null;
                }
                recordsAt >> int <- integer(artifact,H_RECORDS_OFFSET);
                records >> int <- integer(artifact,H_IR_NODES);
                if (recordsAt < HEADER_BYTES || recordsAt > bytes || records < 0 ||
                    records > (bytes-recordsAt)/RECORD_BYTES) { free(artifact); return null; }
                at >> int <- 0;
                while (at < records) {
                    item >> p<byte> <- off(artifact,recordsAt+at*RECORD_BYTES);
                    section >> int <- integer(item,R_SECTION);
                    if (integer(item,R_IR_OPCODE) == IR_DECLARE && (section == SECTION_DATA || section == SECTION_BSS)) {
                        alignment >> int <- integer(item,R_ALIGNMENT);
                        offset >> int <- integer(item,R_TEXT_OFFSET);
                        width >> int <- integer(item,R_BYTE_LENGTH);
                        limit >> int <- section == SECTION_DATA ? dataBytes : integer(artifact,H_BSS_BYTES);
                        if (alignment <= 0 || alignment > storageAlignment || (alignment & (alignment-1)) != 0 ||
                            offset < 0 || offset % alignment != 0 || offset > limit || width < 0 || width > limit-offset) {
                            free(artifact); return null;
                        }
                    }
                    at += 1;
                }
                return artifact;
            }

        internal:
            artifactGraph(artifact >> p<byte>) -> p<byte> {
                guard artifact != null && integer(artifact, H_TARGET) == 10 else return null;
                start >> int <- (integer(artifact, H_TEXT_OFFSET) + integer(artifact, H_TEXT_BYTES) + 7) & ~7;
                guard integer(artifact, H_MATERIAL_BYTES) >= start + 128 else return null;
                graph >> p<byte> <- off(artifact, start);
                guard ir.nccIr.graphMaterialBytes(graph) == integer(artifact, H_MATERIAL_BYTES) - start else return null;
                ir.nccIr.graphRebase(graph);
                return graph;
            }

            artifactFromGraph(graph >> p<byte>) -> p<byte> {
                return lowerGraph(graph);
            }

            artifactFor(path >> str, targetName >> str) -> p<byte> {
                graph >> p<byte> <- ir.nccIr.graphFor(path, targetName);
                guard graph != null else return null;
                artifact >> p<byte> <- lowerGraph(graph);
                ir.nccIr.releaseGraph(graph);
                return artifact;
            }

            optimizedArtifactFor(path >> str, targetName >> str, level >> int) -> p<byte> {
                graph >> p<byte> <- ir.nccIr.graphFor(path, targetName);
                guard graph != null else return null;
                transform >> p<byte> <- mct_llvm.nccMctLlvm.optimizeGraph(graph, level);
                guard transform != null else {
                    ir.nccIr.releaseGraph(graph);
                    return null;
                }
                artifact >> p<byte> <- lowerGraph(graph);
                mct_llvm.nccMctLlvm.releaseTransform(transform);
                ir.nccIr.releaseGraph(graph);
                return artifact;
            }

            artifactTarget(artifact >> p<byte>) -> int {
                return integer(artifact, H_TARGET);
            }

            artifactFamily(artifact >> p<byte>) -> int {
                return integer(artifact, H_FAMILY);
            }

            artifactPointerBits(artifact >> p<byte>) -> int {
                return integer(artifact, H_POINTER_BITS);
            }

            artifactObjectFormat(artifact >> p<byte>) -> int {
                return integer(artifact, H_OBJECT);
            }

            artifactAbi(artifact >> p<byte>) -> int {
                return integer(artifact, H_ABI);
            }

            artifactNodeCount(artifact >> p<byte>) -> int {
                return integer(artifact, H_IR_NODES);
            }

            artifactText(artifact >> p<byte>) -> p<byte> {
                return text(artifact);
            }

            artifactTextBytes(artifact >> p<byte>) -> int {
                return integer(artifact, H_TEXT_BYTES);
            }
            artifactSectionData(artifact >> p<byte>, section >> int) -> p<byte> {
                if (section == SECTION_TEXT) return text(artifact);
                if (section == SECTION_DATA) return off(artifact,integer(artifact,H_DATA_OFFSET));
                if (section == SECTION_RODATA) return off(artifact,integer(artifact,H_RODATA_OFFSET));
                return null;
            }
            artifactSectionBytes(artifact >> p<byte>, section >> int) -> int {
                if (section == SECTION_TEXT) return integer(artifact,H_TEXT_BYTES);
                if (section == SECTION_DATA) return integer(artifact,H_DATA_BYTES);
                if (section == SECTION_BSS) return integer(artifact,H_BSS_BYTES);
                if (section == SECTION_RODATA) return integer(artifact,H_RODATA_BYTES);
                return 0;
            }
            artifactRecordSection(artifact >> p<byte>, index >> int) -> int { return integer(record(artifact,index),R_SECTION); }
            artifactDefinition(artifact >> p<byte>, index >> int) -> bool {
                return integer(record(artifact,index),R_IR_OPCODE) == IR_FUNCTION ||
                    (integer(record(artifact,index),R_IR_OPCODE) == IR_DECLARE && artifactRecordSection(artifact,index) != SECTION_TEXT);
            }

            artifactRelocations(artifact >> p<byte>) -> int {
                return integer(artifact, H_RELOCATIONS);
            }

            artifactFingerprint(artifact >> p<byte>) -> int {
                return integer(artifact, H_FINGERPRINT);
            }

            artifactRecordOpcode(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_IR_OPCODE);
            }

            artifactRecordByteLength(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_BYTE_LENGTH);
            }

            artifactRecordLine(artifact >> p<byte>, index >> int) -> int {
                return integer(sourceRecord(artifact, index), S_LINE);
            }

            artifactRecordColumn(artifact >> p<byte>, index >> int) -> int {
                return integer(sourceRecord(artifact, index), S_COLUMN);
            }

            artifactRecordRelocation(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_RELOCATION);
            }

            artifactRecordRelocationOffset(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_RELOCATION_OFFSET);
            }

            artifactRecordTextOffset(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_TEXT_OFFSET);
            }

            artifactRecordAddend(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_ADDEND);
            }

            artifactRecordNameHash(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_NAME_HASH);
            }

            artifactRecordFlags(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_FLAGS);
            }

            artifactRecordTargetKind(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_TARGET_KIND);
            }

            artifactRecordTargetValue(artifact >> p<byte>, index >> int) -> int {
                return integer(record(artifact, index), R_TARGET_VALUE);
            }

            artifactRecordTargetName(artifact >> p<byte>, index >> int) -> p<byte> {
                return off(strings(artifact), integer(identity(artifact, index), I_NAME_OFFSET));
            }

            artifactRecordTargetNameBytes(artifact >> p<byte>, index >> int) -> int {
                return integer(identity(artifact, index), I_NAME_BYTES);
            }

            artifactRecordTargetOwner(artifact >> p<byte>, index >> int) -> p<byte> {
                return off(strings(artifact), integer(identity(artifact, index), I_OWNER_OFFSET));
            }

            artifactRecordTargetOwnerBytes(artifact >> p<byte>, index >> int) -> int {
                return integer(identity(artifact, index), I_OWNER_BYTES);
            }

            artifactRecordTargetVisibility(artifact >> p<byte>, index >> int) -> int {
                return integer(identity(artifact, index), I_VISIBILITY);
            }

            artifactRecordTargetClass(artifact >> p<byte>, index >> int) -> int {
                return integer(identity(artifact, index), I_KIND);
            }

            artifactRecordTargetHashA(artifact >> p<byte>, index >> int) -> int {
                return integer(identity(artifact, index), I_HASH_A);
            }

            artifactRecordTargetHashB(artifact >> p<byte>, index >> int) -> int {
                return integer(identity(artifact, index), I_HASH_B);
            }

            artifactIdentityBytes(artifact >> p<byte>) -> int {
                return integer(artifact, H_STRING_BYTES);
            }

            artifactIdentityFingerprint(artifact >> p<byte>) -> int {
                return integer(artifact, H_IDENTITY_FINGERPRINT);
            }

            artifactIntrinsicTargets(artifact >> p<byte>) -> int {
                return integer(artifact, H_INTRINSIC_TARGETS);
            }

            artifactSelectedIntrinsics(artifact >> p<byte>) -> int {
                return selectedIntrinsicCount(artifact);
            }

            artifactRuntimeTargets(artifact >> p<byte>) -> int {
                return integer(artifact, H_RUNTIME_TARGETS);
            }

            artifactProjectExternalTargets(artifact >> p<byte>) -> int {
                return integer(artifact, H_EXTERNAL_TARGETS) -
                    integer(artifact, H_INTRINSIC_TARGETS) -
                    integer(artifact, H_RUNTIME_TARGETS);
            }

            artifactSourceMapBytes(artifact >> p<byte>) -> int {
                return integer(artifact, H_SOURCE_MAP_BYTES);
            }

            artifactSourceMapLines(artifact >> p<byte>) -> int {
                return integer(artifact, H_SOURCE_MAP_LINES);
            }

            artifactAlignment(artifact >> p<byte>) -> int {
                return integer(artifact, H_ALIGNMENT);
            }
            artifactStorageAlignment(artifact >> p<byte>) -> int {
                value >> int <- integer(artifact,H_STORAGE_ALIGNMENT);
                return value == 0 ? 16 : value;
            }

            releaseArtifact(artifact >> p<byte>) -> void {
                if (artifact != null) free(artifact);
            }

        public:
            projectArtifactFromGraph(graph >> p<byte>) -> p<byte> {
                return artifactFromGraph(graph);
            }
            projectOpenArtifact(path >> str) -> p<byte> {
                return openArtifact(path);
            }
            projectArtifactFingerprint(artifact >> p<byte>) -> int {
                return artifactFingerprint(artifact);
            }
            projectArtifactRelocations(artifact >> p<byte>) -> int {
                return artifactRelocations(artifact);
            }
            projectArtifactIntrinsicTargets(artifact >> p<byte>) -> int {
                return artifactIntrinsicTargets(artifact);
            }
            projectArtifactSelectedIntrinsics(artifact >> p<byte>) -> int {
                return artifactSelectedIntrinsics(artifact);
            }
            projectArtifactRuntimeTargets(artifact >> p<byte>) -> int {
                return artifactRuntimeTargets(artifact);
            }
            projectArtifactExternalTargets(artifact >> p<byte>) -> int {
                return artifactProjectExternalTargets(artifact);
            }
            projectWriteArtifact(artifact >> p<byte>, path >> str) -> bool {
                return artifact != null && writeArtifact(artifact, path);
            }
            projectReleaseArtifact(artifact >> p<byte>) -> void {
                releaseArtifact(artifact);
            }

            emitFile(path >> str, targetName >> str, output >> str,
                optimizationLevel >> str, json >> bool, quiet >> bool) -> int {
                target >> int <- ir.nccIr.targetCode(targetName);
                if (target == 0) return diagnostics.nccDiagnostics.emitIrTarget(path, targetName);
                level >> int <- mct_llvm.nccMctLlvm.parseLevel(optimizationLevel);
                guard level >= 0 else return 1;
                semaCode >> int <- sema.nccSema.analyzeFile(path, false, true);
                if (semaCode != 0) return semaCode;
                artifact >> p<byte> <- level == 0 ? artifactFor(path, targetName) :
                    optimizedArtifactFor(path, targetName, level);
                guard artifact != null else return diagnostics.nccDiagnostics.emitMctMaterial(path);
                if (!writeArtifact(artifact, output)) {
                    free(artifact);
                    return diagnostics.nccDiagnostics.emitMctWrite(output);
                }
                if (!quiet) emitArtifact(artifact, json);
                translations += 1;
                bytesSelected += integer(artifact, H_TEXT_BYTES);
                lastTarget <- target;
                lastTextBytes <- integer(artifact, H_TEXT_BYTES);
                lastFingerprint <- integer(artifact, H_FINGERPRINT);
                lastIdentityBytes <- integer(artifact, H_STRING_BYTES);
                free(artifact);
                return 0;
            }

            checkFile(path >> str, targetName >> str, expectedFamily >> int,
                expectedPointerBits >> int, expectedObject >> int, expectedAbi >> int,
                expectedNodes >> int, expectedInstructions >> int,
                expectedRelocations >> int, expectedTextBytes >> int,
                expectedFingerprint >> int) -> int {
                target >> int <- ir.nccIr.targetCode(targetName);
                if (target == 0) return diagnostics.nccDiagnostics.emitIrTarget(path, targetName);
                semaCode >> int <- sema.nccSema.analyzeFile(path, false, true);
                if (semaCode != 0) return semaCode;
                artifact >> p<byte> <- artifactFor(path, targetName);
                guard artifact != null else return diagnostics.nccDiagnostics.emitMctMaterial(path);
                valid >> bool <- integer(artifact, H_MAGIC) == MCT_MAGIC &&
                    integer(artifact, H_VERSION) == MCT_VERSION &&
                    integer(artifact, H_FAMILY) == expectedFamily &&
                    integer(artifact, H_POINTER_BITS) == expectedPointerBits &&
                    integer(artifact, H_OBJECT) == expectedObject &&
                    integer(artifact, H_ABI) == expectedAbi &&
                    integer(artifact, H_IR_NODES) == expectedNodes &&
                    integer(artifact, H_INSTRUCTIONS) == expectedInstructions &&
                    integer(artifact, H_RELOCATIONS) == expectedRelocations &&
                    integer(artifact, H_TEXT_BYTES) == expectedTextBytes &&
                    integer(artifact, H_FINGERPRINT) == expectedFingerprint &&
                    (integer(artifact, H_TARGET) == 10 ? artifactGraph(artifact) != null :
                    integer(artifact, H_MATERIAL_BYTES) == HEADER_BYTES +
                        expectedNodes * RECORD_BYTES + expectedNodes * IDENTITY_BYTES +
                        integer(artifact, H_STRING_BYTES) +
                        expectedNodes * SOURCE_MAP_RECORD_BYTES + expectedTextBytes);
                free(artifact);
                return valid ? 0 : diagnostics.nccDiagnostics.emitMctContract(path);
            }

            checkTargets(path >> str, targetName >> str, expectedTargets >> int,
                expectedLocal >> int, expectedExternal >> int, expectedControl >> int,
                expectedUnresolved >> int, expectedFingerprint >> int) -> int {
                target >> int <- ir.nccIr.targetCode(targetName);
                if (target == 0) return diagnostics.nccDiagnostics.emitIrTarget(path, targetName);
                semaCode >> int <- sema.nccSema.analyzeFile(path, false, true);
                if (semaCode != 0) return semaCode;
                artifact >> p<byte> <- artifactFor(path, targetName);
                guard artifact != null else return diagnostics.nccDiagnostics.emitMctMaterial(path);
                valid >> bool <- integer(artifact, H_TARGETS) == expectedTargets &&
                    integer(artifact, H_LOCAL_TARGETS) == expectedLocal &&
                    integer(artifact, H_EXTERNAL_TARGETS) == expectedExternal &&
                    integer(artifact, H_CONTROL_TARGETS) == expectedControl &&
                    integer(artifact, H_UNRESOLVED_TARGETS) == expectedUnresolved &&
                    integer(artifact, H_FINGERPRINT) == expectedFingerprint;
                free(artifact);
                return valid ? 0 : diagnostics.nccDiagnostics.emitMctContract(path);
            }

            linkReadiness(path >> str, targetName >> str, json >> bool) -> int {
                target >> int <- ir.nccIr.targetCode(targetName);
                if (target == 0) return diagnostics.nccDiagnostics.emitIrTarget(path, targetName);
                semaCode >> int <- sema.nccSema.analyzeFile(path, false, true);
                if (semaCode != 0) return semaCode;
                artifact >> p<byte> <- artifactFor(path, targetName);
                guard artifact != null else return diagnostics.nccDiagnostics.emitMctMaterial(path);
                intrinsic >> int <- integer(artifact, H_INTRINSIC_TARGETS);
                runtime >> int <- integer(artifact, H_RUNTIME_TARGETS);
                project >> int <- integer(artifact, H_EXTERNAL_TARGETS) - intrinsic - runtime;
                unresolved >> int <- integer(artifact, H_UNRESOLVED_TARGETS);
                if (json) {
                    print("{\"schema\":\"nc.bootstrap.mct.link-readiness.v1\"");
                    print(",\"intrinsic_targets_pending_selection\":"); print(renderInt(intrinsic));
                    print(",\"selected_intrinsics\":"); print(renderInt(
                        selectedIntrinsicCount(artifact)));
                    print(",\"runtime_import_targets\":"); print(renderInt(runtime));
                    print(",\"project_external_targets\":"); print(renderInt(project));
                    print(",\"unresolved_targets\":"); print(renderInt(unresolved));
                    print(",\"ready\":"); print(intrinsic == 0 && unresolved == 0 ? "true" : "false");
                    println("}");
                } else {
                    print("MCT link-readiness intrinsic="); print(renderInt(intrinsic));
                    print(" selected="); print(renderInt(selectedIntrinsicCount(artifact)));
                    print(" runtime="); print(renderInt(runtime));
                    print(" project="); print(renderInt(project));
                    print(" unresolved="); println(renderInt(unresolved));
                }
                free(artifact);
                return 0;
            }

            checkLinkReadiness(path >> str, targetName >> str,
                expectedIntrinsic >> int, expectedRuntime >> int,
                expectedProject >> int, expectedUnresolved >> int,
                expectedSelected >> int) -> int {
                target >> int <- ir.nccIr.targetCode(targetName);
                if (target == 0) return diagnostics.nccDiagnostics.emitIrTarget(path, targetName);
                semaCode >> int <- sema.nccSema.analyzeFile(path, false, true);
                if (semaCode != 0) return semaCode;
                artifact >> p<byte> <- artifactFor(path, targetName);
                guard artifact != null else return diagnostics.nccDiagnostics.emitMctMaterial(path);
                intrinsic >> int <- integer(artifact, H_INTRINSIC_TARGETS);
                runtime >> int <- integer(artifact, H_RUNTIME_TARGETS);
                project >> int <- integer(artifact, H_EXTERNAL_TARGETS) - intrinsic - runtime;
                valid >> bool <- intrinsic == expectedIntrinsic &&
                    runtime == expectedRuntime && project == expectedProject &&
                    integer(artifact, H_UNRESOLVED_TARGETS) == expectedUnresolved &&
                    (expectedSelected < 0 ||
                    selectedIntrinsicCount(artifact) == expectedSelected);
                free(artifact);
                return valid ? 0 : diagnostics.nccDiagnostics.emitMctContract(path);
            }

            selfTest() -> bool {
                return HEADER_BYTES == 192 && RECORD_BYTES == 72 && IDENTITY_BYTES == 32 &&
                    SOURCE_MAP_RECORD_BYTES == 8 &&
                    MAX_INSTRUCTION_BYTES == 32 && family(1) == FAMILY_X86_64 &&
                    family(4) == FAMILY_I386 && family(5) == FAMILY_AARCH64 &&
                    family(7) == FAMILY_ARMV7 && family(8) == FAMILY_RISCV32 &&
                    family(9) == FAMILY_RISCV64 && family(10) == FAMILY_WASM32 &&
                    relocation(FAMILY_X86_64, IR_CALL) == RELOC_X86_PCREL32 &&
                    relocation(FAMILY_AARCH64, IR_CALL) == RELOC_AARCH64_CALL26 &&
                    relocation(FAMILY_RISCV64, IR_BRANCH) == RELOC_RISCV_BRANCH &&
                    TARGET_LOCAL_SYMBOL == 1 && TARGET_EXTERNAL_SYMBOL == 2 &&
                    TARGET_CONTROL_NODE == 3 && TARGET_UNRESOLVED == 4 &&
                    H_INTRINSIC_TARGETS + 4 == H_RUNTIME_TARGETS &&
                    H_STORAGE_RESERVED + 4 == HEADER_BYTES &&
                    intrinsics.nccIntrinsics.selfTest();
            }

    fa:
        return true;
}
