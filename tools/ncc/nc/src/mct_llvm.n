use <io:output, render>;
use <project:ir, sema, diagnostics, native_types, mct_values>;

nccMctLlvm {
    const:
        PLAN_MAGIC >> int <- 0x504F434E;
        PLAN_VERSION >> int <- 1;
        HEADER_BYTES >> int <- 64;
        PASS_BYTES >> int <- 16;
        MAX_PASSES >> int <- 29;

        H_MAGIC >> int <- 0;
        H_VERSION >> int <- 4;
        H_LEVEL >> int <- 8;
        H_PROFILE >> int <- 12;
        H_PASSES >> int <- 16;
        H_BYTES >> int <- 20;
        H_HASH >> int <- 24;
        H_RAW_FLAGS >> int <- 28;
        H_VECTOR >> int <- 32;
        H_LTO >> int <- 36;
        H_PGO >> int <- 40;
        H_DEBUG >> int <- 44;
        H_RECORD_BYTES >> int <- 48;
        H_RECORDS_AT >> int <- 52;
        H_MAX_PASSES >> int <- 56;

        P_ID >> int <- 0;
        P_STAGE >> int <- 4;
        P_FLAGS >> int <- 8;
        P_ORDINAL >> int <- 12;

        LEVEL_O0 >> int <- 0;
        LEVEL_O1 >> int <- 1;
        LEVEL_O2 >> int <- 2;
        LEVEL_O3 >> int <- 3;
        LEVEL_OS >> int <- 4;
        LEVEL_OZ >> int <- 5;

        STAGE_VALIDATION >> int <- 1;
        STAGE_TARGET >> int <- 2;
        STAGE_MEMORY >> int <- 3;
        STAGE_OFFICIAL >> int <- 4;
        STAGE_FP >> int <- 5;
        STAGE_DEBUG >> int <- 6;
        STAGE_SCALAR >> int <- 7;
        STAGE_CFG >> int <- 8;
        STAGE_LOOP >> int <- 9;
        STAGE_VECTOR >> int <- 10;
        STAGE_LTO >> int <- 11;
        STAGE_PGO >> int <- 12;
        STAGE_SIZE >> int <- 13;

        FLAG_ENABLED >> int <- 1;
        FLAG_RAW_MAY_ALIAS >> int <- 2;
        FLAG_NO_IMPLICIT_TBAA >> int <- 4;
        FLAG_OBSERVABLE_MEMORY >> int <- 8;
        FLAG_DEBUG_PRESERVED >> int <- 16;

        TRANSFORM_MAGIC >> int <- 0x544F434E;
        TRANSFORM_VERSION >> int <- 7;
        TRANSFORM_HEADER_BYTES >> int <- 104;
        TRANSFORM_RECORD_BYTES >> int <- 24;

        T_MAGIC >> int <- 0;
        T_VERSION >> int <- 4;
        T_LEVEL >> int <- 8;
        T_NODES >> int <- 12;
        T_ELIMINATED >> int <- 16;
        T_CONSTANT_BRANCHES >> int <- 20;
        T_DEAD_CFG >> int <- 24;
        T_BEFORE_FINGERPRINT >> int <- 28;
        T_AFTER_FINGERPRINT >> int <- 32;
        T_BYTES >> int <- 36;
        T_HASH >> int <- 40;
        T_RECORD_BYTES >> int <- 44;
        T_RECORDS_AT >> int <- 48;
        T_RAW_FLAGS >> int <- 52;
        T_SSA_PROPAGATIONS >> int <- 56;
        T_DEAD_SCALAR_WRITES >> int <- 60;
        T_DEAD_FUNCTIONS >> int <- 64;
        T_CALL_EDGES >> int <- 68;
        T_LOOP_COLLAPSES >> int <- 72;
        T_ZERO_TRIP_LOOPS >> int <- 76;
        T_STRENGTH_REDUCTIONS >> int <- 80;
        T_INDUCTION_VARIABLES >> int <- 84;
        T_LOOP_INVARIANTS >> int <- 88;
        T_DERIVED_INDUCTIONS >> int <- 92;
        T_INLINED_CALLS >> int <- 96;
        T_GVN_REUSES >> int <- 100;

        TR_NODE >> int <- 0;
        TR_ACTION >> int <- 4;
        TR_OPCODE >> int <- 8;
        TR_AST_KIND >> int <- 12;
        TR_ORIGINAL_ROLE >> int <- 16;
        TR_REPLACEMENT_ROLE >> int <- 20;

        ACTION_KEEP >> int <- 0;
        ACTION_CONSTANT_BRANCH >> int <- 1;
        ACTION_DEAD_CFG >> int <- 2;
        ACTION_SSA_BRANCH >> int <- 3;
        ACTION_DEAD_SCALAR_WRITE >> int <- 4;
        ACTION_DEAD_FUNCTION >> int <- 5;
        ACTION_LOOP_COLLAPSE >> int <- 6;
        ACTION_ZERO_TRIP_LOOP >> int <- 7;
        ACTION_STRENGTH_REDUCTION >> int <- 8;
        ACTION_INDUCTION_VARIABLE >> int <- 9;
        ACTION_LOOP_INVARIANT >> int <- 10;
        ACTION_DERIVED_INDUCTION >> int <- 11;
        ACTION_INLINE_CALL >> int <- 12;
        ACTION_INLINE_SOURCE >> int <- 13;
        ACTION_INLINE_TEMP_SOURCE >> int <- 14;
        ACTION_GVN_REUSE >> int <- 15;
        ACTION_GVN_ELIMINATED >> int <- 16;
        ACTION_GVN_SOURCE >> int <- 17;

        ROLE_STRENGTH_SHL_BASE >> int <- 4096;
        ROLE_STRENGTH_SHR_U_BASE >> int <- 4160;
        ROLE_LICM_BASE >> int <- 4224;
        ROLE_INLINE_BASE >> int <- 8192;
        ROLE_GVN_SOURCE_BASE >> int <- 12288;
        ROLE_GVN_REUSE_BASE >> int <- 12304;

        MAX_INLINE_BODY_NODES >> int <- 12;
        MAX_INLINE_ARGUMENT_NODES >> int <- 8;
        MAX_INLINE_REMATERIALIZE_NODES >> int <- 2;
        MAX_INLINE_PARAMETER_USES >> int <- 4;
        MAX_INLINE_TEMPORARIES >> int <- 2;
        MAX_GVN_SLOTS >> int <- 2;

        EFFECT_CALL >> int <- 4;
        EFFECT_BRANCH >> int <- 8;
        EFFECT_TERMINATE >> int <- 16;
        EFFECT_MEMORY >> int <- 32;
        EFFECT_SUSPEND >> int <- 64;
        EFFECT_CLEANUP >> int <- 128;

        IR_FUNCTION >> int <- 2;
        IR_BRANCH >> int <- 12;
        IR_CALL >> int <- 8;
        IR_ENTRY >> int <- 19;
        AST_FUNCTION_DECL >> int <- 15;
        AST_PARAMETER_DECL >> int <- 16;
        AST_VALUE_DECL >> int <- 12;
        AST_BLOCK >> int <- 34;
        AST_STMT_EXPRESSION >> int <- 35;
        AST_STMT_ASSIGN >> int <- 36;
        AST_STMT_RETURN >> int <- 37;
        AST_STMT_IF >> int <- 38;
        AST_STMT_WHILE >> int <- 39;
        AST_STMT_FOR >> int <- 40;
        AST_STMT_BREAK >> int <- 43;
        AST_STMT_CONTINUE >> int <- 44;
        AST_STMT_LOOP >> int <- 55;
        AST_STMT_REPEAT >> int <- 56;
        AST_STMT_DO_WHILE >> int <- 57;
        AST_EXPR_LITERAL >> int <- 25;
        AST_EXPR_NAME >> int <- 26;
        AST_EXPR_UNARY >> int <- 27;
        AST_EXPR_BINARY >> int <- 28;
        AST_EXPR_CALL >> int <- 29;
        AST_EXPR_MEMBER >> int <- 30;
        AST_GENERIC_APPLY >> int <- 74;
        AST_ENTRY_REF >> int <- 17;
        TOKEN_TRUE >> int <- 76;
        TOKEN_FALSE >> int <- 77;
        TOKEN_LESS_DASH >> int <- 24;
        TOKEN_LESS >> int <- 27;
        TOKEN_LESS_EQ >> int <- 29;
        TOKEN_EQ >> int <- 30;
        TOKEN_PLUS_EQ >> int <- 37;
        TOKEN_MINUS_EQ >> int <- 40;
        TOKEN_STAR >> int <- 18;
        TOKEN_SLASH >> int <- 41;
        VIS_PUBLIC >> int <- 1;
        VIS_PRIVATE >> int <- 2;
        VIS_INTERNAL >> int <- 3;

    type:
        OptimizationContract {
            public:
                level >> int;
                passes >> int;
                bytes >> int;
                hash >> int;
                vectorized >> bool;
                lto >> bool;
                pgo >> bool;
        }

    stc:
        materializations >> u64 <- 0;
        materialBytes >> u64 <- 0;

    local:
        lastLevel >> int <- 0;
        lastPasses >> int <- 0;
        lastBytes >> int <- 0;
        lastHash >> int <- 0;

    fn:
        private:
            same(left >> str, right >> str) -> bool {
                a >> p<byte> <- cast<byte>(left);
                b >> p<byte> <- cast<byte>(right);
                at >> int <- 0;
                while (rd<byte>(off(a, at)) != 0 && rd<byte>(off(b, at)) != 0) {
                    if (rd<byte>(off(a, at)) != rd<byte>(off(b, at))) return false;
                    at += 1;
                }
                return rd<byte>(off(a, at)) == rd<byte>(off(b, at));
            }

            integer(base >> p<byte>, at >> int) -> int {
                return rd<int>(off(base, at));
            }

            putInteger(base >> p<byte>, at >> int, value >> int) -> void {
                wr<int>(off(base, at), value);
            }

            zero(base >> p<byte>, bytes >> int) -> void {
                at >> int <- 0;
                while (at < bytes) {
                    wr<byte>(off(base, at), 0);
                    at += 1;
                }
            }

            unsignedByte(value >> int) -> int {
                return value < 0 ? value + 256 : value;
            }

            hash(base >> p<byte>, bytes >> int) -> int {
                value >> int <- 104729;
                at >> int <- 0;
                while (at < bytes) {
                    value <- (value + unsignedByte(rd<byte>(off(base, at))) *
                        ((at % 251) + 1) + at * 17 + 1) % 1000000007;
                    at += 1;
                }
                return value;
            }

            profileCode(level >> int) -> int {
                if (level == LEVEL_O0) return 1;
                if (level == LEVEL_O1) return 2;
                if (level == LEVEL_O2) return 3;
                if (level == LEVEL_O3) return 4;
                if (level == LEVEL_OS) return 5;
                return 6;
            }

            writePass(blob >> p<byte>, ordinal >> int, id >> int,
                stage >> int, flags >> int) -> int {
                at >> int <- HEADER_BYTES + ordinal * PASS_BYTES;
                putInteger(blob, at + P_ID, id);
                putInteger(blob, at + P_STAGE, stage);
                putInteger(blob, at + P_FLAGS, flags | FLAG_ENABLED);
                putInteger(blob, at + P_ORDINAL, ordinal);
                return ordinal + 1;
            }

            writeBase(blob >> p<byte>, ordinal >> int) -> int {
                at >> int <- ordinal;
                at <- writePass(blob, at, 1, STAGE_VALIDATION, 0);
                at <- writePass(blob, at, 2, STAGE_TARGET, 0);
                at <- writePass(blob, at, 3, STAGE_MEMORY, FLAG_RAW_MAY_ALIAS);
                at <- writePass(blob, at, 4, STAGE_MEMORY, FLAG_NO_IMPLICIT_TBAA);
                at <- writePass(blob, at, 5, STAGE_MEMORY, FLAG_OBSERVABLE_MEMORY);
                at <- writePass(blob, at, 6, STAGE_OFFICIAL, 0);
                at <- writePass(blob, at, 7, STAGE_FP, 0);
                at <- writePass(blob, at, 8, STAGE_FP, 0);
                at <- writePass(blob, at, 9, STAGE_FP, 0);
                return writePass(blob, at, 10, STAGE_DEBUG, FLAG_DEBUG_PRESERVED);
            }

            writeScalar(blob >> p<byte>, ordinal >> int) -> int {
                at >> int <- ordinal;
                at <- writePass(blob, at, 11, STAGE_SCALAR, 0);
                at <- writePass(blob, at, 12, STAGE_SCALAR, 0);
                at <- writePass(blob, at, 13, STAGE_SCALAR, 0);
                at <- writePass(blob, at, 14, STAGE_CFG, 0);
                return writePass(blob, at, 15, STAGE_SCALAR, 0);
            }

            writeGlobal(blob >> p<byte>, ordinal >> int) -> int {
                at >> int <- ordinal;
                at <- writePass(blob, at, 16, STAGE_SCALAR, 0);
                at <- writePass(blob, at, 17, STAGE_SCALAR, 0);
                at <- writePass(blob, at, 18, STAGE_LOOP, 0);
                at <- writePass(blob, at, 19, STAGE_LOOP, 0);
                return writePass(blob, at, 20, STAGE_MEMORY, FLAG_RAW_MAY_ALIAS);
            }

            writeVector(blob >> p<byte>, ordinal >> int) -> int {
                at >> int <- writePass(blob, ordinal, 21, STAGE_VECTOR,
                    FLAG_RAW_MAY_ALIAS | FLAG_NO_IMPLICIT_TBAA);
                return writePass(blob, at, 22, STAGE_VECTOR,
                    FLAG_RAW_MAY_ALIAS | FLAG_NO_IMPLICIT_TBAA);
            }

            writeLtoPgo(blob >> p<byte>, ordinal >> int) -> int {
                at >> int <- writePass(blob, ordinal, 23, STAGE_LTO, 0);
                at <- writePass(blob, at, 24, STAGE_PGO, FLAG_DEBUG_PRESERVED);
                return writePass(blob, at, 25, STAGE_PGO, FLAG_DEBUG_PRESERVED);
            }

            writeAggressive(blob >> p<byte>, ordinal >> int) -> int {
                at >> int <- writePass(blob, ordinal, 26, STAGE_LOOP, 0);
                return writePass(blob, at, 27, STAGE_SCALAR, 0);
            }

            writeSize(blob >> p<byte>, ordinal >> int, level >> int) -> int {
                at >> int <- writePass(blob, ordinal, 28, STAGE_SIZE, 0);
                if (level == LEVEL_OS) at <- writePass(blob, at, 29, STAGE_SIZE, 0);
                return at;
            }

            valid(blob >> p<byte>) -> bool {
                guard blob != null else return false;
                bytes >> int <- integer(blob, H_BYTES);
                saved >> int <- integer(blob, H_HASH);
                putInteger(blob, H_HASH, 0);
                computed >> int <- hash(blob, bytes);
                putInteger(blob, H_HASH, saved);
                return integer(blob, H_MAGIC) == PLAN_MAGIC &&
                    integer(blob, H_VERSION) == PLAN_VERSION &&
                    integer(blob, H_RECORD_BYTES) == PASS_BYTES &&
                    integer(blob, H_RECORDS_AT) == HEADER_BYTES &&
                    integer(blob, H_PASSES) <= MAX_PASSES && saved == computed;
            }

            transformRecord(blob >> p<byte>, index >> int) -> p<byte> {
                return off(blob, TRANSFORM_HEADER_BYTES + index * TRANSFORM_RECORD_BYTES);
            }

            transformAction(blob >> p<byte>, index >> int) -> int {
                return integer(transformRecord(blob, index), TR_ACTION);
            }

            putTransformAction(blob >> p<byte>, index >> int, action >> int) -> bool {
                item >> p<byte> <- transformRecord(blob, index);
                guard integer(item, TR_ACTION) == ACTION_KEEP else return false;
                putInteger(item, TR_ACTION, action);
                return true;
            }

            putRoleAction(blob >> p<byte>, index >> int, action >> int,
                original >> int, replacement >> int) -> bool {
                item >> p<byte> <- transformRecord(blob, index);
                guard integer(item, TR_ACTION) == ACTION_KEEP else return false;
                putInteger(item, TR_ACTION, action);
                putInteger(item, TR_ORIGINAL_ROLE, original);
                putInteger(item, TR_REPLACEMENT_ROLE, replacement);
                return true;
            }

            putRewriteAction(blob >> p<byte>, index >> int, original >> int,
                replacement >> int) -> bool {
                return putRoleAction(blob, index, ACTION_STRENGTH_REDUCTION,
                    original, replacement);
            }

            descendantOf(graph >> p<byte>, node >> int, root >> int) -> bool {
                current >> int <- node;
                while (current >= 0) {
                    if (current == root) return true;
                    current <- ir.nccIr.graphNodeParent(graph, current);
                }
                return false;
            }

            markSubtree(graph >> p<byte>, blob >> p<byte>, root >> int,
                action >> int) -> int {
                guard root >= 0 else return 0;
                changed >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, root)) {
                        if (putTransformAction(blob, node, action)) changed += 1;
                    }
                    node += 1;
                }
                return changed;
            }

            functionOf(graph >> p<byte>, node >> int) -> int {
                current >> int <- node;
                while (current >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, current) ==
                        AST_FUNCTION_DECL) return current;
                    current <- ir.nccIr.graphNodeParent(graph, current);
                }
                return -1;
            }

            simpleWriteSymbol(graph >> p<byte>, statement >> int) -> int {
                kind >> int <- ir.nccIr.graphNodeAstKind(graph, statement);
                if (kind == AST_VALUE_DECL) return statement;
                guard kind == AST_STMT_ASSIGN else return -1;
                assignment >> int <- ir.nccIr.graphNodeRoleHash(graph, statement);
                guard assignment == TOKEN_LESS_DASH || assignment == TOKEN_EQ else
                    return -1;
                target >> int <- ir.nccIr.graphNodeFirstChild(graph, statement);
                return target >= 0 && ir.nccIr.graphNodeAstKind(graph, target) ==
                    AST_EXPR_NAME ? target : -1;
            }

            sameSymbol(graph >> p<byte>, left >> int, right >> int) -> bool {
                guard left >= 0 && right >= 0 else return false;
                leftBytes >> int <- ir.nccIr.graphNodeNameBytes(graph, left);
                rightBytes >> int <- ir.nccIr.graphNodeNameBytes(graph, right);
                if (leftBytes > 0 || rightBytes > 0)
                    return leftBytes > 0 && rightBytes > 0 &&
                        ir.nccIr.graphNodeNameEqual(graph, left, right);
                leftHash >> int <- ir.nccIr.graphNodeNameHash(graph, left);
                rightHash >> int <- ir.nccIr.graphNodeNameHash(graph, right);
                if (leftHash != 0 || rightHash != 0)
                    return leftHash != 0 && leftHash == rightHash;
                leftRole >> int <- ir.nccIr.graphNodeRoleHash(graph, left);
                rightRole >> int <- ir.nccIr.graphNodeRoleHash(graph, right);
                return leftRole != 0 && leftRole == rightRole;
            }

            writeValue(graph >> p<byte>, statement >> int) -> int {
                kind >> int <- ir.nccIr.graphNodeAstKind(graph, statement);
                if (kind == AST_VALUE_DECL) {
                    typeNode >> int <- ir.nccIr.graphNodeFirstChild(graph, statement);
                    return typeNode >= 0 ?
                        ir.nccIr.graphNodeNextSibling(graph, typeNode) : -1;
                }
                guard kind == AST_STMT_ASSIGN else return -1;
                target >> int <- ir.nccIr.graphNodeFirstChild(graph, statement);
                return target >= 0 ?
                    ir.nccIr.graphNodeNextSibling(graph, target) : -1;
            }

            uniqueLocalDeclaration(graph >> p<byte>, symbol >> int) -> int {
                owner >> int <- functionOf(graph, symbol);
                guard owner >= 0 else return -1;
                found >> int <- -1;
                matches >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, node) == AST_VALUE_DECL &&
                        functionOf(graph, node) == owner &&
                        sameSymbol(graph, node, symbol)) {
                        found <- node;
                        matches += 1;
                    }
                    node += 1;
                }
                return matches == 1 ? found : -1;
            }

            literalPowerShift(graph >> p<byte>, node >> int) -> int {
                guard node >= 0 && ir.nccIr.graphNodeAstKind(graph, node) ==
                    AST_EXPR_LITERAL else return -1;
                value >> int <- ir.nccIr.graphNodePositiveInteger(graph, node);
                guard value > 1 else return -1;
                shift >> int <- 0;
                while (value > 1 && value % 2 == 0) {
                    value <- value / 2;
                    shift += 1;
                }
                return value == 1 && shift < 32 ? shift : -1;
            }

            unsignedType(graph >> p<byte>, typeNode >> int) -> bool {
                return typeNode >= 0 && (
                    ir.nccIr.graphTextValue(graph, typeNode, "byte") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "u8") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "word") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "u16") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "dword") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "u32") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "qword") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "u64") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "usize") ||
                    ir.nccIr.graphTextValue(graph, typeNode, "addr"));
            }

            unsignedExpression(graph >> p<byte>, node >> int) -> bool {
                guard node >= 0 else return false;
                kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                if (kind == AST_EXPR_NAME) {
                    declaration >> int <- uniqueLocalDeclaration(graph, node);
                    typeNode >> int <- declaration >= 0 ?
                        ir.nccIr.graphNodeFirstChild(graph, declaration) : -1;
                    return unsignedType(graph, typeNode);
                }
                if (kind == AST_EXPR_BINARY) return unsignedExpression(
                    graph, ir.nccIr.graphNodeFirstChild(graph, node));
                return false;
            }

            subtreeEffects(graph >> p<byte>, root >> int) -> int {
                value >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, root) &&
                        !ir.nccIr.graphNodeOptimizedOut(graph, node))
                        value <- value | ir.nccIr.graphNodeEffects(graph, node);
                    node += 1;
                }
                return value;
            }

            assignmentTarget(graph >> p<byte>, node >> int) -> bool {
                parent >> int <- ir.nccIr.graphNodeParent(graph, node);
                return parent >= 0 &&
                    ir.nccIr.graphNodeAstKind(graph, parent) == AST_STMT_ASSIGN &&
                    ir.nccIr.graphNodeFirstChild(graph, parent) == node;
            }

            subtreeReadsSymbol(graph >> p<byte>, root >> int, symbol >> int) -> bool {
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, root) && node != symbol &&
                        !ir.nccIr.graphNodeOptimizedOut(graph, node) &&
                        ir.nccIr.graphNodeAstKind(graph, node) == AST_EXPR_NAME &&
                        !assignmentTarget(graph, node) &&
                        sameSymbol(graph, node, symbol)) return true;
                    node += 1;
                }
                return false;
            }

            symbolAddressTaken(graph >> p<byte>, declaration >> int) -> bool {
                owner >> int <- functionOf(graph, declaration);
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (functionOf(graph, node) == owner &&
                        ir.nccIr.graphNodeAstKind(graph, node) == AST_EXPR_NAME &&
                        sameSymbol(graph, node, declaration)) {
                        parent >> int <- ir.nccIr.graphNodeParent(graph, node);
                        if (parent >= 0 && ir.nccIr.graphNodeAstKind(graph, parent) ==
                            AST_EXPR_UNARY) return true;
                    }
                    node += 1;
                }
                return false;
            }

            writeFateAfter(graph >> p<byte>, statement >> int, symbol >> int) -> int {
                next >> int <- ir.nccIr.graphNodeNextSibling(graph, statement);
                while (next >= 0) {
                    if (subtreeReadsSymbol(graph, next, symbol)) return 0;
                    writer >> int <- simpleWriteSymbol(graph, next);
                    if (writer >= 0 && sameSymbol(graph, writer, symbol)) return 1;
                    effects >> int <- subtreeEffects(graph, next);
                    if ((effects & (EFFECT_CALL | EFFECT_BRANCH | EFFECT_SUSPEND |
                        EFFECT_CLEANUP)) != 0) return 0;
                    if (ir.nccIr.graphNodeAstKind(graph, next) == AST_STMT_ASSIGN &&
                        writer < 0) return 0;
                    if ((effects & EFFECT_TERMINATE) != 0) return 2;
                    next <- ir.nccIr.graphNodeNextSibling(graph, next);
                }
                return 2;
            }

            eliminateDeadScalarWrites(graph >> p<byte>, blob >> p<byte>) -> int {
                eliminated >> int <- 0;
                block >> int <- 0;
                while (block < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, block) == AST_BLOCK) {
                        statement >> int <- ir.nccIr.graphNodeFirstChild(graph, block);
                        while (statement >= 0) {
                            symbol >> int <- simpleWriteSymbol(graph, statement);
                            value >> int <- writeValue(graph, statement);
                            declaration >> int <- symbol >= 0 ?
                                uniqueLocalDeclaration(graph, symbol) : -1;
                            if (declaration >= 0 && value >= 0 &&
                                ir.nccIr.graphNodeAstKind(graph, value) == AST_EXPR_LITERAL &&
                                !symbolAddressTaken(graph, declaration) &&
                                transformAction(blob, statement) == ACTION_KEEP) {
                                fate >> int <- writeFateAfter(graph, statement, symbol);
                                if (fate == 1 && statement == declaration)
                                    eliminated += markSubtree(graph, blob, value,
                                        ACTION_DEAD_SCALAR_WRITE);
                                else if (fate > 0)
                                    eliminated += markSubtree(graph, blob, statement,
                                        ACTION_DEAD_SCALAR_WRITE);
                            }
                            statement <- ir.nccIr.graphNodeNextSibling(graph, statement);
                        }
                    }
                    block += 1;
                }
                return eliminated;
            }

            literalBoolean(graph >> p<byte>, node >> int) -> int {
                guard node >= 0 && ir.nccIr.graphNodeAstKind(graph, node) ==
                    AST_EXPR_LITERAL else return -1;
                role >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                if (role == TOKEN_TRUE) return 1;
                if (role == TOKEN_FALSE) return 0;
                return -1;
            }

            constantBefore(graph >> p<byte>, control >> int, symbol >> int) -> int {
                declaration >> int <- uniqueLocalDeclaration(graph, symbol);
                guard declaration >= 0 && !symbolAddressTaken(graph, declaration) else
                    return -1;
                block >> int <- ir.nccIr.graphNodeParent(graph, control);
                guard block >= 0 && ir.nccIr.graphNodeAstKind(graph, block) ==
                    AST_BLOCK else return -1;
                known >> int <- -1;
                statement >> int <- ir.nccIr.graphNodeFirstChild(graph, block);
                while (statement >= 0 && statement != control) {
                    writer >> int <- simpleWriteSymbol(graph, statement);
                    if (writer >= 0 && sameSymbol(graph, writer, symbol)) {
                        value >> int <- writeValue(graph, statement);
                        known <- literalBoolean(graph, value);
                    } else {
                        effects >> int <- subtreeEffects(graph, statement);
                        if ((effects & (EFFECT_CALL | EFFECT_BRANCH | EFFECT_SUSPEND |
                            EFFECT_CLEANUP)) != 0 ||
                            (ir.nccIr.graphNodeAstKind(graph, statement) ==
                            AST_STMT_ASSIGN && writer < 0)) known <- -1;
                    }
                    statement <- ir.nccIr.graphNodeNextSibling(graph, statement);
                }
                return known;
            }

            conditionBoolean(graph >> p<byte>, control >> int, condition >> int) -> int {
                direct >> int <- literalBoolean(graph, condition);
                if (direct >= 0) return direct;
                guard condition >= 0 && ir.nccIr.graphNodeAstKind(graph, condition) ==
                    AST_EXPR_NAME else return -1;
                propagated >> int <- constantBefore(graph, control, condition);
                return propagated >= 0 ? propagated + 2 : -1;
            }

            staticBoolean(graph >> p<byte>, node >> int) -> int {
                direct >> int <- literalBoolean(graph, node);
                if (direct >= 0) return direct;
                guard node >= 0 && ir.nccIr.graphNodeAstKind(graph, node) ==
                    AST_STMT_EXPRESSION else return -1;
                return literalBoolean(graph, ir.nccIr.graphNodeFirstChild(graph, node));
            }

            childWithFlag(graph >> p<byte>, parent >> int, flag >> int) -> int {
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, parent);
                while (child >= 0) {
                    if (ir.nccIr.graphNodeFlags(graph, child) == flag) return child;
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return -1;
            }

            directFinalBreak(graph >> p<byte>, body >> int) -> int {
                guard body >= 0 && ir.nccIr.graphNodeAstKind(graph, body) ==
                    AST_BLOCK else return -1;
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, body);
                guard child >= 0 else return -1;
                last >> int <- child;
                while (child >= 0) {
                    last <- child;
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return ir.nccIr.graphNodeAstKind(graph, last) ==
                    AST_STMT_BREAK ? last : -1;
            }

            exactOnceBody(graph >> p<byte>, body >> int, finalBreak >> int) -> bool {
                guard finalBreak >= 0 else return false;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (node != body && descendantOf(graph, node, body) &&
                        !descendantOf(graph, node, finalBreak)) {
                        effects >> int <- ir.nccIr.graphNodeEffects(graph, node);
                        if ((effects & (EFFECT_BRANCH | EFFECT_TERMINATE |
                            EFFECT_SUSPEND)) != 0) return false;
                    }
                    node += 1;
                }
                return true;
            }

            collapseExactOnce(graph >> p<byte>, blob >> p<byte>, loop >> int,
                condition >> int, step >> int, body >> int) -> bool {
                finalBreak >> int <- directFinalBreak(graph, body);
                guard exactOnceBody(graph, body, finalBreak) else return false;
                putTransformAction(blob, loop, ACTION_LOOP_COLLAPSE);
                markSubtree(graph, blob, condition, ACTION_LOOP_COLLAPSE);
                markSubtree(graph, blob, step, ACTION_LOOP_COLLAPSE);
                markSubtree(graph, blob, finalBreak, ACTION_LOOP_COLLAPSE);
                return true;
            }

            simplifyStaticLoops(graph >> p<byte>, blob >> p<byte>) -> int {
                changed >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                    if (kind == AST_STMT_WHILE) {
                        condition >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        body >> int <- condition >= 0 ?
                            ir.nccIr.graphNodeNextSibling(graph, condition) : -1;
                        resolved >> int <- conditionBoolean(graph, node, condition);
                        if (resolved >= 0 && resolved % 2 == 0) {
                            markSubtree(graph, blob, node, ACTION_ZERO_TRIP_LOOP);
                            changed += 1;
                        } else if (resolved >= 0 && resolved % 2 == 1 &&
                            collapseExactOnce(graph, blob, node, condition, -1, body))
                            changed += 1;
                    } else if (kind == AST_STMT_LOOP) {
                        body >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        if (collapseExactOnce(graph, blob, node, -1, -1, body))
                            changed += 1;
                    } else if (kind == AST_STMT_DO_WHILE ||
                        kind == AST_STMT_REPEAT) {
                        body >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        condition >> int <- body >= 0 ?
                            ir.nccIr.graphNodeNextSibling(graph, body) : -1;
                        resolved >> int <- staticBoolean(graph, condition);
                        stops >> bool <- (kind == AST_STMT_DO_WHILE && resolved == 0) ||
                            (kind == AST_STMT_REPEAT && resolved == 1);
                        if (stops) {
                            putTransformAction(blob, node, ACTION_LOOP_COLLAPSE);
                            markSubtree(graph, blob, condition, ACTION_LOOP_COLLAPSE);
                            changed += 1;
                        }
                    } else if (kind == AST_STMT_FOR) {
                        initializer >> int <- childWithFlag(graph, node, 1);
                        condition >> int <- childWithFlag(graph, node, 2);
                        step >> int <- childWithFlag(graph, node, 3);
                        body >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        while (body >= 0 && ir.nccIr.graphNodeAstKind(graph, body) !=
                            AST_BLOCK) {
                            body <- ir.nccIr.graphNodeNextSibling(graph, body);
                        }
                        resolved >> int <- staticBoolean(graph, condition);
                        if (initializer >= 0 && condition >= 0 && step >= 0 &&
                            body >= 0 && resolved == 0) {
                            putTransformAction(blob, node, ACTION_ZERO_TRIP_LOOP);
                            markSubtree(graph, blob, condition, ACTION_ZERO_TRIP_LOOP);
                            markSubtree(graph, blob, step, ACTION_ZERO_TRIP_LOOP);
                            markSubtree(graph, blob, body, ACTION_ZERO_TRIP_LOOP);
                            changed += 1;
                        } else if (initializer >= 0 && condition >= 0 && step >= 0 &&
                            body >= 0 && resolved == 1 && collapseExactOnce(
                            graph, blob, node, condition, step, body)) changed += 1;
                    }
                    node += 1;
                }
                return changed;
            }

            foldConstantBranches(graph >> p<byte>, blob >> p<byte>) -> int {
                folded >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                    if ((kind == AST_STMT_IF || kind == AST_STMT_WHILE) &&
                        transformAction(blob, node) == ACTION_KEEP) {
                        condition >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        resolved >> int <- conditionBoolean(graph, node, condition);
                        if (resolved >= 0) {
                            value >> int <- resolved % 2;
                            action >> int <- resolved >= 2 ?
                                ACTION_SSA_BRANCH : ACTION_CONSTANT_BRANCH;
                            putTransformAction(blob, node, action);
                            markSubtree(graph, blob, condition, action);
                            body >> int <- condition >= 0 ?
                                ir.nccIr.graphNodeNextSibling(graph, condition) : -1;
                            if (kind == AST_STMT_WHILE && value == 0) {
                                markSubtree(graph, blob, body, action);
                            } else if (kind == AST_STMT_IF) {
                                alternate >> int <- body >= 0 ?
                                    ir.nccIr.graphNodeNextSibling(graph, body) : -1;
                                if (value == 0) markSubtree(
                                    graph, blob, body, action);
                                else markSubtree(
                                    graph, blob, alternate, action);
                            }
                            folded += 1;
                        }
                    }
                    node += 1;
                }
                return folded;
            }

            isDirectTerminator(graph >> p<byte>, node >> int) -> bool {
                kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                return kind == AST_STMT_RETURN || kind == AST_STMT_BREAK ||
                    kind == AST_STMT_CONTINUE;
            }

            pruneAfterTerminators(graph >> p<byte>, blob >> p<byte>) -> int {
                pruned >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, node) == AST_BLOCK) {
                        child >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        terminated >> bool <- false;
                        while (child >= 0) {
                            if (terminated) pruned += markSubtree(
                                graph, blob, child, ACTION_DEAD_CFG);
                            else if (transformAction(blob, child) == ACTION_KEEP &&
                                isDirectTerminator(graph, child)) terminated <- true;
                            child <- ir.nccIr.graphNodeNextSibling(graph, child);
                        }
                    }
                    node += 1;
                }
                return pruned;
            }

            callSourceNode(graph >> p<byte>, call >> int) -> int {
                guard ir.nccIr.graphNodeAstKind(graph, call) == AST_EXPR_CALL else
                    return -1;
                source >> int <- ir.nccIr.graphNodeFirstChild(graph, call);
                if (source >= 0 && ir.nccIr.graphNodeAstKind(graph, source) ==
                    AST_GENERIC_APPLY)
                    return ir.nccIr.graphNodeFirstChild(graph, source);
                return source;
            }

            bytesEqual(left >> p<byte>, leftBytes >> int,
                right >> p<byte>, rightBytes >> int) -> bool {
                guard leftBytes == rightBytes else return false;
                at >> int <- 0;
                while (at < leftBytes) {
                    if (rd<byte>(off(left, at)) != rd<byte>(off(right, at)))
                        return false;
                    at += 1;
                }
                return true;
            }

            sameOwner(graph >> p<byte>, left >> int, right >> int) -> bool {
                guard left >= 0 && right >= 0 else return false;
                return bytesEqual(ir.nccIr.graphNodeOwner(graph, left),
                    ir.nccIr.graphNodeOwnerBytes(graph, left),
                    ir.nccIr.graphNodeOwner(graph, right),
                    ir.nccIr.graphNodeOwnerBytes(graph, right));
            }

            functionIndex(graph >> p<byte>) -> p<int> {
                nodes >> int <- ir.nccIr.graphNodes(graph);
                if (nodes < 0 || nodes > 536870910) return null;
                functions >> p<int> <- cast<int>(alloc((nodes+1)*sizeOf(int)));
                if (functions == null) return null;
                count >> int <- 0;
                node >> int <- 0;
                while (node < nodes) {
                    if (ir.nccIr.graphNodeOpcode(graph,node) == IR_FUNCTION) {
                        count += 1;
                        wr(off(functions,count),node);
                    }
                    node += 1;
                }
                wr(functions,count);
                return functions;
            }

            resolveUniqueFunction(graph >> p<byte>, reference >> int,
                functions >> p<int>) -> int {
                guard reference >= 0 && ir.nccIr.graphNodeNameBytes(
                    graph, reference) > 0 else return -1;
                found >> int <- -1;
                matches >> int <- 0;
                at >> int <- 1;
                while (at <= rd(functions)) {
                    node >> int <- rd(off(functions,at));
                    if (ir.nccIr.graphNodeNameEqual(graph, node, reference) &&
                        sameOwner(graph, node, reference)) {
                        found <- node;
                        matches += 1;
                    }
                    at += 1;
                }
                return matches == 1 ? found : -1;
            }

            resolveEntryFunction(graph >> p<byte>, reference >> int,
                functions >> p<int>) -> int {
                strict >> int <- resolveUniqueFunction(graph, reference,functions);
                if (strict >= 0) return strict;
                guard reference >= 0 && ir.nccIr.graphNodeNameBytes(
                    graph, reference) > 0 else return -1;
                found >> int <- -1;
                matches >> int <- 0;
                at >> int <- 1;
                while (at <= rd(functions)) {
                    node >> int <- rd(off(functions,at));
                    if ((ir.nccIr.graphNodeNameEqual(graph, node, reference) ||
                        (ir.nccIr.graphNodeRoleHash(graph, reference) != 0 &&
                        ir.nccIr.graphNodeNameHash(graph, node) ==
                            ir.nccIr.graphNodeRoleHash(graph, reference)))) {
                        found <- node;
                        matches += 1;
                    }
                    at += 1;
                }
                return matches == 1 ? found : -1;
            }

            inlineVisibilityAllowed(graph >> p<byte>, call >> int,
                target >> int) -> bool {
                caller >> int <- functionOf(graph, call);
                guard caller >= 0 && target >= 0 && caller != target else return false;
                visibility >> int <- ir.nccIr.graphNodeVisibility(graph, target);
                if (sameOwner(graph, caller, target)) return visibility == VIS_PRIVATE;
                return visibility == VIS_PUBLIC || visibility == VIS_INTERNAL;
            }

            reachableAt(reachable >> p<byte>, function >> int) -> bool {
                return function >= 0 && rd<byte>(off(reachable, function)) != 0;
            }

            markReachable(reachable >> p<byte>, function >> int) -> bool {
                guard function >= 0 && !reachableAt(reachable, function) else
                    return false;
                wr<byte>(off(reachable, function), 1);
                return true;
            }

            seedReachability(graph >> p<byte>, reachable >> p<byte>,
                functions >> p<int>) -> int {
                roots >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeOpcode(graph, node) == IR_FUNCTION &&
                        ir.nccIr.graphNodeVisibility(graph, node) != VIS_PRIVATE) {
                        if (markReachable(reachable, node)) roots += 1;
                    }
                    node += 1;
                }
                node <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, node) == AST_ENTRY_REF) {
                        function >> int <- resolveEntryFunction(graph, node,functions);
                        if (markReachable(reachable, function)) roots += 1;
                    }
                    node += 1;
                }
                return roots;
            }

            inlineCallSource(graph >> p<byte>, blob >> p<byte>, node >> int) -> bool {
                parent >> int <- ir.nccIr.graphNodeParent(graph, node);
                return parent >= 0 && transformAction(blob, parent) ==
                    ACTION_INLINE_CALL && callSourceNode(graph, parent) == node;
            }

            propagateReachability(graph >> p<byte>, blob >> p<byte>,
                reachable >> p<byte>, functions >> p<int>, references >> p<int>) -> int {
                nodes >> int <- ir.nccIr.graphNodes(graph);
                node >> int <- 0;
                while (node < nodes) {
                    owner >> int <- -1;
                    target >> int <- -1;
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph,node);
                    reference >> int <- -1;
                    if (kind == AST_EXPR_CALL && transformAction(blob,node) != ACTION_INLINE_CALL)
                        reference <- callSourceNode(graph,node);
                    else if ((kind == AST_EXPR_NAME || kind == AST_EXPR_MEMBER) &&
                        !inlineCallSource(graph,blob,node)) reference <- node;
                    if (reference >= 0) {
                        owner <- functionOf(graph,node);
                        if (owner >= 0) target <- resolveUniqueFunction(graph,reference,functions);
                    }
                    wr(off(references,node*2),owner);
                    wr(off(references,node*2+1),target);
                    node += 1;
                }
                changed >> bool <- true;
                while (changed) {
                    changed <- false;
                    node <- 0;
                    while (node < nodes) {
                        owner >> int <- rd(off(references,node*2));
                        target >> int <- rd(off(references,node*2+1));
                        // Any reachable function ancestor retains nested references, as before.
                        while (target >= 0 && owner >= 0 && !reachableAt(reachable,owner)) {
                            owner <- functionOf(graph,ir.nccIr.graphNodeParent(graph,owner));
                        }
                        if (target >= 0 && reachableAt(reachable,owner) &&
                            markReachable(reachable,target)) changed <- true;
                        node += 1;
                    }
                }
                edges >> int <- 0;
                call >> int <- 0;
                while (call < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, call) == AST_EXPR_CALL) {
                        owner >> int <- rd(off(references,call*2));
                        target >> int <- rd(off(references,call*2+1));
                        if (reachableAt(reachable, owner) && target >= 0 &&
                            transformAction(blob, call) != ACTION_INLINE_CALL) edges += 1;
                    }
                    call += 1;
                }
                return edges;
            }

            pruneDeadFunctions(graph >> p<byte>, blob >> p<byte>, functions >> p<int>) -> int {
                nodes >> int <- ir.nccIr.graphNodes(graph);
                reachable >> p<byte> <- cast<byte>(alloc(nodes));
                guard reachable != null else return 0;
                zero(reachable, nodes);
                roots >> int <- seedReachability(graph, reachable,functions);
                if (roots == 0) {
                    free(reachable);
                    return 0;
                }
                references >> p<int> <- cast<int>(alloc(nodes*2*sizeOf(int)));
                if (references == null) { free(reachable); return 0; }
                edges >> int <- propagateReachability(graph, blob, reachable,functions,references);
                free(references);
                function >> int <- 0;
                while (function < nodes) {
                    if (ir.nccIr.graphNodeOpcode(graph, function) == IR_FUNCTION &&
                        ir.nccIr.graphNodeVisibility(graph, function) == VIS_PRIVATE &&
                        !reachableAt(reachable, function))
                        markSubtree(graph, blob, function, ACTION_DEAD_FUNCTION);
                    function += 1;
                }
                free(reachable);
                return edges;
            }

            directFunctionBlock(graph >> p<byte>, function >> int) -> int {
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, function);
                found >> int <- -1;
                blocks >> int <- 0;
                while (child >= 0) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph, child);
                    if (kind == AST_BLOCK) {
                        found <- child;
                        blocks += 1;
                    }
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return blocks == 1 ? found : -1;
            }

            singleReturnExpression(graph >> p<byte>, function >> int) -> int {
                block >> int <- directFunctionBlock(graph, function);
                guard block >= 0 else return -1;
                statement >> int <- ir.nccIr.graphNodeFirstChild(graph, block);
                guard statement >= 0 && ir.nccIr.graphNodeAstKind(graph, statement) ==
                    AST_STMT_RETURN && ir.nccIr.graphNodeNextSibling(graph, statement) < 0
                    else return -1;
                expression >> int <- ir.nccIr.graphNodeFirstChild(graph, statement);
                return expression >= 0 &&
                    ir.nccIr.graphNodeNextSibling(graph, expression) < 0 ? expression : -1;
            }

            directParameterCount(graph >> p<byte>, function >> int) -> int {
                count >> int <- 0;
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, function);
                while (child >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, child) ==
                        AST_PARAMETER_DECL) count += 1;
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return count;
            }

            directParameterAt(graph >> p<byte>, function >> int,
                position >> int) -> int {
                at >> int <- 0;
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, function);
                while (child >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, child) ==
                        AST_PARAMETER_DECL) {
                        if (at == position) return child;
                        at += 1;
                    }
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return -1;
            }

            parameterPosition(graph >> p<byte>, function >> int,
                expression >> int) -> int {
                guard expression >= 0 && ir.nccIr.graphNodeAstKind(
                    graph, expression) == AST_EXPR_NAME else return -1;
                position >> int <- 0;
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, function);
                while (child >= 0) {
                    if (ir.nccIr.graphNodeAstKind(graph, child) ==
                        AST_PARAMETER_DECL) {
                        if (sameSymbol(graph, child, expression)) return position;
                        position += 1;
                    }
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return -1;
            }

            parameterUseCount(graph >> p<byte>, expression >> int,
                parameter >> int) -> int {
                uses >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, expression) &&
                        ir.nccIr.graphNodeAstKind(graph, node) == AST_EXPR_NAME &&
                        sameSymbol(graph, node, parameter)) uses += 1;
                    node += 1;
                }
                return uses;
            }

            callArgumentAt(graph >> p<byte>, call >> int, position >> int) -> int {
                source >> int <- ir.nccIr.graphNodeFirstChild(graph, call);
                guard source >= 0 else return -1;
                argument >> int <- ir.nccIr.graphNodeNextSibling(graph, source);
                at >> int <- 0;
                while (argument >= 0 && at < position) {
                    argument <- ir.nccIr.graphNodeNextSibling(graph, argument);
                    at += 1;
                }
                return argument;
            }

            callArgumentCount(graph >> p<byte>, call >> int) -> int {
                count >> int <- 0;
                argument >> int <- callArgumentAt(graph, call, 0);
                while (argument >= 0) {
                    count += 1;
                    argument <- ir.nccIr.graphNodeNextSibling(graph, argument);
                }
                return count;
            }

            inlineSubtreeAvailable(graph >> p<byte>, blob >> p<byte>,
                root >> int) -> bool {
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, root) &&
                        transformAction(blob, node) != ACTION_KEEP) return false;
                    node += 1;
                }
                return true;
            }

            pureInlineExpression(graph >> p<byte>, function >> int,
                root >> int) -> bool {
                guard root >= 0 else return false;
                count >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, root)) {
                        kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                        if (kind != AST_EXPR_LITERAL && kind != AST_EXPR_UNARY &&
                            kind != AST_EXPR_BINARY &&
                            (kind != AST_EXPR_NAME ||
                            parameterPosition(graph, function, node) < 0)) return false;
                        count += 1;
                    }
                    node += 1;
                }
                effects >> int <- subtreeEffects(graph, root);
                return count > 0 && count <= MAX_INLINE_BODY_NODES &&
                    (effects & (EFFECT_CALL |
                    EFFECT_BRANCH | EFFECT_TERMINATE | EFFECT_MEMORY |
                    EFFECT_SUSPEND | EFFECT_CLEANUP)) == 0;
            }

            pureInlineArgument(graph >> p<byte>, blob >> p<byte>,
                root >> int) -> bool {
                guard root >= 0 && inlineSubtreeAvailable(graph, blob, root) else
                    return false;
                count >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, root)) {
                        kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                        if (kind != AST_EXPR_LITERAL && kind != AST_EXPR_NAME &&
                            kind != AST_EXPR_UNARY && kind != AST_EXPR_BINARY)
                            return false;
                        count += 1;
                    }
                    node += 1;
                }
                effects >> int <- subtreeEffects(graph, root);
                return count > 0 && count <= MAX_INLINE_ARGUMENT_NODES &&
                    (effects & (EFFECT_CALL | EFFECT_BRANCH | EFFECT_TERMINATE |
                    EFFECT_MEMORY | EFFECT_SUSPEND | EFFECT_CLEANUP)) == 0;
            }

            rematerializableInlineArgument(graph >> p<byte>, blob >> p<byte>,
                root >> int) -> bool {
                guard pureInlineArgument(graph, blob, root) else return false;
                count >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, root)) {
                        kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                        if (kind != AST_EXPR_LITERAL && kind != AST_EXPR_UNARY)
                            return false;
                        count += 1;
                    }
                    node += 1;
                }
                return count > 0 && count <= MAX_INLINE_REMATERIALIZE_NODES;
            }

            inlineArgumentsMatch(graph >> p<byte>, blob >> p<byte>, call >> int,
                function >> int, expression >> int) -> bool {
                parameters >> int <- directParameterCount(graph, function);
                guard parameters == callArgumentCount(graph, call) else return false;
                position >> int <- 0;
                temporaries >> int <- 0;
                while (position < parameters) {
                    parameter >> int <- directParameterAt(graph, function, position);
                    argument >> int <- callArgumentAt(graph, call, position);
                    uses >> int <- parameterUseCount(graph, expression, parameter);
                    if (parameter < 0 || uses < 1 ||
                        uses > MAX_INLINE_PARAMETER_USES ||
                        !pureInlineArgument(graph, blob, argument)) return false;
                    if (uses > 1 && !rematerializableInlineArgument(
                        graph, blob, argument)) {
                        temporaries += 1;
                        if (temporaries > MAX_INLINE_TEMPORARIES) return false;
                    }
                    position += 1;
                }
                return true;
            }

            consumeInlineArguments(graph >> p<byte>, blob >> p<byte>,
                call >> int, function >> int, expression >> int) -> int {
                consumed >> int <- 0;
                position >> int <- 0;
                argument >> int <- callArgumentAt(graph, call, position);
                while (argument >= 0) {
                    parameter >> int <- directParameterAt(graph, function, position);
                    uses >> int <- parameterUseCount(graph, expression, parameter);
                    action >> int <- uses > 1 && !rematerializableInlineArgument(
                        graph, blob, argument) ? ACTION_INLINE_TEMP_SOURCE :
                        ACTION_INLINE_SOURCE;
                    consumed += markSubtree(
                        graph, blob, argument, action);
                    position += 1;
                    argument <- callArgumentAt(graph, call, position);
                }
                return consumed;
            }

            analyzeInlineCalls(graph >> p<byte>, blob >> p<byte>, functions >> p<int>) -> int {
                found >> int <- 0;
                call >> int <- 0;
                while (call < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, call) == AST_EXPR_CALL &&
                        transformAction(blob, call) == ACTION_KEEP) {
                        source >> int <- callSourceNode(graph, call);
                        target >> int <- resolveUniqueFunction(graph, source,functions);
                        expression >> int <- target >= 0 &&
                            inlineVisibilityAllowed(graph, call, target) ?
                            singleReturnExpression(graph, target) : -1;
                        if (source >= 0 && expression >= 0 &&
                            transformAction(blob, source) == ACTION_KEEP &&
                            inlineSubtreeAvailable(graph, blob, expression) &&
                            pureInlineExpression(graph, target, expression) &&
                            inlineArgumentsMatch(
                                graph, blob, call, target, expression)) {
                            replacement >> int <- ROLE_INLINE_BASE + expression;
                            if (putRoleAction(blob, call, ACTION_INLINE_CALL,
                                ir.nccIr.graphNodeRoleHash(graph, call), replacement) &&
                                putTransformAction(blob, source, ACTION_INLINE_SOURCE)) {
                                consumeInlineArguments(
                                    graph, blob, call, target, expression);
                                ir.nccIr.graphSetNodeRoleHash(graph, call, replacement);
                                found += 1;
                            }
                        }
                    }
                    call += 1;
                }
                return found;
            }

            actionNodes(blob >> p<byte>, nodes >> int, action >> int) -> int {
                count >> int <- 0;
                node >> int <- 0;
                while (node < nodes) {
                    if (transformAction(blob, node) == action) count += 1;
                    node += 1;
                }
                return count;
            }

            actionRoots(graph >> p<byte>, blob >> p<byte>, nodes >> int,
                action >> int) -> int {
                count >> int <- 0;
                node >> int <- 0;
                while (node < nodes) {
                    if (transformAction(blob, node) == action) {
                        parent >> int <- ir.nccIr.graphNodeParent(graph, node);
                        if (parent < 0 || transformAction(blob, parent) != action) count += 1;
                    }
                    node += 1;
                }
                return count;
            }

            branchActionRoots(graph >> p<byte>, blob >> p<byte>, nodes >> int,
                action >> int) -> int {
                count >> int <- 0;
                node >> int <- 0;
                while (node < nodes) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                    if ((kind == AST_STMT_IF || kind == AST_STMT_WHILE) &&
                        transformAction(blob, node) == action) count += 1;
                    node += 1;
                }
                return count;
            }

            loopActionCount(graph >> p<byte>, blob >> p<byte>, nodes >> int,
                action >> int) -> int {
                count >> int <- 0;
                node >> int <- 0;
                while (node < nodes) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                    loopNode >> bool <- kind == AST_STMT_WHILE || kind == AST_STMT_FOR ||
                        kind == AST_STMT_LOOP || kind == AST_STMT_REPEAT ||
                        kind == AST_STMT_DO_WHILE;
                    if (loopNode && transformAction(blob, node) == action) count += 1;
                    node += 1;
                }
                return count;
            }

            reduceStrength(graph >> p<byte>, blob >> p<byte>) -> int {
                changed >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (!ir.nccIr.graphNodeOptimizedOut(graph, node) &&
                        ir.nccIr.graphNodeAstKind(graph, node) == AST_EXPR_BINARY &&
                        transformAction(blob, node) == ACTION_KEEP) {
                        role >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                        left >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        right >> int <- left >= 0 ?
                            ir.nccIr.graphNodeNextSibling(graph, left) : -1;
                        shift >> int <- literalPowerShift(graph, right);
                        replacement >> int <- -1;
                        if (shift > 0 && role == TOKEN_STAR)
                            replacement <- ROLE_STRENGTH_SHL_BASE + shift;
                        else if (shift > 0 && role == TOKEN_SLASH &&
                            unsignedExpression(graph, left))
                            replacement <- ROLE_STRENGTH_SHR_U_BASE + shift;
                        if (replacement >= 0) {
                            recorded >> bool <- putRewriteAction(
                                blob, node, role, replacement);
                            if (recorded) {
                                if (ir.nccIr.graphSetNodeRoleHash(
                                    graph, node, replacement)) changed += 1;
                            }
                        }
                    }
                    node += 1;
                }
                return changed;
            }

            unitStepInBody(graph >> p<byte>, body >> int, symbol >> int) -> bool {
                matches >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, body) &&
                        ir.nccIr.graphNodeAstKind(graph, node) == AST_STMT_ASSIGN &&
                        !ir.nccIr.graphNodeOptimizedOut(graph, node)) {
                        role >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                        target >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        value >> int <- target >= 0 ?
                            ir.nccIr.graphNodeNextSibling(graph, target) : -1;
                        if ((role == TOKEN_PLUS_EQ || role == TOKEN_MINUS_EQ) &&
                            sameSymbol(graph, target, symbol) &&
                            value >= 0 && ir.nccIr.graphTextValue(graph, value, "1"))
                            matches += 1;
                    }
                    node += 1;
                }
                return matches == 1;
            }

            positiveStepLiteral(graph >> p<byte>, node >> int) -> bool {
                guard node >= 0 && ir.nccIr.graphNodeAstKind(graph, node) ==
                    AST_EXPR_LITERAL else return false;
                return ir.nccIr.graphNodePositiveInteger(graph, node) > 0;
            }

            declaredBeforeLoop(graph >> p<byte>, declaration >> int,
                loopNode >> int) -> bool {
                block >> int <- ir.nccIr.graphNodeParent(graph, loopNode);
                guard declaration >= 0 && block >= 0 &&
                    ir.nccIr.graphNodeParent(graph, declaration) == block else return false;
                statement >> int <- ir.nccIr.graphNodeFirstChild(graph, block);
                while (statement >= 0 && statement != loopNode) {
                    if (statement == declaration) return true;
                    statement <- ir.nccIr.graphNodeNextSibling(graph, statement);
                }
                return false;
            }

            constantStepCount(graph >> p<byte>, body >> int, symbol >> int) -> int {
                matches >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, body) &&
                        ir.nccIr.graphNodeAstKind(graph, node) == AST_STMT_ASSIGN &&
                        !ir.nccIr.graphNodeOptimizedOut(graph, node)) {
                        role >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                        target >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        value >> int <- target >= 0 ?
                            ir.nccIr.graphNodeNextSibling(graph, target) : -1;
                        if ((role == TOKEN_PLUS_EQ || role == TOKEN_MINUS_EQ) &&
                            sameSymbol(graph, target, symbol) &&
                            positiveStepLiteral(graph, value)) matches += 1;
                    }
                    node += 1;
                }
                return matches;
            }

            symbolWrittenInBody(graph >> p<byte>, body >> int, symbol >> int) -> bool {
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, body)) {
                        writer >> int <- simpleWriteSymbol(graph, node);
                        if (writer >= 0 && sameSymbol(graph, writer, symbol)) return true;
                    }
                    node += 1;
                }
                return false;
            }

            scalarInvariantTree(graph >> p<byte>, root >> int, body >> int) -> bool {
                names >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (descendantOf(graph, node, root) &&
                        !ir.nccIr.graphNodeOptimizedOut(graph, node)) {
                        kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                        if (kind == AST_EXPR_NAME) {
                            declaration >> int <- uniqueLocalDeclaration(graph, node);
                            if (declaration < 0 || descendantOf(graph, declaration, body) ||
                                symbolAddressTaken(graph, declaration) ||
                                symbolWrittenInBody(graph, body, node)) return false;
                            names += 1;
                        } else if (kind != AST_EXPR_BINARY &&
                            kind != AST_EXPR_LITERAL) return false;
                    }
                    node += 1;
                }
                effects >> int <- subtreeEffects(graph, root);
                return names > 0 && (effects & (EFFECT_CALL | EFFECT_BRANCH |
                    EFFECT_TERMINATE | EFFECT_MEMORY | EFFECT_SUSPEND |
                    EFFECT_CLEANUP)) == 0;
            }

            invariantValueRoot(graph >> p<byte>, node >> int) -> bool {
                current >> int <- ir.nccIr.graphNodeParent(graph, node);
                while (current >= 0) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph, current);
                    if (kind == AST_VALUE_DECL || kind == AST_STMT_ASSIGN)
                        return true;
                    if (kind == AST_EXPR_BINARY || kind == AST_BLOCK) return false;
                    current <- ir.nccIr.graphNodeParent(graph, current);
                }
                return false;
            }

            analyzeInductions(graph >> p<byte>, blob >> p<byte>) -> int {
                found >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, node) == AST_STMT_WHILE &&
                        !ir.nccIr.graphNodeOptimizedOut(graph, node) &&
                        transformAction(blob, node) == ACTION_KEEP) {
                        condition >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                        body >> int <- condition >= 0 ?
                            ir.nccIr.graphNodeNextSibling(graph, condition) : -1;
                        role >> int <- condition >= 0 ?
                            ir.nccIr.graphNodeRoleHash(graph, condition) : 0;
                        symbol >> int <- condition >= 0 ?
                            ir.nccIr.graphNodeFirstChild(graph, condition) : -1;
                        valid >> bool <- false;
                        if (condition >= 0 && body >= 0) {
                            if (ir.nccIr.graphNodeAstKind(graph, condition) ==
                                AST_EXPR_BINARY && (role == TOKEN_LESS ||
                                role == TOKEN_LESS_EQ) && symbol >= 0) {
                                if (ir.nccIr.graphNodeAstKind(graph, symbol) ==
                                    AST_EXPR_NAME &&
                                    uniqueLocalDeclaration(graph, symbol) >= 0)
                                    valid <- unitStepInBody(graph, body, symbol);
                            }
                        }
                        if (valid) {
                            if (putTransformAction(
                                blob, node, ACTION_INDUCTION_VARIABLE)) found += 1;
                        }
                    }
                    node += 1;
                }
                return found;
            }

            analyzeDerivedInductions(graph >> p<byte>, blob >> p<byte>) -> int {
                found >> int <- 0;
                loopNode >> int <- 0;
                while (loopNode < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, loopNode) == AST_STMT_WHILE &&
                        transformAction(blob, loopNode) == ACTION_INDUCTION_VARIABLE) {
                        condition >> int <- ir.nccIr.graphNodeFirstChild(graph, loopNode);
                        body >> int <- condition >= 0 ?
                            ir.nccIr.graphNodeNextSibling(graph, condition) : -1;
                        primary >> int <- condition >= 0 ?
                            ir.nccIr.graphNodeFirstChild(graph, condition) : -1;
                        node >> int <- 0;
                        while (node < ir.nccIr.graphNodes(graph)) {
                            if (body >= 0 && descendantOf(graph, node, body) &&
                                ir.nccIr.graphNodeAstKind(graph, node) == AST_STMT_ASSIGN &&
                                transformAction(blob, node) == ACTION_KEEP) {
                                role >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                                target >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                                value >> int <- target >= 0 ?
                                    ir.nccIr.graphNodeNextSibling(graph, target) : -1;
                                declaration >> int <- target >= 0 ?
                                    uniqueLocalDeclaration(graph, target) : -1;
                                if ((role == TOKEN_PLUS_EQ || role == TOKEN_MINUS_EQ) &&
                                    target >= 0 && !sameSymbol(graph, target, primary) &&
                                    positiveStepLiteral(graph, value) &&
                                    declaredBeforeLoop(graph, declaration, loopNode) &&
                                    constantStepCount(graph, body, target) == 1) {
                                    if (putTransformAction(blob, node,
                                        ACTION_DERIVED_INDUCTION)) found += 1;
                                }
                            }
                            node += 1;
                        }
                    }
                    loopNode += 1;
                }
                return found;
            }

            analyzeLoopInvariants(graph >> p<byte>, blob >> p<byte>) -> int {
                found >> int <- 0;
                loopNode >> int <- 0;
                while (loopNode < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, loopNode) == AST_STMT_WHILE &&
                        transformAction(blob, loopNode) == ACTION_INDUCTION_VARIABLE) {
                        condition >> int <- ir.nccIr.graphNodeFirstChild(graph, loopNode);
                        body >> int <- condition >= 0 ?
                            ir.nccIr.graphNodeNextSibling(graph, condition) : -1;
                        node >> int <- 0;
                        while (node < ir.nccIr.graphNodes(graph)) {
                            if (body >= 0 && descendantOf(graph, node, body) &&
                                ir.nccIr.graphNodeAstKind(graph, node) == AST_EXPR_BINARY &&
                                transformAction(blob, node) == ACTION_KEEP &&
                                invariantValueRoot(graph, node)) {
                                role >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                                if (role > 0 && role < 128 &&
                                    scalarInvariantTree(graph, node, body)) {
                                    replacement >> int <- ROLE_LICM_BASE + role;
                                    recorded >> bool <- putRoleAction(blob, node,
                                        ACTION_LOOP_INVARIANT, role, replacement);
                                    if (recorded && ir.nccIr.graphSetNodeRoleHash(
                                        graph, node, replacement)) found += 1;
                                }
                            }
                            node += 1;
                        }
                    }
                    loopNode += 1;
                }
                return found;
            }

            expressionRole(graph >> p<byte>, blob >> p<byte>, node >> int) -> int {
                return ir.nccIr.graphNodeRoleHash(graph, node);
            }

            gvnEvaluationType(graph >> p<byte>, node >> int) -> int {
                parent >> int <- ir.nccIr.graphNodeParent(graph,node);
                kind >> int <- ir.nccIr.graphNodeAstKind(graph,parent);
                declaration >> int <- kind == AST_STMT_ASSIGN ?
                    mct_values.nccMctValues.resolve(graph,ir.nccIr.graphNodeFirstChild(graph,parent)) : parent;
                return native_types.nccNativeTypes.code(graph,native_types.nccNativeTypes.typeNode(graph,declaration));
            }
            gvnParametersValid(graph >> p<byte>, node >> int, function >> int) -> bool {
                kind >> int <- ir.nccIr.graphNodeAstKind(graph,node);
                if (kind == AST_EXPR_NAME) {
                    declaration >> int <- mct_values.nccMctValues.resolve(graph,node);
                    return ir.nccIr.graphNodeAstKind(graph,declaration) == AST_PARAMETER_DECL &&
                        functionOf(graph,declaration) == function &&
                        native_types.nccNativeTypes.code(graph,native_types.nccNativeTypes.typeNode(graph,declaration)) != 34 &&
                        !native_types.nccNativeTypes.floating(native_types.nccNativeTypes.code(graph,native_types.nccNativeTypes.typeNode(graph,declaration)));
                }
                if (kind == AST_EXPR_UNARY) {
                    role >> int <- ir.nccIr.graphNodeRoleHash(graph,node);
                    if (role != 35 && role != 38 && role != 33 && role != 34) return false;
                }
                child >> int <- ir.nccIr.graphNodeFirstChild(graph,node);
                while (child >= 0) {
                    if (!gvnParametersValid(graph,child,function)) return false;
                    child = ir.nccIr.graphNodeNextSibling(graph,child);
                }
                return true;
            }
            gvnReadsDeclaration(graph >> p<byte>, node >> int, declaration >> int) -> bool {
                if (ir.nccIr.graphNodeAstKind(graph,node) == AST_EXPR_NAME &&
                    mct_values.nccMctValues.resolve(graph,node) == declaration) return true;
                child >> int <- ir.nccIr.graphNodeFirstChild(graph,node);
                while (child >= 0) {
                    if (gvnReadsDeclaration(graph,child,declaration)) return true;
                    child = ir.nccIr.graphNodeNextSibling(graph,child);
                }
                return false;
            }
            gvnSourceWritesOperand(graph >> p<byte>, statement >> int, value >> int) -> bool {
                if (ir.nccIr.graphNodeAstKind(graph,statement) != AST_STMT_ASSIGN) return false;
                target >> int <- ir.nccIr.graphNodeFirstChild(graph,statement);
                declaration >> int <- mct_values.nccMctValues.resolve(graph,target);
                return declaration < 0 || gvnReadsDeclaration(graph,value,declaration);
            }

            sameExpressionTree(graph >> p<byte>, blob >> p<byte>,
                left >> int, right >> int) -> bool {
                guard left >= 0 && right >= 0 else return false;
                if (ir.nccIr.graphNodeAstKind(graph, left) !=
                    ir.nccIr.graphNodeAstKind(graph, right) ||
                    ir.nccIr.graphNodeTypeHash(graph, left) !=
                    ir.nccIr.graphNodeTypeHash(graph, right) ||
                    expressionRole(graph, blob, left) !=
                    expressionRole(graph, blob, right)) return false;
                kind >> int <- ir.nccIr.graphNodeAstKind(graph, left);
                if ((kind == AST_EXPR_LITERAL || kind == AST_EXPR_NAME) &&
                    !sameSymbol(graph, left, right)) return false;
                leftChild >> int <- ir.nccIr.graphNodeFirstChild(graph, left);
                rightChild >> int <- ir.nccIr.graphNodeFirstChild(graph, right);
                while (leftChild >= 0 && rightChild >= 0) {
                    if (!sameExpressionTree(
                        graph, blob, leftChild, rightChild)) return false;
                    leftChild <- ir.nccIr.graphNodeNextSibling(graph, leftChild);
                    rightChild <- ir.nccIr.graphNodeNextSibling(graph, rightChild);
                }
                return leftChild < 0 && rightChild < 0;
            }

            gvnValueRoot(graph >> p<byte>, node >> int) -> bool {
                kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                guard kind == AST_EXPR_UNARY || kind == AST_EXPR_BINARY else return false;
                parent >> int <- ir.nccIr.graphNodeParent(graph, node);
                guard parent >= 0 else return false;
                parentKind >> int <- ir.nccIr.graphNodeAstKind(graph, parent);
                if (parentKind == AST_VALUE_DECL || parentKind == AST_STMT_RETURN ||
                    parentKind == AST_STMT_EXPRESSION) return true;
                if (parentKind == AST_STMT_ASSIGN) {
                    target >> int <- ir.nccIr.graphNodeFirstChild(graph, parent);
                    return target >= 0 && ir.nccIr.graphNodeNextSibling(
                        graph, target) == node;
                }
                return false;
            }

            gvnCandidate(graph >> p<byte>, blob >> p<byte>, node >> int) -> bool {
                guard node >= 0 && transformAction(blob, node) == ACTION_KEEP &&
                    gvnValueRoot(graph, node) else return false;
                role >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                function >> int <- functionOf(graph, node);
                evaluation >> int <- gvnEvaluationType(graph,node);
                return role > 0 && role < ROLE_STRENGTH_SHL_BASE &&
                    !native_types.nccNativeTypes.floating(evaluation) &&
                    ir.nccIr.graphNodeGvnSource(graph,node) < 0 && evaluation > 0 && evaluation < 100000 &&
                    function >= 0 && ir.nccIr.graphNodeBlockId(graph, node) >= 0 &&
                    inlineSubtreeAvailable(graph, blob, node) &&
                    gvnParametersValid(graph,node,function) &&
                    pureInlineExpression(graph, function, node);
            }

            gvnStatementBarrier(graph >> p<byte>, statement >> int) -> bool {
                effects >> int <- subtreeEffects(graph, statement);
                return ir.nccIr.graphNodeAstKind(graph, statement) ==
                    AST_STMT_ASSIGN || (effects & (EFFECT_CALL | EFFECT_BRANCH |
                    EFFECT_TERMINATE | EFFECT_MEMORY | EFFECT_SUSPEND |
                    EFFECT_CLEANUP)) != 0;
            }

            gvnBarrierBetweenStatements(graph >> p<byte>, left >> int,
                right >> int) -> bool {
                statement >> int <- ir.nccIr.graphNodeNextSibling(graph, left);
                while (statement >= 0 && statement != right) {
                    if (gvnStatementBarrier(graph, statement)) return true;
                    statement <- ir.nccIr.graphNodeNextSibling(graph, statement);
                }
                return statement != right;
            }

            gvnSourceSlot(graph >> p<byte>, blob >> p<byte>, block >> int) -> int {
                used >> int <- 0;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeBlockId(graph, node) == block &&
                        transformAction(blob, node) == ACTION_GVN_SOURCE) used += 1;
                    node += 1;
                }
                return used < MAX_GVN_SLOTS ? used : -1;
            }

            markGvnDuplicate(graph >> p<byte>, blob >> p<byte>, root >> int,
                source >> int, slot >> int, type >> int) -> bool {
                original >> int <- ir.nccIr.graphNodeRoleHash(graph, root);
                replacement >> int <- ROLE_GVN_REUSE_BASE + slot;
                guard putRoleAction(blob, root, ACTION_GVN_REUSE,
                    original, replacement) else return false;
                guard ir.nccIr.graphSetNodeGvn(graph,root,source,slot,type) else return false;
                node >> int <- 0;
                while (node < ir.nccIr.graphNodes(graph)) {
                    if (node != root && descendantOf(graph, node, root))
                        putTransformAction(blob, node, ACTION_GVN_ELIMINATED);
                    node += 1;
                }
                return true;
            }

            analyzeGlobalValueNumbers(graph >> p<byte>, blob >> p<byte>) -> int {
                reuses >> int <- 0;
                block >> int <- 0;
                while (block < ir.nccIr.graphNodes(graph)) {
                    if (ir.nccIr.graphNodeAstKind(graph, block) == AST_BLOCK) {
                        statement >> int <- ir.nccIr.graphNodeFirstChild(graph, block);
                        while (statement >= 0) {
                            value >> int <- writeValue(graph, statement);
                            if (gvnCandidate(graph, blob, value)) {
                                previousStatement >> int <-
                                    ir.nccIr.graphNodeFirstChild(graph, block);
                                matched >> bool <- false;
                                while (previousStatement >= 0 &&
                                    previousStatement != statement && !matched) {
                                    previous >> int <- writeValue(
                                        graph, previousStatement);
                                    action >> int <- previous >= 0 ?
                                        transformAction(blob, previous) : ACTION_KEEP;
                                    priorRole >> int <- previous >= 0 ?
                                        ir.nccIr.graphNodeRoleHash(graph, previous) : 0;
                                    source >> bool <- action == ACTION_GVN_SOURCE;
                                    available >> bool <- previous >= 0 &&
                                        (action == ACTION_KEEP || source);
                                    if (available && (source || gvnCandidate(
                                        graph, blob, previous)) &&
                                        !gvnSourceWritesOperand(graph,previousStatement,previous) &&
                                        !gvnBarrierBetweenStatements(graph,
                                            previousStatement, statement) &&
                                        sameExpressionTree(
                                            graph, blob, previous, value) &&
                                        gvnEvaluationType(graph,previous) == gvnEvaluationType(graph,value)) {
                                        slot >> int <- source ?
                                            ir.nccIr.graphNodeGvnSlot(graph,previous) :
                                            gvnSourceSlot(graph, blob, block);
                                        if (slot >= 0 && slot < MAX_GVN_SLOTS) {
                                            if (!source) {
                                                original >> int <- priorRole;
                                                replacement >> int <-
                                                    ROLE_GVN_SOURCE_BASE + slot;
                                                if (putRoleAction(blob, previous,
                                                    ACTION_GVN_SOURCE, original,
                                                    replacement))
                                                    ir.nccIr.graphSetNodeGvn(graph,previous,previous,slot,gvnEvaluationType(graph,previous));
                                            }
                                            if (markGvnDuplicate(
                                                graph, blob, value, previous, slot, gvnEvaluationType(graph,value))) {
                                                reuses += 1;
                                                matched <- true;
                                            }
                                        }
                                    }
                                    previousStatement <-
                                        ir.nccIr.graphNodeNextSibling(
                                            graph, previousStatement);
                                }
                            }
                            statement <- ir.nccIr.graphNodeNextSibling(
                                graph, statement);
                        }
                    }
                    block += 1;
                }
                return reuses;
            }

            applyTransform(graph >> p<byte>, blob >> p<byte>, nodes >> int) -> int {
                eliminated >> int <- 0;
                node >> int <- 0;
                while (node < nodes) {
                    action >> int <- transformAction(blob, node);
                    if ((action > ACTION_KEEP && action <= ACTION_ZERO_TRIP_LOOP) ||
                        action == ACTION_INLINE_SOURCE ||
                        action == ACTION_INLINE_TEMP_SOURCE ||
                        action == ACTION_GVN_ELIMINATED) {
                        ir.nccIr.graphSetNodeOptimizedOut(graph, node, true);
                        eliminated += 1;
                    }
                    node += 1;
                }
                return eliminated;
            }

            validTransform(blob >> p<byte>) -> bool {
                guard blob != null else return false;
                bytesValue >> int <- integer(blob, T_BYTES);
                saved >> int <- integer(blob, T_HASH);
                putInteger(blob, T_HASH, 0);
                computed >> int <- hash(blob, bytesValue);
                putInteger(blob, T_HASH, saved);
                return integer(blob, T_MAGIC) == TRANSFORM_MAGIC &&
                    integer(blob, T_VERSION) == TRANSFORM_VERSION &&
                    integer(blob, T_RECORD_BYTES) == TRANSFORM_RECORD_BYTES &&
                    integer(blob, T_RECORDS_AT) == TRANSFORM_HEADER_BYTES &&
                    integer(blob, T_ELIMINATED) <= integer(blob, T_NODES) &&
                    integer(blob, T_SSA_PROPAGATIONS) <=
                        integer(blob, T_CONSTANT_BRANCHES) &&
                    integer(blob, T_DEAD_SCALAR_WRITES) <=
                        integer(blob, T_ELIMINATED) &&
                    integer(blob, T_DEAD_FUNCTIONS) <=
                        integer(blob, T_ELIMINATED) &&
                    integer(blob, T_LOOP_COLLAPSES) <=
                        integer(blob, T_ELIMINATED) &&
                    integer(blob, T_ZERO_TRIP_LOOPS) <=
                        integer(blob, T_ELIMINATED) &&
                    integer(blob, T_STRENGTH_REDUCTIONS) <=
                        integer(blob, T_NODES) &&
                    integer(blob, T_INDUCTION_VARIABLES) <=
                        integer(blob, T_NODES) &&
                    integer(blob, T_INLINED_CALLS) <= integer(blob, T_NODES) &&
                    integer(blob, T_GVN_REUSES) <= integer(blob, T_NODES) &&
                    saved == computed;
            }

            emitTransformReport(blob >> p<byte>, targetName >> str,
                json >> bool) -> bool {
                if (!json) {
                    print("LLVM transform target="); print(targetName);
                    print(" level="); print(levelName(integer(blob, T_LEVEL)));
                    print(" nodes="); print(renderInt(integer(blob, T_NODES)));
                    print(" eliminated="); println(renderInt(integer(blob, T_ELIMINATED)));
                    return true;
                }
                print("{\"schema\":\"nc.bootstrap.mct.llvm-transform.v7\"");
                print(",\"target\":\""); print(targetName); print("\"");
                print(",\"level\":\""); print(levelName(integer(blob, T_LEVEL))); print("\"");
                print(",\"nodes\":"); print(renderInt(integer(blob, T_NODES)));
                print(",\"eliminated\":"); print(renderInt(integer(blob, T_ELIMINATED)));
                print(",\"constant_branches\":"); print(renderInt(
                    integer(blob, T_CONSTANT_BRANCHES)));
                print(",\"dead_cfg_nodes\":"); print(renderInt(integer(blob, T_DEAD_CFG)));
                print(",\"ssa_propagations\":"); print(renderInt(
                    integer(blob, T_SSA_PROPAGATIONS)));
                print(",\"dead_scalar_writes\":"); print(renderInt(
                    integer(blob, T_DEAD_SCALAR_WRITES)));
                print(",\"dead_functions\":"); print(renderInt(
                    integer(blob, T_DEAD_FUNCTIONS)));
                print(",\"local_call_edges\":"); print(renderInt(
                    integer(blob, T_CALL_EDGES)));
                print(",\"loop_collapses\":"); print(renderInt(
                    integer(blob, T_LOOP_COLLAPSES)));
                print(",\"zero_trip_loops\":"); print(renderInt(
                    integer(blob, T_ZERO_TRIP_LOOPS)));
                print(",\"strength_reductions\":"); print(renderInt(
                    integer(blob, T_STRENGTH_REDUCTIONS)));
                print(",\"induction_variables\":"); print(renderInt(
                    integer(blob, T_INDUCTION_VARIABLES)));
                print(",\"loop_invariants\":"); print(renderInt(
                    integer(blob, T_LOOP_INVARIANTS)));
                print(",\"derived_inductions\":"); print(renderInt(
                    integer(blob, T_DERIVED_INDUCTIONS)));
                print(",\"inlined_calls\":"); print(renderInt(
                    integer(blob, T_INLINED_CALLS)));
                print(",\"gvn_reuses\":"); print(renderInt(
                    integer(blob, T_GVN_REUSES)));
                print(",\"before_fingerprint\":"); print(renderInt(
                    integer(blob, T_BEFORE_FINGERPRINT)));
                print(",\"after_fingerprint\":"); print(renderInt(
                    integer(blob, T_AFTER_FINGERPRINT)));
                print(",\"raw_may_alias\":true");
                print(",\"observable_memory_preserved\":true");
                print(",\"bytes\":"); print(renderInt(integer(blob, T_BYTES)));
                print(",\"hash\":"); print(renderInt(integer(blob, T_HASH)));
                println("}");
                return true;
            }

            emitReport(blob >> p<byte>, json >> bool) -> bool {
                level >> int <- integer(blob, H_LEVEL);
                if (!json) {
                    print("LLVM optimization level="); print(levelName(level));
                    print(" passes="); print(renderInt(integer(blob, H_PASSES)));
                    print(" bytes="); print(renderInt(integer(blob, H_BYTES)));
                    print(" hash="); println(renderInt(integer(blob, H_HASH)));
                    return true;
                }
                print("{\"schema\":\"nc.bootstrap.mct.llvm-optimization.v1\"");
                print(",\"level\":\""); print(levelName(level));
                print("\",\"profile\":\""); print(profileName(level));
                print("\",\"clang_arg\":\""); print(clangArgument(level));
                print("\",\"opt_passes\":\""); print(optPasses(level));
                print("\",\"pass_count\":"); print(renderInt(integer(blob, H_PASSES)));
                print(",\"record_bytes\":"); print(renderInt(PASS_BYTES));
                print(",\"raw_may_alias_default\":true");
                print(",\"implicit_tbaa_noalias\":false");
                print(",\"observable_memory_preserved\":true");
                print(",\"vectorization\":"); print(integer(blob, H_VECTOR) != 0 ? "true" : "false");
                print(",\"lto\":"); print(integer(blob, H_LTO) != 0 ? "true" : "false");
                print(",\"pgo\":"); print(integer(blob, H_PGO) != 0 ? "true" : "false");
                print(",\"debug_preserved\":true");
                print(",\"bytes\":"); print(renderInt(integer(blob, H_BYTES)));
                print(",\"hash\":"); print(renderInt(integer(blob, H_HASH)));
                println("}");
                return true;
            }

        public:
            parseLevel(value >> str) -> int {
                if (same(value, "0") || same(value, "O0") || same(value, "o0") ||
                    same(value, "debug") || same(value, "none")) return LEVEL_O0;
                if (same(value, "1") || same(value, "O1") || same(value, "o1") ||
                    same(value, "release-light")) return LEVEL_O1;
                if (same(value, "2") || same(value, "O2") || same(value, "o2") ||
                    same(value, "release")) return LEVEL_O2;
                if (same(value, "3") || same(value, "O3") || same(value, "o3") ||
                    same(value, "release-fast") || same(value, "release-aggressive")) return LEVEL_O3;
                if (same(value, "s") || same(value, "Os") || same(value, "os") ||
                    same(value, "size") || same(value, "release-small")) return LEVEL_OS;
                if (same(value, "z") || same(value, "Oz") || same(value, "oz") ||
                    same(value, "tiny") || same(value, "release-tiny")) return LEVEL_OZ;
                return -1;
            }

            optimizeGraph(graph >> p<byte>, level >> int) -> p<byte> {
                guard graph != null && level >= LEVEL_O0 && level <= LEVEL_OZ else
                    return null;
                nodes >> int <- ir.nccIr.graphNodes(graph);
                bytesValue >> int <- TRANSFORM_HEADER_BYTES +
                    nodes * TRANSFORM_RECORD_BYTES;
                blob >> p<byte> <- cast<byte>(alloc(bytesValue));
                guard blob != null else return null;
                functions >> p<int> <- functionIndex(graph);
                if (functions == null) { free(blob); return null; }
                zero(blob, bytesValue);
                node >> int <- 0;
                while (node < nodes) {
                    item >> p<byte> <- transformRecord(blob, node);
                    putInteger(item, TR_NODE, node);
                    putInteger(item, TR_ACTION, ACTION_KEEP);
                    putInteger(item, TR_OPCODE, ir.nccIr.graphNodeOpcode(graph, node));
                    putInteger(item, TR_AST_KIND, ir.nccIr.graphNodeAstKind(graph, node));
                    putInteger(item, TR_ORIGINAL_ROLE,
                        ir.nccIr.graphNodeRoleHash(graph, node));
                    putInteger(item, TR_REPLACEMENT_ROLE,
                        ir.nccIr.graphNodeRoleHash(graph, node));
                    node += 1;
                }
                before >> int <- ir.nccIr.graphFingerprint(graph);
                callEdges >> int <- 0;
                inlinedCalls >> int <- 0;
                gvnReuses >> int <- 0;
                if (level != LEVEL_O0) {
                    simplifyStaticLoops(graph, blob);
                    foldConstantBranches(graph, blob);
                    pruneAfterTerminators(graph, blob);
                    eliminateDeadScalarWrites(graph, blob);
                    inlinedCalls <- analyzeInlineCalls(graph, blob,functions);
                    callEdges <- pruneDeadFunctions(graph, blob,functions);
                    reduceStrength(graph, blob);
                    analyzeInductions(graph, blob);
                    analyzeDerivedInductions(graph, blob);
                    analyzeLoopInvariants(graph, blob);
                    gvnReuses <- analyzeGlobalValueNumbers(graph, blob);
                }
                constantBranches >> int <- branchActionRoots(
                    graph, blob, nodes, ACTION_CONSTANT_BRANCH);
                ssaPropagations >> int <- branchActionRoots(
                    graph, blob, nodes, ACTION_SSA_BRANCH);
                deadCfg >> int <- actionNodes(blob, nodes, ACTION_DEAD_CFG);
                deadScalarWrites >> int <- actionRoots(
                    graph, blob, nodes, ACTION_DEAD_SCALAR_WRITE);
                deadFunctions >> int <- actionRoots(
                    graph, blob, nodes, ACTION_DEAD_FUNCTION);
                loopCollapses >> int <- loopActionCount(
                    graph, blob, nodes, ACTION_LOOP_COLLAPSE);
                zeroTripLoops >> int <- loopActionCount(
                    graph, blob, nodes, ACTION_ZERO_TRIP_LOOP);
                strengthReductions >> int <- actionNodes(
                    blob, nodes, ACTION_STRENGTH_REDUCTION);
                inductionVariables >> int <- actionNodes(
                    blob, nodes, ACTION_INDUCTION_VARIABLE);
                loopInvariants >> int <- actionNodes(
                    blob, nodes, ACTION_LOOP_INVARIANT);
                derivedInductions >> int <- actionNodes(
                    blob, nodes, ACTION_DERIVED_INDUCTION);
                eliminated >> int <- applyTransform(graph, blob, nodes);
                after >> int <- eliminated > 0 || strengthReductions > 0 ||
                    loopInvariants > 0 || inlinedCalls > 0 || gvnReuses > 0 ?
                    ir.nccIr.graphRefreshFingerprint(graph) : before;
                putInteger(blob, T_MAGIC, TRANSFORM_MAGIC);
                putInteger(blob, T_VERSION, TRANSFORM_VERSION);
                putInteger(blob, T_LEVEL, level);
                putInteger(blob, T_NODES, nodes);
                putInteger(blob, T_ELIMINATED, eliminated);
                putInteger(blob, T_CONSTANT_BRANCHES,
                    constantBranches + ssaPropagations);
                putInteger(blob, T_DEAD_CFG, deadCfg);
                putInteger(blob, T_BEFORE_FINGERPRINT, before);
                putInteger(blob, T_AFTER_FINGERPRINT, after);
                putInteger(blob, T_BYTES, bytesValue);
                putInteger(blob, T_HASH, 0);
                putInteger(blob, T_RECORD_BYTES, TRANSFORM_RECORD_BYTES);
                putInteger(blob, T_RECORDS_AT, TRANSFORM_HEADER_BYTES);
                putInteger(blob, T_RAW_FLAGS,
                    FLAG_RAW_MAY_ALIAS | FLAG_NO_IMPLICIT_TBAA | FLAG_OBSERVABLE_MEMORY);
                putInteger(blob, T_SSA_PROPAGATIONS, ssaPropagations);
                putInteger(blob, T_DEAD_SCALAR_WRITES, deadScalarWrites);
                putInteger(blob, T_DEAD_FUNCTIONS, deadFunctions);
                putInteger(blob, T_CALL_EDGES, callEdges);
                putInteger(blob, T_LOOP_COLLAPSES, loopCollapses);
                putInteger(blob, T_ZERO_TRIP_LOOPS, zeroTripLoops);
                putInteger(blob, T_STRENGTH_REDUCTIONS, strengthReductions);
                putInteger(blob, T_INDUCTION_VARIABLES, inductionVariables);
                putInteger(blob, T_LOOP_INVARIANTS, loopInvariants);
                putInteger(blob, T_DERIVED_INDUCTIONS, derivedInductions);
                putInteger(blob, T_INLINED_CALLS, inlinedCalls);
                putInteger(blob, T_GVN_REUSES, gvnReuses);
                putInteger(blob, T_HASH, hash(blob, bytesValue));
                free(functions);
                return blob;
            }

            releaseTransform(blob >> p<byte>) -> void {
                if (blob != null) free(blob);
            }

            transformInlinedCalls(blob >> p<byte>) -> int {
                return blob != null && integer(blob, T_MAGIC) == TRANSFORM_MAGIC ?
                    integer(blob, T_INLINED_CALLS) : -1;
            }

            transformGvnReuses(blob >> p<byte>) -> int {
                return blob != null && integer(blob, T_MAGIC) == TRANSFORM_MAGIC ?
                    integer(blob, T_GVN_REUSES) : -1;
            }

            transformCallEdges(blob >> p<byte>) -> int {
                return blob != null && integer(blob, T_MAGIC) == TRANSFORM_MAGIC ?
                    integer(blob, T_CALL_EDGES) : -1;
            }

            transformHash(blob >> p<byte>) -> int {
                return blob != null && integer(blob, T_MAGIC) == TRANSFORM_MAGIC ?
                    integer(blob, T_HASH) : 0;
            }

            emitTransform(path >> str, targetName >> str, levelValue >> str,
                output >> str, json >> bool, quiet >> bool) -> int {
                level >> int <- parseLevel(levelValue);
                guard level >= 0 else return 1;
                target >> int <- ir.nccIr.targetCode(targetName);
                if (target == 0) return diagnostics.nccDiagnostics.emitIrTarget(
                    path, targetName);
                semaCode >> int <- sema.nccSema.analyzeFile(path, false, true);
                if (semaCode != 0) return semaCode;
                graph >> p<byte> <- ir.nccIr.graphFor(path, targetName);
                guard graph != null else return diagnostics.nccDiagnostics.emitIrGraph(path);
                blob >> p<byte> <- optimizeGraph(graph, level);
                guard blob != null else {
                    ir.nccIr.releaseGraph(graph);
                    return 1;
                }
                if (output != "" && fsWriteFrom(output, blob,
                    integer(blob, T_BYTES), false) != integer(blob, T_BYTES)) {
                    releaseTransform(blob);
                    ir.nccIr.releaseGraph(graph);
                    return 1;
                }
                if (!quiet) emitTransformReport(blob, targetName, json);
                code >> int <- validTransform(blob) ? 0 : 1;
                releaseTransform(blob);
                ir.nccIr.releaseGraph(graph);
                return code;
            }

            checkTransform(path >> str, targetName >> str, levelValue >> str,
                expectedEliminated >> int, expectedBranches >> int,
                expectedDead >> int, expectedSsa >> int,
                expectedDeadWrites >> int, expectedDeadFunctions >> int,
                expectedCallEdges >> int, expectedLoopCollapses >> int,
                expectedZeroTripLoops >> int, expectedStrengthReductions >> int,
                expectedInductionVariables >> int, expectedLoopInvariants >> int,
                expectedDerivedInductions >> int, expectedInlinedCalls >> int,
                expectedGvnReuses >> int, expectedHash >> int) -> int {
                level >> int <- parseLevel(levelValue);
                guard level >= 0 else return 1;
                graph >> p<byte> <- ir.nccIr.graphFor(path, targetName);
                guard graph != null else return 1;
                blob >> p<byte> <- optimizeGraph(graph, level);
                ok >> bool <- blob != null && validTransform(blob) &&
                    integer(blob, T_ELIMINATED) == expectedEliminated &&
                    integer(blob, T_CONSTANT_BRANCHES) == expectedBranches &&
                    integer(blob, T_DEAD_CFG) == expectedDead &&
                    integer(blob, T_SSA_PROPAGATIONS) == expectedSsa &&
                    integer(blob, T_DEAD_SCALAR_WRITES) == expectedDeadWrites &&
                    integer(blob, T_DEAD_FUNCTIONS) == expectedDeadFunctions &&
                    integer(blob, T_CALL_EDGES) == expectedCallEdges &&
                    integer(blob, T_LOOP_COLLAPSES) == expectedLoopCollapses &&
                    integer(blob, T_ZERO_TRIP_LOOPS) == expectedZeroTripLoops &&
                    integer(blob, T_STRENGTH_REDUCTIONS) ==
                        expectedStrengthReductions &&
                    integer(blob, T_INDUCTION_VARIABLES) ==
                        expectedInductionVariables &&
                    integer(blob, T_LOOP_INVARIANTS) == expectedLoopInvariants &&
                    integer(blob, T_DERIVED_INDUCTIONS) == expectedDerivedInductions &&
                    integer(blob, T_INLINED_CALLS) == expectedInlinedCalls &&
                    (expectedGvnReuses < 0 || integer(blob, T_GVN_REUSES) ==
                        expectedGvnReuses) &&
                    integer(blob, T_HASH) == expectedHash;
                releaseTransform(blob);
                ir.nccIr.releaseGraph(graph);
                return ok ? 0 : 1;
            }

            levelName(level >> int) -> str {
                if (level == LEVEL_O0) return "O0";
                if (level == LEVEL_O1) return "O1";
                if (level == LEVEL_O2) return "O2";
                if (level == LEVEL_O3) return "O3";
                if (level == LEVEL_OS) return "Os";
                return "Oz";
            }

            profileName(level >> int) -> str {
                if (level == LEVEL_O0) return "debug";
                if (level == LEVEL_O1) return "release-light";
                if (level == LEVEL_O2) return "release";
                if (level == LEVEL_O3) return "release-aggressive";
                if (level == LEVEL_OS) return "release-size";
                return "release-tiny";
            }

            clangArgument(level >> int) -> str {
                if (level == LEVEL_O0) return "-O0";
                if (level == LEVEL_O1) return "-O1";
                if (level == LEVEL_O2) return "-O2";
                if (level == LEVEL_O3) return "-O3";
                if (level == LEVEL_OS) return "-Os";
                return "-Oz";
            }

            optPasses(level >> int) -> str {
                if (level == LEVEL_O0) return "default<O0>";
                if (level == LEVEL_O1) return "default<O1>";
                if (level == LEVEL_O2) return "default<O2>";
                if (level == LEVEL_O3) return "default<O3>";
                if (level == LEVEL_OS) return "default<Os>";
                return "default<Oz>";
            }

            build(level >> int) -> p<byte> {
                guard level >= LEVEL_O0 && level <= LEVEL_OZ else return null;
                capacity >> int <- HEADER_BYTES + MAX_PASSES * PASS_BYTES;
                blob >> p<byte> <- cast<byte>(alloc(capacity));
                guard blob != null else return null;
                zero(blob, capacity);
                passes >> int <- writeBase(blob, 0);
                if (level != LEVEL_O0) passes <- writeScalar(blob, passes);
                if (level == LEVEL_O2 || level == LEVEL_O3 ||
                    level == LEVEL_OS || level == LEVEL_OZ)
                    passes <- writeGlobal(blob, passes);
                if (level == LEVEL_O2 || level == LEVEL_O3)
                    passes <- writeVector(blob, passes);
                if (level == LEVEL_O2 || level == LEVEL_O3 ||
                    level == LEVEL_OS || level == LEVEL_OZ)
                    passes <- writeLtoPgo(blob, passes);
                if (level == LEVEL_O3) passes <- writeAggressive(blob, passes);
                if (level == LEVEL_OS || level == LEVEL_OZ)
                    passes <- writeSize(blob, passes, level);
                bytes >> int <- HEADER_BYTES + passes * PASS_BYTES;
                putInteger(blob, H_MAGIC, PLAN_MAGIC);
                putInteger(blob, H_VERSION, PLAN_VERSION);
                putInteger(blob, H_LEVEL, level);
                putInteger(blob, H_PROFILE, profileCode(level));
                putInteger(blob, H_PASSES, passes);
                putInteger(blob, H_BYTES, bytes);
                putInteger(blob, H_HASH, 0);
                putInteger(blob, H_RAW_FLAGS,
                    FLAG_RAW_MAY_ALIAS | FLAG_NO_IMPLICIT_TBAA | FLAG_OBSERVABLE_MEMORY);
                putInteger(blob, H_VECTOR, (level == LEVEL_O2 || level == LEVEL_O3) ? 1 : 0);
                putInteger(blob, H_LTO,
                    (level == LEVEL_O2 || level == LEVEL_O3 || level == LEVEL_OS || level == LEVEL_OZ) ? 1 : 0);
                putInteger(blob, H_PGO, integer(blob, H_LTO));
                putInteger(blob, H_DEBUG, 1);
                putInteger(blob, H_RECORD_BYTES, PASS_BYTES);
                putInteger(blob, H_RECORDS_AT, HEADER_BYTES);
                putInteger(blob, H_MAX_PASSES, MAX_PASSES);
                putInteger(blob, H_HASH, hash(blob, bytes));
                materializations += 1;
                materialBytes += bytes;
                lastLevel <- level;
                lastPasses <- passes;
                lastBytes <- bytes;
                lastHash <- integer(blob, H_HASH);
                return blob;
            }

            bytes(blob >> p<byte>) -> int { return integer(blob, H_BYTES); }
            passes(blob >> p<byte>) -> int { return integer(blob, H_PASSES); }
            checksum(blob >> p<byte>) -> int { return integer(blob, H_HASH); }
            release(blob >> p<byte>) -> void { if (blob != null) free(blob); }

            emitPlan(levelNameValue >> str, output >> str, json >> bool, quiet >> bool) -> int {
                level >> int <- parseLevel(levelNameValue);
                guard level >= 0 else {
                    println("error[E_MCT_LLVM_OPT_LEVEL_001] mct.llvm.optimization");
                    print("     | unknown optimization level '"); print(levelNameValue); println("'");
                    return 1;
                }
                blob >> p<byte> <- build(level);
                guard blob != null else return 1;
                if (output != "" && fsWriteFrom(output, blob, bytes(blob), false) != bytes(blob)) {
                    release(blob);
                    return 1;
                }
                if (!quiet) emitReport(blob, json);
                code >> int <- valid(blob) ? 0 : 1;
                release(blob);
                return code;
            }

            check(levelNameValue >> str, expectedPasses >> int,
                expectedBytes >> int, expectedHash >> int) -> int {
                level >> int <- parseLevel(levelNameValue);
                guard level >= 0 else return 1;
                blob >> p<byte> <- build(level);
                guard blob != null else return 1;
                ok >> bool <- valid(blob) && passes(blob) == expectedPasses &&
                    bytes(blob) == expectedBytes && checksum(blob) == expectedHash;
                release(blob);
                return ok ? 0 : 1;
            }

            selfTest() -> bool {
                o0 >> p<byte> <- build(LEVEL_O0);
                o3 >> p<byte> <- build(LEVEL_O3);
                oz >> p<byte> <- build(LEVEL_OZ);
                ok >> bool <- o0 != null && o3 != null && oz != null &&
                    valid(o0) && valid(o3) && valid(oz) &&
                    passes(o0) == 10 && passes(o3) == 27 && passes(oz) == 24;
                release(o0); release(o3); release(oz);
                return ok;
            }

    fa:
        return true;
}
