nccFsAbi {
    fn:
        internal:
            same(data >> p<byte>, bytes >> int, text >> str, count >> int) -> bool {
                if (data == null || bytes != count) return false;
                at >> int <- 0;
                while (at < bytes) {
                    if (rd(off(data,at)) != rd<byte>(off(cast<byte>(text),at))) return false;
                    at += 1;
                }
                return true;
            }
            resolve(name >> p<byte>, bytes >> int) -> int {
                if (same(name,bytes,"exists",6)) return 1;
                if (same(name,bytes,"createDir",9)) return 2;
                if (same(name,bytes,"isOk",4)) return 3;
                if (same(name,bytes,"isErr",5)) return 4;
                if (same(name,bytes,"fsWriteFrom",11)) return 5;
                if (same(name,bytes,"fsReadInto",10)) return 6;
                if (same(name,bytes,"fsSize",6)) return 7;
                if (same(name,bytes,"removeDir",9)) return 8;
                if (same(name,bytes,"delete_file",11)) return 9;
                if (same(name,bytes,"fsCopy",6)) return 10;
                if (same(name,bytes,"rename_file",11)) return 11;
                if (same(name,bytes,"fsMetadataInto",14)) return 12;
                if (same(name,bytes,"fsPermissionsInto",17)) return 13;
                if (same(name,bytes,"listDirInto",11)) return 14;
                if (same(name,bytes,"officialPathInto",16)) return 15;
                if (same(name,bytes,"absolutePathInto",16)) return 16;
                return 0;
            }
            owned(name >> p<byte>, bytes >> int, owner >> p<byte>, ownerBytes >> int) -> int {
                id >> int <- resolve(name,bytes);
                if (id == 1 && same(owner,ownerBytes,"fs",2)) return id;
                if ((id == 2 || id == 8) && (same(owner,ownerBytes,"dir",3) || same(owner,ownerBytes,"fs",2))) return id;
                if (id >= 3 && id <= 4 && same(owner,ownerBytes,"result",6)) return id;
                if (id >= 5 && same(owner,ownerBytes,"fs",2)) return id;
                return 0;
            }
            arity(id >> int) -> int { return id == 5 ? 4 : (id == 6 || (id >= 12 && id <= 16) ? 3 : (id == 10 || id == 11 ? 2 : (id >= 1 && id <= 9 ? 1 : -1))); }
            argumentCode(id >> int, index >> int) -> int {
                if (index < 0 || index >= arity(id)) return -1;
                if (id >= 12) return index == 0 ? 34 : 8;
                if (id <= 2 || id >= 7) return 34;
                if (id <= 4) return 8;
                return index == 0 ? 34 : (index == 1 ? 8 : (index == 2 ? 20 : 33));
            }
            argumentSemanticCode(id >> int, index >> int) -> int {
                if (id >= 12 && index == 2) return 20;
                return argumentCode(id,index);
            }
            resultCode(id >> int) -> int { return id == 2 || id == 8 ? 8 : ((id >= 5 && id <= 7) || id == 10 || id >= 12 ? 20 : 33); }
            ownerData(id >> int) -> p<byte> { return cast<byte>(id == 2 || id == 8 ? "dir" : (id == 3 || id == 4 ? "result" : "fs")); }
            ownerBytes(id >> int) -> int { return id == 2 || id == 8 ? 3 : (id == 3 || id == 4 ? 6 : 2); }
    fa: return true;
}
