            code(c >> p<byte>) -> p<byte> { return from<byte>(rd<addr>(off(c,56))); }
            record(c >> p<byte>, index >> int) -> p<byte> { return off(from<byte>(rd<addr>(off(c,48))),index*RECORD); }
            count(c >> p<byte>) -> int { return get(c,40); }
            bytes(c >> p<byte>) -> int { return get(c,32); }
            data(c >> p<byte>) -> p<byte> { return from<byte>(rd<addr>(off(c,88))); }
            dataBytes(c >> p<byte>) -> int { return get(c,96); }
            bssBytes(c >> p<byte>) -> int { return get(c,100); }
            rodata(c >> p<byte>) -> p<byte> { return from<byte>(rd<addr>(off(c,112))); }
            rodataBytes(c >> p<byte>) -> int { return get(c,104); }
            healthy(c >> p<byte>) -> bool {
                guard c != null else return false;
