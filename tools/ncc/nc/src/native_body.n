use <io:output, render>;
use <project:ir, mct_values, native_types, heap_abi, memory_abi, output_abi, string_abi, fs_abi, time_abi, json_abi, command_abi, binary64>;

nccNativeBody {
    const:
        HEADER >> int <- 128;
        RECORD >> int <- 32;
        ROLE_STRENGTH_SHL_BASE >> int <- 4096;
        ROLE_STRENGTH_SHR_U_BASE >> int <- 4160;
        ROLE_INLINE_BASE >> int <- 8192;
    fn:
        private:
            g(c >> p<byte>) -> p<byte> { return from<byte>(rd<addr>(c)); }
            slots(c >> p<byte>) -> p<int> { return from<int>(rd<addr>(off(c,16))); }
            get(c >> p<byte>, at >> int) -> int { return rd<int>(off(c,at)); }
            set(c >> p<byte>, at >> int, value >> int) -> void { wr<int>(off(c,at),value); }
            reject(c >> p<byte>, node >> int) -> void {
                if (get(c,36) == 0) {
                    print("native body rejected node "); print(renderInt(node));
                    if (node >= 0 && node < ir.nccIr.graphNodes(g(c))) {
                        print(" kind="); print(renderInt(ir.nccIr.graphNodeAstKind(g(c),node)));
                        print(" line="); print(renderInt(ir.nccIr.graphNodeLine(g(c),node)));
                    }
                    println("");
                }
                set(c,36,1);
            }
            put(c >> p<byte>, value >> int) -> void {
                at >> int <- get(c,32);
                if (at >= get(c,28)) { reject(c,0); return; }
                wr<byte>(off(code(c),at),cast<byte>(value)); set(c,32,at+1);
            }
            word(c >> p<byte>, value >> int) -> void {
                put(c,value); put(c,value >> 8); put(c,value >> 16); put(c,value >> 24);
            }
            begin(c >> p<byte>, node >> int, opcode >> int) -> int {
                index >> int <- get(c,40);
                if (index >= get(c,24)) { reject(c,node); return -1; }
                item >> p<byte> <- record(c,index);
                wr<int>(item,node); wr<int>(off(item,4),opcode);
                wr<int>(off(item,8),get(c,32)); wr<int>(off(item,16),-1);
                wr<int>(off(item,20),-1);
                wr<int>(off(item,24),-1); wr<int>(off(item,28),1);
                set(c,40,index+1); return index;
            }
            end(c >> p<byte>, index >> int) -> void {
                if (index < 0) return;
                item >> p<byte> <- record(c,index);
                length >> int <- get(c,32)-rd<int>(off(item,8));
                wr<int>(off(item,12),length);
                if (length > 32) reject(c,rd<int>(item));
            }
            byteOp(c >> p<byte>, node >> int, opcode >> int, byte >> int) -> void {
                index >> int <- begin(c,node,opcode); put(c,byte); end(c,index);
            }
            constant(c >> p<byte>, node >> int, value >> int) -> void {
                index >> int <- begin(c,node,5); put(c,0xB8); word(c,value); end(c,index);
            }
            constant64(c >> p<byte>, node >> int, value >> u64) -> void {
                index >> int <- begin(c,node,5);
                put(c,0x48); put(c,0xB8);
                at >> int <- 0;
                while (at < 8) {
                    part >> u64 <- value >> (at*8);
                    piece >> int <- part; put(c,piece); at += 1;
                }
                end(c,index);
            }
            push(c >> p<byte>, node >> int) -> void {
                byteOp(c,node,7,0x50); set(c,44,get(c,44)+1);
            }
            pop(c >> p<byte>, node >> int, reg >> int) -> void {
                index >> int <- begin(c,node,7);
                if (reg >= 8) put(c,0x41);
                put(c,0x58+(reg & 7)); end(c,index); set(c,44,get(c,44)-1);
            }
            frameAccess(c >> p<byte>, node >> int, declaration >> int, store >> bool, reg >> int) -> void {
                if (declaration < 0) { reject(c,node); return; }
                slot >> int <- rd<int>(off(slots(c),declaration));
                if (slot < 0) {
                    if (globalSection(c,declaration) > 0) globalAccess(c,node,declaration,store,reg,false);
                    else reject(c,node);
                    return;
                }
                if (store && reg == 0) normalize(c,node,typeNode(c,declaration));
                index >> int <- begin(c,node,store ? 9 : 6);
                put(c,reg >= 8 ? 0x4C : 0x48);
                put(c,store ? 0x89 : 0x8B); put(c,0x85+((reg & 7)*8));
                word(c,-8*(slot+1)); end(c,index);
                if (!store && reg == 0) normalize(c,node,typeNode(c,declaration));
            }
            scalar(c >> p<byte>, node >> int, allowVoid >> bool) -> bool {
                type >> int <- native_types.nccNativeTypes.code(g(c),node);
                return (type > 0 && !native_types.nccNativeTypes.aggregate(type)) || (allowVoid && (node < 0 || type == 0));
            }
            typeNode(c >> p<byte>, node >> int) -> int {
                return native_types.nccNativeTypes.typeNode(g(c),node);
            }
            normalize(c >> p<byte>, node >> int, type >> int) -> void {
                normalizeCode(c,node,native_types.nccNativeTypes.code(g(c),type));
            }
            normalizeCode(c >> p<byte>, node >> int, type >> int) -> void {
                if (native_types.nccNativeTypes.aggregate(type) || native_types.nccNativeTypes.floating(type)) return;
                if (type == 33) {
                    index >> int <- begin(c,node,7);
                    put(c,0x84); put(c,0xC0); put(c,0x0F); put(c,0x95); put(c,0xC0);
                    put(c,0x0F); put(c,0xB6); put(c,0xC0); end(c,index); return;
                }
                width >> int <- native_types.nccNativeTypes.width(type);
                signed >> bool <- native_types.nccNativeTypes.signed(type);
                if (width <= 0 || width == 8) return;
                index >> int <- begin(c,node,7);
                if (width == 4) {
                    if (signed) { put(c,0x48); put(c,0x63); put(c,0xC0); }
                    else { put(c,0x89); put(c,0xC0); }
                }
                else {
                    if (signed) put(c,0x48);
                    put(c,0x0F); put(c,(signed ? 0xBE : 0xB6)+(width == 2 ? 1 : 0)); put(c,0xC0);
                }
                end(c,index);
            }
            functionOf(c >> p<byte>, node >> int) -> int {
                while (node >= 0) {
                    if (ir.nccIr.graphNodeAstKind(g(c),node) == 15) return node;
                    node <- ir.nccIr.graphNodeParent(g(c),node);
                }
                return -1;
            }
            registerFor(c >> p<byte>, parameter >> int) -> int {
                if (ir.nccIr.graphAbi(g(c)) == 2) {
                    if (parameter == 0) return 1;
                    if (parameter == 1) return 2;
                    return parameter+6;
                }
                if (parameter == 0) return 7;
                if (parameter == 1) return 6;
                if (parameter == 2) return 2;
                if (parameter == 3) return 1;
                return parameter+4;
            }
            adjust(c >> p<byte>, node >> int, bytes >> int, restore >> bool) -> void {
                if (bytes == 0) return;
                if (!restore && bytes >= 4096) {
                    moveReg(c,node,0,4);
                    index >> int <- begin(c,node,7);
                    put(c,0x48); put(c,0x2D); word(c,bytes); end(c,index);
                    probeTo(c,node); return;
                }
                index >> int <- begin(c,node,7);
                put(c,0x48); put(c,0x81); put(c,restore ? 0xC4 : 0xEC); word(c,bytes);
                end(c,index);
            }
            // RAX is the new stack boundary. Touch every page without moving the frame pointer.
            probeTo(c >> p<byte>, node >> int) -> void {
                moveReg(c,node,11,4);
                index >> int <- begin(c,node,7);
                put(c,0x49); put(c,0x29); put(c,0xC3); end(c,index);
                loopAt >> int <- get(c,32);
                index <- begin(c,node,7);
                put(c,0x49); put(c,0x81); put(c,0xFB); word(c,4096); end(c,index);
                finish >> int <- flagBranch(c,node,0x86);
                index <- begin(c,node,7);
                put(c,0x48); put(c,0x81); put(c,0xEC); word(c,4096);
                put(c,0xF6); put(c,0x04); put(c,0x24); put(c,0);
                put(c,0x49); put(c,0x81); put(c,0xEB); word(c,4096); end(c,index);
                back >> int <- branch(c,node,-1); patch(c,back,loopAt); patch(c,finish,get(c,32));
                index <- begin(c,node,7);
                put(c,0x4C); put(c,0x29); put(c,0xDC);
                put(c,0xF6); put(c,0x04); put(c,0x24); put(c,0); end(c,index);
            }
            callBases(c >> p<byte>) -> p<int> { return from<int>(rd<addr>(off(c,8))); }
            callAlignment(c >> p<byte>, node >> int) -> int {
                if (ir.nccIr.graphAbi(g(c)) == 2) return 16;
                alignment >> int <- 16;
                arg >> int <- ir.nccIr.graphNodeNextSibling(g(c),ir.nccIr.graphNodeFirstChild(g(c),node));
                while (arg >= 0) {
                    type >> int <- native_types.nccNativeTypes.expression(g(c),arg,0);
                    current >> int <- native_types.nccNativeTypes.aggregate(type) ? native_types.nccNativeTypes.aggregateAlign(g(c),type) : 1;
                    if (current > alignment) alignment <- current;
                    arg <- ir.nccIr.graphNodeNextSibling(g(c),arg);
                }
                return alignment;
            }
            callValue(c >> p<byte>, node >> int, padding >> int, displacement >> int, reg >> int, realigned >> bool) -> void {
                if (!realigned) { stackAccess(c,node,padding+displacement,reg,false); return; }
                memoryOp(c,node,5,-8*(rd(off(callBases(c),node))+1),8,false,11,false);
                memoryOp(c,node,11,displacement,8,false,reg,false);
            }
            stackAccess(c >> p<byte>, node >> int, displacement >> int, reg >> int, store >> bool) -> void {
                index >> int <- begin(c,node,store ? 9 : 6);
                put(c,reg >= 8 ? 0x4C : 0x48); put(c,store ? 0x89 : 0x8B);
                put(c,0x84+8*(reg & 7)); put(c,0x24); word(c,displacement); end(c,index);
            }
            moveReg(c >> p<byte>, node >> int, destination >> int, source >> int) -> void {
                index >> int <- begin(c,node,7);
                put(c,0x48+(source >= 8 ? 4 : 0)+(destination >= 8 ? 1 : 0));
                put(c,0x89); put(c,0xC0+(source & 7)*8+(destination & 7)); end(c,index);
            }
            xmm(c >> p<byte>, node >> int, register >> int, gpr >> int, toXmm >> bool, type >> int) -> void {
                index >> int <- begin(c,node,7);
                put(c,0x66);
                rex >> int <- 0x40+(type == 41 ? 8 : 0)+(register >= 8 ? 4 : 0)+(gpr >= 8 ? 1 : 0);
                if (rex != 0x40) put(c,rex);
                put(c,0x0F); put(c,toXmm ? 0x6E : 0x7E);
                put(c,0xC0+(register & 7)*8+(gpr & 7)); end(c,index);
            }
            fpOp(c >> p<byte>, node >> int, opcode >> int, type >> int, modrm >> int) -> void {
                index >> int <- begin(c,node,7);
                put(c,type == 41 ? 0xF2 : 0xF3); put(c,0x0F); put(c,opcode); put(c,modrm); end(c,index);
            }
            fpConvert(c >> p<byte>, node >> int, source >> int, destination >> int) -> void {
                if (source == destination || (!native_types.nccNativeTypes.floating(source) && !native_types.nccNativeTypes.floating(destination))) return;
                if (native_types.nccNativeTypes.floating(source)) {
                    xmm(c,node,0,0,true,source);
                    if (native_types.nccNativeTypes.floating(destination)) {
                        fpOp(c,node,0x5A,source,0xC0); xmm(c,node,0,0,false,destination); return;
                    }
                    if (destination == 8) {
                        constant64(c,node,source == 41 ? 0x43E0000000000000 : 0x5F000000);
                        xmm(c,node,1,0,true,source);
                        index >> int <- begin(c,node,7);
                        if (source == 41) put(c,0x66);
                        put(c,0x0F); put(c,0x2E); put(c,0xC1); end(c,index);
                        low >> int <- flagBranch(c,node,0x82);
                        fpOp(c,node,0x5C,source,0xC1);
                        index <- begin(c,node,7); put(c,source == 41 ? 0xF2 : 0xF3);
                        put(c,0x48); put(c,0x0F); put(c,0x2C); put(c,0xC0); end(c,index);
                        moveReg(c,node,1,0); constant64(c,node,0x8000000000000000);
                        index <- begin(c,node,7); put(c,0x48); put(c,0x09); put(c,0xC8); end(c,index);
                        finish >> int <- branch(c,node,-1); patch(c,low,get(c,32));
                        index <- begin(c,node,7); put(c,source == 41 ? 0xF2 : 0xF3);
                        put(c,0x48); put(c,0x0F); put(c,0x2C); put(c,0xC0); end(c,index);
                        patch(c,finish,get(c,32)); return;
                    }
                    if (destination == 33) {
                        index >> int <- begin(c,node,7); put(c,0x66); put(c,0x0F); put(c,0xEF); put(c,0xC9);
                        if (source == 41) put(c,0x66);
                        put(c,0x0F); put(c,0x2E); put(c,0xC1);
                        put(c,0x0F); put(c,0x95); put(c,0xC0); put(c,0x0F); put(c,0x9A); put(c,0xC2);
                        put(c,0x08); put(c,0xD0); put(c,0x0F); put(c,0xB6); put(c,0xC0); end(c,index); return;
                    }
                    index >> int <- begin(c,node,7); put(c,source == 41 ? 0xF2 : 0xF3);
                    put(c,0x48); put(c,0x0F); put(c,0x2C); put(c,0xC0); end(c,index);
                    normalizeCode(c,node,destination); return;
                }
                normalizeCode(c,node,source);
                if (source == 8) {
                    low >> int <- branch(c,node,0x89);
                    index >> int <- begin(c,node,7);
                    put(c,0x48); put(c,0x89); put(c,0xC1); put(c,0x48); put(c,0xD1); put(c,0xE8);
                    put(c,0x83); put(c,0xE1); put(c,1); put(c,0x48); put(c,0x09); put(c,0xC8);
                    put(c,destination == 41 ? 0xF2 : 0xF3); put(c,0x48); put(c,0x0F); put(c,0x2A); put(c,0xC0); end(c,index);
                    fpOp(c,node,0x58,destination,0xC0);
                    finish >> int <- branch(c,node,-1); patch(c,low,get(c,32));
                    index <- begin(c,node,7); put(c,destination == 41 ? 0xF2 : 0xF3);
                    put(c,0x48); put(c,0x0F); put(c,0x2A); put(c,0xC0); end(c,index); patch(c,finish,get(c,32));
                } else {
                    index >> int <- begin(c,node,7); put(c,destination == 41 ? 0xF2 : 0xF3);
                    put(c,0x48); put(c,0x0F); put(c,0x2A); put(c,0xC0); end(c,index);
                }
                xmm(c,node,0,0,false,destination);
            }
            fpBinary(c >> p<byte>, node >> int, op >> int, type >> int) -> void {
                xmm(c,node,0,1,true,type); xmm(c,node,1,0,true,type);
                if (op == 35 || op == 37 || op == 36 || op == 38 || op == 40 || op == 39 || op == 18 || op == 47 || op == 41) {
                    fpOp(c,node,op == 35 || op == 37 || op == 36 ? 0x58 :
                        (op == 38 || op == 40 || op == 39 ? 0x5C : (op == 41 ? 0x5E : 0x59)),type,0xC1);
                    xmm(c,node,0,0,false,type); return;
                }
                if (op != 31 && op != 32 && (op < 26 || op > 29)) { reject(c,node); return; }
                index >> int <- begin(c,node,7);
                if (type == 41) put(c,0x66);
                put(c,0x0F); put(c,0x2E); put(c,0xC1);
                cc >> int <- op == 31 ? 0x94 : (op == 32 ? 0x95 : (op == 26 ? 0x97 : (op == 27 ? 0x92 : (op == 28 ? 0x93 : 0x96))));
                put(c,0x0F); put(c,cc); put(c,0xC0);
                if (op == 31 || op == 32 || op == 27 || op == 29) {
                    put(c,0x0F); put(c,op == 32 ? 0x9A : 0x9B); put(c,0xC2);
                    put(c,op == 32 ? 0x08 : 0x20); put(c,0xD0);
                }
                put(c,0x0F); put(c,0xB6); put(c,0xC0); end(c,index);
            }
            fpArgument(c >> p<byte>, node >> int, index >> int, indirect >> bool) -> int {
                graph >> p<byte> <- g(c); callee >> int <- ir.nccIr.graphNodeFirstChild(graph,node);
                if (ir.nccIr.graphNodeAstKind(graph,callee) == 74) callee <- ir.nccIr.graphNodeFirstChild(graph,callee);
                if (indirect) return native_types.nccNativeTypes.code(graph,native_types.nccNativeTypes.functionParameter(graph,native_types.nccNativeTypes.expressionType(graph,callee,0),index));
                if (ir.nccIr.graphSignatureArity(graph,callee) >= 0) return native_types.nccNativeTypes.signatureCode(graph,callee,index);
                target >> int <- mct_values.nccMctValues.resolve(graph,callee);
                if (target >= 0) {
                    parameter >> int <- ir.nccIr.graphNodeFirstChild(graph,target);
                    while (parameter >= 0) {
                        if (ir.nccIr.graphNodeAstKind(graph,parameter) == 16) {
                            if (index == 0) return native_types.nccNativeTypes.code(graph,typeNode(c,parameter));
                            index -= 1;
                        }
                        parameter <- ir.nccIr.graphNodeNextSibling(graph,parameter);
                    }
                    return -1;
                }
                json >> int <- json_abi.nccJsonAbi.owned(ir.nccIr.graphNodeName(graph,callee),ir.nccIr.graphNodeNameBytes(graph,callee),ir.nccIr.graphNodeOwner(graph,callee),ir.nccIr.graphNodeOwnerBytes(graph,callee));
                return json > 0 ? json_abi.nccJsonAbi.argumentCode(json,index) : native_types.nccNativeTypes.expression(graph,native_types.nccNativeTypes.argument(graph,node,index),0);
            }
            fpCall(c >> p<byte>, node >> int, arity >> int, result >> int, indirect >> bool) -> void {
                locations >> array<int,256>; where >> p<int> <- cast<int>(&locations);
                windows >> bool <- ir.nccIr.graphAbi(g(c)) == 2;
                gp >> int <- 0; fp >> int <- 0; spilled >> int <- 0; at >> int <- 0;
                while (at < arity) {
                    floating >> bool <- native_types.nccNativeTypes.floating(fpArgument(c,node,at,indirect));
                    position >> int <- windows ? at : (floating ? fp : gp);
                    limit >> int <- windows ? 4 : (floating ? 8 : 6);
                    if (position < limit) wr(off(where,at),(floating ? 16 : 0)+position);
                    else { wr(off(where,at),32+spilled); spilled += 1; }
                    if (floating) fp += 1; else gp += 1;
                    at += 1;
                }
                shadow >> int <- windows ? 32 : 0;
                padding >> int <- shadow+spilled*8+((get(c,44)+spilled) & 1)*8;
                adjust(c,node,padding,false); at <- 0;
                while (at < arity) {
                    location >> int <- rd(off(where,at));
                    if (location >= 32) {
                        stackAccess(c,node,padding+(arity-1-at)*8,0,false);
                        stackAccess(c,node,shadow+(location-32)*8,0,true);
                    }
                    at += 1;
                }
                at <- 0;
                while (at < arity) {
                    location >> int <- rd(off(where,at));
                    if (location < 32) {
                        stackAccess(c,node,padding+(arity-1-at)*8,0,false);
                        if (location >= 16) xmm(c,node,location-16,0,true,fpArgument(c,node,at,indirect));
                        else moveReg(c,node,registerFor(c,location),0);
                    }
                    at += 1;
                }
                if (indirect) stackAccess(c,node,padding+arity*8,11,false);
                index >> int <- begin(c,node,indirect ? 7 : 8);
                if (indirect) { put(c,0x41); put(c,0xFF); put(c,0xD3); }
                else { put(c,0xE8); wr<int>(off(record(c,index),16),get(c,32)); word(c,0); }
                end(c,index);
                adjust(c,node,padding+(arity+(indirect ? 1 : 0))*8,true); set(c,44,get(c,44)-arity-(indirect ? 1 : 0));
                if (native_types.nccNativeTypes.floating(result)) xmm(c,node,0,0,false,result);
                else normalizeCode(c,node,result);
            }
            memoryOp(c >> p<byte>, node >> int, base >> int, displacement >> int,
                width >> int, signed >> bool, reg >> int, store >> bool) -> void {
                if (width != 1 && width != 2 && width != 4 && width != 8) { reject(c,node); return; }
                index >> int <- begin(c,node,store ? 9 : 6);
                if (store && width == 2) put(c,0x66);
                prefix >> int <- 0x40+(reg >= 8 ? 4 : 0)+(base >= 8 ? 1 : 0);
                if (width == 8 || (!store && signed)) prefix += 8;
                if (prefix != 0x40 || (store && width == 1 && reg >= 4)) put(c,prefix);
                if (!store && width < 4) { put(c,0x0F); put(c,(signed ? 0xBE : 0xB6)+(width == 2 ? 1 : 0)); }
                else put(c,store ? (width == 1 ? 0x88 : 0x89) : (width == 4 && signed ? 0x63 : 0x8B));
                put(c,0x80+(reg & 7)*8+(base & 7));
                if ((base & 7) == 4) put(c,0x24);
                word(c,displacement); end(c,index);
            }
            packedLoad(c >> p<byte>, node >> int, base >> int, displacement >> int,
                bytes >> int, destination >> int) -> void {
                if (bytes == 1 || bytes == 2 || bytes == 4 || bytes == 8) {
                    memoryOp(c,node,base,displacement,bytes,false,destination,false); return;
                }
                if (bytes < 1 || bytes > 8) { reject(c,node); return; }
                constant(c,node,0);
                at >> int <- 0;
                while (at < bytes) {
                    memoryOp(c,node,base,displacement+at,1,false,11,false);
                    index >> int <- begin(c,node,7);
                    if (at > 0) { put(c,0x49); put(c,0xC1); put(c,0xE3); put(c,at*8); }
                    put(c,0x4C); put(c,0x09); put(c,0xD8); end(c,index); at += 1;
                }
                if (destination != 0) moveReg(c,node,destination,0);
            }
            packedStore(c >> p<byte>, node >> int, base >> int, displacement >> int,
                bytes >> int, source >> int) -> void {
                if (bytes == 1 || bytes == 2 || bytes == 4 || bytes == 8) {
                    memoryOp(c,node,base,displacement,bytes,false,source,true); return;
                }
                if (bytes < 1 || bytes > 8) { reject(c,node); return; }
                moveReg(c,node,10,source);
                at >> int <- 0;
                while (at < bytes) {
                    memoryOp(c,node,base,displacement+at,1,false,10,true);
                    index >> int <- begin(c,node,7);
                    put(c,0x49); put(c,0xC1); put(c,0xEA); put(c,8); end(c,index); at += 1;
                }
            }
            addAddress(c >> p<byte>, node >> int, bytes >> int) -> void {
                if (bytes == 0) return;
                index >> int <- begin(c,node,7);
                put(c,0x48); put(c,0x05); word(c,bytes); end(c,index);
            }
            copyTo(c >> p<byte>, node >> int, bytes >> int) -> void {
                // R10 is source; RAX is destination. No allocator or runtime call is inserted.
                push(c,node); moveReg(c,node,11,0); constant(c,node,bytes);
                if (bytes <= 128) {
                    at >> int <- 0;
                    while (at < bytes) {
                        left >> int <- bytes-at;
                        width >> int <- left >= 8 ? 8 : (left >= 4 ? 4 : (left >= 2 ? 2 : 1));
                        memoryOp(c,node,10,at,width,false,0,false);
                        memoryOp(c,node,11,at,width,false,0,true); at += width;
                    }
