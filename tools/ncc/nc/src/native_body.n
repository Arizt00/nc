                gpParameter >> int <- mode == 3 ? 1 : 0; fpParameter >> int <- 0;
                argumentRow >> array<int,8>; row >> p<byte> <- cast<byte>(&argumentRow);
                while (child >= 0) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph,child);
                    if (kind == 16) {
                        if (aggregateAbi) {
                            type >> int <- native_types.nccNativeTypes.code(graph,typeNode(c,child));
                            isRecord >> bool <- native_types.nccNativeTypes.aggregate(type);
                            bytes >> int <- isRecord ? native_types.nccNativeTypes.aggregateBytes(graph,type) : 8;
                            argMode >> int <- native_types.nccNativeTypes.returnMode(graph,type);
                            placeArgument(c,type,gpParameter,fpParameter,row);
                            gpParameter <- rd<int>(off(row,24)); fpParameter <- rd<int>(off(row,28));
                            location >> int <- rd<int>(off(row,8));
                            if (location >= 0) {
                                if (isRecord && !(ir.nccIr.graphAbi(graph) == 2 && argMode == 3)) {
                                    address(c,child,child); moveReg(c,child,11,0); lane >> int <- 0;
                                    while (lane < (argMode == 2 ? 2 : 1)) {
                                        location <- rd<int>(off(row,8+lane*4));
                                        if (location >= 0) {
                                            offset >> int <- location >= 16 ? limit+location-16 : location;
                                            memoryOp(c,child,5,-8*(get(c,124)+offset+1),8,false,0,false);
                                            width >> int <- bytes-lane*8;
                                            packedStore(c,child,11,lane*8,width > 8 ? 8 : width,0);
