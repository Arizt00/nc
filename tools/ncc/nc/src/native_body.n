                            }
                            child <- ir.nccIr.graphNodeNextSibling(graph,child); continue;
                        }
                        if (!scalar(c,typeNode(c,child),false)) { reject(c,child); return; }
                        paramType >> int <- native_types.nccNativeTypes.code(graph,typeNode(c,child));
                        floating >> bool <- native_types.nccNativeTypes.floating(paramType);
                        position >> int <- ir.nccIr.graphAbi(graph) == 2 ? parameter : (floating ? fpParameter : gpParameter);
                        limit <- ir.nccIr.graphAbi(graph) == 2 ? 4 : (floating ? 8 : 6);
                        if (position < limit) {
                            if (floating) xmm(c,child,position,0,false,paramType);
                            else moveReg(c,child,0,registerFor(c,position));
                        } else {
                            memoryOp(c,child,5,16+(ir.nccIr.graphAbi(graph) == 2 ? 32 : 0)+incoming,8,false,0,false);
                            incoming += 8;
                        }
                        frameAccess(c,child,child,true,0);
                        if (floating) fpParameter += 1; else gpParameter += 1;
                        parameter += 1;
                        child <- ir.nccIr.graphNodeNextSibling(graph,child); continue;
                    }
                    if (kind == 34) statement(c,child,0,null,-1);
                    child <- ir.nccIr.graphNodeNextSibling(graph,child);
                }
                if (native_types.nccNativeTypes.floating(resultCode)) {
                    constant(c,node,0); xmm(c,node,0,0,true,resultCode);
