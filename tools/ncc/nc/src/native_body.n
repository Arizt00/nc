            }
            release(c >> p<byte>) -> void {
                if (c != null) { free(callBases(c)); free(slots(c)); free(code(c)); free(literalOffsets(c)); free(globalSections(c)); free(globalOffsets(c)); free(data(c)); free(rodata(c)); free(from<byte>(rd<addr>(off(c,48)))); free(c); }
            }
            create(graph >> p<byte>) -> p<byte> {
                c >> p<byte> <- cast<byte>(calloc(1,HEADER));
                if (c == null) return null;
                wr<addr>(c,adr(graph));
                nodes >> int <- ir.nccIr.graphNodes(graph);
                poolBytes >> int <- 0;
                storageBytes >> int <- 0;
                at >> int <- 0;
                while (at < nodes) {
                    if (ir.nccIr.graphNodeAstKind(graph,at) == 25 && ir.nccIr.graphNodeRoleHash(graph,at) == 3)
                        poolBytes += ir.nccIr.graphNodeNameBytes(graph,at)+1;
                    if (globalDeclaration(c,at)) {
                        type >> int <- native_types.nccNativeTypes.code(graph,native_types.nccNativeTypes.typeNode(graph,at));
                        width >> int <- native_types.nccNativeTypes.aggregate(type) ? native_types.nccNativeTypes.aggregateBytes(graph,type) : native_types.nccNativeTypes.width(type);
                        alignment >> int <- native_types.nccNativeTypes.aggregate(type) ? native_types.nccNativeTypes.aggregateAlign(graph,type) : 16;
                        if (width <= 0 || alignment <= 0 || alignment > 1048576 || width > 2147483646-storageBytes-alignment) { free(c); return null; }
                        storageBytes += width+alignment-1;
                    }
                    at += 1;
                }
                wr<addr>(c,adr(graph));
                wr<addr>(off(c,8),adr(calloc(nodes,sizeOf(int))));
                wr<addr>(off(c,16),adr(alloc(nodes*sizeOf(int))));
                set(c,24,nodes*17+poolBytes/32); set(c,28,nodes*256+poolBytes);
                wr<addr>(off(c,48),adr(calloc(get(c,24),RECORD)));
                wr<addr>(off(c,56),adr(alloc(get(c,28))));
                wr<addr>(off(c,64),adr(alloc(nodes*sizeOf(int))));
                wr<addr>(off(c,72),adr(calloc(nodes,sizeOf(int))));
                wr<addr>(off(c,80),adr(calloc(nodes,sizeOf(int))));
                wr<addr>(off(c,88),adr(calloc(storageBytes+1,1)));
                wr<addr>(off(c,112),adr(alloc(poolBytes+1)));
                if (callBases(c) == null || slots(c) == null || code(c) == null || literalOffsets(c) == null || globalSections(c) == null || globalOffsets(c) == null || data(c) == null || rodata(c) == null || from<byte>(rd<addr>(off(c,48))) == null) { release(c); return null; }
                at <- 0;
                while (at < nodes) { wr<int>(off(slots(c),at),-1); wr(off(literalOffsets(c),at),-1); at += 1; }
                storagePlan(c);
                at <- 0;
                while (at < nodes && healthy(c)) {
                    if (ir.nccIr.graphNodeAstKind(graph,at) == 15 && !ir.nccIr.graphNodeOptimizedOut(graph,at)) emitFunction(c,at);
                    at += 1;
                }
                if (healthy(c)) stringPool(c);
                return c;
            }
    fa:
        return true;
}
