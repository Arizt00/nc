                index <- begin(c,node,11); put(c,0x31); put(c,0xC0); put(c,0xC9); put(c,0xC3); end(c,index);
            }
        internal:
            stringConcat(graph >> p<byte>, node >> int) -> bool {
                guard node >= 0 else return false;
                kind >> int <- ir.nccIr.graphNodeAstKind(graph,node);
                op >> int <- native_types.nccNativeTypes.operation(graph,node);
                if (!((kind == 28 && op == 35) || (kind == 36 && op == 37))) return false;
                left >> int <- ir.nccIr.graphNodeFirstChild(graph,node);
                right >> int <- ir.nccIr.graphNodeNextSibling(graph,left);
