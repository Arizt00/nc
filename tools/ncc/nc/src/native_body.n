                            } else {
                                alignment >> int <- ir.nccIr.graphAbi(graph) != 2 && isRecord ? native_types.nccNativeTypes.aggregateAlign(graph,type) : 8;
                                alignment <- alignment < 8 ? 8 : alignment;
                                incoming <- (incoming+alignment-1) & (0-alignment);
                                displacement >> int <- 16+(ir.nccIr.graphAbi(graph) == 2 ? 32 : 0)+incoming;
                                if (isRecord && ir.nccIr.graphAbi(graph) != 2) {
                                    index <- begin(c,child,7); put(c,0x4C); put(c,0x8D); put(c,0x95); word(c,displacement); end(c,index);
                                    address(c,child,child); copyTo(c,child,bytes);
                                } else {
                                    memoryOp(c,child,5,displacement,8,false,0,false);
                                    if (isRecord && argMode == 3) { moveReg(c,child,10,0); address(c,child,child); copyTo(c,child,bytes); }
                                    else if (isRecord) { moveReg(c,child,9,0); address(c,child,child); moveReg(c,child,11,0); packedStore(c,child,11,0,bytes,9); }
                                    else frameAccess(c,child,child,true,0);
                                }
