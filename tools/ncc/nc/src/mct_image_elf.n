use <project:mct, mct_link, mct_image_contract>;

nccMctImageElf {
    const:
        TARGET_X86_64 >> int <- 1;
        TARGET_AARCH64 >> int <- 5;
        TARGET_RISCV64 >> int <- 9;
        FORMAT_ELF64 >> int <- 2;
        ELF_HEADER_BYTES >> int <- 64;
        PROGRAM_HEADER_BYTES >> int <- 56;
        SECTION_HEADER_BYTES >> int <- 64;
        PAGE_BYTES >> int <- 0x1000;
        TEXT_AT >> int <- 0x1000;
        DYNAMIC_ENTRIES >> int <- 16;
        DYNAMIC_BYTES >> int <- DYNAMIC_ENTRIES * 16;
        SHSTR_BYTES >> int <- 92;

    fn:
        private:
            supported(target >> int) -> bool {
                return target == TARGET_X86_64 || target == TARGET_AARCH64 ||
                    target == TARGET_RISCV64;
            }

            machine(target >> int) -> int {
                if (target == TARGET_AARCH64) return 183;
                if (target == TARGET_RISCV64) return 243;
                return 62;
            }

            machineFlags(target >> int) -> int {
                return target == TARGET_RISCV64 ? 4 : 0;
            }

            interpreterBytes(target >> int) -> int {
                if (target == TARGET_AARCH64) return 27;
                if (target == TARGET_RISCV64) return 33;
                return 28;
            }

            writeInterpreter(out >> p<byte>, at >> int, target >> int) -> int {
                if (target == TARGET_AARCH64)
                    return mct_image_contract.nccMctImageContract.cstring(
                        out, at, "/lib/ld-linux-aarch64.so.1", 26);
                if (target == TARGET_RISCV64)
                    return mct_image_contract.nccMctImageContract.cstring(
                        out, at, "/lib/ld-linux-riscv64-lp64d.so.1", 32);
                return mct_image_contract.nccMctImageContract.cstring(
                    out, at, "/lib64/ld-linux-x86-64.so.2", 27);
            }

            symbolBytes(material >> p<byte>, node >> int) -> int {
                ownerBytes >> int <- mct.nccMct.artifactRecordTargetOwnerBytes(
                    material, node);
                return 11 + ownerBytes + (ownerBytes > 0 ? 1 : 0) +
                    mct.nccMct.artifactRecordTargetNameBytes(material, node) + 1;
            }

            writeSymbol(out >> p<byte>, at >> int, material >> p<byte>, node >> int) -> int {
                cursor >> int <- mct_image_contract.nccMctImageContract.literal(
                    out, at, "nC.runtime.", 11);
                ownerBytes >> int <- mct.nccMct.artifactRecordTargetOwnerBytes(material, node);
                if (ownerBytes > 0) {
                    cp(off(out, cursor), mct.nccMct.artifactRecordTargetOwner(material, node),
                        ownerBytes);
                    cursor += ownerBytes;
                    mct_image_contract.nccMctImageContract.put8(out, cursor, 46);
                    cursor += 1;
                }
                nameBytes >> int <- mct.nccMct.artifactRecordTargetNameBytes(material, node);
                if (nameBytes > 0) {
                    cp(off(out, cursor), mct.nccMct.artifactRecordTargetName(material, node),
                        nameBytes);
                    cursor += nameBytes;
                }
                mct_image_contract.nccMctImageContract.put8(out, cursor, 0);
                return cursor + 1;
            }

            dynstrBytes(material >> p<byte>, plan >> p<byte>) -> int {
                bytes >> int <- 19;
                index >> int <- 0;
                while (index < mct_link.nccMctLink.finalPlanProviderCount(plan)) {
                    node >> int <- mct_link.nccMctLink.finalPlanProviderNode(plan, index);
                    bytes += symbolBytes(material, node);
                    index += 1;
                }
                return bytes;
            }

            hashSpan(value >> int, data >> p<byte>, bytes >> int) -> int {
                at >> int <- 0;
                hash >> int <- value;
                while (at < bytes) {
                    hash <- (hash << 4) + (rd<byte>(off(data, at)) & 255);
                    high >> int <- hash & 0xF0000000;
                    if (high != 0) hash <- hash ^ (high >> 24);
                    hash <- hash & 0x0FFFFFFF;
                    at += 1;
                }
                return hash;
            }

            symbolHash(material >> p<byte>, node >> int) -> int {
                hash >> int <- hashSpan(0, cast<byte>("nC.runtime."), 11);
                ownerBytes >> int <- mct.nccMct.artifactRecordTargetOwnerBytes(
                    material, node);
                if (ownerBytes > 0) {
                    hash <- hashSpan(hash,
                        mct.nccMct.artifactRecordTargetOwner(material, node), ownerBytes);
                    dot >> byte <- 46;
                    hash <- hashSpan(hash, &dot, 1);
                }
                return hashSpan(hash, mct.nccMct.artifactRecordTargetName(material, node),
                    mct.nccMct.artifactRecordTargetNameBytes(material, node));
            }

            hashBytes(providers >> int) -> int {
                return 8 + providers * 4 + (providers + 1) * 4;
            }

            writeNamesSymbolsHash(out >> p<byte>, dynstrAt >> int, dynsymAt >> int,
                hashAt >> int, material >> p<byte>, plan >> p<byte>) -> void {
                providers >> int <- mct_link.nccMctLink.finalPlanProviderCount(plan);
                mct_image_contract.nccMctImageContract.put8(out, dynstrAt, 0);
                cursor >> int <- mct_image_contract.nccMctImageContract.cstring(
                    out, dynstrAt + 1, "libncruntime.so.2", 17);
                bucketsAt >> int <- hashAt + 8;
                chainsAt >> int <- bucketsAt + providers * 4;
                mct_image_contract.nccMctImageContract.put32(out, hashAt, providers);
                mct_image_contract.nccMctImageContract.put32(out, hashAt + 4,
                    providers + 1);
                index >> int <- 0;
                while (index < providers) {
                    node >> int <- mct_link.nccMctLink.finalPlanProviderNode(plan, index);
                    nameOffset >> int <- cursor - dynstrAt;
                    cursor <- writeSymbol(out, cursor, material, node);
                    symbolAt >> int <- dynsymAt + (index + 1) * 24;
                    mct_image_contract.nccMctImageContract.put32(out, symbolAt, nameOffset);
                    mct_image_contract.nccMctImageContract.put8(out, symbolAt + 4, 0x12);

                    symbolIndex >> int <- index + 1;
                    bucket >> int <- symbolHash(material, node) % providers;
                    first >> int <- rd<int>(off(out, bucketsAt + bucket * 4));
                    if (first == 0) {
                        mct_image_contract.nccMctImageContract.put32(out,
                            bucketsAt + bucket * 4, symbolIndex);
                    } else {
                        chain >> int <- first;
                        while (rd<int>(off(out, chainsAt + chain * 4)) != 0) {
                            chain <- rd<int>(off(out, chainsAt + chain * 4));
                        }
                        mct_image_contract.nccMctImageContract.put32(out,
                            chainsAt + chain * 4, symbolIndex);
                    }
                    index += 1;
                }
            }

            jumpSlot(target >> int) -> int {
                if (target == TARGET_AARCH64) return 1026;
                if (target == TARGET_RISCV64) return 5;
                return 7;
            }

            writeRela(out >> p<byte>, at >> int, plan >> p<byte>, target >> int) -> void {
                providers >> int <- mct_link.nccMctLink.finalPlanProviderCount(plan);
                base >> int <- mct_link.nccMctLink.finalPlanImageBase(plan);
                index >> int <- 0;
                while (index < providers) {
                    relocation >> int <- at + index * 24;
                    slot >> int <- base +
                        mct_link.nccMctLink.finalPlanProviderSlotOffset(plan, index);
                    mct_image_contract.nccMctImageContract.put64(out, relocation, slot);
                    mct_image_contract.nccMctImageContract.put64Parts(out, relocation + 8,
                        jumpSlot(target), index + 1);
                    mct_image_contract.nccMctImageContract.put64(out, relocation + 16, 0);
                    index += 1;
                }
            }

            putDynamic(out >> p<byte>, at >> int, index >> int,
                tag >> int, value >> int) -> void {
                entry >> int <- at + index * 16;
                mct_image_contract.nccMctImageContract.put64(out, entry, tag);
                mct_image_contract.nccMctImageContract.put64(out, entry + 8, value);
            }

            writeDynamic(out >> p<byte>, at >> int, dynstrAt >> int, dynstrSize >> int,
                dynsymAt >> int, hashAt >> int, relaAt >> int, relaBytes >> int,
                slotAddress >> int, base >> int) -> void {
                putDynamic(out, at, 0, 1, 1);
                putDynamic(out, at, 1, 4, base + hashAt);
                putDynamic(out, at, 2, 5, base + dynstrAt);
                putDynamic(out, at, 3, 6, base + dynsymAt);
                putDynamic(out, at, 4, 10, dynstrSize);
                putDynamic(out, at, 5, 11, 24);
                putDynamic(out, at, 6, 3, slotAddress);
                putDynamic(out, at, 7, 2, relaBytes);
                putDynamic(out, at, 8, 20, 7);
                putDynamic(out, at, 9, 23, base + relaAt);
                putDynamic(out, at, 10, 7, base + relaAt);
                putDynamic(out, at, 11, 8, relaBytes);
                putDynamic(out, at, 12, 9, 24);
                putDynamic(out, at, 13, 24, 0);
                putDynamic(out, at, 14, 30, 8);
                putDynamic(out, at, 15, 0, 0);
            }

            writeProgram(out >> p<byte>, at >> int, kind >> int, flags >> int,
                fileAt >> int, address >> int, fileBytes >> int,
                memoryBytes >> int, alignment >> int) -> void {
                mct_image_contract.nccMctImageContract.put32(out, at, kind);
                mct_image_contract.nccMctImageContract.put32(out, at + 4, flags);
                mct_image_contract.nccMctImageContract.put64(out, at + 8, fileAt);
                mct_image_contract.nccMctImageContract.put64(out, at + 16, address);
                mct_image_contract.nccMctImageContract.put64(out, at + 24, address);
                mct_image_contract.nccMctImageContract.put64(out, at + 32, fileBytes);
                mct_image_contract.nccMctImageContract.put64(out, at + 40, memoryBytes);
                mct_image_contract.nccMctImageContract.put64(out, at + 48, alignment);
            }

            writeSection(out >> p<byte>, at >> int, name >> int, kind >> int,
                flags >> int, address >> int, fileAt >> int, bytes >> int,
                link >> int, info >> int, alignment >> int, entryBytes >> int) -> void {
                mct_image_contract.nccMctImageContract.put32(out, at, name);
                mct_image_contract.nccMctImageContract.put32(out, at + 4, kind);
                mct_image_contract.nccMctImageContract.put64(out, at + 8, flags);
                mct_image_contract.nccMctImageContract.put64(out, at + 16, address);
                mct_image_contract.nccMctImageContract.put64(out, at + 24, fileAt);
                mct_image_contract.nccMctImageContract.put64(out, at + 32, bytes);
                mct_image_contract.nccMctImageContract.put32(out, at + 40, link);
                mct_image_contract.nccMctImageContract.put32(out, at + 44, info);
                mct_image_contract.nccMctImageContract.put64(out, at + 48, alignment);
                mct_image_contract.nccMctImageContract.put64(out, at + 56, entryBytes);
            }

            wrapperBytes(target >> int, hasEntry >> bool) -> int {
                if (target == TARGET_X86_64) return hasEntry ? 14 : 9;
                return 12;
            }

            writeX86Wrapper(out >> p<byte>, at >> int, linked >> int,
                entry >> int) -> void {
                cursor >> int <- at;
                if (entry >= 0) {
                    mct_image_contract.nccMctImageContract.put8(out, cursor, 0xE8);
                    mct_image_contract.nccMctImageContract.put32(out, cursor + 1,
                        entry - (linked + 5));
                    cursor += 5;
                    mct_image_contract.nccMctImageContract.put8(out, cursor, 0x89);
                    mct_image_contract.nccMctImageContract.put8(out, cursor + 1, 0xC7);
                    cursor += 2;
                } else {
                    mct_image_contract.nccMctImageContract.put8(out, cursor, 0x31);
                    mct_image_contract.nccMctImageContract.put8(out, cursor + 1, 0xFF);
                    cursor += 2;
                }
                mct_image_contract.nccMctImageContract.put8(out, cursor, 0xB8);
                mct_image_contract.nccMctImageContract.put32(out, cursor + 1, 60);
                mct_image_contract.nccMctImageContract.put8(out, cursor + 5, 0x0F);
                mct_image_contract.nccMctImageContract.put8(out, cursor + 6, 0x05);
            }

            writeAarch64Wrapper(out >> p<byte>, at >> int, linked >> int,
                entry >> int) -> void {
                cursor >> int <- at;
                if (entry >= 0) {
                    delta >> int <- entry - linked;
                    branch >> int <- 0x94000000 | ((delta / 4) & 0x03FFFFFF);
                    mct_image_contract.nccMctImageContract.put32(out, cursor, branch);
                } else {
                    mct_image_contract.nccMctImageContract.put32(out, cursor, 0xD2800000);
                }
                mct_image_contract.nccMctImageContract.put32(out, cursor + 4, 0xD2800BA8);
                mct_image_contract.nccMctImageContract.put32(out, cursor + 8, 0xD4000001);
            }

            riscvJal(delta >> int) -> int {
                return (((delta >> 20) & 1) << 31) |
                    (((delta >> 1) & 0x3FF) << 21) |
                    (((delta >> 11) & 1) << 20) |
                    (((delta >> 12) & 0xFF) << 12) |
                    (1 << 7) | 0x6F;
            }

            writeRiscvWrapper(out >> p<byte>, at >> int, linked >> int,
                entry >> int) -> void {
                first >> int <- entry >= 0 ? riscvJal(entry - linked) : 0x00000513;
                mct_image_contract.nccMctImageContract.put32(out, at, first);
                mct_image_contract.nccMctImageContract.put32(out, at + 4, 0x05D00893);
                mct_image_contract.nccMctImageContract.put32(out, at + 8, 0x00000073);
            }

            writeWrapper(out >> p<byte>, at >> int, target >> int, linked >> int,
                entry >> int) -> void {
                if (target == TARGET_X86_64) { writeX86Wrapper(out, at, linked, entry); return; }
                if (target == TARGET_AARCH64) {
                    writeAarch64Wrapper(out, at, linked, entry); return;
                }
                writeRiscvWrapper(out, at, linked, entry);
            }

            writeShstr(out >> p<byte>, at >> int) -> void {
                cursor >> int <- at;
                mct_image_contract.nccMctImageContract.put8(out, cursor, 0); cursor += 1;
                cursor <- mct_image_contract.nccMctImageContract.cstring(out, cursor, ".text", 5);
                cursor <- mct_image_contract.nccMctImageContract.cstring(
                    out, cursor, ".text.start", 11);
                cursor <- mct_image_contract.nccMctImageContract.cstring(out, cursor, ".plt", 4);
                cursor <- mct_image_contract.nccMctImageContract.cstring(
                    out, cursor, ".got.plt", 8);
                cursor <- mct_image_contract.nccMctImageContract.cstring(
                    out, cursor, ".interp", 7);
                cursor <- mct_image_contract.nccMctImageContract.cstring(
                    out, cursor, ".dynstr", 7);
                cursor <- mct_image_contract.nccMctImageContract.cstring(
                    out, cursor, ".dynsym", 7);
                cursor <- mct_image_contract.nccMctImageContract.cstring(out, cursor, ".hash", 5);
                cursor <- mct_image_contract.nccMctImageContract.cstring(
                    out, cursor, ".rela.plt", 9);
                cursor <- mct_image_contract.nccMctImageContract.cstring(
                    out, cursor, ".dynamic", 8);
                mct_image_contract.nccMctImageContract.cstring(out, cursor, ".shstrtab", 9);
            }

        public:
            build(material >> p<byte>, plan >> p<byte>) -> p<byte> {
                guard material != null && plan != null &&
                    supported(mct_link.nccMctLink.finalPlanTarget(plan)) &&
                    mct_link.nccMctLink.finalPlanReady(plan) else return null;
                target >> int <- mct_link.nccMctLink.finalPlanTarget(plan);
                linked >> int <- mct_link.nccMctLink.finalPlanBytes(plan);
                guard linked > 0 else return null;
                providers >> int <- mct_link.nccMctLink.finalPlanProviderCount(plan);
                dynamic >> bool <- providers > 0;
                bodyEntry >> int <- mct_link.nccMctLink.finalPlanEntryOffset(plan);
                startBytes >> int <- wrapperBytes(target, bodyEntry >= 0);
                payloadBytes >> int <- linked + startBytes;
                textEnd >> int <- TEXT_AT + payloadBytes;
                separate >> bool <- target == TARGET_X86_64;
                phnum >> int <- (dynamic ? 5 : 1)+(separate ? 3 : 0);
                guard ELF_HEADER_BYTES + phnum * PROGRAM_HEADER_BYTES <= TEXT_AT else return null;

                interpAt >> int <- 0;
                dynstrAt >> int <- 0;
                dynsymAt >> int <- 0;
                hashAt >> int <- 0;
                relaAt >> int <- 0;
                dynamicAt >> int <- 0;
                roEnd >> int <- textEnd;
                dataEnd >> int <- textEnd;
                storageEnd >> int <- separate ? TEXT_AT+mct_link.nccMctLink.finalPlanStorageEnd(plan) : textEnd;
                dynstrSize >> int <- 0;
                relaBytes >> int <- providers * 24;
                if (dynamic) {
                    interpAt <- mct_image_contract.nccMctImageContract.align(storageEnd, PAGE_BYTES);
                    dynstrAt <- interpAt + interpreterBytes(target);
                    dynstrSize <- dynstrBytes(material, plan);
                    dynsymAt <- mct_image_contract.nccMctImageContract.align(
                        dynstrAt + dynstrSize, 8);
                    hashAt <- mct_image_contract.nccMctImageContract.align(
                        dynsymAt + (providers + 1) * 24, 4);
                    relaAt <- mct_image_contract.nccMctImageContract.align(
                        hashAt + hashBytes(providers), 8);
                    roEnd <- relaAt + relaBytes;
                    dynamicAt <- mct_image_contract.nccMctImageContract.align(roEnd, PAGE_BYTES);
                    dataEnd <- dynamicAt + DYNAMIC_BYTES;
                }

                if (!dynamic && separate) dataEnd <- storageEnd;
                shstrAt >> int <- dataEnd;
                shoff >> int <- mct_image_contract.nccMctImageContract.align(
                    shstrAt + SHSTR_BYTES+(separate ? 19 : 0), 8);
                shnum >> int <- (dynamic ? 12 : 4)+(separate ? 3 : 0);
                total >> int <- shoff + shnum * SECTION_HEADER_BYTES;
                planBase >> int <- mct_link.nccMctLink.finalPlanImageBase(plan);
                base >> int <- planBase - TEXT_AT;
                entryAddress >> int <- planBase + linked;
                image >> p<byte> <- mct_image_contract.nccMctImageContract.make(
                    FORMAT_ELF64, target, total, entryAddress, providers,
                    dynamic ? 3 : 1);
                guard image != null else return null;
                out >> p<byte> <- mct_image_contract.nccMctImageContract.data(image);

                mct_image_contract.nccMctImageContract.put8(out, 0, 0x7F);
                mct_image_contract.nccMctImageContract.put8(out, 1, 0x45);
                mct_image_contract.nccMctImageContract.put8(out, 2, 0x4C);
                mct_image_contract.nccMctImageContract.put8(out, 3, 0x46);
                mct_image_contract.nccMctImageContract.put8(out, 4, 2);
                mct_image_contract.nccMctImageContract.put8(out, 5, 1);
                mct_image_contract.nccMctImageContract.put8(out, 6, 1);
                mct_image_contract.nccMctImageContract.put16(out, 16, 2);
                mct_image_contract.nccMctImageContract.put16(out, 18, machine(target));
                mct_image_contract.nccMctImageContract.put32(out, 20, 1);
                mct_image_contract.nccMctImageContract.put64(out, 24, entryAddress);
                mct_image_contract.nccMctImageContract.put64(out, 32, ELF_HEADER_BYTES);
                mct_image_contract.nccMctImageContract.put64(out, 40, shoff);
                mct_image_contract.nccMctImageContract.put32(out, 48, machineFlags(target));
                mct_image_contract.nccMctImageContract.put16(out, 52, ELF_HEADER_BYTES);
                mct_image_contract.nccMctImageContract.put16(out, 54, PROGRAM_HEADER_BYTES);
                mct_image_contract.nccMctImageContract.put16(out, 56, phnum);
                mct_image_contract.nccMctImageContract.put16(out, 58, SECTION_HEADER_BYTES);
                mct_image_contract.nccMctImageContract.put16(out, 60, shnum);
                mct_image_contract.nccMctImageContract.put16(out, 62, shnum - 1);

                programAt >> int <- ELF_HEADER_BYTES;
                writeProgram(out, programAt, 1, separate ? 5 : (dynamic ? 7 : 5), 0, base,
                    textEnd, textEnd, PAGE_BYTES);
                programAt += PROGRAM_HEADER_BYTES;
                if (separate) {
                    roOffset >> int <- TEXT_AT+mct_link.nccMctLink.sectionOffset(plan,4);
                    dataOffset >> int <- TEXT_AT+mct_link.nccMctLink.sectionOffset(plan,2);
                    writeProgram(out,programAt,1,4,roOffset,base+roOffset,dataOffset-roOffset,dataOffset-roOffset,PAGE_BYTES);
                    programAt += PROGRAM_HEADER_BYTES;
                    writeProgram(out,programAt,1,6,dataOffset,base+dataOffset,storageEnd-dataOffset,storageEnd-dataOffset,PAGE_BYTES);
                    programAt += PROGRAM_HEADER_BYTES;
                    writeProgram(out,programAt,0x6474E551,6,0,0,0,0,16);
                    programAt += PROGRAM_HEADER_BYTES;
                }
                if (dynamic) {
                    writeProgram(out, programAt, 1, 4, interpAt, base + interpAt,
                        roEnd - interpAt, roEnd - interpAt, PAGE_BYTES);
                    programAt += PROGRAM_HEADER_BYTES;
                    writeProgram(out, programAt, 1, 6, dynamicAt, base + dynamicAt,
                        DYNAMIC_BYTES, DYNAMIC_BYTES, PAGE_BYTES);
                    programAt += PROGRAM_HEADER_BYTES;
                    writeProgram(out, programAt, 3, 4, interpAt, base + interpAt,
                        interpreterBytes(target), interpreterBytes(target), 1);
                    programAt += PROGRAM_HEADER_BYTES;
                    writeProgram(out, programAt, 2, 6, dynamicAt, base + dynamicAt,
                        DYNAMIC_BYTES, DYNAMIC_BYTES, 8);
                }

                cp(off(out, TEXT_AT), mct_link.nccMctLink.finalPlanData(plan), linked);
                if (separate) {
                    roOffset >> int <- mct_link.nccMctLink.sectionOffset(plan,4);
                    cp(off(out,TEXT_AT+roOffset),off<byte>(mct_link.nccMctLink.finalPlanData(plan),roOffset),
                        storageEnd-TEXT_AT-roOffset);
                }
                writeWrapper(out, TEXT_AT + linked, target, linked, bodyEntry);
                if (dynamic) {
                    writeInterpreter(out, interpAt, target);
                    writeNamesSymbolsHash(out, dynstrAt, dynsymAt, hashAt, material, plan);
                    writeRela(out, relaAt, plan, target);
                    slotAddress >> int <- planBase +
                        mct_link.nccMctLink.finalPlanProviderSlotOffset(plan, 0);
                    writeDynamic(out, dynamicAt, dynstrAt, dynstrSize, dynsymAt, hashAt,
                        relaAt, relaBytes, slotAddress, base);
                }
                writeShstr(out, shstrAt);

                sectionAt >> int <- shoff + SECTION_HEADER_BYTES;
                writeSection(out, sectionAt, 1, 1, 6, planBase, TEXT_AT,
                    mct_link.nccMctLink.finalPlanTextBytes(plan), 0, 0, 16, 0);
                sectionAt += SECTION_HEADER_BYTES;
                writeSection(out, sectionAt, 7, 1, 6, entryAddress,
                    TEXT_AT + linked, startBytes, 0, 0, 4, 0);
                sectionAt += SECTION_HEADER_BYTES;
                if (dynamic) {
                    thunkOffset >> int <- mct_link.nccMctLink.finalPlanProviderThunkOffset(plan, 0);
                    slotOffset >> int <- mct_link.nccMctLink.finalPlanProviderSlotOffset(plan, 0);
                    writeSection(out, sectionAt, 19, 1, 6, planBase + thunkOffset,
                        TEXT_AT + thunkOffset,
                        providers * mct_link.nccMctLink.finalPlanThunkStride(plan),
                        0, 0, 16, 16);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out, sectionAt, 24, 1, 3, planBase + slotOffset,
                        TEXT_AT + slotOffset,
                        providers * mct_link.nccMctLink.finalPlanSlotStride(plan),
                        0, 0, 8, 8);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out, sectionAt, 33, 1, 2, base + interpAt, interpAt,
                        interpreterBytes(target), 0, 0, 1, 0);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out, sectionAt, 41, 3, 2, base + dynstrAt, dynstrAt,
                        dynstrSize, 0, 0, 1, 0);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out, sectionAt, 49, 11, 2, base + dynsymAt, dynsymAt,
                        (providers + 1) * 24, 6, 1, 8, 24);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out, sectionAt, 57, 5, 2, base + hashAt, hashAt,
                        hashBytes(providers), 7, 0, 4, 4);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out, sectionAt, 63, 4, 2, base + relaAt, relaAt,
                        relaBytes, 7, 4, 8, 24);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out, sectionAt, 73, 6, 3, base + dynamicAt, dynamicAt,
                        DYNAMIC_BYTES, 6, 0, 8, 16);
                    sectionAt += SECTION_HEADER_BYTES;
                }
                if (separate) {
                    mct_image_contract.nccMctImageContract.literal(out,shstrAt+92,".rodata",7);
                    mct_image_contract.nccMctImageContract.literal(out,shstrAt+100,".data",5);
                    mct_image_contract.nccMctImageContract.literal(out,shstrAt+106,".bss",4);
                    roOffset >> int <- mct_link.nccMctLink.sectionOffset(plan,4);
                    dataOffset >> int <- mct_link.nccMctLink.sectionOffset(plan,2);
                    bssOffset >> int <- mct_link.nccMctLink.sectionOffset(plan,3);
                    writeSection(out,sectionAt,92,1,2,planBase+roOffset,TEXT_AT+roOffset,
                        mct_link.nccMctLink.finalPlanSectionBytes(plan,4),0,0,1,0);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out,sectionAt,100,1,3,planBase+dataOffset,TEXT_AT+dataOffset,
                        mct_link.nccMctLink.finalPlanSectionBytes(plan,2),0,0,mct.nccMct.artifactStorageAlignment(material),0);
                    sectionAt += SECTION_HEADER_BYTES;
                    writeSection(out,sectionAt,106,8,3,planBase+bssOffset,TEXT_AT+bssOffset,
                        mct_link.nccMctLink.finalPlanSectionBytes(plan,3),0,0,mct.nccMct.artifactStorageAlignment(material),0);
                    sectionAt += SECTION_HEADER_BYTES;
                }
                writeSection(out, sectionAt, 82, 3, 0, 0, shstrAt,
                    SHSTR_BYTES+(separate ? 19 : 0), 0, 0, 1, 0);
                return mct_image_contract.nccMctImageContract.finish(image);
            }

            selfTest() -> bool {
                return TARGET_X86_64 == 1 && TARGET_AARCH64 == 5 &&
                    TARGET_RISCV64 == 9 && FORMAT_ELF64 == 2 &&
                    ELF_HEADER_BYTES + 5 * PROGRAM_HEADER_BYTES < TEXT_AT &&
                    SHSTR_BYTES == 92;
            }

    fa:
        return true;
}
