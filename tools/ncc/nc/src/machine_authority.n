use <text:string>;

nccMachineAuthority {
    const:
        ARCH_X86_64 >> str <- "x86_64";
        ARCH_I386 >> str <- "i386";
        ARCH_AARCH64 >> str <- "aarch64";
        ARCH_ARMV7 >> str <- "armv7";
        ARCH_RISCV32 >> str <- "riscv32";
        ARCH_RISCV64 >> str <- "riscv64";
        ARCH_WASM32 >> str <- "wasm32";

        ISA_X86_64 >> str <- "|mov|lea|add|sub|cmp|call|ret|clc|stc|cli|sti|cld|std|hlt|endbr64|endbr32|rdpkru|wrpkru|serialize|cldemote|clflush|clflushopt|clwb|prefetchnta|prefetcht0|prefetcht1|prefetcht2|monitor|mwait|umonitor|umwait|tpause|syscall|sysret|rdtsc|rdtscp|rdpmc|rdpid|cpuid|getsec|rdmsr|wrmsr|clts|invd|wbinvd|wbnoinvd|swapgs|rsm|ud2|rdrand|rdseed|aesenc|pclmulqdq|sha256rnds2|vmxon|vmptrld|vmptrst|vmread|vmwrite|invept|invvpid|vmrun|vmload|vmsave|";
        ISA_I386 >> str <- "|mov|lea|add|sub|cmp|call|ret|endbr32|rdpkru|wrpkru|rdpmc|rdpid|getsec|pushad|popad|aaa|aad|aam|aas|daa|das|salc|icebp|into|xlatb|ud2|in|out|hlt|nop|";
        ISA_AARCH64 >> str <- "|mov|adr|adrp|add|sub|cmp|b|bl|br|ret|ldr|str|ldxr|stxr|cas|swp|dmb|dsb|isb|sb|ssbb|pssbb|csdb|esb|tsb|dgh|xaflag|axflag|wfet|wfit|wfi|wfe|sev|eret|paciasp|autiasp|xpaclri|xpaci|xpacd|paciza|autiza|pacia|autda|whilelo|ptrue|pfalse|ld1b|ld1h|ld1w|ld1d|st1b|st1h|st1w|st1d|cntb|cnth|cntw|cntd|incb|inch|incw|incd|cmpeq|cmpne|cmplt|cmpgt|cmpge|cmple|sel|fmla|faddv|";
        ISA_ARMV7 >> str <- "|mov|movw|movt|add|sub|cmp|b|bl|bx|ldr|str|ldrex|strex|clrex|svc|hvc|smc|dbg|dmb|dsb|isb|yield|wfi|wfe|sev|setend|cpsid|cpsie|qadd|qsub|ssat|usat|rbit|rev|";
        ISA_RISCV32 >> str <- "|lui|auipc|jal|jalr|beq|bne|blt|bge|lb|lh|lw|sb|sh|sw|addi|add|sub|mul|div|rem|and|or|xor|sll|srl|sra|fence|fence.tso|fence.i|pause|wrs.nto|wrs.sto|cbo.clean|cbo.flush|cbo.inval|cbo.zero|ecall|ebreak|mret|sret|sfence.vma|sfence.w.inval|sfence.inval.ir|sinval.vma|hfence.vvma|hfence.gvma|hinval.vvma|hinval.gvma|hlv.b|hlv.bu|hlv.h|hlv.hu|hlv.w|hlvx.hu|hsv.b|hsv.h|hsv.w|csrr|csrw|csrrw|csrrs|csrrc|csrrwi|csrrsi|csrrci|lr.w|sc.w|amoadd.w|czero.eqz|czero.nez|clz|ctz|cpop|sext.b|sext.h|zext.h|orc.b|rev8|bset|bclr|binv|bext|bseti|bclri|binvi|bexti|";
        ISA_RISCV64 >> str <- "|lui|auipc|jal|jalr|beq|bne|blt|bge|lb|lh|lw|ld|sb|sh|sw|sd|addi|addiw|add|sub|mul|div|rem|and|or|xor|sll|srl|sra|fence|fence.tso|fence.i|pause|wrs.nto|wrs.sto|cbo.clean|cbo.flush|cbo.inval|cbo.zero|ecall|ebreak|mret|sret|sfence.vma|sfence.w.inval|sfence.inval.ir|sinval.vma|hfence.vvma|hfence.gvma|hinval.vvma|hinval.gvma|hlv.b|hlv.bu|hlv.h|hlv.hu|hlv.w|hlv.wu|hlv.d|hlvx.hu|hlvx.wu|hsv.b|hsv.h|hsv.w|hsv.d|csrr|csrw|csrrw|csrrs|csrrc|csrrwi|csrrsi|csrrci|lr.d|sc.d|amoadd.d|czero.eqz|czero.nez|clz|ctz|cpop|clzw|ctzw|cpopw|sext.b|sext.h|zext.h|orc.b|rev8|bset|bclr|binv|bext|bseti|bclri|binvi|bexti|";
        ISA_WASM32 >> str <- "|unreachable|nop|block|loop|br|br_if|call|return|drop|select|local.get|local.set|local.tee|table.get|table.set|table.size|table.grow|table.fill|table.copy|table.init|elem.drop|ref.null|ref.is_null|ref.func|i32.const|i64.const|i32.load|i64.load|i32.store|i64.store|i32.eqz|i32.eq|i32.ne|i32.add|i32.sub|i32.mul|i32.div_s|i32.div_u|i32.and|i32.or|i32.xor|i64.eqz|i64.add|i64.sub|i64.mul|i64.div_s|i64.div_u|i64.and|i64.or|i64.xor|memory.size|memory.grow|memory.copy|memory.fill|memory.init|data.drop|";

        LEGACY_X86 >> str <- "|aaa|aad|aam|aas|daa|das|salc|icebp|into|xlatb|pushad|popad|";
        PRIVILEGED >> str <- "|clts|invd|wbinvd|wbnoinvd|getsec|swapgs|rsm|rdmsr|wrmsr|vmxon|vmptrld|vmptrst|vmread|vmwrite|invept|invvpid|vmrun|vmload|vmsave|hvc|smc|eret|mret|sret|sfence.vma|sfence.w.inval|sfence.inval.ir|sinval.vma|hfence.vvma|hfence.gvma|hinval.vvma|hinval.gvma|hlv.b|hlv.bu|hlv.h|hlv.hu|hlv.w|hlv.wu|hlv.d|hlvx.hu|hlvx.wu|hsv.b|hsv.h|hsv.w|hsv.d|";

    type:
        TargetContract {
            public:
                target >> str;
                arch >> str;
                abi >> str;
                object >> str;
                pointerWidth >> int;
                endian >> str;
                executableKind >> str;
                startupKind >> str;
        }

    stc:
        queries >> u64 <- 0;

    fn:
        private:
            same(left >> str, right >> str) -> bool {
                a >> p<byte> <- cast<byte>(left);
                b >> p<byte> <- cast<byte>(right);
                at >> int <- 0;
                while (rd<byte>(off(a, at)) != 0 && rd<byte>(off(b, at)) != 0) {
                    if (rd<byte>(off(a, at)) != rd<byte>(off(b, at))) return false;
                    at += 1;
                }
                return rd<byte>(off(a, at)) == rd<byte>(off(b, at));
            }

            catalogHas(catalog >> str, symbol >> str) -> bool {
                return strContains(catalog, "|" + symbol + "|");
            }

        public:
            normalizeArch(arch >> str) -> str {
                if (same(arch, "amd64")) return ARCH_X86_64;
                if (same(arch, "x86") || same(arch, "i686")) return ARCH_I386;
                if (same(arch, "arm64")) return ARCH_AARCH64;
                if (same(arch, "thumb") || same(arch, "thumb2")) return ARCH_ARMV7;
                if (same(arch, "rv32")) return ARCH_RISCV32;
                if (same(arch, "rv64")) return ARCH_RISCV64;
                return arch;
            }

            targetArch(target >> str) -> str {
                if (strStartsWith(target, "x86_64-")) return ARCH_X86_64;
                if (strStartsWith(target, "i386-") || strStartsWith(target, "i686-")) return ARCH_I386;
                if (strStartsWith(target, "aarch64-")) return ARCH_AARCH64;
                if (strStartsWith(target, "armv7-") || strStartsWith(target, "thumbv7-")) return ARCH_ARMV7;
                if (strStartsWith(target, "riscv32")) return ARCH_RISCV32;
                if (strStartsWith(target, "riscv64")) return ARCH_RISCV64;
                if (strStartsWith(target, "wasm32-")) return ARCH_WASM32;
                return "";
            }

            pointerWidth(target >> str) -> int {
                arch >> str <- targetArch(target);
                if (arch == ARCH_X86_64 || arch == ARCH_AARCH64 || arch == ARCH_RISCV64) return 64;
                if (arch == ARCH_I386 || arch == ARCH_ARMV7 || arch == ARCH_RISCV32 || arch == ARCH_WASM32) return 32;
                return 0;
            }

            abi(target >> str) -> str {
                arch >> str <- targetArch(target);
                if (arch == ARCH_X86_64 && strContains(target, "windows")) return "win64";
                if (arch == ARCH_X86_64) return "sysv64";
                if (arch == ARCH_I386) return "cdecl";
                if (arch == ARCH_AARCH64) return "aapcs64";
                if (arch == ARCH_ARMV7) return "aapcs32";
                if (arch == ARCH_RISCV32) return "ilp32";
                if (arch == ARCH_RISCV64) return "lp64";
                if (arch == ARCH_WASM32) return "wasm";
                return "";
            }

            object(target >> str) -> str {
                arch >> str <- targetArch(target);
                if (strContains(target, "windows")) return "coff";
                if (strContains(target, "darwin") || strContains(target, "apple")) return "macho64";
                if (arch == ARCH_X86_64 || arch == ARCH_AARCH64 || arch == ARCH_RISCV64) return "elf64";
                if (arch == ARCH_I386 || arch == ARCH_ARMV7 || arch == ARCH_RISCV32) return "elf32";
                if (arch == ARCH_WASM32) return "wasm";
                return "";
            }

            executableKind(target >> str) -> str {
                if (strContains(target, "windows")) return "pe";
                if (strContains(target, "darwin") || strContains(target, "apple")) return "macho";
                if (targetArch(target) == ARCH_WASM32) return "wasm";
                return targetArch(target) == "" ? "" : "elf";
            }

            loaderKind(target >> str) -> str {
                kind >> str <- executableKind(target);
                if (kind == "pe") return "windows-pe-loader";
                if (kind == "macho") return "darwin-macho-loader";
                if (kind == "wasm") return "wasi-module-loader";
                if (strContains(target, "none") || strContains(target, "unknown-elf")) {
                    return "firmware-elf-loader";
                }
                return kind == "elf" ? "host-elf-loader" : "";
            }

            startupKind(target >> str) -> str {
                arch >> str <- targetArch(target);
                if (arch == ARCH_WASM32) return "wasm-module";
                if (strContains(target, "none") || strContains(target, "unknown-elf")) return "freestanding-entry-object";
                return "machine-entry-object";
            }

            executableSuffix(target >> str) -> str {
                kind >> str <- executableKind(target);
                if (kind == "pe") return ".exe";
                if (kind == "wasm") return ".wasm";
                return "";
            }

            catalog(arch >> str) -> str {
                normalized >> str <- normalizeArch(arch);
                if (normalized == ARCH_X86_64) return ISA_X86_64;
                if (normalized == ARCH_I386) return ISA_I386;
                if (normalized == ARCH_AARCH64) return ISA_AARCH64;
                if (normalized == ARCH_ARMV7) return ISA_ARMV7;
                if (normalized == ARCH_RISCV32) return ISA_RISCV32;
                if (normalized == ARCH_RISCV64) return ISA_RISCV64;
                if (normalized == ARCH_WASM32) return ISA_WASM32;
                return "";
            }

            supports(arch >> str, symbol >> str) -> bool {
                queries += 1;
                material >> str <- catalog(arch);
                return material != "" && catalogHas(material, symbol);
            }

            supportsAny(symbol >> str) -> bool {
                return catalogHas(ISA_X86_64, symbol) || catalogHas(ISA_I386, symbol) ||
                    catalogHas(ISA_AARCH64, symbol) || catalogHas(ISA_ARMV7, symbol) ||
                    catalogHas(ISA_RISCV32, symbol) || catalogHas(ISA_RISCV64, symbol) ||
                    catalogHas(ISA_WASM32, symbol);
            }

            legacy(symbol >> str) -> bool { return catalogHas(LEGACY_X86, symbol); }
            privileged(symbol >> str) -> bool { return catalogHas(PRIVILEGED, symbol); }

            selfTest() -> bool {
                return targetArch("x86_64-pc-windows-msvc") == ARCH_X86_64 &&
                    pointerWidth("riscv32imac-unknown-elf") == 32 &&
                    abi("aarch64-apple-darwin") == "aapcs64" &&
                    object("armv7-unknown-linux-gnueabihf") == "elf32" &&
                    executableSuffix("x86_64-pc-windows-msvc") == ".exe" &&
                    executableSuffix("wasm32-wasi") == ".wasm" &&
                    loaderKind("aarch64-apple-darwin") == "darwin-macho-loader" &&
                    loaderKind("riscv32imac-unknown-elf") == "firmware-elf-loader" &&
                    startupKind("riscv32imac-unknown-elf") == "freestanding-entry-object" &&
                    supports("x86_64", "endbr64") && supports("i386", "xlatb") &&
                    supports("x86_64", "wbnoinvd") && supports("x86_64", "getsec") &&
                    supports("i386", "rdpid") && supports("x86_64", "rdpmc") &&
                    supports("aarch64", "esb") && supports("aarch64", "dgh") &&
                    supports("aarch64", "wfet") && supports("armv7", "dbg") &&
                    supports("armv7", "hvc") && supports("armv7", "cpsid") &&
                    supports("riscv64", "hfence.gvma") && supports("riscv64", "hlv.d") &&
                    supports("riscv32", "sinval.vma") && supports("wasm32", "memory.init") &&
                    supports("wasm32", "table.size") && supports("wasm32", "table.copy") &&
                    legacy("aaa") && privileged("vmxon") && privileged("getsec");
            }

    fa:
        return true;
}
