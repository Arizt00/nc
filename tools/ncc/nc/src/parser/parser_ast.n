use <io:output, render>;
use <project:lexer, diagnostics, ast_arena, ast_schema, parser_modules>;

nccParserAst {
    const:
        AST_BYTES >> int <- 48;
        NODE_BYTES >> int <- 64;
        A_NODES >> int <- 0;
        A_COUNT >> int <- 8;
        A_ERROR >> int <- 16;
        A_ERROR_LINE >> int <- 24;
        A_ERROR_COLUMN >> int <- 32;

        N_KIND >> int <- 0;
        N_PARENT >> int <- 4;
        N_LINE >> int <- 8;
        N_COLUMN >> int <- 12;
        N_NAME_HASH >> int <- 16;
        N_ROLE_HASH >> int <- 20;
        N_FIRST_TOKEN >> int <- 24;
        N_END_TOKEN >> int <- 28;
        N_FIRST_CHILD >> int <- 32;
        N_NEXT_SIBLING >> int <- 36;
        N_TYPE_HASH >> int <- 40;
        N_FLAGS >> int <- 44;

        AST_PROGRAM >> int <- 1;
        AST_USE_GROUP >> int <- 2;
        AST_CONTAINER >> int <- 3;
        AST_CONST_SECTION >> int <- 4;
        AST_TYPE_SECTION >> int <- 5;
        AST_STC_SECTION >> int <- 6;
        AST_LOCAL_SECTION >> int <- 7;
        AST_FN_SECTION >> int <- 8;
        AST_FA_SECTION >> int <- 9;
        AST_GLOBAL_CONST >> int <- 10;
        AST_GLOBAL_TYPE >> int <- 11;
        AST_VALUE_DECL >> int <- 12;
        AST_TYPE_DECL >> int <- 13;
        AST_FIELD_DECL >> int <- 14;
        AST_FUNCTION_DECL >> int <- 15;
        AST_PARAMETER_DECL >> int <- 16;
        AST_ENTRY_REF >> int <- 17;
        AST_TYPE_NAME >> int <- 18;
        AST_TYPE_APPLY >> int <- 19;
        AST_TYPE_POINTER >> int <- 20;
        AST_TYPE_ARRAY >> int <- 21;
        AST_TYPE_UNION >> int <- 22;
        AST_TYPE_FUNCTION >> int <- 23;
        AST_TYPE_CONST >> int <- 24;
        AST_EXPR_LITERAL >> int <- 25;
        AST_EXPR_NAME >> int <- 26;
        AST_EXPR_UNARY >> int <- 27;
        AST_EXPR_BINARY >> int <- 28;
        AST_EXPR_CALL >> int <- 29;
        AST_EXPR_MEMBER >> int <- 30;
        AST_EXPR_INDEX >> int <- 31;
        AST_EXPR_TERNARY >> int <- 32;
        AST_EXPR_ARRAY >> int <- 33;
        AST_BLOCK >> int <- 34;
        AST_STMT_EXPRESSION >> int <- 35;
        AST_STMT_ASSIGN >> int <- 36;
        AST_STMT_RETURN >> int <- 37;
        AST_STMT_IF >> int <- 38;
        AST_STMT_WHILE >> int <- 39;
        AST_STMT_FOR >> int <- 40;
        AST_STMT_GUARD >> int <- 41;
        AST_STMT_DEFER >> int <- 42;
        AST_STMT_BREAK >> int <- 43;
        AST_STMT_CONTINUE >> int <- 44;
        AST_EXPR_STRUCT >> int <- 45;
        AST_EXPR_FIELD >> int <- 46;
        AST_EXPR_CLOSURE >> int <- 47;
        AST_EXPR_TRY >> int <- 48;
        AST_EXPR_PREFIX >> int <- 49;
        AST_EXPR_IF >> int <- 50;
        AST_STMT_MATCH >> int <- 51;
        AST_MATCH_ARM >> int <- 52;
        AST_STMT_FOR_IN >> int <- 53;
        AST_STMT_FOR_RANGE >> int <- 54;
        AST_STMT_LOOP >> int <- 55;
        AST_STMT_REPEAT >> int <- 56;
        AST_STMT_DO_WHILE >> int <- 57;
        AST_STMT_UNLESS >> int <- 58;
        AST_STMT_YIELD >> int <- 59;
        AST_PATTERN_WILDCARD >> int <- 60;
        AST_PATTERN_LITERAL >> int <- 61;
        AST_PATTERN_BINDING >> int <- 62;
        AST_PATTERN_VARIANT >> int <- 63;
        AST_PATTERN_STRUCT >> int <- 64;
        AST_PATTERN_FIELD >> int <- 65;
        AST_PATTERN_ARRAY >> int <- 66;
        AST_PATTERN_RANGE >> int <- 67;
        AST_PATTERN_REST >> int <- 68;
        AST_CLOSURE_PARAMETER >> int <- 69;
        AST_CLOSURE_CAPTURE >> int <- 70;
        AST_CLOSURE_EFFECT >> int <- 71;
        AST_GENERIC_DECL >> int <- 72;
        AST_GENERIC_PARAM >> int <- 73;
        AST_GENERIC_APPLY >> int <- 74;
        AST_TRAIT_DECL >> int <- 75;
        AST_IMPL_DECL >> int <- 76;
        AST_ASSOCIATED_TYPE >> int <- 77;
        AST_ABI_CONTRACT >> int <- 78;
        AST_ABI_FIELD >> int <- 79;
        AST_ABI_BINDING >> int <- 80;
        AST_TYPE_CLAUSE >> int <- 86;
        AST_CONTRACT_ITEM >> int <- 87;
        AST_TYPE_VARIANT >> int <- 88;
        AST_TYPE_GENERIC_PARAM >> int <- 89;

        VIS_DEFAULT >> int <- 0;
        VIS_PUBLIC >> int <- 1;
        VIS_PRIVATE >> int <- 2;
        VIS_INTERNAL >> int <- 3;
        VIS_STRICTLY >> int <- 4;

        T_IDENTIFIER >> int <- 1;
        T_NUMBER >> int <- 2;
        T_STRING >> int <- 3;
        T_CHAR >> int <- 4;
        T_LBRACE >> int <- 5;
        T_RBRACE >> int <- 6;
        T_LPAREN >> int <- 7;
        T_RPAREN >> int <- 8;
        T_LBRACKET >> int <- 9;
        T_RBRACKET >> int <- 10;
        T_COLON >> int <- 13;
        T_SEMICOLON >> int <- 14;
        T_COMMA >> int <- 15;
        T_DOT >> int <- 16;
        T_AT >> int <- 17;
        T_STAR >> int <- 18;
        T_ARROW >> int <- 19;
        T_SHIFT2 >> int <- 21;
        T_SHIFT3 >> int <- 22;
        T_LESS_DASH >> int <- 24;
        T_PIPE >> int <- 25;
        T_GREATER >> int <- 26;
        T_LESS >> int <- 27;
        T_GREATER_EQ >> int <- 28;
        T_LESS_EQ >> int <- 29;
        T_EQ >> int <- 30;
        T_EQ_EQ >> int <- 31;
        T_NOT_EQ >> int <- 32;
        T_BANG >> int <- 33;
        T_TILDE >> int <- 34;
        T_PLUS >> int <- 35;
        T_PLUS_PLUS >> int <- 36;
        T_PLUS_EQ >> int <- 37;
        T_MINUS >> int <- 38;
        T_MINUS_MINUS >> int <- 39;
        T_MINUS_EQ >> int <- 40;
        T_SLASH >> int <- 41;
        T_PERCENT >> int <- 42;
        T_AMP >> int <- 43;
        T_CARET >> int <- 44;
        T_QUESTION >> int <- 45;
        T_SHIFT_LEFT >> int <- 46;
        T_STAR_EQ >> int <- 47;
        T_AND_AND >> int <- 48;
        T_OR_OR >> int <- 49;
        T_KEYWORD_USE >> int <- 50;
        T_KEYWORD_IMPORT >> int <- 51;
        T_KEYWORD_STC >> int <- 52;
        T_KEYWORD_LOCAL >> int <- 53;
        T_KEYWORD_FN >> int <- 54;
        T_KEYWORD_MOVE >> int <- 55;
        T_KEYWORD_STR >> int <- 61;
        T_KEYWORD_FA >> int <- 63;
        T_KEYWORD_PUBLIC >> int <- 64;
        T_KEYWORD_PRIVATE >> int <- 65;
        T_KEYWORD_INTERNAL >> int <- 66;
        T_KEYWORD_RETURN >> int <- 68;
        T_KEYWORD_IF >> int <- 70;
        T_KEYWORD_ELSE >> int <- 71;
        T_KEYWORD_WHILE >> int <- 72;
        T_KEYWORD_REF >> int <- 73;
        T_KEYWORD_MAIN >> int <- 74;
        T_KEYWORD_TRUE >> int <- 76;
        T_KEYWORD_FALSE >> int <- 77;
        T_EOF >> int <- 101;

        TYPE_CONTEXT_BYTES >> int <- 24;
        TC_AT >> int <- 0;
        TC_END >> int <- 8;
        TC_PENDING_GT >> int <- 16;

        EXPR_CONTEXT_BYTES >> int <- 16;
        EC_AT >> int <- 0;
        EC_END >> int <- 8;

        STMT_CONTEXT_BYTES >> int <- 16;
        SC_AT >> int <- 0;
        SC_END >> int <- 8;

        MATERIAL_SESSION_BYTES >> int <- 16;
        MS_STATE >> int <- 0;
        MS_AST >> int <- 8;

    fn:
        private:
            field(value >> p<byte>, byteAt >> int) -> int {
                return rd<int>(off(value, byteAt));
            }

            put(value >> p<byte>, byteAt >> int, item >> int) -> void {
                wr<int>(off(value, byteAt), item);
            }

            node(ast >> p<byte>, index >> int) -> p<byte> {
                return ast_arena.nccAstArena.node(ast, index);
            }

            materialState(session >> p<byte>) -> p<byte> {
                return from<byte>(rd<addr>(off(session, MS_STATE)));
            }

            materialAst(session >> p<byte>) -> p<byte> {
                return from<byte>(rd<addr>(off(session, MS_AST)));
            }

            kind(state >> p<byte>, index >> int) -> int {
                if (index < 0 || index >= lexer.nccLexer.tokenCount(state)) return T_EOF;
                return lexer.nccLexer.tokenKindAt(state, index);
            }

            makeAst(tokenCount >> int) -> p<byte> {
                guard tokenCount >= 0 && tokenCount <= 3355430 else return null;
                return ast_arena.nccAstArena.open(tokenCount * 10 + 128);
            }

            releaseAst(ast >> p<byte>) -> bool {
                return ast_arena.nccAstArena.close(ast);
            }

            adopt(ast >> p<byte>, parent >> int, child >> int) -> bool {
                return ast_arena.nccAstArena.attach(ast, parent, child);
            }

            appendNode(
                ast >> p<byte>, nodeKind >> int, parent >> int, line >> int,
                column >> int, nameHash >> int, roleHash >> int, firstToken >> int
            ) -> int {
                return ast_arena.nccAstArena.append(ast, nodeKind, parent, line,
                    column, nameHash, roleHash, firstToken);
            }

            closeNode(ast >> p<byte>, index >> int, endToken >> int) -> bool {
                if (index >= 0) put(node(ast, index), N_END_TOKEN, endToken);
                return true;
            }

            appendTypedNode(
                ast >> p<byte>,
                nodeKind >> int,
                parent >> int,
                state >> p<byte>,
                firstToken >> int,
                typeToken >> int,
                flags >> int
            ) -> int {
                nameHash >> int <- lexer.nccLexer.identifierKind(kind(state, firstToken)) ?
                    lexer.nccLexer.identifierHashAt(state, firstToken) :
                    lexer.nccLexer.tokenHashAt(state, firstToken);
                index >> int <- appendNode(ast, nodeKind, parent,
                    lexer.nccLexer.tokenLineAt(state, firstToken),
                    lexer.nccLexer.tokenColumnAt(state, firstToken),
                    nameHash, 0, firstToken);
                if (typeToken >= 0) {
                    put(node(ast, index), N_TYPE_HASH,
                        lexer.nccLexer.tokenHashAt(state, typeToken));
                }
                put(node(ast, index), N_FLAGS, flags);
                return index;
            }

            visibility(token >> int) -> int {
                if (token == T_KEYWORD_PUBLIC) return VIS_PUBLIC;
                if (token == T_KEYWORD_PRIVATE) return VIS_PRIVATE;
                if (token == T_KEYWORD_INTERNAL) return VIS_INTERNAL;
                if (token == 67) return VIS_STRICTLY;
                return VIS_DEFAULT;
            }

            declarationBoundary(state >> p<byte>, index >> int) -> bool {
                if (index <= 0) return true;
                previous >> int <- kind(state, index - 1);
                return previous == T_COLON || previous == T_SEMICOLON ||
                    previous == T_LBRACE || previous == T_RBRACE;
            }

            parameterBoundary(state >> p<byte>, index >> int) -> bool {
                if (index <= 0) return false;
                previous >> int <- kind(state, index - 1);
                return previous == T_LPAREN || previous == T_COMMA;
            }

            typeContext(start >> int, end >> int) -> p<byte> {
                context >> p<byte> <- cast<byte>(alloc(TYPE_CONTEXT_BYTES));
                guard context != null else return null;
                wr<int>(off(context, TC_AT), start);
                wr<int>(off(context, TC_END), end);
                wr<int>(off(context, TC_PENDING_GT), 0);
                return context;
            }

            typeAt(context >> p<byte>) -> int {
                return rd<int>(off(context, TC_AT));
            }

            typePending(context >> p<byte>) -> int {
                return rd<int>(off(context, TC_PENDING_GT));
            }

            materialTypeKind(state >> p<byte>, context >> p<byte>) -> int {
                if (typePending(context) > 0) return T_GREATER;
                if (typeAt(context) >= rd<int>(off(context, TC_END))) return T_EOF;
                return kind(state, typeAt(context));
            }

            typeToken(context >> p<byte>) -> int {
                return typePending(context) > 0 ? typeAt(context) - 1 : typeAt(context);
            }

            typeAdvance(context >> p<byte>) -> bool {
                guard typePending(context) == 0 else return false;
                wr<int>(off(context, TC_AT), typeAt(context) + 1);
                return true;
            }

            typeGreater(state >> p<byte>, context >> p<byte>) -> bool {
                pending >> int <- typePending(context);
                if (pending > 0) {
                    wr<int>(off(context, TC_PENDING_GT), pending - 1);
                    return true;
                }
                token >> int <- materialTypeKind(state, context);
                if (token == T_GREATER) return typeAdvance(context);
                if (token == T_SHIFT2 || token == T_SHIFT3) {
                    typeAdvance(context);
                    wr<int>(off(context, TC_PENDING_GT), token == T_SHIFT2 ? 1 : 2);
                    return true;
                }
                return false;
            }

            typeNameToken(token >> int) -> bool {
                return token == T_IDENTIFIER || token == T_KEYWORD_STR ||
                    token == T_KEYWORD_REF;
            }

            expressionNameToken(token >> int) -> bool {
                return token == T_IDENTIFIER ||
                    (token >= 55 && token <= 60) ||
                    (token >= 78 && token <= 100);
            }

            detached(
                ast >> p<byte>,
                nodeKind >> int,
                state >> p<byte>,
                tokenAt >> int
            ) -> int {
                nameHash >> int <- (nodeKind == AST_EXPR_NAME || nodeKind == AST_TYPE_NAME) &&
                    lexer.nccLexer.identifierKind(kind(state, tokenAt)) ?
                    lexer.nccLexer.identifierHashAt(state, tokenAt) :
                    lexer.nccLexer.tokenHashAt(state, tokenAt);
                index >> int <- appendNode(ast, nodeKind, -1,
                    lexer.nccLexer.tokenLineAt(state, tokenAt),
                    lexer.nccLexer.tokenColumnAt(state, tokenAt),
                    nameHash,
                    kind(state, tokenAt), tokenAt);
                closeNode(ast, index, tokenAt);
                return index;
            }

            advancedResult(
                ast >> p<byte>, state >> p<byte>, tokenAt >> int, result >> int
            ) -> int {
                if (result < 0 && field(ast, A_ERROR) == 0) {
                    setError(ast, 7, lexer.nccLexer.tokenLineAt(state, tokenAt),
                        lexer.nccLexer.tokenColumnAt(state, tokenAt));
                }
                return result;
            }

            parseTypeRef(
                ast >> p<byte>, state >> p<byte>, context >> p<byte>
            ) -> int {
                left >> int <- parseTypeSingle(ast, state, context);
                guard left >= 0 else return -1;
                if (materialTypeKind(state, context) != T_PIPE) return left;
                root >> int <- detached(ast, AST_TYPE_UNION, state,
                    field(node(ast, left), N_FIRST_TOKEN));
                adopt(ast, root, left);
                while (materialTypeKind(state, context) == T_PIPE) {
                    typeAdvance(context);
                    item >> int <- parseTypeSingle(ast, state, context);
                    guard item >= 0 else return -1;
                    adopt(ast, root, item);
                }
                closeNode(ast, root, typeAt(context) - 1);
                return root;
            }

            parseTypeSingle(
                ast >> p<byte>, state >> p<byte>, context >> p<byte>
            ) -> int {
                start >> int <- typeToken(context);
                token >> int <- materialTypeKind(state, context);
                if (token == T_NUMBER) {
                    root >> int <- detached(ast, AST_TYPE_CONST, state, start);
                    typeAdvance(context);
                    return root;
                }

                if (token == T_KEYWORD_FN && kind(state, typeAt(context) + 1) == T_LPAREN) {
                    root >> int <- detached(ast, AST_TYPE_FUNCTION, state, start);
                    typeAdvance(context);
                    typeAdvance(context);
                    if (materialTypeKind(state, context) != T_RPAREN) {
                        more >> bool <- true;
                        while (more) {
                            argument >> int <- parseTypeRef(ast, state, context);
                            guard argument >= 0 else return -1;
                            adopt(ast, root, argument);
                            more <- materialTypeKind(state, context) == T_COMMA;
                            if (more) typeAdvance(context);
                        }
                    }
                    guard materialTypeKind(state, context) == T_RPAREN else {
                        setError(ast, 4, lexer.nccLexer.tokenLineAt(state, typeToken(context)),
                            lexer.nccLexer.tokenColumnAt(state, typeToken(context)));
                        return -1;
                    }
                    typeAdvance(context);
                    guard materialTypeKind(state, context) == T_ARROW else {
                        setError(ast, 4, lexer.nccLexer.tokenLineAt(state, typeToken(context)),
                            lexer.nccLexer.tokenColumnAt(state, typeToken(context)));
                        return -1;
                    }
                    typeAdvance(context);
                    result >> int <- parseTypeRef(ast, state, context);
                    guard result >= 0 else return -1;
                    put(node(ast, result), N_ROLE_HASH, 1);
                    adopt(ast, root, result);
                    closeNode(ast, root, field(node(ast, result), N_END_TOKEN));
                    return root;
                }

                guard typeNameToken(token) else {
                    setError(ast, 4, lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start));
                    return -1;
                }
                base >> int <- start;
                typeAdvance(context);
                while (materialTypeKind(state, context) == T_DOT &&
                    lexer.nccLexer.pathSegmentKind(kind(state, typeAt(context) + 1))) {
                    typeAdvance(context);
                    typeAdvance(context);
                }

                root >> int <- -1;
                if (materialTypeKind(state, context) == T_LESS) {
                    pointerBase >> bool <- lexer.nccLexer.tokenSame(state, base, "p") ||
                        lexer.nccLexer.tokenSame(state, base, "ptr");
                    arrayBase >> bool <- lexer.nccLexer.tokenSame(state, base, "array");
                    root <- detached(ast, pointerBase ? AST_TYPE_POINTER :
                        (arrayBase ? AST_TYPE_ARRAY : AST_TYPE_APPLY), state, base);
                    typeAdvance(context);
                    more >> bool <- true;
                    while (more) {
                        argument >> int <- parseTypeRef(ast, state, context);
                        guard argument >= 0 else return -1;
                        adopt(ast, root, argument);
                        more <- materialTypeKind(state, context) == T_COMMA;
                        if (more) typeAdvance(context);
                    }
                    guard typeGreater(state, context) else {
                        setError(ast, 4, lexer.nccLexer.tokenLineAt(state, typeToken(context)),
                            lexer.nccLexer.tokenColumnAt(state, typeToken(context)));
                        return -1;
                    }
                    closeNode(ast, root, typeAt(context) - 1);
                } else {
                    root <- detached(ast, AST_TYPE_NAME, state, base);
                    closeNode(ast, root, typeAt(context) - 1);
                }

                while (materialTypeKind(state, context) == T_STAR ||
                    materialTypeKind(state, context) == T_LBRACKET) {
                    if (materialTypeKind(state, context) == T_STAR) {
                        marker >> int <- detached(ast, AST_TYPE_POINTER, state, field(node(ast, root), N_FIRST_TOKEN));
                        put(node(ast, marker), 56, typeToken(context));
                        typeAdvance(context);
                        adopt(ast, marker, root);
                        closeNode(ast, marker, typeAt(context) - 1);
                        root <- marker;
                    } else {
                        marker >> int <- detached(ast, AST_TYPE_ARRAY, state, field(node(ast, root), N_FIRST_TOKEN));
                        put(node(ast, marker), 56, typeToken(context));
                        typeAdvance(context);
                        adopt(ast, marker, root);
                        if (materialTypeKind(state, context) != T_RBRACKET) {
                            length >> int <- parseTypeSingle(ast, state, context);
                            guard length >= 0 else return -1;
                            adopt(ast, marker, length);
                        }
                        guard materialTypeKind(state, context) == T_RBRACKET else {
                            setError(ast, 4, lexer.nccLexer.tokenLineAt(state, typeToken(context)),
                                lexer.nccLexer.tokenColumnAt(state, typeToken(context)));
                            return -1;
                        }
                        typeAdvance(context);
                        closeNode(ast, marker, typeAt(context) - 1);
                        root <- marker;
                    }
                }
                return root;
            }

            attachType(
                ast >> p<byte>, state >> p<byte>, parent >> int, start >> int
            ) -> bool {
                context >> p<byte> <- typeContext(start, lexer.nccLexer.tokenCount(state));
                guard context != null else return false;
                root >> int <- parseTypeRef(ast, state, context);
                valid >> bool <- root >= 0 && field(ast, A_ERROR) == 0;
                if (valid) {
                    put(node(ast, parent), N_TYPE_HASH,
                        lexer.nccLexer.tokenHashAt(state, start));
                    adopt(ast, parent, root);
                }
                free(context);
                return valid;
            }

            attachTypeRange(
                ast >> p<byte>, state >> p<byte>, parent >> int,
                start >> int, end >> int
            ) -> bool {
                context >> p<byte> <- typeContext(start, end);
                guard context != null else return false;
                root >> int <- parseTypeRef(ast, state, context);
                valid >> bool <- root >= 0 && typeAt(context) == end &&
                    typePending(context) == 0 && field(ast, A_ERROR) == 0;
                if (valid) {
                    put(node(ast, parent), N_TYPE_HASH,
                        lexer.nccLexer.tokenHashAt(state, start));
                    adopt(ast, parent, root);
                } else if (field(ast, A_ERROR) == 0) {
                    setError(ast, 4, lexer.nccLexer.tokenLineAt(state, typeToken(context)),
                        lexer.nccLexer.tokenColumnAt(state, typeToken(context)));
                }
                free(context);
                return valid;
            }

            exprContext(start >> int, end >> int) -> p<byte> {
                context >> p<byte> <- cast<byte>(alloc(EXPR_CONTEXT_BYTES));
                guard context != null else return null;
                wr<int>(off(context, EC_AT), start);
                wr<int>(off(context, EC_END), end);
                return context;
            }

            exprAt(context >> p<byte>) -> int {
                return rd<int>(off(context, EC_AT));
            }

            exprKind(state >> p<byte>, context >> p<byte>) -> int {
                if (exprAt(context) >= rd<int>(off(context, EC_END))) return T_EOF;
                return kind(state, exprAt(context));
            }

            exprAdvance(context >> p<byte>) -> bool {
                wr<int>(off(context, EC_AT), exprAt(context) + 1);
                return true;
            }

            questionHasColon(state >> p<byte>, context >> p<byte>) -> bool {
                at >> int <- exprAt(context) + 1;
                end >> int <- rd<int>(off(context, EC_END));
                round >> int <- 0;
                square >> int <- 0;
                braces >> int <- 0;
                while (at < end) {
                    token >> int <- kind(state, at);
                    if (token == T_COLON && round == 0 && square == 0 && braces == 0) {
                        return true;
                    }
                    if (token == T_LPAREN) round += 1;
                    else if (token == T_RPAREN) round -= 1;
                    else if (token == T_LBRACKET) square += 1;
                    else if (token == T_RBRACKET) square -= 1;
                    else if (token == T_LBRACE) braces += 1;
                    else if (token == T_RBRACE) braces -= 1;
                    at += 1;
                }
                return false;
            }

            parseClosure(
                ast >> p<byte>, state >> p<byte>, context >> p<byte>,
                start >> int, asyncClosure >> bool, moved >> bool
            ) -> int {
                closure >> int <- detached(ast, AST_EXPR_CLOSURE, state, start);
                put(node(ast, closure), N_FLAGS,
                    (asyncClosure ? 1 : 0) + (moved ? 2 : 0));

                if (exprKind(state, context) == T_OR_OR) {
                    exprAdvance(context);
                } else {
                    guard exprKind(state, context) == T_PIPE else return -1;
                    exprAdvance(context);
                    while (exprKind(state, context) != T_PIPE) {
                        parameterAt >> int <- exprAt(context);
                        guard expressionNameToken(exprKind(state, context)) else return -1;
                        exprAdvance(context);
                        guard exprKind(state, context) == T_COLON ||
                            exprKind(state, context) == T_SHIFT2 else return -1;
                        exprAdvance(context);
                        typeStart >> int <- exprAt(context);
                        comma >> int <- topLevelKind(state, typeStart,
                            rd<int>(off(context, EC_END)), T_COMMA);
                        pipe >> int <- topLevelKind(state, typeStart,
                            rd<int>(off(context, EC_END)), T_PIPE);
                        typeEnd >> int <- comma >= 0 && comma < pipe ? comma : pipe;
                        guard typeEnd > typeStart else return -1;
                        parameter >> int <- appendNode(ast, AST_CLOSURE_PARAMETER, closure,
                            lexer.nccLexer.tokenLineAt(state, parameterAt),
                            lexer.nccLexer.tokenColumnAt(state, parameterAt),
                            lexer.nccLexer.tokenHashAt(state, parameterAt), 0, parameterAt);
                        guard attachTypeRange(ast, state, parameter, typeStart, typeEnd) else return -1;
                        closeNode(ast, parameter, typeEnd - 1);
                        wr<int>(off(context, EC_AT), typeEnd);
                        if (exprKind(state, context) == T_COMMA) exprAdvance(context);
                        else guard exprKind(state, context) == T_PIPE else return -1;
                    }
                    exprAdvance(context);
                }

                guard exprKind(state, context) == T_ARROW else return -1;
                exprAdvance(context);
                returnStart >> int <- exprAt(context);
                end >> int <- rd<int>(off(context, EC_END));
                bodyOpen >> int <- topLevelKind(state, returnStart, end, T_LBRACE);
                captureAt >> int <- topLevelWord(state, returnStart, bodyOpen, "captures");
                effectsAt >> int <- topLevelWord(state, returnStart, bodyOpen, "effects");
                returnEnd >> int <- bodyOpen;
                if (captureAt >= 0 && captureAt < returnEnd) returnEnd <- captureAt;
                if (effectsAt >= 0 && effectsAt < returnEnd) returnEnd <- effectsAt;
                guard bodyOpen >= 0 && returnEnd > returnStart &&
                    attachTypeRange(ast, state, closure, returnStart, returnEnd) else return -1;

                if (effectsAt >= 0) {
                    effectOpen >> int <- effectsAt + 1;
                    guard kind(state, effectOpen) == T_LPAREN else return -1;
                    effectClose >> int <- matching(state, effectOpen, bodyOpen,
                        T_LPAREN, T_RPAREN);
                    guard effectClose >= 0 else return -1;
                    at >> int <- effectOpen + 1;
                    while (at < effectClose) {
                        if (expressionNameToken(kind(state, at))) {
                            effect >> int <- appendNode(ast, AST_CLOSURE_EFFECT, closure,
                                lexer.nccLexer.tokenLineAt(state, at),
                                lexer.nccLexer.tokenColumnAt(state, at),
                                lexer.nccLexer.tokenHashAt(state, at), 0, at);
                            closeNode(ast, effect, at);
                        }
                        at += 1;
                    }
                }

                if (captureAt >= 0) {
                    captureOpen >> int <- captureAt + 1;
                    guard kind(state, captureOpen) == T_LPAREN else return -1;
                    captureClose >> int <- matching(state, captureOpen, bodyOpen,
                        T_LPAREN, T_RPAREN);
                    guard captureClose >= 0 else return -1;
                    at >> int <- captureOpen + 1;
                    while (at < captureClose) {
                        mode >> int <- 0;
                        if (kind(state, at) == T_KEYWORD_MOVE) { mode <- 1; at += 1; }
                        else if (kind(state, at) == T_KEYWORD_REF) { mode <- 2; at += 1; }
                        else if (tokenWord(state, at, "mut")) { mode <- 3; at += 1; }
                        if (kind(state, at) == T_AT) at += 1;
                        guard expressionNameToken(kind(state, at)) else return -1;
                        capture >> int <- appendNode(ast, AST_CLOSURE_CAPTURE, closure,
                            lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at),
                            lexer.nccLexer.tokenHashAt(state, at), mode, at);
                        closeNode(ast, capture, at);
                        at += 1;
                        if (kind(state, at) == T_COMMA) at += 1;
                    }
                }

                body >> p<byte> <- statementContext(bodyOpen, end);
                guard body != null else return -1;
                parsed >> int <- parseBlock(ast, state, closure, body);
                next >> int <- statementAt(body);
                free(body);
                guard parsed >= 0 else return -1;
                wr<int>(off(context, EC_AT), next);
                closeNode(ast, closure, next - 1);
                return closure;
            }

            precedence(token >> int) -> int {
                if (token == T_OR_OR) return 1;
                if (token == T_AND_AND) return 2;
                if (token == T_PIPE) return 3;
                if (token == T_CARET) return 4;
                if (token == T_AMP) return 5;
                if (token == T_EQ_EQ || token == T_NOT_EQ) return 6;
                if (token == T_GREATER || token == T_LESS ||
                    token == T_GREATER_EQ || token == T_LESS_EQ) return 7;
                if (token == T_SHIFT2 || token == T_SHIFT3 ||
                    token == T_SHIFT_LEFT) return 8;
                if (token == T_PLUS || token == T_MINUS) return 9;
                if (token == T_STAR || token == T_SLASH || token == T_PERCENT) return 10;
                return 0;
            }

            prefixWord(state >> p<byte>, context >> p<byte>, value >> str) -> bool {
                guard tokenWord(state, exprAt(context), value) else return false;
                next >> int <- kind(state, exprAt(context) + 1);
                return next != T_EOF && next != T_SEMICOLON && next != T_COMMA &&
                    next != T_RPAREN && next != T_RBRACKET && next != T_RBRACE &&
                    next != T_LPAREN && next != T_LBRACKET && next != T_DOT &&
                    next != T_COLON && next != T_QUESTION && next != T_BANG &&
                    next != T_EQ && next != T_LESS_DASH && next != T_PLUS_PLUS &&
                    next != T_PLUS_EQ && next != T_MINUS_MINUS && next != T_MINUS_EQ &&
                    next != T_STAR_EQ &&
                    precedence(next) == 0;
            }

            parseExpression(
                ast >> p<byte>, state >> p<byte>, context >> p<byte>
            ) -> int {
                condition >> int <- parseBinary(ast, state, context, 1);
                guard condition >= 0 else return -1;
                if (exprKind(state, context) != T_QUESTION) return condition;
                marker >> int <- exprAt(context);
                exprAdvance(context);
                whenTrue >> int <- parseExpression(ast, state, context);
                guard whenTrue >= 0 && exprKind(state, context) == T_COLON else {
                    setError(ast, 5, lexer.nccLexer.tokenLineAt(state, marker),
                        lexer.nccLexer.tokenColumnAt(state, marker));
                    return -1;
                }
                exprAdvance(context);
                whenFalse >> int <- parseExpression(ast, state, context);
                guard whenFalse >= 0 else return -1;
                root >> int <- detached(ast, AST_EXPR_TERNARY, state, marker);
                put(node(ast, root), N_ROLE_HASH, T_QUESTION);
                adopt(ast, root, condition);
                adopt(ast, root, whenTrue);
                adopt(ast, root, whenFalse);
                closeNode(ast, root, field(node(ast, whenFalse), N_END_TOKEN));
                return root;
            }

            parseBinary(
                ast >> p<byte>, state >> p<byte>, context >> p<byte>, minimum >> int
            ) -> int {
                left >> int <- parseUnary(ast, state, context);
                guard left >= 0 else return -1;
                level >> int <- precedence(exprKind(state, context));
                while (level >= minimum) {
                    operatorAt >> int <- exprAt(context);
                    operator >> int <- exprKind(state, context);
                    exprAdvance(context);
                    right >> int <- parseBinary(ast, state, context, level + 1);
                    guard right >= 0 else return -1;
                    root >> int <- detached(ast, AST_EXPR_BINARY, state, operatorAt);
                    put(node(ast, root), N_ROLE_HASH, operator);
                    adopt(ast, root, left);
                    adopt(ast, root, right);
                    put(node(ast, root), N_FIRST_TOKEN,
                        field(node(ast, left), N_FIRST_TOKEN));
                    closeNode(ast, root, field(node(ast, right), N_END_TOKEN));
                    left <- root;
                    level <- precedence(exprKind(state, context));
                }
                return left;
            }

            parseUnary(
                ast >> p<byte>, state >> p<byte>, context >> p<byte>
            ) -> int {
                token >> int <- exprKind(state, context);
                if (tokenWord(state, exprAt(context), "async")) {
                    next >> int <- kind(state, exprAt(context) + 1);
                    after >> int <- kind(state, exprAt(context) + 2);
                    if (next == T_PIPE || next == T_OR_OR ||
                        (next == T_KEYWORD_MOVE && (after == T_PIPE || after == T_OR_OR))) {
                        start >> int <- exprAt(context);
                        exprAdvance(context);
                        moved >> bool <- exprKind(state, context) == T_KEYWORD_MOVE;
                        if (moved) exprAdvance(context);
                        return advancedResult(ast, state, start,
                            parseClosure(ast, state, context, start, true, moved));
                    }
                }
                if (token == T_KEYWORD_MOVE &&
                    (kind(state, exprAt(context) + 1) == T_PIPE ||
                    kind(state, exprAt(context) + 1) == T_OR_OR)) {
                    start >> int <- exprAt(context);
                    exprAdvance(context);
                    return advancedResult(ast, state, start,
                        parseClosure(ast, state, context, start, false, true));
                }
                if (prefixWord(state, context, "await") ||
                    prefixWord(state, context, "spawn") ||
                    prefixWord(state, context, "join") ||
                    prefixWord(state, context, "copy") ||
                    prefixWord(state, context, "clone") ||
                    prefixWord(state, context, "try") ||
                    (token == T_KEYWORD_MOVE && kind(state, exprAt(context) + 1) != T_LPAREN)) {
                    marker >> int <- exprAt(context);
                    exprAdvance(context);
                    value >> int <- parseUnary(ast, state, context);
                    guard value >= 0 else return -1;
                    prefixKind >> int <- tokenWord(state, marker, "try") ?
                        AST_EXPR_TRY : AST_EXPR_PREFIX;
                    root >> int <- detached(ast, prefixKind, state, marker);
                    put(node(ast, root), N_ROLE_HASH,
                        lexer.nccLexer.tokenHashAt(state, marker));
                    adopt(ast, root, value);
                    closeNode(ast, root, field(node(ast, value), N_END_TOKEN));
                    return root;
                }
                if (token == T_KEYWORD_IF) {
                    marker >> int <- exprAt(context);
                    exprAdvance(context);
                    guard exprKind(state, context) == T_LPAREN else return -1;
                    exprAdvance(context);
                    condition >> int <- parseExpression(ast, state, context);
                    guard condition >= 0 && exprKind(state, context) == T_RPAREN else return -1;
                    exprAdvance(context);
                    guard exprKind(state, context) == T_LBRACE else return -1;
                    exprAdvance(context);
                    whenTrue >> int <- parseExpression(ast, state, context);
                    guard whenTrue >= 0 && exprKind(state, context) == T_RBRACE else return -1;
                    exprAdvance(context);
                    guard exprKind(state, context) == T_KEYWORD_ELSE else return -1;
                    exprAdvance(context);
                    guard exprKind(state, context) == T_LBRACE else return -1;
                    exprAdvance(context);
                    whenFalse >> int <- parseExpression(ast, state, context);
                    guard whenFalse >= 0 && exprKind(state, context) == T_RBRACE else return -1;
                    exprAdvance(context);
                    root >> int <- detached(ast, AST_EXPR_IF, state, marker);
                    adopt(ast, root, condition);
                    adopt(ast, root, whenTrue);
                    adopt(ast, root, whenFalse);
                    closeNode(ast, root, exprAt(context) - 1);
                    return root;
                }
                if (token == T_BANG || token == T_TILDE || token == T_MINUS ||
                    token == T_PLUS || token == T_AMP || token == T_STAR) {
                    operatorAt >> int <- exprAt(context);
                    exprAdvance(context);
                    value >> int <- parseUnary(ast, state, context);
                    guard value >= 0 else return -1;
                    root >> int <- detached(ast, AST_EXPR_UNARY, state, operatorAt);
                    put(node(ast, root), N_ROLE_HASH, token);
                    adopt(ast, root, value);
                    closeNode(ast, root, field(node(ast, value), N_END_TOKEN));
                    return root;
                }
                return parsePrimary(ast, state, context);
            }

            qualifiedConstructorEnd(state >> p<byte>, start >> int, end >> int) -> int {
                at >> int <- start;
                if (!expressionNameToken(kind(state,at))) return -1;
                at += 1;
                while (at+1 < end && kind(state,at) == T_DOT &&
                    expressionNameToken(kind(state,at+1))) at += 2;
                if (at == start+1 || at >= end) return -1;
                if (kind(state,at) == T_LBRACE) return at;
                if (kind(state,at) == T_LPAREN && at+2 < end &&
                    expressionNameToken(kind(state,at+1)) && kind(state,at+2) == T_COLON) return at;
                return -1;
            }

            parsePrimary(
                ast >> p<byte>, state >> p<byte>, context >> p<byte>
            ) -> int {
                start >> int <- exprAt(context);
                token >> int <- exprKind(state, context);
                root >> int <- -1;
                if (token == T_PIPE || token == T_OR_OR) {
                    return advancedResult(ast, state, start,
                        parseClosure(ast, state, context, start, false, false));
                } else if (token == T_NUMBER || token == T_STRING || token == T_CHAR ||
                    token == T_KEYWORD_TRUE || token == T_KEYWORD_FALSE) {
                    root <- detached(ast, AST_EXPR_LITERAL, state, start);
                    exprAdvance(context);
                } else if (expressionNameToken(token)) {
                    typeEnd >> int <- qualifiedConstructorEnd(state,start,rd<int>(off(context,EC_END)));
                    if (typeEnd >= 0) {
                        typeState >> p<byte> <- typeContext(start,typeEnd);
                        guard typeState != null else return -1;
                        root <- parseTypeRef(ast,state,typeState);
                        valid >> bool <- root >= 0 && typeAt(typeState) == typeEnd;
                        free(typeState);
                        guard valid else return -1;
                        wr<int>(off(context,EC_AT),typeEnd);
                    } else {
                        root <- detached(ast, AST_EXPR_NAME, state, start);
                        exprAdvance(context);
                    }
                } else if (token == T_LPAREN) {
                    exprAdvance(context);
                    root <- parseExpression(ast, state, context);
                    guard root >= 0 && exprKind(state, context) == T_RPAREN else {
                        setError(ast, 5, lexer.nccLexer.tokenLineAt(state, start),
                            lexer.nccLexer.tokenColumnAt(state, start));
                        return -1;
                    }
                    exprAdvance(context);
                    put(node(ast, root), N_FIRST_TOKEN, start);
                    closeNode(ast, root, exprAt(context) - 1);
                } else if (token == T_LBRACKET) {
                    root <- detached(ast, AST_EXPR_ARRAY, state, start);
                    exprAdvance(context);
                    if (exprKind(state, context) != T_RBRACKET) {
                        more >> bool <- true;
                        while (more) {
                            item >> int <- parseExpression(ast, state, context);
                            guard item >= 0 else return -1;
                            adopt(ast, root, item);
                            more <- exprKind(state, context) == T_COMMA;
                            if (more) exprAdvance(context);
                        }
                    }
                    guard exprKind(state, context) == T_RBRACKET else {
                        setError(ast, 5, lexer.nccLexer.tokenLineAt(state, start),
                            lexer.nccLexer.tokenColumnAt(state, start));
                        return -1;
                    }
                    exprAdvance(context);
                    closeNode(ast, root, exprAt(context) - 1);
                } else {
                    setError(ast, 5, lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start));
                    return -1;
                }

                postfix >> bool <- true;
                while (postfix) {
                    token <- exprKind(state, context);
                    if (token == T_LESS &&
                        (field(node(ast, root), N_KIND) == AST_EXPR_NAME ||
                            field(node(ast, root), N_KIND) == AST_EXPR_MEMBER)) {
                        marker >> int <- exprAt(context);
                        close >> int <- genericCallClose(state, marker,
                            rd<int>(off(context, EC_END)));
                        if (close >= 0 && kind(state, close + 1) == T_LPAREN) {
                            application >> int <- detached(ast, AST_GENERIC_APPLY, state, marker);
                            adopt(ast, application, root);
                            arguments >> p<byte> <- typeContext(marker + 1, close + 1);
                            guard arguments != null else return -1;
                            more >> bool <- true;
                            while (more) {
                                argument >> int <- parseTypeRef(ast, state, arguments);
                                if (argument < 0) { free(arguments); return -1; }
                                adopt(ast, application, argument);
                                more <- materialTypeKind(state, arguments) == T_COMMA;
                                if (more) typeAdvance(arguments);
                            }
                            validArguments >> bool <- typeGreater(state, arguments) &&
                                typePending(arguments) == 0 && typeAt(arguments) == close + 1;
                            free(arguments);
                            guard validArguments else return -1;
                            put(node(ast, application), N_FIRST_TOKEN,
                                field(node(ast, root), N_FIRST_TOKEN));
                            closeNode(ast, application, close);
                            wr<int>(off(context, EC_AT), close + 1);
                            root <- application;
                        } else {
                            postfix <- false;
                        }
                    } else if (token == T_LPAREN) {
                        marker >> int <- exprAt(context);
                        namedFields >> bool <- (field(node(ast, root), N_KIND) == AST_EXPR_NAME ||
                            field(node(ast, root), N_KIND) == AST_TYPE_NAME) &&
                            expressionNameToken(kind(state, marker + 1)) &&
                            kind(state, marker + 2) == T_COLON;
                        if (namedFields) {
                            literal >> int <- detached(ast, AST_EXPR_STRUCT, state, marker);
                            adopt(ast, literal, root);
                            exprAdvance(context);
                            while (exprKind(state, context) != T_RPAREN) {
                                fieldAt >> int <- exprAt(context);
                                guard expressionNameToken(exprKind(state, context)) else return -1;
                                exprAdvance(context);
                                guard exprKind(state, context) == T_COLON else return -1;
                                exprAdvance(context);
                                fieldValue >> int <- parseExpression(ast, state, context);
                                guard fieldValue >= 0 else return -1;
                                member >> int <- appendNode(ast, AST_EXPR_FIELD, literal,
                                    lexer.nccLexer.tokenLineAt(state, fieldAt),
                                    lexer.nccLexer.tokenColumnAt(state, fieldAt),
                                    lexer.nccLexer.identifierHashAt(state, fieldAt), 0, fieldAt);
                                adopt(ast, member, fieldValue);
                                closeNode(ast, member,
                                    field(node(ast, fieldValue), N_END_TOKEN));
                                if (exprKind(state, context) == T_COMMA) exprAdvance(context);
                                else guard exprKind(state, context) == T_RPAREN else return -1;
                            }
                            exprAdvance(context);
                            put(node(ast, literal), N_FIRST_TOKEN,
                                field(node(ast, root), N_FIRST_TOKEN));
                            closeNode(ast, literal, exprAt(context) - 1);
                            root <- literal;
                        } else {
                        call >> int <- detached(ast, AST_EXPR_CALL, state, marker);
                        adopt(ast, call, root);
                        exprAdvance(context);
                        if (exprKind(state, context) != T_RPAREN) {
                            more >> bool <- true;
                            while (more) {
                                argument >> int <- parseExpression(ast, state, context);
                                guard argument >= 0 else return -1;
                                adopt(ast, call, argument);
                                more <- exprKind(state, context) == T_COMMA;
                                if (more) exprAdvance(context);
                            }
                        }
                        guard exprKind(state, context) == T_RPAREN else {
                            setError(ast, 5, lexer.nccLexer.tokenLineAt(state, marker),
                                lexer.nccLexer.tokenColumnAt(state, marker));
                            return -1;
                        }
                        exprAdvance(context);
                        put(node(ast, call), N_FIRST_TOKEN, field(node(ast, root), N_FIRST_TOKEN));
                        closeNode(ast, call, exprAt(context) - 1);
                        root <- call;
                        }
                    } else if (token == T_DOT) {
                        marker >> int <- exprAt(context);
                        exprAdvance(context);
                        guard expressionNameToken(exprKind(state, context)) else {
                            setError(ast, 5, lexer.nccLexer.tokenLineAt(state, marker),
                                lexer.nccLexer.tokenColumnAt(state, marker));
                            return -1;
                        }
                        member >> int <- detached(ast, AST_EXPR_MEMBER, state, marker);
                        adopt(ast, member, root);
                        name >> int <- detached(ast, AST_EXPR_NAME, state, exprAt(context));
                        adopt(ast, member, name);
                        exprAdvance(context);
                        put(node(ast, member), N_FIRST_TOKEN, field(node(ast, root), N_FIRST_TOKEN));
                        closeNode(ast, member, exprAt(context) - 1);
                        root <- member;
                    } else if (token == T_LBRACKET) {
                        marker >> int <- exprAt(context);
                        exprAdvance(context);
                        index >> int <- parseExpression(ast, state, context);
                        guard index >= 0 && exprKind(state, context) == T_RBRACKET else {
                            setError(ast, 5, lexer.nccLexer.tokenLineAt(state, marker),
                                lexer.nccLexer.tokenColumnAt(state, marker));
                            return -1;
                        }
                        exprAdvance(context);
                        access >> int <- detached(ast, AST_EXPR_INDEX, state, marker);
                        adopt(ast, access, root);
                        adopt(ast, access, index);
                        put(node(ast, access), N_FIRST_TOKEN, field(node(ast, root), N_FIRST_TOKEN));
                        closeNode(ast, access, exprAt(context) - 1);
                        root <- access;
                    } else if (token == T_LBRACE &&
                        (field(node(ast, root), N_KIND) == AST_EXPR_NAME ||
                            field(node(ast, root), N_KIND) == AST_TYPE_NAME)) {
                        marker >> int <- exprAt(context);
                        literal >> int <- detached(ast, AST_EXPR_STRUCT, state, marker);
                        adopt(ast, literal, root);
                        exprAdvance(context);
                        while (exprKind(state, context) != T_RBRACE) {
                            fieldAt >> int <- exprAt(context);
                            guard expressionNameToken(exprKind(state, context)) else return -1;
                            exprAdvance(context);
                            guard exprKind(state, context) == T_COLON else return -1;
                            exprAdvance(context);
                            fieldValue >> int <- parseExpression(ast, state, context);
                            guard fieldValue >= 0 else return -1;
                            member >> int <- appendNode(ast, AST_EXPR_FIELD, literal,
                                lexer.nccLexer.tokenLineAt(state, fieldAt),
                                lexer.nccLexer.tokenColumnAt(state, fieldAt),
                                lexer.nccLexer.identifierHashAt(state, fieldAt), 0, fieldAt);
                            adopt(ast, member, fieldValue);
                            closeNode(ast, member,
                                field(node(ast, fieldValue), N_END_TOKEN));
                            if (exprKind(state, context) == T_COMMA) exprAdvance(context);
                            else guard exprKind(state, context) == T_RBRACE else return -1;
                        }
                        exprAdvance(context);
                        put(node(ast, literal), N_FIRST_TOKEN,
                            field(node(ast, root), N_FIRST_TOKEN));
                        closeNode(ast, literal, exprAt(context) - 1);
                        root <- literal;
                    } else if (token == T_QUESTION && !questionHasColon(state, context)) {
                        marker >> int <- exprAt(context);
                        exprAdvance(context);
                        propagated >> int <- detached(ast, AST_EXPR_TRY, state, marker);
                        adopt(ast, propagated, root);
                        put(node(ast, propagated), N_FIRST_TOKEN,
                            field(node(ast, root), N_FIRST_TOKEN));
                        closeNode(ast, propagated, marker);
                        root <- propagated;
                    } else if (token == T_BANG) {
                        marker >> int <- exprAt(context);
                        exprAdvance(context);
                        forced >> int <- detached(ast, AST_EXPR_PREFIX, state, marker);
                        put(node(ast, forced), N_ROLE_HASH, T_BANG);
                        adopt(ast, forced, root);
                        put(node(ast, forced), N_FIRST_TOKEN,
                            field(node(ast, root), N_FIRST_TOKEN));
                        closeNode(ast, forced, marker);
                        root <- forced;
                    } else {
                        postfix <- false;
                    }
                }
                return root;
            }

            expressionEnd(state >> p<byte>, start >> int) -> int {
                at >> int <- start;
                round >> int <- 0;
                square >> int <- 0;
                braces >> int <- 0;
                while (at < lexer.nccLexer.tokenCount(state)) {
                    token >> int <- kind(state, at);
                    if (token == T_SEMICOLON && round == 0 && square == 0 && braces == 0) {
                        return at;
                    }
                    if (token == T_LPAREN) round += 1;
                    else if (token == T_RPAREN) round -= 1;
                    else if (token == T_LBRACKET) square += 1;
                    else if (token == T_RBRACKET) square -= 1;
                    else if (token == T_LBRACE) braces += 1;
                    else if (token == T_RBRACE) {
                        if (braces == 0) return at;
                        braces -= 1;
                    }
                    at += 1;
                }
                return at;
            }

            attachExpression(
                ast >> p<byte>, state >> p<byte>, parent >> int, start >> int
            ) -> bool {
                end >> int <- expressionEnd(state, start);
                return attachExpressionRange(ast, state, parent, start, end);
            }

            attachExpressionRange(
                ast >> p<byte>, state >> p<byte>, parent >> int,
                start >> int, end >> int
            ) -> bool {
                context >> p<byte> <- exprContext(start, end);
                guard context != null else return false;
                root >> int <- parseExpression(ast, state, context);
                valid >> bool <- root >= 0 && exprAt(context) == end && field(ast, A_ERROR) == 0;
                if (valid) adopt(ast, parent, root);
                else if (field(ast, A_ERROR) == 0) {
                    setError(ast, 5, lexer.nccLexer.tokenLineAt(state, exprAt(context)),
                        lexer.nccLexer.tokenColumnAt(state, exprAt(context)));
                }
                free(context);
                return valid;
            }

            statementContext(start >> int, end >> int) -> p<byte> {
                context >> p<byte> <- cast<byte>(alloc(STMT_CONTEXT_BYTES));
                guard context != null else return null;
                wr<int>(off(context, SC_AT), start);
                wr<int>(off(context, SC_END), end);
                return context;
            }

            statementAt(context >> p<byte>) -> int {
                return rd<int>(off(context, SC_AT));
            }

            statementLimit(context >> p<byte>) -> int {
                return rd<int>(off(context, SC_END));
            }

            statementMove(context >> p<byte>, at >> int) -> bool {
                wr<int>(off(context, SC_AT), at);
                return true;
            }

            tokenWord(state >> p<byte>, at >> int, value >> str) -> bool {
                return kind(state, at) == T_IDENTIFIER &&
                    lexer.nccLexer.tokenSame(state, at, value);
            }

            matching(
                state >> p<byte>, start >> int, end >> int,
                open >> int, close >> int
            ) -> int {
                depth >> int <- 0;
                at >> int <- start;
                while (at < end) {
                    token >> int <- kind(state, at);
                    if (token == open) depth += 1;
                    else if (token == close) {
                        depth -= 1;
                        if (depth == 0) return at;
                    }
                    at += 1;
                }
                return -1;
            }

            matchingGeneric(state >> p<byte>, start >> int, end >> int) -> int {
                depth >> int <- 0;
                at >> int <- start;
                while (at < end) {
                    token >> int <- kind(state, at);
                    if (token == T_LESS) depth += 1;
                    else if (token == T_GREATER) depth -= 1;
                    else if (token == T_SHIFT2) depth -= 2;
                    else if (token == T_SHIFT3) depth -= 3;
                    if (depth <= 0 && at > start) return at;
                    at += 1;
                }
                return -1;
            }

            genericCallClose(state >> p<byte>, start >> int, end >> int) -> int {
                close >> int <- matchingGeneric(state, start, end);
                guard close > start + 1 && kind(state, close + 1) == T_LPAREN else return -1;
                // Speculation uses the type grammar without mutating the expression arena.
                scratch >> p<byte> <- makeAst(close - start);
                context >> p<byte> <- typeContext(start + 1, close + 1);
                guard scratch != null && context != null else {
                    ast_arena.nccAstArena.close(scratch); free(context); return -1;
                }
                valid >> bool <- true;
                more >> bool <- true;
                while (more && valid) {
                    valid <- parseTypeRef(scratch, state, context) >= 0 && field(scratch, A_ERROR) == 0;
                    more <- valid && materialTypeKind(state, context) == T_COMMA;
                    if (more) typeAdvance(context);
                }
                valid <- valid && typeGreater(state, context) && typePending(context) == 0 &&
                    typeAt(context) == close + 1;
                free(context);
                ast_arena.nccAstArena.close(scratch);
                return valid ? close : -1;
            }

            topLevelKind(
                state >> p<byte>, start >> int, end >> int, wanted >> int
            ) -> int {
                round >> int <- 0;
                square >> int <- 0;
                braces >> int <- 0;
                at >> int <- start;
                while (at < end) {
                    token >> int <- kind(state, at);
                    if (token == wanted && round == 0 && square == 0 && braces == 0) return at;
                    if (token == T_LPAREN) round += 1;
                    else if (token == T_RPAREN) round -= 1;
                    else if (token == T_LBRACKET) square += 1;
                    else if (token == T_RBRACKET) square -= 1;
                    else if (token == T_LBRACE) braces += 1;
                    else if (token == T_RBRACE) braces -= 1;
                    at += 1;
                }
                return -1;
            }

            topLevelWord(
                state >> p<byte>, start >> int, end >> int, wanted >> str
            ) -> int {
                round >> int <- 0;
                square >> int <- 0;
                braces >> int <- 0;
                at >> int <- start;
                while (at < end) {
                    token >> int <- kind(state, at);
                    if (round == 0 && square == 0 && braces == 0 &&
                        tokenWord(state, at, wanted)) return at;
                    if (token == T_LPAREN) round += 1;
                    else if (token == T_RPAREN) round -= 1;
                    else if (token == T_LBRACKET) square += 1;
                    else if (token == T_RBRACKET) square -= 1;
                    else if (token == T_LBRACE) braces += 1;
                    else if (token == T_RBRACE) braces -= 1;
                    at += 1;
                }
                return -1;
            }

            topLevelRange(state >> p<byte>, start >> int, end >> int) -> int {
                round >> int <- 0;
                square >> int <- 0;
                braces >> int <- 0;
                at >> int <- start;
                while (at + 1 < end) {
                    token >> int <- kind(state, at);
                    if (token == T_DOT && kind(state, at + 1) == T_DOT &&
                        round == 0 && square == 0 && braces == 0) return at;
                    if (token == T_LPAREN) round += 1;
                    else if (token == T_RPAREN) round -= 1;
                    else if (token == T_LBRACKET) square += 1;
                    else if (token == T_RBRACKET) square -= 1;
                    else if (token == T_LBRACE) braces += 1;
                    else if (token == T_RBRACE) braces -= 1;
                    at += 1;
                }
                return -1;
            }

            topLevelFatArrow(state >> p<byte>, start >> int, end >> int) -> int {
                round >> int <- 0;
                square >> int <- 0;
                braces >> int <- 0;
                at >> int <- start;
                while (at + 1 < end) {
                    token >> int <- kind(state, at);
                    if (token == T_EQ && kind(state, at + 1) == T_GREATER &&
                        round == 0 && square == 0 && braces == 0) return at;
                    if (token == T_LPAREN) round += 1;
                    else if (token == T_RPAREN) round -= 1;
                    else if (token == T_LBRACKET) square += 1;
                    else if (token == T_RBRACKET) square -= 1;
                    else if (token == T_LBRACE) braces += 1;
                    else if (token == T_RBRACE) braces -= 1;
                    at += 1;
                }
                return -1;
            }

            assignmentKind(token >> int) -> bool {
                return token == T_LESS_DASH || token == T_EQ || token == T_PLUS_EQ ||
                    token == T_MINUS_EQ || token == T_STAR_EQ;
            }

            topLevelAssignment(state >> p<byte>, start >> int, end >> int) -> int {
                round >> int <- 0;
                square >> int <- 0;
                braces >> int <- 0;
                at >> int <- start;
                while (at < end) {
                    token >> int <- kind(state, at);
                    if (assignmentKind(token) && round == 0 && square == 0 && braces == 0) {
                        return at;
                    }
                    if (token == T_LPAREN) round += 1;
                    else if (token == T_RPAREN) round -= 1;
                    else if (token == T_LBRACKET) square += 1;
                    else if (token == T_RBRACKET) square -= 1;
                    else if (token == T_LBRACE) braces += 1;
                    else if (token == T_RBRACE) braces -= 1;
                    at += 1;
                }
                return -1;
            }

            appendStatementValue(
                ast >> p<byte>, state >> p<byte>, parent >> int,
                start >> int, end >> int
            ) -> int {
                guard start < end else return -1;
                assignment >> int <- topLevelAssignment(state, start, end);
                increment >> bool <- end - start > 1 &&
                    (kind(state, end - 1) == T_PLUS_PLUS || kind(state, end - 1) == T_MINUS_MINUS);
                if (assignment >= 0 || increment) {
                    operatorAt >> int <- increment ? end - 1 : assignment;
                    statement >> int <- appendNode(ast, AST_STMT_ASSIGN, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0,
                        kind(state, operatorAt), start);
                    leftEnd >> int <- operatorAt;
                    guard attachExpressionRange(ast, state, statement, start, leftEnd) else return -1;
                    if (!increment) {
                        guard operatorAt + 1 < end && attachExpressionRange(
                            ast, state, statement, operatorAt + 1, end) else return -1;
                    }
                    closeNode(ast, statement, end - 1);
                    return statement;
                }
                statement >> int <- appendNode(ast, AST_STMT_EXPRESSION, parent,
                    lexer.nccLexer.tokenLineAt(state, start),
                    lexer.nccLexer.tokenColumnAt(state, start), 0, 0, start);
                guard attachExpressionRange(ast, state, statement, start, end) else return -1;
                closeNode(ast, statement, end - 1);
                return statement;
            }

            parseLocalDeclaration(
                ast >> p<byte>, state >> p<byte>, parent >> int,
                start >> int, end >> int
            ) -> int {
                initializer >> int <- topLevelAssignment(state, start + 2, end);
                typeEnd >> int <- initializer >= 0 ? initializer : end;
                declaration >> int <- appendTypedNode(ast, AST_VALUE_DECL, parent,
                    state, start, start + 2, VIS_DEFAULT);
                guard attachTypeRange(ast, state, declaration, start + 2, typeEnd) else return -1;
                if (initializer >= 0) {
                    guard initializer + 1 < end && attachExpressionRange(
                        ast, state, declaration, initializer + 1, end) else return -1;
                    put(node(ast, declaration), N_FLAGS,
                        field(node(ast, declaration), N_FLAGS) + 16);
                }
                closeNode(ast, declaration, end - 1);
                return declaration;
            }

            parseBlock(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>
            ) -> int {
                open >> int <- statementAt(context);
                guard kind(state, open) == T_LBRACE else {
                    setError(ast, 6, lexer.nccLexer.tokenLineAt(state, open),
                        lexer.nccLexer.tokenColumnAt(state, open));
                    return -1;
                }
                close >> int <- matching(state, open, statementLimit(context),
                    T_LBRACE, T_RBRACE);
                guard close >= 0 else {
                    setError(ast, 6, lexer.nccLexer.tokenLineAt(state, open),
                        lexer.nccLexer.tokenColumnAt(state, open));
                    return -1;
                }
                block >> int <- appendNode(ast, AST_BLOCK, parent,
                    lexer.nccLexer.tokenLineAt(state, open),
                    lexer.nccLexer.tokenColumnAt(state, open), 0, 0, open);
                body >> p<byte> <- statementContext(open + 1, close);
                guard body != null else return -1;
                while (statementAt(body) < close && field(ast, A_ERROR) == 0) {
                    if (kind(state, statementAt(body)) == T_SEMICOLON) {
                        statementMove(body, statementAt(body) + 1);
                    } else {
                        before >> int <- statementAt(body);
                        parseStatement(ast, state, block, body);
                        if (statementAt(body) <= before && field(ast, A_ERROR) == 0) {
                            setError(ast, 6, lexer.nccLexer.tokenLineAt(state, before),
                                lexer.nccLexer.tokenColumnAt(state, before));
                        }
                    }
                }
                free(body);
                closeNode(ast, block, close);
                statementMove(context, close + 1);
                return block;
            }

            conditionAndBody(
                ast >> p<byte>, state >> p<byte>, owner >> int,
                context >> p<byte>, marker >> int
            ) -> int {
                conditionStart >> int <- marker + 1;
                bodyStart >> int <- -1;
                conditionEnd >> int <- -1;
                if (kind(state, conditionStart) == T_LPAREN) {
                    close >> int <- matching(state, conditionStart, statementLimit(context),
                        T_LPAREN, T_RPAREN);
                    guard close >= 0 else return -1;
                    conditionStart += 1;
                    conditionEnd <- close;
                    bodyStart <- close + 1;
                } else {
                    bodyStart <- topLevelKind(state, conditionStart,
                        statementLimit(context), T_LBRACE);
                    conditionEnd <- bodyStart;
                }
                guard bodyStart >= 0 && bodyStart < statementLimit(context) &&
                    conditionStart < conditionEnd &&
                    kind(state, bodyStart) != T_KEYWORD_ELSE else {
                    setError(ast, 6, lexer.nccLexer.tokenLineAt(state, marker),
                        lexer.nccLexer.tokenColumnAt(state, marker));
                    return -1;
                }
                guard attachExpressionRange(ast, state, owner,
                    conditionStart, conditionEnd) else return -1;
                statementMove(context, bodyStart);
                if (kind(state, bodyStart) == T_LBRACE) {
                    return parseBlock(ast, state, owner, context);
                }
                return parseStatement(ast, state, owner, context);
            }

            parseIf(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>
            ) -> int {
                marker >> int <- statementAt(context);
                statement >> int <- appendNode(ast, AST_STMT_IF, parent,
                    lexer.nccLexer.tokenLineAt(state, marker),
                    lexer.nccLexer.tokenColumnAt(state, marker), 0, 0, marker);
                guard conditionAndBody(ast, state, statement, context, marker) >= 0 else return -1;
                next >> int <- statementAt(context);
                if (kind(state, next) == T_KEYWORD_ELSE) {
                    statementMove(context, next + 1);
                    if (kind(state, statementAt(context)) == T_KEYWORD_IF) {
                        guard parseIf(ast, state, statement, context) >= 0 else return -1;
                    } else if (kind(state, statementAt(context)) == T_LBRACE) {
                        guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                    } else {
                        guard parseStatement(ast, state, statement, context) >= 0 else return -1;
                    }
                } else if (tokenWord(state, next, "elseIf")) {
                    guard parseIf(ast, state, statement, context) >= 0 else return -1;
                }
                closeNode(ast, statement, statementAt(context) - 1);
                return statement;
            }

            parseWhile(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>
            ) -> int {
                marker >> int <- statementAt(context);
                statement >> int <- appendNode(ast, AST_STMT_WHILE, parent,
                    lexer.nccLexer.tokenLineAt(state, marker),
                    lexer.nccLexer.tokenColumnAt(state, marker), 0, 0, marker);
                if (tokenWord(state, marker + 1, "let")) {
                    bodyOpen >> int <- topLevelKind(state, marker + 2,
                        statementLimit(context), T_LBRACE);
                    assign >> int <- topLevelKind(state, marker + 2,
                        bodyOpen, T_LESS_DASH);
                    if (assign < 0) assign <- topLevelKind(state, marker + 2,
                        bodyOpen, T_EQ);
                    guard bodyOpen >= 0 && assign > marker + 2 else return -1;
                    patternContext >> p<byte> <- exprContext(marker + 2, assign);
                    guard patternContext != null else return -1;
                    pattern >> int <- parsePattern(ast, state, patternContext);
                    valid >> bool <- pattern >= 0 && exprAt(patternContext) == assign;
                    free(patternContext);
                    guard valid else return -1;
                    adopt(ast, statement, pattern);
                    guard attachExpressionRange(ast, state, statement,
                        assign + 1, bodyOpen) else return -1;
                    put(node(ast, statement), N_FLAGS, 1);
                    statementMove(context, bodyOpen);
                    guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                    closeNode(ast, statement, statementAt(context) - 1);
                    return statement;
                }
                guard conditionAndBody(ast, state, statement, context, marker) >= 0 else return -1;
                closeNode(ast, statement, statementAt(context) - 1);
                return statement;
            }

            parseForClause(
                ast >> p<byte>, state >> p<byte>, parent >> int,
                start >> int, end >> int, role >> int
            ) -> int {
                if (start >= end) return -1;
                clause >> int <- appendStatementValue(ast, state, parent, start, end);
                if (clause >= 0) put(node(ast, clause), N_FLAGS, role);
                return clause;
            }

            parseFor(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>
            ) -> int {
                marker >> int <- statementAt(context);
                statement >> int <- appendNode(ast, AST_STMT_FOR, parent,
                    lexer.nccLexer.tokenLineAt(state, marker),
                    lexer.nccLexer.tokenColumnAt(state, marker), 0, 0, marker);
                header >> int <- marker + 1;
                bodyOpen >> int <- -1;
                if (kind(state, header) == T_LPAREN) {
                    close >> int <- matching(state, header, statementLimit(context),
                        T_LPAREN, T_RPAREN);
                    guard close >= 0 else return -1;
                    first >> int <- topLevelKind(state, header + 1, close, T_SEMICOLON);
                    second >> int <- first < 0 ? -1 :
                        topLevelKind(state, first + 1, close, T_SEMICOLON);
                    guard first >= 0 && second >= 0 else {
                        setError(ast, 6, lexer.nccLexer.tokenLineAt(state, marker),
                            lexer.nccLexer.tokenColumnAt(state, marker));
                        return -1;
                    }
                    parseForClause(ast, state, statement, header + 1, first, 1);
                    parseForClause(ast, state, statement, first + 1, second, 2);
                    parseForClause(ast, state, statement, second + 1, close, 3);
                    bodyOpen <- close + 1;
                } else {
                    bodyOpen <- topLevelKind(state, header,
                        statementLimit(context), T_LBRACE);
                    binding >> int <- topLevelWord(state, header, bodyOpen, "in");
                    guard bodyOpen >= 0 && binding > header else {
                        setError(ast, 6, lexer.nccLexer.tokenLineAt(state, marker),
                            lexer.nccLexer.tokenColumnAt(state, marker));
                        return -1;
                    }
                    name >> int <- detached(ast, AST_EXPR_NAME, state, header);
                    adopt(ast, statement, name);
                    step >> int <- topLevelWord(state, binding + 1, bodyOpen, "step");
                    iterableEnd >> int <- step >= 0 ? step : bodyOpen;
                    range >> int <- topLevelRange(state, binding + 1, iterableEnd);
                    if (range >= 0) {
                        put(node(ast, statement), N_KIND, AST_STMT_FOR_RANGE);
                        inclusive >> bool <- kind(state, range + 2) == T_EQ;
                        rightStart >> int <- range + (inclusive ? 3 : 2);
                        guard range > binding + 1 && rightStart < iterableEnd &&
                            attachExpressionRange(ast, state, statement,
                                binding + 1, range) &&
                            attachExpressionRange(ast, state, statement,
                                rightStart, iterableEnd) else return -1;
                        put(node(ast, statement), N_FLAGS, inclusive ? 1 : 0);
                        if (step >= 0) {
                            guard attachExpressionRange(ast, state, statement,
                                step + 1, bodyOpen) else return -1;
                        }
                    } else {
                        put(node(ast, statement), N_KIND, AST_STMT_FOR_IN);
                        guard attachExpressionRange(ast, state, statement,
                            binding + 1, iterableEnd) else return -1;
                    }
                }
                guard kind(state, bodyOpen) == T_LBRACE else return -1;
                statementMove(context, bodyOpen);
                guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                closeNode(ast, statement, statementAt(context) - 1);
                return statement;
            }

            parsePattern(
                ast >> p<byte>, state >> p<byte>, context >> p<byte>
            ) -> int {
                start >> int <- exprAt(context);
                token >> int <- exprKind(state, context);
                if (tokenWord(state, start, "_")) {
                    root >> int <- detached(ast, AST_PATTERN_WILDCARD, state, start);
                    exprAdvance(context);
                    return root;
                }
                if (token == T_NUMBER || token == T_STRING || token == T_CHAR ||
                    token == T_KEYWORD_TRUE || token == T_KEYWORD_FALSE) {
                    literal >> int <- detached(ast, AST_PATTERN_LITERAL, state, start);
                    value >> int <- detached(ast, AST_EXPR_LITERAL, state, start);
                    adopt(ast, literal, value);
                    exprAdvance(context);
                    if (exprKind(state, context) == T_DOT &&
                        kind(state, exprAt(context) + 1) == T_DOT) {
                        range >> int <- detached(ast, AST_PATTERN_RANGE, state, start);
                        adopt(ast, range, literal);
                        exprAdvance(context);
                        exprAdvance(context);
                        inclusive >> bool <- exprKind(state, context) == T_EQ;
                        if (inclusive) exprAdvance(context);
                        endpoint >> int <- parsePattern(ast, state, context);
                        guard endpoint >= 0 else return -1;
                        adopt(ast, range, endpoint);
                        put(node(ast, range), N_FLAGS, inclusive ? 1 : 0);
                        closeNode(ast, range,
                            field(node(ast, endpoint), N_END_TOKEN));
                        return range;
                    }
                    return literal;
                }
                if (token == T_LBRACKET) {
                    array >> int <- detached(ast, AST_PATTERN_ARRAY, state, start);
                    exprAdvance(context);
                    while (exprKind(state, context) != T_RBRACKET) {
                        if (exprKind(state, context) == T_DOT &&
                            kind(state, exprAt(context) + 1) == T_DOT) {
                            restAt >> int <- exprAt(context);
                            exprAdvance(context);
                            exprAdvance(context);
                            rest >> int <- detached(ast, AST_PATTERN_REST, state, restAt);
                            if (expressionNameToken(exprKind(state, context))) {
                                put(node(ast, rest), N_NAME_HASH,
                                    lexer.nccLexer.tokenHashAt(state, exprAt(context)));
                                exprAdvance(context);
                            }
                            adopt(ast, array, rest);
                        } else {
                            item >> int <- parsePattern(ast, state, context);
                            guard item >= 0 else return -1;
                            adopt(ast, array, item);
                        }
                        if (exprKind(state, context) == T_COMMA) exprAdvance(context);
                        else guard exprKind(state, context) == T_RBRACKET else return -1;
                    }
                    exprAdvance(context);
                    closeNode(ast, array, exprAt(context) - 1);
                    return array;
                }
                guard expressionNameToken(token) else return -1;
                first >> int <- exprAt(context);
                last >> int <- first;
                segments >> int <- 1;
                exprAdvance(context);
                while (exprKind(state, context) == T_DOT &&
                    expressionNameToken(kind(state, exprAt(context) + 1))) {
                    exprAdvance(context);
                    last <- exprAt(context);
                    segments += 1;
                    exprAdvance(context);
                }
                if (exprKind(state, context) == T_LBRACE) {
                    structPattern >> int <- detached(ast, AST_PATTERN_STRUCT, state, first);
                    put(node(ast, structPattern), N_ROLE_HASH,
                        lexer.nccLexer.tokenHashAt(state, last));
                    exprAdvance(context);
                    while (exprKind(state, context) != T_RBRACE) {
                        if (exprKind(state, context) == T_DOT &&
                            kind(state, exprAt(context) + 1) == T_DOT) {
                            restAt >> int <- exprAt(context);
                            exprAdvance(context);
                            exprAdvance(context);
                            rest >> int <- detached(ast, AST_PATTERN_REST, state, restAt);
                            adopt(ast, structPattern, rest);
                        } else {
                            fieldAt >> int <- exprAt(context);
                            guard expressionNameToken(exprKind(state, context)) else return -1;
                            exprAdvance(context);
                            field >> int <- appendNode(ast, AST_PATTERN_FIELD, structPattern,
                                lexer.nccLexer.tokenLineAt(state, fieldAt),
                                lexer.nccLexer.tokenColumnAt(state, fieldAt),
                                lexer.nccLexer.tokenHashAt(state, fieldAt), 0, fieldAt);
                            if (exprKind(state, context) == T_COLON) {
                                exprAdvance(context);
                                nested >> int <- parsePattern(ast, state, context);
                                guard nested >= 0 else return -1;
                                adopt(ast, field, nested);
                            } else {
                                binding >> int <- detached(ast, AST_PATTERN_BINDING,
                                    state, fieldAt);
                                adopt(ast, field, binding);
                            }
                            closeNode(ast, field, exprAt(context) - 1);
                        }
                        if (exprKind(state, context) == T_COMMA) exprAdvance(context);
                        else guard exprKind(state, context) == T_RBRACE else return -1;
                    }
                    exprAdvance(context);
                    closeNode(ast, structPattern, exprAt(context) - 1);
                    return structPattern;
                }
                variant >> bool <- segments > 1 || tokenWord(state, first, "Some") ||
                    tokenWord(state, first, "None") || tokenWord(state, first, "Ok") ||
                    tokenWord(state, first, "Err");
                if (exprKind(state, context) == T_LPAREN || variant) {
                    root >> int <- detached(ast, AST_PATTERN_VARIANT, state, first);
                    put(node(ast, root), N_ROLE_HASH,
                        lexer.nccLexer.tokenHashAt(state, last));
                    if (exprKind(state, context) == T_LPAREN) {
                        exprAdvance(context);
                        while (exprKind(state, context) != T_RPAREN) {
                            item >> int <- parsePattern(ast, state, context);
                            guard item >= 0 else return -1;
                            adopt(ast, root, item);
                            if (exprKind(state, context) == T_COMMA) exprAdvance(context);
                            else guard exprKind(state, context) == T_RPAREN else return -1;
                        }
                        exprAdvance(context);
                    }
                    closeNode(ast, root, exprAt(context) - 1);
                    return root;
                }
                binding >> int <- detached(ast, AST_PATTERN_BINDING, state, first);
                closeNode(ast, binding, last);
                return binding;
            }

            parseMatch(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>
            ) -> int {
                marker >> int <- statementAt(context);
                bodyOpen >> int <- topLevelKind(state, marker + 1,
                    statementLimit(context), T_LBRACE);
                guard bodyOpen > marker + 1 else return -1;
                valueStart >> int <- marker + 1;
                valueEnd >> int <- bodyOpen;
                if (kind(state, valueStart) == T_LPAREN) {
                    valueClose >> int <- matching(state, valueStart, bodyOpen,
                        T_LPAREN, T_RPAREN);
                    guard valueClose == bodyOpen - 1 else return -1;
                    valueStart += 1;
                    valueEnd <- valueClose;
                }
                statement >> int <- appendNode(ast, AST_STMT_MATCH, parent,
                    lexer.nccLexer.tokenLineAt(state, marker),
                    lexer.nccLexer.tokenColumnAt(state, marker), 0, 0, marker);
                guard attachExpressionRange(ast, state, statement,
                    valueStart, valueEnd) else return -1;
                bodyClose >> int <- matching(state, bodyOpen, statementLimit(context),
                    T_LBRACE, T_RBRACE);
                guard bodyClose >= 0 else return -1;
                at >> int <- bodyOpen + 1;
                while (at < bodyClose) {
                    arm >> int <- appendNode(ast, AST_MATCH_ARM, statement,
                        lexer.nccLexer.tokenLineAt(state, at),
                        lexer.nccLexer.tokenColumnAt(state, at), 0, 0, at);
                    armContext >> p<byte> <- exprContext(at, bodyClose);
                    guard armContext != null else return -1;
                    pattern >> int <- parsePattern(ast, state, armContext);
                    guard pattern >= 0 else { free(armContext); return -1; }
                    adopt(ast, arm, pattern);
                    at <- exprAt(armContext);
                    free(armContext);
                    arrow >> int <- topLevelFatArrow(state, at, bodyClose);
                    guard arrow >= at else return -1;
                    if (tokenWord(state, at, "if") || kind(state, at) == T_KEYWORD_IF) {
                        if (at + 1 >= arrow) return -1;
                        guard attachExpressionRange(ast, state, arm,
                            at + 1, arrow) else return -1;
                    } else guard arrow == at else return -1;
                    statementMove(context, arrow + 2);
                    if (kind(state, arrow + 2) == T_LBRACE) {
                        guard parseBlock(ast, state, arm, context) >= 0 else return -1;
                    } else {
                        guard parseStatement(ast, state, arm, context) >= 0 else return -1;
                    }
                    at <- statementAt(context);
                    if (kind(state, at) == T_COMMA) at += 1;
                    closeNode(ast, arm, at - 1);
                }
                if (at != bodyClose) return -1;
                statementMove(context, bodyClose + 1);
                closeNode(ast, statement, bodyClose);
                return statement;
            }

            parseBodyThenCondition(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>,
                statementKind >> int, tail >> str
            ) -> int {
                marker >> int <- statementAt(context);
                statement >> int <- appendNode(ast, statementKind, parent,
                    lexer.nccLexer.tokenLineAt(state, marker),
                    lexer.nccLexer.tokenColumnAt(state, marker), 0, 0, marker);
                bodyOpen >> int <- marker + 1;
                statementMove(context, bodyOpen);
                guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                tailAt >> int <- statementAt(context);
                guard tokenWord(state, tailAt, tail) ||
                    (tail == "while" && kind(state, tailAt) == T_KEYWORD_WHILE) else return -1;
                end >> int <- topLevelKind(state, tailAt + 1,
                    statementLimit(context), T_SEMICOLON);
                guard end > tailAt + 1 else return -1;
                conditionStart >> int <- tailAt + 1;
                conditionEnd >> int <- end;
                if (kind(state, conditionStart) == T_LPAREN) {
                    conditionStart += 1;
                    conditionEnd -= 1;
                }
                guard attachExpressionRange(ast, state, statement,
                    conditionStart, conditionEnd) else return -1;
                statementMove(context, end + 1);
                closeNode(ast, statement, end);
                return statement;
            }

            parseGuard(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>
            ) -> int {
                marker >> int <- statementAt(context);
                otherwise >> int <- topLevelKind(state, marker + 1,
                    statementLimit(context), T_KEYWORD_ELSE);
                guard otherwise > marker + 1 else {
                    setError(ast, 6, lexer.nccLexer.tokenLineAt(state, marker),
                        lexer.nccLexer.tokenColumnAt(state, marker));
                    return -1;
                }
                statement >> int <- appendNode(ast, AST_STMT_GUARD, parent,
                    lexer.nccLexer.tokenLineAt(state, marker),
                    lexer.nccLexer.tokenColumnAt(state, marker), 0, 0, marker);
                guard attachExpressionRange(ast, state, statement,
                    marker + 1, otherwise) else return -1;
                statementMove(context, otherwise + 1);
                guard parseStatement(ast, state, statement, context) >= 0 else return -1;
                closeNode(ast, statement, statementAt(context) - 1);
                return statement;
            }

            parseDefer(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>
            ) -> int {
                marker >> int <- statementAt(context);
                statement >> int <- appendNode(ast, AST_STMT_DEFER, parent,
                    lexer.nccLexer.tokenLineAt(state, marker),
                    lexer.nccLexer.tokenColumnAt(state, marker), 0, 0, marker);
                if (kind(state, marker + 1) == T_LBRACE) {
                    statementMove(context, marker + 1);
                    guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                } else {
                    end >> int <- topLevelKind(state, marker + 1,
                        statementLimit(context), T_SEMICOLON);
                    guard end > marker + 1 && attachExpressionRange(
                        ast, state, statement, marker + 1, end) else return -1;
                    statementMove(context, end + 1);
                }
                closeNode(ast, statement, statementAt(context) - 1);
                return statement;
            }

            parseStatement(
                ast >> p<byte>, state >> p<byte>, parent >> int, context >> p<byte>
            ) -> int {
                start >> int <- statementAt(context);
                token >> int <- kind(state, start);
                if (token == T_LBRACE) return parseBlock(ast, state, parent, context);
                if (tokenWord(state, start, "match")) {
                    return advancedResult(ast, state, start,
                        parseMatch(ast, state, parent, context));
                }
                if ((tokenWord(state, start, "async") ||
                    tokenWord(state, start, "parallel") ||
                    tokenWord(state, start, "comptime")) &&
                    tokenWord(state, start + 1, "for")) {
                    statementMove(context, start + 1);
                    statement >> int <- parseFor(ast, state, parent, context);
                    if (statement >= 0) {
                        put(node(ast, statement), N_ROLE_HASH,
                            lexer.nccLexer.tokenHashAt(state, start));
                        put(node(ast, statement), N_FIRST_TOKEN, start);
                    }
                    return statement;
                }
                if (token == T_KEYWORD_IF || tokenWord(state, start, "elseIf")) {
                    return parseIf(ast, state, parent, context);
                }
                if (token == T_KEYWORD_WHILE) return parseWhile(ast, state, parent, context);
                if (tokenWord(state, start, "for")) return parseFor(ast, state, parent, context);
                if (tokenWord(state, start, "same") && tokenWord(state, start + 1, "for")) {
                    open >> int <- start + 2;
                    guard kind(state, open) == T_LPAREN else return -1;
                    close >> int <- matching(state, open, statementLimit(context),
                        T_LPAREN, T_RPAREN);
                    guard close >= 0 && kind(state, close + 1) == T_LBRACE else return -1;
                    statement >> int <- appendNode(ast, AST_STMT_REPEAT, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0,
                        lexer.nccLexer.tokenHashAt(state, start), start);
                    guard attachExpressionRange(ast, state, statement,
                        open + 1, close) else return -1;
                    statementMove(context, close + 1);
                    guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                    closeNode(ast, statement, statementAt(context) - 1);
                    return statement;
                }
                if (tokenWord(state, start, "same") && tokenWord(state, start + 1, "in")) {
                    colon >> int <- topLevelKind(state, start + 2,
                        statementLimit(context), T_COLON);
                    bodyOpen >> int <- topLevelKind(state, start + 2,
                        statementLimit(context), T_LBRACE);
                    guard colon == start + 3 && bodyOpen > colon + 1 else return -1;
                    statement >> int <- appendNode(ast, AST_STMT_FOR_IN, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0,
                        lexer.nccLexer.tokenHashAt(state, start), start);
                    name >> int <- detached(ast, AST_EXPR_NAME, state, start + 2);
                    adopt(ast, statement, name);
                    guard attachExpressionRange(ast, state, statement,
                        colon + 1, bodyOpen) else return -1;
                    statementMove(context, bodyOpen);
                    guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                    closeNode(ast, statement, statementAt(context) - 1);
                    return statement;
                }
                if (tokenWord(state, start, "each")) {
                    binding >> int <- topLevelWord(state, start + 1,
                        statementLimit(context), "in");
                    bodyWord >> int <- topLevelWord(state, binding + 1,
                        statementLimit(context), "do");
                    guard binding == start + 2 && bodyWord > binding + 1 &&
                        kind(state, bodyWord + 1) == T_LBRACE else return -1;
                    statement >> int <- appendNode(ast, AST_STMT_FOR_IN, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0,
                        lexer.nccLexer.tokenHashAt(state, start), start);
                    name >> int <- detached(ast, AST_EXPR_NAME, state, start + 1);
                    adopt(ast, statement, name);
                    guard attachExpressionRange(ast, state, statement,
                        binding + 1, bodyWord) else return -1;
                    statementMove(context, bodyWord + 1);
                    guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                    tail >> int <- statementAt(context);
                    guard tokenWord(state, tail, "while") else return -1;
                    end >> int <- topLevelKind(state, tail + 1,
                        statementLimit(context), T_SEMICOLON);
                    guard end > tail + 1 else return -1;
                    conditionStart >> int <- tail + 1;
                    conditionEnd >> int <- end;
                    if (kind(state, conditionStart) == T_LPAREN) {
                        conditionStart += 1;
                        conditionEnd -= 1;
                    }
                    guard attachExpressionRange(ast, state, statement,
                        conditionStart, conditionEnd) else return -1;
                    statementMove(context, end + 1);
                    closeNode(ast, statement, end);
                    return statement;
                }
                if (tokenWord(state, start, "loop")) {
                    statement >> int <- appendNode(ast, AST_STMT_LOOP, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0, 0, start);
                    statementMove(context, start + 1);
                    guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                    closeNode(ast, statement, statementAt(context) - 1);
                    return statement;
                }
                if (tokenWord(state, start, "do")) {
                    return parseBodyThenCondition(ast, state, parent, context,
                        AST_STMT_DO_WHILE, "while");
                }
                if (tokenWord(state, start, "repeat") &&
                    kind(state, start + 1) == T_LBRACE) {
                    return parseBodyThenCondition(ast, state, parent, context,
                        AST_STMT_REPEAT, "until");
                }
                if (tokenWord(state, start, "repeat")) {
                    bodyOpen >> int <- topLevelKind(state, start + 1,
                        statementLimit(context), T_LBRACE);
                    guard bodyOpen > start + 1 else return -1;
                    statement >> int <- appendNode(ast, AST_STMT_REPEAT, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0, 1, start);
                    guard attachExpressionRange(ast, state, statement,
                        start + 1, bodyOpen) else return -1;
                    statementMove(context, bodyOpen);
                    guard parseBlock(ast, state, statement, context) >= 0 else return -1;
                    closeNode(ast, statement, statementAt(context) - 1);
                    return statement;
                }
                if (tokenWord(state, start, "unless")) {
                    statement >> int <- appendNode(ast, AST_STMT_UNLESS, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0, 0, start);
                    guard conditionAndBody(ast, state, statement, context, start) >= 0 else return -1;
                    closeNode(ast, statement, statementAt(context) - 1);
                    return statement;
                }
                if (tokenWord(state, start, "guard")) return parseGuard(ast, state, parent, context);
                if (tokenWord(state, start, "defer")) return parseDefer(ast, state, parent, context);

                end >> int <- topLevelKind(state, start,
                    statementLimit(context), T_SEMICOLON);
                guard end >= 0 else {
                    setError(ast, 6, lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start));
                    return -1;
                }
                if (token == T_KEYWORD_RETURN) {
                    statement >> int <- appendNode(ast, AST_STMT_RETURN, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0, 0, start);
                    if (start + 1 < end) {
                        guard attachExpressionRange(ast, state, statement,
                            start + 1, end) else return -1;
                    }
                    closeNode(ast, statement, end);
                    statementMove(context, end + 1);
                    return statement;
                }
                if (tokenWord(state, start, "yield")) {
                    statement >> int <- appendNode(ast, AST_STMT_YIELD, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start), 0, 0, start);
                    guard start + 1 < end && attachExpressionRange(ast, state,
                        statement, start + 1, end) else return -1;
                    closeNode(ast, statement, end);
                    statementMove(context, end + 1);
                    return statement;
                }
                if (tokenWord(state, start, "break") || tokenWord(state, start, "continue")) {
                    statementKind >> int <- tokenWord(state, start, "break") ?
                        AST_STMT_BREAK : AST_STMT_CONTINUE;
                    statement >> int <- appendNode(ast, statementKind, parent,
                        lexer.nccLexer.tokenLineAt(state, start),
                        lexer.nccLexer.tokenColumnAt(state, start),
                        start + 1 < end ? lexer.nccLexer.tokenHashAt(state, start + 1) : 0,
                        0, start);
                    closeNode(ast, statement, end);
                    statementMove(context, end + 1);
                    return statement;
                }
                if (kind(state, start + 1) == T_SHIFT2) {
                    statement >> int <- parseLocalDeclaration(ast, state, parent, start, end);
                    statementMove(context, end + 1);
                    return statement;
                }
                statement >> int <- appendStatementValue(ast, state, parent, start, end);
                statementMove(context, end + 1);
                return statement;
            }

            materializeFunctionBodies(ast >> p<byte>, state >> p<byte>) -> bool {
                retained >> int <- field(ast, A_COUNT);
                at >> int <- 0;
                while (at < retained && field(ast, A_ERROR) == 0) {
                    item >> p<byte> <- node(ast, at);
                    if (field(item, N_KIND) == AST_FUNCTION_DECL) {
                        first >> int <- field(item, N_FIRST_TOKEN);
                        end >> int <- field(item, N_END_TOKEN);
                        bodyOpen >> int <- topLevelKind(state, first, end + 1, T_LBRACE);
                        if (bodyOpen >= 0) {
                            context >> p<byte> <- statementContext(bodyOpen, end + 1);
                            guard context != null else return false;
                            parseBlock(ast, state, at, context);
                            free(context);
                        }
                    }
                    at += 1;
                }
                return field(ast, A_ERROR) == 0;
            }

            materializeGenericParameters(ast >> p<byte>, state >> p<byte>,
                parent >> int, first >> int, end >> int) -> int {
                at >> int <- first;
                total >> int <- 0;
                while (at < end) {
                    constParameter >> bool <- at > first &&
                        lexer.nccLexer.tokenSame(state, at - 1, "const");
                    if (kind(state, at) == T_IDENTIFIER &&
                        (at == first || kind(state, at - 1) == T_COMMA ||
                        constParameter)) {
                        parameter >> int <- appendNode(ast, AST_GENERIC_PARAM, parent,
                            lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at),
                            lexer.nccLexer.tokenHashAt(state, at),
                            constParameter ? 1 : 0, at);
                        closeNode(ast, parameter, at);
                        total += 1;
                    }
                    at += 1;
                }
                return total;
            }

            materializeGenericAbiNodes(ast >> p<byte>, state >> p<byte>) -> bool {
                count >> int <- lexer.nccLexer.tokenCount(state);
                at >> int <- 0;
                rootChild >> int <- field(node(ast, 0), N_FIRST_CHILD);
                while (at < count) {
                    while (rootChild >= 0 && field(node(ast, rootChild), N_END_TOKEN) < at) {
                        rootChild <- field(node(ast, rootChild), N_NEXT_SIBLING);
                    }
                    if (rootChild >= 0) {
                        rootKind >> int <- field(node(ast, rootChild), N_KIND);
                        if ((rootKind == 81 || rootKind == 82) &&
                            field(node(ast, rootChild), N_FIRST_TOKEN) <= at) {
                            at <- field(node(ast, rootChild), N_END_TOKEN) + 1;
                            continue;
                        }
                    }
                    if (kind(state, at) == T_IDENTIFIER && kind(state, at + 1) == T_LESS) {
                        close >> int <- matchingGeneric(state, at + 1, count);
                        if (close > at + 1 && kind(state, close + 1) == T_LPAREN) {
                            callClose >> int <- matching(state, close + 1, count,
                                T_LPAREN, T_RPAREN);
                            declaration >> bool <- callClose >= 0 &&
                                kind(state, callClose + 1) == T_ARROW;
                            if (declaration) {
                                existing >> int <- 0;
                                while (existing < field(ast,A_COUNT)) {
                                    if (field(node(ast,existing),N_KIND) == AST_FUNCTION_DECL &&
                                        field(node(ast,existing),N_FIRST_TOKEN) == at) break;
                                    existing += 1;
                                }
                                if (existing < field(ast,A_COUNT)) { at = close + 1; continue; }
                                generic >> int <- appendNode(ast, AST_GENERIC_DECL, 0,
                                    lexer.nccLexer.tokenLineAt(state, at),
                                    lexer.nccLexer.tokenColumnAt(state, at),
                                    lexer.nccLexer.tokenHashAt(state, at), 0, at);
                                materializeGenericParameters(ast, state, generic, at + 2, close);
                                closeNode(ast, generic, callClose);
                            }
                        }
                    }
                    if (kind(state,at) != T_STRING && kind(state,at) != T_CHAR &&
                        lexer.nccLexer.tokenSame(state, at, "trait")) {
                        declaration >> int <- appendNode(ast, AST_TRAIT_DECL, 0,
                            lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at),
                            kind(state, at + 1) == T_IDENTIFIER ?
                                lexer.nccLexer.tokenHashAt(state, at + 1) : 0, 0, at);
                        closeNode(ast, declaration, at + 1);
                    } else if (kind(state,at) != T_STRING && kind(state,at) != T_CHAR &&
                        lexer.nccLexer.tokenSame(state, at, "impl")) {
                        declaration >> int <- appendNode(ast, AST_IMPL_DECL, 0,
                            lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at), 0, 0, at);
                        closeNode(ast, declaration, at);
                    } else if (lexer.nccLexer.tokenSame(state, at, "type") &&
                        kind(state, at + 1) == T_IDENTIFIER && kind(state, at + 2) == T_SEMICOLON) {
                        declaration >> int <- appendNode(ast, AST_ASSOCIATED_TYPE, 0,
                            lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at),
                            lexer.nccLexer.tokenHashAt(state, at + 1), 0, at);
                        closeNode(ast, declaration, at + 2);
                    } else if (kind(state, at) == T_IDENTIFIER &&
                        kind(state, at + 1) == T_COLON && kind(state, at + 2) == T_COLON &&
                        lexer.nccLexer.tokenSame(state, at + 3, "abi")) {
                        declaration >> int <- appendNode(ast, AST_ABI_CONTRACT, 0,
                            lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at),
                            lexer.nccLexer.tokenHashAt(state, at), 0, at);
                        closeNode(ast, declaration, at + 3);
                    } else if (kind(state,at) != T_STRING && kind(state,at) != T_CHAR &&
                        lexer.nccLexer.tokenSame(state, at, "bind") &&
                        lexer.nccLexer.pathSegmentKind(kind(state,at + 1))) {
                        bindingEnd >> int <- at + 1;
                        while (bindingEnd < count && kind(state,bindingEnd) != T_SEMICOLON &&
                            kind(state,bindingEnd) != T_RBRACE) { bindingEnd += 1; }
                        declaration >> int <- appendNode(ast, AST_ABI_BINDING, 0,
                            lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at), 0, 0, at);
                        closeNode(ast, declaration, bindingEnd);
                    }
                    at += 1;
                }
                return true;
            }

            opens(token >> int) -> bool {
                return token == T_LBRACE || token == T_LPAREN || token == T_LBRACKET;
            }

            closes(token >> int) -> bool {
                return token == T_RBRACE || token == T_RPAREN || token == T_RBRACKET;
            }

            expected(open >> int) -> int {
                if (open == T_LBRACE) return T_RBRACE;
                if (open == T_LPAREN) return T_RPAREN;
                return T_RBRACKET;
            }

            sectionKind(state >> p<byte>, index >> int) -> int {
                token >> int <- kind(state, index);
                if (token == T_KEYWORD_STC) return AST_STC_SECTION;
                if (token == T_KEYWORD_LOCAL) return AST_LOCAL_SECTION;
                if (token == T_KEYWORD_FN) return AST_FN_SECTION;
                if (token == T_KEYWORD_FA) return AST_FA_SECTION;
                if (token == T_IDENTIFIER && lexer.nccLexer.tokenSame(state, index, "const")) {
                    return AST_CONST_SECTION;
                }
                if (token == T_IDENTIFIER && lexer.nccLexer.tokenSame(state, index, "type")) {
                    return AST_TYPE_SECTION;
                }
                return 0;
            }

            setError(ast >> p<byte>, error >> int, line >> int, column >> int) -> bool {
                put(ast, A_ERROR, error);
                put(ast, A_ERROR_LINE, line);
                put(ast, A_ERROR_COLUMN, column);
                return false;
            }

            decoratedContainerHeader(state >> p<byte>, at >> int) -> bool {
                guard kind(state, at + 1) == T_LBRACKET else return false;
                cursor >> int <- at + 2;
                square >> int <- 1;
                count >> int <- lexer.nccLexer.tokenCount(state);
                while (cursor < count && square > 0) {
                    if (kind(state, cursor) == T_LBRACKET) square += 1;
                    else if (kind(state, cursor) == T_RBRACKET) square -= 1;
                    cursor += 1;
                }
                return square == 0 && kind(state, cursor) == T_LBRACE;
            }

            contractError(ast >> p<byte>, state >> p<byte>, at >> int, code >> int) -> int {
                setError(ast, code, lexer.nccLexer.tokenLineAt(state, at),
                    lexer.nccLexer.tokenColumnAt(state, at));
                return -1;
            }

            contractRole(state >> p<byte>, at >> int) -> int {
                cursor >> int <- at + 1;
                if (kind(state, cursor) == T_LESS) {
                    cursor += 1;
                    while (kind(state, cursor) == T_IDENTIFIER) {
                        cursor += 1;
                        if (kind(state, cursor) != T_COMMA) break;
                        cursor += 1;
                    }
                    if (kind(state, cursor) != T_GREATER) return -1;
                    cursor += 1;
                }
                if (kind(state, cursor) != T_COLON || kind(state, cursor + 1) != T_COLON) return -1;
                cursor += 2;
                if (lexer.nccLexer.tokenAsciiWordSame(state, cursor, "type") ||
                    lexer.nccLexer.tokenAsciiWordSame(state, cursor, "struct") ||
                    lexer.nccLexer.tokenAsciiWordSame(state, cursor, "union") ||
                    lexer.nccLexer.tokenAsciiWordSame(state, cursor, "enum")) return cursor;
                return -1;
            }

            clauseCode(state >> p<byte>, at >> int) -> int {
                if (kind(state, at + 1) != T_COLON) return 0;
                if (tokenWord(state, at, "layout")) return 1;
                if (tokenWord(state, at, "invariant")) return 2;
                if (tokenWord(state, at, "bounds")) return 3;
                if (tokenWord(state, at, "constructure")) return 4;
                if (tokenWord(state, at, "destructure")) return 5;
                if (tokenWord(state, at, "copy")) return 6;
                if (tokenWord(state, at, "clone")) return 7;
                if (kind(state, at) == T_KEYWORD_MOVE) return 8;
                if (tokenWord(state, at, "ffi")) return 9;
                if (tokenWord(state, at, "ownership")) return 10;
                if (tokenWord(state, at, "nullability")) return 11;
                if (tokenWord(state, at, "methods")) return 12;
                if (tokenWord(state, at, "associated")) return 13;
                if (tokenWord(state, at, "validate")) return 14;
                if (tokenWord(state, at, "drop")) return 15;
                if (tokenWord(state, at, "default")) return 16;
                if (tokenWord(state, at, "compare")) return 17;
                if (tokenWord(state, at, "hash")) return 18;
                if (tokenWord(state, at, "debug")) return 19;
                if (tokenWord(state, at, "stable")) return 20;
                return 0;
            }

            contractBoundary(state >> p<byte>, at >> int) -> bool {
                return clauseCode(state, at) > 0 ||
                    (visibility(kind(state, at)) > 0 && kind(state, at + 1) == T_COLON);
            }

            contractField(ast >> p<byte>, state >> p<byte>, parent >> int,
                at >> int, limit >> int, access >> int, group >> int, payload >> bool) -> int {
                if (!lexer.nccLexer.identifierKind(kind(state,at))) return contractError(ast, state, at, 10);
                separator >> int <- kind(state, at + 1);
                if (separator != T_COLON && (payload || separator != T_SHIFT2))
                    return contractError(ast, state, at + 1, 16);
                item >> int <- appendTypedNode(ast, AST_FIELD_DECL, parent, state, at, at + 2, access);
                put(node(ast, item), N_ROLE_HASH, group);
                context >> p<byte> <- typeContext(at + 2, limit);
                if (context == null) return contractError(ast, state, at + 2, 4);
                root >> int <- parseTypeRef(ast, state, context);
                next >> int <- typeAt(context);
                pending >> int <- typePending(context);
                free(context);
                if (root < 0 || pending != 0) return -1;
                adopt(ast, item, root);
                if (!payload && kind(state, next) != T_SEMICOLON)
                    return contractError(ast, state, next, 13);
                closeNode(ast, item, payload ? next - 1 : next);
                return payload ? next : next + 1;
            }

            contractClause(ast >> p<byte>, state >> p<byte>, parent >> int,
                start >> int, limit >> int) -> int {
                clause >> int <- appendTypedNode(ast, AST_TYPE_CLAUSE, parent, state, start, -1, clauseCode(state, start));
                cursor >> int <- start + 2;
                items >> int <- 0;
                while (cursor < limit && !contractBoundary(state, cursor)) {
                    first >> int <- cursor;
                    depth >> int <- 0;
                    stack >> p<int> <- cast(alloc((limit - cursor + 1) * sizeOf(int)));
                    if (stack == null) return contractError(ast, state, cursor, 4);
                    while (cursor < limit) {
                        token >> int <- kind(state, cursor);
                        if (depth == 0 && token == T_SEMICOLON) break;
                        if (opens(token)) { wr(off(stack, depth), token); depth += 1; }
                        else if (closes(token)) {
                            if (depth == 0 || expected(rd(off(stack, depth - 1))) != token) {
                                free(stack); return contractError(ast, state, cursor, 1);
                            }
                            depth -= 1;
                        }
                        cursor += 1;
                    }
                    free(stack);
                    if (cursor >= limit || depth != 0) return contractError(ast, state, cursor, 13);
                    if (cursor > first) {
                        item >> int <- appendTypedNode(ast, AST_CONTRACT_ITEM, clause, state, first, -1, 0);
                        closeNode(ast, item, cursor - 1);
                        items += 1;
                    }
                    cursor += 1;
                }
                if (items == 0) return contractError(ast, state, cursor, 14);
                closeNode(ast, clause, cursor - 1);
                return cursor;
            }

            contractLayout(ast >> p<byte>, state >> p<byte>, parent >> int, start >> int, end >> int) -> bool {
                if (start + 1 == end) return true;
                clause >> int <- appendTypedNode(ast, AST_TYPE_CLAUSE, parent, state, start, -1, 1);
                closeNode(ast, clause, end);
                cursor >> int <- start + 1;
                while (cursor < end) {
                    if (!lexer.nccLexer.pathSegmentKind(kind(state, cursor))) {
                        contractError(ast, state, cursor, 15); return false;
                    }
                    key >> int <- cursor;
                    style >> int <- 1;
                    if (lexer.nccLexer.tokenAsciiWordSame(state, key, "repr")) style <- 2;
                    if (lexer.nccLexer.tokenAsciiWordSame(state, key, "align")) style <- 3;
                    if (lexer.nccLexer.tokenAsciiWordSame(state, key, "endian")) style <- 4;
                    if (lexer.nccLexer.tokenAsciiWordSame(state, key, "c")) style <- 5;
                    if (lexer.nccLexer.tokenAsciiWordSame(state, key, "little") ||
                        lexer.nccLexer.tokenAsciiWordSame(state, key, "le")) style <- 6;
                    if (lexer.nccLexer.tokenAsciiWordSame(state, key, "big") ||
                        lexer.nccLexer.tokenAsciiWordSame(state, key, "be")) style <- 7;
                    cursor += 1;
                    if (style >= 2 && style <= 4) {
                        valid >> bool <- lexer.nccLexer.pathSegmentKind(kind(state, cursor));
                        if (style == 3) valid <- kind(state, cursor) == T_NUMBER || kind(state, cursor) == T_IDENTIFIER;
                        if (!valid) { contractError(ast, state, cursor, 15); return false; }
                        cursor += 1;
                    }
                    item >> int <- appendTypedNode(ast, AST_CONTRACT_ITEM, clause, state, key, -1, style);
                    closeNode(ast, item, cursor - 1);
                    if (cursor == end) break;
                    if (kind(state, cursor) != T_PIPE) { contractError(ast, state, cursor, 15); return false; }
                    cursor += 1;
                }
                return true;
            }

            parseTypeContract(ast >> p<byte>, state >> p<byte>, parent >> int, start >> int,
                global >> bool, declarationAccess >> int) -> int {
                declaration >> int <- appendTypedNode(ast, global ? AST_GLOBAL_TYPE : AST_TYPE_DECL,
                    parent, state, start, -1, 1);
                cursor >> int <- start + 1;
                if (kind(state, cursor) == T_LESS) {
                    cursor += 1;
                    while (kind(state, cursor) == T_IDENTIFIER) {
                        appendTypedNode(ast, AST_TYPE_GENERIC_PARAM, declaration, state, cursor, -1, 0);
                        cursor += 1;
                        if (kind(state, cursor) != T_COMMA) break;
                        cursor += 1;
                        if (kind(state, cursor) != T_IDENTIFIER) return contractError(ast, state, cursor, 10);
                    }
                    if (kind(state, cursor) != T_GREATER) return contractError(ast, state, cursor, 4);
                    cursor += 1;
                }
                role >> int <- contractRole(state, start);
                typeKind >> int <- 1;
                if (role >= 0) {
                    if (lexer.nccLexer.tokenAsciiWordSame(state, role, "union")) typeKind <- 2;
                    if (lexer.nccLexer.tokenAsciiWordSame(state, role, "enum")) typeKind <- 3;
                    cursor <- role + 1;
                } else if (tokenWord(state, cursor, "enum")) { typeKind <- 3; cursor += 1; }
                else if (tokenWord(state, cursor, "union")) { typeKind <- 2; cursor += 1; }
                else if (tokenWord(state, cursor, "tagged")) {
                    cursor += 1;
                    if (!tokenWord(state, cursor, "union")) return contractError(ast, state, cursor, 14);
                    typeKind <- 4; cursor += 1;
                }
                // Low byte is the type class; declaration visibility occupies the next byte.
                put(node(ast, declaration), N_FLAGS, typeKind | (declarationAccess << 8));
                layoutStart >> int <- -1;
                layoutEnd >> int <- -1;
                if (role >= 0 && kind(state, cursor) == T_LBRACKET) {
                    layoutStart <- cursor;
                    layoutEnd <- matching(state, cursor, lexer.nccLexer.tokenCount(state), T_LBRACKET, T_RBRACKET);
                    if (layoutEnd < 0) return contractError(ast, state, cursor, 2);
                    cursor <- layoutEnd + 1;
                }
                if (kind(state, cursor) != T_LBRACE) return contractError(ast, state, cursor, 14);
                end >> int <- matching(state, cursor, lexer.nccLexer.tokenCount(state), T_LBRACE, T_RBRACE);
                if (end < 0) return contractError(ast, state, cursor, 2);
                cursor += 1;
                access >> int <- VIS_PUBLIC;
                group >> int <- 0;
                enumFields >> bool <- false;
                while (cursor < end) {
                    if (role >= 0 && typeKind >= 3 && contractBoundary(state, cursor))
                        return contractError(ast, state, cursor, 10);
                    if (visibility(kind(state, cursor)) > 0 && kind(state, cursor + 1) == T_COLON) {
                        access <- visibility(kind(state, cursor)); group += 1; cursor += 2;
                        enumFields <- true;
                        if (cursor == end || contractBoundary(state, cursor)) return contractError(ast, state, cursor, 14);
                    } else if (clauseCode(state, cursor) > 0) {
                        cursor <- contractClause(ast, state, declaration, cursor, end);
                        group += 1; access <- VIS_PUBLIC; enumFields <- false;
                        if (cursor < 0) return -1;
                        continue;
                    }
                    if (typeKind >= 3 && !enumFields) {
                        if (kind(state, cursor) != T_IDENTIFIER) return contractError(ast, state, cursor, 10);
                        variant >> int <- appendTypedNode(ast, AST_TYPE_VARIANT, declaration, state, cursor, -1, 0);
                        cursor += 1;
                        if (kind(state, cursor) == T_LPAREN) {
                            cursor += 1;
                            while (kind(state, cursor) != T_RPAREN) {
                                cursor <- contractField(ast, state, variant, cursor, end, VIS_PUBLIC, 0, true);
                                if (cursor < 0) return -1;
                                if (kind(state, cursor) != T_COMMA) break;
                                cursor += 1;
                            }
                            if (kind(state, cursor) != T_RPAREN) return contractError(ast, state, cursor, 1);
                            cursor += 1;
                        }
                        if (kind(state, cursor) != T_SEMICOLON) return contractError(ast, state, cursor, 13);
                        closeNode(ast, variant, cursor); cursor += 1;
                    } else {
                        cursor <- contractField(ast, state, declaration, cursor, end, access, group, false);
                        if (cursor < 0) return -1;
                    }
                }
                if (layoutStart >= 0) {
                    if (!contractLayout(ast, state, declaration, layoutStart, layoutEnd)) return -1;
                }
                closeNode(ast, declaration, end);
                return end + 1;
            }

            build(state >> p<byte>) -> p<byte> {
                count >> int <- lexer.nccLexer.tokenCount(state);
                ast >> p<byte> <- makeAst(count);
                guard ast != null else return null;
                appendNode(ast, AST_PROGRAM, -1, 1, 1, 0, 0, 0);
                stack >> p<int> <- cast<int>(alloc(count * sizeOf(int)));
                guard stack != null else { releaseAst(ast); return null; }

                depth >> int <- 0;
                braceDepth >> int <- 0;
                activeRoot >> int <- -1;
                activeContainer >> int <- -1;
                pendingImport >> int <- -1;
                activeSection >> int <- -1;
                activeType >> int <- -1;
                activeFunction >> int <- -1;
                activeDeclaration >> int <- -1;
                activeVisibility >> int <- VIS_DEFAULT;
                at >> int <- 0;

                while (at < count && kind(state, at) != T_EOF && field(ast, A_ERROR) == 0) {
                    token >> int <- kind(state, at);
                    topLevel >> bool <- braceDepth == 0;

                    // Inline entry is an ordinary body with a distinct source-origin flag.
                    if (braceDepth == 1 && activeContainer >= 0 && tokenWord(state, at, "to") &&
                        kind(state, at + 1) == T_KEYWORD_MAIN) {
                        body >> int <- at + 2;
                        if (kind(state, body) == T_AT) {
                            body += 1;
                            if (lexer.nccLexer.pathSegmentKind(kind(state, body))) body += 1;
                        }
                        if (kind(state, body) != T_LBRACE) {
                            contractError(ast, state, body, 6); break;
                        }
                        end >> int <- matching(state, body, count, T_LBRACE, T_RBRACE);
                        if (end < 0) { contractError(ast, state, body, 2); break; }
                        if (activeSection >= 0) closeNode(ast, activeSection, at - 1);
                        activeSection <- appendNode(ast, AST_FN_SECTION, activeContainer,
                            lexer.nccLexer.tokenLineAt(state, at), lexer.nccLexer.tokenColumnAt(state, at), 0, 0, at);
                        entryBody >> int <- appendTypedNode(ast, AST_FUNCTION_DECL, activeSection,
                            state, at + 1, -1, 128);
                        closeNode(ast, entryBody, end);
                        entry >> int <- appendTypedNode(ast, AST_ENTRY_REF, activeSection,
                            state, at + 1, -1, 128);
                        put(node(ast, entry), N_ROLE_HASH, lexer.nccLexer.tokenHashAt(state, at + 1));
                        closeNode(ast, entry, at + 1);
                        at <- end + 1;
                        continue;
                    }

                    if (topLevel && pendingImport < 0 && parser_modules.nccParserModules.starts(state, at)) {
                        next >> int <- parser_modules.nccParserModules.parse(ast, state, at, 0);
                        if (next < 0) break;
                        at <- next;
                        continue;
                    }

                    typeRole >> int <- lexer.nccLexer.identifierKind(token) ? contractRole(state, at) : -1;
                    if (topLevel && pendingImport < 0 && typeRole >= 0) {
                        at <- parseTypeContract(ast, state, 0, at, true, activeVisibility);
                        if (at < 0) break;
                        continue;
                    }
                    if (braceDepth == 1 && activeContainer >= 0 && activeFunction < 0 &&
                        lexer.nccLexer.identifierKind(token) &&
                        !(kind(state, at - 1) == T_COLON && kind(state, at - 2) == T_COLON)) {
                        inTypes >> bool <- activeSection >= 0 && field(node(ast, activeSection), N_KIND) == AST_TYPE_SECTION;
                        oldHeader >> bool <- inTypes && (kind(state, at + 1) == T_LBRACE ||
                            kind(state, at + 1) == T_LESS || tokenWord(state, at + 1, "enum") ||
                            tokenWord(state, at + 1, "union") || tokenWord(state, at + 1, "tagged"));
                        if (typeRole >= 0 || oldHeader) {
                            if (!inTypes) {
                                if (activeSection >= 0) closeNode(ast, activeSection, at - 1);
                                activeSection <- appendNode(ast, AST_TYPE_SECTION, activeContainer,
                                    lexer.nccLexer.tokenLineAt(state, at), lexer.nccLexer.tokenColumnAt(state, at), 0, 0, at);
                            }
                            at <- parseTypeContract(ast, state, activeSection, at, false, activeVisibility);
                            if (at < 0) break;
                            continue;
                        }
                    }

                    if (topLevel && pendingImport < 0 && tokenWord(state, at, "const") &&
                        kind(state, at + 2) == T_SHIFT2) {
                        end >> int <- topLevelKind(state, at + 3, count, T_SEMICOLON);
                        declaration >> int <- end >= 0 ? parseLocalDeclaration(ast, state, 0, at + 1, end) : -1;
                        if (declaration < 0) {
                            setError(ast, 6, lexer.nccLexer.tokenLineAt(state, at), lexer.nccLexer.tokenColumnAt(state, at));
                            break;
                        }
                        put(node(ast, declaration), N_KIND, AST_GLOBAL_CONST);
                        closeNode(ast, declaration, end);
                        at <- end + 1;
                        continue;
                    }

                    if (topLevel && (token == T_KEYWORD_USE || token == T_KEYWORD_IMPORT)) {
                        pendingImport <- appendNode(ast, AST_USE_GROUP, 0,
                            lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at), 0, 0, at);
                    }

                    roleContinuation >> bool <- kind(state, at - 1) == T_COLON &&
                        kind(state, at - 2) == T_COLON;
                    if (topLevel && pendingImport < 0 && lexer.nccLexer.identifierKind(token) &&
                        !roleContinuation) {
                        shortHeader >> bool <- kind(state, at + 1) == T_LBRACE ||
                            decoratedContainerHeader(state, at);
                        doubleColon >> bool <- kind(state, at + 1) == T_COLON &&
                            kind(state, at + 2) == T_COLON;
                        roleHeader >> bool <- doubleColon && kind(state, at + 4) == T_LBRACE;
                        globalConst >> bool <- doubleColon &&
                            lexer.nccLexer.tokenSame(state, at + 3, "const");
                        globalType >> bool <- roleHeader && (
                            lexer.nccLexer.tokenSame(state, at + 3, "type") ||
                            lexer.nccLexer.tokenSame(state, at + 3, "struct") ||
                            lexer.nccLexer.tokenSame(state, at + 3, "union") ||
                            lexer.nccLexer.tokenSame(state, at + 3, "enum"));
                        if (globalConst) {
                            activeRoot <- appendNode(ast, AST_GLOBAL_CONST, 0,
                                lexer.nccLexer.tokenLineAt(state, at),
                                lexer.nccLexer.tokenColumnAt(state, at),
                                lexer.nccLexer.tokenHashAt(state, at),
                                lexer.nccLexer.tokenHashAt(state, at + 3), at);
                        } else if (globalType) {
                            activeRoot <- appendNode(ast, AST_GLOBAL_TYPE, 0,
                                lexer.nccLexer.tokenLineAt(state, at),
                                lexer.nccLexer.tokenColumnAt(state, at),
                                lexer.nccLexer.tokenHashAt(state, at),
                                lexer.nccLexer.tokenHashAt(state, at + 3), at);
                        } else if (shortHeader || roleHeader) {
                            activeContainer <- appendNode(ast, AST_CONTAINER, 0,
                                lexer.nccLexer.tokenLineAt(state, at),
                                lexer.nccLexer.tokenColumnAt(state, at),
                                lexer.nccLexer.identifierHashAt(state, at),
                                roleHeader ? lexer.nccLexer.tokenHashAt(state, at + 3) : 0, at);
                            activeRoot <- activeContainer;
                        }
                    }

                    if (braceDepth == 1 && activeContainer >= 0 &&
                        kind(state, at + 1) == T_COLON) {
                        section >> int <- sectionKind(state, at);
                        if (section != 0) {
                            if (activeSection >= 0) closeNode(ast, activeSection, at - 1);
                            activeSection <- appendNode(ast, section, activeContainer,
                                lexer.nccLexer.tokenLineAt(state, at),
                                lexer.nccLexer.tokenColumnAt(state, at), 0, 0, at);
                            activeVisibility <- VIS_DEFAULT;
                        }
                    }

                    compactFunction >> bool <- lexer.nccLexer.identifierKind(token) &&
                        kind(state, at + 1) == T_COLON && kind(state, at + 2) == T_COLON &&
                        kind(state, at + 3) == T_KEYWORD_FN && kind(state, at + 4) == T_LPAREN;
                    compactType >> bool <- lexer.nccLexer.identifierKind(token) &&
                        kind(state, at + 1) == T_COLON && kind(state, at + 2) == T_COLON &&
                        lexer.nccLexer.tokenSame(state, at + 3, "type");
                    genericEnd >> int <- lexer.nccLexer.identifierKind(token) && kind(state,at+1) == T_LESS ?
                        matchingGeneric(state,at+1,count) : -1;
                    genericFunction >> bool <- genericEnd > at+1 && kind(state,genericEnd+1) == T_LPAREN;
                    bareFunction >> bool <- false;
                    if (braceDepth == 1 && activeFunction < 0 && !roleContinuation &&
                        lexer.nccLexer.identifierKind(token) && (kind(state, at + 1) == T_LPAREN || genericFunction) &&
                        declarationBoundary(state, at)) {
                        parametersEnd >> int <- matching(state, genericFunction ? genericEnd+1 : at+1, count, T_LPAREN, T_RPAREN);
                        if (parametersEnd >= 0) bareFunction <- kind(state, parametersEnd + 1) == T_ARROW;
                    }
                    implicitSection >> bool <- compactFunction || compactType;
                    if (bareFunction && activeSection < 0) implicitSection <- true;
                    if (bareFunction && activeSection >= 0) {
                        if (field(node(ast, activeSection), N_KIND) != AST_FN_SECTION) implicitSection <- true;
                    }
                    if (braceDepth == 1 && activeContainer >= 0 && implicitSection) {
                        if (activeSection >= 0) closeNode(ast, activeSection, at - 1);
                        activeSection <- appendNode(ast, compactType ? AST_TYPE_SECTION : AST_FN_SECTION,
                            activeContainer, lexer.nccLexer.tokenLineAt(state, at),
                            lexer.nccLexer.tokenColumnAt(state, at), 0, 0, at);
                    }
                    sectionType >> int <- 0;
                    if (activeSection >= 0) sectionType <- field(node(ast, activeSection), N_KIND);
                    declaredVisibility >> int <- visibility(token);
                    if (declaredVisibility != VIS_DEFAULT && kind(state, at + 1) == T_COLON &&
                        ((braceDepth == 1 && (sectionType == AST_FN_SECTION || sectionType == AST_TYPE_SECTION)) ||
                        (braceDepth == 2 && activeType >= 0))) {
                        activeVisibility <- declaredVisibility;
                    }

                    if (braceDepth == 1 && sectionType == AST_TYPE_SECTION &&
                        lexer.nccLexer.identifierKind(token) && (kind(state, at + 1) == T_LBRACE || compactType)) {
                        activeType <- appendTypedNode(ast, AST_TYPE_DECL, activeSection,
                            state, at, -1, 1 | (activeVisibility << 8));
                    }

                    if (braceDepth == 1 &&
                        (sectionType == AST_CONST_SECTION || sectionType == AST_STC_SECTION ||
                        sectionType == AST_LOCAL_SECTION) && token == T_IDENTIFIER &&
                        kind(state, at + 1) == T_SHIFT2 && declarationBoundary(state, at)) {
                        activeDeclaration <- appendTypedNode(ast, AST_VALUE_DECL, activeSection,
                            state, at, at + 2, activeVisibility);
                        attachType(ast, state, activeDeclaration, at + 2);
                    }

                    if (braceDepth == 2 && activeType >= 0 && lexer.nccLexer.identifierKind(token) &&
                        kind(state, at + 1) == T_SHIFT2 && declarationBoundary(state, at)) {
                        activeDeclaration <- appendTypedNode(ast, AST_FIELD_DECL, activeType,
                            state, at, at + 2, activeVisibility);
                        attachType(ast, state, activeDeclaration, at + 2);
                    }

                    if (braceDepth == 1 && sectionType == AST_FN_SECTION && activeFunction < 0 && !roleContinuation &&
                        lexer.nccLexer.identifierKind(token) && (kind(state, at + 1) == T_LPAREN || compactFunction || genericFunction)) {
                        activeFunction <- appendTypedNode(ast, AST_FUNCTION_DECL, activeSection,
                            state, at, -1, activeVisibility);
                        if (genericFunction) {
                            generic >> int <- appendNode(ast,AST_GENERIC_DECL,activeFunction,
                                lexer.nccLexer.tokenLineAt(state,at),lexer.nccLexer.tokenColumnAt(state,at),
                                lexer.nccLexer.tokenHashAt(state,at),0,at);
                            materializeGenericParameters(ast,state,generic,at+2,genericEnd);
                            closeNode(ast,generic,genericEnd);
                        }
                    }

                    if (braceDepth == 1 && activeFunction >= 0 && expressionNameToken(token) &&
                        kind(state, at + 1) == T_SHIFT2 && parameterBoundary(state, at)) {
                        parameter >> int <- appendTypedNode(ast, AST_PARAMETER_DECL,
                            activeFunction, state, at, at + 2, VIS_DEFAULT);
                        if (token != T_IDENTIFIER) put(node(ast, parameter), N_ROLE_HASH, token);
                        attachType(ast, state, parameter, at + 2);
                        typeEnd >> int <- field(node(ast,
                            field(node(ast, parameter), N_FIRST_CHILD)), N_END_TOKEN);
                        closeNode(ast, parameter, typeEnd);
                    }

                    if (braceDepth == 1 && activeFunction >= 0 && token == T_ARROW &&
                        kind(state, at + 1) != T_LBRACE) {
                        put(node(ast, activeFunction), N_TYPE_HASH,
                            lexer.nccLexer.tokenHashAt(state, at + 1));
                        attachType(ast, state, activeFunction, at + 1);
                    }

                    if (token == T_LESS_DASH && activeDeclaration >= 0 &&
                        field(node(ast, activeDeclaration), N_FLAGS) < 16) {
                        if (attachExpression(ast, state, activeDeclaration, at + 1)) {
                            put(node(ast, activeDeclaration), N_FLAGS,
                                field(node(ast, activeDeclaration), N_FLAGS) + 16);
                        }
                    }

                    if (activeFunction < 0 && token == T_KEYWORD_RETURN &&
                        kind(state, at + 1) != T_SEMICOLON) {
                        expressionParent >> int <- activeSection >= 0 ? activeSection : activeRoot;
                        if (expressionParent >= 0) {
                            attachExpression(ast, state, expressionParent, at + 1);
                        }
                    }

                    if (braceDepth == 1 && sectionType == AST_FN_SECTION &&
                        token == T_KEYWORD_REF && kind(state, at + 1) == T_KEYWORD_MAIN) {
                        activeDeclaration <- appendTypedNode(ast, AST_ENTRY_REF, activeSection,
                            state, at, -1, VIS_DEFAULT);
                        if (kind(state, at + 3) == T_IDENTIFIER) {
                            put(node(ast, activeDeclaration), N_ROLE_HASH,
                                lexer.nccLexer.tokenHashAt(state, at + 3));
                        }
                    }

                    if (opens(token)) {
                        wr(off(stack, depth), token);
                        depth += 1;
                        if (token == T_LBRACE) braceDepth += 1;
                    } else if (closes(token)) {
                        if (depth == 0 || expected(rd(off(stack, depth - 1))) != token) {
                            setError(ast, 1, lexer.nccLexer.tokenLineAt(state, at),
                                lexer.nccLexer.tokenColumnAt(state, at));
                        } else {
                            if (token == T_RBRACE && braceDepth == 2) {
                                if (activeFunction >= 0) {
                                    closeNode(ast, activeFunction, at);
                                    activeFunction <- -1;
                                }
                                if (activeType >= 0) {
                                    closeNode(ast, activeType, at);
                                    activeType <- -1;
                                }
                            }
                            if (token == T_RBRACE && braceDepth == 1) {
                                if (activeSection >= 0) closeNode(ast, activeSection, at - 1);
                                closeNode(ast, activeRoot, at);
                                activeSection <- -1;
                                activeContainer <- -1;
                                activeRoot <- -1;
                            }
                            depth -= 1;
                            if (token == T_RBRACE) braceDepth -= 1;
                        }
                    } else if (topLevel && token == T_SEMICOLON) {
                        if (pendingImport >= 0) {
                            closeNode(ast, pendingImport, at);
                            pendingImport <- -1;
                        }
                        if (activeRoot >= 0) {
                            closeNode(ast, activeRoot, at);
                            activeRoot <- -1;
                        }
                    } else if (token == T_SEMICOLON && activeDeclaration >= 0) {
                        closeNode(ast, activeDeclaration, at);
                        activeDeclaration <- -1;
                    }
                    at += 1;
                }

                if (field(ast, A_ERROR) == 0 && depth != 0) {
                    setError(ast, 2, lexer.nccLexer.tokenLineAt(state, count - 1),
                        lexer.nccLexer.tokenColumnAt(state, count - 1));
                }
                if (field(ast, A_ERROR) == 0 && pendingImport >= 0) {
                    setError(ast, 3, lexer.nccLexer.tokenLineAt(state, count - 1),
                        lexer.nccLexer.tokenColumnAt(state, count - 1));
                }
                if (field(ast, A_ERROR) == 0) materializeGenericAbiNodes(ast, state);
                if (field(ast, A_ERROR) == 0) materializeFunctionBodies(ast, state);
                closeNode(ast, 0, count - 1);
                free(stack);
                return ast;
            }

            kindName(value >> int) -> str {
                return ast_schema.nccAstSchema.kindName(value);
            }

            countKind(ast >> p<byte>, wanted >> int) -> int {
                total >> int <- 0;
                at >> int <- 0;
                while (at < field(ast, A_COUNT)) {
                    if (field(node(ast, at), N_KIND) == wanted) total += 1;
                    at += 1;
                }
                return total;
            }

            sectionCount(ast >> p<byte>) -> int {
                total >> int <- 0;
                at >> int <- 0;
                while (at < field(ast, A_COUNT)) {
                    value >> int <- field(node(ast, at), N_KIND);
                    if (value >= AST_CONST_SECTION && value <= AST_FA_SECTION) total += 1;
                    at += 1;
                }
                return total;
            }

            declarationCount(ast >> p<byte>) -> int {
                return countKind(ast, AST_VALUE_DECL) + countKind(ast, AST_TYPE_DECL) +
                    countKind(ast, AST_FIELD_DECL) + countKind(ast, AST_FUNCTION_DECL);
            }

            typeNodeCount(ast >> p<byte>) -> int {
                total >> int <- 0;
                value >> int <- AST_TYPE_NAME;
                while (value <= AST_TYPE_CONST) {
                    total += countKind(ast, value);
                    value += 1;
                }
                return total;
            }

            expressionNodeCount(ast >> p<byte>) -> int {
                total >> int <- 0;
                value >> int <- AST_EXPR_LITERAL;
                while (value <= AST_EXPR_ARRAY) {
                    total += countKind(ast, value);
                    value += 1;
                }
                value <- AST_EXPR_STRUCT;
                while (value <= AST_EXPR_IF) {
                    total += countKind(ast, value);
                    value += 1;
                }
                return total;
            }

            statementNodeCount(ast >> p<byte>) -> int {
                total >> int <- 0;
                value >> int <- AST_BLOCK;
                while (value <= AST_STMT_CONTINUE) {
                    total += countKind(ast, value);
                    value += 1;
                }
                total += countKind(ast, AST_STMT_MATCH);
                value <- AST_STMT_FOR_IN;
                while (value <= AST_STMT_YIELD) {
                    total += countKind(ast, value);
                    value += 1;
                }
                at >> int <- 0;
                while (at < field(ast, A_COUNT)) {
                    if (field(node(ast, at), N_KIND) == AST_VALUE_DECL) {
                        parent >> int <- field(node(ast, at), N_PARENT);
                        if (parent >= 0 && field(node(ast, parent), N_KIND) == AST_BLOCK) {
                            total += 1;
                        }
                    }
                    at += 1;
                }
                return total;
            }

            advancedNodeCount(ast >> p<byte>) -> int {
                total >> int <- 0;
                value >> int <- AST_EXPR_STRUCT;
                while (value <= AST_CLOSURE_EFFECT) {
                    total += countKind(ast, value);
                    value += 1;
                }
                return total;
            }

            emitAst(ast >> p<byte>, tokenCount >> int, json >> bool) -> bool {
                if (!json) {
                    print("nodes="); print(renderInt(field(ast, A_COUNT)));
                    print(" imports="); print(renderInt(countKind(ast, AST_USE_GROUP)));
                    print(" containers="); print(renderInt(countKind(ast, AST_CONTAINER)));
                    print(" sections="); print(renderInt(sectionCount(ast)));
                    print(" declarations="); print(renderInt(declarationCount(ast)));
                    print(" parameters="); print(renderInt(countKind(ast, AST_PARAMETER_DECL)));
                    print(" type_nodes="); print(renderInt(typeNodeCount(ast)));
                    print(" expression_nodes="); print(renderInt(expressionNodeCount(ast)));
                    print(" statement_nodes="); println(renderInt(statementNodeCount(ast)));
                    return true;
                }
                print("{\"schema\":\"nc.bootstrap.parser.ast-head.v7\",\"token_count\":");
                print(renderInt(tokenCount));
                print(",\"node_count\":"); print(renderInt(field(ast, A_COUNT)));
                print(",\"import_groups\":"); print(renderInt(countKind(ast, AST_USE_GROUP)));
                print(",\"containers\":"); print(renderInt(countKind(ast, AST_CONTAINER)));
                print(",\"sections\":"); print(renderInt(sectionCount(ast)));
                print(",\"declarations\":"); print(renderInt(declarationCount(ast)));
                print(",\"parameters\":"); print(renderInt(countKind(ast, AST_PARAMETER_DECL)));
                print(",\"entries\":"); print(renderInt(countKind(ast, AST_ENTRY_REF)));
                print(",\"type_nodes\":"); print(renderInt(typeNodeCount(ast)));
                print(",\"expression_nodes\":"); print(renderInt(expressionNodeCount(ast)));
                print(",\"statement_nodes\":"); print(renderInt(statementNodeCount(ast)));
                print(",\"advanced_nodes\":"); print(renderInt(advancedNodeCount(ast)));
                print(",\"nodes\":[");
                at >> int <- 0;
                while (at < field(ast, A_COUNT)) {
                    if (at > 0) print(",");
                    item >> p<byte> <- node(ast, at);
                    print("{\"kind\":\""); print(kindName(field(item, N_KIND)));
                    print("\",\"parent\":"); print(renderInt(field(item, N_PARENT)));
                    print(",\"line\":"); print(renderInt(field(item, N_LINE)));
                    print(",\"column\":"); print(renderInt(field(item, N_COLUMN)));
                    print(",\"name_hash\":"); print(renderInt(field(item, N_NAME_HASH)));
                    print(",\"role_hash\":"); print(renderInt(field(item, N_ROLE_HASH)));
                    print(",\"first_token\":"); print(renderInt(field(item, N_FIRST_TOKEN)));
                    print(",\"end_token\":"); print(renderInt(field(item, N_END_TOKEN)));
                    print(",\"first_child\":"); print(renderInt(field(item, N_FIRST_CHILD)));
                    print(",\"next_sibling\":"); print(renderInt(field(item, N_NEXT_SIBLING)));
                    print(",\"type_hash\":"); print(renderInt(field(item, N_TYPE_HASH)));
                    print(",\"flags\":"); print(renderInt(field(item, N_FLAGS)));
                    print("}");
                    at += 1;
                }
                println("]}");
                return true;
            }

            openSession(state >> p<byte>) -> p<byte> {
                guard state != null else return null;
                session >> p<byte> <- cast<byte>(alloc(MATERIAL_SESSION_BYTES));
                guard session != null else {
                    lexer.nccLexer.close(state);
                    return null;
                }
                ast >> p<byte> <- null;
                if (lexer.nccLexer.valid(state)) ast <- build(state);
                wr<addr>(off(session, MS_STATE), adr(state));
                astAddress >> addr <- 0;
                if (ast != null) astAddress <- adr(ast);
                wr<addr>(off(session, MS_AST), astAddress);
                return session;
            }

        public:
            openMaterial(path >> str) -> p<byte> {
                return openSession(lexer.nccLexer.openFile(path));
            }

            openBuffer(data >> p<byte>, bytes >> int) -> p<byte> {
                return openSession(lexer.nccLexer.openBuffer(data, bytes));
            }

            closeMaterial(session >> p<byte>) -> bool {
                guard session != null else return true;
                ast >> p<byte> <- materialAst(session);
                state >> p<byte> <- materialState(session);
                if (ast != null) releaseAst(ast);
                if (state != null) lexer.nccLexer.close(state);
                free(session);
                return true;
            }

            materialReady(session >> p<byte>) -> bool {
                guard session != null else return false;
                guard materialAst(session) != null else return false;
                return lexer.nccLexer.valid(materialState(session)) &&
                    field(materialAst(session), A_ERROR) == 0;
            }

            materialLexerError(session >> p<byte>) -> int {
                guard session != null else return 0;
                return lexer.nccLexer.errorKind(materialState(session));
            }

            materialParserError(session >> p<byte>) -> int {
                guard session != null else return 0;
                guard materialAst(session) != null else return 0;
                return field(materialAst(session), A_ERROR);
            }

            materialErrorLine(session >> p<byte>) -> int {
                guard session != null else return 0;
                if (materialLexerError(session) != 0) {
                    return lexer.nccLexer.errorLine(materialState(session));
                }
                guard materialAst(session) != null else return 0;
                return field(materialAst(session), A_ERROR_LINE);
            }

            materialErrorColumn(session >> p<byte>) -> int {
                guard session != null else return 0;
                if (materialLexerError(session) != 0) {
                    return lexer.nccLexer.errorColumn(materialState(session));
                }
                guard materialAst(session) != null else return 0;
                return field(materialAst(session), A_ERROR_COLUMN);
            }

            materialNodeCount(session >> p<byte>) -> int {
                guard session != null else return 0;
                guard materialAst(session) != null else return 0;
                return field(materialAst(session), A_COUNT);
            }

            materialNodeKind(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_KIND);
            }

            materialNodeParent(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_PARENT);
            }

            materialNodeLine(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_LINE);
            }

            materialNodeColumn(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_COLUMN);
            }

            materialNodeNameHash(session >> p<byte>, index >> int) -> int {
                item >> p<byte> <- node(materialAst(session), index);
                value >> int <- field(item, N_NAME_HASH);
                tag >> int <- field(item, N_KIND);
                if (value == 0 && (tag == AST_FUNCTION_DECL || tag == AST_VALUE_DECL ||
                    tag == AST_FIELD_DECL || tag == AST_PARAMETER_DECL || tag == AST_EXPR_NAME ||
                    tag == AST_TYPE_NAME))
                    return lexer.nccLexer.wordHashAt(materialState(session), field(item, 56));
                return value;
            }

            materialNodeRoleHash(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_ROLE_HASH);
            }

            materialNodeFirstToken(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_FIRST_TOKEN);
            }

            materialNodeEndToken(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_END_TOKEN);
            }

            materialNodeFirstChild(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_FIRST_CHILD);
            }

            materialNodeNextSibling(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_NEXT_SIBLING);
            }

            materialNodeTypeHash(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_TYPE_HASH);
            }

            materialNodeFlags(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), N_FLAGS);
            }

            materialTokenKind(session >> p<byte>, index >> int) -> int {
                return lexer.nccLexer.tokenKindAt(materialState(session), index);
            }

            materialTokenName(session >> p<byte>, index >> int) -> str {
                return lexer.nccLexer.tokenNameAt(materialState(session), index);
            }

            materialTokenHash(session >> p<byte>, index >> int) -> int {
                return lexer.nccLexer.tokenHashAt(materialState(session), index);
            }

            materialIdentityHash(session >> p<byte>, index >> int) -> int {
                state >> p<byte> <- materialState(session);
                value >> int <- lexer.nccLexer.wordHashAt(state, index);
                return value != 0 ? value : lexer.nccLexer.tokenHashAt(state, index);
            }

            materialIdentityBytes(session >> p<byte>, index >> int) -> int {
                state >> p<byte> <- materialState(session);
                if (lexer.nccLexer.pathSegmentKind(lexer.nccLexer.tokenKindAt(state, index)))
                    return lexer.nccLexer.tokenEndAt(state, index) - lexer.nccLexer.tokenStartAt(state, index);
                return lexer.nccLexer.tokenBytesAt(state, index);
            }

            materialIdentityData(session >> p<byte>, index >> int) -> p<byte> {
                state >> p<byte> <- materialState(session);
                return lexer.nccLexer.pathSegmentKind(lexer.nccLexer.tokenKindAt(state, index)) ?
                    lexer.nccLexer.tokenDataAt(state, index) : lexer.nccLexer.tokenPayloadAt(state, index);
            }

            materialIdentitiesEqual(session >> p<byte>, left >> int, right >> int) -> bool {
                bytes >> int <- materialIdentityBytes(session, left);
                if (bytes != materialIdentityBytes(session, right) ||
                    materialIdentityHash(session, left) != materialIdentityHash(session, right)) return false;
                a >> p<byte> <- materialIdentityData(session, left);
                b >> p<byte> <- materialIdentityData(session, right);
                at >> int <- 0;
                while (at < bytes) {
                    if (rd<byte>(off(a, at)) != rd<byte>(off(b, at))) return false;
                    at += 1;
                }
                return true;
            }

            materialTokenData(session >> p<byte>, index >> int) -> p<byte> {
                return lexer.nccLexer.tokenDataAt(materialState(session), index);
            }

            materialTokenPayload(session >> p<byte>, index >> int) -> p<byte> {
                return lexer.nccLexer.tokenPayloadAt(materialState(session), index);
            }

            materialTokenStart(session >> p<byte>, index >> int) -> int {
                return lexer.nccLexer.tokenStartAt(materialState(session), index);
            }

            materialTokenEnd(session >> p<byte>, index >> int) -> int {
                return lexer.nccLexer.tokenEndAt(materialState(session), index);
            }

            materialNodeOrigin(session >> p<byte>, index >> int) -> int {
                return field(node(materialAst(session), index), 56);
            }

            materialNodeName(session >> p<byte>, index >> int) -> str {
                return kindName(materialNodeKind(session, index));
            }

            materialTreeValid(session >> p<byte>) -> bool {
                guard materialReady(session) else return false;
                return ast_arena.nccAstArena.validate(materialAst(session));
            }

            materialTokenBytes(session >> p<byte>, index >> int) -> int {
                return lexer.nccLexer.tokenBytesAt(materialState(session), index);
            }

            materialTokenCount(session >> p<byte>) -> int {
                return lexer.nccLexer.tokenCount(materialState(session));
            }

            materialTokenLine(session >> p<byte>, index >> int) -> int {
                return lexer.nccLexer.tokenLineAt(materialState(session), index);
            }

            materialTokenColumn(session >> p<byte>, index >> int) -> int {
                return lexer.nccLexer.tokenColumnAt(materialState(session), index);
            }

            materialTokenSame(session >> p<byte>, index >> int, value >> str) -> bool {
                return lexer.nccLexer.tokenSame(materialState(session), index, value);
            }

            materialTokensEqual(session >> p<byte>, left >> int, right >> int) -> bool {
                return lexer.nccLexer.tokenEqual(materialState(session), left, right);
            }

            parseFile(path >> str, json >> bool, quiet >> bool) -> int {
                state >> p<byte> <- lexer.nccLexer.openFile(path);
                guard state != null else {
                    println("error[E_NCC_BOOTSTRAP_SOURCE_001]: source cannot be read");
                    return 66;
                }
                if (!lexer.nccLexer.valid(state)) {
                    code >> int <- diagnostics.nccDiagnostics.emitDiagnostic(
                        lexer.nccLexer.errorKind(state), lexer.nccLexer.errorLine(state),
                        lexer.nccLexer.errorColumn(state), path);
                    lexer.nccLexer.close(state);
                    return code;
                }
                ast >> p<byte> <- build(state);
                guard ast != null else { lexer.nccLexer.close(state); return 70; }
                error >> int <- field(ast, A_ERROR);
                code >> int <- error == 0 ? 0 : diagnostics.nccDiagnostics.emitParser(
                    error, field(ast, A_ERROR_LINE), field(ast, A_ERROR_COLUMN), path);
                if (code == 0 && !quiet) emitAst(ast, lexer.nccLexer.tokenCount(state), json);
                releaseAst(ast);
                lexer.nccLexer.close(state);
                return code;
            }

            checkFile(
                path >> str,
                expectedNodes >> int,
                expectedImports >> int,
                expectedContainers >> int,
                expectedSections >> int
            ) -> int {
                state >> p<byte> <- lexer.nccLexer.openFile(path);
                guard state != null else return 66;
                if (!lexer.nccLexer.valid(state)) {
                    code >> int <- diagnostics.nccDiagnostics.emitDiagnostic(
                        lexer.nccLexer.errorKind(state), lexer.nccLexer.errorLine(state),
                        lexer.nccLexer.errorColumn(state), path);
                    lexer.nccLexer.close(state);
                    return code;
                }
                ast >> p<byte> <- build(state);
                guard ast != null else { lexer.nccLexer.close(state); return 70; }
                error >> int <- field(ast, A_ERROR);
                code >> int <- error == 0 ? 0 : diagnostics.nccDiagnostics.emitParser(
                    error, field(ast, A_ERROR_LINE), field(ast, A_ERROR_COLUMN), path);
                if (code == 0 && (field(ast, A_COUNT) != expectedNodes ||
                    countKind(ast, AST_USE_GROUP) != expectedImports ||
                    countKind(ast, AST_CONTAINER) != expectedContainers ||
                    sectionCount(ast) != expectedSections)) {
                    code <- diagnostics.nccDiagnostics.emitAstShape(path);
                }
                releaseAst(ast);
                lexer.nccLexer.close(state);
                return code;
            }

            checkDeclarations(
                path >> str,
                expectedNodes >> int,
                expectedDeclarations >> int,
                expectedParameters >> int,
                expectedEntries >> int
            ) -> int {
                state >> p<byte> <- lexer.nccLexer.openFile(path);
                guard state != null else return 66;
                if (!lexer.nccLexer.valid(state)) {
                    code >> int <- diagnostics.nccDiagnostics.emitDiagnostic(
                        lexer.nccLexer.errorKind(state), lexer.nccLexer.errorLine(state),
                        lexer.nccLexer.errorColumn(state), path);
                    lexer.nccLexer.close(state);
                    return code;
                }
                ast >> p<byte> <- build(state);
                guard ast != null else { lexer.nccLexer.close(state); return 70; }
                error >> int <- field(ast, A_ERROR);
                code >> int <- error == 0 ? 0 : diagnostics.nccDiagnostics.emitParser(
                    error, field(ast, A_ERROR_LINE), field(ast, A_ERROR_COLUMN), path);
                if (code == 0 && (field(ast, A_COUNT) != expectedNodes ||
                    declarationCount(ast) != expectedDeclarations ||
                    countKind(ast, AST_PARAMETER_DECL) != expectedParameters ||
                    countKind(ast, AST_ENTRY_REF) != expectedEntries)) {
                    code <- diagnostics.nccDiagnostics.emitAstShape(path);
                }
                releaseAst(ast);
                lexer.nccLexer.close(state);
                return code;
            }

            checkMaterial(
                path >> str,
                expectedNodes >> int,
                expectedTypes >> int,
                expectedExpressions >> int
            ) -> int {
                state >> p<byte> <- lexer.nccLexer.openFile(path);
                guard state != null else return 66;
                if (!lexer.nccLexer.valid(state)) {
                    code >> int <- diagnostics.nccDiagnostics.emitDiagnostic(
                        lexer.nccLexer.errorKind(state), lexer.nccLexer.errorLine(state),
                        lexer.nccLexer.errorColumn(state), path);
                    lexer.nccLexer.close(state);
                    return code;
                }
                ast >> p<byte> <- build(state);
                guard ast != null else { lexer.nccLexer.close(state); return 70; }
                error >> int <- field(ast, A_ERROR);
                code >> int <- error == 0 ? 0 : diagnostics.nccDiagnostics.emitParser(
                    error, field(ast, A_ERROR_LINE), field(ast, A_ERROR_COLUMN), path);
                if (code == 0 && (field(ast, A_COUNT) != expectedNodes ||
                    typeNodeCount(ast) != expectedTypes ||
                    expressionNodeCount(ast) != expectedExpressions)) {
                    code <- diagnostics.nccDiagnostics.emitAstShape(path);
                }
                releaseAst(ast);
                lexer.nccLexer.close(state);
                return code;
            }

            checkStatements(
                path >> str,
                expectedNodes >> int,
                expectedStatements >> int,
                expectedExpressions >> int
            ) -> int {
                state >> p<byte> <- lexer.nccLexer.openFile(path);
                guard state != null else return 66;
                if (!lexer.nccLexer.valid(state)) {
                    code >> int <- diagnostics.nccDiagnostics.emitDiagnostic(
                        lexer.nccLexer.errorKind(state), lexer.nccLexer.errorLine(state),
                        lexer.nccLexer.errorColumn(state), path);
                    lexer.nccLexer.close(state);
                    return code;
                }
                ast >> p<byte> <- build(state);
                guard ast != null else { lexer.nccLexer.close(state); return 70; }
                error >> int <- field(ast, A_ERROR);
                code >> int <- error == 0 ? 0 : diagnostics.nccDiagnostics.emitParser(
                    error, field(ast, A_ERROR_LINE), field(ast, A_ERROR_COLUMN), path);
                if (code == 0 && (field(ast, A_COUNT) != expectedNodes ||
                    statementNodeCount(ast) != expectedStatements ||
                    expressionNodeCount(ast) != expectedExpressions)) {
                    code <- diagnostics.nccDiagnostics.emitAstShape(path);
                }
                releaseAst(ast);
                lexer.nccLexer.close(state);
                return code;
            }

            checkAdvanced(
                path >> str,
                expectedNodes >> int,
                expectedAdvanced >> int,
                expectedExpressions >> int,
                expectedStatements >> int
            ) -> int {
                state >> p<byte> <- lexer.nccLexer.openFile(path);
                guard state != null else return 66;
                if (!lexer.nccLexer.valid(state)) {
                    code >> int <- diagnostics.nccDiagnostics.emitDiagnostic(
                        lexer.nccLexer.errorKind(state), lexer.nccLexer.errorLine(state),
                        lexer.nccLexer.errorColumn(state), path);
                    lexer.nccLexer.close(state);
                    return code;
                }
                ast >> p<byte> <- build(state);
                guard ast != null else { lexer.nccLexer.close(state); return 70; }
                error >> int <- field(ast, A_ERROR);
                code >> int <- error == 0 ? 0 : diagnostics.nccDiagnostics.emitParser(
                    error, field(ast, A_ERROR_LINE), field(ast, A_ERROR_COLUMN), path);
                if (code == 0 && (field(ast, A_COUNT) != expectedNodes ||
                    advancedNodeCount(ast) != expectedAdvanced ||
                    expressionNodeCount(ast) != expectedExpressions ||
                    statementNodeCount(ast) != expectedStatements)) {
                    code <- diagnostics.nccDiagnostics.emitAstShape(path);
                }
                releaseAst(ast);
                lexer.nccLexer.close(state);
                return code;
            }

    fa:
        return true;
}
