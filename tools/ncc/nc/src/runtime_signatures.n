showCursor|0|0|bool||;terminal|windowClose|1|0|bool|int|;terminal|windowDpi|1|0|int|int|;terminal|windowFocus|1|0|bool|int|;terminal|windowHeight|1|0|int|int|;terminal|windowHide|1|0|bool|int|;terminal|windowIsFocused|1|0|bool|int|;terminal|windowIsOpen|1|0|bool|int|;terminal|windowOpen|3|0|int|str~int~int|;terminal|windowPoll|1|0|bool|int|;terminal|windowRefreshHz|1|0|int|int|;terminal|windowSetSize|3|0|bool|int~int~int|;terminal|windowSetState|2|0|bool|int~int|;terminal|windowSetTitle|2|0|bool|int~str|;terminal|windowShow|1|0|bool|int|;terminal|windowState|1|0|int|int|;terminal|windowWaitEvent|2|0|bool|int~int|;";
                if (part == 14) return "terminal|windowWidth|1|0|int|int|;text|textContains|2|0|bool|str~str|;text|textIsEmpty|1|0|bool|str|;text|textLength|1|0|int|str|;text|textRelease|1|0|bool|str|;text|textReplace|3|0|str|str~str~str|;text|textSplit|2|0|array<str>|str~str|;text|textSplitRelease|1|0|bool|ptr<byte>|;text|textTrim|1|0|str|str|;thread|threadId|0|0|int||;thread|threadJoin|1|0|Result<any, ThreadError>|any|;thread|threadJoinTimeout|2|0|Result<any, ThreadError>|any~int|;thread|threadLocalCreate|1|0|Result<ThreadLocalHandle, ThreadError>|any|;thread|threadLocalGet|1|0|Result<any, ThreadError>|any|;thread|threadLocalRemove|1|0|Result<bool, ThreadError>|any|;thread|threadLocalSet|2|0|Result<bool, ThreadError>|any~any|;thread|threadSleep|1|0|void|int|;thread|threadSpawn|1|0|Result<ThreadHandle, ThreadError>|any|;time|date|0|0|str||;time|dateInto|2|0|int|ptr<byte>~u64|;time|formatTime|1|0|str|int|;time|formatTimeInto|3|0|int|int~ptr<byte>~u64|;time|monotonicMs|0|0|int||;time|monotonicNs|0|0|int||;time|now|0|0|int||;time|nowMs|0|0|int||;time|sleep|1|0|void|int|;time|sleepUntilMs|1|0|bool|int|;time|timeRelease|1|0|bool|str|;time|timestamp|0|0|int||;timer|timeout|1|0|Result<FutureHandle, AsyncError>|int|;timer|timerReset|1|0|Result<bool, AsyncError>|any|;timer|timerStart|0|0|Result<TimerHandle, AsyncError>||;timer|timerStop|1|0|Result<int, AsyncError>|any|;tls|tlsClose|1|0|bool|any|;tls|tlsConnect|3|0|result|str~any~any|;tls|tlsPeerCert|1|0|result|any|;tls|tlsRecv|3|0|result|any~any~any|;tls|tlsSend|2|0|result|any~any|;trace|traceClear|2|0|bool|addr~int|;trace|traceCopy|4|0|bool|addr~int~addr~int|;trace|traceId|2|0|int|addr~int|;trace|traceKind|2|0|int|addr~int|;trace|traceParent|2|0|int|addr~int|;trace|tracePayload|2|0|addr|addr~int|;trace|tracePayloadBytes|2|0|int|addr~int|;trace|traceStride|0|0|int||;trace|traceTick|2|0|int|addr~int|;trace|traceValue|2|0|int|addr~int|;trace|traceWrite|9|0|bool|addr~int~int~int~int~int~addr~int~int|;truncate|truncate|2|0|str|str~int|;truncate|truncateEnd|2|0|str|str~int|;truncate|truncateMiddle|2|0|str|str~int|;truncate|truncateRelease|1|0|bool|str|;tts|connect|1|0|bool|str|;tts|disconnect|0|0|bool||;tts|isSpeaking|0|0|bool||;tts|speak|1|0|bool|str|;tts|stop|0|0|bool||;udp|udpBind|1|0|result|any|;udp|udpBindOn|2|0|result|str~any|;udp|udpClose|1|0|bool|any|;udp|udpPort|1|0|result|any|;";
                if (part == 15) return "udp|udpRecvFrom|3|0|result|any~any~any|;udp|udpSendTo|4|0|result|any~str~any~any|;udp|udpSetNonBlocking|2|0|result|any~bool|;udp|udpSetTimeout|3|0|result|any~any~any|;unicode|graphemeCount|1|0|int|str|;unicode|graphemeSlice|3|0|str|str~int~int|;unicode|isValidUtf8|1|0|bool|str|;unicode|normalizeNfc|1|0|str|str|;unicode|normalizeNfd|1|0|str|str|;unicode|normalizeNfkc|1|0|str|str|;unicode|normalizeNfkd|1|0|str|str|;unicode|normalizeUnicode|1|0|str|str|;unicode|stripInvalidUnicode|1|0|str|str|;unicode|supportsGrapheme|0|0|bool||;unicode|unicodeMode|0|0|str||;unicode|unicodeRelease|1|0|bool|str|;user|userBuffer|1|0|addr|int|;user|userCheckMembership|3|0|bool|addr~addr~addr|;user|userClose|1|0|bool|addr|;user|userCreateWellKnownSid|4|0|bool|int~addr~addr~addr|;user|userCurrentProcess|0|0|addr||;user|userDuplicateToken|3|0|bool|addr~int~addr|;user|userFree|1|0|bool|addr|;user|userImpersonate|1|0|bool|addr|;user|userLastError|0|0|int||;user|userLoadProfile|2|0|bool|addr~addr|;user|userName|2|0|bool|addr~addr|;user|userNameEx|3|0|bool|int~addr~addr|;user|userOpenProcessToken|3|0|bool|addr~int~addr|;user|userProfileDirectory|3|0|bool|addr~addr~addr|;user|userRevert|0|0|bool||;user|userSetThreadToken|2|0|bool|addr~addr|;user|userTokenInformation|5|0|bool|addr~int~addr~int~addr|;user|userUnloadProfile|2|0|bool|addr~addr|;uuid|isUuid|1|0|bool|str|;uuid|uuidFromBytes|1|0|str|array<byte,16>|;uuid|uuidFromBytesInto|3|0|int|ptr<byte>~ptr<byte>~u64|;uuid|uuidRelease|1|0|bool|str|;uuid|uuidV4|0|0|str||;uuid|uuidV4Into|2|0|int|ptr<byte>~u64|;validate|validateAligned|2|0|bool|addr~int|;validate|validateAscii|2|0|bool|addr~int|;validate|validateEqual|4|0|bool|addr~int~addr~int|;validate|validateLength|3|0|bool|int~int~int|;validate|validateMask|3|0|bool|int~int~int|;validate|validateNotNull|1|0|bool|addr|;validate|validatePowerOfTwo|1|0|bool|int|;validate|validateRange|3|0|bool|int~int~int|;validate|validateUtf8|2|0|bool|addr~int|;validate|validateZero|2|0|bool|addr~int|;width|ansiVisibleWidth|1|0|int|str|;width|byteLength|1|0|int|str|;width|charCount|1|0|int|str|;width|displayWidth|1|0|int|str|;width|graphemeCount|1|0|int|str|;wrap|indent|2|0|str|str~int|;wrap|wrap|2|0|str|str~int|;wrap|wrapRelease|1|0|bool|str|;wrap|wrapWords|2|0|str|str~int|;";
                return "";
            }

            rawByte(data >> p<byte>, at >> int) -> int {
                return rd<byte>(off(data, at));
            }

            textBytes(value >> str) -> int {
                data >> p<byte> <- cast<byte>(value);
                at >> int <- 0;
                while (rawByte(data, at) != 0) {
                    at += 1;
                }
                return at;
            }

            endOf(data >> p<byte>, at >> int, delimiter >> int) -> int {
                while (rawByte(data, at) != 0 && rawByte(data, at) != delimiter) {
                    at += 1;
                }
                return at;
            }

            sliceSame(data >> p<byte>, start >> int, count >> int, value >> str) -> bool {
                wanted >> p<byte> <- cast<byte>(value);
                if (textBytes(value) != count) return false;
                at >> int <- 0;
                while (at < count) {
                    if (rawByte(data, start + at) != rawByte(wanted, at)) return false;
                    at += 1;
                }
                return true;
            }

            tokenSame(material >> p<byte>, token >> int, data >> p<byte>,
                start >> int, count >> int) -> bool {
                if (parser_ast.nccParserAst.materialTokenBytes(material, token) != count) {
                    return false;
                }
                wanted >> p<byte> <- parser_ast.nccParserAst.materialTokenData(material, token);
                at >> int <- 0;
                while (at < count) {
                    if (rawByte(data, start + at) != rawByte(wanted, at)) return false;
                    at += 1;
                }
                return true;
            }

            decimal(data >> p<byte>, start >> int, end >> int) -> int {
                value >> int <- 0;
                at >> int <- start;
                while (at < end) {
                    value <- value * 10 + rawByte(data, at) - 48;
                    at += 1;
                }
                return value;
            }

            sliceHash(data >> p<byte>, start >> int, count >> int) -> int {
                hash >> int <- 17;
                at >> int <- 0;
                while (at < count) {
                    hash <- (hash * 31 + rawByte(data, start + at)) % 10000019;
                    at += 1;
                }
                return hash;
            }

            typeClass(data >> p<byte>, start >> int, count >> int) -> int {
                if (sliceSame(data, start, count, "void")) return TY_VOID;
                if (sliceSame(data, start, count, "bool")) return TY_BOOL;
                if (sliceSame(data, start, count, "char")) return TY_CHAR;
                if (sliceSame(data, start, count, "addr")) return TY_ADDRESS;
                if (sliceSame(data, start, count, "str") ||
                    sliceSame(data, start, count, "string") ||
                    sliceSame(data, start, count, "text")) return TY_STRING;
                if (sliceSame(data, start, count, "ft") ||
                    sliceSame(data, start, count, "ft32") ||
                    sliceSame(data, start, count, "ft64") ||
                    sliceSame(data, start, count, "f32") ||
                    sliceSame(data, start, count, "f64") ||
                    sliceSame(data, start, count, "float")) return TY_FLOAT;
                if (sliceSame(data, start, count, "int") ||
                    sliceSame(data, start, count, "uint") ||
                    sliceSame(data, start, count, "byte") ||
                    sliceSame(data, start, count, "i8") ||
                    sliceSame(data, start, count, "u8") ||
                    sliceSame(data, start, count, "i16") ||
                    sliceSame(data, start, count, "u16") ||
                    sliceSame(data, start, count, "i32") ||
                    sliceSame(data, start, count, "u32") ||
                    sliceSame(data, start, count, "i64") ||
                    sliceSame(data, start, count, "u64") ||
                    sliceSame(data, start, count, "isize") ||
                    sliceSame(data, start, count, "usize") ||
                    sliceSame(data, start, count, "addr") ||
                    sliceSame(data, start, count, "qword")) return TY_INTEGER;
                if (count >= 2 && rawByte(data, start) == 112 &&
                    rawByte(data, start + 1) == 60) return TY_POINTER;
                if (count >= 4 && rawByte(data, start) == 112 &&
                    rawByte(data, start + 1) == 116 &&
                    rawByte(data, start + 2) == 114 &&
                    rawByte(data, start + 3) == 60) return TY_POINTER;
                if (count >= 5 && rawByte(data, start) == 97 &&
                    rawByte(data, start + 1) == 114 &&
                    rawByte(data, start + 2) == 114 &&
                    rawByte(data, start + 3) == 97 &&
                    rawByte(data, start + 4) == 121) return TY_ARRAY;
                if (count >= 2 && rawByte(data, start) == 102 &&
                    rawByte(data, start + 1) == 110) return TY_FUNCTION;
                if (sliceSame(data, start, count, "any") ||
                    sliceSame(data, start, count, "T") ||
                    sliceSame(data, start, count, "E") ||
                    sliceSame(data, start, count, "value")) return TY_UNKNOWN;
                return TY_NOMINAL;
            }

            familySame(material >> p<byte>, moduleToken >> int, itemToken >> int,
                data >> p<byte>, start >> int, count >> int) -> bool {
                if (tokenSame(material, itemToken, data, start, count)) return true;
                if (parser_ast.nccParserAst.materialTokenSame(material, moduleToken, "math") &&
                    parser_ast.nccParserAst.materialTokenSame(material, itemToken, "core") &&
                    sliceSame(data, start, count, "math")) return true;
                if (parser_ast.nccParserAst.materialTokenSame(material, moduleToken, "mobile") &&
                    parser_ast.nccParserAst.materialTokenSame(material, itemToken, "network") &&
                    sliceSame(data, start, count, "mobilenetwork")) return true;
                if (parser_ast.nccParserAst.materialTokenSame(material, itemToken, "tts_engine") &&
                    sliceSame(data, start, count, "tts")) return true;
                if (parser_ast.nccParserAst.materialTokenSame(material, itemToken, "permissions") &&
                    sliceSame(data, start, count, "permission")) return true;
                return false;
            }

            put(out >> p<int>, index >> int, value >> int) -> void {
                wr<int>(off(out, index), value);
            }

            clear(out >> p<int>) -> void {
                at >> int <- 0;
                while (at < DESCRIPTOR_INTS) {
                    put(out, at, 0);
                    at += 1;
                }
            }

            parseArguments(data >> p<byte>, start >> int, end >> int, out >> p<int>) -> int {
                if (start == end) return 0;
                count >> int <- 0;
                at >> int <- start;
                while (at <= end && count < DESCRIPTOR_INTS - D_TYPES) {
                    next >> int <- at;
                    while (next < end && rawByte(data, next) != 126) {
                        next += 1;
                    }
                    put(out, D_TYPES + count, typeClass(data, at, next - at));
                    count += 1;
                    if (next >= end) return count;
                    at <- next + 1;
                }
                return count;
            }

            inspectRow(material >> p<byte>, moduleToken >> int, itemToken >> int,
                functionToken >> int, arguments >> int, data >> p<byte>, part >> int,
                row >> int, out >> p<int>) -> int {
                familyEnd >> int <- endOf(data, row, 124);
                nameStart >> int <- familyEnd + 1;
                nameEnd >> int <- endOf(data, nameStart, 124);
                arityStart >> int <- nameEnd + 1;
                arityEnd >> int <- endOf(data, arityStart, 124);
                variadicStart >> int <- arityEnd + 1;
                variadicEnd >> int <- endOf(data, variadicStart, 124);
                returnStart >> int <- variadicEnd + 1;
                returnEnd >> int <- endOf(data, returnStart, 124);
                argsStart >> int <- returnEnd + 1;
                argsEnd >> int <- endOf(data, argsStart, 124);
                genericsStart >> int <- argsEnd + 1;
                rowEnd >> int <- endOf(data, genericsStart, 59);

                if (!familySame(material, moduleToken, itemToken, data, row,
                    familyEnd - row)) return rowEnd + 1;
                if (!tokenSame(material, functionToken, data, nameStart,
                    nameEnd - nameStart)) return rowEnd + 1;

                minimum >> int <- decimal(data, arityStart, arityEnd);
                isVariadic >> bool <- rawByte(data, variadicStart) == 49;
                if ((!isVariadic && arguments != minimum) ||
                    (isVariadic && arguments < minimum)) return -(rowEnd + 2);

                clear(out);
                put(out, D_ARITY, minimum);
                put(out, D_VARIADIC, isVariadic ? 1 : 0);
                put(out, D_RETURN, typeClass(data, returnStart, returnEnd - returnStart));
                put(out, D_ARGUMENTS, parseArguments(data, argsStart, argsEnd, out));
                put(out, D_FINGERPRINT, sliceHash(data, row, rowEnd - row));
                put(out, D_FAMILY_PART, part);
                put(out, D_FAMILY_OFFSET, row);
                put(out, D_FAMILY_BYTES, familyEnd - row);
                return 0;
            }

        public:
            descriptorBytes() -> int { return DESCRIPTOR_INTS * 4; }
            arity(out >> p<int>) -> int { return rd<int>(off(out, D_ARITY)); }
            variadic(out >> p<int>) -> bool { return rd<int>(off(out, D_VARIADIC)) != 0; }
            returnClass(out >> p<int>) -> int { return rd<int>(off(out, D_RETURN)); }
            argumentCount(out >> p<int>) -> int { return rd<int>(off(out, D_ARGUMENTS)); }
            argumentClass(out >> p<int>, index >> int) -> int {
                guard index >= 0 && index < argumentCount(out) else return TY_UNKNOWN;
                return rd<int>(off(out, D_TYPES + index));
            }
            signatureFingerprint(out >> p<int>) -> int {
                return rd<int>(off(out, D_FINGERPRINT));
            }
            familyData(out >> p<int>) -> p<byte> {
                return off(cast<byte>(table(rd<int>(off(out, D_FAMILY_PART)))),
                    rd<int>(off(out, D_FAMILY_OFFSET)));
            }
            familyBytes(out >> p<int>) -> int {
                return rd<int>(off(out, D_FAMILY_BYTES));
            }

            resolve(material >> p<byte>, moduleToken >> int, itemToken >> int,
                functionToken >> int, arguments >> int, out >> p<int>) -> int {
                seen >> bool <- false;
                part >> int <- 0;
                while (part < SHARDS) {
                    data >> p<byte> <- cast<byte>(table(part));
                    row >> int <- 0;
                    while (rawByte(data, row) != 0) {
                        result >> int <- inspectRow(material, moduleToken, itemToken,
                            functionToken, arguments, data, part, row, out);
                        if (result == 0) return 1;
                        if (result < 0) {
                            seen <- true;
                            row <- -result - 1;
                        } else {
                            row <- result;
                        }
                    }
                    part += 1;
                }
                return seen ? -1 : 0;
            }

            known(material >> p<byte>, functionToken >> int) -> bool {
                part >> int <- 0;
                while (part < SHARDS) {
                    data >> p<byte> <- cast<byte>(table(part));
                    row >> int <- 0;
                    while (rawByte(data, row) != 0) {
                        familyEnd >> int <- endOf(data, row, 124);
                        nameStart >> int <- familyEnd + 1;
                        nameEnd >> int <- endOf(data, nameStart, 124);
                        if (tokenSame(material, functionToken, data, nameStart,
                            nameEnd - nameStart)) return true;
                        row <- endOf(data, nameEnd + 1, 59) + 1;
                    }
                    part += 1;
                }
                return false;
            }

            signatureCount() -> int {
                count >> int <- 0;
                part >> int <- 0;
                while (part < SHARDS) {
                    data >> p<byte> <- cast<byte>(table(part));
                    at >> int <- 0;
                    while (rawByte(data, at) != 0) {
                        if (rawByte(data, at) == 59) count += 1;
                        at += 1;
                    }
                    part += 1;
                }
                return count;
            }

            familyCount() -> int {
                count >> int <- 0;
                previousHash >> int <- -1;
                previousBytes >> int <- -1;
                part >> int <- 0;
                while (part < SHARDS) {
                    data >> p<byte> <- cast<byte>(table(part));
                    row >> int <- 0;
                    while (rawByte(data, row) != 0) {
                        familyEnd >> int <- endOf(data, row, 124);
                        bytes >> int <- familyEnd - row;
                        hash >> int <- sliceHash(data, row, bytes);
                        if (hash != previousHash || bytes != previousBytes) {
                            count += 1;
                            previousHash <- hash;
                            previousBytes <- bytes;
                        }
                        row <- endOf(data, familyEnd + 1, 59) + 1;
                    }
                    part += 1;
                }
                return count;
            }

            fingerprint() -> int {
                hash >> int <- 17;
                part >> int <- 0;
                while (part < SHARDS) {
                    data >> p<byte> <- cast<byte>(table(part));
                    at >> int <- 0;
                    while (rawByte(data, at) != 0) {
                        hash <- (hash * 31 + rawByte(data, at)) % 10000019;
                        at += 1;
                    }
                    part += 1;
                }
                return hash;
            }

            selfTest() -> bool {
                return signatureCount() == SIGNATURES && familyCount() == FAMILIES &&
                    fingerprint() == FINGERPRINT;
            }

            report() -> int {
                ok >> bool <- selfTest();
                print("{\"schema\":\"nc.bootstrap.runtime-signatures.v1\",");
                print("\"families\":"); print(renderInt(familyCount()));
                print(",\"signatures\":"); print(renderInt(signatureCount()));
                print(",\"fingerprint\":"); print(renderInt(fingerprint()));
                print(",\"status\":\""); print(ok ? "ok" : "invalid"); println("\"}");
                return ok ? 0 : 1;
            }

            check(expectedFamilies >> int, expectedSignatures >> int,
                expectedFingerprint >> int) -> int {
                ok >> bool <- familyCount() == expectedFamilies &&
                    signatureCount() == expectedSignatures &&
                    fingerprint() == expectedFingerprint && selfTest();
                if (!ok) {
                    return diagnostics.nccDiagnostics.emitRuntimeSignatureShape();
                }
                return 0;
            }

    fa:
        return true;
}
