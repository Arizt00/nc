use <project:ir>;

nccMctValues {
    fn:
        private:
            scopeKind(kind >> int) -> bool {
                return kind == 1 || kind == 3 || kind == 13 || kind == 15 ||
                    kind == 34 || kind == 47 || kind == 52;
            }

            declaration(kind >> int) -> bool {
                return kind == 10 || kind == 12 || kind == 14 || kind == 15 || kind == 16;
            }

            inScope(graph >> p<byte>, owner >> int, reference >> int) -> int {
                found >> int <- -1;
                cursor >> int <- ir.nccIr.graphNodeFirstChild(graph,owner);
                while (cursor >= 0) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph,cursor);
                    if (declaration(kind) && scope(graph,cursor) == owner &&
                        ir.nccIr.graphNodeNameEqual(graph,cursor,reference)) {
                        before >> bool <- ir.nccIr.graphNodeLine(graph,cursor) <
                            ir.nccIr.graphNodeLine(graph,reference) ||
                            (ir.nccIr.graphNodeLine(graph,cursor) == ir.nccIr.graphNodeLine(graph,reference) &&
                                ir.nccIr.graphNodeColumn(graph,cursor) < ir.nccIr.graphNodeColumn(graph,reference));
                        ownerKind >> int <- ir.nccIr.graphNodeAstKind(graph,owner);
                        if ((ownerKind == 1 || ownerKind == 3 || kind == 16 || before) && cursor > found)
                            found <- cursor;
                    }
                    child >> int <- ir.nccIr.graphNodeFirstChild(graph,cursor);
                    if (!scopeKind(kind) && child >= 0) cursor <- child;
                    else {
                        while (cursor >= 0 && cursor != owner && ir.nccIr.graphNodeNextSibling(graph,cursor) < 0) {
                            cursor <- ir.nccIr.graphNodeParent(graph,cursor);
                        }
                        if (cursor == owner || cursor < 0) break;
                        cursor <- ir.nccIr.graphNodeNextSibling(graph,cursor);
                    }
                }
                return found;
            }

        internal:
            scope(graph >> p<byte>, node >> int) -> int {
                node <- ir.nccIr.graphNodeParent(graph, node);
                while (node >= 0) {
                    if (scopeKind(ir.nccIr.graphNodeAstKind(graph, node))) return node;
                    node <- ir.nccIr.graphNodeParent(graph, node);
                }
                return -1;
            }

            resolve(graph >> p<byte>, node >> int) -> int {
                if (node >= 0 && ir.nccIr.graphNodeAstKind(graph,node) == 30) {
                    at >> int <- 0;
                    found >> int <- -1;
                    while (at < ir.nccIr.graphNodes(graph)) {
                        if ((ir.nccIr.graphNodeAstKind(graph,at) == 15 ||
                            (ir.nccIr.graphNodeAstKind(graph,at) == 12 &&
                                ir.nccIr.graphNodeAstKind(graph,scope(graph,at)) == 3)) &&
                            ir.nccIr.graphNodeNameEqual(graph,at,node) &&
                            ir.nccIr.graphNodeOwnerEqual(graph,at,node)) {
                            if (found >= 0) return -1;
                            found <- at;
                        }
                        at += 1;
                    }
                    return found;
                }
                owner >> int <- scope(graph, node);
                while (owner >= 0) {
                    found >> int <- inScope(graph,owner,node);
                    if (found >= 0) return found;
                    owner <- scope(graph, owner);
                }
                return -1;
            }

            isConstant(graph >> p<byte>, node >> int) -> bool {
                guard node >= 0 else return false;
                if (ir.nccIr.graphNodeAstKind(graph, node) == 10) return true;
                guard ir.nccIr.graphNodeAstKind(graph, node) == 12 else return false;
                owner >> int <- ir.nccIr.graphNodeParent(graph, node);
                return owner >= 0 && ir.nccIr.graphNodeAstKind(graph, owner) == 4;
            }

            initializer(graph >> p<byte>, node >> int) -> int {
                child >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                while (child >= 0) {
                    kind >> int <- ir.nccIr.graphNodeAstKind(graph, child);
                    if (kind >= 25 && kind <= 33 || kind == 45 || kind == 47 || kind == 50) return child;
                    child <- ir.nccIr.graphNodeNextSibling(graph, child);
                }
                return -1;
            }

            status(table >> p<byte>, node >> int) -> int {
                return node < 0 ? 0 : rd<int>(off(table, node * 8));
            }

            value(table >> p<byte>, node >> int) -> int {
                return rd<int>(off(table, node * 8 + 4));
            }

            evaluate(graph >> p<byte>, table >> p<byte>, node >> int, depth >> int) -> bool {
                guard node >= 0 && depth < 256 else return false;
                old >> int <- status(table, node);
                if (old == 2) return true;
                if (old == 1 || old == -1) { wr<int>(off(table, node * 8), -1); return false; }
                if (old == 3) return false;
                wr<int>(off(table, node * 8), 1);
                kind >> int <- ir.nccIr.graphNodeAstKind(graph, node);
                op >> int <- ir.nccIr.graphNodeRoleHash(graph, node);
                result >> int <- 0;
                known >> bool <- false;
                first >> int <- ir.nccIr.graphNodeFirstChild(graph, node);
                if (kind == 25 && (op == 2 || op == 4 || op == 76 || op == 77)) {
                    result <- ir.nccIr.graphNodeIntegerLiteral(graph, node);
                    known <- true;
                    data >> p<byte> <- ir.nccIr.graphNodeName(graph,node);
                    bytes >> int <- ir.nccIr.graphNodeNameBytes(graph,node);
                    decimal >> bool <- bytes < 2 || rd(data) != 48 ||
                        (rd(off(data,1)) != 120 && rd(off(data,1)) != 88 &&
                         rd(off(data,1)) != 98 && rd(off(data,1)) != 66 &&
                         rd(off(data,1)) != 111 && rd(off(data,1)) != 79);
                    scan >> int <- 0;
                    while (op == 2 && decimal && scan < bytes) {
                        digit >> byte <- rd(off(data,scan));
                        if (digit == 46 || digit == 101 || digit == 69) known <- false;
                        scan += 1;
                    }
                }
                else if (kind == 26) {
                    target >> int <- resolve(graph, node);
                    if (isConstant(graph, target)) {
                        child >> int <- initializer(graph, target);
                        known <- evaluate(graph, table, child, depth + 1);
                        if (known) result <- value(table, child);
                        else if (status(table, child) == -1) wr<int>(off(table, node * 8), -1);
                    }
                }
                else if (kind == 27 && (op == 35 || op == 38 || op == 33 || op == 34)) {
                    known <- evaluate(graph, table, first, depth + 1);
                    if (known) {
                        result <- value(table, first);
                        if (op == 38) result <- -result;
                        if (op == 33) result <- result == 0 ? 1 : 0;
                        if (op == 34) result <- ~result;
                    }
                }
                else if (kind == 28 && evaluate(graph, table, first, depth + 1)) {
                    left >> int <- value(table, first);
                    second >> int <- ir.nccIr.graphNodeNextSibling(graph, first);
                    if (op == 48 && left == 0 || op == 49 && left != 0) {
                        result <- op == 49 ? 1 : 0;
                        known <- true;
                    }
                    else if (evaluate(graph, table, second, depth + 1)) {
                        right >> int <- value(table, second);
                        known <- true;
                        if (op == 35) result <- left + right;
                        else if (op == 38) result <- left - right;
                        else if (op == 18) result <- left * right;
                        else if (op == 41 || op == 42) {
                            if (right == 0 || (left == -2147483647 - 1 && right == -1)) known <- false;
                            else result <- op == 41 ? left / right : left % right;
                        }
                        else if (op == 31) result <- left == right ? 1 : 0;
                        else if (op == 32) result <- left != right ? 1 : 0;
                        else if (op == 26) result <- left > right ? 1 : 0;
                        else if (op == 27) result <- left < right ? 1 : 0;
                        else if (op == 28) result <- left >= right ? 1 : 0;
                        else if (op == 29) result <- left <= right ? 1 : 0;
                        else if (op == 43) result <- left & right;
                        else if (op == 25) result <- left | right;
                        else if (op == 44) result <- left ^ right;
                        else if (op == 48 || op == 49) result <- right != 0 ? 1 : 0;
                        else if (op == 46 && right >= 0 && right < 32) result <- left << right;
                        else if (op == 21 && right >= 0 && right < 32) result <- left >> right;
                        else known <- false;
                    }
                }
                else if (kind == 32 && evaluate(graph, table, first, depth + 1)) {
                    selected >> int <- ir.nccIr.graphNodeNextSibling(graph, first);
                    if (value(table, first) == 0) selected <- ir.nccIr.graphNodeNextSibling(graph, selected);
                    known <- evaluate(graph, table, selected, depth + 1);
                    if (known) result <- value(table, selected);
                }
                if (status(table, node) != -1) wr<int>(off(table, node * 8), known ? 2 : 3);
                if (known) wr<int>(off(table, node * 8 + 4), result);
                return known;
            }

            create(graph >> p<byte>) -> p<byte> {
                bytes >> int <- ir.nccIr.graphNodes(graph) * 8;
                table >> p<byte> <- cast<byte>(alloc(bytes));
                guard table != null else return null;
                at >> int <- 0;
                while (at < bytes) { wr<byte>(off(table, at), 0); at += 1; }
                at <- 0;
                while (at < ir.nccIr.graphNodes(graph)) {
                    evaluate(graph, table, at, 0);
                    at += 1;
                }
                return table;
            }

            knownAncestor(graph >> p<byte>, table >> p<byte>, node >> int) -> bool {
                owner >> int <- ir.nccIr.graphNodeParent(graph, node);
                while (owner >= 0) {
                    if (status(table, owner) == 2) return true;
                    owner <- ir.nccIr.graphNodeParent(graph, owner);
                }
                return false;
            }
    fa:
        return true;
}
