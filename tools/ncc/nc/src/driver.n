                    if (same(action, "sema-types")) {
                        guard argsCount(arguments) >= 4 else { argsRelease(arguments); return 64; }
                        code >> int <- type_contract_sema.nccTypeContractSema.analyzeFile(
                            argsAt(arguments,3),hasFlag(arguments,"--json"),hasFlag(arguments,"--quiet"));
                        argsRelease(arguments); return code;
                    }
                    if (same(action, "sema")) {
                        code >> int <- semaCommand(arguments, false);
                        argsRelease(arguments);
                        return code;
