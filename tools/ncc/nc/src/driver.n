                if (same(command, "emit-executable")) {
                    code >> int <- imageCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-symbol-bundle")) {
                    code >> int <- symbolBundleCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-debug-unwind")) {
                    code >> int <- debugUnwindCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-platform-debug")) {
                    code >> int <- platformDebugCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-native-unwind")) {
                    code >> int <- nativeUnwindCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-llvm-optimization")) {
                    code >> int <- llvmOptimizationCommand(arguments);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-llvm-transform")) {
                    code >> int <- llvmTransformCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-pdb")) {
                    code >> int <- pdbCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "project")) {
                    code >> int <- projectCommand(arguments);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "compiler") && argsCount(arguments) > 2) {
                    action >> str <- argsAt(arguments, 2);
                    if (same(action, "tokens")) {
                        code >> int <- tokenCommand(arguments, false);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "outline")) {
                        code >> int <- outlineCommand(arguments, false);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "ast-head")) {
                        code >> int <- astHeadCommand(arguments, false);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "type-contracts")) {
                        if (argsCount(arguments) < 4) { argsRelease(arguments); return 64; }
                        code >> int <- type_contract_report.nccTypeContractReport.parseFile(argsAt(arguments, 3));
                        argsRelease(arguments); return code;
                    }
                    if (same(action, "ast-head-check")) {
                        code >> int <- astHeadCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "ast-decl-check")) {
                        code >> int <- astDeclarationCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "ast-material-check")) {
                        code >> int <- astMaterialCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "ast-statement-check")) {
                        code >> int <- astStatementCheckCommand(arguments);
                        argsRelease(arguments);
