                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-ir")) {
                    code >> int <- irCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "emit-mct")) {
                    code >> int <- mctCommand(arguments, true);
                    argsRelease(arguments);
                    return code;
                }
                if (same(command, "mct-link-readiness")) {
