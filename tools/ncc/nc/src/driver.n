                        return code;
                    }
                    if (same(action, "emit-pdb")) {
                        code >> int <- pdbCommand(arguments, false);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "pdb-check")) {
                        code >> int <- pdbCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "project-check")) {
                        code >> int <- projectCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "project-mct-readiness-check")) {
                        code >> int <- projectMctReadinessCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "relocation-check")) {
                        code >> int <- relocationCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "mct-target-check")) {
                        code >> int <- mctTargetCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    code >> int <- diagnostics.nccDiagnostics.stage0Required(action);
                    argsRelease(arguments);
                    return code;
                }

                code >> int <- diagnostics.nccDiagnostics.stage0Required(command);
                argsRelease(arguments);
                return code;
            }

    fa:
        return true;
}
