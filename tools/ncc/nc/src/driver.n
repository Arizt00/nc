                    if (same(action, "sema-imports-check")) {
                        code >> int <- semaImportsCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "sema-authority")) {
                        code >> int <- semaImportsCommand(arguments, false);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "sema-authority-check")) {
                        code >> int <- semaAuthorityCheckCommand(arguments);
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "runtime-signatures")) {
                        code >> int <- runtime_signatures.nccRuntimeSignatures.report();
                        argsRelease(arguments);
                        return code;
                    }
                    if (same(action, "runtime-signatures-check")) {
                        code >> int <- runtimeSignatureCheckCommand(arguments, false);
                        argsRelease(arguments);
                        return code;
