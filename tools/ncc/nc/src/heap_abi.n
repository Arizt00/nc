nccHeapAbi {
    fn:
        internal:
            resolve(name >> p<byte>, bytes >> int) -> int {
                guard name != null else return 0;
                if (bytes == 5 && rd(name) == 97 && rd(off(name,1)) == 108 &&
                    rd(off(name,2)) == 108 && rd(off(name,3)) == 111 && rd(off(name,4)) == 99) return 1;
                if (bytes == 6 && rd(name) == 99 && rd(off(name,1)) == 97 &&
                    rd(off(name,2)) == 108 && rd(off(name,3)) == 108 && rd(off(name,4)) == 111 && rd(off(name,5)) == 99) return 2;
                if (bytes == 7 && rd(name) == 114 && rd(off(name,1)) == 101 &&
                    rd(off(name,2)) == 97 && rd(off(name,3)) == 108 && rd(off(name,4)) == 108 &&
                    rd(off(name,5)) == 111 && rd(off(name,6)) == 99) return 3;
                if (bytes == 4 && rd(name) == 102 && rd(off(name,1)) == 114 &&
                    rd(off(name,2)) == 101 && rd(off(name,3)) == 101) return 4;
                return 0;
            }
            arity(id >> int) -> int { return id == 2 || id == 3 ? 2 : (id == 1 || id == 4 ? 1 : -1); }
            pointerArgument(id >> int, index >> int) -> bool { return index == 0 && (id == 3 || id == 4); }
            resultCode(id >> int) -> int { return id == 4 ? 33 : (id > 0 && id < 4 ? 8 : -1); }
            ownerData() -> p<byte> { return cast<byte>("heap"); }
            ownerBytes() -> int { return 4; }
    fa:
        return true;
}
