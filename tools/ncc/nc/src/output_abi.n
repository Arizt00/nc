nccOutputAbi {
    fn:
        internal:
            same(data >> p<byte>, bytes >> int, text >> str, count >> int) -> bool {
                if (data == null || bytes != count) return false;
                at >> int <- 0;
                while (at < bytes) {
                    if (rd(off(data,at)) != rd<byte>(off(cast<byte>(text),at))) return false;
                    at += 1;
                }
                return true;
            }
            resolve(name >> p<byte>, bytes >> int, owner >> p<byte>, ownerBytes >> int) -> int {
                if (same(owner,ownerBytes,"render",6)) {
                    if (same(name,bytes,"renderInt",9)) return 10;
                    if (same(name,bytes,"renderBool",10)) return 11;
                    if (same(name,bytes,"renderChar",10)) return 12;
                    if (same(name,bytes,"renderStr",9)) return 13;
                    return 0;
                }
                if (!same(owner,ownerBytes,"output",6)) return 0;
                if (same(name,bytes,"print",5)) return 1;
                if (same(name,bytes,"println",7)) return 2;
                if (same(name,bytes,"flush",5)) return 3;
                return 0;
            }
            validArity(id >> int, count >> int) -> bool {
                if (id >= 10 && id <= 13) return count == 1;
                return id == 1 ? count == 1 : (id == 2 ? count == 0 || count == 1 : id == 3 && count == 0);
            }
            machineArity(id >> int) -> int { return id >= 10 && id <= 13 ? 1 : (id == 3 ? 0 : 2); }
            resultCode(id >> int) -> int { return id >= 10 && id <= 13 ? 34 : (id == 3 ? 33 : (id == 1 || id == 2 ? 0 : -1)); }
            argumentCode(id >> int) -> int { return id == 10 ? 20 : (id == 11 ? 33 : (id == 12 ? 35 : (id == 13 ? 34 : -1))); }
            valueTag(code >> int, character >> bool, pointer >> bool) -> int {
                if (code == 34) return 5;
                if (code == 33) return 3;
                if (character || code == 35) return 4;
                if (pointer) return 6;
                if (code == 1 || code == 2 || code == 4 || code == 8) return 1;
                if (code == 17 || code == 18 || code == 20 || code == 24) return 2;
                return -1;
            }
    fa: return true;
}
