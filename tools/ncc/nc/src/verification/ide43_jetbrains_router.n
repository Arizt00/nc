use <data:json>;
use <io:output, erroroutput>;
use <process:args, env>;
use <project:release_io, tool_cli, cert_json, ide43_core>;

ide43JetbrainsRouter {
    fn:
        private:
            negativeNumber(value >> str) -> bool {
                if (!strStartsWith(value,"-") || strByteLen(value) < 2) return false;
                data >> p<byte> <- cast(value); index >> int <- 1; dot >> bool <- false; digits >> int <- 0;
                while (index < strByteLen(value)) {
                    byte >> int <- rd(off(data,index));
                    if (byte == 46 && !dot) { dot <- true; if (index+1 == strByteLen(value)) return false; }
                    else if (byte >= 48 && byte <= 57) digits += 1;
                    else return false;
                    index += 1;
                }
                return digits > 0;
            }
            parseOptions(arguments >> addr) -> int {
                result >> int <- jsonNewObject(); index >> int <- 2;
                while (index < argsCount(arguments)) {
                    name >> str <- argsAt(arguments,index);
                    equal >> int <- strIndexOf(name,"="); supplied >> bool <- equal >= 0; explicitValue >> str <- "";
                    if (supplied) { explicitValue <- strSubstring(name,equal+1,strByteLen(name)-equal-1); name <- strSubstring(name,0,equal); }
                    if (strStartsWith(name,"--") && strByteLen(name) >= 3) {
                        if (strStartsWith("--file",name)) name <- "--file";
                        else if (strStartsWith("--ncup",name)) name <- "--ncup";
                        else if (strStartsWith("--json",name)) name <- "--json";
                        else if (strStartsWith("--help",name)) name <- "--help";
                    }
                    if (name == "--json" || name == "--help" || name == "-h") {
                        if (supplied) { jsonRelease(result); return 0; }
                        cert_json.certJson.put(result,name,jsonNewBool(true));
                        if (name == "--help" || name == "-h") return result;
                        index += 1; continue;
                    }
                    key >> str <- name; value >> str <- "";
                    if (supplied) {
                        if (name != "--file" && name != "--ncup") { jsonRelease(result); return 0; }
                        value <- explicitValue; index += 1;
                    } else {
                        if ((name != "--file" && name != "--ncup") || index+1 >= argsCount(arguments)) { jsonRelease(result); return 0; }
                        value <- argsAt(arguments,index+1);
                        if (strStartsWith(value,"-") && value != "-" && !negativeNumber(value)) { jsonRelease(result); return 0; }
                        index += 2;
                    }
                    cert_json.certJson.put(result,key,jsonNewString(value));
                }
                return result;
            }
            lexicalFile(value >> str) -> str {
                forward >> str <- envHas("WINDIR") ? release_io.releaseIo.forwardPath(value) : strSubstring(value,0,strByteLen(value)); data >> p<byte> <- cast(forward);
                result >> str <- strStartsWith(forward,"//") && !strStartsWith(forward,"///") ? "//" : (strStartsWith(forward,"/") ? "/" : "");
                start >> int <- 0; index >> int <- 0;
                while (index <= strByteLen(forward)) {
                    if (index == strByteLen(forward) || rd(off(data,index)) == 47) {
                        part >> str <- strSubstring(forward,start,index-start);
                        if (part != "" && part != ".") result <- result+(result != "" && !strEndsWith(result,"/") ? "/" : "")+part;
                        strRelease(part); start <- index+1;
                    }
                    index += 1;
                }
                strRelease(forward);
                if (result == "") result <- ".";
                if (envHas("WINDIR")) {
                    result <- strSubstring(result,0,strByteLen(result));
                    data <- cast(result); index <- 0;
                    while (index < strByteLen(result)) { if (rd(off(data,index)) == 47) wr(off(data,index),92); index += 1; }
                }
                return result;
            }
            utf8Width(data >> p<byte>, size >> int, index >> int) -> int {
                first >> int <- rd(off(data,index)) & 255;
                if (first < 128) return 1;
                count >> int <- first >= 194 && first <= 223 ? 2 : (first >= 224 && first <= 239 ? 3 : (first >= 240 && first <= 244 ? 4 : 0));
                if (count == 0 || count > size-index) return 0;
                next >> int <- rd(off(data,index+1)) & 255;
                if ((first == 224 && next < 160) || (first == 237 && next >= 160) ||
                    (first == 240 && next < 144) || (first == 244 && next >= 144)) return 0;
                at >> int <- 1;
                while (at < count) { byte >> int <- rd(off(data,index+at)) & 255; if (byte < 128 || byte > 191) return 0; at += 1; }
                return count;
            }
            headText(content >> str, size >> int) -> str {
                // Same validated scalar bounds as lexerVerifierBytes.width; preserve UTF-8 errors=ignore and text newline mode.
                input >> p<byte> <- cast(content); output >> p<byte> <- cast(alloc(32769));
                if (output == null) return "";
                index >> int <- 0; written >> int <- 0; characters >> int <- 0;
                while (index < size && characters < 8192) {
                    width >> int <- utf8Width(input,size,index);
                    if (width == 0) { index += 1; continue; }
                    byte >> int <- rd(off(input,index));
                    if (byte == 13) {
                        wr(off(output,written),10); written += 1; index += 1;
                        if (index < size) { if (rd(off(input,index)) == 10) index += 1; }
                    } else {
                        at >> int <- 0;
                        while (at < width) {
                            byte <- rd(off(input,index+at)); wr(off(output,written),byte == 0 ? 1 : byte); written += 1; at += 1;
                        }
                        index += width;
                    }
                    characters += 1;
                }
                wr(off(output,written),0); headBuffer >> str <- cast(output); result >> str <- strSubstring(headBuffer,0,written); free(output); return result;
            }
            joined(words >> int) -> str {
                result >> str <- ""; index >> int <- 0;
                while (index < jsonArrayLen(words)) {
                    word >> int <- jsonArrayGet(words,index); result <- result+(index == 0 ? "" : " ")+jsonStringView(word,"");
                    jsonRelease(word); index += 1;
                }
                return result;
            }
            resolvedPath(value >> str) -> str {
                buffer >> p<byte> <- cast(alloc(32768)); if (buffer == null) return "";
                size >> int <- officialPathInto(value == "" ? "." : value,buffer,32767);
                if (size < 0 || size >= 32767) { free(buffer); return tool_cli.toolCli.absolute(value); }
                wr(off(buffer,size),0); rawPath >> str <- cast(buffer); result >> str <- strSubstring(rawPath,0,size); free(buffer);
                if (strStartsWith(result,"\\\\?\\UNC\\")) return "\\\\"+strSubstring(result,8,strByteLen(result)-8);
                if (strStartsWith(result,"\\\\?\\")) return strSubstring(result,4,strByteLen(result)-4);
                return result;
            }
            lowExtension(file >> str) -> bool {
                data >> p<byte> <- cast(file); start >> int <- 0; index >> int <- 0;
                if (envHas("WINDIR") && strByteLen(file) >= 2) { if (rd(off(data,1)) == 58) start <- 2; }
                while (index < strByteLen(file)) {
                    if (rd(off(data,index)) == 47 || (envHas("WINDIR") && rd(off(data,index)) == 92)) start <- index+1;
                    index += 1;
                }
                name >> str <- strToLower(strSubstring(file,start,strByteLen(file)-start));
                return (strByteLen(name) > 3 && (strEndsWith(name,".nb") || strEndsWith(name,".nm"))) ||
                    (strByteLen(name) > 4 && strEndsWith(name,".ncp"));
            }
        public:
            execute(arguments >> addr) -> int {
                options >> int <- parseOptions(arguments);
                if (options == 0) { eprintln("route-jetbrains: invalid arguments"); return 2; }
                if (tool_cli.toolCli.hasFlag(options,"--help") || tool_cli.toolCli.hasFlag(options,"-h")) {
                    println("route-jetbrains --file FILE [--ncup EXE] [--json]"); jsonRelease(options); return 0;
                }
                if (!jsonObjectHas(options,"--file")) { eprintln("route-jetbrains: --file is required"); jsonRelease(options); return 2; }
                file >> str <- lexicalFile(tool_cli.toolCli.value(options,"--file",""));
                if (release_io.releaseIo.fileType(file) != 1) { eprintln("missing file: "+file); jsonRelease(options); return 1; }
                size >> int <- fsSize(file);
                if (size < 0 || size > 134217728) { jsonRelease(options); return 1; }
                data >> p<byte> <- cast(alloc(size+1));
                if (data == null) { jsonRelease(options); return 1; }
                if (fsReadInto(file,data,size) != size) { free(data); jsonRelease(options); return 1; }
                wr(off(data,size),0); content >> str <- cast(data); head >> str <- headText(content,size);
                free(cast<byte>(content));
                words >> int <- ide43_core.ide43Core.list("which|ncc|--json");
                jsonArrayInsert(words,0,jsonNewString(tool_cli.toolCli.value(options,"--ncup","ncup")));
                row >> int <- tool_cli.toolCli.execute(words,"",30000); jsonRelease(words);
                if (!tool_cli.toolCli.hasFlag(row,"ok")) {
                    diagnostic >> str <- strTrim(release_io.releaseIo.field(row,"stderr"));
                    if (diagnostic == "") diagnostic <- strTrim(release_io.releaseIo.field(row,"stdout"));
                    eprintln(diagnostic == "" ? "ncup which ncc failed" : diagnostic);
                    jsonRelease(row); jsonRelease(options); strRelease(head); return 1;
                }
                which >> int <- jsonParse(release_io.releaseIo.field(row,"stdout")); jsonRelease(row);
                resolved >> int <- jsonObjectGet(which,"path");
                if (jsonKind(which) != 6 || jsonKind(resolved) != 4) {
                    eprintln("ncup which ncc: expected a JSON object with string path");
                    jsonRelease(resolved); jsonRelease(which); jsonRelease(options); strRelease(head); return 1;
                }
                path >> str <- resolvedPath(ide43_core.ide43Core.field(which,"path"));
                jsonRelease(resolved);
                if (path == "") { jsonRelease(which); jsonRelease(options); strRelease(head); return 1; }
                low >> bool <- lowExtension(file) ||
                    strContains(head,"primitive"+"[@]") || strContains(head,"[@"+ "machine]") || strContains(head,"[@]");
                directory >> str <- release_io.releaseIo.directory(path);
                command >> int <- jsonNewArray();
                if (low) { cert_json.certJson.push(command,jsonNewString("nc-sys-lsp")); cert_json.certJson.push(command,jsonNewString("lsp")); }
                else {
                    cert_json.certJson.push(command,jsonNewString(directory+(envHas("WINDIR") ? "\\" : "/")+"nclsp")); cert_json.certJson.push(command,jsonNewString("validate"));
                    cert_json.certJson.push(command,jsonNewString(file));
                    suffix >> int <- ide43_core.ide43Core.list("--profile|standard|--migration-stage|error-by-profile|--json"); index >> int <- 0;
                    while (index < jsonArrayLen(suffix)) { cert_json.certJson.push(command,jsonArrayGet(suffix,index)); index += 1; }
                    jsonRelease(suffix);
                }
                payload >> int <- jsonNewObject();
                cert_json.certJson.put(payload,"schema",jsonNewString("nc.jetbrains.lsp.route.v1"));
                cert_json.certJson.put(payload,"version",jsonNewString("1.0.0.21v"));
                cert_json.certJson.put(payload,"state",jsonNewString("frozen"));
                cert_json.certJson.put(payload,"semantic_authority",jsonNewString("ncc"));
                cert_json.certJson.put(payload,"professional_ide_parity",ide43_core.ide43Core.list("c|cpp|rust|java"));
                cert_json.certJson.put(payload,"file",jsonNewString(file));
                cert_json.certJson.put(payload,"low_level",jsonNewBool(low));
                cert_json.certJson.put(payload,"backend",jsonNewString(low ? "nc-sys-lsp" : "nclsp"));
                cert_json.certJson.put(payload,"toolchain_id",jsonObjectHas(which,"toolchain_id") ? jsonObjectGet(which,"toolchain_id") : jsonNewNull());
                cert_json.certJson.put(payload,"toolchain_source",jsonObjectHas(which,"source") ? jsonObjectGet(which,"source") : jsonNewNull());
                cert_json.certJson.put(payload,"ncc_path",jsonNewString(path));
                cert_json.certJson.put(payload,"bin_dir",jsonNewString(directory));
                cert_json.certJson.put(payload,"command",jsonClone(command));
                if (tool_cli.toolCli.hasFlag(options,"--json")) println(cert_json.certJson.stringify(payload));
                else { println("backend="+ide43_core.ide43Core.field(payload,"backend")); println("ncc="+path); println("cmd="+joined(command)); }
                jsonRelease(command); jsonRelease(which); jsonRelease(payload); jsonRelease(options); strRelease(head); return 0;
            }
    fa: return true;
}

