            count(kind >> int) -> int { return kind == 0 ? 1433 : (kind == 1 ? 174 : (kind == 2 ? 491 : 711)); }
            table(kind >> int) -> p<byte> {
                saved >> addr <- kind == 0 ? lowerTable : (kind == 1 ? casedTable : (kind == 2 ? ignoredTable : printableTable));
                if (cast<byte>(saved) != null) return cast(saved);
                data >> p<byte> <- cast(calloc(count(kind)*3,sizeOf(int))); guard data != null else return null;
                part >> int <- 0; filled >> int <- 0;
                while (filled < count(kind)) {
                    model >> int <- jsonParse(rows(kind,part)); at >> int <- 0;
                    while (at < jsonArrayLen(model)) {
                        row >> int <- jsonArrayBorrow(model,at); col >> int <- 0;
                        while (col < jsonArrayLen(row)) { value >> int <- jsonArrayBorrow(row,col); wr<int>(off(data,(filled*3+col)*sizeOf(int)),jsonGetInt(value)); jsonRelease(value); col += 1; }
                        jsonRelease(row); filled += 1; at += 1;
                    }
                    jsonRelease(model); part += 1;
                }
                if (kind == 0) lowerTable <- adr(data); else if (kind == 1) casedTable <- adr(data); else if (kind == 2) ignoredTable <- adr(data); else printableTable <- adr(data);
                return data;
            }
            index(kind >> int, code >> int) -> int {
                data >> p<byte> <- table(kind); if (data == null) return -1;
                left >> int <- 0; right >> int <- count(kind)-1;
                while (left <= right) {
                    mid >> int <- (left+right)/2; first >> int <- rd<int>(off(data,mid*3*sizeOf(int)));
                    last >> int <- kind == 0 ? first : rd<int>(off(data,(mid*3+1)*sizeOf(int)));
                    if (code < first) right <- mid-1; else if (code > last) left <- mid+1; else return mid;
                }
                return -1;
            }
            scalar(code >> int) -> str {
                data >> p<byte> <- cast(alloc(5)); guard data != null else return "";
                size >> int <- 1; first >> int <- 0; second >> int <- 0; third >> int <- 0; fourth >> int <- 0;
                if (code < 128) wr(data,code);
                else if (code < 2048) { size <- 2; first <- 192+(code >>> 6); second <- 128+(code & 63); wr(data,first); wr(off(data,1),second); }
                else if (code < 65536) { size <- 3; first <- 224+(code >>> 12); second <- 128+((code >>> 6) & 63); third <- 128+(code & 63); wr(data,first); wr(off(data,1),second); wr(off(data,2),third); }
