use <io:output>;
use <process:args>;
use <project:editor_industrial, editor_rpc, editor_tests_v42>;

editorCli {
    fn:
        public:
            dispatch(arguments >> addr) -> int {
                if (argsCount(arguments) < 2) { println("ncc-tools: editor-industrial, editor-lsp-smoke"); return 2; }
                command >> str <- argsAt(arguments,1);
                if (command == "--help" || command == "-h") { println("ncc-tools: editor-industrial, editor-lsp-smoke"); return 0; }
                if (command == "editor-industrial") return editor_industrial.editorIndustrial.execute(arguments);
                if (command == "editor-lsp-smoke") return editor_rpc.editorRpc.execute(arguments);
                if (command == "editor-lsp-relay") return editor_rpc.editorRpc.relay(arguments);
                if (command == "editor-self-test") return editor_tests_v42.editorTestsV42.selfTest(arguments);
                if (command == "editor-fixture-v42") return editor_tests_v42.editorTestsV42.fixture(arguments);
                println("Unknown editor command: "+command); return 2;
            }
    fa: return true;
}
