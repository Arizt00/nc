use <process:args>;
use <io:erroroutput>;
use <project:physical43_common, physical43_exact, physical43_portable, physical43_primitive, physical43_final>;

physical43Cli {
    fn:
        public:
            execute(arguments >> addr, command >> str) -> int {
                physical43_common.physical43Common.reset();
                if (command == "exact-head-evidence" || command == "exact_head_evidence.py") return physical43_exact.physical43Exact.execute(arguments);
                if (command == "portable-hypervisor-iommu" || command == "verify_portable_hypervisor_iommu_evidence.py") return physical43_portable.physical43Portable.execute(arguments);
                if (command == "primitive-release-evidence" || command == "verify_primitive_release_evidence_v2_0_0.py") return physical43_primitive.physical43Primitive.execute(arguments);
                if (command == "certify-final-pipeline" || command == "certify_final_pipeline.py" || command == "certify-raw-optimizer" || command == "certify_raw_optimizer.py") return physical43_final.physical43Final.execute(arguments);
                eprintln("unknown physical43 command: "+command); return 2;
            }
    fa: return true;
}
