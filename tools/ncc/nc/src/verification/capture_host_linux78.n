captureHost78 {
    fn:
      public:
    open(path >> str) -> addr {
        fd >> i64 <- syscall6(257,-100,adr(path),0x800C1,384,0,0);
        if (fd < 0) return null;
        duplicate >> i64 <- syscall6(72,fd,1030,3,0,0,0);
        syscall6(3,fd,0,0,0,0,0);
        return duplicate < 0 ? null : from<byte>(duplicate+1);
    }
    close(handle >> addr) -> bool { return syscall6(3,adr(handle)-1,0,0,0,0,0) == 0; }
    fa: return true;
}
