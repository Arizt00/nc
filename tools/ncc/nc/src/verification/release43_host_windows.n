        c symbol "FindFirstFileW" { abi: C; header: "windows.h"; library: "kernel32"; linkage: dynamic; layout: stable; ownership: borrowed; sideEffects: writesMemory; signature: fn(addr,addr) -> addr; }
        c symbol "FindNextFileW" { abi: C; header: "windows.h"; library: "kernel32"; linkage: dynamic; layout: stable; ownership: borrowed; sideEffects: writesMemory; signature: fn(addr,addr) -> i32; }
        c symbol "FindClose" { abi: C; header: "windows.h"; library: "kernel32"; linkage: dynamic; layout: stable; ownership: borrowed; sideEffects: writesMemory; signature: fn(addr) -> i32; }
