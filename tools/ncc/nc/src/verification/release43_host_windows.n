    fn:
        private:
            unsigned(value >> int) -> u32 { return value; }
            invalid(handle >> addr) -> bool { return handle == null || handle == cast<addr>(-1); }
            nativePath(path >> str) -> p<u16> {
                input >> p<u16> <- utf16(path); data >> p<u16> <- cast(alloc(65536)); if (input == null || data == null) { free(input); free(data); return null; }
                count >> u32 <- GetFullPathNameW(adr(input),32768,adr(data),null); free(input);
                if (count == 0 || count >= 32760) { free(data); return null; }
                full >> str <- utf8(data); free(data);
