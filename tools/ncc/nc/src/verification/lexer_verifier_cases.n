use <data:json>;
use <project:frontend_session, lexer_verifier_bytes, release_io, sha256>;

lexerVerifierCases {
    const:
        CATALOG_HASH >> str <- "ee4bee62c8ec5d7051021f0555bb3d8b13466f74e76b284fa7b6a17c31d541fb";
    fn:
        private:
            entry(paths >> int, path >> str, onlyNative >> bool) -> void {
                row >> int <- jsonNewObject();
                value >> int <- jsonNewString(path); jsonObjectSet(row,"path",value); jsonRelease(value);
                value <- jsonNewBool(onlyNative); jsonObjectSet(row,"native_only",value); jsonRelease(value);
                jsonArrayPush(paths,row); jsonRelease(row);
            }
        public:
            generate() -> int {
                paths >> int <- jsonNewArray();
                root >> str <- frontend_session.frontendSession.rootPath();
                catalogHash >> str <- sha256.nccSha256.file(root+"/bootstrap/lexer-v42-cases.json");
                frontend_session.frontendSession.check(catalogHash == CATALOG_HASH,"frozen-fixture-catalog"); strRelease(catalogHash);
                if(!frontend_session.frontendSession.good()) return paths;
                catalog >> int <- jsonParseFile(root+"/bootstrap/lexer-v42-cases.json");
                cases >> int <- jsonObjectBorrow(catalog,"cases");
                frontend_session.frontendSession.check(jsonArrayLen(cases) == 97,"lexer-fixture-inventory");
                source >> str <- lexer_verifier_bytes.lexerVerifierBytes.text(catalog,"stage0_catalog_source");
                hash >> str <- sha256.nccSha256.file(root+"/"+source);
                frontend_session.frontendSession.check(hash == lexer_verifier_bytes.lexerVerifierBytes.text(catalog,"stage0_catalog_sha256"),"stage0-keyword-catalog-unchanged");
                strRelease(hash);
                index >> int <- 0;
                while (index < jsonArrayLen(cases) && frontend_session.frontendSession.good()) {
                    row >> int <- jsonArrayBorrow(cases,index);
                    name >> str <- lexer_verifier_bytes.lexerVerifierBytes.text(row,"name");
                    text >> str <- lexer_verifier_bytes.lexerVerifierBytes.text(row,"hex");
                    field >> int <- jsonObjectBorrow(row,"bytes"); size >> int <- jsonGetInt(field); jsonRelease(field);
                    valid >> bool <- size >= 0 && size <= 1048576 && strByteLen(text) == size*2 &&
                        !strContains(name,"/") && !strContains(name,"\\") && strEndsWith(name,".n");
                    frontend_session.frontendSession.check(valid,"fixture-metadata-"+name);
                    if (!valid) { jsonRelease(row); break; }
                    bytes >> p<byte> <- cast(alloc(size+1));
                    if (bytes == null) { frontend_session.frontendSession.check(false,"fixture-allocation"); jsonRelease(row); break; }
                    encoded >> p<byte> <- cast(text); at >> int <- 0;
                    while (at < size && valid) {
                        hi >> int <- lexer_verifier_bytes.lexerVerifierBytes.hex(rd(off(encoded,at*2)));
                        lo >> int <- lexer_verifier_bytes.lexerVerifierBytes.hex(rd(off(encoded,at*2+1)));
                        valid <- hi >= 0 && lo >= 0;
                        if (valid) wr(off(bytes,at),hi*16+lo);
                        at += 1;
                    }
                    path >> str <- frontend_session.frontendSession.outputPath()+"/cases/"+name;
                    frontend_session.frontendSession.check(valid && fsWriteFrom(path,bytes,size,false) == size,"write-"+name);
                    free(bytes);
                    actual >> str <- sha256.nccSha256.file(path);
                    frontend_session.frontendSession.check(actual == lexer_verifier_bytes.lexerVerifierBytes.text(row,"sha256"),"bytes-"+name);
                    strRelease(actual);
                    field <- jsonObjectBorrow(row,"native_only"); entry(paths,path,jsonGetBoolOr(field,false));
                    jsonRelease(field); jsonRelease(row);
                    index += 1;
                }
                jsonRelease(cases); jsonRelease(catalog);
                largeCase >> int <- 0;
                while (largeCase < 2 && frontend_session.frontendSession.good()) {
                    size >> int <- largeCase == 0 ? 20000 : 2097156;
                    bytes >> p<byte> <- cast(alloc(size));
                    if (bytes == null) { frontend_session.frontendSession.check(false,"large-fixture-allocation"); break; }
                    at >> int <- 0;
                    while (at < size) { wr(off(bytes,at),largeCase == 0 ? (at%2 == 0 ? 97 : 32) : 120); at += 1; }
                    if (largeCase == 1) { wr(bytes,47); wr(off(bytes,1),42); wr(off(bytes,size-2),42); wr(off(bytes,size-1),47); }
                    name >> str <- largeCase == 0 ? "growth.n" : "large-comment.n";
                    path >> str <- frontend_session.frontendSession.outputPath()+"/cases/"+name;
                    frontend_session.frontendSession.check(fsWriteFrom(path,bytes,size,false) == size,"write-"+name);
                    free(bytes); entry(paths,path,false); largeCase += 1;
                }
                return paths;
            }
            collect(paths >> int, root >> str, depth >> int) -> bool {
                if (depth > 128) return false;
                kind >> int <- release_io.releaseIo.fileType(root);
                if (kind == 1) { entry(paths,root,false); return true; }
                if (kind != 2) return false;
                names >> int <- release_io.releaseIo.names(root);
                if (jsonKind(names) != 5) return false;
                index >> int <- 0; ok >> bool <- true;
                while (index < jsonArrayLen(names) && ok) {
                    item >> int <- jsonArrayBorrow(names,index); name >> str <- jsonStringView(item,"");
                    path >> str <- root+"/"+name;
                    kind <- release_io.releaseIo.fileType(path);
                    if (kind == 2) ok <- collect(paths,path,depth+1);
                    else if (kind == 1 && strEndsWith(name,".n")) entry(paths,path,false);
                    jsonRelease(item); index += 1;
                }
                jsonRelease(names); return ok;
            }
    fa: return true;
}
