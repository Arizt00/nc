use <process:args>;
use <io:output>;
use <project:ide43_cli, ide43_jetbrains_router, ide_router>;
use <project:ide43_bundle, ide43_distribution>;

ide43Main {
    fn:
        run() -> int {
            arguments >> addr <- argsOpen();
            if (argsCount(arguments) < 2) { println("ide43: a command is required"); argsRelease(arguments); return 2; }
            command >> str <- argsAt(arguments,1); code >> int <- 2;
            if (command == "route-jetbrains") code <- ide43_jetbrains_router.ide43JetbrainsRouter.execute(arguments);
            else if (command == "ide43-bundle") code <- ide43_bundle.ide43Bundle.execute(arguments);
            else if (command == "ide43-distribution") code <- ide43_distribution.ide43Distribution.execute(arguments);
            else if (command == "route-vscode" || command == "route-ghidra") code <- ide_router.ideRouter.execute(arguments,command == "route-ghidra");
            else code <- ide43_cli.ide43Cli.execute(arguments,command);
            argsRelease(arguments); return code;
        }
    ref main ->> run;
    fa: return true;
}
