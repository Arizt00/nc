use <data:json>;
use <project:release_io, contract_checks>;

finalClosure {
    fn:
        public:
            inspect(root >> str, helpReady >> bool) -> int {
                checks >> int <- jsonNewObject();
                paths >> int <- jsonParse("[\"docs/spec/release/v2_0_0_phase10_final_closure_spec.md\",\"docs/spec/release/v2_0_0_phase10_final_closure_compatibility_spec.md\",\"docs/spec/release/v2_0_0_phase10_final_closure_contract.json\",\"docs/status/STATUS_PHASE10_punto19_final_closure_v2_0_0.md\",\"tools/ncc/nc/src/verification/final_closure.n\",\"tools/release/qa_phase10_p19_v2_0_0.sh\"]");
                contract_checks.contractChecks.record(checks,"artifacts_present",contract_checks.contractChecks.files(root,paths,true));
                jsonRelease(paths);
                contract >> int <- jsonParseFile(root+"/docs/spec/release/v2_0_0_phase10_final_closure_contract.json");
                gate >> str <- "release_phase10_final_closure_gate_tests";
                contract_checks.contractChecks.record(checks,"contract_consistent",contract_checks.contractChecks.contract(contract,"nc.phase10.final.closure.contract.v1",gate));
                reports >> int <- jsonObjectGet(contract,"required_reports");
                ready >> bool <- jsonKind(reports) == 5 && jsonArrayLen(reports) > 0;
                index >> int <- 0;
                while (index < jsonArrayLen(reports)) {
                    path >> int <- jsonArrayGet(reports,index);
                    report >> int <- jsonParseFile(root+"/"+jsonGetString(path));
                    if (!release_io.releaseIo.reportOk(report,false)) ready <- false;
                    jsonRelease(path); jsonRelease(report); index += 1;
                }
                contract_checks.contractChecks.record(checks,"required_reports_ok",ready);
                jsonRelease(reports); jsonRelease(contract);
                qa >> str <- release_io.releaseIo.text(root+"/tools/release/qa_phase10_v2_0_0.sh");
                contract_checks.contractChecks.record(checks,"qa_global_integrated",strContains(qa,"qa_phase10_p19_v2_0_0.sh"));
                train >> int <- jsonParseFile(root+"/docs/spec/release/v2_0_0_release_train_contract.json");
                installer >> int <- jsonParseFile(root+"/docs/spec/release/v2_0_0_phase10_installer_product_contract.json");
                artifact >> str <- "docs/spec/release/v2_0_0_phase10_final_closure_spec.md";
                contract_checks.contractChecks.record(checks,"release_train_integrated",contract_checks.contractChecks.integrated(train,gate,artifact,false));
                contract_checks.contractChecks.record(checks,"installer_contract_integrated",contract_checks.contractChecks.integrated(installer,gate,artifact,false));
                contract_checks.contractChecks.record(checks,"cli_help_accessible",helpReady);
                jsonRelease(train); jsonRelease(installer);
                return checks;
            }
    fa:
        return true;
}
