use <data:json>;
use <project:physical43_common, physical43_stages, release_io, sha256>;

physical43Routes {
    fn:
        private:
            get(model >> int, key >> str) -> str { return physical43_stages.physical43Stages.get(model,key); }
            set(model >> int, key >> str, value >> int) -> void { physical43_stages.physical43Stages.set(model,key,value); }
            add(model >> int, value >> int) -> void { physical43_stages.physical43Stages.add(model,value); }
            command(ncc >> str, tail >> str, source >> str) -> int { words >> int <- jsonParse(tail); jsonArrayInsert(words,0,jsonNewString(ncc)); add(words,jsonNewString(physical43_common.physical43Common.nativePath(source))); return words; }
        public:
            execution(route >> int, artifact >> str, runner >> str) -> int {
                mode >> str <- get(route,"execution"); expected >> str <- get(route,"runner"); arch >> str <- get(route,"architecture"); words >> int <- jsonNewArray();
                if ((mode == "native" || mode == "native-or-qemu-user") && runner == expected) { add(words,jsonNewString(artifact)); return words; }
                if (mode == "native-or-qemu-user") { qemu >> str <- arch == "i386" ? "qemu-i386" : (arch == "aarch64" ? "qemu-aarch64" : (arch == "riscv64" ? "qemu-riscv64" : "")); if (qemu != "" && physical43_common.physical43Common.available(qemu)) { add(words,jsonNewString(qemu)); add(words,jsonNewString(artifact)); return words; } }
                if (mode == "wasmtime" && physical43_common.physical43Common.available("wasmtime")) { add(words,jsonNewString("wasmtime")); add(words,jsonNewString(artifact)); } return words;
            }
            route(spec >> int, ncc >> str, repo >> str, software >> str, logs >> str, runner >> str) -> int {
                id >> str <- get(spec,"id"); source >> str <- physical43_common.physical43Common.joinPath(repo,get(spec,"source")); root >> str <- physical43_common.physical43Common.nativePath(software+"/routes/"+id); physical43_common.physical43Common.directories(root); stages >> int <- jsonNewArray();
                words >> int <- command(ncc,"[\"emit-ast\"]",source); add(stages,physical43_stages.physical43Stages.runStage("parser",id+"-parser",words,repo,logs,300)); jsonRelease(words);
                words <- command(ncc,"[\"check\"]",source); add(stages,physical43_stages.physical43Stages.runStage("sema",id+"-sema",words,repo,logs,300)); jsonRelease(words);
                words <- command(ncc,"[\"emit-ir\"]",source); add(stages,physical43_stages.physical43Stages.runStage("typed_ir",id+"-typed-ir",words,repo,logs,300)); jsonRelease(words);
                words <- command(ncc,"[\"build\"]",source); add(words,jsonNewString("--target")); add(words,jsonObjectGet(spec,"target")); add(words,jsonNewString("--profile")); add(words,jsonObjectGet(spec,"profile")); add(words,jsonNewString("--out-dir")); add(words,jsonNewString(root)); add(words,jsonNewString("--json")); add(stages,physical43_stages.physical43Stages.runStage("build",id+"-build",words,repo,logs,600)); jsonRelease(words);
                discovered >> int <- physical43_stages.physical43Stages.manifest(root,get(spec,"target")); payload >> int <- jsonObjectBorrow(discovered,"payload"); manifestPath >> str <- get(discovered,"path"); if (manifestPath != "") add(stages,physical43_stages.physical43Stages.oneFile("build",id+"-build-manifest",manifestPath,"build manifest is missing"));
                llvm >> int <- physical43_stages.physical43Stages.suffixFiles(root,".ll");
                if (jsonArrayLen(llvm) == 0 && get(spec,"architecture") == "wasm32") { path >> str <- physical43_common.physical43Common.nativePath(root+"/lowering/"+id+".certification.ll"); words <- command(ncc,"[\"mct\",\"emit-llvm\"]",source); add(words,jsonNewString("--out")); add(words,jsonNewString(path)); add(words,jsonNewString("--cc")); add(words,jsonNewString("nC.portable")); add(words,jsonNewString("--opt-level")); add(words,jsonNewString("3")); add(stages,physical43_stages.physical43Stages.runStage("llvm_ir",id+"-llvm-retain",words,repo,logs,300)); jsonRelease(words); if (physical43_common.physical43Common.fileType(path) == 1) add(llvm,jsonNewString(path)); }
                machine >> int <- physical43_stages.physical43Stages.suffixFiles(root,".nm"); add(stages,physical43_stages.physical43Stages.fileStage("llvm_ir",id+"-llvm-ir",llvm,"no non-empty LLVM IR emitted")); add(stages,physical43_stages.physical43Stages.fileStage("machine_ir",id+"-machine-ir",machine,"no non-empty .nm emitted"));
                if (jsonArrayLen(machine) > 0) { first >> int <- jsonArrayBorrow(machine,0); words <- command(ncc,"[\"machine\",\"check\"]",jsonStringView(first,"")); add(stages,physical43_stages.physical43Stages.runStage("machine_ir",id+"-machine-check",words,repo,logs,300)); jsonRelease(first); jsonRelease(words); } jsonRelease(llvm); jsonRelease(machine);
                object >> str <- physical43_stages.physical43Stages.manifestPath(payload,"object"); if (object == "") object <- physical43_stages.physical43Stages.chooseObject(root,get(spec,"object_format")); add(stages,physical43_stages.physical43Stages.oneFile("object",id+"-object",object,"no "+get(spec,"object_format")+" object with valid magic emitted"));
                if (object != "") { words <- command(ncc,"[\"machine\",\"verify-object\"]",object); add(stages,physical43_stages.physical43Stages.runStage("object_verify",id+"-object-verify",words,repo,logs,300)); jsonRelease(words); words <- command(ncc,"[\"disasm\"]",object); add(words,jsonNewString("--json")); add(stages,physical43_stages.physical43Stages.runStage("disassembly",id+"-disassembly",words,repo,logs,300)); jsonRelease(words); }
                linked >> str <- physical43_stages.physical43Stages.manifestPath(payload,"executable"); if (linked == "") linked <- physical43_stages.physical43Stages.manifestPath(payload,"image"); if (linked == "") linked <- physical43_stages.physical43Stages.linked(root); add(stages,physical43_stages.physical43Stages.oneFile("link",id+"-linked-artifact",linked,"no non-empty linked artifact emitted under bin/"));
                executionRow >> int <- 0;
                if (strStartsWith(get(spec,"execution"),"qemu-system") && runner == get(spec,"runner")) { contract >> int <- jsonPointer(payload,"/boot_artifact/qemu_smoke"); executionRow <- physical43_stages.physical43Stages.qemu(id+"-execution",contract,repo,logs); jsonRelease(contract); }
                else if (linked != "") { words <- execution(spec,linked,runner); if (jsonArrayLen(words) > 0) executionRow <- physical43_stages.physical43Stages.runStage("execution",id+"-execution",words,repo,logs,180); jsonRelease(words); }
                if (executionRow == 0) { executionRow <- jsonParse("{\"phase\":\"execution\",\"status\":\"not_executed_runner_mismatch\",\"returncode\":null}"); set(executionRow,"name",jsonNewString(id+"-execution")); set(executionRow,"required_runner",jsonObjectBorrow(spec,"runner")); set(executionRow,"actual_runner",jsonNewString(runner)); set(executionRow,"mode",jsonObjectBorrow(spec,"execution")); }
                jsonArrayPush(stages,executionRow); required >> int <- physical43_stages.physical43Stages.phases(); at >> int <- 0; material >> bool <- true;
                while (at < jsonArrayLen(required)-1) { phaseNode >> int <- jsonArrayBorrow(required,at); phase >> str <- jsonStringView(phaseNode,""); passed >> bool <- false; failed >> bool <- false; index >> int <- 0;
                    while (index < jsonArrayLen(stages)) { row >> int <- jsonArrayBorrow(stages,index); if (get(row,"phase") == phase) { if (get(row,"status") == "passed") passed <- true; if (get(row,"status") == "failed") failed <- true; } jsonRelease(row); index += 1; } material <- material && passed && !failed; jsonRelease(phaseNode); at += 1;
                }
                result >> int <- jsonNewObject(); keys >> int <- jsonParse("[\"id\",\"target\",\"profile\",\"architecture\",\"abi\",\"object_format\",\"runner\",\"physical_required\"]"); at <- 0; while (at < jsonArrayLen(keys)) { key >> int <- jsonArrayBorrow(keys,at); name >> str <- jsonStringView(key,""); set(result,name,jsonObjectBorrow(spec,name)); jsonRelease(key); at += 1; }
                set(result,"material_status",jsonNewString(material ? "passed" : "failed")); set(result,"execution_status",jsonObjectBorrow(executionRow,"status")); set(result,"linked_artifact",linked == "" ? jsonNewNull() : jsonNewString(linked)); set(result,"linked_sha256",linked == "" ? jsonNewNull() : jsonNewString(physical43_common.physical43Common.fileHash(linked))); set(result,"stages",stages); jsonRelease(executionRow); jsonRelease(payload); jsonRelease(discovered); jsonRelease(required); jsonRelease(keys); return result;
            }
            native(ncc >> str, repo >> str, software >> str, logs >> str) -> int {
                source >> str <- physical43_common.physical43Common.nativePath(repo+"/examples/06_memory/raw_optimizer_memory_intrinsics.n"); stages >> int <- jsonNewArray();
                words >> int <- command(ncc,"[\"emit-ast\"]",source); add(stages,physical43_stages.physical43Stages.runStage("parser","raw-parser",words,repo,logs,300)); jsonRelease(words);
                words <- command(ncc,"[\"check\"]",source); add(stages,physical43_stages.physical43Stages.runStage("sema","raw-sema",words,repo,logs,300)); jsonRelease(words);
                words <- command(ncc,"[\"emit-ir\"]",source); add(stages,physical43_stages.physical43Stages.runStage("typed_ir","raw-typed-ir",words,repo,logs,300)); jsonRelease(words);
                llvm >> str <- physical43_common.physical43Common.nativePath(software+"/native-raw/raw-optimizer.ll"); physical43_common.physical43Common.directories(release_io.releaseIo.directory(llvm)); words <- command(ncc,"[\"mct\",\"emit-llvm\"]",source); add(words,jsonNewString("--out")); add(words,jsonNewString(llvm)); add(words,jsonNewString("--opt-level")); add(words,jsonNewString("3")); add(stages,physical43_stages.physical43Stages.runStage("llvm_ir","raw-llvm-ir",words,repo,logs,300)); jsonRelease(words);
                words <- command(ncc,"[\"compiler\",\"build-native\"]",source); add(words,jsonNewString("--out-dir")); add(words,jsonNewString(physical43_common.physical43Common.nativePath(software+"/native-raw/build"))); tail >> int <- jsonParse("[\"--profile\",\"release-fast\",\"--lto\",\"off\",\"--pgo\",\"off\",\"--no-run\",\"--json\"]"); at >> int <- 0; while (at < jsonArrayLen(tail)) { add(words,jsonArrayGet(tail,at)); at += 1; } jsonRelease(tail);
                build >> int <- physical43_stages.physical43Stages.runStage("link","raw-native-build",words,repo,logs,600); jsonArrayPush(stages,build); jsonRelease(words);
                if (get(build,"status") == "passed") {
                    payload >> int <- physical43_common.physical43Common.read(get(build,"stdout"),false); executable >> str <- physical43_stages.physical43Stages.query(payload,"/paths/executable");
                    if (executable == "") add(stages,physical43_stages.physical43Stages.failure("execution","raw-native-artifact-parse","missing or invalid paths/executable in native build output",87));
                    else { words <- jsonNewArray(); add(words,jsonNewString(physical43_common.physical43Common.joinPath(repo,executable))); row >> int <- physical43_stages.physical43Stages.runStage("execution","raw-native-execution",words,repo,logs,300); exact >> bool <- physical43_stages.physical43Stages.exactText(get(row,"stdout"),"3048\n42\n"); set(row,"exact_output",jsonNewBool(exact)); if (!exact) { set(row,"status",jsonNewString("failed")); set(row,"returncode",jsonNewInt(86)); set(row,"diagnostic",jsonNewString("native raw program output did not match exact oracle")); } add(stages,row); jsonRelease(words); } jsonRelease(payload);
                }
                jsonRelease(build); return stages;
            }
            stress(ncc >> str, repo >> str, software >> str, logs >> str, profile >> str, cargo >> str, skip >> bool) -> int {
                rows >> int <- jsonNewArray(); names >> int <- jsonParse("[\"raw-memory-stress\",\"stress\"]"); verifyNames >> int <- jsonParse("[\"verify-raw-memory-stress\",\"verify-stress\"]"); at >> int <- 0;
                while (at < 2) { name >> int <- jsonArrayBorrow(names,at); commandName >> str <- jsonStringView(name,""); bundle >> str <- physical43_common.physical43Common.nativePath(software+"/stress/"+(at == 0 ? "raw-memory" : "kernel")); words >> int <- jsonParse("[\"machine\",\"kernel-system\"]"); jsonArrayInsert(words,0,jsonNewString(ncc)); add(words,jsonNewString(commandName)); add(words,jsonNewString("--profile")); add(words,jsonNewString(profile)); add(words,jsonNewString("--bundle")); add(words,jsonNewString(bundle)); label >> str <- at == 0 ? "raw-memory-stress" : "kernel-stress"; row >> int <- physical43_stages.physical43Stages.runStage("stress",label,words,repo,logs,1800); jsonRelease(words); jsonArrayPush(rows,row);
                    if (get(row,"status") == "passed") { words <- jsonParse("[\"machine\",\"kernel-system\"]"); jsonArrayInsert(words,0,jsonNewString(ncc)); add(words,jsonArrayGet(verifyNames,at)); add(words,jsonNewString(bundle)); add(rows,physical43_stages.physical43Stages.runStage("stress",label+"-verify",words,repo,logs,300)); jsonRelease(words); } jsonRelease(row); jsonRelease(name); at += 1;
                }
                if (!skip) { words >> int <- jsonParse("[\"test\",\"-p\",\"ncc-cli\",\"--test\",\"raw_optimizer_certification\",\"--\",\"--nocapture\"]"); jsonArrayInsert(words,0,jsonNewString(cargo)); add(rows,physical43_stages.physical43Stages.runStage("differential","gcc-clang-differential",words,repo,logs,1800)); jsonRelease(words); } jsonRelease(names); jsonRelease(verifyNames); return rows;
            }
    fa: return true;
}
