use <io:output>;
use <process:args>;
use <project:utility_migration>;

utilityCli {
    fn:
        public:
            execute(arguments >> addr) -> int {
                if (argsCount(arguments) >= 2) {
                    if (argsAt(arguments,1) == "migrate-low-level") return utility_migration.utilityMigration.execute(arguments);
                    if (argsAt(arguments,1) == "--help" || argsAt(arguments,1) == "-h") {
                        println("ncc-tools: migrate-low-level"); return 0;
                    }
                }
                println("ncc-tools: expected migrate-low-level"); return 2;
            }
    fa: return true;
}
