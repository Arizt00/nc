use <data:json>;
use <project:release_io, ide43_core>;

ide43Ghidra {
    fn:
        public:
            evaluate(root >> str) -> int {
                checks >> int <- ide43_core.ide43Core.initialize("ghidra_extension_artifacts_present|ghidra_router_low_level_uses_nc_sys_lsp|ghidra_router_high_level_falls_back_nclsp|nc_sys_lsp_low_level_analyze_ok|ghidra_bundle_generated|ghidra_contract_consistent");
                ide43_core.ide43Core.record(checks,"ghidra_extension_artifacts_present",ide43_core.ide43Core.files(root,
                    "IDE_GHIDRA.md|docs/spec/release/v2_0_0_phase10_ghidra_integration_spec.md|docs/spec/release/v2_0_0_phase10_ghidra_integration_compatibility_spec.md|docs/spec/release/v2_0_0_phase10_ghidra_integration_contract.json|docs/status/STATUS_PHASE10_punto20_ghidra_integration_v2_0_0.md|tools/ghidra/nc-ghidra-extension/README.md|tools/ghidra/nc-ghidra-extension/extension.properties|tools/ghidra/nc-ghidra-extension/Module.manifest|tools/ncc/nc/src/verification/ide_router.n|tools/ghidra/nc-ghidra-extension/ghidra_scripts/NcPrimitiveAnalyze.java|tools/ncc/nc/src/verification/ide43_bundle.n|tools/release/qa_phase10_p20_v2_0_0.sh|tools/ncc/nc/src/verification/ide43_ghidra.n",true));
                return checks;
            }
            finalize(root >> str, checks >> int) -> void {
                contract >> int <- ide43_core.ide43Core.read(root,"docs/spec/release/v2_0_0_phase10_ghidra_integration_contract.json");
                ide43_core.ide43Core.record(checks,"ghidra_contract_consistent",
                    ide43_core.ide43Core.is(contract,"schema","nc.phase10.ghidra.integration.contract.v1") &&
                    ide43_core.ide43Core.is(contract,"ghidra|primary_surface","primitive"+"[@]") &&
                    ide43_core.ide43Core.members(contract,"required_gates","release_phase10_ghidra_gate_tests",false));
                jsonRelease(contract);
            }
    fa: return true;
}

