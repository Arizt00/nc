use <data:json>;
use <process:args, env>;
use <io:output, erroroutput>;
use <project:physical43_common, physical43_stages, physical43_routes, physical43_boards, release_io, tool_cli, sha256>;

physical43Final {
    fn:
        private:
            get(model >> int, key >> str) -> str { return physical43_stages.physical43Stages.get(model,key); }
            set(model >> int, key >> str, value >> int) -> void { physical43_stages.physical43Stages.set(model,key,value); }
            allPassed(rows >> int) -> bool { at >> int <- 0; while (at < jsonArrayLen(rows)) { item >> int <- jsonArrayBorrow(rows,at); valid >> bool <- get(item,"status") == "passed"; jsonRelease(item); if (!valid) return false; at += 1; } return true; }
            git(repo >> str, words >> str) -> str { row >> int <- physical43_common.physical43Common.invoke(words,"git",repo,300000); result >> str <- physical43_common.physical43Common.succeeded(row) ? physical43_common.physical43Common.stdoutText(row) : ""; jsonRelease(row); return result; }
        public:
            runner() -> str { architecture >> str <- strToLower(physical43_common.physical43Common.hostArchitecture()); return strToLower(physical43_common.physical43Common.hostSystem())+"-"+(architecture == "amd64" ? "x86_64" : (architecture == "arm64" ? "aarch64" : architecture)); }
            summarize(native >> int, routes >> int, stress >> int, physical >> int) -> int {
                software >> bool <- allPassed(native) && allPassed(stress); certified >> int <- jsonNewArray(); at >> int <- 0;
                while (at < jsonArrayLen(physical)) { row >> int <- jsonArrayBorrow(physical,at); if (get(row,"status") == "passed") physical43_stages.physical43Stages.add(certified,jsonObjectGet(row,"route_id")); jsonRelease(row); at += 1; }
                physicalOk >> bool <- true; required >> int <- 0; executionOk >> bool <- true; at <- 0;
                while (at < jsonArrayLen(routes)) { route >> int <- jsonArrayBorrow(routes,at); needsPhysical >> bool <- physical43_common.physical43Common.truthyAt(route,"/physical_required"); hasCertificate >> bool <- release_io.releaseIo.contains(certified,get(route,"id")); if (needsPhysical) { required += 1; physicalOk <- physicalOk && hasCertificate; } executionOk <- executionOk && (get(route,"execution_status") == "passed" || (needsPhysical && hasCertificate)); software <- software && get(route,"material_status") == "passed"; jsonRelease(route); at += 1; }
                physicalOk <- physicalOk && required > 0; result >> int <- jsonNewObject(); set(result,"software_status",jsonNewString(software ? "passed" : "failed")); set(result,"execution_status",jsonNewString(executionOk ? "passed" : "partial_not_all_runners_executed")); set(result,"physical_status",jsonNewString(physicalOk ? "certified" : (jsonArrayLen(physical) > 0 ? "failed" : "not_executed_no_hardware_manifest"))); set(result,"certification_status",jsonNewString(software && executionOk && (physicalOk || required == 0) ? "certified" : (software ? "software_certified_execution_partial" : "failed"))); jsonRelease(certified); return result;
            }
            markdown(report >> int) -> str {
                text >> str <- "# nC final pipeline certification\n\n- schema: `"+get(report,"schema")+"`\n- git head: `"+physical43_stages.physical43Stages.query(report,"/git/head")+"`\n- exact head: `"+(physical43_stages.physical43Stages.truth(report,"/git/exact_head") ? "true" : "false")+"`\n- software: `"+get(report,"software_status")+"`\n- execution: `"+get(report,"execution_status")+"`\n- physical: `"+get(report,"physical_status")+"`\n- final: `"+get(report,"certification_status")+"`\n\n## Target routes\n\n| Route | Target | Profile | Material | Execution | Physical |\n|---|---|---|---:|---:|---:|\n";
                rows >> int <- jsonObjectBorrow(report,"routes"); at >> int <- 0;
                while (at < jsonArrayLen(rows)) { row >> int <- jsonArrayBorrow(rows,at); text <- text+"| `"+get(row,"id")+"` | `"+get(row,"target")+"` | `"+get(row,"profile")+"` | "+get(row,"material_status")+" | "+get(row,"execution_status")+" | "+(physical43_common.physical43Common.truthyAt(row,"/physical_required") ? "required" : "n/a")+" |\n"; jsonRelease(row); at += 1; } jsonRelease(rows);
                return text+"\n## Truth boundary\n\nSoftware, QEMU and hardware are separate evidence classes. Physical status changes to `certified` only when every selected physical route has an identified board certificate emitted by `ncc machine certify-board`. Runner mismatch and absent hardware remain visible and never count as success.\n";
            }
            execute(arguments >> addr) -> int {
                if (physical43_common.physical43Common.help(arguments)) { println("certify-final-pipeline --ncc EXE --out NEW_DIRECTORY [--repo REPO] [--matrix JSON] [--cargo EXE] [--skip-cargo] [--require-exact-head] [--require-execution] [--require-physical] [--runner RUNNER] [--route ID] [--stress-profile smoke|ci|endurance] [--physical-manifest [ID=]JSON]"); return 0; }
                options >> int <- physical43_common.physical43Common.parse(arguments,2,"|--ncc|--repo|--out|--matrix|--cargo|--runner|--route|--stress-profile|--physical-manifest|","|--skip-cargo|--require-exact-head|--require-execution|--require-physical|","|--route|--physical-manifest|");
                if (options == 0) { eprintln("invalid or missing final pipeline options"); return 2; }
                if (!jsonObjectHas(options,"--ncc") || !jsonObjectHas(options,"--out")) { eprintln("invalid or missing final pipeline options"); return 2; }
                profile >> str <- tool_cli.toolCli.value(options,"--stress-profile","smoke"); if (profile != "smoke" && profile != "ci" && profile != "endurance") { eprintln("invalid stress profile"); return 2; }
                repo >> str <- physical43_common.physical43Common.absolutePath(tool_cli.toolCli.value(options,"--repo",".")); out >> str <- physical43_common.physical43Common.absolutePath(tool_cli.toolCli.value(options,"--out",""));
                if (physical43_common.physical43Common.fileType(out) != 0) { names >> int <- physical43_common.physical43Common.names(out); nonempty >> bool <- jsonKind(names) != 5 || jsonArrayLen(names) > 0; jsonRelease(names); if (nonempty) { eprintln("E_FINAL_CERT_OUT_NOT_EMPTY_001: output directory is not empty: "+out); return 2; } }
                logs >> str <- physical43_common.physical43Common.nativePath(out+"/logs"); softwareRoot >> str <- physical43_common.physical43Common.nativePath(out+"/software"); physicalRoot >> str <- physical43_common.physical43Common.nativePath(out+"/physical"); physical43_common.physical43Common.directories(logs); physical43_common.physical43Common.directories(softwareRoot); physical43_common.physical43Common.directories(physicalRoot);
                matrixPath >> str <- physical43_common.physical43Common.joinPath(repo,tool_cli.toolCli.value(options,"--matrix","tools/certification/final-target-matrix.v1.json")); matrix >> int <- physical43_stages.physical43Stages.matrix(matrixPath,repo);
                if (matrix == 0) { eprintln(physical43_common.physical43Common.diagnostic()); return 2; }
                allRoutes >> int <- jsonObjectBorrow(matrix,"routes"); wanted >> int <- jsonObjectBorrow(options,"--route"); selected >> int <- jsonNewArray(); at >> int <- 0;
                while (at < jsonArrayLen(allRoutes)) { route >> int <- jsonArrayBorrow(allRoutes,at); if (jsonArrayLen(wanted) == 0 || release_io.releaseIo.contains(wanted,get(route,"id"))) jsonArrayPush(selected,route); jsonRelease(route); at += 1; }
                at <- 0; while (at < jsonArrayLen(wanted)) { request >> int <- jsonArrayBorrow(wanted,at); name >> str <- jsonStringView(request,""); found >> bool <- false; index >> int <- 0; while (index < jsonArrayLen(selected)) { route >> int <- jsonArrayBorrow(selected,index); if (get(route,"id") == name) found <- true; jsonRelease(route); index += 1; } if (!found) { eprintln("E_FINAL_CERT_ROUTE_UNKNOWN_001: unknown routes: "+name); return 2; } jsonRelease(request); at += 1; }
                ncc >> str <- physical43_common.physical43Common.absolutePath(tool_cli.toolCli.value(options,"--ncc","")); if (physical43_common.physical43Common.fileType(ncc) != 1) { eprintln("E_FINAL_CERT_NCC_001: ncc binary does not exist: "+ncc); return 2; }
                head >> str <- git(repo,"[\"rev-parse\",\"HEAD\"]"); dirty >> str <- git(repo,"[\"status\",\"--porcelain\"]"); exact >> bool <- head != "" && dirty == "";
                if (tool_cli.toolCli.hasFlag(options,"--require-exact-head") && !exact) { eprintln("E_FINAL_CERT_EXACT_HEAD_001: worktree is not clean exact-head"); return 2; }
                runnerName >> str <- tool_cli.toolCli.value(options,"--runner",runner()); native >> int <- physical43_routes.physical43Routes.native(ncc,repo,softwareRoot,logs); routes >> int <- jsonNewArray(); at <- 0;
                while (at < jsonArrayLen(selected)) { spec >> int <- jsonArrayBorrow(selected,at); physical43_stages.physical43Stages.add(routes,physical43_routes.physical43Routes.route(spec,ncc,repo,softwareRoot,logs,runnerName)); jsonRelease(spec); at += 1; }
                cargoDefault >> str <- physical43_common.physical43Common.resolveCommand("cargo");
                if (cargoDefault == "") { strRelease(cargoDefault); cargoDefault <- strSubstring("cargo",0,5); }
                stress >> int <- physical43_routes.physical43Routes.stress(ncc,repo,softwareRoot,logs,profile,tool_cli.toolCli.value(options,"--cargo",cargoDefault),tool_cli.toolCli.hasFlag(options,"--skip-cargo")); strRelease(cargoDefault);
                manifests >> int <- jsonObjectBorrow(options,"--physical-manifest"); physical >> int <- physical43_boards.physical43Boards.run(manifests,routes,ncc,repo,physicalRoot,logs); report >> int <- summarize(native,routes,stress,physical);
                generated >> i64 <- nowMs(); generated <- generated*1000000;
                set(report,"schema",jsonNewString("ncc.final_pipeline.certification.v2")); set(report,"generated_unix_ns",physical43_common.physical43Common.integer64(generated)); gitModel >> int <- jsonNewObject(); set(gitModel,"head",jsonNewString(head)); set(gitModel,"dirty",jsonNewBool(dirty != "")); set(gitModel,"exact_head",jsonNewBool(exact)); set(report,"git",gitModel); set(report,"runner",jsonNewString(runnerName));
                identity >> int <- jsonNewObject(); set(identity,"path",jsonNewString(matrixPath)); set(identity,"sha256",jsonNewString(physical43_common.physical43Common.fileHash(matrixPath))); set(report,"matrix",identity); identity <- jsonNewObject(); set(identity,"path",jsonNewString(ncc)); set(identity,"sha256",jsonNewString(physical43_common.physical43Common.fileHash(ncc))); set(report,"ncc",identity); set(report,"native_raw_stages",native); set(report,"routes",routes); set(report,"stress",stress); set(report,"physical",physical); set(report,"truth_boundary",jsonParse("{\"qemu_is_physical_hardware\":false,\"host_model_is_physical_device_dma\":false,\"physical_requires_identified_board_manifest\":true,\"runner_mismatch_counts_as_execution\":false}"));
                excluded >> int <- jsonParse("[\"*/report.json\",\"*/report.md\",\"*/SHA256SUMS\"]"); artifacts >> int <- physical43_common.physical43Common.inventory(out,excluded,false,false); jsonRelease(excluded); if (jsonKind(artifacts) != 5) { eprintln(physical43_common.physical43Common.diagnostic()); return 1; } jsonObjectSet(report,"artifacts",artifacts);
                normalizedArtifacts >> int <- jsonNewArray(); sums >> str <- ""; at <- 0;
                while (at < jsonArrayLen(artifacts)) { row >> int <- jsonArrayGet(artifacts,at); set(row,"path",jsonNewString(physical43_common.physical43Common.nativePath(get(row,"path")))); sums <- sums+get(row,"sha256")+"  "+get(row,"path")+"\n"; physical43_common.physical43Common.push(normalizedArtifacts,row); at += 1; }
                set(report,"artifacts",normalizedArtifacts);
                if (sums == "") sums <- "\n";
                if (!physical43_common.physical43Common.save(out+"/report.json",report) || !physical43_common.physical43Common.writeText(out+"/report.md",markdown(report)) || !physical43_common.physical43Common.writeText(out+"/SHA256SUMS",sums)) { eprintln("cannot write final pipeline report"); return 1; }
                summary >> int <- jsonNewObject(); keys >> int <- jsonParse("[\"software_status\",\"execution_status\",\"physical_status\",\"certification_status\"]"); at <- 0; while (at < 4) { key >> int <- jsonArrayBorrow(keys,at); name >> str <- jsonStringView(key,""); set(summary,name,jsonObjectBorrow(report,name)); jsonRelease(key); at += 1; } set(summary,"report",jsonNewString(physical43_common.physical43Common.nativePath(out+"/report.json"))); physical43_common.physical43Common.print(summary);
                code >> int <- get(report,"software_status") != "passed" ? 1 : ((tool_cli.toolCli.hasFlag(options,"--require-execution") && get(report,"execution_status") != "passed") ? 3 : ((tool_cli.toolCli.hasFlag(options,"--require-physical") && get(report,"physical_status") != "certified") ? 4 : 0));
                jsonRelease(keys); jsonRelease(summary); jsonRelease(report); jsonRelease(artifacts); jsonRelease(selected); jsonRelease(allRoutes); jsonRelease(wanted); jsonRelease(matrix); jsonRelease(manifests); jsonRelease(options); return code;
            }
    fa: return true;
}
