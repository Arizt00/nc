use <process:command>;

physical43Wait {
    stc:
        result >> int <- 0;
    fn:
        public:
            wait(child >> addr, timeoutMs >> int) -> int {
                result <- -1;
                status >> int <- commandWait(child,timeoutMs);
                if (status == 0) result <- commandExitCode(child);
                return status;
            }
            exitCode() -> int { return result; }
    fa: return true;
}
