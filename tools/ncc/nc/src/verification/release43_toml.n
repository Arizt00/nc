use <data:json>;
use <project:release43_common>;

release43Toml {
    stc:
        source >> str;
        cursor >> int;
        length >> int;
        broken >> bool;
    fn:
        private:
            code() -> int { return cursor < length ? rd<byte>(off<byte>(cast<byte>(source),cursor)) & 255 : 0; }
            spaces() -> void {
                while (cursor < length) {
                    c >> int <- code();
                    if (c == 32 || c == 9 || c == 10 || c == 13) cursor += 1;
                    else if (c == 35) { while (cursor < length && code() != 10) { cursor += 1; } }
                    else break;
                }
            }
            quoted() -> int {
                first >> int <- cursor; quote >> int <- code(); cursor += 1;
                if (quote == 39) {
                    start >> int <- cursor; while (cursor < length && code() != 39 && code() != 10 && code() != 13) { cursor += 1; }
                    if (code() != 39) { broken <- true; return 0; }
                    result >> int <- jsonNewString(strSubstring(source,start,cursor-start)); cursor += 1; return result;
                }
                escaped >> bool <- false;
                while (cursor < length) {
                    c >> int <- code(); cursor += 1;
                    if (!escaped && c == 34) return jsonParse(strSubstring(source,first,cursor-first));
                    if (c == 10 || c == 13) { broken <- true; return 0; }
                    if (!escaped && c == 92) escaped <- true; else escaped <- false;
                }
                broken <- true; return 0;
            }
            value(depth >> int) -> int {
                spaces(); if (depth > 32) { broken <- true; return 0; }
                c >> int <- code();
                if (c == 34 || c == 39) { result >> int <- quoted(); if (result == 0) broken <- true; return result; }
                if (c == 91) {
                    cursor += 1; rows >> int <- jsonNewArray(); spaces();
                    while (code() != 93 && !broken) {
                        child >> int <- value(depth+1); if (child == 0) { broken <- true; break; }
                        release43_common.release43Common.push(rows,child); spaces();
                        if (code() == 44) { cursor += 1; spaces(); }
                        else if (code() != 93) broken <- true;
                    }
                    if (code() != 93 || broken) { release43_common.release43Common.release(rows); broken <- true; return 0; }
                    cursor += 1; return rows;
                }
                first >> int <- cursor;
                while (cursor < length && code() != 32 && code() != 9 && code() != 10 && code() != 13 && code() != 35 && code() != 44 && code() != 93) { cursor += 1; }
                if (cursor == first) { broken <- true; return 0; }
                result >> int <- jsonParse(strSubstring(source,first,cursor-first));
                if (result == 0) { broken <- true; return 0; }
                if (jsonKind(result) != 2 && jsonKind(result) != 3) { release43_common.release43Common.release(result); broken <- true; return 0; }
                return result;
            }
            name() -> str {
                spaces(); first >> int <- cursor;
                while (cursor < length) {
                    c >> int <- code();
                    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45) cursor += 1;
                    else break;
                }
                if (cursor == first) broken <- true;
                return strSubstring(source,first,cursor-first);
            }
        public:
            parse(text >> str) -> int {
                source <- text; cursor <- 0; length <- strByteLen(text); broken <- false;
                root >> int <- jsonNewObject(); table >> int <- jsonNewObject(); key >> str <- ""; entryRows >> int <- jsonNewArray(); entryMode >> bool <- false;
                while (cursor < length && !broken) {
                    spaces(); if (cursor >= length) break;
                    if (code() == 91) {
                        if (key != "") {
                            if (entryMode) release43_common.release43Common.push(entryRows,table);
                            else release43_common.release43Common.put(root,key,table);
                        } else { release43_common.release43Common.release(table); }
                        table <- 0;
                        cursor += 1; entryMode <- code() == 91; if (entryMode) cursor += 1;
                        key <- name(); spaces();
                        if (code() != 93) { broken <- true; break; } cursor += 1;
                        if (entryMode) { if (code() != 93 || key != "entries") { broken <- true; break; } cursor += 1; }
                        else if (jsonObjectHas(root,key)) { broken <- true; break; }
                        table <- jsonNewObject();
                    } else {
                        name >> str <- name(); spaces(); if (code() != 61) { broken <- true; break; } cursor += 1;
                        child >> int <- value(0); target >> int <- key == "" ? root : table;
                        if (child == 0) { broken <- true; break; }
                        if (jsonObjectHas(target,name)) { release43_common.release43Common.release(child); broken <- true; break; }
                        release43_common.release43Common.put(target,name,child);
                    }
                    // No second assignment may silently follow a value on the same line.
                    while (cursor < length && (code() == 32 || code() == 9 || code() == 13)) { cursor += 1; }
                    if (code() == 35) { while (cursor < length && code() != 10) { cursor += 1; } }
                    if (cursor < length && code() != 10) broken <- true;
                    if (code() == 10) cursor += 1;
                }
                if (key != "" && !broken) {
                    if (entryMode) release43_common.release43Common.push(entryRows,table);
                    else release43_common.release43Common.put(root,key,table);
                } else if (table != 0) release43_common.release43Common.release(table);
                if (broken) { release43_common.release43Common.release(root); release43_common.release43Common.release(entryRows); return 0; }
                if (jsonArrayLen(entryRows) > 0) release43_common.release43Common.put(root,"entries",entryRows); else release43_common.release43Common.release(entryRows);
                return root;
            }
    fa: return true;
}
