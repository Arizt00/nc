use foreign { c };
use <net:socket>;
use <process:env>;
use <project:sha256, mobile43_codec>;

mobile43Transport {
    foreign:
        c symbol "signal" {
            abi: C;
            header: "signal.h";
            library: "system";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(i32, addr) -> addr";
        }
        c symbol "TLS_client_method" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn() -> addr";
        }
        c symbol "TLS_server_method" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn() -> addr";
        }
        c symbol "SSL_CTX_new" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> addr";
        }
        c symbol "SSL_CTX_free" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> void";
        }
        c symbol "SSL_CTX_load_verify_locations" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, ptr<byte>, addr) -> i32";
        }
        c symbol "SSL_CTX_set_verify" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, i32, addr) -> void";
        }
        c symbol "SSL_CTX_ctrl" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, i32, int, addr) -> int";
        }
        c symbol "SSL_new" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> addr";
        }
        c symbol "SSL_free" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> void";
        }
        c symbol "SSL_set_fd" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, i32) -> i32";
        }
        c symbol "SSL_connect" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> i32";
        }
        c symbol "SSL_accept" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> i32";
        }
        c symbol "SSL_read" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, addr, i32) -> i32";
        }
        c symbol "SSL_write" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, addr, i32) -> i32";
        }
        c symbol "SSL_get1_peer_certificate" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> addr";
        }
        c symbol "SSL_CTX_use_certificate_file" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, ptr<byte>, i32) -> i32";
        }
        c symbol "SSL_CTX_use_PrivateKey_file" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, ptr<byte>, i32) -> i32";
        }
        c symbol "SSL_CTX_check_private_key" {
            abi: C;
            header: "openssl/ssl.h";
            library: "ssl";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> i32";
        }
        c symbol "X509_free" {
            abi: C;
            header: "openssl/crypto.h";
            library: "crypto";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr) -> void";
        }
        c symbol "i2d_X509" {
            abi: C;
            header: "openssl/crypto.h";
            library: "crypto";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, addr) -> i32";
        }
        c symbol "RAND_bytes" {
            abi: C;
            header: "openssl/crypto.h";
            library: "crypto";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            nullability: nullable;
            sideEffects: explicit;
            signature: "fn(addr, i32) -> i32";
        }
    fn:
        public:
            narrow(value >> int) -> i32 { return value; }
            descriptor(value >> addr) -> i32 { return value; }
            ignoredHandler() -> addr { return 1; }
            ignoreBrokenPipe() -> void {
                if (!envHas("WINDIR")) signal(narrow(13),ignoredHandler());
            }
            context(server >> bool, certificate >> str, key >> str) -> addr {
                method >> addr <- server ? TLS_server_method() : TLS_client_method();
                ctx >> addr <- SSL_CTX_new(method);
                guard ctx != null else return null;
                // SSL_CTRL_SET_MIN_PROTO_VERSION; TLS 1.2. No downgrade to raw.
                if (SSL_CTX_ctrl(ctx,narrow(123),771,null) != 1) { SSL_CTX_free(ctx); return null; }
                if (server) {
                    if (SSL_CTX_use_certificate_file(ctx,cast<byte>(certificate),narrow(1)) != narrow(1) ||
                        SSL_CTX_use_PrivateKey_file(ctx,cast<byte>(key),narrow(1)) != narrow(1) || SSL_CTX_check_private_key(ctx) != narrow(1)) {
                        SSL_CTX_free(ctx); return null;
                    }
                } else {
                    if (certificate != "") {
                        if (SSL_CTX_load_verify_locations(ctx,cast<byte>(certificate),null) != narrow(1)) { SSL_CTX_free(ctx); return null; }
                        SSL_CTX_set_verify(ctx,narrow(1),null);
                    } else SSL_CTX_set_verify(ctx,narrow(0),null);
                }
                return ctx;
            }
            wrap(ctx >> addr, socket >> addr, server >> bool) -> addr {
                stream >> addr <- SSL_new(ctx);
                guard stream != null else return null;
                fd >> i32 <- descriptor(socket);
                if (SSL_set_fd(stream,fd) != narrow(1)) { SSL_free(stream); return null; }
                status >> int <- server ? SSL_accept(stream) : SSL_connect(stream);
                if (status != 1) { SSL_free(stream); return null; }
                return stream;
            }
            read(socket >> addr, tls >> addr, buffer >> p<byte>, count >> int) -> int {
                if (tls == null) return socketRecv(socket,adr(buffer),count,0);
                return SSL_read(tls,adr(buffer),narrow(count));
            }
            write(socket >> addr, tls >> addr, buffer >> p<byte>, count >> int) -> int {
                if (tls == null) return socketSend(socket,adr(buffer),count,0);
                return SSL_write(tls,adr(buffer),narrow(count));
            }
            fingerprint(tls >> addr) -> str {
                certificate >> addr <- SSL_get1_peer_certificate(tls);
                guard certificate != null else return "";
                count >> int <- i2d_X509(certificate,null);
                if (count <= 0 || count > 1048576) { X509_free(certificate); return ""; }
                data >> p<byte> <- cast(alloc(count));
                guard data != null else { X509_free(certificate); return ""; }
                position >> p<addr> <- cast(alloc(8));
                guard position != null else { free(data); X509_free(certificate); return ""; }
                wr(position,adr(data));
                actual >> int <- i2d_X509(certificate,adr(position));
                digest >> str <- actual == count ? sha256.nccSha256.bytes(data,count) : "";
                free(position); free(data); X509_free(certificate);
                return digest;
            }
            nonce() -> str {
                data >> p<byte> <- cast(alloc(24));
                guard data != null else return "";
                if (RAND_bytes(adr(data),narrow(24)) != narrow(1)) { free(data); return ""; }
                value >> str <- mobile43_codec.mobile43Codec.hex(data,24);
                free(data); return value;
            }
            close(socket >> addr, tls >> addr, ctx >> addr) -> void {
                if (tls != null) SSL_free(tls);
                if (socket != null) socketClose(socket);
                if (ctx != null) SSL_CTX_free(ctx);
            }
    fa: return true;
}

