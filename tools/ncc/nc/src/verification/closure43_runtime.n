use <data:json>;
use <process:args>;
use <io:output, render>;
use <project:closure43_core, closure43_documents, closure43_markers, closure43_gates, closure43_options, release_io, tool_cli>;

closure43Runtime {
    fn:
        private:
            fields(target >> int, source >> int, names >> str) -> void {
                keys >> int <- jsonParse(names); index >> int <- 0;
                while (index < jsonArrayLen(keys)) {
                    key >> int <- jsonArrayGet(keys,index); closure43_core.closure43Core.copyField(target,source,jsonGetString(key)); jsonRelease(key); index += 1;
                }
                jsonRelease(keys);
            }
            selected(source >> int, names >> str) -> int { result >> int <- jsonNewObject(); fields(result,source,names); return result; }
            wordCommand(operation >> str, subject >> str, suffix >> str) -> int {
                words >> int <- jsonParse("[\"@ncc\",\"runtime\"]"); closure43_core.closure43Core.push(words,jsonNewString(operation));
                if (subject != "") closure43_core.closure43Core.push(words,jsonNewString(subject));
                if (suffix == "--strict --json") closure43_core.closure43Core.push(words,jsonNewString("--strict"));
                if (suffix != "") closure43_core.closure43Core.push(words,jsonNewString(suffix == "--strict --json" ? "--json" : suffix));
                record >> int <- closure43_core.closure43Core.command(words,false,false,false);
                label >> str <- "ncc "; index >> int <- 1;
                while (index < jsonArrayLen(words)) { item >> int <- jsonArrayGet(words,index); if (index > 1) label <- label+" "; label <- label+jsonGetString(item); jsonRelease(item); index += 1; }
                if (strStartsWith(subject,"examples/runtime/families/")) {
                    label <- "runtime "+operation+(operation == "report" ? (suffix == "--md" ? " md" : " json") : "")+" "+subject;
                    if (operation == "report" && subject == "examples/runtime/families/list_basic.n") label <- "runtime report "+(suffix == "--md" ? "md" : "json")+" list alias";
                }
                closure43_core.closure43Core.require(record,label); jsonRelease(words); return record;
            }
            query(operation >> str, subject >> str) -> int {
                record >> int <- wordCommand(operation,subject,"--json"); value >> int <- closure43_core.closure43Core.payload(record,true); jsonRelease(record); return value;
            }
            diagnostics(errors >> int, key >> str) -> int {
                direct >> int <- jsonNewArray(); generic >> int <- jsonNewArray(); index >> int <- 0;
                codes >> int <- jsonParse("[\"E_RUNTIME_USE_001\",\"E_RUNTIME_IMPORT_001\",\"E_RUNTIME_IMPORT_002\",\"E_RUNTIME_EXPORTS_001\",\"E_RUNTIME_CAPABILITY_001\",\"E_RUNTIME_POLICY_001\"]");
                while (index < jsonArrayLen(errors)) {
                    row >> int <- jsonArrayGet(errors,index);
                    if (closure43_core.closure43Core.field(row,"family") == key) jsonArrayPush(direct,row);
                    if (release_io.releaseIo.contains(codes,closure43_core.closure43Core.field(row,"code"))) jsonArrayPush(generic,row);
                    jsonRelease(row); index += 1;
                }
                jsonRelease(codes);
                if (jsonArrayLen(direct) > 0) { jsonRelease(generic); return direct; }
                jsonRelease(direct); return generic;
            }
            aliases(row >> int, aliasSurface >> bool) -> int {
                if (aliasSurface) return jsonParse("[\"nC.list\",\"nC.list.*\",\"nC.runtime.list.*\",\"runtime.list\"]");
                values >> int <- jsonNewArray(); modulePath >> str <- closure43_core.closure43Core.field(row,"module_path"); closure43_core.closure43Core.push(values,jsonNewString(modulePath));
                if (closure43_core.closure43Core.field(row,"family_key") == "queue" && modulePath != "runtime.queue") closure43_core.closure43Core.push(values,jsonNewString("runtime.queue"));
                sorted >> int <- release_io.releaseIo.sorted(values); jsonRelease(values); return sorted;
            }
            codes(rows >> int) -> int {
                result >> int <- jsonNewArray(); index >> int <- 0;
                while (index < jsonArrayLen(rows)) { row >> int <- jsonArrayGet(rows,index); closure43_core.closure43Core.push(result,jsonObjectGet(row,"code")); jsonRelease(row); index += 1; }
                return result;
            }
            missing(values >> int, catalog >> int) -> int {
                result >> int <- jsonNewArray(); index >> int <- 0;
                while (index < jsonArrayLen(values)) { value >> int <- jsonArrayGet(values,index); if (!release_io.releaseIo.contains(catalog,jsonGetString(value))) jsonArrayPush(result,value); jsonRelease(value); index += 1; }
                return result;
            }
            compact(data >> int, key >> str) -> str {
                canonical >> int <- jsonObjectGet(data,"canonical"); lowered >> str <- strToLower(strTrim(key)); value >> str <- closure43_core.closure43Core.field(canonical,lowered);
                if (!jsonObjectHas(canonical,lowered)) closure43_core.closure43Core.fail("runtime family has no canonical compact import: "+key);
                jsonRelease(canonical); return value;
            }
            camel(key >> str) -> str {
                result >> str <- ""; first >> bool <- true; index >> int <- 0; bytes >> p<byte> <- cast(key);
                while (index < strByteLen(key)) {
                    character >> int <- rd(off(bytes,index)) & 255;
                    if ((character >= 48 && character <= 57) || (character >= 65 && character <= 90) || (character >= 97 && character <= 122)) {
                        piece >> str <- strSubstring(key,index,1); result <- result+(first ? strToUpper(piece) : piece); first <- false;
                    } else first <- true;
                    index += 1;
                }
                return result == "" ? "Runtime" : result;
            }
            example(data >> int, key >> str) -> str {
                return "use "+compact(data,key)+";\n\nruntimeFamily"+camel(key)+"Basic[@runtime] {\n    run :: fn() -> bool {\n        return true;\n    }\n\n    ref main ->> run;\n\n    fa:\n        return true;\n}\n";
            }
            bullets(values >> int) -> str {
                result >> str <- ""; index >> int <- 0;
                while (index < jsonArrayLen(values)) { item >> int <- jsonArrayGet(values,index); if (index > 0) result <- result+"\n"; result <- result+"- \u{60}"+jsonGetString(item)+"\u{60}"; jsonRelease(item); index += 1; }
                return result == "" ? "- none" : result;
            }
            joinOrNone(values >> int) -> str { return jsonArrayLen(values) > 0 ? closure43_core.closure43Core.joinText(values,", ") : "none"; }
            document(data >> int, name >> str, context >> int, destination >> str, lines >> bool) -> void {
                documents >> int <- jsonObjectGet(data,"documents"); template >> int <- jsonObjectGet(documents,name);
                text >> str <- lines ? closure43_documents.closure43Documents.render(template,context) : closure43_documents.closure43Documents.content(template,context);
                closure43_core.closure43Core.write(destination,text); strRelease(text); jsonRelease(template); jsonRelease(documents);
            }
            importDoc(data >> int, row >> int, exports >> int, errors >> int, evidence >> int, aliasSurface >> bool) -> void {
                tick >> str <- "\u{60}"; key >> str <- closure43_core.closure43Core.field(row,"family_key"); context >> int <- jsonNewObject();
                closure43_core.closure43Core.set(context,"family_key",key); closure43_core.closure43Core.copyField(context,row,"import_path"); jsonObjectSet(context,"docs_evidence",evidence); closure43_core.closure43Core.set(context,"compact_import",compact(data,key));
                caps >> int <- jsonObjectGet(row,"required_capabilities"); policies >> int <- jsonObjectGet(row,"required_policies"); errorRows >> int <- diagnostics(errors,key); errorCodes >> int <- codes(errorRows);
                closure43_core.closure43Core.set(context,"cap_lines",bullets(caps)); closure43_core.closure43Core.set(context,"policy_lines",bullets(policies));
                aliasValues >> int <- aliases(row,aliasSurface); aliasText >> str <- ""; index >> int <- 0;
                while (index < jsonArrayLen(aliasValues)) { value >> int <- jsonArrayGet(aliasValues,index); if (index > 0) aliasText <- aliasText+", "; aliasText <- aliasText+tick+jsonGetString(value)+tick; jsonRelease(value); index += 1; }
                closure43_core.closure43Core.set(context,"aliases_text",aliasText == "" ? "No aliases are registered." : aliasText);
                closure43_core.closure43Core.set(context,"mode_denied","root and primitive under strict runtime import rules"+(key == "input" ? "; machine and kernel for input" : ""));
                errorText >> str <- ""; index <- 0;
                while (index < jsonArrayLen(errorRows)) {
                    errorRow >> int <- jsonArrayGet(errorRows,index); if (index > 0) errorText <- errorText+"\n";
                    name >> str <- jsonObjectHas(errorRow,"name") ? closure43_core.closure43Core.field(errorRow,"name") : "runtime error";
                    errorText <- errorText+"- "+tick+closure43_core.closure43Core.field(errorRow,"code")+tick+" ("+name+")"; jsonRelease(errorRow); index += 1;
                }
                closure43_core.closure43Core.set(context,"error_lines",errorText == "" ? "- none registered for this family" : errorText);
                exportText >> str <- ""; index <- 0;
                while (index < jsonArrayLen(exports)) {
                    exportRow >> int <- jsonArrayGet(exports,index); args >> int <- jsonObjectGet(exportRow,"arg_types"); name >> str <- closure43_core.closure43Core.field(exportRow,"name"); returnType >> str <- closure43_core.closure43Core.field(exportRow,"return");
                    if (index > 0) exportText <- exportText+"\n";
                    exportText <- exportText+"| "+tick+name+tick+" | "+tick+name+"("+closure43_core.closure43Core.joinText(args,", ")+") -> "+returnType+tick+" | "+tick+returnType+tick+" | "+tick+joinOrNone(caps)+tick+" | "+tick+joinOrNone(policies)+tick+" | "+tick+joinOrNone(errorCodes)+tick+" | official export |";
                    jsonRelease(exportRow); jsonRelease(args); index += 1;
                }
                closure43_core.closure43Core.set(context,"export_lines",exportText == "" ? "| none | none | none | none | none | none | no callable exports |" : exportText);
                document(data,"import.md",context,"docs/spec/runtime/imports/"+key+".md",false); jsonRelease(context); jsonRelease(caps); jsonRelease(policies); jsonRelease(errorRows); jsonRelease(errorCodes); jsonRelease(aliasValues);
            }
            docEvidence(evidence >> int) -> int {
                result >> int <- selected(evidence,"[\"example_positive\",\"report_json\",\"report_md\",\"evidence_hash\"]"); commands >> int <- jsonObjectGet(evidence,"commands");
                closure43_core.closure43Core.put(result,"exports_command",jsonObjectGet(commands,"exports")); closure43_core.closure43Core.put(result,"check_command",jsonObjectGet(commands,"check"));
                closure43_core.closure43Core.put(result,"report_command",jsonObjectGet(commands,"report_json")); jsonRelease(commands); return result;
            }
            manifest(key >> str, importPath >> str, aliasSurface >> bool) -> int {
                row >> int <- jsonParse("{\"category\":\"runnable\",\"expected_status\":\"pass\",\"expected_diagnostic\":null,\"expected_output\":\"\",\"mode\":\"runtime\",\"release_blocking\":true}");
                closure43_core.closure43Core.set(row,"path","examples/runtime/families/"+key+"_basic.n"); closure43_core.closure43Core.set(row,"family_key",key); closure43_core.closure43Core.set(row,"import_path",importPath);
                closure43_core.closure43Core.set(row,"notes",aliasSurface ? "list alias surface; not counted in the official 90 families report" : "minimal positive import/run example"); return row;
            }
            matrix(row >> int, evidence >> int, identity >> bool, data >> int) -> int {
                result >> int <- jsonParse("{\"examples_negative\":[],\"tests_positive\":[\"runtime_all_90_families_import_check_ok\"],\"tests_negative\":[\"runtime_no_missing_use_silent_fallback\"],\"mode_restrictions\":[\"runtime allowed\",\"root/primitive rejected by strict runtime import rules\"],\"strict_mode_behavior\":\"runtime context passes; forbidden modes fail\",\"blockers\":[]}");
                fields(result,row,"[\"family_key\",\"import_path\",\"aliases\",\"release_status\"]"); closure43_core.closure43Core.set(result,"official_use",compact(data,closure43_core.closure43Core.field(row,"family_key")));
                exports >> int <- jsonObjectGet(row,"exports"); closure43_core.closure43Core.put(result,"exports_expected",jsonNewInt(jsonArrayLen(exports))); closure43_core.closure43Core.put(result,"exports_actual",jsonNewInt(jsonArrayLen(exports))); closure43_core.closure43Core.put(result,"export_identity_ok",jsonNewBool(identity));
                closure43_core.closure43Core.put(result,"capabilities_expected",jsonObjectGet(row,"required_capabilities")); closure43_core.closure43Core.put(result,"capabilities_actual",jsonObjectGet(row,"required_capabilities")); closure43_core.closure43Core.put(result,"policies_expected",jsonObjectGet(row,"required_policies")); closure43_core.closure43Core.put(result,"policies_actual",jsonObjectGet(row,"required_policies")); closure43_core.closure43Core.put(result,"diagnostics_expected",jsonObjectGet(row,"diagnostics")); closure43_core.closure43Core.put(result,"diagnostics_actual",jsonObjectGet(row,"diagnostics"));
                examples >> int <- jsonNewArray(); closure43_core.closure43Core.push(examples,jsonObjectGet(evidence,"example_positive")); closure43_core.closure43Core.put(result,"examples_positive",examples); docs >> int <- jsonNewArray(); closure43_core.closure43Core.push(docs,jsonObjectGet(row,"docs_path")); closure43_core.closure43Core.put(result,"docs",docs);
                key >> str <- closure43_core.closure43Core.field(row,"family_key"); closure43_core.closure43Core.set(result,"report_json","reports/runtime_closure/evidence/"+key+".json"); closure43_core.closure43Core.set(result,"report_md","reports/runtime_closure/evidence/"+key+".md"); closure43_core.closure43Core.copyField(result,evidence,"evidence_hash"); commands >> int <- jsonObjectGet(evidence,"commands");
                closure43_core.closure43Core.put(result,"last_checked_command",jsonObjectGet(commands,"check")); jsonRelease(exports); jsonRelease(commands); return result;
            }
            table(rows >> int) -> str {
                tick >> str <- "\u{60}"; text >> str <- "| # | Import | Family key | Status | Exports | Capabilities | Policies | Docs |\n|---|---|---|---|---:|---:|---:|---|"; index >> int <- 0;
                while (index < jsonArrayLen(rows)) {
                    row >> int <- jsonArrayGet(rows,index); caps >> int <- jsonObjectGet(row,"required_capabilities"); policies >> int <- jsonObjectGet(row,"required_policies");
                    text <- text+"\n| "+renderInt(index+1)+" | "+tick+closure43_core.closure43Core.field(row,"import_path")+tick+" | "+tick+closure43_core.closure43Core.field(row,"family_key")+tick+" | "+tick+closure43_core.closure43Core.field(row,"release_status")+tick+" | "+renderInt(release_io.releaseIo.number(row,"exports_count",0))+" | "+renderInt(jsonArrayLen(caps))+" | "+renderInt(jsonArrayLen(policies))+" | "+tick+closure43_core.closure43Core.field(row,"docs_path")+tick+" |";
                    jsonRelease(row); jsonRelease(caps); jsonRelease(policies); index += 1;
                }
                return text;
            }
            container(schema >> str, generated >> str, name >> str, rows >> int) -> int {
                value >> int <- jsonNewObject(); closure43_core.closure43Core.set(value,"schema",schema); closure43_core.closure43Core.set(value,"generated_at_utc",generated); closure43_core.closure43Core.put(value,"count",jsonNewInt(jsonArrayLen(rows))); jsonObjectSet(value,name,rows); return value;
            }
            retainedCommand(name >> str, words >> int) -> int {
                record >> int <- closure43_core.closure43Core.command(words,false,false,false); label >> str <- "ncc "; index >> int <- 1;
                while (index < jsonArrayLen(words)) { item >> int <- jsonArrayGet(words,index); if (index > 1) label <- label+" "; label <- label+jsonGetString(item); jsonRelease(item); index += 1; }
                closure43_core.closure43Core.require(record,label); payload >> int <- closure43_core.closure43Core.payload(record,true); if (!closure43_core.closure43Core.ok()) return jsonNewObject(); path >> str <- "reports/runtime_closure/final_validation/"+name+".json"; closure43_core.closure43Core.save(path,payload);
                small >> int <- selected(record,"[\"cmd\",\"returncode\",\"sha256\"]"); fields(small,payload,"[\"status\",\"count\"]"); closure43_core.closure43Core.set(small,"path",path); result >> int <- jsonNewObject(); closure43_core.closure43Core.put(result,"record",small); closure43_core.closure43Core.put(result,"payload",payload); jsonRelease(record); return result;
            }
            validateFinal(data >> int, settings >> int, rows >> int, counts >> int) -> int {
                if (!release_io.releaseIo.makeDirectories(closure43_core.closure43Core.diskPath(closure43_core.closure43Core.path("reports/runtime_closure/final_validation")))) { closure43_core.closure43Core.fail("cannot create runtime final validation directory"); return jsonNewObject(); }
                summary >> int <- jsonObjectGet(data,"summary"); closure43_gates.closure43Gates.configure(summary,settings); closure43_core.closure43Core.put(summary,"cargo",closure43_gates.closure43Gates.cargo(settings,true));
                closure43_core.closure43Core.put(summary,"official_families",jsonNewInt(jsonArrayLen(rows))); states >> int <- jsonParse("[\"closed\",\"partial\",\"deferred\",\"broken\",\"blocked\"]"); index >> int <- 0;
                while (index < 5) { state >> int <- jsonArrayGet(states,index); closure43_core.closure43Core.put(summary,jsonGetString(state)+"_families",jsonObjectGet(counts,jsonGetString(state))); jsonRelease(state); index += 1; }
                commands >> int <- jsonObjectGet(data,"commands"); records >> int <- jsonNewObject(); index <- 0;
                while (index < jsonArrayLen(commands) && closure43_core.closure43Core.ok()) {
                    entry >> int <- jsonArrayGet(commands,index); name >> int <- jsonArrayGet(entry,0); args >> int <- jsonArrayGet(entry,1); words >> int <- jsonParse("[\"@ncc\"]"); at >> int <- 0;
                    while (at < jsonArrayLen(args)) { closure43_core.closure43Core.push(words,jsonArrayGet(args,at)); at += 1; }
                    result >> int <- retainedCommand(jsonGetString(name),words); closure43_core.closure43Core.put(records,jsonGetString(name),jsonObjectGet(result,"record"));
                    jsonRelease(entry); jsonRelease(name); jsonRelease(args); jsonRelease(words); jsonRelease(result); index += 1;
                }
                closure43_core.closure43Core.put(summary,"runtime_commands",records); sweep >> int <- jsonNewArray(); index <- 0;
                if (!closure43_core.closure43Core.ok()) return summary;
                while (index < jsonArrayLen(rows) && closure43_core.closure43Core.ok()) {
                    row >> int <- jsonArrayGet(rows,index); key >> str <- closure43_core.closure43Core.field(row,"family_key"); importPath >> str <- closure43_core.closure43Core.field(row,"import_path");
                    words >> int <- jsonParse("[\"@ncc\",\"runtime\",\"exports\"]"); closure43_core.closure43Core.push(words,jsonNewString(importPath)); closure43_core.closure43Core.push(words,jsonNewString("--json"));
                    result >> int <- retainedCommand("exports_"+key,words); payload >> int <- jsonObjectGet(result,"payload"); record >> int <- jsonObjectGet(result,"record"); exports >> int <- jsonObjectGet(payload,"exports");
                    entry >> int <- selected(row,"[\"family_key\",\"import_path\"]"); closure43_core.closure43Core.put(entry,"family_key_returned",jsonObjectGet(payload,"family_key")); closure43_core.closure43Core.put(entry,"exports",jsonNewInt(jsonArrayLen(exports)));
                    identity >> bool <- closure43_core.closure43Core.field(payload,"family_key") == key; closure43_core.closure43Core.put(entry,"ok",jsonNewBool(identity)); closure43_core.closure43Core.copyField(entry,record,"sha256");
                    if (!identity) closure43_core.closure43Core.fail("runtime export sweep found a family identity mismatch");
                    closure43_core.closure43Core.push(sweep,entry); jsonRelease(row); jsonRelease(words); jsonRelease(result); jsonRelease(payload); jsonRelease(record); jsonRelease(exports); index += 1;
                }
                if (!closure43_core.closure43Core.ok()) return summary;
                closure43_core.closure43Core.save("reports/runtime_closure/final_validation/runtime_exports_all_families.json",sweep); closure43_core.closure43Core.put(summary,"export_sweep_count",jsonNewInt(jsonArrayLen(sweep)));
                paths >> int <- closure43_core.closure43Core.files("examples/runtime/families",".n"); checks >> int <- jsonNewArray(); index <- 0;
                while (index < jsonArrayLen(paths) && closure43_core.closure43Core.ok()) {
                    path >> int <- jsonArrayGet(paths,index); record >> int <- wordCommand("check",jsonGetString(path),"--strict --json"); entry >> int <- jsonNewObject(); jsonObjectSet(entry,"path",path);
                    closure43_core.closure43Core.set(entry,"sha256",closure43_core.closure43Core.hash(closure43_core.closure43Core.field(record,"stdout"))); closure43_core.closure43Core.push(checks,entry); jsonRelease(path); jsonRelease(record); index += 1;
                }
                if (!closure43_core.closure43Core.ok()) return summary;
                closure43_core.closure43Core.save("reports/runtime_closure/final_validation/runtime_family_example_checks.json",checks); closure43_core.closure43Core.put(summary,"family_example_checks",jsonNewInt(jsonArrayLen(checks))); jsonRelease(paths);
                paths <- jsonParse("[\"examples/helloWorld.n\",\"examples/calculadoraElite.n\",\"examples/randomArraySearchHidden.n\",\"examples/sumaParesImpares.n\",\"examples/maxMinMediaArray.n\",\"examples/maxMinMediaResultados.n\",\"examples/arrayCapicua.n\"]"); runnable >> int <- jsonNewArray(); index <- 0;
                while (index < 7 && closure43_core.closure43Core.ok()) {
                    path >> int <- jsonArrayGet(paths,index); words >> int <- jsonParse("[\"@ncc\",\"run\"]"); jsonArrayPush(words,path); record >> int <- closure43_core.closure43Core.command(words,false,true,false); closure43_core.closure43Core.require(record,"ncc run "+jsonGetString(path)); entry >> int <- jsonNewObject(); jsonObjectSet(entry,"path",path);
                    closure43_core.closure43Core.set(entry,"sha256",closure43_core.closure43Core.hash(closure43_core.closure43Core.field(record,"stdout"))); closure43_core.closure43Core.push(runnable,entry); jsonRelease(path); jsonRelease(words); jsonRelease(record); index += 1;
                }
                if (!closure43_core.closure43Core.ok()) return summary;
                closure43_core.closure43Core.save("reports/runtime_closure/final_validation/runtime_required_runnable_examples.json",runnable); closure43_core.closure43Core.put(summary,"required_runnable_examples",jsonNewInt(jsonArrayLen(runnable)));
                anti >> int <- closure43_markers.closure43Markers.execute(true); closure43_markers.closure43Markers.write(anti,true); if (closure43_core.closure43Core.field(anti,"status") != "ok") closure43_core.closure43Core.fail("runtime anti-marker gate blocked F.2 closure");
                closure43_core.closure43Core.put(summary,"anti_marker_gate",closure43_gates.closure43Gates.markerSummary(anti)); closure43_core.closure43Core.stamp(summary,"evidence_hash");
                jsonRelease(states); jsonRelease(commands); jsonRelease(sweep); jsonRelease(paths); jsonRelease(checks); jsonRelease(runnable); jsonRelease(anti); return summary;
            }
        public:
            execute(args >> addr) -> int {
                closure43_core.closure43Core.init(); settings >> int <- closure43_gates.closure43Gates.options(args); if (settings == 0) return 2; if (!closure43_core.closure43Core.ok()) return 1;
                closure43_core.closure43Core.commandStyle("runtime");
                if (closure43_options.closure43Options.help(settings,"runtime")) return 0;
                data >> int <- closure43_core.closure43Core.load("runtime"); if (!closure43_core.closure43Core.ok()) return 1;
                build >> int <- closure43_core.closure43Core.run("[\"cargo\",\"build\",\"-p\",\"ncc-cli\",\"--bin\",\"ncc\"]",true,false,false); jsonRelease(build);
                if (release_io.releaseIo.fileType(closure43_core.closure43Core.ncc()) == 0) closure43_core.closure43Core.fail("ncc binary not found: "+closure43_core.closure43Core.ncc());
                if (!closure43_core.closure43Core.ok()) return 1;
                generated >> str <- closure43_core.closure43Core.iso(); families >> int <- query("families",""); capabilityDoc >> int <- query("capabilities",""); policyDoc >> int <- query("policies",""); errorDoc >> int <- query("errors","");
                if (!closure43_core.closure43Core.ok()) return 1;
                capabilities >> int <- jsonObjectGet(capabilityDoc,"catalog"); policies >> int <- jsonObjectGet(policyDoc,"catalog"); errors >> int <- jsonObjectGet(errorDoc,"errors"); rows >> int <- jsonObjectGet(families,"rows");
                discovered >> int <- jsonNewArray(); matrices >> int <- jsonNewArray(); manifests >> int <- jsonNewArray(); indices >> int <- jsonNewArray(); aggregateRows >> int <- jsonNewArray(); index >> int <- 0; counts >> int <- jsonParse("{\"closed\":0,\"partial\":0,\"deferred\":0,\"broken\":0,\"blocked\":0}");
                while (index < jsonArrayLen(rows) && closure43_core.closure43Core.ok()) {
                    row >> int <- jsonArrayGet(rows,index); key >> str <- closure43_core.closure43Core.field(row,"family_key"); importPath >> str <- closure43_core.closure43Core.field(row,"family"); positive >> str <- "examples/runtime/families/"+key+"_basic.n";
                    closure43_core.closure43Core.set(row,"import_path",importPath); closure43_core.closure43Core.put(row,"aliases",aliases(row,false)); errorRows >> int <- diagnostics(errors,key); closure43_core.closure43Core.put(row,"diagnostics",codes(errorRows)); jsonRelease(errorRows);
                    closure43_core.closure43Core.set(row,"docs_path","docs/spec/runtime/imports/"+key+".md"); closure43_core.closure43Core.set(row,"tests_path","crates/ncc-cli/tests/runtime_family_closure.rs"); closure43_core.closure43Core.set(row,"examples_path",positive);
                    byImport >> int <- query("exports",importPath); byKey >> int <- query("exports",key); exports >> int <- jsonObjectGet(byImport,"exports"); closure43_core.closure43Core.write(positive,example(data,key)); if (!closure43_core.closure43Core.ok()) return 1;
                    imports >> int <- wordCommand("imports",positive,"--json"); check >> int <- wordCommand("check",positive,"--strict --json"); report >> int <- wordCommand("report",positive,"--json"); markdown >> int <- wordCommand("report",positive,"--md"); if (!closure43_core.closure43Core.ok()) return 1;
                    reportValue >> int <- closure43_core.closure43Core.payload(report,true); if (!closure43_core.closure43Core.ok()) return 1; reportJson >> str <- "reports/runtime_closure/runtime_reports/"+key+".json"; reportMd >> str <- "reports/runtime_closure/runtime_reports/"+key+".md";
                    closure43_core.closure43Core.save(reportJson,reportValue); closure43_core.closure43Core.write(reportMd,closure43_core.closure43Core.field(markdown,"stdout"));
                    caps >> int <- jsonObjectGet(row,"required_capabilities"); policyValues >> int <- jsonObjectGet(row,"required_policies"); unknownCaps >> int <- missing(caps,capabilities); unknownPolicies >> int <- missing(policyValues,policies); mixed >> int <- jsonNewArray(); at >> int <- 0;
                    while (key == "queue" && at < jsonArrayLen(exports)) { exportRow >> int <- jsonArrayGet(exports,at); name >> str <- closure43_core.closure43Core.field(exportRow,"name"); if (strStartsWith(strToLower(name),"list")) closure43_core.closure43Core.push(mixed,jsonNewString(name)); jsonRelease(exportRow); at += 1; }
