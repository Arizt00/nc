use <process:args>;
use <io:output>;
use <project:closure43_primitive, closure43_machine, closure43_compiler, closure43_runtime>;

closure43Cli {
    fn:
        public:
            execute(arguments >> addr, command >> str) -> int {
                if (command == "generate-primitive-real-closure") {
                    index >> int <- 1;
                    while (index < argsCount(arguments)) {
                        argument >> str <- argsAt(arguments,index);
                        if (argument == "-h" || argument == "--help") {
                            println("usage: ncc-closures-v43 generate-primitive-real-closure [-h|--help]\n\nGenerate primitive real closure reports and documentation.\n\n  -h, --help  Show this help and exit without initializing or writing the workspace.\n\nOther arguments remain ignored, as in the retained original generator.");
                            return 0;
                        }
                        index += 1;
                    }
                    return closure43_primitive.closure43Primitive.execute(arguments);
                }
                if (command == "generate-machine-closure") return closure43_machine.closure43Machine.execute(arguments);
                if (command == "generate-compiler-closure") return closure43_compiler.closure43Compiler.execute(arguments);
                if (command == "generate-runtime-closure") return closure43_runtime.closure43Runtime.execute(arguments);
                println("closure43: unsupported command: "+command); return 2;
            }
    fa: return true;
}
