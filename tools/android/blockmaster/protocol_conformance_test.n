use <process:args>;
use <project:mobile43_conformance>;

protocolConformanceTest {
    fn:
        run() -> int {
            arguments >> addr <- argsOpen();
            result >> int <- mobile43_conformance.mobile43Conformance.execute(arguments,1);
            argsRelease(arguments); return result;
        }
    ref main ->> run;
    fa: return true;
}
