<idea-plugin>
    <id>dev.nc.language</id>
    <name>nC Language</name>
    <vendor email="oss@nc.dev" url="https://github.com/aristtote/nc-language.git">nC Project</vendor>
    <version>1.0.0.21v</version>
    <idea-version since-build="242" until-build="262.*"/>
    <description>
        <![CDATA[
        Official nC language integration for JetBrains IDEs.
        Routes high-level files to nclsp and machine files to nc-sys-lsp.
        Semantic authority remains in ncc.
        License: MIT OR Apache-2.0.
        ]]>
    </description>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="nC Source" implementationClass="dev.nc.jetbrains.NcFileType" fieldName="INSTANCE" language="nC" extensions="n"/>
        <fileType name="nC Basal Root" implementationClass="dev.nc.jetbrains.NcRootFileType" fieldName="INSTANCE" language="nC" extensions="nb"/>
        <fileType name="nC Primitive" implementationClass="dev.nc.jetbrains.NcPrimitiveFileType" fieldName="INSTANCE" language="nC" extensions="nbb"/>
        <fileType name="nC Machine" implementationClass="dev.nc.jetbrains.NcMachineFileType" fieldName="INSTANCE" language="nC" extensions="nm"/>
        <fileType name="nC Backend Object IR" implementationClass="dev.nc.jetbrains.NcBackendObjectFileType" fieldName="INSTANCE" language="nC" extensions="nbo"/>
        <fileType name="nC Physical Hardware" implementationClass="dev.nc.jetbrains.NcHardwareFileType" fieldName="INSTANCE" language="nC" extensions="ncp"/>
        <lang.parserDefinition language="nC" implementationClass="dev.nc.jetbrains.NcParserDefinition"/>
        <lang.syntaxHighlighterFactory language="nC" implementationClass="dev.nc.jetbrains.NcSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="nC" implementationClass="dev.nc.jetbrains.NcBraceMatcher"/>
        <colorSettingsPage implementation="dev.nc.jetbrains.NcColorSettingsPage"/>
        <completion.contributor language="nC" implementationClass="dev.nc.jetbrains.NcCompletionContributor"/>
        <codeInsight.inlayProvider language="nC" implementationClass="dev.nc.jetbrains.NcInlayHintsProvider"/>
        <lang.documentationProvider language="nC" implementationClass="dev.nc.jetbrains.NcDocumentationProvider"/>
        <gotoDeclarationHandler implementation="dev.nc.jetbrains.NcGotoDeclarationHandler"/>
        <annotator language="nC" implementationClass="dev.nc.jetbrains.NcImportAnnotator"/>
        <editorFactoryListener implementation="dev.nc.jetbrains.NcAutoImportTypingListener"/>
        <configurationType implementation="dev.nc.jetbrains.NcRunConfigurationType"/>
        <runConfigurationProducer implementation="dev.nc.jetbrains.NcRunConfigurationProducer"/>
        <programRunner implementation="dev.nc.jetbrains.NcDebugProgramRunner"/>
    </extensions>

    <actions>
        <action id="Nc.ResolveToolchain" class="dev.nc.jetbrains.NcResolveToolchainAction" text="nC: Resolve Toolchain"/>
        <action id="Nc.RouteLsp" class="dev.nc.jetbrains.NcRouteLspAction" text="nC: Route LSP Backend"/>
        <action id="Nc.RunActiveFile" class="dev.nc.jetbrains.NcRunActiveFileAction" text="nC: Run Active File"/>
        <action id="Nc.DebugActiveFile" class="dev.nc.jetbrains.NcDebugActiveFileAction" text="nC: Debug Active File"/>
        <group id="Nc.ToolsMenu" text="nC" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <reference ref="Nc.RunActiveFile"/>
            <reference ref="Nc.DebugActiveFile"/>
            <reference ref="Nc.ResolveToolchain"/>
            <reference ref="Nc.RouteLsp"/>
        </group>
    </actions>
</idea-plugin>
