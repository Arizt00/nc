use <fs:dir>;

nativeFsCreateFailuresV61 {
    identity(result >> Result<bool, FsError>) -> Result<bool, FsError> { return result; }
    run() -> int {
        existing >> Result<bool, FsError> <- identity(createDir("."));
        empty >> Result<bool, FsError> <- createDir("");
        absent >> Result<bool, FsError> <- createDir(null);
        guard isErr(existing) && !isOk(existing) && isErr(empty) && isErr(absent) else return 1;
        return 165;
    }
    ref main ->> run;
    fa: return true;
}
