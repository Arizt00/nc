nativeRepeatControl {
    run() -> int {
        i >> int <- 0; sum >> int <- 0;
        repeat {
            i += 1;
            if (i == 2) continue;
            sum += i;
            if (i == 4) break;
        } until (i >= 9);
        j >> int <- 0;
        do {
            j += 1;
            if (j < 3) continue;
        } while (j < 3);
        once >> int <- 0;
        repeat { once += 1; } until (true);
        nested >> int <- 0;
        while (nested < 2) {
            inner >> int <- 0;
            repeat { inner += 1; if (inner == 2) break; } until (false);
            if (inner != 2) return 1;
            nested += 1;
        }
        return i == 4 && sum == 8 && j == 3 && once == 1 && nested == 2 ? 180 : 1;
    }
    ref main ->> run;
    fa: return true;
}
