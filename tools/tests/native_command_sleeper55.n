use <process:command>;
use <io:std>;
nativeCommandSleeper55 {
    run() -> int {
        data >> p<byte> <- cast<byte>(calloc(1,25));
        guard data != null else return 1;
        wr<addr>(data,stdIn());
        commandPipeRead(adr(data),adr(off(data,24)),1);
        free(data); return 74;
    }
    ref main ->> run;
    fa: return true;
}
