nativeSignedWide69 {
    divide(value >> i64, divisor >> i64) -> i64 { return value / divisor; }
    run() -> int {
        value >> i64 <- -4294967296;
        divisor >> i64 <- 2;
        if (value / divisor != -2147483648) return 1;
        if (value % 3 != -1) return 2;
        if (value >> 32 != -1) return 3;
        if (divide(value,divisor) != -2147483648) return 4;
        widened >> u64 <- value / divisor;
        if (widened != 18446744071562067968) return 5;
        unsignedValue >> u64 <- 0xFFFFFFFFFFFFFFFF;
        narrowed >> i64 <- unsignedValue / 2;
        if (narrowed != 9223372036854775807) return 6;
        if (unsignedValue % 10 != 5 || unsignedValue >>> 63 != 1) return 7;
        return 227;
    }
    ref main ->> run;
    fa: return true;
}
