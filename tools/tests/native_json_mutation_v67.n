use <data:json>;
use <io:output>;

nativeJsonMutation67 {
    run() -> int {
        array >> int <- jsonNewArray();
        value >> int <- jsonNewInt(10);
        if (!jsonArrayInsert(array, 0, value)) return 1;
        jsonRelease(value);
        value <- jsonNewInt(30);
        if (!jsonArrayInsert(array, 1, value)) return 2;
        jsonRelease(value);
        value <- jsonNewInt(20);
        if (!jsonArrayInsert(array, 1, value)) return 3;
        if (jsonArrayInsert(array, -1, value) || jsonArrayInsert(array, 4, value)) return 4;
        jsonRelease(value);
        if (jsonArrayLen(array) != 3) return 5;
        middle >> int <- jsonArrayRemove(array, 1);
        if (jsonGetInt(middle) != 20 || jsonArrayLen(array) != 2) return 6;
        jsonRelease(middle);
        tail >> int <- jsonArrayRemove(array, 1);
        if (jsonGetInt(tail) != 30) return 7;
        jsonRelease(tail);
        value <- jsonNewInt(40);
        if (!jsonArrayInsert(array, 1, value)) return 8;
        jsonRelease(value);
        head >> int <- jsonArrayRemove(array, 0);
        if (jsonGetInt(head) != 10) return 9;
        jsonRelease(head);
        tail <- jsonArrayRemove(array, 0);
        if (jsonArrayLen(array) != 0 || jsonArrayRemove(array, 0) != 0) return 10;
        jsonRelease(array);
        if (jsonGetInt(tail) != 40) return 11;
        jsonRelease(tail);
        println("json-mutation-ok");
        return 213;
    }
    ref main ->> run;
    fa: return true;
}
