use <data:json>;
use <project:json>;
jsonProviderProbe54 {
    run() -> int {
        root >> int <- json.jsonProvider54.jsonNewObject();
        value >> int <- json.jsonProvider54.jsonNewBool(true);
        guard root > 0 && value > 0 && json.jsonProvider54.jsonObjectSet(root,"flag",value) else return 1;
        json.jsonProvider54.jsonRelease(value);
        read >> int <- json.jsonProvider54.jsonObjectBorrow(root,"flag");
        ok >> bool <- json.jsonProvider54.jsonGetBool(read);
        json.jsonProvider54.jsonRelease(read); json.jsonProvider54.jsonRelease(root);
        return ok ? 130 : 2;
    }
    ref main ->> run;
    fa: return true;
}
