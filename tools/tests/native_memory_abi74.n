use <io:output>;
use <project:memory_abi>;

nativeMemoryAbi74 {
    run() -> int {
        if (!memory_abi.nccMemoryAbi.selfTest()) return 1;
        if (memory_abi.nccMemoryAbi.resolve(null,20) != 0 ||
            memory_abi.nccMemoryAbi.resolve(cast<byte>("other"),5) != 0) return 2;
        if (memory_abi.nccMemoryAbi.resolve(cast<byte>("vmReadWriteProtection"),21) != 18) return 3;
        if (memory_abi.nccMemoryAbi.arity(13) != 6 || memory_abi.nccMemoryAbi.arity(17) != 6 ||
            memory_abi.nccMemoryAbi.arity(18) != 0) return 4;
        if (memory_abi.nccMemoryAbi.resultCode(102) != 20 ||
            memory_abi.nccMemoryAbi.resultCode(103) != 20 ||
            memory_abi.nccMemoryAbi.resultCode(4) != 33) return 5;
        if (memory_abi.nccMemoryAbi.argumentCode(101,0) != 8 ||
            memory_abi.nccMemoryAbi.argumentCode(101,2) != 4 ||
            memory_abi.nccMemoryAbi.argumentCode(101,4) != -1) return 6;
        if (!memory_abi.nccMemoryAbi.pointerArgument(103,3) ||
            memory_abi.nccMemoryAbi.pointerArgument(103,2)) return 7;
        if (memory_abi.nccMemoryAbi.owner(3) != "vm" ||
            memory_abi.nccMemoryAbi.owner(101) != "os_windows" ||
            memory_abi.nccMemoryAbi.owner(201) != "os_linux") return 8;
        if (memory_abi.nccMemoryAbi.arity(111) != 6 ||
            memory_abi.nccMemoryAbi.argumentCode(111,0) != 8 ||
            memory_abi.nccMemoryAbi.argumentCode(111,1) != 4 ||
            memory_abi.nccMemoryAbi.argumentCode(111,3) != 4 ||
            memory_abi.nccMemoryAbi.argumentCode(111,4) != 8 ||
            memory_abi.nccMemoryAbi.argumentCode(111,5) != 8 ||
            !memory_abi.nccMemoryAbi.pointerArgument(111,5)) return 9;
        println("native-memory-abi-ok");
        return 246;
    }
    ref main ->> run;
    fa: return true;
}
