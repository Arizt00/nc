use <project:json_bool_default_provider>;

jsonBoolDefaultProviderNative57 {
    run() -> int {
        yes >> int <- jsonNewBool(true);
        no >> int <- jsonNewBool(false);
        guard yes > 0 && no > 0 else return 1;
        guard json_bool_default_provider.jsonBoolDefaultProvider.provider_json_jsonGetBoolOr(yes,false) &&
            !json_bool_default_provider.jsonBoolDefaultProvider.provider_json_jsonGetBoolOr(no,true) &&
            json_bool_default_provider.jsonBoolDefaultProvider.provider_json_jsonGetBoolOr(0,true) &&
            !json_bool_default_provider.jsonBoolDefaultProvider.provider_json_jsonGetBoolOr(0,false) else return 2;
        guard jsonRelease(yes) && jsonRelease(no) else return 3;
        return 139;
    }
    ref main ->> run;
    fa: return true;
}
