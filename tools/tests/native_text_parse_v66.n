use <io:output>;
use <text:parse, string>;

nativeTextParse66 {
    run() -> int {
        if (parseInt("  -0x7F_ff\n") != -32767 || parseInt("+0b101_001") != 41) return 1;
        if (parseInt("0o755") != 493 || parseInt("2147483648") != -2147483648) return 2;
        if (parseInt("1__2") != 0 || parseInt("_1") != 0 || parseInt("1_") != 0 || parseInt("0x") != 0) return 3;
        missing >> str <- cast<str>(null);
        if (parseInt("12x") != 0 || parseInt("") != 0 || parseInt(missing) != 0) return 4;
        if (parseUInt("0xFFFF_FFFF_FFFF_FFFF") != 0xFFFFFFFFFFFFFFFF || parseUInt("-1") != 0) return 5;
        if (parseUInt("18446744073709551616") != 0 || parseUInt("+0o777") != 511) return 6;
        if (!parseBool(" \tTrUe\r") || parseBool("FALSE") || !parseBool("1") || parseBool("yes")) return 7;
        if (charCode(parseChar("  Zrest")) != 90 || charCode(parseChar("  ")) != 0) return 8;
        value >> int <- 719;
        if (tryParseInt("invalid",&value) || value != 719 || !tryParseInt("-42",&value) || value != -42) return 9;
        flag >> bool <- true;
        if (tryParseBool("invalid",&flag) || !flag || !tryParseBool("false",&flag) || flag) return 10;
        intOut >> p<int> <- null;
        boolOut >> p<bool> <- null;
        if (tryParseInt("1",intOut) || tryParseBool("true",boolOut)) return 11;
        println("text-parse-ok"); return 203;
    }
    ref main ->> run;
    fa: return true;
}
