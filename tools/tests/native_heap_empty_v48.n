nativeHeapEmptyV48 {
    run() -> int {
        empty >> p<byte> <- alloc(0);
        if (empty == null) return 1;
        zeroed >> p<byte> <- calloc(0,0xFFFFFFFFFFFFFFFF);
        if (zeroed == null) { free(empty); return 2; }
        return free(empty) && free(zeroed) && free(null) ? 74 : 3;
    }
    ref main ->> run;
    fa: return true;
}
