genericComparison {
    const:
        LIMIT >> u64 <- 0x7FFFFFFFFFFFFFFF;

    fail(context >> p<int>, code >> int) -> bool {
        wr(context, code);
        return false;
    }

    valid(context >> p<int>, digit >> int, base >> u64, value >> u64) -> bool {
        if (digit < 0 || digit >= base || value > (LIMIT-digit)/base)
            return fail(context, 17);
        return true;
    }

    run() -> int {
        result >> int <- 0;
        guard valid(&result, 7, 10, 42) else return 1;
        guard !valid(&result, -1, 10, 42) && result == 17 else return 2;
        result <- 0;
        guard !valid(&result, 10, 10, 42) && result == 17 else return 3;
        result <- 0;
        guard !valid(&result, 7, 10, LIMIT) && result == 17 else return 4;
        guard valid(&result, 0, 10, LIMIT/10) else return 5;
        return 117;
    }

    ref main ->> run;
    fa:
        return true;
}
