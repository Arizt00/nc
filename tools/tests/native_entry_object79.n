use <process:args>;
use <project:elf_entry>;

nativeEntryObject79 {
    run() -> int {
        arguments >> addr <- argsOpen();
        if (arguments == null || argsCount(arguments) != 2) return 64;
        valid >> bool <- elf_entry.elfEntry79.write(argsAt(arguments,1));
        argsRelease(arguments); return valid ? 0 : 1;
    }
    ref main ->> run;
    fa: return true;
}
