use <data:json>;
use <io:output>;
use <project:rows>;

nativeJsonUnitsV54 {
    run() -> int {
        row >> int <- rows.jsonRowsV54.open(true);
        guard row > 0 else return 1;
        guard rows.jsonRowsV54.ready(row) else return 2;
        text >> str <- jsonStringify(row);
        guard text == "{\"ready\":true}" else return 3;
        println(text);
        free(cast<byte>(text));
        rows.jsonRowsV54.close(row);
        return 131;
    }
    ref main ->> run;
    fa: return true;
}
