use <data:json>;

jsonRowsV54 {
    fn:
        public:
    open(ready >> bool) -> int {
        row >> int <- jsonNewObject();
        value >> int <- jsonNewBool(ready);
        guard row > 0 && value > 0 else {
            jsonRelease(row); jsonRelease(value); return 0;
        }
        stored >> bool <- jsonObjectSet(row,"ready",value);
        jsonRelease(value);
        if (!stored) { jsonRelease(row); return 0; }
        return row;
    }
    ready(row >> int) -> bool {
        value >> int <- jsonObjectBorrow(row,"ready");
        answer >> bool <- jsonGetBool(value);
        jsonRelease(value);
        return answer;
    }
    close(row >> int) -> bool { return jsonRelease(row); }
    fa: return true;
}
