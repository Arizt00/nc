use <io:output>;
use <text:string>;

nativeTextCase66 {
    run() -> int {
        source >> str <- "AbC 123 !";
        lower >> str <- strToLower(source);
        upper >> str <- strToUpper(source);
        trimmed >> str <- strTrim("\t\n AbC 123 ! \r");
        empty >> str <- strEmpty();
        clean >> str <- strTrim("\t\r\n");
        if (source != "AbC 123 !" || lower != "abc 123 !" || upper != "ABC 123 !") return 1;
        if (trimmed != source || empty != "" || clean != "") return 2;
        bytes >> p<byte> <- cast(alloc(4));
        wr(bytes,195); wr(off(bytes,1),169); wr(off(bytes,2),65); wr(off(bytes,3),0);
        view >> str <- cast(bytes);
        converted >> str <- strToLower(view);
        if (strByteLen(converted) != 3 || rd<byte>(cast<byte>(converted)) != 195 || rd<byte>(off(cast<byte>(converted),1)) != 169 || rd<byte>(off(cast<byte>(converted),2)) != 97) return 3;
        strRelease(lower); strRelease(upper); strRelease(trimmed); strRelease(empty); strRelease(clean); strRelease(converted); free(bytes);
        println("text-case-ok"); return 204;
    }
    ref main ->> run;
    fa: return true;
}
