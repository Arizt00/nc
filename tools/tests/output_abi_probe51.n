use <project:output_abi>;

outputAbiProbe51 {
    run() -> int {
        owner >> p<byte> <- cast<byte>("output");
        if (output_abi.nccOutputAbi.resolve(cast<byte>("print"),5,owner,6) != 1) return 1;
        if (output_abi.nccOutputAbi.resolve(cast<byte>("println"),7,owner,6) != 2) return 2;
        if (output_abi.nccOutputAbi.resolve(cast<byte>("flush"),5,owner,6) != 3) return 3;
        if (output_abi.nccOutputAbi.resolve(cast<byte>("print"),5,cast<byte>("heap"),4) != 0) return 4;
        if (output_abi.nccOutputAbi.resolve(cast<byte>("renderInt"),9,cast<byte>("render"),6) != 10) return 5;
        if (output_abi.nccOutputAbi.validArity(1,0) || !output_abi.nccOutputAbi.validArity(1,1)) return 6;
        if (!output_abi.nccOutputAbi.validArity(2,0) || output_abi.nccOutputAbi.validArity(2,2)) return 7;
        if (!output_abi.nccOutputAbi.validArity(10,1) || output_abi.nccOutputAbi.validArity(10,0)) return 8;
        if (output_abi.nccOutputAbi.machineArity(1) != 2 || output_abi.nccOutputAbi.machineArity(10) != 1) return 9;
        if (output_abi.nccOutputAbi.resultCode(1) != 0 || output_abi.nccOutputAbi.resultCode(10) != 34) return 10;
        if (output_abi.nccOutputAbi.argumentCode(10) != 20 || output_abi.nccOutputAbi.argumentCode(12) != 35) return 11;
        if (output_abi.nccOutputAbi.valueTag(35,false,false) != 4 || output_abi.nccOutputAbi.valueTag(34,false,false) != 5) return 12;
        if (output_abi.nccOutputAbi.valueTag(8,false,true) != 6 || output_abi.nccOutputAbi.valueTag(8,false,false) != 1) return 13;
        if (output_abi.nccOutputAbi.valueTag(24,false,false) != 2 || output_abi.nccOutputAbi.valueTag(-1,false,false) != -1) return 14;
        return 111;
    }
    ref main ->> run;
    fa: return true;
}
