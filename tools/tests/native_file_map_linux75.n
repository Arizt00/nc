use <io:output, render>;
use <process:args>;

nativeFileMapLinux75 {
    const:
        PAGE >> u64 <- 4096;
        GRAN >> u64 <- 65536;
        BYTES >> u64 <- 135168;
        HIGH >> u64 <- 0x100010000;

    pattern(at >> u64) -> byte { return (at * 37 + 11) & 255; }
    expected(at >> u64, high >> bool) -> byte {
        if (!high && at == PAGE-1) return 211;
        if (!high && at == GRAN+23) return 165;
        return pattern(at);
    }
    path(high >> bool) -> str { return high ? "file75-high.bin" : "file75-main.bin"; }
    fail(code >> int) -> int {
        error >> int <- vmLastError();
        print("linux-file-map-failure "); print(code);
        print(" errno "); println(error);
        return code;
    }
    writeFile(high >> bool) -> int {
        name >> str <- path(high);
        file >> i64 <- syscall6(257,-100,adr(name),0xC2,384,0,0);
        if (file < 0) return fail(1);
        base >> u64 <- high ? HIGH : 0;
        bytes >> u64 <- high ? PAGE : BYTES;
        if (syscall6(77,file,base+bytes,0,0,0,0) != 0) return fail(2);
        view >> p<byte> <- vmMap(null,bytes,3,1,file,base);
        if (view == null) return fail(3);
        at >> u64 <- 0;
        while (at < bytes) { volatileWrite(off(view,at),expected(at,high)); at += 1; }
        partOffset >> u64 <- high ? HIGH : GRAN;
        part >> p<byte> <- vmMap(null,PAGE,1,1,file,partOffset);
        if (part == null) return fail(4);
        at <- 0;
        while (at < PAGE) {
            if (volatileRead(off(part,at)) != expected((high ? 0 : GRAN)+at,high)) return fail(5);
            at += 1;
        }
        copied >> p<byte> <- vmMap(null,PAGE,3,2,file,partOffset);
        if (copied == null) return fail(6);
        original >> byte <- volatileRead(off(part,17));
        volatileWrite(off(copied,17),original ^ 255);
        if (volatileRead(off(copied,17)) == original || volatileRead(off(part,17)) != original) return fail(7);
        if (!vmUnmap(copied,PAGE) || !vmUnmap(part,PAGE)) return fail(8);
        bad >> p<byte> <- vmMap(null,PAGE,1,1,file,base+1);
        if (bad != null || vmLastError() != 22) return fail(9);
        if (!vmSync(view,bytes,4) || syscall6(74,file,0,0,0,0,0) != 0) return fail(10);
        if (syscall6(3,file,0,0,0,0,0) != 0) return fail(11);
        if (volatileRead(off(view,bytes-1)) != expected(bytes-1,high)) return fail(12);
        if (!vmUnmap(view,bytes)) return fail(13);
        return 0;
    }
    readFile(high >> bool) -> int {
        name >> str <- path(high);
        file >> i64 <- syscall6(257,-100,adr(name),0,0,0,0);
        if (file < 0) return fail(14);
        base >> u64 <- high ? HIGH : 0;
        bytes >> u64 <- high ? PAGE : BYTES;
        total >> i64 <- syscall6(8,file,0,2,0,0,0);
        if (total != base+bytes) return fail(15);
        buffer >> array<byte,4096>;
        at >> u64 <- 0;
        sum >> u64 <- 0;
        while (at < bytes) {
            got >> i64 <- syscall6(17,file,adr(&buffer),PAGE,base+at,0,0);
            if (got <= 0 || got > PAGE) return fail(16);
            index >> u64 <- 0;
            while (index < got) {
                value >> byte <- rd(off(cast<byte>(&buffer),index));
                if (at+index >= bytes || value != expected(at+index,high)) return fail(17);
                sum += value;
                index += 1;
            }
            at += got;
        }
        if (at != bytes || sum != (high ? 522240 : 17233972)) return fail(18);
        if (syscall6(17,file,adr(&buffer),1,base+bytes,0,0) != 0) return fail(19);
        rejected >> p<byte> <- vmMap(null,PAGE,3,1,file,base);
        if (rejected != null || vmLastError() != 13) return fail(20);
        if (syscall6(3,file,0,0,0,0,0) != 0 || syscall6(263,-100,adr(name),0,0,0,0) != 0) return fail(21);
        return 0;
    }
    readonlyFault() -> int {
        name >> str <- path(false);
        file >> i64 <- syscall6(257,-100,adr(name),0,0,0,0);
        if (file < 0) return fail(23);
        view >> p<byte> <- vmMap(null,PAGE,1,1,file,0);
        if (view == null) return fail(24);
        volatileWrite<byte>(view,1);
        return fail(25);
    }
    run() -> int {
        arguments >> addr <- argsOpen();
        if (arguments == null || argsCount(arguments) != 2) return 64;
        if (vmPageSize() != PAGE) return fail(22);
        mode >> str <- argsAt(arguments,1);
        if (mode == "fault") return readonlyFault();
        writer >> bool <- mode == "write";
        if (!writer && mode != "read") return 65;
        first >> int <- writer ? writeFile(false) : readFile(false);
        if (first != 0) return first;
        second >> int <- writer ? writeFile(true) : readFile(true);
        if (second != 0) return second;
        argsRelease(arguments);
        println(writer ? "file-map-write-ok" : "file-map-read-ok");
        return 0;
    }
    ref main ->> run;
    fa: return true;
}
