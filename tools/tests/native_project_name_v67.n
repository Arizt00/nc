use <io:output>;
use <project:project>;

nativeProjectName67 {
    run() -> int {
        number >> u64 <- 0x123456789ABCDEF0;
        if (project.projectLeaf67.select(true, "selected") != 23) return 1;
        if (project.projectLeaf67.select(false, "selected") != 0) return 2;
        if (project.projectLeaf67.echo(number) != number) return 3;
        println("project-name-ok");
        return 215;
    }
    ref main ->> run;
    fa: return true;
}
