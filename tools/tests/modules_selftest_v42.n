use <process:args>;
use <project:modules_tests>;

modulesSelftestV42 {
    fn:
        run() -> int {
            arguments >> addr <- argsOpen();
            if (argsCount(arguments) != 2) { argsRelease(arguments); return 2; }
            code >> int <- modules_tests.modulesTests.run(argsAt(arguments,1));
            argsRelease(arguments); return code;
        }
    ref main ->> run;
    fa: return true;
}
