use <io:output, render>;

nativeWallClock69 {
    run() -> int {
        seconds >> int <- now();
        milliseconds >> int <- nowMs();
        other >> int <- timestamp();
        if (seconds <= 0 || other < seconds || other-seconds > 2) return 1;
        print("now="); println(seconds);
        print("nowMs="); println(milliseconds);
        return 225;
    }
    ref main ->> run;
    fa: return true;
}
