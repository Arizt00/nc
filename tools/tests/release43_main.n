use <process:args>;
use <io:errorOutput>;
use <project:release43_cli>;

release43Main {
    fn:
        public:
            run() -> int {
                args >> addr <- argsOpen();
                if (argsCount(args) < 2) { eprintln("release43 requires an explicit command"); argsRelease(args); return 2; }
                result >> int <- release43_cli.release43Cli.execute(args,argsAt(args,1)); argsRelease(args); return result;
            }
    ref main ->> run;
    fa: return true;
}
