use <io:output>;

nativeFixedArrays66 {
    type: Pair { public: a >> int; b >> int; }
    run() -> int {
        numbers >> array<int,4> <- [7,-11,0,2147483647];
        octets >> array<byte,4> <- [255,0,128,17];
        grid >> array<array<int,2>,2> <- [[1,2],[3,4]];
        records >> array<Pair,2> <- [Pair(a: 17,b: 19),Pair(a: 23,b: 29)];
        i >> int <- 1;
        numbers[i] += 3;
        octets[2] <- 253;
        grid[1][0] <- -31;
        records[1].b += 2;
        if (numbers[1] != -8 || numbers[0] != 7 || octets[0] != 255 || octets[2] != 253) return 1;
        if (grid[0][1] != 2 || grid[1][0] != -31 || records[0].a != 17 || records[1].b != 31) return 2;
        pointer >> p<int> <- &numbers[0];
        pointer[2] <- 42;
        middle >> p<int> <- off(pointer,1);
        if (middle[-1] != 7 || numbers[2] != 42 || adr(&numbers[3]) != adr(pointer)+12) return 3;
        println("fixed-arrays-ok"); return 209;
    }
    ref main ->> run;
    fa: return true;
}
