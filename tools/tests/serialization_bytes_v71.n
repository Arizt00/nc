use <io:output>;

serializationBytes71 {
    emitByte(value >> int) -> void {
        bytes >> p<byte> <- alloc(2);
        wr(bytes,value); wr(off(bytes,1),0);
        print(cast<str>(bytes));
        free(bytes);
    }
    change(value >> str) -> str {
        access >> str <- value;
        if (access == "unspecified") access = "internal";
        return access;
    }
    run() -> int {
        emitByte(65);
        println(change("unspecified"));
        return 239;
    }
    ref main ->> run;
    fa: return true;
}
