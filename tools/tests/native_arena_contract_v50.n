use <project:ast_arena, ast_schema>;

nativeArenaContractV50 {
    run() -> int {
        if (!ast_arena.nccAstArena.layoutValid()) return 1;
        if (ast_schema.nccAstSchema.kindName(89) != "TypeGenericParam") return 2;
        if (ast_schema.nccAstSchema.kindName(100) != "Invalid") return 3;
        arena >> p<byte> <- ast_arena.nccAstArena.open(4);
        guard arena != null else return 4;
        root >> int <- ast_arena.nccAstArena.append(arena,1,-1,1,1,0,0,0);
        child >> int <- ast_arena.nccAstArena.append(arena,3,root,2,1,0,0,1);
        ok >> bool <- root == 0 && child == 1 && ast_arena.nccAstArena.count(arena) == 2;
        ok <- ok && ast_arena.nccAstArena.validate(arena);
        ok <- ok && !ast_arena.nccAstArena.attach(arena,child,root);
        ok <- ok && ast_arena.nccAstArena.detach(arena,child);
        ok <- ok && ast_arena.nccAstArena.attach(arena,root,child);
        ok <- ok && ast_arena.nccAstArena.validate(arena);
        ast_arena.nccAstArena.close(arena);
        return ok ? 103 : 5;
    }
    ref main ->> run;
    fa: return true;
}
