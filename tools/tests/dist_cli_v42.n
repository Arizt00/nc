use <process:args>;
use <io:output>;
use <project:dist_cli>;

distCliV42 {
    fn:
        run() -> int {
            arguments >> addr <- argsOpen();
            mode >> str <- argsAt(arguments,1);
            code >> int <- 2;
            if (mode == "dist-telemetry") code <- dist_cli.distCli.execute(arguments,"telemetry");
            else if (mode == "dist-external-ops") code <- dist_cli.distCli.execute(arguments,"external-ops");
            else println("dist-v42: unknown command");
            argsRelease(arguments); return code;
        }
    ref main ->> run;
    fa: return true;
}
