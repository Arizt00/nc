use <data:json>;
use <io:output, render>;
use <process:args, env>;
use <project:stream_sha43, release43_host, release_io, cert_json>;

streamSha43Tests {
    stc:
        cases >> int;
        failed >> bool <- false;
    fn:
        private:
            check(name >> str, good >> bool) -> void {
                row >> int <- jsonNewObject();
                cert_json.certJson.put(row,"name",jsonNewString(name));
                cert_json.certJson.put(row,"passed",jsonNewBool(good));
                cert_json.certJson.push(cases,row);
                if (!good) { failed <- true; println("FAIL "+name); }
            }
            vectors(path >> str) -> void {
                text >> str <- release_io.releaseIo.text(path);
                model >> int <- jsonParse(text); free(cast<byte>(text));
                if (model == 0) { check("vector fixture present",false); return; }
                rows >> int <- jsonObjectGet(model,"vectors");
                check("vector fixture nonempty",jsonKind(rows) == 5 && jsonArrayLen(rows) == 39);
                chunks >> array<int,9> <- [1,3,7,31,64,65,127,1024,1048576];
                data >> p<byte> <- cast(alloc(1048577));
                if (data == null) { check("vector buffer",false); jsonRelease(rows); jsonRelease(model); return; }
                at >> int <- 0;
                while (at < 1048577) { value >> int <- (at*37+11)%256; wr(off(data,at),value); at += 1; }
                index >> int <- 0;
                while (index < jsonArrayLen(rows)) {
                    row >> int <- jsonArrayGet(rows,index);
                    count >> int <- release_io.releaseIo.number(row,"bytes",-1);
                    expected >> str <- cert_json.certJson.field(row,"sha256");
                    test >> int <- 0;
                    while (test < 9) {
                        context >> p<byte> <- stream_sha43.streamSha43.open();
                        good >> bool <- context != null; position >> int <- 0;
                        if (good) good <- stream_sha43.streamSha43.update(context,null,0);
                        while (position < count && good) {
                            amount >> int <- count-position < chunks[test] ? count-position : chunks[test];
                            good <- stream_sha43.streamSha43.update(context,off(data,position),amount);
                            position += amount;
                        }
                        digest >> str <- good ? stream_sha43.streamSha43.finish(context) : "";
                        check(renderInt(count)+" bytes / "+renderInt(chunks[test])+" chunk",good && digest == expected);
                        check("finalized context rejects update",!stream_sha43.streamSha43.update(context,data,1));
                        check("finalized context rejects finish",stream_sha43.streamSha43.finish(context) == "");
                        strRelease(digest); stream_sha43.streamSha43.close(context); test += 1;
                    }
                    strRelease(expected); jsonRelease(row); index += 1;
                }
                free(data); jsonRelease(rows); jsonRelease(model);
            }
            files(work >> str) -> void {
                if (release43_host.release43Host.kind(work) != 0) {
                    check("filesystem work directory must be fresh",false); return;
                }
                check("filesystem work directory created",release_io.releaseIo.makeDirectories(work));
                empty >> str <- work+"/empty.bin"; abc >> str <- work+"/abc.bin";
                unicode >> str <- work+"/datos_á_漢字.bin"; boundary >> str <- work+"/chunk-boundary.bin";
                check("empty file written",release43_host.release43Host.writeRaw(empty,cast<byte>(""),0,false) == 0);
                digest >> str <- stream_sha43.streamSha43.file(empty);
                check("empty file digest",digest == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"); strRelease(digest);
                check("abc file written",release43_host.release43Host.writeRaw(abc,cast<byte>("abc"),3,false) == 3);
                digest <- stream_sha43.streamSha43.file(abc);
                check("abc file digest",digest == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"); strRelease(digest);
                data >> p<byte> <- cast(alloc(1048577));
                if (data != null) {
                    index >> int <- 0;
                    while (index < 1048577) { value >> int <- (index*37+11)%256; wr(off(data,index),value); index += 1; }
                    check("Unicode binary file written",release43_host.release43Host.writeRaw(unicode,data,257,false) == 257);
                    digest <- stream_sha43.streamSha43.file(unicode);
                    check("Unicode binary file digest",digest == "08570fb3dfab53bcb3e8f4ca60b7331d9c603460a45d978226e18dd019468d07"); strRelease(digest);
                    check("chunk boundary file written",release43_host.release43Host.writeRaw(boundary,data,1048577,false) == 1048577);
                    digest <- stream_sha43.streamSha43.file(boundary);
                    check("chunk boundary file digest",digest == "dceb11fea27458999b9aa5d4fbea9519d01712ec5b930b228df516f0632b0fba"); strRelease(digest);
                    free(data);
                } else check("file buffer allocation",false);
                check("missing file rejected",stream_sha43.streamSha43.file(work+"/missing.bin") == "");
                check("directory read rejected",stream_sha43.streamSha43.file(work) == "");
                check("empty file removed",release43_host.release43Host.deleteFile(empty));
                check("abc file removed",release43_host.release43Host.deleteFile(abc));
                check("Unicode binary file removed",release43_host.release43Host.deleteFile(unicode));
                check("chunk boundary file removed",release43_host.release43Host.deleteFile(boundary));
                check("filesystem work directory removed",release43_host.release43Host.rmdir(work));
            }
        public:
            run() -> int {
                arguments >> addr <- argsOpen(); cases <- jsonNewArray();
                vectors(release_io.releaseIo.option(arguments,"--vectors","bootstrap/stream-sha43-vectors.json"));
                check("null update rejected",!stream_sha43.streamSha43.update(null,null,0));
                context >> p<byte> <- stream_sha43.streamSha43.open();
                check("negative update rejected",!stream_sha43.streamSha43.update(context,cast<byte>("x"),-1));
                check("null nonempty update rejected",!stream_sha43.streamSha43.update(context,null,1));
                stream_sha43.streamSha43.close(context);
                context <- stream_sha43.streamSha43.open();
                total >> p<u64> <- cast(off(context,352));
                wideLength >> u64 <- 6442451009; wr(total,wideLength);
                synthetic >> str <- stream_sha43.streamSha43.finish(context);
                lengthField >> p<byte> <- off(context,344);
                expectedBytes >> array<int,8> <- [0,0,0,12,0,0,2,8];
                byteIndex >> int <- 0;
                while (byteIndex < 8) {
                    check("64-bit SHA length byte "+renderInt(byteIndex),
                        (rd(off(lengthField,byteIndex)) & 255) == expectedBytes[byteIndex]);
                    byteIndex += 1;
                }
                strRelease(synthetic); stream_sha43.streamSha43.close(context);
                work >> str <- release_io.releaseIo.option(arguments,"--work",
                    "target/tmp/stream-sha43-fs-"+(envHas("WINDIR") ? "windows-" : "linux-")+renderInt(nowMs()));
                files(work);
                path >> str <- release_io.releaseIo.option(arguments,"--file","");
                if (path != "") {
                    expected >> str <- release_io.releaseIo.option(arguments,"--digest","");
                    digest >> str <- stream_sha43.streamSha43.file(path);
                    println("streamed digest: "+digest);
                    check("streamed file SHA256",strByteLen(expected) == 64 && digest == expected);
                    strRelease(digest);
                }
                out >> str <- release_io.releaseIo.option(arguments,"--out","target/tmp/stream-sha43-tests.json");
                report >> int <- jsonNewObject();
                cert_json.certJson.put(report,"schema",jsonNewString("nc.stream-sha256.tests.v43"));
                cert_json.certJson.put(report,"host",jsonNewString(envHas("WINDIR") ? "windows" : "linux"));
                cert_json.certJson.put(report,"passed",jsonNewBool(!failed));
                cert_json.certJson.put(report,"cases",cases);
                if (!cert_json.certJson.save(out,report)) failed <- true;
                jsonRelease(report); argsRelease(arguments);
                println(failed ? "FAILED: streaming SHA256" : "OK: streaming SHA256");
                return failed ? 1 : 0;
            }
    ref main ->> run;
    fa: return true;
}
