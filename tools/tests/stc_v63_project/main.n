use <project:left,right>;
nativeStcProject {
    fn:
        run() -> int {
            if (left.stcLeft.read() != 17 || right.stcRight.read() != 29) return 1;
            pointer >> p<int> <- left.stcLeft.address();
            wr(pointer, 41);
            if (left.stcLeft.read() != 41 || right.stcRight.read() != 29) return 2;
            left.stcLeft.add(3);
            right.stcRight.add(5);
            if (rd(pointer) != 44 || right.stcRight.read() != 34) return 3;
            return 184;
        }
    ref main ->> run;
    fa:
        return true;
}
