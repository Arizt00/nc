use <process:args>;
use <io:output>;
use <project:cert_cli>;

certMainV42 {
    fn:
        public:
            run() -> int {
                arguments >> addr <- argsOpen();
                if (argsCount(arguments) < 2) { println("ncc-tools cert-matrix --help"); argsRelease(arguments); return 2; }
                result >> int <- cert_cli.certCli.execute(arguments,argsAt(arguments,1));
                argsRelease(arguments);
                return result;
            }
    ref main ->> run;
    fa: return true;
}
