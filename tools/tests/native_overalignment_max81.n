use <io:output>;

nativeOveralignmentMax81 {
    type:
        Page { public: value >> u64; layout: align(1048576); }
    stc:
        initialized >> Page <- Page(value: 97);
        uninitialized >> Page;
        pointer >> p<u64> <- &initialized.value;
    run() -> int {
        if (alignOf(Page) != 1048576 || sizeOf(Page) != 1048576 || adr(&initialized) % 1048576 != 0 ||
            adr(&uninitialized) % 1048576 != 0 || initialized.value != 97 || uninitialized.value != 0 || rd(pointer) != 97) return 1;
        println("native-overalignment-max-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
