nativeStcAddresses {
    stc:
        a >> u64 <- 0xF123456789ABCDEF;
        b >> u64;
        first >> p<u64> <- &a;
        second >> p<u64> <- &b;
        missing >> p<byte> <- null;
    fn:
        exchange() -> void {
            wr(second, rd(first));
            wr(first, 0x8123456789ABCDEF);
        }
        run() -> int {
            if (missing != null || adr(first) != adr(&a) || adr(second) != adr(&b)) return 1;
            if (rd(first) != a || rd(second) != 0) return 2;
            exchange();
            if (a != 0x8123456789ABCDEF || b != 0xF123456789ABCDEF) return 3;
            return 183;
        }
    ref main ->> run;
    fa:
        return true;
}
