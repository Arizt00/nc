use <io:output>;
use <text:pad, string>;

nativeTextPadding66 {
    run() -> int {
        left >> str <- padLeft("ab",5,'.');
        right >> str <- padRight("ab",5,'.');
        both >> str <- padBoth("ab",5,'.');
        narrow >> str <- padBoth("abcdef",2,'-');
        negative >> str <- padLeft("abcdef",-1,'-');
        empty >> str <- padRight("",3,'x');
        if (left != "...ab" || right != "ab..." || both != ".ab..") return 1;
        if (narrow != "abcdef" || negative != "abcdef" || empty != "xxx") return 2;
        strRelease(left); strRelease(right); strRelease(both); strRelease(narrow); strRelease(negative); strRelease(empty);
        println("text-padding-ok"); return 206;
    }
    ref main ->> run;
    fa: return true;
}
