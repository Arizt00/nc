use <process:args>;
use <project:sema>;

nativeSemaProbe74 {
    run() -> int {
        arguments >> addr <- argsOpen();
        if (arguments == null || argsCount(arguments) != 2) return 64;
        result >> int <- sema.nccSema.analyzeFile(argsAt(arguments,1),true,false);
        argsRelease(arguments);
        return result;
    }
    ref main ->> run;
    fa: return true;
}
