nativeFsIoQueries {
    run() -> int {
        data >> p<byte> <- null;
        ok >> bool <- fsSize("") == -1 && fsSize(null) == -1;
        ok <- ok && fsReadInto("",data,0) == -1 && fsWriteFrom("",data,0,false) == -1;
        return ok ? 179 : 1;
    }
    ref main ->> run;
    fa: return true;
}
