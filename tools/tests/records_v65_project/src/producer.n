recordsProducer65 {
    type:
        Large {
            public:
                ready >> bool;
                a >> u64;
                b >> u64;
                c >> u64;
                d >> u64;
        }
        Pair {
            public:
                a >> u64;
                b >> u64;
        }
    fn:
        public:
            make(value >> int) -> Large { return Large(ready: true, a: value, b: 0xFEDCBA9876543210, c: 42, d: 19); }
            consume(a >> int, b >> int, c >> int, d >> int, e >> int, p >> Pair, tail >> int) -> int {
                p.a <- 99;
                return a+b+c+d+e+tail+p.b;
            }
    fa: return true;
}
