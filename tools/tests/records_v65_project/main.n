use <project:producer>;
use <io:output>;

recordsProject65 {
    type:
        Large {
            public:
                ready >> bool;
                a >> u64;
                b >> u64;
                c >> u64;
                d >> u64;
        }
        Pair {
            public:
                a >> u64;
                b >> u64;
        }
    run() -> int {
        value >> Large <- producer.recordsProducer65.make(7);
        p >> Pair <- Pair(a: 4, b: 11);
        if (!value.ready || value.a != 7 || value.b != 0xFEDCBA9876543210 || value.c != 42 || value.d != 19) return 1;
        if (producer.recordsProducer65.consume(1,2,3,4,5,p,6) != 32 || p.a != 4) return 2;
        println("records-project-ok");
        return 199;
    }
    ref main ->> run;
    fa: return true;
}
