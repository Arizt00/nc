use <io:output>;

nativeRecordWidths65 {
    type:
        Bytes1 { public: tail >> byte; }
        Bytes2 { public: prior >> Bytes1; tail >> byte; }
        Bytes3 { public: prior >> Bytes2; tail >> byte; }
        Bytes4 { public: prior >> Bytes3; tail >> byte; }
        Bytes5 { public: prior >> Bytes4; tail >> byte; }
        Bytes6 { public: prior >> Bytes5; tail >> byte; }
        Bytes7 { public: prior >> Bytes6; tail >> byte; }
        Bytes8 { public: prior >> Bytes7; tail >> byte; }
        Bytes9 { public: prior >> Bytes8; tail >> byte; }
        Bytes10 { public: prior >> Bytes9; tail >> byte; }
        Bytes11 { public: prior >> Bytes10; tail >> byte; }
        Bytes12 { public: prior >> Bytes11; tail >> byte; }
        Bytes13 { public: prior >> Bytes12; tail >> byte; }
        Bytes14 { public: prior >> Bytes13; tail >> byte; }
        Bytes15 { public: prior >> Bytes14; tail >> byte; }
        Bytes16 { public: prior >> Bytes15; tail >> byte; }
    fn:
        make1() -> Bytes1 { return Bytes1(tail: 1); }
        read1(value >> Bytes1) -> int { result >> int <- value.tail; value.tail <- 0; return result; }
        make2() -> Bytes2 { return Bytes2(prior: make1(), tail: 2); }
        read2(value >> Bytes2) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make3() -> Bytes3 { return Bytes3(prior: make2(), tail: 3); }
        read3(value >> Bytes3) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make4() -> Bytes4 { return Bytes4(prior: make3(), tail: 4); }
        read4(value >> Bytes4) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make5() -> Bytes5 { return Bytes5(prior: make4(), tail: 5); }
        read5(value >> Bytes5) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make6() -> Bytes6 { return Bytes6(prior: make5(), tail: 6); }
        read6(value >> Bytes6) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make7() -> Bytes7 { return Bytes7(prior: make6(), tail: 7); }
        read7(value >> Bytes7) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make8() -> Bytes8 { return Bytes8(prior: make7(), tail: 8); }
        read8(value >> Bytes8) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make9() -> Bytes9 { return Bytes9(prior: make8(), tail: 9); }
        read9(value >> Bytes9) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make10() -> Bytes10 { return Bytes10(prior: make9(), tail: 10); }
        read10(value >> Bytes10) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make11() -> Bytes11 { return Bytes11(prior: make10(), tail: 11); }
        read11(value >> Bytes11) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make12() -> Bytes12 { return Bytes12(prior: make11(), tail: 12); }
        read12(value >> Bytes12) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make13() -> Bytes13 { return Bytes13(prior: make12(), tail: 13); }
        read13(value >> Bytes13) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make14() -> Bytes14 { return Bytes14(prior: make13(), tail: 14); }
        read14(value >> Bytes14) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make15() -> Bytes15 { return Bytes15(prior: make14(), tail: 15); }
        read15(value >> Bytes15) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        make16() -> Bytes16 { return Bytes16(prior: make15(), tail: 16); }
        read16(value >> Bytes16) -> int { result >> int <- value.tail+value.prior.tail; value.tail <- 0; return result; }
        run() -> int {
            value1 >> Bytes1 <- make1();
            if (sizeOf(Bytes1) != 1 || read1(value1) != 1 || value1.tail != 1) return 1;
            value2 >> Bytes2 <- make2();
            if (sizeOf(Bytes2) != 2 || read2(value2) != 3 || value2.tail != 2) return 2;
            value3 >> Bytes3 <- make3();
            if (sizeOf(Bytes3) != 3 || read3(value3) != 5 || value3.tail != 3) return 3;
            value4 >> Bytes4 <- make4();
            if (sizeOf(Bytes4) != 4 || read4(value4) != 7 || value4.tail != 4) return 4;
            value5 >> Bytes5 <- make5();
            if (sizeOf(Bytes5) != 5 || read5(value5) != 9 || value5.tail != 5) return 5;
            value6 >> Bytes6 <- make6();
            if (sizeOf(Bytes6) != 6 || read6(value6) != 11 || value6.tail != 6) return 6;
            value7 >> Bytes7 <- make7();
            if (sizeOf(Bytes7) != 7 || read7(value7) != 13 || value7.tail != 7) return 7;
            value8 >> Bytes8 <- make8();
            if (sizeOf(Bytes8) != 8 || read8(value8) != 15 || value8.tail != 8) return 8;
            value9 >> Bytes9 <- make9();
            if (sizeOf(Bytes9) != 9 || read9(value9) != 17 || value9.tail != 9) return 9;
            value10 >> Bytes10 <- make10();
            if (sizeOf(Bytes10) != 10 || read10(value10) != 19 || value10.tail != 10) return 10;
            value11 >> Bytes11 <- make11();
            if (sizeOf(Bytes11) != 11 || read11(value11) != 21 || value11.tail != 11) return 11;
            value12 >> Bytes12 <- make12();
            if (sizeOf(Bytes12) != 12 || read12(value12) != 23 || value12.tail != 12) return 12;
            value13 >> Bytes13 <- make13();
            if (sizeOf(Bytes13) != 13 || read13(value13) != 25 || value13.tail != 13) return 13;
            value14 >> Bytes14 <- make14();
            if (sizeOf(Bytes14) != 14 || read14(value14) != 27 || value14.tail != 14) return 14;
            value15 >> Bytes15 <- make15();
            if (sizeOf(Bytes15) != 15 || read15(value15) != 29 || value15.tail != 15) return 15;
            value16 >> Bytes16 <- make16();
            if (sizeOf(Bytes16) != 16 || read16(value16) != 31 || value16.tail != 16) return 16;
            println("records-widths-ok");
            return 201;
        }
    ref main ->> run;
    fa: return true;
}
