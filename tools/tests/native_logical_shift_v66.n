use <io:output>;

nativeLogicalShift66 {
    stc:
        highBit >> int <- -1 >>> 31;
        highWide >> u64 <- 0xFFFFFFFFFFFFFFFF >>> 63;
    shift32(value >> int, bits >> int) -> int { return value >>> bits; }
    shift64(value >> i64, bits >> int) -> u64 { return value >>> bits; }
    run() -> int {
        if (highBit != 1 || highWide != 1) return 4;
        if (shift32(-1,31) != 1 || shift32(-2147483648,1) != 1073741824 || shift32(1,0) != 1) return 1;
        if (shift64(-1,63) != 1 || shift64(-1,32) != 0xFFFFFFFF) return 2;
        value >> u64 <- 0xFEDCBA9876543210;
        bits >> int <- 8;
        if ((value >>> bits) != 0x00FEDCBA98765432) return 3;
        println("logical-shift-ok"); return 207;
    }
    ref main ->> run;
    fa: return true;
}
