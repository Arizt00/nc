nativeLayoutStrengthV49 {
    scaled(value >> u64) -> u64 {
        return value * 8;
    }
    divided(value >> u64) -> u64 {
        return value / 4;
    }
    run() -> int {
        wide >> u64 <- 0x100000011;
        narrow >> int <- -17;
        if (scaled(wide) != 0x800000088) return 1;
        if (divided(0x800000088) != 0x200000022) return 2;
        if (narrow * 16 != -272) return 3;
        if (narrow / 4 != -4) return 4;
        return 95;
    }
    ref main ->> run;
    fa: return true;
}
