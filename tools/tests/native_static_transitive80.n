use <io:output>;
use <project:api, mid, leaf>;

nativeStaticTransitive80 {
    stc:
        stored >> api.nativeTransitiveApi80.Box <- api.nativeTransitiveApi80.Box(head: 53,
            payload: mid.nativeTransitiveMid80.Packet(prefix: 59,
                cells: [leaf.nativeTransitiveLeaf80.Cell(tag: 61,score: 6.25),leaf.nativeTransitiveLeaf80.Cell(tag: 67,score: 6.5)],
                packed: leaf.nativeTransitiveLeaf80.Packed(mark: 71,bits: 0x1234567890ABCDEF),
                word: leaf.nativeTransitiveLeaf80.Word(value: 7.5),tail: 73),sentinel: 79);
        callback >> fn(api.nativeTransitiveApi80.Box) -> api.nativeTransitiveApi80.Box <- &api.nativeTransitiveApi80.mutate;
    run() -> int {
        if (stored.head != 53 || stored.payload.prefix != 59 || stored.payload.cells[0].tag != 61 ||
            stored.payload.cells[1].tag != 67 || stored.payload.cells[0].score != 6.25 || stored.payload.cells[1].score != 6.5 ||
            stored.payload.packed.mark != 71 || stored.payload.packed.bits != 0x1234567890ABCDEF || stored.payload.word.value != 7.5 ||
            stored.payload.tail != 73 || stored.sentinel != 79 || adr(&stored) % 16 != 0) return 1;
        stored <- callback(stored);
        if (stored.payload.cells[1].tag != 68 || stored.payload.tail != 75 || stored.sentinel != 82) return 2;
        println("native-static-transitive-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
