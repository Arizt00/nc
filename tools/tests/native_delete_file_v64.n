use <io:output>;

nativeDeleteFile64 {
    fn:
        public:
            run() -> int {
                path >> str <- "delete-file-64.bin";
                dir >> str <- "delete-file-64-dir";
                if (exists(path) || exists(dir)) return 1;
                if (fsWriteFrom(path,cast<byte>("payload"),7,false) != 7) return 2;
                created >> Result<bool,FsError> <- createDir(dir);
                if (!isOk(created)) return 3;
                if (delete_file(dir) || !exists(dir)) return 4;
                if (!delete_file(path) || exists(path)) return 5;
                if (delete_file(path) || delete_file("") || delete_file(null)) return 6;
                removed >> Result<bool,FsError> <- removeDir(dir);
                if (!isOk(removed)) return 7;
                println("delete-file-ok");
                return 193;
            }
    ref main ->> run;
    fa: return true;
}
