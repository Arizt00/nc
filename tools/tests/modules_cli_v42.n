use <process:args>;
use <project:modules_verify>;

modulesCliV42 {
    fn:
        run() -> int {
            arguments >> addr <- argsOpen();
            code >> int <- 2;
            if (argsCount(arguments) > 1 && argsAt(arguments,1) == "verify-parser-modules")
                code <- modules_verify.modulesVerify.execute(arguments);
            argsRelease(arguments); return code;
        }
    ref main ->> run;
    fa: return true;
}
