use <project:string_query_provider>;

nativeStringProvider {
    run() -> int {
        part >> str <- string_query_provider.stringQueryProvider.provider_string_strSubstring("abcde",1,3);
        ok >> bool <- part == "bcd" && string_query_provider.stringQueryProvider.provider_string_strContains("abc","bc");
        ok <- ok && string_query_provider.stringQueryProvider.provider_string_strCompare("a","b") == -1;
        strRelease(part);
        return ok ? 178 : 1;
    }
    ref main ->> run;
    fa: return true;
}
