use <process:args>;
use <io:output>;
use <project:closure43_cli>;

closure43Main {
    fn:
        run() -> int {
            args >> addr <- argsOpen();
            if (argsCount(args) < 2) { argsRelease(args); println("closure43: expected generator command"); return 2; }
            code >> int <- closure43_cli.closure43Cli.execute(args,argsAt(args,1));
            argsRelease(args); return code;
        }
    ref main ->> run;
    fa: return true;
}
