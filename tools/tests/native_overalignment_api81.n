use <project:leaf>;

nativeOveralignmentApi81 {
    type:
        Box { public: tag >> byte; cell >> leaf.nativeOveralignmentLeaf81.Cell; end >> u64; }
    fn:
        public:
        make() -> Box { return Box(tag: 7,cell: leaf.nativeOveralignmentLeaf81.read(),end: 11); }
        change(value >> Box) -> Box {
            if (adr(&value) % 512 != 0 || adr(&value.cell) % 512 != 0) return Box(tag: 0,cell: leaf.nativeOveralignmentLeaf81.Cell(value: 0,other: 0.0),end: 0);
            value.cell <- leaf.nativeOveralignmentLeaf81.change(value.cell); value.end += 2; return value;
        }
        ready() -> bool { return leaf.nativeOveralignmentLeaf81.aligned(); }
    fa: return true;
}
