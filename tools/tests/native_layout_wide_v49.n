nativeLayoutWideV49 {
    type:
        Huge { public: payload >> array<byte, 4294967312>; }
    run() -> int {
        bytes >> u64 <- sizeOf(Huge);
        if (bytes != 0x100000010) return 1;
        if (alignOf(Huge) != 1 || offsetOf<Huge>(payload) != 0) return 2;
        return 93;
    }
    ref main ->> run;
    fa: return true;
}
