use <io:output>;
use <project:platform_abi, memory_abi>;

nativePlatformContract76 {
    run() -> int {
        if (!platform_abi.nccPlatformAbi.selfTest() || !memory_abi.nccMemoryAbi.selfTest()) return 1;
        phase >> int <- 0;
        count >> int <- 0;
        while (phase < 2) {
            id >> int <- phase == 0 ? 300 : 1000;
            end >> int <- phase == 0 ? 346 : 1037;
            while (id < end) {
                arity >> int <- memory_abi.nccMemoryAbi.arity(id);
                result >> int <- memory_abi.nccMemoryAbi.resultCode(id);
                if (arity < 0 || arity > 10 || (result != 0 && result != 4 && result != 8 && result != 20 && result != 24)) return 2;
                if (memory_abi.nccMemoryAbi.owner(id) != (phase == 0 ? "os_windows" : "os_linux")) return 3;
                if (memory_abi.nccMemoryAbi.argumentCode(id,arity) != -1 || memory_abi.nccMemoryAbi.pointerArgument(id,-1)) return 4;
                at >> int <- 0;
                while (at < arity) {
                    code >> int <- memory_abi.nccMemoryAbi.argumentCode(id,at);
                    if (code != 4 && code != 8 && code != 20 && code != 24) return 5;
                    if (memory_abi.nccMemoryAbi.pointerArgument(id,at) && code != 8) return 6;
                    at += 1;
                }
                count += 1;
                id += 1;
            }
            phase += 1;
        }
        if (count != 83) return 7;
        println("native-platform-abi-ok");
        return 0;
    }
    ref main ->> run;
    fa: return true;
}
