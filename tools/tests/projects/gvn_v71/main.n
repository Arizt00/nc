use <io:output>;

gvnProgram71 {
    assignment(value >> int) -> int {
        value = value + 1;
        result >> int <- value + 1;
        return result;
    }
    unary(value >> int) -> int {
        first >> int <- -value;
        second >> int <- -value;
        third >> int <- -1;
        fourth >> int <- -1;
        return first + second + third + fourth;
    }
    arithmetic(value >> i64) -> i64 {
        first >> i64 <- (value * 3) + 11;
        second >> i64 <- (value * 3) + 11;
        return first + second;
    }
    widths(value >> int) -> int {
        narrow >> byte <- -value;
        wide >> int <- -value;
        again >> byte <- -value;
        return narrow + again + wide;
    }
    branch(value >> int) -> int {
        result >> int <- 0;
        if (value > 0) {
            first >> int <- -value;
            second >> int <- -value;
            result = first + second;
        } else {
            first >> int <- value * 3;
            second >> int <- value * 3;
            result = first + second;
        }
        return result;
    }
    memory(pointer >> p<int>) -> int {
        first >> int <- rd(pointer) + 1;
        wr(pointer,9);
        second >> int <- rd(pointer) + 1;
        return first + second;
    }
    run() -> int {
        if (assignment(7) != 9) return 7;
        if (unary(7) != -16) return 1;
        if (arithmetic(4294967296) != 25769803798) return 2;
        if (widths(1) != 509) return 3;
        if (branch(7) != -14 || branch(-3) != -18) return 4;
        cell >> int <- 3;
        if (memory(&cell) != 14 || cell != 9) return 5;
        iteration >> int <- 0;
        total >> int <- 0;
        while (iteration < 10000) {
            total += unary(iteration);
            iteration += 1;
        }
        if (total != -100010000) return 6;
        println("gvn-program-ok");
        return 237;
    }
    ref main ->> run;
    fa: return true;
}
