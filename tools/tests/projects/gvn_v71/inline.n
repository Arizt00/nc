use <io:output>;

inlineProgram71 {
    type:
        Triple { public: left >> i64; middle >> i64; right >> i64; }
    fn:
        private:
            validLink(value >> int, limit >> int) -> bool { return value >= 0 && value < limit; }
            twice(value >> int) -> int { return value+value; }
            narrow(value >> byte) -> byte { return value+1; }
            pointer(value >> p<int>) -> p<int> { return value; }
            identity<T>(value >> T) -> T { return value; }
            constant() -> int { return 17; }
        public:
            run() -> int {
                value >> int <- 21;
                if (!validLink(2,4) || validLink(-1,4) || validLink(4,4)) return 1;
                if (twice(value) != 42 || narrow(255) != 0 || constant() != 17) return 2;
                if (rd(pointer(&value)) != 21) return 3;
                source >> Triple <- Triple(left:4294967296,middle:77,right:-19);
                copied >> Triple <- identity<Triple>(source);
                copied.right = 11;
                if (source.right != -19 || copied.left != 4294967296 || copied.middle != 77 || copied.right != 11) return 4;
                println("native-inline-program-ok");
                return 247;
            }
    ref main ->> run;
    fa: return true;
}
