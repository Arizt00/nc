use <io:output>;

reachabilityProgram71 {
    fn:
        private:
            odd(value >> int) -> int {
                if (value <= 0) return 41;
                return even(value-1);
            }
            even(value >> int) -> int {
                if (value <= 0) return 42;
                return odd(value-1);
            }
            twice(value >> int) -> int { return value*2; }
            unused(value >> int) -> int { return value+1000; }
        public:
            callback() -> fn(int) -> int { return &twice; }
            run() -> int {
                selected >> fn(int) -> int <- callback();
                if (selected(21) != 42 || odd(6) != 41 || even(6) != 42) return 1;
                println("reachability-program-ok");
                return 246;
            }
    ref main ->> run;
    fa: return true;
}
