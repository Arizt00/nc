use <io:output>;
use <project:api>;

signatureAggregates71 {
    type:
        LocalPair {
            public:
                left >> i64;
                right >> i64;
            layout: align(16);
        }
        Triple { public: first >> i64; second >> i64; third >> i64; }
    run() -> int {
        pair >> LocalPair <- LocalPair(
            left:4294967296,right:77
        );
        copied >> api.signatureApi71.Wide <- api.signatureApi71.identity<api.signatureApi71.Wide>(pair);
        repeated >> api.signatureApi71.Wide <- api.signatureApi71.repeat<api.signatureApi71.Wide>(copied,9);
        if (repeated.left != 4294967296 || repeated.right != 77) return 1;
        changed >> api.signatureApi71.Wide <- api.signatureApi71.advance(repeated);
        if (changed.left != 4294967297 || changed.right != 76) return 2;
        numbers >> array<int,3> <- [7,11,13];
        arrayCopy >> array<int,3> <- api.signatureApi71.identity<array<int,3>>(numbers);
        arrayAgain >> array<int,3> <- api.signatureApi71.repeat<array<int,3>>(arrayCopy,9);
        if (arrayAgain[0] != 7 || arrayAgain[1] != 11 || arrayAgain[2] != 13) return 3;
        triple >> Triple <- Triple(first:4294967296,second:77,third:-19);
        tripleCopy >> Triple <- api.signatureApi71.identity<Triple>(triple);
        tripleAgain >> Triple <- api.signatureApi71.repeat<Triple>(tripleCopy,9);
        if (tripleAgain.first != 4294967296 || tripleAgain.second != 77 || tripleAgain.third != -19) return 4;
        println("aggregate-generics-ok");
        return 245;
    }
    ref main ->> run;
    fa: return true;
}
