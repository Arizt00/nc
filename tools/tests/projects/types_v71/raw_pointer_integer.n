use <io:output>;
use <project:api>;
rawPointerInteger71 {
    run() -> int {
        cell >> int <- 7;
        pointer >> p<int> <- &cell;
        actual >> int <- api.signatureApi71.identity<int>(pointer);
        expected >> int <- cast<int>(adr(pointer));
        if (actual != expected) return 1;
        println("raw-address-conversion-ok");
        return 243;
    }
    ref main ->> run;
    fa: return true;
}
