use <io:output>;
use <project:api>;

signatureProgram71 {
    forward(value >> api.signatureApi71.Packet) -> api.signatureApi71.Packet {
        return api.signatureApi71.identity<api.signatureApi71.Packet>(value);
    }
    run() -> int {
        packet >> api.signatureApi71.Packet <- api.signatureApi71.make(31);
        if (packet.value != 31 || packet.flags != 7) return 1;
        number >> int <- api.signatureApi71.identity<int>(15);
        narrow >> byte <- api.signatureApi71.identity<byte>(255);
        wide >> i64 <- api.signatureApi71.identity<i64>(4294967296);
        if (number != 15 || narrow != 255 || wide != 4294967296) return 2;
        copied >> api.signatureApi71.Packet <- api.signatureApi71.identity<api.signatureApi71.Packet>(packet);
        if (copied.value != 31 || copied.flags != 7) return 3;
        recursive >> api.signatureApi71.Packet <- api.signatureApi71.repeat<api.signatureApi71.Packet>(copied,17);
        if (recursive.value != 31 || recursive.flags != 7 || forward(recursive).value != 31) return 5;
        if (api.signatureApi71.read<int>(&number) != 15) return 6;
        count >> int <- 0;
        total >> int <- 0;
        while (count < 10000) {
            total += api.signatureApi71.identity<int>(count);
            count += 1;
        }
        if (total != 49995000) return 4;
        println("types-generics-ok");
        return 238;
    }
    ref main ->> run;
    fa: return true;
}
