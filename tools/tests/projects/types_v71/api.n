signatureApi71 {
    type:
        Packet { public: value >> int; flags >> byte; }
        Wide { public: left >> i64; right >> i64; layout: align(16); }
    fn:
        public:
            identity<T>(value >> T) -> T { return value; }
            repeat<T>(value >> T, count >> int) -> T {
                held >> T;
                held = value;
                if (count <= 0) return held;
                return repeat<T>(held,count-1);
            }
            read<T>(pointer >> p<T>) -> T { return rd(pointer); }
            make(value >> int) -> Packet { return Packet(value:value,flags:7); }
            advance(value >> Wide) -> Wide { return Wide(left:value.left+1,right:value.right-1); }
    fa: return true;
}
