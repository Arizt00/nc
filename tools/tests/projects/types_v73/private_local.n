use <io:output>;

privateLocal73 {
    type:
        private:
            Secret { public: value >> int; }
    run() -> int {
        value >> Secret <- Secret(value:42);
        if (value.value != 42 || sizeOf(Secret) != 4) return 1;
        println("private-local-layout-ok");
        return 255;
    }
    ref main ->> run;
    fa: return true;
}
