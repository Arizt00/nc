use <io:output>;
use <project:api>;

qualifiedConstructors73 {
    run() -> int {
        first >> api.constructorApi73.Packet <- api.constructorApi73.Packet(value:42,flags:255);
        second >> api.constructorApi73.Packet <- api.constructorApi73.Packet { flags:7,value:31 };
        nested >> api.constructorApi73.Envelope <- api.constructorApi73.Envelope {
            packet: api.constructorApi73.Packet(value:73,flags:9),
            stamp: 4294967296
        };
        copied >> api.constructorApi73.Packet <- api.constructorApi73.identity<api.constructorApi73.Packet>(first);
        pair >> api.constructorApi73.Wide <- api.constructorApi73.Wide(left:4294967296,right:77);
        changed >> api.constructorApi73.Wide <- api.constructorApi73.advance(pair);
        if (first.value != 42 || first.flags != 255 || second.value != 31 || second.flags != 7) return 1;
        if (nested.packet.value != 73 || nested.packet.flags != 9 || nested.stamp != 4294967296) return 2;
        if (copied.value != 42 || copied.flags != 255 || changed.left != 4294967297 || changed.right != 76) return 3;
        println("qualified-constructors-ok");
        return 253;
    }
    ref main ->> run;
    fa: return true;
}
