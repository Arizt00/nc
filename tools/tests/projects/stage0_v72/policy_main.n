use <io:output>;
use <project:stage0_policy>;

stage0PolicyProgram72 {
    run() -> int {
        if (stage0_policy.nccStage0Policy.rawDeclaration(21) != 1 ||
            stage0_policy.nccStage0Policy.rawDeclaration(13) != 0 ||
            stage0_policy.nccStage0Policy.rawDeclaration(0) != 0) return 10;
        if (stage0_policy.nccStage0Policy.functionName(1) != 1 ||
            stage0_policy.nccStage0Policy.functionName(2) != 1 ||
            stage0_policy.nccStage0Policy.functionName(0) != 0) return 1;
        token >> int <- 0;
        while (token < 150) {
            got >> int <- stage0_policy.nccStage0Policy.prefixNext(token);
            if (got != 0 && got != 1) return 2;
            token += 1;
        }
        if (stage0_policy.nccStage0Policy.prefixNext(31) != 0 ||
            stage0_policy.nccStage0Policy.prefixNext(35) != 0 ||
            stage0_policy.nccStage0Policy.prefixNext(14) != 0 ||
            stage0_policy.nccStage0Policy.prefixNext(1) != 1) return 3;
        unsigned >> int <- stage0_policy.nccStage0Policy.integerClass(cast<byte>("BYTE"),4,64);
        signed >> int <- stage0_policy.nccStage0Policy.integerClass(cast<byte>("i8"),2,64);
        if (unsigned != 264 || signed != 8) return 4;
        if (stage0_policy.nccStage0Policy.extension(unsigned,8,32) != 2 ||
            stage0_policy.nccStage0Policy.extension(signed,8,32) != 1 ||
            stage0_policy.nccStage0Policy.extension(unsigned,32,8) != 3 ||
            stage0_policy.nccStage0Policy.extension(unsigned,8,8) != 0 ||
            stage0_policy.nccStage0Policy.extension(0,0,32) != -1) return 5;
        if (stage0_policy.nccStage0Policy.integerClass(cast<byte>("usize"),5,32) != 288 ||
            stage0_policy.nccStage0Policy.integerClass(cast<byte>("usize"),5,64) != 320 ||
            stage0_policy.nccStage0Policy.integerClass(cast<byte>("unknown"),7,64) != 0) return 6;
        shape >> int <- 0;
        while (shape < 5) {
            expected >> int <- shape == 1 ? 1 : (shape == 2 ? 2 : 3);
            if (stage0_policy.nccStage0Policy.callTarget(shape) != expected) return 7;
            shape += 1;
        }
        tokens >> array<int,8> <- [7,7,1,8,8,71,0,0];
        if (stage0_policy.nccStage0Policy.guardCondition(&tokens[0],6) != 1) return 8;
        tokens[5] <- 7;
        if (stage0_policy.nccStage0Policy.guardCondition(&tokens[0],6) != 0 ||
            stage0_policy.nccStage0Policy.guardCondition(&tokens[0],0) != 0) return 9;
        println("stage0-policy-ok");
        return 248;
    }
