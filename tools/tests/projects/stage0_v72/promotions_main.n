use <io:output>;

scalarPromotions72 {
    type:
        Bytes { public: positive >> byte; negative >> i8; }
    stc:
        global >> byte <- 255;
    identity(value >> byte) -> byte { return value; }
    signedIdentity(value >> i8) -> i8 { return value; }
    run() -> int {
        positive >> byte <- 255;
        negative >> i8 <- -1;
        record >> Bytes <- Bytes(positive:255,negative:-1);
        if (positive+negative != 254 || global+negative != 254) return 1;
        if (identity(255)+1 != 256 || signedIdentity(-1)+1 != 0) return 2;
        if (record.positive+record.negative != 254) return 3;
        wide >> u32 <- 4294967295;
        bigger >> i64 <- wide;
        if (bigger != 4294967295) return 4;
        repeated >> int <- 0;
        total >> int <- 0;
        while (repeated < 10000) { total += positive+negative; repeated += 1; }
        if (total != 2540000) return 5;
        println("scalar-promotions-ok");
        return 250;
    }
    ref main ->> run;
    fa: return true;
}
