use <io:output>;

contextualProgram72 {
    emit(value >> int) -> int { return value+1; }
    observe(clone >> int) -> int {
        clone += 1;
        if (clone == 8) return clone+2;
        return clone;
    }
    run() -> int {
        clone >> int <- 7;
        if (clone != 7 || clone+1 != 8 || observe(clone) != 10 || emit(clone) != 8) return 1;
        println("contextual-stage0-ok");
        return 249;
    }
    ref main ->> run;
    fa: return true;
}
