use <project:middle>;
use <io:output>;
signatureThreeMain70 {
    type:
        Packet { public: value >> int; flags >> byte; }
    run() -> int {
        packet >> Packet <- middle.signatureMiddle70.packet(31);
        value >> byte <- 201;
        if (packet.value != 31 || packet.flags != 7) return 1;
        if (rd(middle.signatureMiddle70.pointer(&value)) != 201) return 2;
        if (middle.signatureMiddle70.wide() != 4294967323) return 3;
        println("three-units-ok");
        return 232;
    }
    ref main ->> run;
    fa: return true;
}
