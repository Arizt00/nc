use <project:api>;
rawCast70 {
    run() -> int {
        cell >> u32 <- 0x01020304;
        bytes >> p<byte> <- api.signatureApi70.bytes(cast<byte>(&cell));
        if (rd(bytes) != 4) return 1;
        wr(bytes,9);
        return cell == 0x01020309 ? 229 : 2;
    }
    ref main ->> run;
    fa: return true;
}
