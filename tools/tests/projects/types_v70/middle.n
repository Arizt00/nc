use <project:api>;
signatureMiddle70 {
    type:
        Packet { public: value >> int; flags >> byte; }
    fn:
        public:
            packet(value >> int) -> Packet { return api.signatureApi70.make(value); }
            pointer(value >> p<byte>) -> p<byte> { return api.signatureApi70.identity<byte>(value); }
            wide() -> i64 {
                callback >> fn(i64,i64,i64,i64,i64,i64,i64) -> i64 <- api.signatureApi70.wideCallback();
                return callback(4294967296,2,3,4,5,6,7);
            }
    fa: return true;
}
