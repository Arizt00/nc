nativeHeapShadowV48 {
    alloc(value >> int) -> int { return value+1; }
    calloc(left >> int, right >> int) -> int { return left+right; }
    free(value >> int) -> int { return value-1; }
    realloc(left >> int, right >> int) -> int { return left*right; }
    run() -> int { return alloc(7)+calloc(9,10)+free(21)+realloc(3,10); }
    ref main ->> run;
    fa: return true;
}
