use <io:output, render>;

nativeTimestamp68 {
    run() -> int {
        first >> int <- timestamp();
        if (first <= 0) return 1;
        sleepMs(25);
        second >> int <- timestamp();
        if (second <= 0 || second < first || second - first > 5) return 2;
        print("timestamp="); println(renderInt(second));
        return 218;
    }
    ref main ->> run;
    fa: return true;
}
