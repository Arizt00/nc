use <process:args, env>;
use <data:json>;
use <io:output, render>;
use <project:closure43_core, tool_cli, release_io, editor_json>;

closure43Negative {
    fn:
        run() -> int {
            args >> addr <- argsOpen(); if (argsCount(args) != 3 && argsCount(args) != 4) return 2; binary >> str <- argsAt(args,1); destination >> str <- argsAt(args,2);
            reference >> int <- 0; frozen >> int <- 0;
            if (argsCount(args) == 4) { text >> str <- release_io.releaseIo.text(argsAt(args,3)); reference <- editor_json.editorJson.parse(text); strRelease(text); frozen <- jsonObjectGet(reference,"cases"); if (jsonArrayLen(frozen) != 23) return 3; }
            cases >> int <- jsonParse("[[\"generate-compiler-closure\",\"--unknown\",2],[\"generate-runtime-closure\",\"--unknown\",2],[\"generate-machine-closure\",\"--unknown\",2],[\"generate-compiler-closure\",\"--full-gates\",\"--release-scoped-gates\",1],[\"generate-runtime-closure\",\"--full-gates\",\"--release-scoped-gates\",1],[\"generate-machine-closure\",\"--ci-host\",2],[\"generate-machine-closure\",\"--ci\",2],[\"generate-machine-closure\",\"--strict-target\",2],[\"generate-machine-closure\",\"--full-gates=true\",2],[\"generate-compiler-closure\",\"--full-gates\",\"--release-scoped-gates\",\"--help\",0],[\"generate-runtime-closure\",\"--full-gates\",\"--release-scoped-gates\",\"--help\",0],[\"generate-compiler-closure\",\"--full\", \"--help\",0],[\"generate-machine-closure\",\"--ci-host=linux\",\"--help\",0]]");
            extra >> int <- jsonParse("[[\"generate-compiler-closure\",\"--unknown\",\"--help\",0],[\"generate-runtime-closure\",\"--help\",\"--unknown\",0],[\"generate-machine-closure\",\"--\",\"--help\",2],[\"generate-machine-closure\",\"--ci-host\",\"-1.\",2],[\"generate-machine-closure\",\"--ci-host\",\"-.1\",\"--help\",0],[\"generate-machine-closure\",\"--ci-host\",\"--help\",2],[\"generate-compiler-closure\",\"--h=foo\",2],[\"generate-compiler-closure\",\"--full-gates\",\"--full-gates\",\"--help\",0],[\"generate-machine-closure\",\"--strict-target=\",\"--help\",0],[\"generate-machine-closure\",\"--ci-host=--help\",\"--help\",0]]");
            index >> int <- 0; while (index < jsonArrayLen(extra)) { closure43_core.closure43Core.push(cases,jsonArrayGet(extra,index)); index += 1; } jsonRelease(extra);
            evidence >> int <- jsonNewArray(); index <- 0; passed >> bool <- true;
            while (index < jsonArrayLen(cases)) {
                testcase >> int <- jsonArrayGet(cases,index); words >> int <- jsonNewArray(); closure43_core.closure43Core.push(words,jsonNewString(binary)); at >> int <- 0;
                while (at+1 < jsonArrayLen(testcase)) { closure43_core.closure43Core.push(words,jsonArrayGet(testcase,at)); at += 1; }
                expected >> int <- jsonArrayGet(testcase,at); record >> int <- tool_cli.toolCli.execute(words,"",120000); code >> int <- release_io.releaseIo.number(record,"code",-1);
                success >> bool <- tool_cli.toolCli.clean(record) && code == jsonGetIntOr(expected,-1); if (!success) passed <- false;
                if (frozen != 0) {
                    oracle >> int <- jsonArrayGet(frozen,index);
                    success <- success && closure43_core.closure43Core.field(record,"stdout") == closure43_core.closure43Core.field(oracle,"stdout") && closure43_core.closure43Core.field(record,"stderr") == closure43_core.closure43Core.field(oracle,"stderr");
                    if (!success) passed <- false; jsonRelease(oracle);
                }
                row >> int <- jsonNewObject(); closure43_core.closure43Core.set(row,"name","cli-"+renderInt(index+1)); jsonObjectSet(row,"argv",words); jsonObjectSet(row,"expected",expected); closure43_core.closure43Core.put(row,"actual",jsonNewInt(code)); closure43_core.closure43Core.put(row,"passed",jsonNewBool(success)); closure43_core.closure43Core.set(row,"stdout",closure43_core.closure43Core.field(record,"stdout")); closure43_core.closure43Core.set(row,"stderr",closure43_core.closure43Core.field(record,"stderr")); closure43_core.closure43Core.push(evidence,row);
                jsonRelease(testcase); jsonRelease(words); jsonRelease(expected); jsonRelease(record); index += 1;
            }
            report >> int <- jsonNewObject(); closure43_core.closure43Core.set(report,"schema","nc.closure43.cli-negative.v1"); closure43_core.closure43Core.put(report,"passed",jsonNewBool(passed)); closure43_core.closure43Core.put(report,"cases",evidence); closure43_core.closure43Core.stamp(report,"evidence_hash");
            if (!release_io.releaseIo.write(destination,closure43_core.closure43Core.pretty(report)+"\n")) passed <- false;
            println("closure43 CLI checks: "+renderInt(jsonArrayLen(cases))); jsonRelease(frozen); jsonRelease(reference); jsonRelease(cases); jsonRelease(report); argsRelease(args); return passed ? 0 : 1;
        }
    ref main ->> run;
    fa: return true;
}
