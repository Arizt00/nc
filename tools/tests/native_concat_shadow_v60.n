use <io:output>;
nativeConcatShadowV60 {
    concat(a >> int, b >> int) -> int { return a*10+b; }
    run() -> int {
        guard concat(4,2) == 42 else return 1;
        a >> str <- "shadow";
        b >> str <- a+" ok";
        guard b == "shadow ok" && strRelease(b) else return 2;
        return 154;
    }
    ref main ->> run;
    fa: return true;
}
