use <project:time_fs_provider>;

nativeTimeFsProvider64 {
    fn:
        public:
            run() -> int {
                started >> int <- time_fs_provider.timeFsProvider.provider_time_monotonicMs();
                time_fs_provider.timeFsProvider.provider_sleep_sleepMs(30);
                if (time_fs_provider.timeFsProvider.provider_time_monotonicMs()-started < 25) return 1;
                if (time_fs_provider.timeFsProvider.provider_dir_removeDir("") != 2) return 2;
                if (time_fs_provider.timeFsProvider.provider_fs_delete_file("") != false) return 3;
                return 194;
            }
    ref main ->> run;
    fa: return true;
}
