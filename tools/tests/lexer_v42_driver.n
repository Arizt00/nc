use <process:args>;
use <project:lexer_material_verify>;

lexerV42Driver {
    run() -> int {
        arguments >> addr <- argsOpen();
        code >> int <- lexer_material_verify.lexerMaterialVerify.execute(arguments);
        argsRelease(arguments);
        return code;
    }
    ref main ->> run;
    fa: return true;
}
