use <io:output>;

nativeOutputUtf8V51 {
    run() -> int {
        characters >> p<char> <- cast<char>("H");
        println(rd(characters));
        println(rd<char>(characters));
        println(from<byte>(4660));
        println(off(from<byte>(4660),2));
        println(adr(from<byte>(4660)));
        low >> i8 <- -128;
        short >> i16 <- -32768;
        high >> u32 <- 4294967295;
        println(low); println(short); println(high);
        at >> int <- 0;
        while (at < 100) { print("\u{e9}\u{1f600}|"); at += 1; }
        println();
        return 112;
    }
    ref main ->> run;
    fa: return true;
}
