nativeHeapOverflowV48 {
    identity(bytes >> u64) -> u64 { return bytes; }
    run() -> int {
        a >> p<byte> <- alloc(identity(0xFFFFFFFFFFFFFFFF));
        b >> p<byte> <- calloc(identity(0x100000000),identity(0x100000000));
        c >> p<byte> <- calloc(1,identity(0xFFFFFFFFFFFFFFFF));
        ok >> bool <- a == null && b == null && c == null;
        free(a); free(b); free(c);
        return ok ? 75 : 1;
    }
    ref main ->> run;
    fa: return true;
}
