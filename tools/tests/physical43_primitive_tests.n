use <data:json>;
use <process:args, env>;
use <io:output, render>;
use <project:physical43_common, physical43_exact, physical43_primitive, release_io, tool_cli, sha256>;

physical43PrimitiveTests {
    stc:
        checks >> int <- 0;
        passed >> bool <- true;
        repo >> str <- "";
        work >> str <- "";
    fn:
        private:
            record(name >> str, valid >> bool) -> void { physical43_common.physical43Common.put(checks,name,jsonNewBool(valid)); passed <- passed && valid; if (!valid) println("FAIL "+name+": "+physical43_common.physical43Common.diagnostic()); physical43_common.physical43Common.reset(); }
            invoke(words >> int, cwd >> str) -> int { row >> int <- physical43_common.physical43Common.command(words,cwd,180000); jsonRelease(words); return row; }
            prepare(root >> str) -> void {
                paths >> int <- jsonParse("[\"docs/spec/release/v2_0_0_primitive_release_evidence_spec.md\",\"docs/spec/release/v2_0_0_primitive_release_evidence_compatibility_spec.md\",\"docs/spec/release/v2_0_0_primitive_release_evidence_contract.json\",\"docs/status/STATUS_PRIMITIVE_release_evidence_v2_0_0.md\",\"tools/ncc/nc/src/verification/physical43_primitive.n\",\"tools/release/qa_primitive_release_evidence_v2_0_0.sh\",\"tools/scripts/run_primitive_qemu_smoke.sh\",\"targets/x86_64-unknown-none.nctarget\",\"link/x86_64_baremetal.ld\",\"examples/primitive/boot_serial_hello.ncp\"]"); at >> int <- 0;
                while (at < jsonArrayLen(paths)) { item >> int <- jsonArrayBorrow(paths,at); relative >> str <- jsonStringView(item,""); source >> str <- repo+"/"+relative; if (physical43_common.physical43Common.fileType(source) != 1 && strStartsWith(relative,"examples/")) source <- repo+"/_archive/old_examples/"+strSubstring(relative,9,strByteLen(relative)-9); destination >> str <- root+"/"+relative; physical43_common.physical43Common.directories(release_io.releaseIo.directory(destination)); record("copy-"+relative,physical43_common.physical43Common.copy(source,destination)); jsonRelease(item); at += 1; } jsonRelease(paths);
            }
            compare(native >> int, reference >> int, label >> str, success >> bool) -> void {
                record(label+"-status",physical43_common.physical43Common.field(native,"status") == (success ? "ok" : "error") && physical43_common.physical43Common.field(reference,"status") == (success ? "ok" : "error"));
                a >> int <- jsonObjectBorrow(native,"checks"); b >> int <- jsonObjectBorrow(reference,"checks"); record(label+"-checks",physical43_common.physical43Common.equal(a,b)); jsonRelease(a); jsonRelease(b);
                record(label+"-mode",physical43_common.physical43Common.field(native,"qemu_mode") == physical43_common.physical43Common.field(reference,"qemu_mode"));
                a <- jsonObjectBorrow(native,"commands"); b <- jsonObjectBorrow(reference,"commands"); at >> int <- 0; same >> bool <- jsonArrayLen(a) == 2 && jsonArrayLen(b) == 2;
                while (at < 2) { left >> int <- jsonArrayBorrow(a,at); right >> int <- jsonArrayBorrow(b,at); ac >> int <- jsonObjectBorrow(left,"code"); bc >> int <- jsonObjectBorrow(right,"code"); same <- same && physical43_common.physical43Common.equal(ac,bc) && physical43_common.physical43Common.boolAt(left,"/ok") == physical43_common.physical43Common.boolAt(right,"/ok"); jsonRelease(ac); jsonRelease(bc); jsonRelease(left); jsonRelease(right); at += 1; } record(label+"-commands",same); jsonRelease(a); jsonRelease(b);
            }
            frozen(contract >> bool, smoke >> bool) -> int {
                model >> int <- jsonParse("{\"status\":\"ok\",\"qemu_mode\":\"native-qemu\",\"checks\":{\"artifacts_present\":true,\"contract_consistent\":true,\"qemu_dependency_present\":true,\"qemu_smoke_passed\":true,\"evidence_fields_valid\":true,\"packaging_layout_ok\":true,\"checksums_written\":true,\"report_written\":true},\"commands\":[{\"code\":0,\"ok\":true},{\"code\":0,\"ok\":true}]}");
                physical43_common.physical43Common.put(model,"status",jsonNewString(contract && smoke ? "ok" : "error")); fields >> int <- jsonObjectGet(model,"checks"); physical43_common.physical43Common.put(fields,"contract_consistent",jsonNewBool(contract)); physical43_common.physical43Common.put(fields,"qemu_smoke_passed",jsonNewBool(smoke)); physical43_common.physical43Common.put(model,"checks",fields);
                rows >> int <- jsonNewArray(); row >> int <- jsonParse("{\"code\":0,\"ok\":true}"); physical43_common.physical43Common.push(rows,row); row <- jsonNewObject(); physical43_common.physical43Common.put(row,"code",jsonNewInt(smoke ? 0 : 89)); physical43_common.physical43Common.put(row,"ok",jsonNewBool(smoke)); physical43_common.physical43Common.push(rows,row); physical43_common.physical43Common.put(model,"commands",rows); return model;
            }
            archive(root >> str) -> void {
                dist >> str <- root+"/var/releases/v2_0_0/primitive_material_dist"; package >> str <- dist+"/packages/primitive-material-x86_64-unknown-none-v2.0.0.tar.gz"; expected >> int <- jsonParse("[\"boot_serial_hello.sov\",\"boot_serial_hello.elf\",\"material_evidence.txt\",\"qemu_serial.log\",\"x86_64-unknown-none.nctarget\",\"x86_64_baremetal.ld\"]");
                words >> int <- jsonParse("[\"tar\",\"-tzf\"]"); physical43_common.physical43Common.push(words,jsonNewString(package)); row >> int <- invoke(words,repo); record("archive-listing",physical43_common.physical43Common.succeeded(row)); text >> str <- physical43_common.physical43Common.field(row,"stdout"); jsonRelease(row); rows >> int <- physical43_common.physical43Common.lines(text); strRelease(text); seen >> int <- jsonNewArray(); at >> int <- 0; valid >> bool <- true;
                while (at < jsonArrayLen(rows)) { item >> int <- jsonArrayBorrow(rows,at); path >> str <- jsonStringView(item,""); if (path != "" && !strEndsWith(path,"/")) { name >> str <- physical43_common.physical43Common.basename(path); valid <- valid && strStartsWith(path,"primitive-material-v2.0.0/") && release_io.releaseIo.contains(expected,name) && !release_io.releaseIo.contains(seen,name); physical43_common.physical43Common.push(seen,jsonNewString(name)); } jsonRelease(item); at += 1; } record("archive-six-frozen-members",valid && jsonArrayLen(seen) == 6); jsonRelease(rows); jsonRelease(seen);
                extracted >> str <- root+"/extracted"; physical43_common.physical43Common.directories(extracted); words <- jsonParse("[\"tar\",\"-xzf\"]"); physical43_common.physical43Common.push(words,jsonNewString(package)); physical43_common.physical43Common.push(words,jsonNewString("-C")); physical43_common.physical43Common.push(words,jsonNewString(extracted)); row <- invoke(words,repo); record("archive-extraction",physical43_common.physical43Common.succeeded(row)); jsonRelease(row); at <- 0;
                while (at < 6) { item >> int <- jsonArrayBorrow(expected,at); name >> str <- jsonStringView(item,""); leftPath >> str <- extracted+"/primitive-material-v2.0.0/"+name; rightPath >> str <- dist+"/staging/primitive-material-v2.0.0/"+name; leftHash >> str <- physical43_common.physical43Common.fileHash(leftPath); rightHash >> str <- physical43_common.physical43Common.fileHash(rightPath); record("archive-bytes-"+name,physical43_common.physical43Common.fileType(leftPath) == 1 && physical43_common.physical43Common.fileType(rightPath) == 1 && physical43_common.physical43Common.fileSize(leftPath) > 0 && physical43_common.physical43Common.hex(leftHash,64,64) && physical43_common.physical43Common.hex(rightHash,64,64) && leftHash == rightHash); jsonRelease(item); at += 1; } jsonRelease(expected);
                golden >> int <- physical43_common.physical43Common.read(repo+"/bootstrap/physical43-goldens.json",false); model >> int <- physical43_common.physical43Common.read(dist+"/manifests/primitive-release-manifest.json",false); reference >> int <- jsonObjectBorrow(golden,"primitive_manifest"); record("manifest-frozen-oracle",physical43_common.physical43Common.equal(model,reference)); jsonRelease(model); jsonRelease(reference); jsonRelease(golden);
                sums >> int <- physical43_exact.physical43Exact.sums(dist+"/integrity/SHA256SUMS"); record("checksums-five-members",jsonKind(sums) == 6 && jsonObjectLen(sums) == 5); at <- 0;
                while (at < jsonObjectLen(sums)) { name >> str <- jsonObjectKeyAt(sums,at); record("checksum-"+name,physical43_common.physical43Common.fileHash(dist+"/"+name) == physical43_common.physical43Common.field(sums,name)); strRelease(name); at += 1; } jsonRelease(sums);
            }
        public:
            run() -> int {
                arguments >> addr <- argsOpen(); options >> int <- physical43_common.physical43Common.parse(arguments,2,"|--repo|--work|--fixture|","",""); if (options == 0 || !jsonObjectHas(options,"--fixture")) return 2;
                repo <- physical43_common.physical43Common.absolutePath(tool_cli.toolCli.value(options,"--repo",".")); work <- physical43_common.physical43Common.absolutePath(tool_cli.toolCli.value(options,"--work","target/tmp/physical43/primitive-fixtures-"+renderInt(nowMs()))); fixture >> str <- physical43_common.physical43Common.absolutePath(tool_cli.toolCli.value(options,"--fixture","")); checks <- jsonNewObject();
                physical43_common.physical43Common.directories(work+"/bin"); physical43_common.physical43Common.directories(work+"/home"); suffix >> str <- envHas("WINDIR") ? ".exe" : ""; record("fixture-cargo-installed",physical43_common.physical43Common.copy(fixture,work+"/bin/cargo"+suffix)); record("fixture-qemu-installed",physical43_common.physical43Common.copy(fixture,work+"/bin/qemu-system-x86_64"+suffix));
                if (!envHas("WINDIR")) { words >> int <- jsonParse("[\"chmod\",\"+x\"]"); physical43_common.physical43Common.push(words,jsonNewString(work+"/bin/cargo")); physical43_common.physical43Common.push(words,jsonNewString(work+"/bin/qemu-system-x86_64")); row >> int <- invoke(words,repo); record("fixture-executable",physical43_common.physical43Common.succeeded(row)); jsonRelease(row); }
                names >> int <- jsonParse("[\"PATH\",\"HOME\",\"MSYS2_PATH_TYPE\",\"PHYSICAL43_FIXTURE_FAIL\"]"); saved >> int <- jsonNewObject(); at >> int <- 0;
                while (at < 4) { nameNode >> int <- jsonArrayBorrow(names,at); name >> str <- jsonStringView(nameNode,""); physical43_common.physical43Common.put(saved,name,envHas(name) ? jsonNewString(physical43_common.physical43Common.env(name)) : jsonNewNull()); jsonRelease(nameNode); at += 1; }
                envSet("PATH",release_io.releaseIo.forwardPath(work)+"/bin"+(envHas("WINDIR") ? ";C:/msys64/usr/bin;C:/msys64/mingw64/bin;" : ":")+physical43_common.physical43Common.env("PATH")); envSet("HOME",release_io.releaseIo.forwardPath(work)+"/home"); envSet("MSYS2_PATH_TYPE","inherit"); envRemove("PHYSICAL43_FIXTURE_FAIL");
                nativeRoot >> str <- work+"/native"; prepare(nativeRoot);
                native >> int <- physical43_primitive.physical43Primitive.verify(nativeRoot); reference >> int <- frozen(true,true); compare(native,reference,"positive",true); jsonRelease(native); jsonRelease(reference); archive(nativeRoot);
                migrated >> int <- physical43_common.physical43Common.read(repo+"/bootstrap/physical43-contracts.json",false); originals >> int <- jsonObjectBorrow(migrated,"retired_originals"); at <- 0;
                while (at < jsonArrayLen(originals)) { original >> int <- jsonArrayBorrow(originals,at); record("retired-original-absent-"+jsonStringView(original,""),physical43_common.physical43Common.fileType(nativeRoot+"/"+jsonStringView(original,"")) == 0); jsonRelease(original); at += 1; } jsonRelease(originals); jsonRelease(migrated);
                contractPath >> str <- nativeRoot+"/docs/spec/release/v2_0_0_primitive_release_evidence_contract.json"; contract >> int <- physical43_common.physical43Common.read(contractPath,false); physical43_common.physical43Common.put(contract,"state",jsonNewString("not-frozen")); physical43_common.physical43Common.save(contractPath,contract); jsonRelease(contract);
                native <- physical43_primitive.physical43Primitive.verify(nativeRoot); reference <- frozen(false,true); compare(native,reference,"contract-negative",false); jsonRelease(native); jsonRelease(reference);
                envSet("PHYSICAL43_FIXTURE_FAIL","1"); native <- physical43_primitive.physical43Primitive.verify(nativeRoot); reference <- frozen(false,false); compare(native,reference,"smoke-negative",false); jsonRelease(native); jsonRelease(reference);
                delete_file(physical43_common.physical43Common.nativeFs(nativeRoot+"/docs/spec/release/v2_0_0_primitive_release_evidence_spec.md")); native <- physical43_primitive.physical43Primitive.verify(nativeRoot); record("missing-required-artifact-rejected",native == 0); jsonRelease(native);
                at <- 0; while (at < 4) { nameNode >> int <- jsonArrayBorrow(names,at); name >> str <- jsonStringView(nameNode,""); value >> int <- jsonObjectBorrow(saved,name); if (jsonKind(value) == 4) envSet(name,jsonStringView(value,"")); else envRemove(name); jsonRelease(value); jsonRelease(nameNode); at += 1; }
                report >> int <- jsonParse("{\"schema\":\"nc.physical43.primitive-native-tests.v1\",\"scope\":\"native frozen-oracle regressions without Python; strict cargo/QEMU fixtures, not physical execution\"}"); physical43_common.physical43Common.put(report,"passed",jsonNewBool(passed)); jsonObjectSet(report,"checks",checks); physical43_common.physical43Common.save(work+"/tests.json",report); physical43_common.physical43Common.print(report); jsonRelease(report); jsonRelease(checks); jsonRelease(saved); jsonRelease(names); jsonRelease(options); argsRelease(arguments); return passed ? 0 : 1;
            }
    ref main ->> run;
    fa: return true;
}
