nativeUnionAbi79 {
    type:
        public:
            Pair { public: first >> ft64; second >> ft64; }
            Mixed { public: tag >> i64; value >> ft64; }
            Bits union { public: value >> ft64; bits >> u64; }
            Float union { public: value >> ft64; samples >> array<ft32,2>; }
            Twin union { public: pair >> Pair; values >> array<ft64,2>; }
            Choice union { public: mixed >> Mixed; pair >> Pair; }
            Large union { public: values >> array<ft64,3>; bytes >> array<byte,24>; }
            Nested { public: prefix >> i64; payload >> Bits; }
    fn:
        public:
            bits(value >> Bits) -> Bits { value.value += 0.5; return value; }
            floating(value >> Float) -> Float { value.value += 1.0; return value; }
            twin(value >> Twin) -> Twin { value.pair.second += value.pair.first; return value; }
            choice(value >> Choice) -> Choice { value.mixed.tag += 1; value.mixed.value += 0.5; return value; }
            large(value >> Large) -> Large { value.values[2] += value.values[0]; return value; }
            nested(value >> Nested) -> Nested { value.payload.value += value.prefix; return value; }
            exhausted(a >> i64,b >> i64,c >> i64,d >> i64,e >> i64,f >> i64,
                choice >> Choice, tail >> ft64) -> ft64 {
                return a+b+c+d+e+f+choice.mixed.tag+choice.mixed.value+tail;
            }
    fa: return true;
}
