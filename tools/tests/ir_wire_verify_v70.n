use <io:output>;
use <process:args>;
use <project:ir>;

irWireVerify70 {
    run() -> int {
        arguments >> addr <- argsOpen();
        if (argsCount(arguments) != 4) { argsRelease(arguments); return 64; }
        graph >> p<byte> <- ir.nccIr.projectReadGraph(argsAt(arguments,1),argsAt(arguments,2));
        if (graph == null) { argsRelease(arguments); return 66; }
        valid >> bool <- ir.nccIr.projectGraphNodes(graph) > 0 &&
            ir.nccIr.projectWriteGraph(graph,argsAt(arguments,3));
        ir.nccIr.projectReleaseGraph(graph);
        argsRelease(arguments);
        if (!valid) return 74;
        println("ir-wire-ok");
        return 235;
    }
    ref main ->> run;
    fa: return true;
}
