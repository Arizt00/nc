use <io:output>;
use <project:timestamp_provider>;

nativeTimestampMath68 {
    run() -> int {
        epoch >> u64 <- 116444736000000000;
        if (timestamp_provider.timestampProvider.fileTimeSeconds(epoch) != 0) return 1;
        if (timestamp_provider.timestampProvider.fileTimeSeconds(epoch - 1) != -1) return 2;
        if (timestamp_provider.timestampProvider.fileTimeSeconds(epoch + 9999999) != 0) return 3;
        if (timestamp_provider.timestampProvider.fileTimeSeconds(epoch + 10000000) != 1) return 4;
        if (timestamp_provider.timestampProvider.narrowSeconds(2147483647) != 2147483647) return 5;
        wide >> i64 <- 2147483648;
        if (timestamp_provider.timestampProvider.narrowSeconds(wide) != -2147483648) return 6;
        if (timestamp_provider.timestampProvider.narrowSeconds(4294967296) != 0) return 7;
        if (timestamp_provider.timestampProvider.narrowSeconds(-1) != -1) return 8;
        println("timestamp-math-ok");
        return 219;
    }
    ref main ->> run;
    fa: return true;
}
