nativeStringBytesV50 {
    echo(value >> str) -> str { return value; }
    run() -> int {
        text >> str <- echo("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ");
        bytes >> p<byte> <- cast<byte>(text);
        if (rd(off(bytes,123)) != 90 || rd(off(bytes,124)) != 0) return 1;
        if (text != "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ") return 2;
        embedded >> p<byte> <- cast<byte>("A\0B");
        if (rd(off(embedded,0)) != 65 || rd(off(embedded,1)) != 0 || rd(off(embedded,2)) != 66 || rd(off(embedded,3)) != 0) return 3;
        if (!("\x80" > "\x7f") || !("\xff" > "\x80")) return 4;
        return 104;
    }
    ref main ->> run;
    fa: return true;
}
