use <data:json>;

nativeJsonIntDefault {
    fn:
        public:
            run() -> int {
                lo >> int <- jsonNewInt(-2147483647-1);
                hi >> int <- jsonNewInt(2147483647);
                zero >> int <- jsonNewInt(0);
                other >> int <- jsonNewString("42");
                ok >> bool <- jsonGetIntOr(lo,7) == -2147483647-1 && jsonGetIntOr(hi,7) == 2147483647 && jsonGetIntOr(zero,7) == 0 && jsonGetIntOr(other,-1) == -1;
                jsonRelease(lo); jsonRelease(hi); jsonRelease(zero); jsonRelease(other);
                return ok ? 173 : 1;
            }
    ref main ->> run;
    fa: return true;
}
