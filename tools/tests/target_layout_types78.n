targetLayoutTypes78 {
    type:
        Basic { public: prefix >> byte; wide >> i64; number >> ft64; link >> p<byte>; }
        Nested { public: head >> byte; body >> Basic; tail >> u16; }
        Samples { public: data >> array<Basic,2>; }
        Choice union { public: wide >> i64; link >> p<byte>; }
        Packed {
            public: prefix >> byte; wide >> i64; number >> ft64; link >> p<byte>;
            layout: repr(C); packed;
        }
        Aligned {
            public: prefix >> byte; wide >> i64; number >> ft64; link >> p<byte>;
            layout: repr(C); align(16);
        }
        Flexible {
            public: marker >> byte; count >> u32; data >> array<byte,0>;
            layout: repr(C); flexible(data);
        }
    fa: return true;
}
