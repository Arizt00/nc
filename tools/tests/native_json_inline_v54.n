use <data:json>;
use <io:output>;

nativeJsonInlineV54 {
    run() -> int {
        row >> int <- jsonNewObject();
        guard row > 0 else return 1;
        guard jsonObjectSet(row,"truncated",jsonNewBool(true)) else return 2;
        value >> int <- jsonObjectBorrow(row,"truncated");
        guard jsonGetBool(value) else return 3;
        jsonRelease(value);
        text >> str <- jsonStringify(row);
        guard text == "{\"truncated\":true}" else return 4;
        println(text);
        free(cast<byte>(text));
        jsonRelease(row);
        // The unnamed owned bool is intentionally retained until process exit.
        return 129;
    }
    ref main ->> run;
    fa: return true;
}
