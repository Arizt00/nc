use <io:output>;
use <project:cycle_a, cycle_b>;

nativeTransitiveCycleCalls80 {
    stc:
        first >> cycle_a.nativeTransitiveCycleA80.A;
        second >> cycle_b.nativeTransitiveCycleB80.B;
    run() -> int {
        first <- cycle_a.nativeTransitiveCycleA80.A(tag: 7,next: &second);
        second <- cycle_b.nativeTransitiveCycleB80.B(value: 2.5,peer: &first);
        first <- cycle_a.nativeTransitiveCycleA80.step(first);
        second <- cycle_b.nativeTransitiveCycleB80.step(second);
        if (first.tag != 8 || second.value != 3.0 || first.next != &second || second.peer != &first) return 1;
        println("native-transitive-cycle-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
