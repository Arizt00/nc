use <io:output>;

nativeTextShadow66 {
    parseInt(value >> int) -> int { return value+100; }
    strEmpty() -> str { return "local"; }
    run() -> int {
        if (parseInt(7) != 107 || strEmpty() != "local") return 1;
        println("text-shadow-ok"); return 210;
    }
    ref main ->> run;
    fa: return true;
}
