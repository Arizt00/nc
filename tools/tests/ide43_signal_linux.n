use foreign { c };
ide43Signal {
    foreign:
        c symbol "kill" {
            abi: C;
            header: "signal.h";
            library: "c";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            sideEffects: processControl;
            capability: "process.signal.self";
            policy: "ide43-test-only-fault-injection";
            signature: fn(i32, i32) -> i32;
        }
        c symbol "getpid" {
            abi: C;
            header: "unistd.h";
            library: "c";
            linkage: dynamic;
            layout: stable;
            ownership: borrowed;
            sideEffects: processObservation;
            capability: "process.id.self";
            policy: "ide43-test-only-fault-injection";
            signature: fn() -> i32;
        }
    fn:
        public:
            trigger() -> void { value >> i32 <- 11; kill(getpid(),value); }
    fa: return true;
}
