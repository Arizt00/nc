use <data:json>;
use <io:output>;

frontendJsonV44 {
    fn:
        run() -> int {
            source >> str <- "[\"A\\u0000B\\ud83d\\ude42\",\"caf\u{e9}\",12.5]";
            model >> int <- jsonParse(source);
            if (jsonKind(model) != 5 || jsonArrayLen(model) != 3) { println("parse failed"); return 1; }
            copy >> int <- jsonClone(model);
            encoded >> str <- jsonStringify(copy);
            ok >> bool <- jsonEquals(model, copy) && strContains(encoded, "A\\u0000B") && strContains(encoded, "12.5");
            // Compare the suffix after NUL too: equality of truncated prefixes is insufficient.
            wrong >> int <- jsonParse("[\"A\\u0000C\\ud83d\\ude42\",\"caf\u{e9}\",12.5]");
            ok <- !jsonEquals(copy, wrong) && ok;
            roundtrip >> int <- jsonParse(encoded);
            ok <- jsonKind(roundtrip) == 5 && jsonEquals(copy, roundtrip) && ok;
            badHigh >> int <- jsonParse("\"\\ud83d\"");
            badLow >> int <- jsonParse("\"\\ude42\"");
            badPair >> int <- jsonParse("\"\\ud83d\\u0041\"");
            ok <- badHigh == 0 && badLow == 0 && badPair == 0 && ok;
            buffer >> p<byte> <- cast(alloc(5));
            wr(buffer, 34); wr(off(buffer, 1), 0xC0); wr(off(buffer, 2), 0xAF);
            wr(off(buffer, 3), 34); wr(off(buffer, 4), 0);
            text >> str <- cast(buffer);
            badUtf8 >> int <- jsonParse(text); ok <- badUtf8 == 0 && ok; free(buffer);
            jsonRelease(model); jsonRelease(copy); jsonRelease(wrong); jsonRelease(roundtrip);
            strRelease(encoded);
            println(ok ? "JSON byte contract PASS" : "JSON byte contract FAIL");
            return ok ? 0 : 1;
        }
    ref main ->> run;
    fa: return true;
}
