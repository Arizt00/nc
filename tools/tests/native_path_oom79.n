use <io:output>;

nativePathOom79 {
    run() -> int {
        out >> p<byte> <- alloc(16384);
        if (out == null) return 1;
        checks >> int <- absolutePathInto(".",out,16384);
        free(out);
        if (checks < 8) return 2;
        print("native-path-oom-ok checks="); println(checks); return 0;
    }
    ref main ->> run;
    fa: return true;
}
