use <project:mid, leaf>;

nativeTransitiveApi80 {
    type:
        Box { public: head >> u32; payload >> mid.nativeTransitiveMid80.Packet; sentinel >> u64; }
        SseBox { public: value >> mid.nativeTransitiveMid80.Sse; }
    fn:
        public:
            make() -> Box { return Box(head: 23,payload: mid.nativeTransitiveMid80.make(),sentinel: 29); }
            mutate(value >> Box) -> Box {
                value.payload <- mid.nativeTransitiveMid80.mutate(value.payload);
                value.sentinel += 3; return value;
            }
            small() -> SseBox {
                return SseBox(value: mid.nativeTransitiveMid80.Sse(pair: leaf.nativeTransitiveLeaf80.Pair(first: 1.5,second: 2.5)));
            }
            smallStep(value >> SseBox) -> SseBox { value.value <- mid.nativeTransitiveMid80.sse(value.value); return value; }
    fa: return true;
}
