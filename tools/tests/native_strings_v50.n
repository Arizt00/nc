nativeStringsV50 {
    const:
        TITLE >> str <- "Program";
    echo(value >> str) -> str { return value; }
    run() -> int {
        left >> str <- TITLE;
        right >> str <- echo("Program");
        if (left != right || left == "Other") return 1;
        if (!("" < "a") || !("ab" < "abc") || !("abc" > "ab")) return 2;
        chosen >> str <- left == right ? "Program" : "Other";
        if (chosen != right || echo("") != "") return 3;
        unicode >> str <- "\u{e9}\u{1f600}";
        bytes >> p<byte> <- cast<byte>(unicode);
        if (rd(bytes) != 195 || rd(off(bytes,1)) != 169 || rd(off(bytes,2)) != 240) return 4;
        return 102;
    }
    ref main ->> run;
    fa: return true;
}
