nativeOveralignmentLeaf81 {
    type:
        Cell { public: value >> u64; other >> ft64; layout: align(512); }
    stc:
        initialized >> Cell <- Cell(value: 73,other: 2.5);
        uninitialized >> Cell;
    fn:
        public:
        read() -> Cell { return initialized; }
        change(value >> Cell) -> Cell {
            if (adr(&value) % 512 != 0) return Cell(value: 0,other: 0.0);
            value.value += 1; value.other += 0.5; return value;
        }
        aligned() -> bool { return adr(&initialized) % 512 == 0 && adr(&uninitialized) % 512 == 0 && uninitialized.value == 0; }
    fa: return true;
}
