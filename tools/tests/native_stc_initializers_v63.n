nativeStcInitializers {
    const:
        NEGATIVE >> i8 <- -10;
    stc:
        quotient >> int <- NEGATIVE / 3;
        remainder >> int <- NEGATIVE % 3;
        shifted >> int <- -64 >> 3;
        product >> int <- 7 * 8;
        reduced >> u64 <- 1024 / 8;
        largeQuotient >> u64 <- 0xFEDCBA9876543210 / 7;
        largeRemainder >> u64 <- 0xFEDCBA9876543210 % 7;
        largeShift >> u64 <- 0xFEDCBA9876543210 >> 8;
        choice >> int <- (-5 < 2) ? 19 : 23;
        condition >> bool <- false && (1 / 0 == 1);
    fn:
        run() -> int {
            if (quotient != -3 || remainder != -1 || shifted != -8) return 1;
            if (product != 56 || reduced != 128 || choice != 19 || condition) return 2;
            if (largeQuotient != 0x2468ACF13579BE02 || largeRemainder != 2) return 3;
            if (largeShift != 0x00FEDCBA98765432) return 4;
            return 185;
        }
    ref main ->> run;
    fa:
        return true;
}
