use <project:labels>;

nativeUnitsStringsV50 {
    run() -> int {
        name >> str <- labels.nativeLabelsV50.kindName(1);
        if (name != "Program" || name == "Container") return 1;
        if (labels.nativeLabelsV50.echo(name) != labels.nativeLabelsV50.kindName(1)) return 2;
        if (labels.nativeLabelsV50.kindName(9) != "") return 3;
        if (!("A" < "B") || !("B" > "A") || !("A" <= "A") || !("B" >= "B")) return 4;
        text >> str <- labels.nativeLabelsV50.escapes();
        if (text != "A\n\t\\\"\&\?\#\x42") return 5;
        bytes >> p<byte> <- cast<byte>(text);
        if (rd(off(bytes,1)) != 10 || rd(off(bytes,2)) != 9 || rd(off(bytes,8)) != 66 || rd(off(bytes,9)) != 0) return 6;
        value >> u64 <- labels.nativeLabelsV50.wide(0x100000000,1,2,3,4,5,
            labels.nativeLabelsV50.echo(name),6);
        if (value != 0x100000015) return 7;
        return 101;
    }
    ref main ->> run;
    fa: return true;
}
