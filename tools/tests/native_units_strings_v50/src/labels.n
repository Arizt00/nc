nativeLabelsV50 {
    // External calls deliberately exercise registers, stack arguments and literal bytes.
    fn:
        public:
            kindName(kind >> int) -> str {
                if (kind == 1) return "Program";
                if (kind == 2) return "Container";
                return "";
            }
            echo(value >> str) -> str { return value; }
            escapes() -> str { return "A\n\t\\\"\&\?\#\x42"; }
            wide(value >> u64, a >> int, b >> int, c >> int,
                d >> int, e >> int, text >> str, tail >> int) -> u64 {
                if (text != "Program") return 0;
                return value+a+b+c+d+e+tail;
            }
    fa: return true;
}
