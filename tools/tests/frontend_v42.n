use <io:output>;
use <project:lexer_tests, parser_tests>;

frontendV42 {
    fn:
        run() -> int {
            lexed >> bool <- lexer_tests.nccLexerTests.selfTest();
            parsed >> bool <- parser_tests.nccParserTests.selfTest();
            println(lexed && parsed ? "PASS: native lexer spans, parser and AST" : "FAIL: native frontend");
            return lexed && parsed ? 0 : 1;
        }
    ref main ->> run;
    fa: return true;
}
