use <project:json_int_default_provider>;
use <data:json>;

nativeJsonIntProvider {
    run() -> int {
        value >> int <- jsonNewInt(-17);
        result >> int <- json_int_default_provider.jsonIntDefaultProvider.provider_json_jsonGetIntOr(value,9);
        fallback >> int <- json_int_default_provider.jsonIntDefaultProvider.provider_json_jsonGetIntOr(0,-23);
        jsonRelease(value);
        return result == -17 && fallback == -23 ? 175 : 1;
    }
    ref main ->> run;
    fa: return true;
}
