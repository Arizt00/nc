nativeHeapAllocV48 {
    run() -> int {
        cell >> p<u64> <- cast<u64>(alloc(8));
        if (cell == null) return 1;
        wr(cell,0x10000002A);
        value >> u64 <- rd(cell);
        released >> bool <- free(cell);
        return value == 0x10000002A && released ? 72 : 2;
    }
    ref main ->> run;
    fa: return true;
}
