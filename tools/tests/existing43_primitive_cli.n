use <process:args>;
use <project:physical43_primitive>;

existing43PrimitiveCli {
    fn:
        public:
            run() -> int {
                arguments >> addr <- argsOpen();
                result >> int <- physical43_primitive.physical43Primitive.execute(arguments);
                argsRelease(arguments); return result;
            }
    ref main ->> run;
    fa: return true;
}
