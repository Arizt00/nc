nativeHeapNestedV48 {
    make(bytes >> u64) -> p<byte> { return alloc(bytes); }
    release(pointer >> p<byte>) -> bool { return free(pointer); }
    run() -> int {
        left >> p<u64> <- cast<u64>(make(8));
        right >> p<u64> <- cast<u64>(make(8));
        if (left == null || right == null) { release(left); release(right); return 1; }
        wr(left,0x100000000); wr(right,0x10000000A);
        value >> u64 <- rd(left)+rd(right);
        return release(left) && release(right) && value == 0x20000000A ? 76 : 2;
    }
    ref main ->> run;
    fa: return true;
}
