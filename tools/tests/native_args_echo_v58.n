use <process:args>;
use <io:output>;

nativeArgsEchoV58 {
    run() -> int {
        arguments >> addr <- argsOpen();
        guard arguments != null && argsError(arguments) == 0 else return 1;
        count >> int <- argsCount(arguments); total >> int <- 0; at >> int <- 0;
        vector >> p<addr> <- from<addr>(argsData(arguments));
        while (at < count) {
            value >> str <- argsAt(arguments,at); bytes >> int <- strByteLen(value);
            guard rd(off(vector,at)) == adr(value) else return 2;
            total += bytes+1;
            if (at > 0) { print(bytes); print(":"); print(value); println(); }
            at += 1;
        }
        guard total == argsBytes(arguments) && argsRelease(arguments) else return 3;
        return 144;
    }
    ref main ->> run;
    fa: return true;
}
