use <io:output>;

nativeOveralignmentMaxLocal81 {
    type:
        Page { public: value >> u64; layout: align(1048576); }
    run() -> int {
        block >> Page;
        block.value = 101;
        if (adr(&block) % 1048576 != 0 || block.value != 101 || rd<u64>(cast<byte>(&block)) != 101) return 1;
        println("native-overalignment-max-local-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
