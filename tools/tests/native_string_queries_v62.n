nativeStringQueries {
    run() -> int {
        text >> str <- "niño/path";
        part >> str <- strSubstring(text,2,2);
        slice >> str <- strSlice("abcde",1,3);
        empty >> str <- substring("abc",3,0);
        ok >> bool <- part == "ñ" && slice == "bcd" && empty == "";
        ok <- ok && strContains(text,"/path") && !strContains(text,"missing") && strContains("","");
        ok <- ok && strIndexOf(text,"/") == 5 && strIndexOf(text,"missing") == -1;
        ok <- ok && strStartsWith(text,"ni") && strEndsWith(text,"path") && strEndsWith(text,"") && !strEndsWith("a","long");
        ok <- ok && strCompare("a","b") == -1 && strCompare("b","a") == 1 && strCompare("a","a") == 0 && strEq("abc","abc");
        strRelease(part); strRelease(slice); strRelease(empty);
        return ok ? 177 : 1;
    }
    ref main ->> run;
    fa: return true;
}
