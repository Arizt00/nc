use <project:release_io>;

docs43Cases {
    fn:
        public:
            config(root >> str) -> bool {
                guard release_io.releaseIo.write(root+"/docs/spec/runtime/runtime_imports_index.json","{\"families\":[{\"family_key\":\"zeta|pipe\",\"import_path\":\"one\\ntwo\",\"exports_count\":{\"quoted\":\"a'b\",\"list\":[true,null,3]},\"required_capabilities\":\"αβγδ\"},{\"family_key\":\"alpha\",\"exports_count\":null},{\"family_key\":\"beta\",\"exports_count\":true}]}") else return false;
                corrupt >> p<byte> <- cast(alloc(5)); guard corrupt != null else return false;
                wr(corrupt,97); wr(off(corrupt,1),226); wr(off(corrupt,2),130); wr(off(corrupt,3),98); wr(off(corrupt,4),255);
                path >> str <- root+"/docs/spec/compiler/compiler_cli.md"; guard release_io.releaseIo.write(path,"") else { free(corrupt); return false; }
                result >> bool <- fsWriteFrom(path,corrupt,5,false) == 5; free(corrupt); return result;
            }
            create(root >> str) -> bool {
                guard release_io.releaseIo.write(root+"/docs/spec/runtime/runtime_imports_index.json","{\"families\":[{\"family_key\":\"zeta\",\"import_path\":\"nC.runtime.zeta\",\"exports_count\":7,\"required_capabilities\":[\"one\",\"two\",\"three\",\"four\"]},{\"family_key\":\"alpha\",\"import_path\":\"nC.runtime.alpha\",\"exports_count\":0,\"required_capabilities\":[]},{\"family_key\":\"empty\"}]}") else return false;
                guard release_io.releaseIo.write(root+"/docs/spec/compiler/compiler_cli.md","Título áéíóú\r\n\talpha beta\r\n- `ncc compiler pipeline|phases|tokens|ast|sema|imports|types|type-contracts|bounds|operators|conditions|nir|lower|backend <file>`\r\n") else return false;
                guard release_io.releaseIo.write(root+"/examples/first.n","first[@runtime] { fa: return true; }\n") else return false;
                guard release_io.releaseIo.write(root+"/examples/hello.n","") else return false;
                guard release_io.releaseIo.write(root+"/examples/deep/second.nm","machine fixture\n") else return false;
                corrupt >> p<byte> <- cast(alloc(5)); guard corrupt != null else return false;
                wr(corrupt,97); wr(off(corrupt,1),226); wr(off(corrupt,2),130); wr(off(corrupt,3),98); wr(off(corrupt,4),255);
                result >> bool <- fsWriteFrom(root+"/invalid-utf8.txt",corrupt,5,false) == 5;
                free(corrupt); return result;
            }
    fa: return true;
}
