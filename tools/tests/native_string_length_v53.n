use <io:output>;

nativeStringLengthV53 {
    const:
        CAPACITY >> int <- 65537;
    count(value >> str) -> int { return strByteLen((value)); }
    run() -> int {
        guard strByteLen("") == 0 && strLen("provider") == 8 && len("a\nb") == 3 else return 1;
        data >> p<byte> <- cast<byte>(alloc(CAPACITY));
        guard data != null else return 2;
        wr<byte>(data,195); wr<byte>(off(data,1),169);
        wr<byte>(off(data,2),240); wr<byte>(off(data,3),159);
        wr<byte>(off(data,4),152); wr<byte>(off(data,5),128); wr<byte>(off(data,6),0);
        text >> str <- cast(data);
        guard count(text) == 6 && strLen(text) == 6 && len(text) == 6 else { free(data); return 3; }
        println(count(text));
        wr<byte>(off(data,1),0);
        guard strByteLen(text) == 1 else { free(data); return 4; }
        at >> int <- 0;
        while (at < CAPACITY-1) { wr<byte>(off(data,at),65); at += 1; }
        wr<byte>(off(data,CAPACITY-1),0);
        tail >> str <- cast(off(data,65535));
        guard strByteLen(text) == 65536 && strByteLen(tail) == 1 else { free(data); return 5; }
        println(strByteLen(text));
        free(data);
        return 122;
    }
    ref main ->> run;
    fa: return true;
}
