use <project:json_file_provider>;
use <data:json>;
use <process:args>;

nativeJsonFileProvider {
    run() -> int {
        args >> addr <- argsOpen();
        if (argsCount(args) != 2) { argsRelease(args); return 64; }
        path >> str <- argsAt(args,1);
        root >> int <- jsonParse("{\"value\":42}");
        ok >> bool <- json_file_provider.jsonFileProvider.provider_json_jsonSaveFile(root,path,2);
        copy >> int <- json_file_provider.jsonFileProvider.provider_json_jsonParseFile(path);
        ok <- ok && jsonEquals(root,copy);
        jsonRelease(copy); jsonRelease(root); argsRelease(args);
        return ok ? 176 : 1;
    }
    ref main ->> run;
    fa: return true;
}
