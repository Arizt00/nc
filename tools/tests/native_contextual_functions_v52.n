contextualFunctions {
    bind(value >> int) -> int { return value + 2; }
    emit(value >> int) -> int { return value * 3; }
    raw(value >> int) -> int { return value - 1; }

    run() -> int {
        guard bind(7) == 9 && emit(7) == 21 && raw(7) == 6 else return 1;
        guard (bind)(4) == 6 else return 2;
        value >> int <- 11;
        address >> p<int> <- &value;
        guard rd<int>((address)) == 11 && (address) != null else return 3;
        return 121;
    }

    ref main ->> run;
    fa: return true;
}
