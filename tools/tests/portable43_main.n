use <process:args>;
use <project:physical43_portable, physical43_common>;

portable43Main {
    fn:
        public:
            run() -> int {
                arguments >> addr <- argsOpen(); physical43_common.physical43Common.reset();
                result >> int <- physical43_portable.physical43Portable.execute(arguments);
                argsRelease(arguments); return result;
            }
    ref main ->> run;
    fa: return true;
}
