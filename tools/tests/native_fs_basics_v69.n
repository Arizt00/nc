use <io:output>;

nativeFsBasics69 {
    run() -> int {
        buffer >> array<byte,4096>;
        data >> p<byte> <- cast<byte>(&buffer);
        length >> int <- fsMetadataInto(".",data,4096);
        if (length <= 0 || !strStartsWith(cast<str>(data),"type=directory;length=")) return 1;
        if (fsPermissionsInto(".",data,4096) <= 0 || !strStartsWith(cast<str>(data),"readonly=")) return 2;
        if (listDirInto(".",null,0) < 0) return 3;
        if (officialPathInto(".",data,4096) <= 0 || !exists(cast<str>(data))) return 4;
        if (fsMetadataInto(".",null,0) != -2) return 5;
        println("filesystem-basics-ok");
        return 226;
    }
    ref main ->> run;
    fa: return true;
}
