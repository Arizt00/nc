nativeStcScalars {
    const:
        SEED >> u64 <- 0xFEDCBA9876543210;
    stc:
        counter >> int <- 7;
        zero >> u64;
        wide >> u64 <- SEED;
        small >> byte <- 251;
        negative >> i16 <- -123;
        enabled >> bool <- true;
        alias >> p<int> <- &counter;
    local:
        visits >> int <- 0;
    fn:
        bump() -> int {
            counter += 3;
            visits += 1;
            zero += 1;
            return counter;
        }
        run() -> int {
            if (counter != 7 || zero != 0 || wide != SEED) return 1;
            if (small != 251 || negative != -123 || !enabled) return 2;
            if (bump() != 10 || bump() != 13 || visits != 2 || zero != 2) return 3;
            wr(alias, 41);
            if (counter != 41 || rd(&counter) != 41) return 4;
            small <- 17;
            negative <- -321;
            enabled <- false;
            wide <- 0x8123456789ABCDEF;
            if (small != 17 || negative != -321 || enabled || wide != 0x8123456789ABCDEF) return 5;
            if (bump() != 44 || visits != 3) return 6;
            return 181;
        }
    ref main ->> run;
    fa:
        return true;
}
