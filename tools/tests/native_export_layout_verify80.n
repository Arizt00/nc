use <io:output>;
use <data:json>;
use <process:args>;

nativeExportLayoutVerify80 {
    stc: checks >> int <- 0; failures >> int <- 0;
    integer(object >> int, key >> str, fallback >> int) -> int {
        value >> int <- jsonObjectBorrow(object,key);
        result >> int <- jsonGetIntOr(value,fallback); jsonRelease(value); return result;
    }
    text(object >> int, key >> str) -> str {
        value >> int <- jsonObjectBorrow(object,key);
        result >> str <- jsonStringView(value,""); jsonRelease(value); return result;
    }
    expect(valid >> bool) -> void { checks += 1; if (!valid) failures += 1; }
    root(shape >> int, index >> int, bytes >> int, alignment >> int) -> void {
        types >> int <- jsonObjectBorrow(shape,"types"); node >> int <- jsonArrayBorrow(types,index);
        expect(integer(node,"layout_valid",0) == 1);
        expect(integer(node,"bytes",-1) == bytes); expect(integer(node,"align",-1) == alignment);
        jsonRelease(node); jsonRelease(types);
    }
    run() -> int {
        arguments >> addr <- argsOpen();
        if (arguments == null || argsCount(arguments) != 3) return 64;
        report >> int <- jsonParseFile(argsAt(arguments,1));
        symbols >> int <- jsonObjectBorrow(report,"symbols");
        bindings >> int <- jsonObjectBorrow(report,"bindings");
        expect(text(report,"status") == "resolved");
        seen >> int <- 0; at >> int <- 0;
        while (at < jsonArrayLen(symbols)) {
            symbol >> int <- jsonArrayBorrow(symbols,at); name >> str <- text(symbol,"name");
            shape >> int <- jsonObjectBorrow(symbol,"type_signature");
            if (name == "nativeTransitiveMid80.Packet") { root(shape,integer(shape,"result",-1),80,16); seen += 1; }
            if (name == "nativeTransitiveApi80.Box" || name == "nativeTransitiveApi80.make" || name == "nativeTransitiveApi80.mutate") {
                root(shape,integer(shape,"result",-1),112,16); seen += 1;
            }
            if (name == "nativeTransitiveApi80.SseBox" || name == "nativeTransitiveApi80.small" || name == "nativeTransitiveApi80.smallStep") {
                root(shape,integer(shape,"result",-1),16,8); seen += 1;
            }
            jsonRelease(shape); jsonRelease(symbol); at += 1;
        }
        expect(seen == 7); seen <- 0; at <- 0;
        while (at < jsonArrayLen(bindings)) {
            binding >> int <- jsonArrayBorrow(bindings,at); name >> str <- text(binding,"qualified");
            if (name == "nativeTransitiveApi80.mutate" || name == "nativeTransitiveMid80.mutate") {
                shape >> int <- jsonObjectBorrow(binding,"type_signature");
                bytes >> int <- name == "nativeTransitiveApi80.mutate" ? 112 : 80;
                root(shape,integer(shape,"result",-1),bytes,16);
                parameters >> int <- jsonObjectBorrow(shape,"parameters");
                parameter >> int <- jsonArrayBorrow(parameters,0);
                root(shape,jsonGetIntOr(parameter,-1),bytes,16);
                jsonRelease(parameter); jsonRelease(parameters); jsonRelease(shape); seen += 1;
            }
            jsonRelease(binding); at += 1;
        }
        expect(seen >= 2);
        result >> int <- jsonNewObject(); value >> int <- jsonNewInt(checks);
        jsonObjectSet(result,"checks",value); jsonRelease(value); value <- jsonNewInt(failures);
        jsonObjectSet(result,"failures",value); jsonRelease(value); value <- jsonNewBool(failures == 0);
        jsonObjectSet(result,"passed",value); jsonRelease(value);
        saved >> bool <- jsonSaveFile(result,argsAt(arguments,2),2);
        jsonRelease(result); jsonRelease(bindings); jsonRelease(symbols); jsonRelease(report); argsRelease(arguments);
        if (!saved || failures != 0) return 1;
        println("native-export-layouts-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
