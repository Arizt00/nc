use <io:output>;
use <project:memory_abi>;

nativeFileMapAbi75 {
    run() -> int {
        if (!memory_abi.nccMemoryAbi.selfTest()) return 1;
        id >> int <- 115;
        while (id <= 126) {
            count >> int <- memory_abi.nccMemoryAbi.arity(id);
            if (count < 1 || count > 8 || memory_abi.nccMemoryAbi.owner(id) != "os_windows") return 2;
            if (memory_abi.nccMemoryAbi.argumentCode(id,-1) != -1 ||
                memory_abi.nccMemoryAbi.argumentCode(id,count) != -1 ||
                memory_abi.nccMemoryAbi.pointerArgument(id,count)) return 3;
            at >> int <- 0;
            while (at < count) {
                code >> int <- memory_abi.nccMemoryAbi.argumentCode(id,at);
                if (code != 4 && code != 8 && code != 20 && code != 24) return 4;
                at += 1;
            }
            id += 1;
        }
        println("file-map-abi-ok");
        return 0;
    }
    ref main ->> run;
    fa: return true;
}
