use <project:leaf>;

nativeTransitiveMid80 {
    type:
        Packet {
            public:
                prefix >> byte;
                cells >> array<leaf.nativeTransitiveLeaf80.Cell,2>;
                packed >> leaf.nativeTransitiveLeaf80.Packed;
                word >> leaf.nativeTransitiveLeaf80.Word;
                tail >> int;
            layout: align(16);
        }
        Sse { public: pair >> leaf.nativeTransitiveLeaf80.Pair; }
    fn:
        public:
            make() -> Packet {
                a >> leaf.nativeTransitiveLeaf80.Cell <- leaf.nativeTransitiveLeaf80.Cell(tag: 7,score: 1.25);
                b >> leaf.nativeTransitiveLeaf80.Cell <- leaf.nativeTransitiveLeaf80.Cell(tag: 9,score: 2.5);
                return Packet(prefix: 11,cells: [a,b],packed: leaf.nativeTransitiveLeaf80.Packed(mark: 13,bits: 0x1234567890ABCDEF),
                    word: leaf.nativeTransitiveLeaf80.Word(value: 3.5),tail: 17);
            }
            mutate(value >> Packet) -> Packet { value.cells[1].tag += 1; value.tail += 2; return value; }
            sse(value >> Sse) -> Sse { value.pair <- leaf.nativeTransitiveLeaf80.pair(value.pair); return value; }
    fa: return true;
}
