use <io:output, concat>;
nativeConcatUnicodeV60 {
    run() -> int {
        a >> str <- "España ";
        b >> str <- "中文 😀";
        c >> str <- a+b;
        guard c == "España 中文 😀" && strByteLen(c) == 19 else return 1;
        prefix >> str <- concat("",c);
        guard prefix == c && cast<byte>(prefix) != cast<byte>(c) else return 2;
        println(c);
        guard strRelease(prefix) && strRelease(c) else return 3;
        return 155;
    }
    ref main ->> run;
    fa: return true;
}
