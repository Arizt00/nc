use <project:string_length>;

stringProviderNative53 {
    run() -> int {
        guard string_length.stringLengthProvider.provider_string_strByteLen("provider") == 8 else return 1;
        guard string_length.stringLengthProvider.provider_string_strLen("abc") == 3 else return 2;
        guard string_length.stringLengthProvider.provider_string_len("") == 0 else return 3;
        return 125;
    }
    ref main ->> run;
    fa: return true;
}
