use <io:output>;
use <data:json>;

nativeJsonFloatProbe77 {
    show(value >> ft64) -> void {
        bits >> u64 <- rd<u64>(cast<byte>(&value));
        high >> int <- bits >> 32; low >> int <- bits & 0xFFFFFFFF;
        print(high); print(" "); println(low);
    }
    run() -> int {
        value >> int <- jsonNewFloat(-0.125);
        show(jsonGetFloat(value)); show(jsonGetFloatOr(0,3.5));
        memory >> p<ft64> <- alloc(16);
        wr(memory,jsonGetFloat(value)); wr(off(memory,1),jsonGetFloatOr(0,3.5));
        show(rd(memory)); show(rd(off(memory,1)));
        integer >> p<u64> <- cast<u64>(memory);
        print(rd(integer) >> 32); print(" "); println(rd(off(integer,1)) >> 32);
        free(memory); jsonRelease(value); return 0;
    }
    ref main ->> run;
    fa: return true;
}
