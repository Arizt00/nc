use <data:json>;
use <io:output>;
use <project:closure43_core, closure43_host>;

closure43HostTests {
    fn:
        run() -> int {
            closure43_core.closure43Core.init(); report >> int <- jsonNewObject();
            name >> str <- closure43_core.closure43Core.hostName(); micros >> i64 <- closure43_host.closure43Host.micros();
            closure43_core.closure43Core.set(report,"host",name);
            closure43_core.closure43Core.put(report,"seconds",jsonNewInt(closure43_core.closure43Core.narrowTime(micros/1000000)));
            closure43_core.closure43Core.put(report,"fraction",jsonNewInt(closure43_core.closure43Core.narrowTime(micros%1000000)));
            closure43_core.closure43Core.set(report,"generated_at",closure43_core.closure43Core.iso());
            println(closure43_core.closure43Core.pretty(report)); jsonRelease(report); return name != "" && micros > 0 ? 0 : 1;
        }
    ref main ->> run;
    fa: return true;
}
