nativeHeapCallocV48 {
    run() -> int {
        cells >> p<u64> <- cast<u64>(calloc(4,8));
        if (cells == null) return 1;
        index >> int <- 0;
        while (index < 4) {
            if (rd(off(cells,index)) != 0) { free(cells); return 2; }
            index += 1;
        }
        wr(off(cells,3),0x123456789ABCDEF);
        value >> u64 <- rd(off(cells,3));
        return free(cells) && value == 0x123456789ABCDEF ? 73 : 3;
    }
    ref main ->> run;
    fa: return true;
}
