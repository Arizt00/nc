use <io:output>;
use <data:json>;
use <process:args>;

nativeOveralignmentVerify81 {
    stc: checks >> int <- 0; failures >> int <- 0;
    number(data >> p<byte>, at >> int, width >> int) -> u64 {
        value >> u64 <- 0; index >> int <- 0;
        while (index < width) { part >> u64 <- rd(off(data,at+index)); value <- value | (part << (index*8)); index += 1; }
        return value;
    }
    inside(at >> u64, bytes >> u64, total >> int) -> bool { return at <= total && bytes <= total-at; }
    name(data >> p<byte>, at >> int, total >> int, expected >> str) -> bool {
        width >> int <- strByteLen(expected); index >> int <- 0;
        if (at < 0 || at > total-width-1) return false;
        while (index < width) { if (rd(off(data,at+index)) != rd(off(cast<byte>(expected),index))) return false; index += 1; }
        return rd(off(data,at+width)) == 0;
    }
    expect(valid >> bool) -> void { checks += 1; if (!valid) failures += 1; }
    run() -> int {
        arguments >> addr <- argsOpen(); if (argsCount(arguments) != 3) return 64;
        bytes >> int <- fsSize(argsAt(arguments,1));
        if (bytes < 64 || bytes > 16777216) return 65;
        data >> p<byte> <- alloc(bytes); if (data == null) return 66;
        if (fsReadInto(argsAt(arguments,1),data,bytes) != bytes) return 67;
        elf >> bool <- number(data,0,4) == 0x464C457F;
        pe >> bool <- number(data,0,2) == 0x5A4D;
        coff >> bool <- number(data,0,2) == 0x8664;
        dataAt >> int <- -1; dataBytes >> int <- -1; dataAddress >> u64 <- 0; bssSeen >> bool <- false;
        image >> bool <- pe || (elf && number(data,16,2) == 2);
        if (elf) {
            table >> u64 <- number(data,40,8); count >> int <- number(data,60,2); names >> int <- number(data,62,2);
            if (!inside(table,count*64,bytes) || names >= count) return 68;
            namesAt >> u64 <- number(data,table+names*64+24,8);
            namesBytes >> u64 <- number(data,table+names*64+32,8);
            if (!inside(namesAt,namesBytes,bytes)) return 69;
            index >> int <- 0;
            while (index < count) {
                row >> int <- table+index*64; label >> u64 <- number(data,row,4);
                if (label < namesBytes && name(data,namesAt+label,bytes,".data")) {
                    dataAt <- number(data,row+24,8); dataBytes <- number(data,row+32,8); dataAddress <- number(data,row+16,8);
                    expect(number(data,row+48,8) == 8192 && dataAt % 8192 == 0);
                    if (image) expect(dataAddress % 8192 == 0);
                }
                if (label < namesBytes && name(data,namesAt+label,bytes,".bss")) {
                    bssSeen <- true; expect(number(data,row+48,8) == 8192 && number(data,row+32,8) == 16384);
                    if (image) expect(number(data,row+16,8) % 8192 == 0);
                }
                index += 1;
            }
        } else if (coff || pe) {
            header >> int <- pe ? number(data,60,4)+4 : 0;
            count >> int <- number(data,header+2,2); table >> int <- header+20+number(data,header+16,2);
            if (!inside(table,count*40,bytes)) return 70;
            base >> u64 <- pe ? number(data,header+20+24,8) : 0;
            index >> int <- 0;
            while (index < count) {
                row >> int <- table+index*40;
                if (name(data,row,bytes,".data")) {
                    dataBytes <- number(data,row+16,4); dataAt <- number(data,row+20,4); dataAddress <- base+number(data,row+12,4);
                    if (coff) expect((number(data,row+36,4) & 0x00F00000) == 0x00E00000);
                    else expect(dataAddress % 8192 == 0);
                }
                if (name(data,row,bytes,".bss")) {
                    bssSeen <- true; expect(number(data,row+16,4) == 16384);
                    expect((number(data,row+36,4) & 0x00F00000) == 0x00E00000);
                }
                index += 1;
            }
        } else return 71;
        expect(pe || bssSeen);
        if (dataAt < 0 || dataBytes < 16408 || !inside(dataAt,dataBytes,bytes)) return 72;
        if (!image) expect(dataBytes == 16408);
        alignment >> int <- 32;
        while (alignment <= 8192) {
            start >> int <- alignment == 32 ? 0 : alignment;
            expect(number(data,dataAt+start,8) == alignment+1);
            expect(number(data,dataAt+start+8,8) == alignment+3);
            index >> int <- start+16; end >> int <- alignment*2;
            while (index < end) { expect(number(data,dataAt+index,1) == 0); index += 1; }
            alignment *= 2;
        }
        if (image) {
            expect(number(data,dataAt+16384,8) == dataAddress);
            expect(number(data,dataAt+16392,8) == dataAddress+520);
            expect(number(data,dataAt+16400,8) == dataAddress+8192);
        } else {
            expect(number(data,dataAt+16384,8) == 0);
            expect(number(data,dataAt+16392,8) == 8);
            expect(number(data,dataAt+16400,8) == 0);
        }
        report >> int <- jsonNewObject(); value >> int <- jsonNewInt(checks); jsonObjectSet(report,"checks",value); jsonRelease(value);
        value <- jsonNewInt(failures); jsonObjectSet(report,"failures",value); jsonRelease(value);
        value <- jsonNewBool(failures == 0); jsonObjectSet(report,"passed",value); jsonRelease(value);
        saved >> bool <- jsonSaveFile(report,argsAt(arguments,2),2);
        jsonRelease(report); argsRelease(arguments); free(data);
        if (!saved || failures != 0) return 1;
        println("native-overalignment-bytes-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
