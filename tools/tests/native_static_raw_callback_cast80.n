use <io:output>;

nativeStaticRawCallbackCast80 {
    type: Callback { public: invoke >> fn(int) -> int; }
    stc: callback >> Callback <- Callback(invoke: cast<fn(int) -> int>(&foreignAbi));
    foreignAbi(value >> ft64) -> ft64 { return value+0.5; }
    run() -> int {
        if (adr(callback.invoke) != adr(&foreignAbi)) return 1;
        // The explicit cast preserves the address, not the incompatible ABI.
        // Invoking this callback would have undefined behavior; this test does not.
        println("native-raw-callback-cast-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
