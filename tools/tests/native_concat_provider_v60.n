use <project:string_concat_provider>;
use <io:output>;

nativeConcatProviderV60 {
    run() -> int {
        a >> str <- string_concat_provider.stringConcatProvider.provider_concat_concat("left","right");
        guard a == "leftright" && strByteLen(a) == 9 else return 1;
        b >> str <- string_concat_provider.stringConcatProvider.provider_concat_concat3("a","","b");
        guard b == "ab" && strRelease(a) && strRelease(b) else return 2;
        println("concat provider ok");
        return 151;
    }
    ref main ->> run;
    fa: return true;
}
