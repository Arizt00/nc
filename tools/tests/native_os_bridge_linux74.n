use <io:output>;

nativeOsBridgeLinux74 {
    run() -> int {
        slot >> p<int> <- cast<int>(osErrnoSlot());
        if (slot == null) return 1;
        previous >> int <- rd(slot);
        wr(slot,1234);
        if (vmLastError() != 1234) return 2;
        if (vmReserve(null,0,0) != null || vmLastError() != 22 || rd(slot) != 22) return 3;
        wr(slot,previous);
        println("native-linux-os-bridge-ok");
        return 245;
    }
    ref main ->> run;
    fa: return true;
}
