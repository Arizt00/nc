use <io:output>;
nativeConcatConstantV60 {
    const:
        LABEL >> str <- "constant"+" string";
    run() -> int {
        a >> str <- LABEL;
        b >> str <- LABEL;
        guard a == "constant string" && b == a && cast<byte>(a) != cast<byte>(b) else return 1;
        guard strRelease(a) && strRelease(b) else return 2;
        return 157;
    }
    ref main ->> run;
    fa: return true;
}
