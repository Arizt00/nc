use <io:output>;
use <project:mct_image_contract>;

imageWordContract70 {
    run() -> int {
        storage >> array<byte,32>;
        data >> p<byte> <- cast<byte>(&storage);
        mct_image_contract.nccMctImageContract.zero(data,32);
        small >> int <- 4194304;
        mct_image_contract.nccMctImageContract.put64(data,0,small);
        mct_image_contract.nccMctImageContract.put64(data,8,0xABCDEF0123456789);
        mct_image_contract.nccMctImageContract.put64Parts(data,16,1432778632,287454020);
        negative >> int <- -1;
        mct_image_contract.nccMctImageContract.put64(data,24,negative);
        if (rd<u64>(data) != 4194304) return 1;
        if (rd<u64>(off(data,8)) != 0xABCDEF0123456789) return 2;
        if (rd<u64>(off(data,16)) != 0x1122334455667788) return 3;
        if (rd<u64>(off(data,24)) != 0xFFFFFFFFFFFFFFFF) return 4;
        println("image-words-ok");
        return 236;
    }
    ref main ->> run;
    fa: return true;
}
