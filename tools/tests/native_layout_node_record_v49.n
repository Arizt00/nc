nativeLayoutNodeRecordV49 {
    type:
        NodeRecord {
            public:
                kind >> int;
                parent >> int;
                line >> int;
                column >> int;
                nameHash >> int;
                roleHash >> int;
                firstToken >> int;
                endToken >> int;
                firstChild >> int;
                nextSibling >> int;
                typeHash >> int;
                flags >> int;
                lastChild >> int;
                previousSibling >> int;
                originToken >> int;
                reserved >> int;
            layout:
                repr(C);
                align(8);
        }
    run() -> int {
        if (sizeOf(NodeRecord) != 64 || alignOf(NodeRecord) != 8) return 1;
        if (offsetOf<NodeRecord>(kind) != 0 || offsetOf<NodeRecord>(firstChild) != 32) return 2;
        if (offsetOf<NodeRecord>(lastChild) != 48 || offsetOf<NodeRecord>(originToken) != 56) return 3;
        return 92;
    }
    ref main ->> run;
    fa: return true;
}
