use <io:output>;

nativeOveralignmentMaxAbi81 {
    type:
        Block { public: value >> u64; layout: align(1048576); }
    change(value >> Block) -> Block {
        if (adr(&value) % 1048576 != 0) return value;
        value.value += 1; return value;
    }
    run() -> int {
        original >> Block;
        original.value = 73;
        changed >> Block <- change(original);
        if (adr(&original) % 1048576 != 0 || adr(&changed) % 1048576 != 0 ||
            original.value != 73 || changed.value != 74) return 1;
        println("native-overalignment-max-abi-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
