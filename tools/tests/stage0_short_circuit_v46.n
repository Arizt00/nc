stage0ShortCircuit {
    guarded(enabled >> bool, pointer >> p<int>) -> bool {
        return enabled && rd(pointer) == 7;
    }
    run() -> int {
        pointer >> p<int> <- null;
        if (guarded(false,pointer)) return 99;
        enabled >> bool <- true;
        if (!(enabled || rd(pointer) == 0)) return 98;
        if (!(enabled && (false || !guarded(false,pointer)))) return 97;
        return 7;
    }
    ref main ->> run;
    fa:
        return true;
}
