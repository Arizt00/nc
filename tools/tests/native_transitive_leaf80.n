nativeTransitiveLeaf80 {
    type:
        Cell { public: tag >> u16; score >> ft64; }
        Packed { public: mark >> byte; bits >> u64; layout: packed; }
        Word union { public: bits >> u64; value >> ft64; }
        Pair { public: first >> ft64; second >> ft64; }
    fn:
        public:
            pair(value >> Pair) -> Pair { value.second += 0.5; return value; }
    fa: return true;
}
