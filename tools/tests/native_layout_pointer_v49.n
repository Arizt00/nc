nativeLayoutPointerV49 {
    type:
        PointerShape {
            public:
                data >> p<byte>;
                length >> usize;
                tag >> int;
        }
    run() -> int {
        width >> int <- sizeOf<addr>();
        if (alignOf(PointerShape) != width) return 1;
        if (offsetOf<PointerShape>(length) != width || offsetOf<PointerShape>(tag) != width*2) return 2;
        if (sizeOf(PointerShape) != width*3) return 3;
        return 94;
    }
    ref main ->> run;
    fa: return true;
}
