use <io:output>;
use <text:string, parse>;

nativeTextRender66 {
    const: ITERATIONS >> int <- 2000;
    run() -> int {
        smallest >> str <- strFromInt(-2147483648);
        largest >> str <- strFromInt(2147483647);
        zero >> str <- strFromInt(0);
        yes >> str <- strFromBool(true); no >> str <- strFromBool(false);
        letter >> str <- charToStr('Q'); repeated >> str <- repeatChar('x',3);
        empty >> str <- repeatChar('x',0);
        joined >> str <- strConcat(smallest,largest);
        if (smallest != "-2147483648" || largest != "2147483647" || zero != "0") return 1;
        if (yes != "true" || no != "false" || letter != "Q" || charCode('Q') != 81) return 2;
        if (repeated != "xxx" || empty != "" || joined != "-21474836482147483647") return 3;
        strRelease(smallest); strRelease(largest); strRelease(zero); strRelease(yes); strRelease(no);
        strRelease(letter); strRelease(repeated); strRelease(empty); strRelease(joined);
        i >> int <- 0;
        while (i < ITERATIONS) {
            value >> str <- strFromInt(i-1000);
            if (parseInt(value) != i-1000) return 4;
            strRelease(value); i += 1;
        }
        println("text-render-ok"); return 205;
    }
    ref main ->> run;
    fa: return true;
}
