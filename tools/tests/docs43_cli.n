use <process:args>;
use <project:docs43_cli>;

docs43Entry {
    fn:
        run() -> int {
            args >> addr <- argsOpen();
            command >> str <- argsCount(args) > 1 ? argsAt(args,1) : "";
            code >> int <- docs43_cli.docs43Cli.execute(args,command);
            argsRelease(args); return code;
        }
    ref main ->> run;
    fa: return true;
}
