use <io:output>;
nativeStcStrings {
    stc:
        text >> str <- "initial";
        saved >> str <- "";
        calls >> int;
    fn:
        replace(value >> str) -> void {
            saved <- text;
            text <- value;
            calls += 1;
        }
        run() -> int {
            if (text != "initial" || saved != "" || calls != 0) return 1;
            replace("changed");
            if (text != "changed" || saved != "initial" || calls != 1) return 2;
            println(saved);
            println(text);
            replace("final");
            if (text != "final" || saved != "changed" || calls != 2) return 3;
            return 182;
        }
    ref main ->> run;
    fa:
        return true;
}
