use <project:fs_describe_host>;

fsDescribeSeedProbe69 {
    run() -> int {
        metadata >> array<u64,4>;
        if (!fs_describe_host.fsDescribeHost.inspect(".",cast<byte>(&metadata))) return 1;
        if (fs_describe_host.fsDescribeHost.names(".",null,0) < 0) return 2;
        text >> array<byte,32768>;
        if (fs_describe_host.fsDescribeHost.canonical(".",cast<byte>(&text),32768) <= 0) return 3;
        return 0;
    }
    ref main ->> run;
    fa: return true;
}
