use <process:args>;
use <io:erroroutput>;
use <project:physical43_cli>;

physical43Main {
    fn:
        public:
            run() -> int {
                arguments >> addr <- argsOpen();
                if (argsCount(arguments) < 2) { eprintln("physical43 requires a command"); argsRelease(arguments); return 2; }
                command >> str <- argsAt(arguments,1);
                if (command == "certify-raw-optimizer" || command == "certify_raw_optimizer.py") command <- "certify-final-pipeline";
                result >> int <- physical43_cli.physical43Cli.execute(arguments,command);
                argsRelease(arguments); return result;
            }
    ref main ->> run;
    fa: return true;
}
