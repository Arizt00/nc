use <process:args>;
use <project:frontend_programs_verify, release_io, process_capture>;

nativeFrontendRunner78 {
    run() -> int {
        arguments >> addr <- argsOpen();
        out >> str <- release_io.releaseIo.option(arguments,"--out","");
        directory >> str <- out+"/capture";
        if (out == "" || !release_io.releaseIo.makeDirectories(directory) || !process_capture.processCapture.configured(directory)) return 64;
        code >> int <- frontend_programs_verify.frontendProgramsVerify.run(arguments);
        argsRelease(arguments);
        strRelease(directory);
        return code;
    }
    ref main ->> run;
    fa: return true;
}
