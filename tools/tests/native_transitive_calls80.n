use <io:output>;
use <project:api>;

nativeTransitiveCalls80 {
    stc:
        storage >> api.nativeTransitiveApi80.Box;
        sse >> api.nativeTransitiveApi80.SseBox;
    run() -> int {
        if (sizeOf(api.nativeTransitiveApi80.Box) != 112 || alignOf(api.nativeTransitiveApi80.Box) != 16 ||
            offsetOf(api.nativeTransitiveApi80.Box,payload) != 16 || offsetOf(api.nativeTransitiveApi80.Box,sentinel) != 96) return 1;
        storage <- api.nativeTransitiveApi80.make();
        indirect >> fn(api.nativeTransitiveApi80.Box) -> api.nativeTransitiveApi80.Box <- &api.nativeTransitiveApi80.mutate;
        storage <- indirect(storage);
        if (storage.head != 23 || storage.payload.prefix != 11 || storage.payload.cells[0].tag != 7 ||
            storage.payload.cells[1].tag != 10 || storage.payload.cells[0].score != 1.25 || storage.payload.cells[1].score != 2.5 ||
            storage.payload.packed.mark != 13 || storage.payload.packed.bits != 0x1234567890ABCDEF ||
            storage.payload.word.value != 3.5 || storage.payload.tail != 19 || storage.sentinel != 32) return 2;
        sse <- api.nativeTransitiveApi80.small();
        step >> fn(api.nativeTransitiveApi80.SseBox) -> api.nativeTransitiveApi80.SseBox <- &api.nativeTransitiveApi80.smallStep;
        sse <- step(sse);
        if (sizeOf(api.nativeTransitiveApi80.SseBox) != 16 || sse.value.pair.first != 1.5 || sse.value.pair.second != 3.0) return 3;
        if (adr(&storage) % 16 != 0) return 4;
        println("native-transitive-calls-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
