use <io:output>;
use <project:api>;

nativeOveralignmentCalls81 {
    run() -> int {
        if (!api.nativeOveralignmentApi81.ready()) return 1;
        value >> api.nativeOveralignmentApi81.Box <- api.nativeOveralignmentApi81.make();
        if (adr(&value) % 512 != 0 || sizeOf(api.nativeOveralignmentApi81.Box) != 1536) return 2;
        next >> fn(api.nativeOveralignmentApi81.Box) -> api.nativeOveralignmentApi81.Box <- &api.nativeOveralignmentApi81.change;
        value <- next(value);
        if (value.tag != 7 || value.cell.value != 74 || value.cell.other != 3.0 || value.end != 13) return 3;
        value <- api.nativeOveralignmentApi81.change(value);
        if (value.cell.value != 75 || value.cell.other != 3.5 || value.end != 15) return 4;
        println("native-overalignment-units-ok"); return 0;
    }
    ref main ->> run;
    fa: return true;
}
