use <data:json>;
use <io:output>;

nativeJsonErrors67 {
    run() -> int {
        invalid >> int <- jsonParse("\n{\"key\":}");
        if (invalid != 0 || jsonErrorCode() == 0 || jsonErrorLine() != 2 || jsonErrorColumn() <= 1) return 1;
        code >> int <- jsonErrorCode();
        line >> int <- jsonErrorLine();
        column >> int <- jsonErrorColumn();
        if (jsonErrorCode() != code || jsonErrorLine() != line || jsonErrorColumn() != column) return 2;
        valid >> int <- jsonParse("[null, 1]");
        if (valid == 0 || jsonErrorCode() != 0 || jsonErrorLine() != 0 || jsonErrorColumn() != 0) return 3;
        jsonRelease(valid);
        println("json-errors-ok");
        return 214;
    }
    ref main ->> run;
    fa: return true;
}
