nativeStcAddends {
    const:
        LABEL >> str <- "offset";
    stc:
        middle >> p<byte> <- off(cast<byte>(LABEL), 2);
        far >> p<byte> <- off(cast<byte>(LABEL), 0x100000004);
        before >> p<byte> <- off(cast<byte>(LABEL), -1);
        physical >> addr <- adr(from<byte>(0xFFFF812345678000));
        chosen >> str <- true ? "selected" : "other";
    fn:
        run() -> int {
            base >> addr <- adr(cast<byte>(LABEL));
            middleAddress >> addr <- base+2;
            farAddress >> addr <- base+0x100000004;
            beforeAddress >> addr <- base-1;
            expectedPhysical >> addr <- 0xFFFF812345678000;
            if (adr(middle) != middleAddress || rd(middle) != 102) return 1;
            if (adr(far) != farAddress || adr(before) != beforeAddress) return 2;
            if (physical != expectedPhysical || chosen != "selected") return 3;
            return 186;
        }
    ref main ->> run;
    fa:
        return true;
}
