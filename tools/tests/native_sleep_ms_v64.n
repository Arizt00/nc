use <io:output>;

nativeSleepMs64 {
    fn:
        public:
            run() -> int {
                started >> int <- monotonicMs();
                sleepMs(-1);
                sleepMs(0);
                at >> int <- 0;
                while (at < 4) { sleepMs(25); at += 1; }
                elapsed >> int <- monotonicMs()-started;
                if (elapsed < 95 || elapsed > 10000) return 1;
                println("sleep-ms-ok");
                return 191;
            }
    ref main ->> run;
    fa: return true;
}
