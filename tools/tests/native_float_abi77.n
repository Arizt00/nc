floatAbi77 {
    fn:
        public:
    mixed(a >> int, b >> ft64, c >> int, d >> ft64, e >> ft64, f >> int,
        g >> ft64, h >> ft64, i >> ft64, j >> ft64, k >> ft64, l >> ft64,
        m >> int, n >> int, o >> int, p >> int) -> ft64 {
        return a+b+c+d+e+f+g+h+i+j+k+l+m+n+o+p;
    }
    calculate(value >> ft64) -> ft64 {
        result >> ft64 <- value*3.0;
        result += 0.5;
        return result/2.0-0.25;
    }
    narrow(value >> ft64) -> ft32 { return value; }
    widen(value >> ft32) -> ft64 { return value; }
    roundUnsigned(value >> u64) -> ft64 { return value; }
    intValue(value >> ft64) -> int { return cast<int>(value); }
    unsignedValue(value >> ft64) -> u64 { return cast<u64>(value); }
    compare(value >> ft64) -> bool {
        return !(value == value) && value != value && !(value < 1.0) &&
            !(value <= 1.0) && !(value > 1.0) && !(value >= 1.0);
    }
    fa: return true;
}
