use <project:command_provider>;
commandProviderProbe55 {
    run() -> int {
        child >> addr <- command_provider.commandProvider.provider_command_commandOpen("","",null,null,null,0);
        pipe >> addr <- command_provider.commandProvider.provider_command_commandPipeOpen(false,false);
        command_provider.commandProvider.provider_command_commandRelease(child);
        command_provider.commandProvider.provider_command_commandPipeRelease(pipe);
        return 0;
    }
    ref main ->> run;
    fa: return true;
}
