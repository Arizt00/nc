use <io:output>;
use <process:args>;

frontendInvalidOutput {
    fn:
        run() -> int {
            arguments >> addr <- argsOpen();
            selfTest >> bool <- argsCount(arguments) == 2 && argsAt(arguments,1) == "self-test";
            argsRelease(arguments);
            if (!selfTest) println("{not-valid-json");
            return 0;
        }
    ref main ->> run;
    fa: return true;
}
