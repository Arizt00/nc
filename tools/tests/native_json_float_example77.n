use <io:output>;
use <data:json>;

nativeJsonFloatExample77 {
    run() -> int {
        number >> int <- jsonNewFloat(0.1);
        if (number == 0) return 1;
        value >> ft64 <- jsonGetFloat(number);
        text >> str <- jsonStringify(number);
        println(text);
        valid >> bool <- value == 0.1 && text == "0.1";
        free(cast<byte>(text)); jsonRelease(number);
        return valid ? 0 : 2;
    }
    ref main ->> run;
    fa: return true;
}
