use::stoud::io::<output, render>;

demoMainBasico {
    stc:
        a >> int = 0;
        b >> int = 0;
        r >> int = 0;

    fn:
        public:
            run() -> bool {
                a <- 12;
                b <- 8;
                r <- (a * b) + (a - b);

                print("resultado = " + renderInt(r));
                return true;
            }

    ref main ->> run;

    fa:
        return true;
}
