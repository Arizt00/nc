{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "nC Backend Object IR",
  "scopeName": "source.nc.backend-object",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#properties" },
    { "include": "#numbers" },
    { "include": "#symbols" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.nc.backend-object",
          "match": ";.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.section.nc.backend-object",
          "match": "(?x)(?<![A-Za-z0-9_])\\.(?:section|symbols|relocations)\\b"
        },
        {
          "name": "entity.name.section.nc.backend-object",
          "match": "(?<=\\.section\\s)[.A-Za-z_][.A-Za-z0-9_$@-]*"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "support.type.property-name.nc.backend-object",
          "match": "\\b(?:target|triple|format|sections|symbols|relocs|kind|unit|size|section|offset|visibility|addend)\\b(?==)"
        },
        {
          "name": "keyword.operator.assignment.nc.backend-object",
          "match": "="
        },
        {
          "name": "constant.language.visibility.nc.backend-object",
          "match": "(?<==)(?:global|local|weak|hidden|external|public|private|internal)\\b"
        },
        {
          "name": "support.constant.relocation.nc.backend-object",
          "match": "(?<==)(?:call-near32|pc-relative|absolute|abs32|abs64|branch|jal|hi20|lo12|pcrel-hi20|pcrel-lo12|got|plt)[A-Za-z0-9_-]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nc.backend-object",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.integer.nc.backend-object",
          "match": "(?<![A-Za-z0-9_])-?[0-9][0-9_]*(?:B)?\\b"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "entity.name.function.nc.backend-object",
          "match": "(?<=^\\s{4})[A-Za-z_.$@][A-Za-z0-9_.$@:-]*(?=\\s+section=)"
        },
        {
          "name": "variable.other.symbol.nc.backend-object",
          "match": "(?<=symbol=)[A-Za-z_.$@][A-Za-z0-9_.$@:-]*"
        }
      ]
    }
  }
}
