{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "nC Target Init",
  "scopeName": "source.nc.target-init",
  "patterns": [
    { "name": "keyword.control.target-init.nc", "match": "\\bNCI1\\b" },
    { "name": "entity.name.tag.target-init.nc", "match": "^(?:schema|target|arch|abi|object|pointer-width|endian|entry|machine-sha256|payload-kind|payload-sha256|payload-bytes)(?=:)" },
    { "name": "constant.numeric.target-init.nc", "match": "(?<=:)(?:16|32|64|128|[0-9]+)$" },
    { "name": "constant.other.hash.target-init.nc", "match": "\\b[0-9a-fA-F]{64}\\b" },
    { "name": "constant.language.target-init.nc", "match": "\\b(?:little|big|elf32|elf64|coff|macho64|wasm|raw|startup-object|startup-module)\\b" },
    { "name": "string.unquoted.target-init.nc", "match": "(?<=:)[^\\r\\n]+" }
  ]
}
