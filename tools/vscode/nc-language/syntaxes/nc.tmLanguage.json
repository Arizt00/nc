{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "nC",
  "scopeName": "source.nc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#kernelcompact" },
    { "include": "#numbers" },
    { "include": "#modes" },
    { "include": "#imports" },
    { "include": "#mainfamily" },
    { "include": "#containers" },
    { "include": "#sections" },
    { "include": "#runtimefamily" },
    { "include": "#printfamily" },
    { "include": "#pointerfamily" },
    { "include": "#ffientities" },
    { "include": "#copyclone" },
    { "include": "#destructureconstructure" },
    { "include": "#diagnostics" },
    { "include": "#rawhazards" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#atgroups" },
    { "include": "#referential" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.nc", "match": "//.*$" },
        { "name": "comment.block.nc", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bytes.nc",
          "begin": "\\bb\\\"",
          "beginCaptures": { "0": { "name": "storage.type.bytes.nc" } },
          "end": "\\\"",
          "patterns": [
            { "name": "constant.character.escape.newline.nc", "match": "\\\\n" },
            { "name": "constant.character.escape.quote.nc", "match": "\\\\\\\"" },
            { "name": "constant.character.escape.backslash.nc", "match": "\\\\\\\\" },
            { "name": "invalid.illegal.escape.nc", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.double.nc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.newline.nc", "match": "\\\\n" },
            { "name": "constant.character.escape.print-control.nc", "match": "\\\\[&?#]" },
            { "name": "constant.character.escape.quote.nc", "match": "\\\\\"" },
            { "name": "constant.character.escape.backslash.nc", "match": "\\\\\\\\" },
            { "name": "constant.language.print-separator.nc", "match": "##" },
            { "name": "invalid.illegal.escape.nc", "match": "\\\\." }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.nc",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.newline.nc", "match": "\\\\n" },
            { "name": "constant.character.escape.print-control.nc", "match": "\\\\[&?#]" },
            { "name": "constant.character.escape.quote.nc", "match": "\\\\'" },
            { "name": "constant.character.escape.backslash.nc", "match": "\\\\\\\\" },
            { "name": "invalid.illegal.escape.nc", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.nc", "match": "\\b(?:0x[0-9A-Fa-f]+|0b[01]+|[0-9]+(?:\\.[0-9]+)?)\\b" }
      ]
    },
    "modes": {
      "patterns": [
        { "name": "keyword.other.nc.role.program", "match": "(?<=::\\s)program\\b" },
        { "name": "keyword.other.nc.role.runtime", "match": "(?<=::\\s)(?:runtime|network)\\b" },
        { "name": "keyword.other.nc.role.system", "match": "(?<=::\\s)(?:system|kernel)\\b" },
        { "name": "keyword.other.nc.role.tooling", "match": "(?<=::\\s)(?:tooling|compiler|security|inspect|ai)\\b" },
        { "name": "keyword.other.nc.role.lowlevel", "match": "(?<=::\\s)(?:machine|primitive|basal)\\b" }
      ]
    },
    "kernelcompact": {
      "patterns": [
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s+(at)\\b",
          "captures": { "1": { "name": "keyword.other.nc.kernel.address" } }
        },
        { "name": "support.function.nc.mmio.width8", "match": "(?:\\*\\s*8|\\b(?:load|store)8)(?=\\s*\\()" },
        { "name": "support.function.nc.mmio.width16", "match": "(?:\\*\\s*16|\\b(?:load|store)16)(?=\\s*\\()" },
        { "name": "support.function.nc.mmio.width32", "match": "(?:\\*\\s*32|\\b(?:load|store)32)(?=\\s*\\()" },
        { "name": "support.function.nc.mmio.width64", "match": "(?:\\*\\s*64|\\b(?:load|store)64)(?=\\s*\\()" },
        { "name": "support.function.nc.mmio.width128", "match": "(?:\\*\\s*128|\\b(?:load|store)128)(?=\\s*\\()" },
        { "name": "support.function.nc.mmio.width256", "match": "(?:\\*\\s*256|\\b(?:load|store)256)(?=\\s*\\()" },
        { "name": "support.function.nc.mmio.width512", "match": "(?:\\*\\s*512|\\b(?:load|store)512)(?=\\s*\\()" }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.facade.nc",
          "match": "\\b(use)\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*)(?:\\.([A-Za-z_][A-Za-z0-9_]*))?\\s*(:)\\s*([^>]*)\\s*(>)(\\s*;)",
          "captures": {
            "1": { "name": "keyword.control.import.nc" },
            "2": { "name": "punctuation.definition.import.begin.nc" },
            "3": { "name": "support.other.import.domain.nc" },
            "4": { "name": "support.other.import.family.nc" },
            "5": { "name": "punctuation.separator.import.nc" },
            "6": { "name": "support.other.import.item.nc" },
            "7": { "name": "punctuation.definition.import.end.nc" },
            "8": { "name": "punctuation.terminator.statement.nc" }
          }
        },
        {
          "name": "meta.import.material.nc",
          "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_\\.]*)\\s*(\\{)\\s*([^}]*)\\s*(\\})(\\s*;)",
          "captures": {
            "1": { "name": "keyword.control.import.nc" },
            "2": { "name": "support.other.import.path.nc" },
            "3": { "name": "punctuation.section.block.begin.nc" },
            "4": { "name": "support.other.import.item.nc" },
            "5": { "name": "punctuation.section.block.end.nc" },
            "6": { "name": "punctuation.terminator.statement.nc" }
          }
        },
        { "name": "keyword.control.import.nc", "match": "\\buse\\b" },
        { "name": "support.other.import.domain.nc", "match": "\\b(?:core|alloc|stoud|auth|dom|project)\\b(?=\\.)" },
        { "name": "support.other.import.path.nc", "match": "\\bnC\\.(?:runtime|high|compiler|system|tooling|inspect|ai)\\.[A-Za-z_][A-Za-z0-9_\\.]*\\b" }
      ]
    },
    "mainfamily": {
      "patterns": [
        { "name": "keyword.control.main.nc", "match": "\\b(?:to\\s+main|ref\\s+main)\\b" }
      ]
    },
    "containers": {
      "patterns": [
        {
          "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(?=\\{)",
          "captures": {
            "2": { "name": "entity.name.container.nc" }
          }
        },
        {
          "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(::)(\\s*)(?=(?:program|runtime|network|system|kernel|tooling|compiler|security|inspect|ai|machine|primitive|basal)\\b)",
          "captures": {
            "2": { "name": "entity.name.container.nc" },
            "4": { "name": "punctuation.separator.declaration.nc" }
          }
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "meta.declaration.function.compact.nc",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(in)\\b",
          "captures": {
            "1": { "name": "entity.name.function.nc" },
            "2": { "name": "punctuation.separator.declaration.nc" },
            "3": { "name": "storage.type.function.nc" }
          }
        },
        {
          "name": "meta.declaration.function.sectioned.nc",
          "match": "^\\s*((?!(?:if|while|for|match|guard|unless)\\b)[A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\([^)]*\\)\\s*->)",
          "captures": {
            "1": { "name": "entity.name.function.nc" }
          }
        },
        {
          "name": "meta.declaration.type.compact.nc",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(type)\\b",
          "captures": {
            "1": { "name": "entity.name.type.nc" },
            "2": { "name": "punctuation.separator.declaration.nc" },
            "3": { "name": "storage.type.nc" }
          }
        },
        { "name": "entity.name.section.static.nc", "match": "\\bstatic\\b(?=\\s*\\{)" },
        { "name": "invalid.deprecated.section.state.nc", "match": "\\bstate\\b(?=\\s*\\{)" },
        { "name": "entity.name.section.stack.nc", "match": "\\bstack\\b(?=\\s*\\{)" },
        { "name": "entity.name.section.stc.nc", "match": "\\bstc\\b(?=\\s*:)" },
        { "name": "entity.name.section.const.nc", "match": "\\bconst\\b(?=\\s*:)" },
        { "name": "entity.name.section.type.nc", "match": "\\btype\\b(?=\\s*:)" },
        { "name": "entity.name.section.local.nc", "match": "\\blocal\\b(?=\\s*:)" },
        { "name": "entity.name.section.function.nc", "match": "\\bfn\\b(?=\\s*:)" },
        { "name": "entity.name.section.fa.nc", "match": "\\bfa\\b(?=\\s*:)" },
        { "name": "storage.modifier.visibility.nc", "match": "\\b(?:public|internal|private)\\b(?=\\s*:)" },
        { "name": "invalid.deprecated.function.shutdown.nc", "match": "\\bshutdown\\b(?=\\s*::)" },
        { "name": "storage.type.abi.nc", "match": "\\babi\\b(?=\\s*\\{)" },
        { "name": "entity.name.section.nc", "match": "\\b(?:probe|binary|bind|raw|bridge|final|layout|ffi|entry|reg|label|inst)\\s*:" }
      ]
    },
    "runtimefamily": {
      "patterns": [
        { "name": "support.type.nc.runtime", "match": "\\bnC\\.runtime\\.[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "printfamily": {
      "patterns": [
        { "name": "support.function.nc.print", "match": "\\b(?:print|println)\\b(?!\\.)" },
        { "name": "support.function.nc.color", "match": "\\b(?:color|colorBold|bgColor|style|emoji|progressBar|spinnerFrame|table2|table3)\\b" }
      ]
    },
    "pointerfamily": {
      "patterns": [
        { "name": "support.function.nc.pointer", "match": "\\b(?:load|store|copy|fill|addr|size|align|offset|rd|wr|off|dist|nil|adr|from|asptr|pRead|pWrite|pOffset|pDiff|pNull|pRegion|pAt|pFromAddr|pCast|pAddr|ptrRead|ptrWrite|ptrOffset|ptrDiff|ptrIsNull|regionFromPtr|regionPtrAt|ptrFromAddr|ptrCast|ptrAddr)\\b" },
        { "name": "support.function.nc.pointer", "match": "\\b(?:Read|Write)(?=\\s*<)" }
      ]
    },
    "primitiveentities": {
      "patterns": [
        { "name": "support.function.primitive.nc", "match": "\\b(?:allow|deny|read|write|rw|route|stable|valid|line_ready|line_ack|await|barrier|ioaddr|timeout|cycles|capability|operation|port|anchor|slot|pattern|mask|window|signal|bus|state|timing|emit|sample|latch|assert|rupture|bridge|seal|voltage|current|clock|edge|latency|metastability|noise|temperature|power|thermalState|throttleState|cacheState|tlbState|pipelineState|branchPredictorState|reorderState|outOfOrder|powerGate|dmaChannel|interruptLine|watchdog|firmwareRegion|bootRom|bootRomRegion|biosRegion|uefiHandoff|resetVector|bootWindow|bootAnchor|firmwareTable|deviceTree|acpiTable|microcode|microcodeState|isa|protocol|controller|peripheral|phy|lane|channel|registerWindow|mmioWindow|portWindow|physicalEvent|asyncHardwareEvent|sideEffect|physicalFault|physicalFailure|physicalViolation)\\b" }
      ]
    },
    "hardwareentities": {
      "patterns": [
        { "name": "support.function.hardware.nc", "match": "\\b(?:voltage|current|clock|edge|latency|metastability|noise|temperature|power|thermalState|throttleState|cacheState|tlbState|pipelineState|branchPredictorState|reorderState|outOfOrder|powerGate|dmaChannel|interruptLine|watchdog|firmwareRegion|bootRom|bootRomRegion|biosRegion|uefiHandoff|resetVector|bootWindow|bootAnchor|firmwareTable|deviceTree|acpiTable|microcode|microcodeState|isa|protocol|controller|peripheral|phy|lane|channel|registerWindow|mmioWindow|portWindow|physicalEvent|asyncHardwareEvent|sideEffect|physicalFault|physicalFailure|physicalViolation)\\b" }
      ]
    },
    "machineentities": {
      "patterns": [
        { "name": "support.constant.machine.register.nc", "match": "\\b(?:reg\\.)?(?:r(?:ax|bx|cx|dx|si|di|sp|bp|ip|flags|8|9|10|11|12|13|14|15)|e(?:ax|bx|cx|dx|si|di|sp|bp|ip|flags)|a[lh]|b[lh]|c[lh]|d[lh]|[abcd]x|[sd]i|[sb]p|xmm[0-9]+|ymm[0-9]+|zmm[0-9]+|k[0-7]|cr[0-9]+|dr[0-9]+|x[0-9]+|w[0-9]+|r(?:[0-9]|1[0-5])|sp|lr|pc|fp|cpsr|spsr|v[0-9]+|z[0-9]+|p[0-9]+|ffr|nzcv|fpcr|fpsr|ra|gp|tp|t[0-6]|s(?:[0-9]|1[01])|a[0-7]|f[0-9]+)\\b" },
        { "name": "support.function.machine.nc", "match": "\\b(?:mov|movzx|movsx|movz|movk|lea|adr|adrp|add|adds|adc|adcx|adox|sub|subs|sbb|sbc|mul|imul|madd|mla|div|idiv|udiv|sdiv|rem|and|orr|or|eor|xor|not|neg|shl|shr|sar|lsl|lsr|asr|rol|ror|cmp|test|cmov|csel|setcc|jmp|je|jne|jal|jalr|beq|bne|blt|bge|call|bl|blr|br|ret|eret|push|pop|pushad|popad|in|out|hlt|nop|pause|mfence|sfence|lfence|dmb|dsb|isb|wfi|wfe|sev|fence|ecall|ebreak|mret|sret|ldr|str|ldp|stp|ldxr|stxr|ldrex|strex|cas|swp|amoadd\\.[wd]|lr\\.[wd]|sc\\.[wd]|aaa|aad|aam|aas|daa|das|salc|icebp|into|xlatb|getsec|rdpmc|rdpid|ud2|setend|dbg|cpsid|cpsie|qadd|qsub|ssat|usat|extr|ubfm|sbfm|bfm|paciasp|autiasp|xpaclri|xpaci|xpacd|paciza|autiza|pacia|autda|serialize|cldemote|clflush|clflushopt|clwb|prefetchnta|prefetcht0|prefetcht1|prefetcht2|monitor|mwait|umonitor|umwait|tpause|rdrand|rdseed|aesenc|pclmulqdq|sha256rnds2|vmxon|vmptrld|vmptrst|vmread|vmwrite|invept|invvpid|wbnoinvd|clts|clc|stc|cli|sti|cld|std|esb|tsb|dgh|xaflag|axflag|wfet|wfit|hvc|smc|hfence\\.(?:vvma|gvma)|hinval\\.(?:vvma|gvma)|hlv\\.(?:b|bu|h|hu|w|wu|d)|hlvx\\.(?:hu|wu)|hsv\\.(?:b|h|w|d)|cbo\\.(?:clean|flush|inval|zero)|fence\\.i|sfence\\.(?:vma|w\\.inval|inval\\.ir)|sinval\\.vma|csrr|csrw|csrrw|csrrs|csrrc|csrrwi|csrrsi|csrrci|czero\\.eqz|czero\\.nez|sext\\.[bh]|zext\\.h|orc\\.b|rev8|bseti|bclri|binvi|bexti|bset|bclr|binv|bext|whilelo|ptrue|pfalse|ld1[bhwd]|st1[bhwd]|cnt[bhwd]|inc[bhwd]|cmpeq|cmpne|cmplt|cmpgt|cmpge|cmple|sel|fmla|faddv|memory\\.(?:size|grow|copy|fill|init)|data\\.drop|table\\.(?:get|set|size|grow|fill|copy|init)|elem\\.drop|ref\\.(?:null|is_null|func)|local\\.(?:get|set|tee)|i32\\.(?:load|store|const|eqz|eq|ne|lt_s|lt_u|gt_s|gt_u|le_s|le_u|ge_s|ge_u|add|sub|mul|div_s|div_u|rem_s|rem_u|and|or|xor|shl|shr_s|shr_u|rotl|rotr)|i64\\.(?:load|store|const|eqz|add|sub|mul|div_s|div_u|and|or|xor|shl|shr_s|shr_u|rotl|rotr)|volatile|opcode|ModRM|SIB|REX|VEX|EVEX)\\b" }
      ]
    },
    "basalentities": {
      "patterns": [
        { "name": "support.function.basal.nc", "match": "\\b(?:root|binary|target|const|site|bind|routine|verify|report|seal|identity|version|profile|authority|evidence|lowering|kind|size|align|permissions|symbol|status|state|emit|require|hash|memory_anchor|evidence_anchor|source_hash)\\b" }
      ]
    },
    "ffientities": {
      "patterns": [
        { "name": "support.function.ffi.nc", "match": "\\b(?:foreign\\.c|foreign\\.cpp|foreign\\.rust|extern|abi|layout|ownership|lifetime|nullability|symbol|repr|bridge\\s+asm|caller|callee|borrowed|external|nullable|nonnullable)\\b" }
      ]
    },
    "copyclone": {
      "patterns": [
        { "name": "support.function.nc.copyclone", "match": "\\b(?:copy|copy\\.value|copy\\.ref|copy\\.ptr|copy\\.fn|copy\\.view|copy\\.deep|copy\\.binary|copy\\.unbinary|clone|clone\\.value|clone\\.shallow|clone\\.deep|clone\\.pointee|clone\\.region|clone\\.binary|clone\\.unbinary|clone\\.fn|clone\\.closure)\\b" }
      ]
    },
    "destructureconstructure": {
      "patterns": [
        { "name": "support.function.nc.nominal", "match": "\\b(?:destructure|destructure\\.static|destructure\\.move|destructure\\.ref|destructure\\.region|destructure\\.binary|destructure\\.ownership|constructure|constructure\\.static|constructure\\.move|constructure\\.copy|constructure\\.region|constructure\\.binary|constructure\\.unbinary)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "support.function.dev.nc", "match": "\\bdev(?=\\s*\\()" },
        { "name": "entity.name.function.nc", "match": "^\\s*[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\([^)]*\\)\\s*->)" },
        { "name": "storage.modifier.visibility.nc", "match": "\\b(?:public|internal|private)\\b" },
        { "name": "keyword.control.return.nc", "match": "\\breturn\\b" },
        { "name": "keyword.control.flow.nc", "match": "\\b(?:if|elseIf|else|while|for|loop|same|match|guard|unless)\\b" },
        { "name": "keyword.control.loop.nc", "match": "\\b(?:break|continue)\\b" },
        { "name": "keyword.control.nc", "match": "\\b(?:skip|stop|final|move|in|step|using|static|stack|stc|fa|const|abi)\\b" }
      ]
    },
    "diagnostics": {
      "patterns": [
        { "name": "invalid.illegal.nc.diagnostic", "match": "\\bE_(?:PTR|BASAL|NBB|TYPE|TEXT|PLUS|SEC|PRIMITIVE)_[A-Z0-9_]+\\b" }
      ]
    },
    "rawhazards": {
      "patterns": [
        { "name": "keyword.other.nc.rawhazard", "match": "\\b(?:risk|hazard|rawPtr|rawAddr|rawSite|unchecked|evidence\\s+boundary|raw_memory_access|raw_memory_read|raw_memory_write|aliasMutation)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "constant.language.boolean.nc", "match": "\\b(?:true|false)\\b" },
        { "name": "support.type.memregion.nc", "match": "\\bmemRegion\\b" },
        { "name": "support.type.nc.pointer", "match": "\\b(?:(?:p|ptr)\\??|(?:p|ptr)\\s+mut)(?=\\s*<)" },
        { "name": "support.type.array.nc", "match": "\\b(?:array|list|queue|vector|slice|span|bytes|matrix|tensor|dinArray|dinArray\\.binary|dinArray\\.unbinary)\\b" },
        { "name": "support.type.function.nc", "match": "\\bfn\\s*\\([^)]*\\)\\s*->\\s*[A-Za-z_][A-Za-z0-9_<>,\\s\\?\\.]*" },
        { "name": "support.type.generic.nc", "match": "<\\s*(?:[A-Za-z_][A-Za-z0-9_]*|[0-9]+)(?:\\s*,\\s*(?:[A-Za-z_][A-Za-z0-9_]*|[0-9]+))*\\s*>" },
        { "name": "support.type.advanced.nc", "match": "\\b(?:addr|ref\\??|ref\\s+mut|site|Result|Option|xy|xyz)\\b" },
        { "name": "support.type.basic.nc", "match": "\\b(?:int|u64|byte|bool|str|text|char|ft32|ft64|word|dword|qword|sbyte|sword|sdword|sqword|void|null)\\b" },
        { "name": "support.type.nc", "match": "\\b(?:int|u64|byte|bool|str|text|char|ft32|ft64|addr|word|dword|qword|sbyte|sword|sdword|sqword|void|null|p\\??|ptr\\??|ref\\??|site|memRegion|slice|span|bytes|array|list|queue|vector|Result|Option|xy|xyz|matrix|tensor|dinArray|dinArray\\.binary|dinArray\\.unbinary)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "invalid.illegal.removed-initializer.nc", "match": ":=" },
        { "name": "keyword.operator.assignment.material.nc", "match": "<-" },
        { "name": "punctuation.separator.declaration.nc", "match": "::" },
        { "name": "keyword.operator.projection.nc", "match": ">>" },
        { "name": "keyword.operator.verification.nc", "match": "!>" },
        { "name": "keyword.operator.nc.compound", "match": "(?:\\+\\+|--|\\+=|-=|=\\+|=-|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)" },
        { "name": "keyword.operator.nc", "match": "(?:->>|->|&&|\\|\\||==|!=|<=|>=|\\.\\.=|\\.\\.|\\+|\\-|\\*|/|%|&|\\||\\^|~|!|<|>|=)" }
      ]
    },
    "referential": {
      "patterns": [
        { "name": "variable.other.referential.nc", "match": "@[A-Za-z_][A-Za-z0-9_\\.]*" }
      ]
    },
    "atgroups": {
      "patterns": [
        {
          "name": "meta.group.at-reference.nc",
          "match": "(@)(\\()(\\s*)([A-Za-z_][A-Za-z0-9_\\.]*)(\\s*)(\\))",
          "captures": {
            "1": { "name": "keyword.operator.at.nc" },
            "2": { "name": "punctuation.section.parens.begin.nc" },
            "4": { "name": "variable.other.referential.group.nc" },
            "6": { "name": "punctuation.section.parens.end.nc" }
          }
        }
      ]
    }
  }
}
