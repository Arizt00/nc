{
  "$schema": "vscode://schemas/color-theme",
  "name": "nC Polyglot Systems",
  "type": "dark",
  "colors": {
    "editor.background": "#15151A",
    "editor.foreground": "#D9E6F2",
    "editor.selectionBackground": "#00599C55",
    "editorLineNumber.foreground": "#6A7A8C",
    "editorCursor.foreground": "#F89820",
    "editorError.foreground": "#CE412B",
    "editorWarning.foreground": "#F89820",
    "activityBar.background": "#15151A",
    "sideBar.background": "#15151A",
    "statusBar.background": "#00599C",
    "terminal.background": "#15151A",
    "terminal.foreground": "#D9E6F2"
  },
  "semanticTokenColors": {
    "mode": "#F89820",
    "basalEntity": "#DEA584",
    "kernelEntity": "#CE412B",
    "section": "#3776AB",
    "type": "#FFD43B",
    "pointerType": "#DEA584",
    "function": "#3776AB",
    "printFunction": "#5382A1",
    "pointerFunction": "#DEA584",
    "colorFunction": "#3A7D44",
    "controlFlow": "#F8961E",
    "loopControl": "#F9C74F",
    "kernelAddressKeyword": "#43AA8B",
    "kernelMmio8": "#F9C74F",
    "kernelMmio16": "#F9844A",
    "kernelMmio32": "#F94144",
    "kernelMmio64": "#A4568D",
    "kernelMmio128": "#659AD2",
    "kernelMmio256": "#2CC4D5",
    "kernelMmio512": "#90BE6D",
    "method": "#5382A1",
    "variable": "#D9E6F2",
    "parameter": "#A8B9CC",
    "property": "#3776AB",
    "operator": "#F89820",
    "number": "#FFD43B",
    "string": "#5382A1",
    "comment": "#6A7A8C",
    "stringEscape": "#FFD43B",
    "modeRuntime": "#5382A1",
    "modeCompiler": "#F89820",
    "modeSystem": "#659AD2",
    "modeMachine": "#00599C",
    "modePrimitive": "#CE412B",
    "modeKernel": "#CE412B",
    "modeBasal": "#DEA584",
    "runtimeFamily": "#5382A1",
    "compilerPhase": "#F89820",
    "primitiveEntity": "#CE412B",
    "hardwareEntity": "#FF4D6D",
    "machineRegister": "#00599C",
    "machineInstruction": "#00599C",
    "ffiSymbol": "#A8B9CC",
    "capability": "#DEA584",
    "policy": "#F89820",
    "diagnostic": "#CE412B",
    "rawHazard": "#CE412B",
    "importHint": "#A8B9CC",
    "importKeyword": "#A8B9CC",
    "importDomain": "#5382A1",
    "importFamily": "#659AD2",
    "importItem": "#FFD43B",
    "stcSection": "#3776AB",
    "typeSection": "#FFD43B",
    "localSection": "#659AD2",
    "constSection": "#F89820",
    "fnSection": "#3776AB",
    "faSection": "#DEA584",
    "atGroup": "#659AD2",
    "copyClone": "#A8B9CC",
    "destructure": "#DEA584",
    "constructure": "#659AD2"
  },
  "tokenColors": [
    { "scope": ["source.nc keyword.control.nc", "source.nc keyword.other.nc.mode"], "settings": { "foreground": "#F89820", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.nc"], "settings": { "foreground": "#3776AB", "fontStyle": "bold" } },
    { "scope": ["source.nc support.type.nc"], "settings": { "foreground": "#FFD43B" } },
    { "scope": ["source.nc support.type.nc.pointer"], "settings": { "foreground": "#DEA584", "fontStyle": "bold" } },
    { "scope": ["source.nc variable.other.referential.nc"], "settings": { "foreground": "#D9E6F2" } },
    { "scope": ["source.nc meta.group.at-reference.nc", "source.nc variable.other.referential.group.nc"], "settings": { "foreground": "#659AD2", "fontStyle": "bold" } },
    { "scope": ["source.nc constant.numeric.nc"], "settings": { "foreground": "#FFD43B" } },
    { "scope": ["source.nc string.quoted.double.nc", "source.nc string.quoted.single.nc"], "settings": { "foreground": "#5382A1" } },
    { "scope": ["source.nc constant.character.escape.nc", "source.nc constant.character.escape.newline.nc", "source.nc constant.character.escape.print-control.nc", "source.nc constant.character.escape.quote.nc", "source.nc constant.character.escape.backslash.nc"], "settings": { "foreground": "#FFD43B", "fontStyle": "bold" } },
    { "scope": ["source.nc comment.line.double-slash.nc", "source.nc comment.block.nc"], "settings": { "foreground": "#6A7A8C", "fontStyle": "italic" } },
    { "scope": ["source.nc keyword.other.nc.mode.runtime"], "settings": { "foreground": "#5382A1", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.compiler"], "settings": { "foreground": "#F89820", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.system"], "settings": { "foreground": "#659AD2", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.machine"], "settings": { "foreground": "#00599C", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.primitive"], "settings": { "foreground": "#CE412B", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.kernel"], "settings": { "foreground": "#CE412B", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.basal"], "settings": { "foreground": "#DEA584", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.stc.nc"], "settings": { "foreground": "#3776AB", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.type.nc"], "settings": { "foreground": "#FFD43B", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.local.nc"], "settings": { "foreground": "#659AD2", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.const.nc"], "settings": { "foreground": "#F89820", "fontStyle": "bold" } },
    { "scope": ["source.nc support.other.import.domain.nc"], "settings": { "foreground": "#5382A1" } },
    { "scope": ["source.nc support.other.import.family.nc"], "settings": { "foreground": "#659AD2" } },
    { "scope": ["source.nc support.other.import.item.nc"], "settings": { "foreground": "#FFD43B" } },

    { "scope": ["source.nc.machine keyword.other.nc.mode", "source.nc.machine entity.name.section.nc"], "settings": { "foreground": "#F3722C", "fontStyle": "bold" } },
    { "scope": ["source.nc.machine support.function.machine.nc"], "settings": { "foreground": "#F3722C", "fontStyle": "bold" } },
    { "scope": ["source.nc.machine support.constant.machine.register.nc"], "settings": { "foreground": "#F9C74F" } },
    { "scope": ["source.nc.machine support.type.nc", "source.nc.machine support.function.ffi.nc"], "settings": { "foreground": "#A8B9CC" } },
    { "scope": ["source.nc.machine constant.numeric.nc"], "settings": { "foreground": "#F9844A" } },

    { "scope": ["source.nc.basal keyword.other.nc.mode", "source.nc.basal entity.name.section.nc"], "settings": { "foreground": "#DEA584", "fontStyle": "bold" } },
    { "scope": ["source.nc.basal support.type.nc", "source.nc.basal support.type.nc.pointer"], "settings": { "foreground": "#F9C74F" } },
    { "scope": ["source.nc.basal constant.numeric.nc"], "settings": { "foreground": "#F9C74F" } },
    { "scope": ["source.nc.basal keyword.other.nc.rawhazard"], "settings": { "foreground": "#CE412B", "fontStyle": "bold" } },

    { "scope": ["source.nc.primitive keyword.other.nc.mode", "source.nc.primitive entity.name.section.nc"], "settings": { "foreground": "#A8B9CC", "fontStyle": "bold" } },
    { "scope": ["source.nc.primitive support.function.primitive.nc"], "settings": { "foreground": "#CE412B", "fontStyle": "bold" } },
    { "scope": ["source.nc.primitive support.type.nc"], "settings": { "foreground": "#659AD2" } },
    { "scope": ["source.nc.primitive constant.numeric.nc"], "settings": { "foreground": "#F94144" } },

    { "scope": ["support.function.ffi.nc"], "settings": { "foreground": "#A8B9CC" } },
    { "scope": ["support.type.nc.runtime"], "settings": { "foreground": "#5382A1" } },
    { "scope": ["keyword.other.nc.rawhazard"], "settings": { "foreground": "#CE412B", "fontStyle": "bold" } },
    { "scope": ["keyword.operator.nc"], "settings": { "foreground": "#F89820" } },
    { "scope": ["invalid.illegal.nc"], "settings": { "foreground": "#CE412B", "fontStyle": "bold" } }
  ]
}
