{
  "$schema": "vscode://schemas/color-theme",
  "name": "nC Source Light",
  "type": "light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#16202B",
    "editor.selectionBackground": "#93C5FD55",
    "editorLineNumber.foreground": "#718498",
    "editorCursor.foreground": "#0284C7",
    "editorError.foreground": "#DC2626",
    "editorWarning.foreground": "#B45309",
    "activityBar.background": "#F7FAFC",
    "sideBar.background": "#F7FAFC",
    "statusBar.background": "#16202B",
    "statusBar.foreground": "#FFFFFF",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#16202B"
  },
  "semanticTokenColors": {
    "type": "#1D4ED8",
    "class": "#16202B",
    "enum": "#1D4ED8",
    "interface": "#0E7490",
    "struct": "#0E7490",
    "typeParameter": "#7E22CE",
    "parameter": "#16202B",
    "variable": "#16202B",
    "property": "#006DCC",
    "enumMember": "#A16207",
    "function": "#2563EB",
    "printFunction": "#0284C7",
    "pointerFunction": "#BE123C",
    "colorFunction": "#4D7C0F",
    "controlFlow": "#C2410C",
    "loopControl": "#A16207",
    "kernelAddressKeyword": "#0F766E",
    "kernelMmio8": "#A16207",
    "kernelMmio16": "#C2410C",
    "kernelMmio32": "#BE123C",
    "kernelMmio64": "#7E22CE",
    "kernelMmio128": "#1D4ED8",
    "kernelMmio256": "#0E7490",
    "kernelMmio512": "#4D7C0F",
    "hardwareEntity": "#BE123C",
    "method": "#2563EB",
    "macro": "#B45309",
    "keyword": "#16202B",
    "modifier": "#16202B",
    "comment": "#718498",
    "string": "#4D7C0F",
    "number": "#A16207",
    "regexp": "#A21CAF",
    "operator": "#C2410C",
    "namespace": "#0284C7",
    "mode": "#7C3AED",
    "modeRuntime": "#0284C7",
    "modeCompiler": "#B45309",
    "modeSystem": "#7C3AED",
    "modeMachine": "#1D4ED8",
    "modePrimitive": "#BE123C",
    "modeKernel": "#DC2626",
    "modeBasal": "#7C3AED",
    "section": "#16202B",
    "pointerType": "#BE123C",
    "runtimeFamily": "#16202B",
    "importHint": "#0284C7",
    "importKeyword": "#0284C7",
    "importDomain": "#0284C7",
    "importFamily": "#0E7490",
    "importItem": "#4D7C0F",
    "container": "#16202B",
    "stcSection": "#008C6A",
    "typeSection": "#1D4ED8",
    "localSection": "#006DCC",
    "constSection": "#A16207",
    "fnSection": "#2563EB",
    "faSection": "#B45309",
    "mainFamily": "#7C3AED",
    "atReference": "#006DCC",
    "atGroup": "#0F766E",
    "projectionOperator": "#C2410C",
    "verificationOperator": "#BE185D",
    "devCall": "#DC2626",
    "returnKeyword": "#6D28D9",
    "basicType": "#1D4ED8",
    "advancedType": "#0E7490",
    "genericType": "#7E22CE",
    "arrayType": "#0F766E",
    "memRegionType": "#EA580C",
    "boolLiteral": "#A21CAF",
    "stringEscape": "#A16207",
    "rawHazard": "#DC2626"
  },
  "tokenColors": [
    { "scope": ["source.nc keyword.control.import.nc"], "settings": { "foreground": "#0284C7", "fontStyle": "bold" } },
    { "scope": ["source.nc support.other.import.path.nc", "source.nc support.other.import.domain.nc", "source.nc support.other.import.family.nc", "source.nc support.other.import.item.nc", "source.nc support.type.nc.runtime"], "settings": { "foreground": "#16202B" } },
    { "scope": ["source.nc support.other.import.domain.nc"], "settings": { "foreground": "#0284C7" } },
    { "scope": ["source.nc support.other.import.family.nc"], "settings": { "foreground": "#0E7490" } },
    { "scope": ["source.nc support.other.import.item.nc"], "settings": { "foreground": "#4D7C0F" } },
    { "scope": ["source.nc entity.name.container.nc"], "settings": { "foreground": "#16202B", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.stc.nc"], "settings": { "foreground": "#008C6A", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.type.nc"], "settings": { "foreground": "#1D4ED8", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.local.nc"], "settings": { "foreground": "#006DCC", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.const.nc"], "settings": { "foreground": "#A16207", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.fn.nc"], "settings": { "foreground": "#2563EB", "fontStyle": "bold" } },
    { "scope": ["source.nc entity.name.section.fa.nc"], "settings": { "foreground": "#B45309", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.runtime"], "settings": { "foreground": "#0284C7", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.compiler"], "settings": { "foreground": "#B45309", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.system"], "settings": { "foreground": "#7C3AED", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.machine"], "settings": { "foreground": "#1D4ED8", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.primitive"], "settings": { "foreground": "#BE123C", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.kernel"], "settings": { "foreground": "#DC2626", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.other.nc.mode.basal"], "settings": { "foreground": "#7C3AED", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.control.main.nc"], "settings": { "foreground": "#7C3AED", "fontStyle": "bold" } },
    { "scope": ["source.nc variable.other.referential.nc"], "settings": { "foreground": "#006DCC" } },
    { "scope": ["source.nc meta.group.at-reference.nc", "source.nc variable.other.referential.group.nc"], "settings": { "foreground": "#0F766E", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.operator.projection.nc"], "settings": { "foreground": "#C2410C", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.operator.verification.nc"], "settings": { "foreground": "#BE185D", "fontStyle": "bold" } },
    { "scope": ["source.nc support.function.dev.nc"], "settings": { "foreground": "#DC2626", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.control.return.nc"], "settings": { "foreground": "#6D28D9", "fontStyle": "bold" } },
    { "scope": ["source.nc support.type.basic.nc"], "settings": { "foreground": "#1D4ED8" } },
    { "scope": ["source.nc support.type.advanced.nc"], "settings": { "foreground": "#0E7490" } },
    { "scope": ["source.nc support.type.generic.nc"], "settings": { "foreground": "#7E22CE" } },
    { "scope": ["source.nc support.type.array.nc"], "settings": { "foreground": "#0F766E" } },
    { "scope": ["source.nc support.type.pointer.nc"], "settings": { "foreground": "#BE123C", "fontStyle": "bold" } },
    { "scope": ["source.nc support.type.memregion.nc"], "settings": { "foreground": "#EA580C", "fontStyle": "bold" } },
    { "scope": ["source.nc constant.language.boolean.nc"], "settings": { "foreground": "#A21CAF" } },
    { "scope": ["source.nc keyword.control.nc", "source.nc keyword.other.nc.mode"], "settings": { "foreground": "#16202B", "fontStyle": "bold" } },
    { "scope": ["source.nc keyword.operator.nc"], "settings": { "foreground": "#16202B" } },
    { "scope": ["source.nc variable.other.nc"], "settings": { "foreground": "#16202B" } },
    { "scope": ["source.nc constant.numeric.nc"], "settings": { "foreground": "#A16207" } },
    { "scope": ["source.nc string.quoted.double.nc", "source.nc string.quoted.single.nc"], "settings": { "foreground": "#4D7C0F" } },
    { "scope": ["source.nc constant.character.escape.nc", "source.nc constant.character.escape.newline.nc", "source.nc constant.character.escape.print-control.nc", "source.nc constant.character.escape.quote.nc", "source.nc constant.character.escape.backslash.nc"], "settings": { "foreground": "#A16207", "fontStyle": "bold" } },
    { "scope": ["source.nc comment.line.double-slash.nc", "source.nc comment.block.nc"], "settings": { "foreground": "#718498", "fontStyle": "italic" } },
    { "scope": ["source.nc support.type.nc"], "settings": { "foreground": "#1D4ED8" } },
    { "scope": ["source.nc support.function.nc.print"], "settings": { "foreground": "#0284C7" } },

    { "scope": ["source.nc.machine keyword.other.nc.mode", "source.nc.machine entity.name.section.nc"], "settings": { "foreground": "#C2410C", "fontStyle": "bold" } },
    { "scope": ["source.nc.machine support.function.machine.nc"], "settings": { "foreground": "#C2410C", "fontStyle": "bold" } },
    { "scope": ["source.nc.machine support.constant.machine.register.nc"], "settings": { "foreground": "#A16207" } },
    { "scope": ["source.nc.basal keyword.other.nc.mode", "source.nc.basal entity.name.section.nc"], "settings": { "foreground": "#7C3AED", "fontStyle": "bold" } },
    { "scope": ["source.nc.primitive keyword.other.nc.mode", "source.nc.primitive entity.name.section.nc"], "settings": { "foreground": "#BE123C", "fontStyle": "bold" } },
    { "scope": ["invalid.illegal.nc"], "settings": { "foreground": "#DC2626", "fontStyle": "bold" } }
  ]
}
