    "taskDefinitions": [
      {
        "type": "nc",
        "required": [
          "verb"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "description": "nC task verb (run/check/debug/nfmt)"
          }
        }
      }
    ],
    "configuration": {
      "title": "nC Language",
      "properties": {
        "nc.kit": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Active nC compiler kit name. Use `nC: Create ncc Kit` or `nC: Select ncc Kit` to populate it."
        },
        "nc.kitTransport": {
          "type": "string",
          "default": "native",
          "enum": [
            "native",
            "wsl"
          ],
          "markdownDescription": "How VS Code should execute the configured `nc.nccPath`: native process or WSL bridge."
        },
        "nc.runHost": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "powershell",
            "cmd",
            "wsl",
            "kali",
            "ubuntu",
            "linux"
          ],
          "markdownDescription": "Preferred host for Run/Debug. `auto` uses the best available route; WSL choices prefer Kali, Ubuntu or the first installed distro."
        },
        "nc.nccPath": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Path or command for `ncc`. `auto` tries `ncup`, PATH, workspace `target/debug`, workspace `.ncc/bin`, and WSL."
        },
        "nc.debugAdapterPath": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Path to `gdb`, `lldb-dap`, or `lldb-vscode` for native `.n` debugging. `auto` searches PATH, LLVM/MSYS2, and the selected WSL distribution."
        },
        "nc.ncupPath": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Path or command for `ncup`. `auto` searches PATH and then falls back to direct ncc kit discovery."
        },
        "nc.toolchain": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Toolchain selector (`auto` or concrete id/channel). Used when `ncup` is available."
        },
        "nc.profile": {
          "type": "string",
          "default": "standard",
          "enum": [
            "novice",
            "standard",
            "expert"
          ],
          "markdownDescription": "Editorial profile for diagnostics and low-level migration policy."
        },
        "nc.runProfile": {
          "type": "string",
          "default": "debug",
          "enum": [
            "debug",
            "interpreted",
            "real",
            "native-fast",
            "native-ffi",
            "release",
            "release-fast",
            "release-small",
            "unsafe-fast",
            "instrumented"
          ],
          "markdownDescription": "Execution profile used by Run. This is independent from the editorial diagnostics profile."
        },
        "nc.target": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Target triple for project builds and low-level lanes. `auto` selects the current host and is not appended to ordinary `ncc run` commands."
        },
        "nc.formatter": {
          "type": "string",
          "default": "nfmt",
          "enum": [
            "nfmt",
            "ncc-nfmt"
          ],
          "markdownDescription": "Formatting backend. The plugin always requests compact normal-form output through `nfmt --compact`."
        },
        "nc.lspMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "nclsp",
            "nc-sys-lsp",
            "nide-broker"
          ],
          "markdownDescription": "LSP routing mode: `auto` (lane-aware), force `nclsp`, force `nc-sys-lsp`, or force `nide-broker`."
        },
        "nc.editorAssistHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable non-authoritative editor assistance hints such as missing-import suggestions. Compiler diagnostics still come from `ncc`."
        },
        "nc.autoImportOnTokenComplete": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically insert or merge safe compact imports such as `use stoud.io { output };` when a completed token is followed by a token boundary such as `(`, `;`, whitespace, comma, or newline. Authorization imports remain quick-fix/policy-driven."
        },
        "nc.inlayHints.parameters": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show parameter name hints for known runtime, compiler and library calls."
        },
        "nc.inlayHints.types": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show inferred expression type hints when the visible source makes a local projection type obvious."
        }
      }
    },
    "iconThemes": [
      {
        "id": "nc-icons",
        "label": "nC File Icons",
        "path": "./icons/nc-icon-theme.json"
      }
    ]
  },
