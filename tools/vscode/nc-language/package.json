          "group": "navigation@1"
        },
        {
          "command": "nc.debug",
          "when": "editorLangId == nc || editorLangId == nc-root || editorLangId == nc-primitive || editorLangId == nc-hardware",
          "group": "navigation@2"
        },
        {
          "command": "nc.check",
          "when": "editorLangId == nc || editorLangId == nc-root || editorLangId == nc-machine || editorLangId == nc-primitive || editorLangId == nc-hardware",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "nc.run",
          "when": "editorLangId == nc || editorLangId == nc-root || editorLangId == nc-primitive || editorLangId == nc-hardware",
          "group": "navigation@1"
        },
        {
