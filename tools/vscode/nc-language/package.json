    "debuggers": [
      {
        "type": "nc",
        "label": "nC",
        "languages": [
          "nc",
          "nc-root",
          "nc-primitive",
          "nc-hardware"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Active nC file to debug.",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debug session.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at program entry before running user code.",
                "default": true
              },
              "lane": {
                "type": "string",
                "enum": [
                  "source",
                  "basal",
                  "machine",
                  "primitive"
                ],
                "description": "Execution lane. Normally inferred from the file extension."
              },
              "profile": {
                "type": "string",
                "description": "Debug profile or low-level lane profile.",
                "default": "debug"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nc",
            "request": "launch",
            "name": "nC: Debug Current File",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true
          }
        ]
      }
    ],
