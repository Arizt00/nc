{
  "name": "nc-language",
  "displayName": "nC Language",
  "description": "Official language support for nC: C/C++/Rust/Java-grade editing surface with syntax highlighting, semantic tokens, snippets, themes, file icons, and integration with ncc, nide, nclsp and nc-sys-lsp.",
  "version": "1.0.0-21v",
  "ncProductVersion": "1.0.0.21v",
  "ncProfessionalIdeParity": {
    "tier": "c_cpp_rust_java_grade",
    "referenceLanguages": [
      "c",
      "cpp",
      "rust",
      "java"
    ],
    "semanticAuthority": "ncc",
    "surfaces": [
      "liveCompilerDiagnostics",
      "nccStyleEditorDiagnostics",
      "semanticTokens",
      "syntaxHighlighting",
      "completion",
      "strongPredictiveCompletion",
      "autoImportAssistance",
      "hoverDocumentation",
      "inlayHints",
      "goToDefinition",
      "realNavigation",
      "projectImportNavigation",
      "closedProjectImportResolution",
      "findReferences",
      "documentSymbols",
      "safeRename",
      "codeActions",
      "predictiveCompletions",
      "codeLensRunDebug",
      "runCheckFormat",
      "documentFormatting",
      "nfmtCompactFormatter",
      "officialCompactSyntax",
      "legacyVerboseCompatibility",
      "stableTypeSurface",
      "externalStoudStdlibCatalog",
      "stoudIoMemoryCollectionsMathTimeFsNetProcessThread",
      "genericArityTyping",
      "vectorQueueTypeSurface",
      "nestedAggregateFieldCompletion",
      "functionValueTyping",
      "compoundOperatorTyping",
      "universalRunDebug",
      "nccDebugAdapter",
      "nccKitResolution",
      "toolchainResolution",
      "projectModelAwareness",
      "bridgeJsonAwareness",
      "nccCodeJsonAwareness",
      "projectGraphView",
      "projectMotherChildDetection",
      "projectDuplicateContainerWarnings",
      "perExtensionFileIcons",
      "fileIconIsolation",
      "externalThemeCompatibility",
      "lowLevelMachinePrimitiveRouting"
    ]
  },
  "publisher": "nc-lang",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aristtote/nc-language.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Linters",
    "Formatters",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:nc",
    "onLanguage:nc-root",
    "onLanguage:nc-machine",
    "onLanguage:nc-backend-object",
    "onLanguage:nc-target-init",
    "onLanguage:nc-primitive",
    "onLanguage:nc-hardware",
    "onDebugResolve:nc",
    "onCommand:nc.run",
    "onCommand:nc.debug",
    "onCommand:nc.check",
    "onCommand:nc.format",
    "onCommand:nc.showCompilerDiagnostics",
    "onCommand:nc.showCompilerPipeline",
    "onCommand:nc.showCompilerAst",
    "onCommand:nc.showCompilerIr",
    "onCommand:nc.showProjectGraph",
    "onCommand:nc.showRuntimeFamilies",
    "onCommand:nc.showRuntimeExports",
    "onCommand:nc.showRuntimeCapabilities",
    "onCommand:nc.showRuntimePolicies",
    "onCommand:nc.primitiveDoctor",
    "onCommand:nc.primitiveCheck",
    "onCommand:nc.primitiveWitness",
    "onCommand:nc.primitiveMap",
    "onCommand:nc.primitiveLower",
    "onCommand:nc.primitiveQemu",
    "onCommand:nc.createKit",
    "onCommand:nc.selectKit",
    "onCommand:nc.selectToolchain",
    "onCommand:nc.openBaseDoc",
    "onCommand:nc.runLegacy",
    "onCommand:nc.debugLegacy",
    "onCommand:nc.checkLegacy",
    "onCommand:nc.formatLegacy"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nc",
        "aliases": [
          "nC",
          "nc"
        ],
        "extensions": [
          ".n"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nc-root",
        "aliases": [
          "nC Root",
          "nc-root"
        ],
        "extensions": [
          ".nb"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nc-machine",
        "aliases": [
          "nC Machine",
          "nc-machine"
        ],
        "extensions": [
          ".nm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nc-backend-object",
        "aliases": [
          "nC Backend Object IR",
          "nc-nbo"
        ],
        "extensions": [
          ".nbo"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nc-target-init",
        "aliases": [
          "nC Target Init",
          "nc-target-init"
        ],
        "extensions": [
          ".init"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nc-primitive",
        "aliases": [
          "nC Primitive",
          "nc-primitive"
        ],
        "extensions": [
          ".nbb"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nc-hardware",
        "aliases": [
          "nC Hardware",
          "nc-hardware"
        ],
        "extensions": [
          ".ncp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
