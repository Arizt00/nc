use <io:output, render, std>;
use <process:args, command, env>;
use <fs:dir>;

buildProviders64 {
    fn:
        private:
            option(arguments >> addr, name >> str, fallback >> str) -> str {
                at >> int <- 1;
                while (at+1 < argsCount(arguments)) {
                    if (argsAt(arguments,at) == name) return argsAt(arguments,at+1);
                    at += 1;
                }
                return fallback;
            }
            quote(value >> str) -> str {
                if (strContains(value,"\"") || strContains(value,"\n") || strContains(value,"\r")) return "";
                return "\""+value+"\"";
            }
            copied(source >> str, destination >> str) -> bool {
                count >> int <- fsSize(source);
                if (count <= 0 || count > 4194304) return false;
                data >> p<byte> <- cast<byte>(alloc(count));
                if (data == null) return false;
                ok >> bool <- fsReadInto(source,data,count) == count && fsWriteFrom(destination,data,count,false) == count;
                free(data); return ok;
            }
            model(path >> str) -> int {
                count >> int <- fsSize(path);
                if (count <= 0 || count > 1048576) return 0;
                data >> p<byte> <- cast<byte>(alloc(count+1));
                if (data == null) return 0;
                if (fsReadInto(path,data,count) != count) { free(data); return 0; }
                wr(off(data,count),0);
                text >> str <- cast(data);
                value >> int <- jsonParse(text);
                free(data); return value;
            }
            invoke(line >> str, windows >> bool) -> bool {
                child >> addr <- commandOpen(line,".",windows ? stdIn() : null,windows ? stdOut() : null,windows ? stdErr() : null,0);
                if (child == null) return false;
                started >> bool <- commandStarted(child);
                waited >> int <- started ? commandWait(child,120000) : -1;
                if (started && waited != 0) { commandTerminate(child,15); commandWait(child,3000); }
                code >> int <- commandExitCode(child); commandRelease(child);
                if (!started || waited != 0 || code != 0) { println("provider v64 failed: "+line); return false; }
                return true;
            }
            build(arguments >> addr, windows >> bool) -> int {
                base >> str <- option(arguments,"--base","");
                out >> str <- option(arguments,"--out","");
                native >> str <- option(arguments,"--native-object","");
                host >> str <- option(arguments,"--host-object","");
                manifest >> int <- model(option(arguments,"--manifest","bootstrap/runtime-v64-exports.json"));
                if (manifest == 0 || base == "" || out == "" || native == "" || host == "") return 64;
                linker >> str <- option(arguments,"--linker",windows ? "C:/Program Files/LLVM/bin/lld-link.exe" : "ld");
                objcopy >> str <- option(arguments,"--objcopy",windows ? "C:/Program Files/LLVM/bin/llvm-objcopy.exe" : "llvm-objcopy");
                if (quote(out) == "" || quote(base) == "" || quote(native) == "" || quote(host) == "" || quote(linker) == "" || quote(objcopy) == "") return 64;
                if (!exists(out)) createDir(out);
                if (!exists(out)) return 73;
                suffix >> str <- windows ? ".obj" : ".o";
                exports >> int <- jsonObjectGet(manifest,"exports");
                additions >> int <- jsonObjectGet(manifest,"additions");
                objects >> int <- jsonObjectGet(manifest,"objects");
                if (jsonArrayLen(exports) != 117 || jsonArrayLen(additions) != 7 || jsonArrayLen(objects) != 22) return 65;
                rename >> str <- "";
                at >> int <- 0;
                while (at < jsonArrayLen(additions)) {
                    name >> str <- jsonGetStringOr(jsonArrayGet(additions,at),"");
                    split >> int <- 11;
                    while (split < strByteLen(name) && rd<byte>(off(cast<byte>(name),split)) != 46) { split += 1; }
                    if (split == strByteLen(name)) return 65;
                    identifier >> str <- "provider_"+strSubstring(name,11,split-11)+"_"+strSubstring(name,split+1,strByteLen(name)-split-1);
                    rename += " --redefine-sym nc$S$P$14$timeFsProvider$"+renderInt(strByteLen(identifier))+"$"+identifier+"="+name;
                    at += 1;
                }
                core >> str <- out+"/time_fs.exports"+suffix;
                if (!invoke(quote(objcopy)+rename+" "+quote(native)+" "+quote(core),windows)) return 1;
                hostNames >> str <- " --redefine-sym malloc=nC.runtime.heap.alloc --redefine-sym free=nC.runtime.heap.free";
                hostNames += " --redefine-sym timeFsHost_sleepMilliseconds=nc$S$P$10$timeFsHost$17$sleepMilliseconds";
                hostNames += " --redefine-sym timeFsHost_monotonicMilliseconds=nc$S$P$10$timeFsHost$21$monotonicMilliseconds";
                hostNames += " --redefine-sym timeFsHost_removeDirectory=nc$S$P$10$timeFsHost$15$removeDirectory";
                hostNames += " --redefine-sym timeFsHost_deleteFile=nc$S$P$10$timeFsHost$10$deleteFile";
                hostNames += " --redefine-sym timeFsHost_renameFile=nc$S$P$10$timeFsHost$10$renameFile";
                adapter >> str <- out+"/time_fs_host"+suffix;
                if (!invoke(quote(objcopy)+hostNames+" "+quote(host)+" "+quote(adapter),windows)) return 1;
                inputs >> str <- " "+quote(core)+" "+quote(adapter);
                at <- 0;
                while (at < jsonArrayLen(objects)) {
                    name >> str <- jsonGetStringOr(jsonArrayGet(objects,at),"")+suffix;
                    if (!copied(base+"/"+name,out+"/"+name)) return 74;
                    inputs += " "+quote(out+"/"+name); at += 1;
                }
                artifact >> str <- out+(windows ? "/ncruntime.dll" : "/libncruntime.so.2");
                if (windows) {
                    published >> str <- ""; at <- 0;
                    while (at < jsonArrayLen(exports)) {
                        published += " /export:"+jsonGetStringOr(jsonArrayGet(exports,at),""); at += 1;
                    }
                    support >> str <- option(arguments,"--compiler-support","C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/MSVC/14.44.35207/lib/x64/msvcrt.lib");
                    if (!invoke(quote(linker)+" /dll /noentry /nodefaultlib /opt:ref /machine:x64 /out:"+quote(artifact)+published+inputs+
                        " C:/msys64/mingw64/lib/libkernel32.a C:/msys64/mingw64/lib/libshell32.a "+quote(support),windows)) return 1;
                } else {
                    if (!copied(base+"/runtime.exports.map",out+"/runtime.exports.map")) return 74;
                    version >> str <- "NC_RUNTIME_64 { global: "; at <- 0;
                    while (at < jsonArrayLen(additions)) {
                        version += "\""+jsonGetStringOr(jsonArrayGet(additions,at),"")+"\"; "; at += 1;
                    }
                    version += "} NC_RUNTIME_62S;\n";
                    if (fsWriteFrom(out+"/runtime.exports.map",cast<byte>(version),strByteLen(version),true) != strByteLen(version)) return 74;
                    if (!invoke(quote(linker)+" -shared -z defs -z text -z noexecstack --gc-sections -soname libncruntime.so.2 --version-script "+quote(out+"/runtime.exports.map")+" -o "+quote(artifact)+inputs+" -lc",windows)) return 1;
                }
                jsonRelease(exports); jsonRelease(additions); jsonRelease(objects); jsonRelease(manifest);
                println("provider v64 built: "+artifact);
                return fsSize(artifact) > 0 ? 0 : 74;
            }
        public:
            run() -> int {
                arguments >> addr <- argsOpen();
                code >> int <- build(arguments,envHas("WINDIR"));
                argsRelease(arguments); return code;
            }
    ref main ->> run;
    fa: return true;
}
