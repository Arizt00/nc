use <io:output, render, std>;
use <process:args, command, env>;
use <fs:dir>;
buildProviders66 {
    fn:
        option(args >> addr, name >> str, fallback >> str) -> str {
            at >> int <- 1;
            while (at+1 < argsCount(args)) {
                if (argsAt(args,at) == name) return argsAt(args,at+1);
                at += 1;
            }
            return fallback;
        }
        quote(value >> str) -> str {
            if (strContains(value,"\"") || strContains(value,"\n") || strContains(value,"\r")) return "";
            return "\""+value+"\"";
        }
        invoke(line >> str, windows >> bool) -> bool {
            child >> addr <- commandOpen(line,".",windows ? stdIn() : null,windows ? stdOut() : null,windows ? stdErr() : null,0);
            if (child == null) return false;
            started >> bool <- commandStarted(child);
            waited >> int <- started ? commandWait(child,120000) : -1;
            if (started && waited != 0) { commandTerminate(child,15); commandWait(child,3000); }
            code >> int <- commandExitCode(child); commandRelease(child);
            if (!started || waited != 0 || code != 0) { println("provider v66 failed: "+line); return false; }
            return true;
        }
        build(args >> addr, windows >> bool) -> int {
            base >> str <- option(args,"--base","");
            out >> str <- option(args,"--out","");
            native >> str <- option(args,"--native-object","");
            manifest >> int <- jsonParseFile(option(args,"--manifest","bootstrap/runtime-v66-exports.json"));
            if (manifest == 0 || base == "" || out == "" || native == "") return 64;
            linker >> str <- option(args,"--linker",windows ? "C:/Program Files/LLVM/bin/lld-link.exe" : "ld");
            objcopy >> str <- option(args,"--objcopy",windows ? "C:/Program Files/LLVM/bin/llvm-objcopy.exe" : "objcopy");
            if (quote(base) == "" || quote(out) == "" || quote(native) == "" || quote(linker) == "" || quote(objcopy) == "") return 64;
            if (!exists(out)) createDir(out);
            if (!exists(out)) return 73;
            exports >> int <- jsonObjectGet(manifest,"exports");
            additions >> int <- jsonObjectGet(manifest,"additions");
            objects >> int <- jsonObjectGet(manifest,"objects");
            if (jsonArrayLen(exports) != 136 || jsonArrayLen(additions) != 19 || jsonArrayLen(objects) != 24) return 65;
            renames >> str <- ""; at >> int <- 0;
            while (at < jsonArrayLen(additions)) {
                name >> str <- jsonGetStringOr(jsonArrayGet(additions,at),"");
                split >> int <- 11;
                while (split < strByteLen(name) && rd<byte>(off(cast<byte>(name),split)) != 46) { split += 1; }
                if (split == strByteLen(name)) return 65;
                identifier >> str <- "provider_"+strSubstring(name,11,split-11)+"_"+strSubstring(name,split+1,strByteLen(name)-split-1);
                renames += " --redefine-sym nc$S$P$18$textScalarProvider$"+renderInt(strByteLen(identifier))+"$"+identifier+"="+name;
                at += 1;
            }
            suffix >> str <- windows ? ".obj" : ".o";
            core >> str <- out+"/text_scalar.exports"+suffix;
            if (!invoke(quote(objcopy)+renames+" "+quote(native)+" "+quote(core),windows)) return 1;
            inputs >> str <- " "+quote(core); at <- 0;
            while (at < jsonArrayLen(objects)) {
                path >> str <- base+"/"+jsonGetStringOr(jsonArrayGet(objects,at),"")+suffix;
                if (fsSize(path) <= 0) return 74;
                inputs += " "+quote(path); at += 1;
            }
            artifact >> str <- out+(windows ? "/ncruntime.dll" : "/libncruntime.so.2");
            if (windows) {
                published >> str <- ""; at <- 0;
                while (at < jsonArrayLen(exports)) {
                    published += " /export:"+jsonGetStringOr(jsonArrayGet(exports,at),""); at += 1;
                }
                support >> str <- option(args,"--compiler-support","C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/MSVC/14.44.35207/lib/x64/msvcrt.lib");
                if (!invoke(quote(linker)+" /dll /noentry /nodefaultlib /opt:ref /machine:x64 /out:"+quote(artifact)+published+inputs+
                    " C:/msys64/mingw64/lib/libkernel32.a C:/msys64/mingw64/lib/libshell32.a "+quote(support),windows)) return 1;
            } else {
                mapPath >> str <- base+"/runtime.exports.map";
                bytes >> int <- fsSize(mapPath);
                if (bytes <= 0) return 74;
                data >> p<byte> <- cast(alloc(bytes));
                if (data == null) return 74;
                valid >> bool <- fsReadInto(mapPath,data,bytes) == bytes && fsWriteFrom(out+"/runtime.exports.map",data,bytes,false) == bytes;
                free(data); if (!valid) return 74;
                version >> str <- "NC_RUNTIME_66 { global: "; at <- 0;
                while (at < jsonArrayLen(additions)) { version += "\""+jsonGetStringOr(jsonArrayGet(additions,at),"")+"\"; "; at += 1; }
                version += "} NC_RUNTIME_64;\n";
                if (fsWriteFrom(out+"/runtime.exports.map",cast<byte>(version),strByteLen(version),true) != strByteLen(version)) return 74;
                if (!invoke(quote(linker)+" -shared -z defs -z text -z noexecstack --gc-sections -soname libncruntime.so.2 --version-script "+quote(out+"/runtime.exports.map")+" -o "+quote(artifact)+inputs+" -lc",windows)) return 1;
            }
            jsonRelease(exports); jsonRelease(additions); jsonRelease(objects); jsonRelease(manifest);
            println("provider v66 built: "+artifact); return fsSize(artifact) > 0 ? 0 : 74;
        }
        run() -> int {
            args >> addr <- argsOpen(); code >> int <- build(args,envHas("WINDIR")); argsRelease(args); return code;
        }
    ref main ->> run;
    fa: return true;
}
