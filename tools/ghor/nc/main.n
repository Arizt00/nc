use <io:output>;
use <process:args>;
use <project:text, diagnostics, manifest, cargo_config, package_graph, transport, resolver, sha256, package_io, dependency_ops, registry, registry_mutation, registry_administration, artifact, build_pipeline, execution_pipeline, project_tools, assurance, certification, security, project_inspection, cargo_parity, build_boundaries, foreign_execution, system_adapters, install_lifecycle, bootstrap_authority, command>;

ghorStage1 {
    fn:
        selfTest() -> bool {
            return diagnostics.diagnostics.selfTest() &&
                manifest.manifest.selfTest() &&
                cargo_config.cargoConfig.selfTest() &&
                package_graph.ghorPackageGraph.selfTest() &&
                transport.transport.selfTest() &&
                resolver.resolver.selfTest() &&
                sha256.sha256.selfTest() &&
                package_io.package_io.selfTest() &&
                dependency_ops.dependency_ops.selfTest() &&
                registry.registry.selfTest() &&
                registry_mutation.registryMutation.selfTest() &&
                registry_administration.registryAdministration.selfTest() &&
                artifact.artifact.selfTest() &&
                build_pipeline.buildPipeline.selfTest() &&
                execution_pipeline.executionPipeline.selfTest() &&
                project_tools.projectTools.selfTest() &&
                assurance.assurance.selfTest() &&
                certification.certification.selfTest() &&
                security.security.selfTest() &&
                project_inspection.projectInspection.selfTest() &&
                cargo_parity.cargoParity.selfTest() &&
                build_boundaries.buildBoundaries.selfTest() &&
                foreign_execution.foreignExecution.selfTest() &&
                system_adapters.systemAdapters.selfTest() &&
                install_lifecycle.installLifecycle.selfTest() &&
                bootstrap_authority.bootstrapAuthority.selfTest() &&
                command.command.selfTest();
        }

        run() -> int {
            arguments >> addr <- argsOpen();
            if (arguments != null && argsError(arguments) == 0 && argsCount(arguments) > 1) {
                selected >> str <- argsAt(arguments, 1);
                if (text.ghorText.same(selected, "--version") ||
                    text.ghorText.same(selected, "-V") ||
                    text.ghorText.same(selected, "version")) {
                    println("ghor 0.1.0");
                    argsRelease(arguments);
                    return 0;
                }
                if (text.ghorText.same(selected, "manifest")) {
                    exitCode >> int <- package_graph.ghorPackageGraph.executeManifest(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (package_graph.ghorPackageGraph.supports(arguments)) {
                    exitCode >> int <- package_graph.ghorPackageGraph.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (resolver.resolver.supports(arguments)) {
                    exitCode >> int <- resolver.resolver.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (package_io.package_io.supports(arguments)) {
                    exitCode >> int <- package_io.package_io.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (dependency_ops.dependency_ops.supports(arguments)) {
                    exitCode >> int <- dependency_ops.dependency_ops.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (registry.registry.supports(arguments)) {
                    exitCode >> int <- registry.registry.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (registry_administration.registryAdministration.supports(arguments)) {
                    exitCode >> int <- registry_administration.registryAdministration.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (artifact.artifact.supports(arguments)) {
                    exitCode >> int <- artifact.artifact.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (build_pipeline.buildPipeline.supports(arguments)) {
                    exitCode >> int <- build_pipeline.buildPipeline.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (execution_pipeline.executionPipeline.supports(arguments)) {
                    exitCode >> int <- execution_pipeline.executionPipeline.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (project_tools.projectTools.supports(arguments)) {
                    exitCode >> int <- project_tools.projectTools.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (bootstrap_authority.bootstrapAuthority.supports(arguments)) {
                    exitCode >> int <- bootstrap_authority.bootstrapAuthority.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (assurance.assurance.supports(arguments)) {
                    exitCode >> int <- assurance.assurance.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (certification.certification.supports(arguments)) {
                    exitCode >> int <- certification.certification.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (security.security.supports(arguments)) {
                    exitCode >> int <- security.security.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (project_inspection.projectInspection.supports(arguments)) {
                    exitCode >> int <- project_inspection.projectInspection.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (cargo_parity.cargoParity.supports(arguments)) {
                    exitCode >> int <- cargo_parity.cargoParity.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (build_boundaries.buildBoundaries.supports(arguments)) {
                    exitCode >> int <- build_boundaries.buildBoundaries.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (foreign_execution.foreignExecution.supports(arguments)) {
                    exitCode >> int <- foreign_execution.foreignExecution.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (system_adapters.systemAdapters.supports(arguments)) {
                    exitCode >> int <- system_adapters.systemAdapters.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (install_lifecycle.installLifecycle.supports(arguments)) {
                    exitCode >> int <- install_lifecycle.installLifecycle.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                if (registry_mutation.registryMutation.supports(arguments)) {
                    exitCode >> int <- registry_mutation.registryMutation.execute(arguments);
                    argsRelease(arguments);
                    return exitCode;
                }
                argsRelease(arguments);
                return 64;
            }
            if (arguments != null) { argsRelease(arguments); }
            guard diagnostics.diagnostics.selfTest() else return 11;
            guard manifest.manifest.selfTest() else return 12;
            guard cargo_config.cargoConfig.selfTest() else return 13;
            guard package_graph.ghorPackageGraph.selfTest() else return 14;
            guard transport.transport.selfTest() else return 15;
            guard resolver.resolver.selfTestCode() == 0 else return 16;
            guard sha256.sha256.selfTest() else return 17;
            guard package_io.package_io.selfTest() else return 18;
            guard dependency_ops.dependency_ops.selfTest() else return 19;
            guard registry.registry.selfTest() else return 20;
            guard registry_mutation.registryMutation.selfTest() else return 21;
            guard registry_administration.registryAdministration.selfTest() else return 22;
            guard artifact.artifact.selfTest() else return 23;
            guard build_pipeline.buildPipeline.selfTest() else return 24;
            guard execution_pipeline.executionPipeline.selfTest() else return 25;
            guard project_tools.projectTools.selfTest() else return 26;
            guard assurance.assurance.selfTest() else return 27;
            guard certification.certification.selfTest() else return 28;
            guard security.security.selfTest() else return 29;
            guard project_inspection.projectInspection.selfTest() else return 30;
            guard cargo_parity.cargoParity.selfTest() else return 31;
            guard build_boundaries.buildBoundaries.selfTest() else return 32;
            guard foreign_execution.foreignExecution.selfTest() else return 33;
            guard system_adapters.systemAdapters.selfTest() else return 34;
            guard install_lifecycle.installLifecycle.selfTest() else return 35;
            guard bootstrap_authority.bootstrapAuthority.selfTest() else return 36;
            guard command.command.selfTest() else return 37;
            return 0;
        }

    ref main ->> run;

    fa:
        return true;
}
