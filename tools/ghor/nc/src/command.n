use <project:text>;

command {
    fn:
        private:
            same(command >> str, expected >> str) -> bool {
                return text.ghorText.same(command, expected);
            }

            buildFamily(command >> str) -> bool {
                return same(command, "new") || same(command, "init") ||
                    same(command, "check") || same(command, "build") ||
                    same(command, "run") || same(command, "test") ||
                    same(command, "bench") || same(command, "clean") ||
                    same(command, "fmt") || same(command, "lint") ||
                    same(command, "doc");
            }

            packageFamily(command >> str) -> bool {
                return same(command, "package") || same(command, "publish") ||
                    same(command, "install") || same(command, "uninstall") ||
                    same(command, "bin") || same(command, "update") ||
                    same(command, "tree") || same(command, "metadata") ||
                    same(command, "manifest") || same(command, "target") ||
                    same(command, "profile") || same(command, "features") ||
                    same(command, "cross") || same(command, "link") ||
                    same(command, "native-deps") || same(command, "ffi-manifest") ||
                    same(command, "artifact") || same(command, "fetch") ||
                    same(command, "report") || same(command, "toolchain") ||
                    same(command, "verify-toolchain") || same(command, "sync-toolchain") ||
                    same(command, "graph") || same(command, "vendor") ||
                    same(command, "workspace") || same(command, "add") ||
                    same(command, "remove") || same(command, "resolve") ||
                    same(command, "lock") || same(command, "verify-lock") ||
                    same(command, "generate-lockfile") ||
                    same(command, "locate-project") || same(command, "read-manifest") ||
                    same(command, "pkgid") || same(command, "unit-graph") ||
                    same(command, "timings") || same(command, "fix");
            }

            registryFamily(command >> str) -> bool {
                return same(command, "registry") || same(command, "cdn") ||
                    same(command, "governance") || same(command, "moderation") ||
                    same(command, "search") || same(command, "info") ||
                    same(command, "login") || same(command, "logout") ||
                    same(command, "owner") || same(command, "yank") ||
                    same(command, "audit") || same(command, "sbom") ||
                    same(command, "license") || same(command, "supply-chain") ||
                    same(command, "capability-audit");
            }

            systemsFamily(command >> str) -> bool {
                return same(command, "machine") || same(command, "basal") ||
                    same(command, "runtime") || same(command, "compiler") ||
                    same(command, "primitive") || same(command, "interop") ||
                    same(command, "cargo-exec") || same(command, "build-script") ||
                    same(command, "proc-macro") || same(command, "external-compat") ||
                    same(command, "lang");
            }

            assuranceFamily(command >> str) -> bool {
                return same(command, "doctor") || same(command, "verify") ||
                    same(command, "evidence") || same(command, "seal") ||
                    same(command, "conformance") || same(command, "public-beta") ||
                    same(command, "release-check") || same(command, "release-hardening") ||
                    same(command, "install-smoke") || same(command, "bootstrap");
            }

        public:
            known(command >> str) -> bool {
                return buildFamily(command) || packageFamily(command) ||
                    registryFamily(command) || systemsFamily(command) ||
                    assuranceFamily(command);
            }

            materializesMachine(command >> str) -> bool {
                return same(command, "build") || same(command, "run") ||
                    same(command, "test") || same(command, "bench") ||
                    same(command, "cross") || same(command, "link") ||
                    same(command, "artifact") || same(command, "machine") ||
                    same(command, "compiler");
            }

            requiresNetwork(command >> str) -> bool {
                return same(command, "publish") || same(command, "registry") ||
                    same(command, "cdn") || same(command, "moderation") ||
                    same(command, "install") || same(command, "update") ||
                    same(command, "fetch") || same(command, "search") ||
                    same(command, "info") || same(command, "login") ||
                    same(command, "logout") || same(command, "owner") ||
                    same(command, "yank");
            }

            selfTest() -> bool {
                return known("build") && known("uninstall") && known("unit-graph") &&
                    known("verify-toolchain") && known("external-compat") &&
                    known("release-hardening") && materializesMachine("run") &&
                    requiresNetwork("publish") && !known("unknown");
            }

    fa:
        return true;
}
