ghorText {
    fn:
        public:
            same(left >> str, right >> str) -> bool {
                leftBytes >> p<byte> <- cast(left);
                rightBytes >> p<byte> <- cast(right);
                position >> int <- 0;
                while (true) {
                    leftByte >> byte <- rd(off(leftBytes, position));
                    rightByte >> byte <- rd(off(rightBytes, position));
                    guard leftByte == rightByte else return false;
                    guard leftByte != 0 else return true;
                    position += 1;
                }
                return false;
            }

            selfTest() -> bool {
                return same("ghor", "ghor") && !same("ghor", "cargo");
            }

    fa:
        return true;
}
