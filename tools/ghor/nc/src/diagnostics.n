diagnostics {
    fn:
        private:
            same(left >> str, right >> str) -> bool {
                a >> p<byte> <- cast(left);
                b >> p<byte> <- cast(right);
                at >> int <- 0;
                while (rd(off(a, at)) != 0 && rd(off(b, at)) != 0) {
                    if (rd(off(a, at)) != rd(off(b, at))) return false;
                    at += 1;
                }
                return rd(off(a, at)) == rd(off(b, at));
            }

        public:
            codeKnown(code >> str) -> bool {
                if (same(code, "E_GHOR_CLI_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_MANIFEST_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_WORKSPACE_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_LOCK_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_RESOLVE_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_MACHINE_001") || same(code, "E_GHOR_MACHINE_002")) {
                    return true;
                }
                if (same(code, "E_GHOR_BASAL_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_TOOLCHAIN_STALE_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_PUBLIC_BETA_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_RELEASE_HARDENING_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_INSTALL_SMOKE_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_CHECKSUM_001") ||
                    same(code, "E_GHOR_SUPPLY_CHAIN_001")) {
                    return true;
                }
                if (same(code, "E_GHOR_TARGET_001") ||
                    same(code, "E_GHOR_REPORT_001") ||
                    same(code, "E_GHOR_GRAPH_001")) {
                    return true;
                }
                return false;
            }

            selfTest() -> bool {
                return true;
            }

    fa:
        return true;
}
