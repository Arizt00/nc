use <project:fs_path_host>;

fsPathProvider {
    fn:
        public:
    provider_fs_absolutePathInto(path >> str, out >> p<byte>, capacity >> u64) -> int {
        if (cast<byte>(path) == null || rd(cast<byte>(path)) == 0) return -1;
        if (out == null || capacity == 0) return -2;
        return fs_path_host.fsPathHost.absolute(path,out,capacity);
    }
    fa: return true;
}
