
wallClockHost {
    type:
        Timespec { public: seconds >> u64; nanoseconds >> u64; }
    fn:
        public:
            milliseconds() -> i64 {
                value >> Timespec <- Timespec(seconds: 0, nanoseconds: 0);
                if (osLclock_gettime(0,adr(&value)) != 0) return -1;
                seconds >> i64 <- value.seconds;
                fraction >> i64 <- value.nanoseconds / 1000000;
                return seconds*1000+fraction;
            }
    fa: return true;
}
