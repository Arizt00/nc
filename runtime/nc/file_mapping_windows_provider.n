fileMappingWindowsProvider :: runtime {
    fn:
        public:
            provider_osCreateFileW(path >> p<u16>, access >> u32, sharing >> u32,
                security >> p<byte>, creation >> u32, flags >> u32, template >> p<byte>) -> p<byte> {
                return cast<byte>(osCreateFileW(path,access,sharing,security,creation,flags,template));
            }
            provider_osCreateFileMappingW(file >> p<byte>, security >> p<byte>, protection >> u32,
                high >> u32, low >> u32, name >> p<u16>) -> p<byte> {
                return cast<byte>(osCreateFileMappingW(file,security,protection,high,low,name));
            }
            provider_osOpenFileMappingW(access >> u32, inherit >> i32, name >> p<u16>) -> p<byte> {
                return cast<byte>(osOpenFileMappingW(access,inherit,name));
            }
            provider_osCloseHandle(handle >> p<byte>) -> i32 { return osCloseHandle(handle); }
            provider_osSetFilePointerEx(file >> p<byte>, distance >> i64, position >> p<i64>, origin >> u32) -> i32 {
                return osSetFilePointerEx(file,distance,position,origin);
            }
            provider_osSetEndOfFile(file >> p<byte>) -> i32 { return osSetEndOfFile(file); }
            provider_osFlushFileBuffers(file >> p<byte>) -> i32 { return osFlushFileBuffers(file); }
            provider_osReadFile(file >> p<byte>, data >> p<byte>, bytes >> u32,
                read >> p<u32>, overlapped >> p<byte>) -> i32 {
                return osReadFile(file,data,bytes,read,overlapped);
            }
            provider_osDeleteFileW(path >> p<u16>) -> i32 { return osDeleteFileW(path); }
            provider_osGetFileSizeEx(file >> p<byte>, bytes >> p<i64>) -> i32 { return osGetFileSizeEx(file,bytes); }
            provider_osDeviceIoControl(file >> p<byte>, code >> u32, input >> p<byte>, inputBytes >> u32,
                output >> p<byte>, outputBytes >> u32, returned >> p<u32>, overlapped >> p<byte>) -> i32 {
                return osDeviceIoControl(file,code,input,inputBytes,output,outputBytes,returned,overlapped);
            }
            provider_osGetCompressedFileSizeW(path >> p<u16>, high >> p<u32>) -> u32 {
                return osGetCompressedFileSizeW(path,high);
            }
    fa: return true;
}
