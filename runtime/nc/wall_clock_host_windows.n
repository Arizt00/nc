
wallClockHost {
    fn:
        public:
            milliseconds() -> i64 {
                ticks >> u64 <- 0;
                osWGetSystemTimeAsFileTime(adr(&ticks));
                whole >> u64 <- ticks / 10000;
                signedMilliseconds >> i64 <- whole;
                return signedMilliseconds-11644473600000;
            }
    fa: return true;
}
