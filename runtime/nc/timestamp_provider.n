use <project:timestamp_host>;

timestampProvider {
    const:
        WINDOWS_EPOCH_SECONDS >> i64 <- 11644473600;
        TICKS_PER_SECOND >> u64 <- 10000000;
    fn:
        public:
            fileTimeSeconds(ticks >> u64) -> i64 {
                whole >> u64 <- ticks / TICKS_PER_SECOND;
                signedSeconds >> i64 <- whole;
                return signedSeconds - WINDOWS_EPOCH_SECONDS;
            }
            narrowSeconds(seconds >> i64) -> int {
                narrowed >> int <- seconds;
                return narrowed;
            }
            provider_time_timestamp() -> int {
                seconds >> i64 <- timestamp_host.timestampHost.seconds();
                return narrowSeconds(seconds);
            }
    fa: return true;
}
