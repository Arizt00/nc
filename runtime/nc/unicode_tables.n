    fn:
        public:

            unicodeCanonicalDecomposition(code >> u32, output >> p<u32>) -> int {
                low >> int <- 0;
                high >> int <- 2081;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    candidate >> u32 <- unicodeCanonicalKeys[middle];
                    if (candidate < code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low < 2081 else return 0;
                guard unicodeCanonicalKeys[low] == code else return 0;
                startAt >> int <- cast(unicodeCanonicalOffsets[low]);
                count >> int <- cast(unicodeCanonicalLengths[low]);
                index >> int <- 0;
                while (index < count) {
                    dataAt >> int <- startAt + index;
                    value >> u32 <- unicodeCanonicalData[dataAt];
                    wr(off(output, index), value);
                    index += 1;
                }
                return count;
            }

            unicodeCompatibilityDecomposition(code >> u32, output >> p<u32>) -> int {
                low >> int <- 0;
                high >> int <- 5914;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    candidate >> u32 <- unicodeCompatibilityKeys[middle];
                    if (candidate < code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low < 5914 else return 0;
                guard unicodeCompatibilityKeys[low] == code else return 0;
                startAt >> int <- cast(unicodeCompatibilityOffsets[low]);
                count >> int <- cast(unicodeCompatibilityLengths[low]);
                index >> int <- 0;
                while (index < count) {
                    dataAt >> int <- startAt + index;
                    value >> u32 <- unicodeCompatibilityData[dataAt];
                    wr(off(output, index), value);
                    index += 1;
                }
                return count;
            }

            unicodeCombiningClass(code >> u32) -> int {
                low >> int <- 0;
                high >> int <- 968;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    candidate >> u32 <- unicodeCccKeys[middle];
                    if (candidate < code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low < 968 else return 0;
                guard unicodeCccKeys[low] == code else return 0;
                return cast(unicodeCccValues[low]);
            }

            unicodeComposePair(starter >> u32, next >> u32) -> u32 {
                starter64 >> u64 <- cast(starter);
                next64 >> u64 <- cast(next);
                key >> u64 <- (starter64 << 21) | next64;
                low >> int <- 0;
                high >> int <- 961;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    candidate >> u64 <- unicodeComposeKeys[middle];
                    if (candidate < key) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low < 961 else return 0;
                guard unicodeComposeKeys[low] == key else return 0;
                return unicodeComposeValues[low];
            }

            unicodeGraphemeProperty(code >> u32) -> int {
                low >> int <- 0;
                high >> int <- 1429;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    if (unicodeGraphemeStarts[middle] <= code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low > 0 else return 0;
                index >> int <- low - 1;
                guard code <= unicodeGraphemeEnds[index] else return 0;
                return cast(unicodeGraphemeValues[index]);
            }

            unicodeIndicConjunctProperty(code >> u32) -> int {
                low >> int <- 0;
                high >> int <- 505;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    if (unicodeIncbStarts[middle] <= code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low > 0 else return 0;
                index >> int <- low - 1;
                guard code <= unicodeIncbEnds[index] else return 0;
                return cast(unicodeIncbValues[index]);
            }

            unicodeIsExtendedPictographic(code >> u32) -> bool {
                low >> int <- 0;
                high >> int <- 451;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    if (unicodePictographicStarts[middle] <= code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low > 0 else return false;
                return code <= unicodePictographicEnds[low - 1];
            }

            unicodeIsWide(code >> u32) -> bool {
                low >> int <- 0;
                high >> int <- 123;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    if (unicodeWideStarts[middle] <= code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low > 0 else return false;
                return code <= unicodeWideEnds[low - 1];
            }

            unicodeIsZeroWidth(code >> u32) -> bool {
                low >> int <- 0;
                high >> int <- 342;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    if (unicodeZeroWidthStarts[middle] <= code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low > 0 else return false;
                return code <= unicodeZeroWidthEnds[low - 1];
            }

            unicodeIsEmojiPresentation(code >> u32) -> bool {
                low >> int <- 0;
                high >> int <- 296;
                while (low < high) {
                    middle >> int <- low + (high - low) / 2;
                    if (unicodeEmojiPresentationStarts[middle] <= code) { low <- middle + 1; }
                    else { high <- middle; }
                }
                guard low > 0 else return false;
                return code <= unicodeEmojiPresentationEnds[low - 1];
            }

    fa:
        return true;
}
