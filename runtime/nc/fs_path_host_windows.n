fsPathHost {
    fn:
        public:
    absolute(path >> str, out >> p<byte>, capacity >> u64) -> int {
        chars >> int <- osWMultiByteToWideChar(65001,8,adr(path),-1,null,0);
        if (chars <= 0) return -1;
        if (chars > 1073741823) return -4;
        input >> p<u16> <- cast<u16>(alloc(chars*2));
        if (input == null) return -4;
        if (osWMultiByteToWideChar(65001,8,adr(path),-1,adr(input),chars) != chars) {
            free(input); return -1;
        }
        needed >> u32 <- osWGetFullPathNameW(adr(input),0,null,null);
        if (needed == 0) { free(input); return -3; }
        while (true) {
            if (needed > 1073741823) { free(input); return -4; }
            text >> p<u16> <- cast<u16>(alloc(needed*2));
            if (text == null) { free(input); return -4; }
            written >> u32 <- osWGetFullPathNameW(adr(input),needed,adr(text),null);
            if (written == 0) { free(text); free(input); return -3; }
            // The process cwd may change between the sizing and materialization calls.
            if (written >= needed) { free(text); needed = written; continue; }
            bytes >> int <- osWWideCharToMultiByte(65001,128,adr(text),written,null,0,null,null);
            result >> int <- -3;
            if (bytes == 2147483647) { free(text); free(input); return -4; }
            if (bytes > 0) {
                if (capacity <= bytes) result = -2;
                else {
                    encoded >> p<byte> <- alloc(bytes+1);
                    if (encoded == null) result = -4;
                    else {
                        if (osWWideCharToMultiByte(65001,128,adr(text),written,adr(encoded),bytes,null,null) == bytes) {
                            wr(off(encoded,bytes),0);
                            cp(out,encoded,bytes+1); result = bytes;
                        }
                        free(encoded);
                    }
                }
            }
            free(text); free(input); return result;
        }
    }
    fa: return true;
}
