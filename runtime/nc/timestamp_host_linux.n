
timestampHost {
    type:
        Timespec {
            public:
                tvSec >> u64;
                tvNsec >> u64;
        }
    fn:
        public:
            seconds() -> i64 {
                value >> Timespec <- Timespec(tvSec: 0, tvNsec: 0);
                if (osLclock_gettime(0, adr(&value)) != 0) return -1;
                seconds >> i64 <- value.tvSec;
                return seconds;
            }
    fa: return true;
}
