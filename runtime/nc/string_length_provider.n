stringLengthProvider :: runtime {
    fn:
        private:
            bytesUntilNul(value >> str) -> int {
                data >> p<byte> <- cast<byte>(value);
                count >> int <- 0;
                while (rd(off(data,count)) != 0) { count += 1; }
                return count;
            }
        public:
            provider_string_strByteLen(value >> str) -> int { return bytesUntilNul(value); }
            provider_string_strLen(value >> str) -> int { return bytesUntilNul(value); }
            provider_string_len(value >> str) -> int { return bytesUntilNul(value); }
    fa: return true;
}
