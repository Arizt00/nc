use <data:json>;

jsonBoolDefaultProvider :: runtime {
    const:
        JSON_BOOL >> int <- 2;
    fn:
        public:
            provider_json_jsonGetBoolOr(handle >> int, fallback >> bool) -> bool {
                return jsonKind(handle) == JSON_BOOL ? jsonGetBool(handle) : fallback;
            }
    fa: return true;
}
