use <project:wall_clock_host>;

wallClockProvider {
    fn:
        public:
            provider_time_now() -> int { return timestamp(); }
            provider_time_nowMs() -> int {
                milliseconds >> i64 <- wall_clock_host.wallClockHost.milliseconds();
                narrowed >> int <- milliseconds;
                return narrowed;
            }
    fa: return true;
}
