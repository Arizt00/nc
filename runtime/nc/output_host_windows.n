
outputHost {
    fn:
        private:
            console(handle >> addr, data >> p<byte>, bytes >> u64) -> i64 {
                buffer >> array<u16,128>;
                out >> p<u16> <- cast<u16>(&buffer);
                consumed >> u64 <- 0;
                units >> u32 <- 0;
                while (consumed < bytes && units < 126) {
                    first >> u32 <- rd(off(data,consumed));
                    width >> u64 <- first < 128 ? 1 : (first >= 194 && first <= 223 ? 2 :
                        (first >= 224 && first <= 239 ? 3 : (first >= 240 && first <= 244 ? 4 : 0)));
                    if (width == 0 || width > bytes-consumed) return -1;
                    code >> u32 <- width == 1 ? first : first & (width == 2 ? 31 : (width == 3 ? 15 : 7));
                    part >> u64 <- 1;
                    while (part < width) {
                        next >> u32 <- rd(off(data,consumed+part));
                        if (next < 128 || next > 191) return -1;
                        code <- (code << 6) | (next & 63); part += 1;
                    }
                    if ((width == 2 && code < 128) || (width == 3 && code < 2048) ||
                        (width == 4 && code < 65536) || code > 1114111 || (code >= 55296 && code <= 57343)) return -1;
                    if (code >= 65536) {
                        code -= 65536;
                        wr<u16>(off(out,units),55296+(code >> 10)); units += 1;
                        wr<u16>(off(out,units),56320+(code & 1023)); units += 1;
                    } else { wr<u16>(off(out,units),code); units += 1; }
                    consumed += width;
                }
                at >> u32 <- 0;
                while (at < units) {
                    written >> u32 <- 0;
                    if (osWWriteConsoleW(handle,adr(off(out,at)),units-at,adr(&written),null) == 0 || written == 0 || written > units-at) return -1;
                    at += written;
                }
                return consumed;
            }
        public:
            writeOnce(data >> p<byte>, bytes >> u64) -> i64 {
                handle >> addr <- osWGetStdHandle(-11);
                if (handle == null) return -1;
                mode >> u32 <- 0;
                if (osWGetConsoleMode(handle,adr(&mode)) != 0) return console(handle,data,bytes);
                count >> u32 <- bytes > 2147483647 ? 2147483647 : bytes;
                written >> u32 <- 0;
                if (osWWriteFile(handle,adr(data),count,adr(&written),null) == 0) return -1;
                return written;
            }
    fa: return true;
}
