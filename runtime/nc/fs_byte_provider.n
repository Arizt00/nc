use <project:fs_io_host>;

fsIoProvider :: runtime {
    fn:
        private:
            pathValid(path >> str) -> bool {
                return cast<byte>(path) != null && rd<byte>(cast<byte>(path)) != 0;
            }
        public:
            provider_fs_fsWriteFrom(path >> str, data >> p<byte>, bytes >> int, append >> bool) -> int {
                if (!pathValid(path) || bytes < 0 || (bytes > 0 && data == null)) return -1;
                return fs_io_host.fsIoHost.writeBytes(path,data,bytes,append);
            }
            provider_fs_fsReadInto(path >> str, data >> p<byte>, bytes >> int) -> int {
                if (!pathValid(path) || bytes < 0 || (bytes > 0 && data == null)) return -1;
                return fs_io_host.fsIoHost.readBytes(path,data,bytes);
            }
            provider_fs_fsSize(path >> str) -> int {
                return pathValid(path) ? fs_io_host.fsIoHost.size(path) : -1;
            }
    fa: return true;
}
