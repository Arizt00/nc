
outputHost {
    fn:
        public:
            writeOnce(data >> p<byte>, bytes >> u64) -> i64 {
                count >> u64 <- bytes > 2147479552 ? 2147479552 : bytes;
                repeat {
                    written >> i64 <- osLwrite(1,adr(data),count);
                    if (written >= 0) return written;
                    error >> p<i32> <- from<i32>(osL__errno_location());
                    if (error == null || rd(error) != 4) return -1;
                } until (false);
                return -1;
            }
    fa: return true;
}
