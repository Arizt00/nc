                info >> array<byte,48>;
                osGetSystemInfo(adr(&info));
                return rd<u32>(off(cast<byte>(&info),40));
            }
            vmReserve(address >> p<byte>, bytes >> u64, flags >> u64) -> p<byte> {
                return cast<byte>(osVirtualAlloc(address,bytes,flags | 0x2000,1));
            }
            vmCommit(address >> p<byte>, bytes >> u64, protection >> u64) -> bool {
                return osVirtualAlloc(address,bytes,0x1000,protection) != null;
            }
            vmDecommit(address >> p<byte>, bytes >> u64) -> bool {
                return osVirtualFree(address,bytes,0x4000) != 0;
            }
            vmRelease(address >> p<byte>, bytes >> u64) -> bool {
                return osVirtualFree(address,0,0x8000) != 0;
            }
            vmProtect(address >> p<byte>, bytes >> u64, protection >> u64) -> bool {
