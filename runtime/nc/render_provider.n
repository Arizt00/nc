renderProvider :: runtime {
    fn:
        public:
            provider_render_renderInt(value >> int) -> str {
                data >> p<byte> <- alloc(12);
                if (data == null) return null;
                wide >> i64 <- value;
                magnitude >> i64 <- wide < 0 ? -wide : wide;
                cursor >> int <- 11;
                wr(off(data,cursor),0);
                repeat {
                    cursor -= 1;
                    digit >> i64 <- magnitude%10;
                    wr<byte>(off(data,cursor),48+digit);
                    magnitude <- magnitude/10;
                } until (magnitude == 0);
                if (wide < 0) { cursor -= 1; wr(off(data,cursor),45); }
                count >> int <- 12-cursor;
                at >> int <- 0;
                while (at < count) { wr(off(data,at),rd(off(data,cursor+at))); at += 1; }
                return cast(data);
            }
            provider_render_renderBool(value >> bool) -> str { return value ? "true" : "false"; }
            provider_render_renderChar(value >> char) -> str {
                data >> p<byte> <- alloc(2);
                if (data == null) return null;
                wr<byte>(data,value); wr(off(data,1),0);
                return cast(data);
            }
            provider_render_renderStr(value >> str) -> str { return value; }
    fa: return true;
}
