use <project:fs_host>;

fsDirectoryProvider :: runtime {
    fn:
        private:
            createEncoded(path >> str) -> u64 {
                if (cast<byte>(path) == null || rd<byte>(cast<byte>(path)) == 0) return 2;
                return fs_host.fsHost.create(path) ? 3 : 2;
            }
        public:
            provider_fs_exists(path >> str) -> bool {
                if (cast<byte>(path) == null || rd<byte>(cast<byte>(path)) == 0) return false;
                return fs_host.fsHost.exists(path);
            }
            provider_dir_createDir(path >> str) -> u64 {
                return createEncoded(path);
            }
            provider_fs_createDir(path >> str) -> u64 { return createEncoded(path); }
            provider_result_isOk(value >> u64) -> bool { return (value & 1) != 0; }
            provider_result_isErr(value >> u64) -> bool { return (value & 1) == 0; }
    fa: return true;
}
